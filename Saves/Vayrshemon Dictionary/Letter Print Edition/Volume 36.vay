rames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltalfader"}]},{"blockId":"block.7f5c8be308e442d8baaab0bf2063e23f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.12","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltharfaderk\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.3dbe113983d6426c9da8a4d64acf2359","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.52","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00ebltalfader tav \u00e5vizya."}]},{"blockId":"block.04b042b5e9fd4cfaa770bc723605c90e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.144","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00c5wenginv\u00d7: Ton i y\u00eblthreninel nerbven f\u00c5w\u2019en \u00e5\u00c3 vesna s\u00dflum kom ka zem zem\u2019falnthren o\u00c3owya."}]},{"blockId":"block.4937641e8b4a45ef8ebf281d04179709","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.241","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nemir r\u00e1\u2019falnthren o\u00c3izya \u00e3\u00d1 y\u00eblt\u00c5wenginv\u00d7 f\u00c5wizya. Neks r\u00e1 po matondizya rav tav w\u00c5vumizya."}]},{"blockId":"block.0af7cf7eec224b9396344747eaecd07b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.334","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00c5wenfaren: Falnthren i \u00d1etib y\u00eblthreninel nerbven f\u00c5w\u2019en giktenv\u00d7owya vin ni \u00d5\u00dfr fradowya."}]},{"blockId":"block.8756d03ed0234d2e9ddaadfc11db4e1e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.429","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venor mavem y\u00eblthreninel nerbven f\u00c5w\u2019en tondaizya. H\u00ebthven lym ly\u2019k\u00cfba\u00d1 y\u00eblt\u00c5wenfaren portimostizya."}]},{"blockId":"block.a1d95124b81d467c8871e508117775d3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.533","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00c5wensef\u00c7\u00c3: Falnthren i y\u00eblthreninel nerbven f\u00c5w\u2019en \u00d1etib tav fradowya \u00e3\u00d1 ni venor t\u00d7 p\u00e1f\u00d7\u2019m\u00e7 nerbyal portimostimowya."}]},{"blockId":"block.b501aabe396645af93976261dedfcc4b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.655","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks venor h\u00ebth falnthren lym h\u00c5b\u00cdpomizya. Venyel y\u00eblt\u00c5wensef\u00c7\u00c3 p\u00e1n ly\u2019broft t\u00e7lizya."}]},{"blockId":"block.1461e336d8b748f791aec7383ca8eecc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.741","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblthar: 1 y\u00ebl thar."}]},{"blockId":"block.d8ca447b32bf471995da1db364ff0ce5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.762","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murlameth\u00ebs\u00dflum\u2019w\u00e9asem yib\u2019\u00ebw vimjw\u00ebn\u2019m\u00e7 venelget f\u00c5wsezif\u00c7\u00c3owya \u00e5\u00c3 zi falib jw\u00ebnenplesten\u2019m\u00e7 murlamet\u2019y\u00ebltharget a\u00d9\u00d5\u00dfrowya."}]},{"blockId":"block.b8c45d8c307b4bf2b6095df88726c115","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.887","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 thar."}]},{"blockId":"block.e31bae6738ce4580865752e78f98ffc0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.895","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi ka zi\u2019y\u00eblthar \u00e7zt\u2019es h\u00ebth r\u00e1un ma\u2019akradowya i r\u00e1un farvem ma\u2019r\u00d7owya."}]},{"blockId":"block.7b39b997c2704669bd0a2849a794bd29","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.967","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblthargrij: y\u00eblthar grij."}]},{"blockId":"block.dded9166e80a458589c7cc6cd5c4b795","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.994","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth ziget lofnaizfu thani felen tha zi thav \u00e7ztizya \u00e3\u00d1 zi\u2019k\u00cfba\u00d1 velvor gren zi \u00c7pibaizya \u00e3\u00d1 ziget thav miktaz\u00d7rizya ziget y\u00eblthargrij\u2019en."}]},{"blockId":"block.edb9b985c55d4280bcd68ad7b093cf70","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1133","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltharvejem: Den gren y\u00eblthar \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.0b7ab9868f9047ec93cb0f49a5720caf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1204","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblthar ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00ebltharvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.005480aaca8d4953a80218219424f01e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1294","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltharvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblthar po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.10d6a433542f4f6bb0704385a3074a70","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1352","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblthar b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00ebltharvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.af26461585a146b7b1f30dc2d0be7241","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1423","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltharfader: Y\u00eblthar \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.bdffbecae1ef4ca6bca11d4f7fd68d05","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1520","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00ebltharfader tav \u00e5vizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":11,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":12,"end":51,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":52,"end":143,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":144,"end":240,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":241,"end":333,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":334,"end":428,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":429,"end":532,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":533,"end":654,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":655,"end":740,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":741,"end":761,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":762,"end":886,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":887,"end":894,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":895,"end":966,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":967,"end":993,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":994,"end":1132,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1133,"end":1203,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1204,"end":1293,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1294,"end":1351,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1352,"end":1422,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1423,"end":1519,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1520,"end":1612,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}],"paragraphs":[{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":