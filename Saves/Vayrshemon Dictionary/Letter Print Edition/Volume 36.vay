yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurthar"}]},{"blockId":"block.a845192105574916a36c626f0cc97ff2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.11","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00ebletke\u00dbon"}]},{"blockId":"block.50216fcc9296485985639b0e5151af98","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.25","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00ebldur thar."}]},{"blockId":"block.929314dc84f745d1a7b0ab34dc614802","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.40","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Trinkulo m\u00dfrnav ni zi\u2019t\u00cdn thavimy\u00cd\u00d7 ziget w\u00e9asemowya ne \u00cbers \u00d1e\u00d5 tremb\u00c5r graf i ne\u2019kerun y\u00ebldurtharatya r\u00e1."}]},{"blockId":"block.579e5304385a45f5b297ceae0a16ad94","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.148","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurthren: Mem i y\u00ebldur \u00d1etib grel jw\u00ebnenplesten\u2019m\u00e7 venka dlen\u00dbeminowya."}]},{"blockId":"block.b10cb0cd1a9d49afbf036e5e745f8fc4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.223","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni dlenson\u2019m\u00e7 venor \u00d3\u00c5tusol ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Grel darum zem\u2019y\u00ebldurthren vesnar\u00d7izya."}]},{"blockId":"block.bc13bacc026e4c1bbcc2b443f552535a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.311","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurverzetpelna: y\u00ebldur verzetpelna."}]},{"blockId":"block.ba77adad56bd4b85928628f3145e5b86","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.350","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pelna y\u00ebldurverzetpelnaun jo\u00d9ol tha \u00e7ztim \u00e3\u00d1 vesna \u00e7l\u00d7on ni verzetim vin 13 venlunun p\u00e1n a\u00d9\u00d5\u00dfrowya zem. P\u00c7n\u00df\u00eb k\u00cfba\u00d1 p\u00e1k\u00cfba\u00d1 jo\u00d9 ni vutim m\u00dfrnav 10 venlunun ni a\u00d9\u00d5\u00dfrowya."}]},{"blockId":"block.b3899e2df83f49c98fc05166b8fb9952","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.520","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurvoren: y\u00ebldur voren."}]},{"blockId":"block.1bd6cf0d43324f61a1c249e9c6d4b7d7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.547","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lomih graf, d\u00df\u00c3\u00df ol, i \u00d1ed vesna vorenetthreninun i j\u00c9gwa\u00c3vorenetun ka kom thavim k\u00e3m zem\u2019jo\u00d9olvorenun lomih y\u00ebldurvorenun gurin vorenkelde\u00dbons\u00dflumun thrin\u00c3\u00cdowfu lom\u00d7r\u2019lahowya."}]},{"blockId":"block.7e03b79adb794c6ab6e34e780d9c2dde","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.724","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurfadervoren: y\u00ebldur fadervoren."}]},{"blockId":"block.60007d98406d43ec9f46f33d46cca6f9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.761","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Miyaldrig\u00e1l. Puna goryemsjo\u00d9 gren Arena jelgl\u00c9st. Goryemsjo\u00d9 \u00db\u00d7b\u00dfimowya. Viminy\u00eblp\u00c5r y\u00eblverzet. Puna z\u00e1lagur \u00e3\u00d1 y\u00eblyemarjem\u00e3. Gwayakil nilom \u00e3\u00d1 z\u00e1lagur. Po\u2019tarmil: Taremp\u00e1wemin, y\u00ebldurfadervoren, Kito felen. Kito i z\u00e1lagur, azar \u00e3\u00d1 s\u00ebra grem."}]},{"blockId":"block.9c8aca5e7a634a86b932f9df97739a88","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1004","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurf\u00ebr: \u00e2lum i y\u00ebldur \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.595085f7a7bd4d1590dadfbd20768d6d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1058","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebldur \u00e3lumizya. \u00caers y\u00ebldurf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.a7837eef40d745fbb5b515317ce19c69","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1127","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldur\u00e7ztthav: y\u00ebldur \u00e7ztthav."}]},{"blockId":"block.7a975ec609ea4ab787cf94822f3d29c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1158","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1\u2019norvend\u00c7\u00d3unel ne\u2019venla vory\u00eblenunget velvorjem\u2019en Yel \u00e3\u00d1 \u00c4\u00d9gif neksus a\u00d9owfu pavin, r\u00e1\u2019farbroft\u2019ni kom ragumowya ka mav\u00d1et neget y\u00ebldur\u00e7ztthavowya\u2019jw\u00ebn, lamem r\u00d7e."}]},{"blockId":"block.a88f58a6bd784c9791797fbb2f897ea0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1325","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldury\u00eblet: y\u00ebldur y\u00eblet."}]},{"blockId":"block.b2e6e56eb96448e08a7c2a6999a5980c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1352","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni Yel nel nel\u2019y\u00ebldury\u00ebletget ragumaratya \u00e3\u00d1 ni venser nel nel\u2019p\u00e1inget kranerarvb\u00e7oraratya p\u00c7n\u00df\u00eb trornek ni Yel i w\u00e9asem \u00e3\u00d1 i maven\u00e1lna w\u00e9asem gurnel r\u00d7atya."}]},{"blockId":"block.52a0c63c30d3473e869ada8a7980c385","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1510","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00ebletke\u00dbon: H\u00c5b\u00cden i y\u00ebldury\u00eblet \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.2223f30a94834cebb94a1f923557c00f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1594","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00ebld\u00ebletke\u00dbon gl\u00c9stizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":10,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":11,"end":24,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":25,"end":39,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":40,"end":147,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":148,"end":222,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":223,"end":310,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":311,"end":349,"attributes":{"tracking":0