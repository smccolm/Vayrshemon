graph","direction":"ltr","runs":[{"runId":"run.qt.26","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblverzetkrannimel \u00e3lumizya. \u00caers y\u00eblvimelf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.71c53d7fe711467185053e7b5be2299b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.109","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblviminmerangoren: y\u00ebl viminmeran goren."}]},{"blockId":"block.453231792355418ba4a55e6ddea9316b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.151","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e2\u00d1 kinos Ly\u2019indian nemirun f\u00c5wizya lyget \u00d1etib y\u00eblvorkinviminmeranun \u00e3\u00d1 y\u00eblviminmerangorenun gren meranybs\u00dfizya ly."}]},{"blockId":"block.7228e9f2539b417fa404f26ffab9bf0a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.267","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvingijw\u00c5b\u00cd: H\u00c5b\u00cden i y\u00eblverzet r\u00c7n\u00d3 velf\u00ebr ningi \u00d1etib p\u00e1n falnthren thavvimna nerbyal miktaz\u00d7rs\u00dflumowya."}]},{"blockId":"block.230211b78a414650a3f0dcb51b04f998","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.376","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n d\u00c7\u00d3 grasnotimizya y\u00eblvingijw\u00c5b\u00cd ly\u2019tremb\u00c5r elyi\u00d1izya."}]},{"blockId":"block.5cd57a61aae442d7941d5745f82c2eda","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.434","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvingih\u00ebth: H\u00c5b\u00cden i y\u00eblverzet r\u00c7n\u00d3 velf\u00ebr ningi \u00d1etib h\u00ebth venor i nerbyal thrin\u00c3\u00cdowya t\u00e7lowya."}]},{"blockId":"block.c7335dce36e54e11b9088e12573d76b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.533","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth lym sezif\u00c7\u00c3izya y\u00eblvingih\u00ebth t\u00e7lizya. Ni goryems po ma\u2019t\u00e7lizya."}]},{"blockId":"block.48bbc16ec6de41b0b88fa23f9c5e35e4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.602","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvingipof\u00c5w: H\u00c5b\u00cden i y\u00eblverzet r\u00c7n\u00d3 velf\u00ebr ningi \u00d1etib \u00cbers ef\u2019gl\u00c9st vin \u00e5\u00c3 falnthren \u00e5\u00c3 vesna s\u00dflum f\u00c5wimowya."}]},{"blockId":"block.fd33bc3a0193423b8806123d9f9c5232","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.717","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi ton tavtondaizya p\u00c7n\u00df\u00eb pel venim wa\u00d9gumizya. Vin zi\u2019tremb\u00c5r da\u00c3izya pel y\u00eblvingipof\u00c5w mlapv\u00d7staizya."}]},{"blockId":"block.660bb098325a4425b2bb1c6fbef82fb5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.821","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvininj\u00c9net: Vimin\u2019m\u00e7 threnin i y\u00eblverzetyemsinin \u00d1etib ma\u2019\u00e7zt\u2019jw\u00ebnowya p\u00c7n\u00df\u00eb j\u00c9gwa\u00c3vorenet \u00e3lumowya."}]},{"blockId":"block.51390abafffa4ec4b18577a87f582f15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.925","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha j\u00c9gwa\u00c3vorenet y\u00eblverzetyemsinin ma\u2019z\u00dfgu\u00d9\u2019jw\u00ebnizya. \u00caers \u00e3lum lym y\u00eblvininj\u00c9net portimostizya."}]},{"blockId":"block.97d5fd5e2ce1435bb94fd98b3d8ab905","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1023","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvinintae\u00db\u00e7: Y\u00eblverzetyemsinin tha p\u00e1nna\u2019m\u00e7 d\u00c7\u00d3 \u00e7ztimowya \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 d\u00c7\u00d3 tav \u00e5v\u2019jw\u00ebnimowya."}]},{"blockId":"block.5b3dcdddc6974f5d8245ab64a71f8ca6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1123","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Po\u2019l\u00c7m \u00e3lumowfu. H\u00ebth kelde\u00dbon lym y\u00eblvinintae\u00db\u00e7 r\u00c7n\u00d3 nesh\u2019m\u00e7 voren jem\u00e3izya."}]},{"blockId":"block.e07d402624d54348816137fb43d158b2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1201","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvininika\u00d9: Vimin\u2019m\u00e7 threnin i y\u00eblverzetyemsinin \u00d1etib p\u00e1n \u00e3lum jem\u00e3imowya t\u00d7 l\u00e1mgl\u00c9st."}]},{"blockId":"block.b944176747394bf283960851d808775b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1291","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth zarun ol vesna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Lym po r\u00c7n\u00d3 y\u00eblvininika\u00d9 k\u00e3menizya."}]},{"blockId":"block.3722e2afb4724351b6d413d839889a00","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1362","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvorkinviminmeran: y\u00ebl vorkin viminmeran."}]},{"blockId":"block.e2f1f80c2fc64a2286ce7afaec0a86c9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1406","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna threnina\u00d9gur y\u00eblyemarvenorviminmeran lomih venor viminy\u00eblyemar \u00e3\u00d1 y\u00eblvorkinviminmeranun r\u00c7n\u00d3 semmem r\u00d7\u2019jorinatya."}]},{"blockId":"block.dd2ab7f5d87249d5b09653dd05b71fe4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1526","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvorenvejem: Den gren y\u00eblviminmerangoren \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.1db0adecf1eb457e8ccd65e319c22b8d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1609","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblviminmerangoren ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblvorenvejem r\u00e1\u2019mela h\u00c5b\u00cdizya "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":11,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":12,"end":25,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":26,"end":108,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":109,"end":150,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":151,"end":266,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":267,"end":375,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":376,"end":433,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":434,"end":532,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":533,"end":601,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":602,"end":716,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":717,"end":820,"attributes":{"tracking":0,"wordSpacing":0.0,"basel