y","type":"unicode","normalization":"none","text":"y\u00eblgurvesna"}]},{"blockId":"block.bb2f304d2cb34d9f8765f3b464bb1874","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.27","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00ebletake\u00dbon: Y\u00ebldury\u00eblet \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.555f8081f23c489799d862959bb223e1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.114","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00ebld\u00ebletake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.da89ca0809cb41f3b1a52237ee0cb9fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.185","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00ebletden: Neks w\u00c5vumen i y\u00ebldury\u00eblet \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.360c5be81ad2407bbd11ca516b69e6cb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.277","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00ebld\u00ebletden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.eeacf651848749e7a815ff31d20efdf1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.353","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgeninjw\u00c5b\u00cd: H\u00c5b\u00cden i y\u00eblgur r\u00c7n\u00d3 valemthrenin \u00d1etib p\u00e1n falnthren thavvimna nerbyal miktaz\u00d7rs\u00dflumowya."}]},{"blockId":"block.43eacd2e3cd047a3a9e30e6fb3c6b524","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.459","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n d\u00c7\u00d3 grasnotimizya y\u00eblgeninjw\u00c5b\u00cd ly\u2019tremb\u00c5r elyi\u00d1izya."}]},{"blockId":"block.00c4cb39735c47779a1760207e9517a4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.517","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgeninh\u00ebth: H\u00c5b\u00cden i y\u00eblgur r\u00c7n\u00d3 valemthrenin \u00d1etib h\u00ebth venor i nerbyal thrin\u00c3\u00cdowya t\u00e7lowya."}]},{"blockId":"block.e6b0b5d5f15245ed81be85489eda14d2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.613","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth lym sezif\u00c7\u00c3izya y\u00eblgeninh\u00ebth t\u00e7lizya. Ni goryems po ma\u2019t\u00e7lizya."}]},{"blockId":"block.1afb40d984a448fbaaeb93d6aadc1eb6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.682","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgeninpof\u00c5w: H\u00c5b\u00cden i y\u00eblgur r\u00c7n\u00d3 valemthrenin \u00d1etib \u00cbers ef\u2019gl\u00c9st vin \u00e5\u00c3 falnthren \u00e5\u00c3 vesna s\u00dflum f\u00c5wimowya."}]},{"blockId":"block.07617aba82ca4b9f8016381b42a5fbc6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.794","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi ton tavtondaizya p\u00c7n\u00df\u00eb pel venim wa\u00d9gumizya. Vin zi\u2019tremb\u00c5r da\u00c3izya pel y\u00eblgeninpof\u00c5w mlapv\u00d7staizya."}]},{"blockId":"block.46bf0c4d3f5346939f16507540a13b7f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.898","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgur: 1 s\u00ebnal i kl\u00e1rjem\u2019m\u00e7 y\u00eblinun t\u00d7 thren da\u00c3\u2019en."}]},{"blockId":"block.ce54c71280654c66a63da925462eb0fb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.952","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 y\u00eblgur jo\u00d9shalget threndarizya za."}]},{"blockId":"block.1f4f134997e54002a4575b4938f79109","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.992","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00eblin z\u00dfgu\u00d9."}]},{"blockId":"block.55d72d03d5a649ad97818148ddebae5a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1007","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"E\u00d9land nira y\u00c9nenimowya yems\u00d7y\u00eblet y\u00eblgurun i y\u00eblgur threnin l\u00dfnowya y\u00ebletun yib kom ragumowya \u00e3\u00d1 lam\u00ebw vimin p\u00e1l\u00dfn i viminy\u00eblp\u00c5r r\u00d7owya, grafvesna vesna gimenun s\u00c7fowya kenst."}]},{"blockId":"block.040797a8ddcd4495aacc6ec04de93fa9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1184","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgur r\u00c7n\u00d3 valemthrenin: Ma\u2019\u00c9lmim\u2019na d\u00c7\u00d3 \u00cbers vimin vemyib\u2019\u00ebw\u2019m\u00e7 pisen y\u00cd\u00d7b\u00d7\u00c7r\u2019m\u00e7 gim\u00cba\u00d5owya. D\u00c7\u00d3s\u00dflum ir pisen nerbyalowya."}]},{"blockId":"block.14d06db6629740d48014f6d939c5903d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1310","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1weminun stras\u2019en za\u2019y\u00eblgur r\u00c7n\u00d3 valemthrenin r\u00d7izya. Yib\u2019\u00ebw ni \u00d1e\u00d5 d\u00c7\u00d3 ol venike\u00dbn\u00c9 lilthreninun lil\u2019en ir za \u00c3ahizya."}]},{"blockId":"block.941567601a46412f9d957a2cda53d4fc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1431","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgurvejem: Den gren y\u00eblgur \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.ca3b9cd60e7a4577bf768d6e63c8c0b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1500","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblgur ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblgurvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.c3c5315fea404c12abfe5ce5e517fe9b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1588","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblgurvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblgur po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.d545ef27260f459892a2a735d1c404ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1644","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblgur b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblgurvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":14,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":15,"end":26,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":27,"end":113,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":114,"end":184,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":185,"end":276,"att