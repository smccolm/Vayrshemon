bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00d5f\u00c5wginv\u00d7"}]},{"blockId":"block.a1b6182d2ad24875aa7bb83a73a22255","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblde\u00d9enginv\u00d7"}]},{"blockId":"block.06a8f1f7c43c4ebb840a4b9bc92f9747","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.28","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nemir r\u00e1\u2019falnthren o\u00c3izya \u00e3\u00d1 y\u00ebld\u00d5f\u00c5wginv\u00d7 f\u00c5wizya. Neks r\u00e1 po matondizya rav tav w\u00c5vumizya."}]},{"blockId":"block.096d16d81022436c9c28dce8a5307f84","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.121","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00d5f\u00c5wfaren: Falnthren i \u00d1etib y\u00ebldur grel d\u00c7\u00d3v\u00df\u00d5f\u00c5w giktenv\u00d7owya vin ni \u00d5\u00dfr fradowya."}]},{"blockId":"block.0b12706ca8f247f5953c623723c498e0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.210","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venor mavem y\u00ebldur grel d\u00c7\u00d3v\u00df\u00d5f\u00c5w tondaizya. H\u00ebthven lym ly\u2019k\u00cfba\u00d1 y\u00ebld\u00d5f\u00c5wfaren portimostizya."}]},{"blockId":"block.06246cd5768e42a38e7d7fd449baad54","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.308","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00d5f\u00c5wsef\u00c7\u00c3: Falnthren i y\u00ebldur grel d\u00c7\u00d3v\u00df\u00d5f\u00c5w \u00d1etib tav fradowya \u00e3\u00d1 ni venor t\u00d7 p\u00e1f\u00d7\u2019m\u00e7 nerbyal portimostimowya."}]},{"blockId":"block.266a236d2cba49209cdae4a665f8f422","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.424","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks venor h\u00ebth falnthren lym h\u00c5b\u00cdpomizya. Venyel y\u00ebld\u00d5f\u00c5wsef\u00c7\u00c3 p\u00e1n ly\u2019broft t\u00e7lizya."}]},{"blockId":"block.ca3a1ecbb32646aa9b0aa4f42ff44ded","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.510","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblderalvejem: Den gren y\u00ebldest\u00eb\u00c5teral \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.ce8f5da75932415f87d6c13f3f947247","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.589","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebldest\u00eb\u00c5teral ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblderalvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.d465860b38414a738255790cf8b22965","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.687","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblderalvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00ebldest\u00eb\u00c5teral po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.d21270a5dbb147d39249f702e32846bc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.753","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebldest\u00eb\u00c5teral b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblderalvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.930c2f2f061143ce85dc3f277b1df1c6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.832","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblderalfader: Y\u00ebldest\u00eb\u00c5teral \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.e3ace2c6e78d4a799af07a0f1f3890ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.937","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblderalfader tav \u00e5vizya."}]},{"blockId":"block.2e3976d9c9494865a5333d5553c7e07c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1031","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldelnap\u00e1in: Y\u00ebldurverzetpelna \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.1b1d301ec584486da5604bc9eb79df21","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1104","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebldelnap\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.b2141dfb87294c739b9c11292fe8573a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1197","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldelnavevor: Threnin i y\u00ebldurverzetpelna \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.e9525179fbca4c869b187021010378b6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1275","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebldurverzetpelna \u00e7ztizya. R\u00e1 y\u00ebldelnavevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.053855560c584d008ade144e2b8573a7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1358","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldelnaf\u00ebr: \u00e2lum i y\u00ebldurverzetpelna \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.9c8ffcb1d7d94478b31ced71fb65c35e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1425","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebldurverzetpelna \u00e3lumizya. \u00caers y\u00ebldelnaf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.6b9d61ca0ade4b26a051187ef04925dc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1507","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblde\u00d9enginv\u00d7: Ton i y\u00ebl shalinsilen venor\u2019m\u00e7 mem t\u00d7 dwe\u00d9en \u00e5\u00c3 vesna s\u00dflum kom ka zem zem\u2019falnthren o\u00c3owya."}]},{"blockId":"block.a3ec0328dace40d8a143cf8b881aab2e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1615","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nemir r\u00e1\u2019falnthren o\u00c3izya \u00e3\u00d1 y\u00eblde\u00d9enginv\u00d7 f\u00c5wizya. Neks r\u00e1 po matondizya rav tav "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":120,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":121,"end":209,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":210,"end":307,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":308,"end":423,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":424,"end":509,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":510,"end":588,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":589,"end":686,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":687,"end":752,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":753,"end":831,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":832,"end":936,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":937,"end":1030,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1031,"end":1103,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1104,"end":1196,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1197,"end":1274,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1275,"end":1357,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1358,"end":1424,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1425,"end":1506,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1507,"end":1614,"attributes":{"