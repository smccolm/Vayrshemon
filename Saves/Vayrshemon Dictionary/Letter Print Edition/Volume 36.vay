tent":{"document":{"schemaVersion":"0.1.0","documentId":"document.conventionaldictionary.letter.36","revision":0,"title":"yalta","layoutProfile":"layout.qt-6.8.3-m2","languageRevision":null,"fonts":[{"fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalin"}]},{"blockId":"block.296dce6f8338499a838fc0c2dddfce1d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.10","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblslebfader"}]},{"blockId":"block.664512f685724505b0c3b427768a1e00","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.23","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebthvenor olgimkinhefak gurs\u00dflum\u00e1pe\u00dbem haren tha y\u00eblthrenin y\u00eblverzetun kamizizya \u00e3\u00d1 s\u00dflum hy\u00c5v\u00cdizya \u00e5\u00c3 kerdest\u00eb\u00c5s\u00ebnal\u2019en y\u00eblshalinun \u00e5\u00c3 shalen\u2019en y\u00eblyemar i dur\u00ebn."}]},{"blockId":"block.f8ac2cdbc99c4843bf3ccad8c1e33030","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalinve\u00dbzarzarven: y\u00eblshalin ve\u00dbzarzarven."}]},{"blockId":"block.706d9f7e7b1d4976929689a15cd0c2e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.235","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Falns\u00dfluml\u00c9y y\u00eblshalinve\u00dbzarzarven thrin siv\u00ebl\u2019m\u00e7 y\u00ebl palesda\u00c3izya."}]},{"blockId":"block.039eb553eb184121aa2a5d2533b4c168","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.303","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsrvenke\u00dbon: H\u00c5b\u00cden i y\u00eblshalinve\u00dbzarzarven \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.e7a92b410d8b4154a511a9769d722e75","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.397","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblsrvenke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.799389328f3f4006999cfa9875d24ba9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.483","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsrvenake\u00dbon: Y\u00eblshalinve\u00dbzarzarven \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.69db199d31084e79abe13b0f469ff82b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.580","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblsrvenake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.980b5070412d4c69aed3a273acda80f9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.651","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsrvenden: Neks w\u00c5vumen i y\u00eblshalinve\u00dbzarzarven \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.e3752383fb404c15beab72c2a4101c6c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.753","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblsrvenden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.479390bff5e44ea99b3c10aedb210e5e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.829","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsleb: y\u00ebl sleb."}]},{"blockId":"block.3bf25b7014ab401ebefcd1f727818396","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.848","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb jw\u00ebnenplesten\u2019m\u00e7 ne\u2019teralun \u00e3\u00d1 y\u00eblslebunget p\u00e1ns\u00ebn a\u00d9e. Ni jelgl\u00c9st i hefak r\u00d7owya Roma \u00e3\u00d1 za\u2019musilgorenun. Neksus vorel murf\u00d7get s\u00c7fowya\u2019jor."}]},{"blockId":"block.1bc1cd27ed5247dba8d46d6797a91e6d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.997","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblslebd\u00c7\u00d3s\u00ebnal \u00d3\u00c5tus jorinun s\u00c7fowya: Neksus falib slebowya \u00e3\u00d1 neksus gren vesna vorel j\u00cdowya vesna\u2019m\u00e7 l\u00e1m grem ilna\u2019m\u00e7 kl\u00e1r\u00e7l\u00d7on. \u00d2\u00c5tusol w\u00cf\u00dfe p\u00e1n d\u00c7\u00d3 nerbw\u00c5vumen\u2019en."}]},{"blockId":"block.5620da53bb4c4564b238525e61190ed1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1166","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pomf\u00c5ws\u00dflum pomf\u00c5wton venel\u2019m\u00e7 \u00d3\u00c5\u00e7izya. Y\u00eblslebd\u00c7\u00d3s\u00ebnal \u00d3\u00c5tus jorinun s\u00c7fowya, palmela tondaizya. Pelel \u00d1etib zi j\u00cdizya w\u00cf\u00dfe."}]},{"blockId":"block.c8a3286dfa594561aba5984911862378","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1292","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblslebvejem: Den gren y\u00eblsleb \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.2642722528984f449965238bfd8bb686","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1363","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblsleb ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblslebvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.9b02873d42b74333b7f058864e2d3c75","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1453","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblslebvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblsleb po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.a155f1015d4d4ce99897be0a7f450527","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1511","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblsleb b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblslebvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.fffec382f1e0478ab21a5b996c689550","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1582","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblslebfader: Y\u00eblsleb \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.50827c9b6dfc4aadb47029620873b6ba","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1679","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblslebfader tav "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":9,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":10,"end":22,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":23,"end":187,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":188,"end":234,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":235,"end":302,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":303,"end":396,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":397,"end":482,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":483,"end":579,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":580,"end":650,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":651,"end":752,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":753,"end":828,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":829,"end":847,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":848,"end":996,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":997,"end":1165,"a