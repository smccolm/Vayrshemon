onaldictionary.letter.36","revision":0,"title":"yalta","layoutProfile":"layout.qt-6.8.3-m2","languageRevision":null,"fonts":[{"fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rnoral"}]},{"blockId":"block.e90edf31c9bc4c6285266b04d0659397","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.12","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblprzetf\u00ebr"}]},{"blockId":"block.a451b6feb952415998011ec2e404270b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.24","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblp\u00c5rnoral y\u00eblverzet \u00e3\u00d1 venam \u00e3\u00d1 komna. Po tha renowya \u00d1etib y\u00eblp\u00c5rnil\u00ebmm\u00ebr lomih y\u00eblp\u00c5ryemtinm\u00ebr, vesna \u00e5vun i po, y\u00eblp\u00c5r thiril meranthiril y\u00eblyemarthirilun."}]},{"blockId":"block.c6ea5ed0254d42da9ff96d8b94b28897","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.185","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5ryemtinm\u00ebr: y\u00eblp\u00c5r yemtin m\u00ebr."}]},{"blockId":"block.cf53f6647bd24786b3914a289a6edb4d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.221","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gim\u00dfv y\u00eblverzetun s\u00c7fowya falib m\u00ebrik m\u00ebrven tha y\u00eblp\u00c5ryemtinm\u00ebr \u00d3\u00c5\u00e7owya \u00d1etib swifl\u00dfn yemtinowya."}]},{"blockId":"block.1cbcbffc12524efcb86ddf87b740bcd0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5ry\u00ebletharen: 1 y\u00eblp\u00c5r y\u00ebletharen."}]},{"blockId":"block.fd3d3b277d45498cad45ebc108bdd470","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.359","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblp\u00c5ry\u00ebletharen i d\u00cdn\u00d7r t\u00d7 pelith varil tha y\u00eblenun nem thart\u00e7lowya. Gim\u00dfv pelna y\u00ebletun lomih y\u00eblenun po \u00e7l\u00d7ono\u00c3t\u00e7owya; vorn y\u00eblenun drupilowya \u00e3\u00d1 gaktrivowya vin pelna y\u00eblenun thar strasf\u00c5w\u2019en p\u00e1ns\u00ebn r\u00d7owya."}]},{"blockId":"block.d4bffcbb8cce435ba042a6c4b124741c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.570","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00eblp\u00c5r y\u00ebletharen."}]},{"blockId":"block.9bdb6992eec44b2c8992c1dd5f555c7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.591","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kinos y\u00eblp\u00c5ry\u00ebletharen y\u00eblp\u00c5rnoral \u00e3\u00d1 y\u00eblp\u00c5r l\u00ddn\u00c5r ilna p\u00e1l\u00dfn y\u00eblverzetun k\u00e3m venor y\u00eblenun strasf\u00c5wowya po."}]},{"blockId":"block.59eab11f670043a3b57b392b1920df97","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.700","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblphrenj\u00c9net: Vimin\u2019m\u00e7 threnin i y\u00eblp\u00c5r mayemszarunthen thenthren \u00d1etib ma\u2019\u00e7zt\u2019jw\u00ebnowya p\u00c7n\u00df\u00eb j\u00c9gwa\u00c3vorenet \u00e3lumowya."}]},{"blockId":"block.ebfeafbed2d94e36b8a16f332c0618b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.819","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha j\u00c9gwa\u00c3vorenet y\u00eblp\u00c5r mayemszarunthen thenthren ma\u2019z\u00dfgu\u00d9\u2019jw\u00ebnizya. \u00caers \u00e3lum lym y\u00eblphrenj\u00c9net portimostizya."}]},{"blockId":"block.97ef6e60351f4c9bb16b09e63c66459e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.932","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblphrentae\u00db\u00e7: Y\u00eblp\u00c5r mayemszarunthen thenthren tha p\u00e1nna\u2019m\u00e7 d\u00c7\u00d3 \u00e7ztimowya \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 d\u00c7\u00d3 tav \u00e5v\u2019jw\u00ebnimowya."}]},{"blockId":"block.13e543cde6da44b68c12c86f28b509b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1047","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Po\u2019l\u00c7m \u00e3lumowfu. H\u00ebth kelde\u00dbon lym y\u00eblphrentae\u00db\u00e7 r\u00c7n\u00d3 nesh\u2019m\u00e7 voren jem\u00e3izya."}]},{"blockId":"block.a2793a25a1b248ee952e33f5cbad9b9c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1125","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblphrenika\u00d9: Vimin\u2019m\u00e7 threnin i y\u00eblp\u00c5r mayemszarunthen thenthren \u00d1etib p\u00e1n \u00e3lum jem\u00e3imowya t\u00d7 l\u00e1mgl\u00c9st."}]},{"blockId":"block.0a368860d80c4a579ffb438db738714a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1230","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth zarun ol vesna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Lym po r\u00c7n\u00d3 y\u00eblphrenika\u00d9 k\u00e3menizya."}]},{"blockId":"block.6bed70769bd34a8abac06fd40fbdf6e2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1301","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblprzetp\u00e1in: Y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.a5f960e8d7864c59990fab2e2d63cb6d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1389","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblprzetp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.5359a5fed47a450abb037a526bcd8cea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1482","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblprzetvevor: Threnin i y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.fdff1e095aeb4ebc99a523bf92daad61","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1575","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet \u00e7ztizya. R\u00e1 y\u00eblprzetvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.f2e5c05652144956b53fd97dfe4b7246","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1673","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblprzetf\u00ebr: \u00e2lum i y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet \u00d1etib venor i d\u00c7\u00d3 "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":11,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":12,"end":23,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":24,"end":184,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":185,"end":220,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":221,"end":319,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":320,"end":358,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":359,"end":569,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":570,"end":590,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":591,"end":699,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":700,"end":818,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":819,"end":931,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":932,"end":1046,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1047,"end":1124,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1125,"end":1229,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1230,"end":1300,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1301,"end":1388,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1389,"end":1481,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1482,"end":1574,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1575,"end":1672,"attributes":{"tracking":0,"w