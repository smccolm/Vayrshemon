9effed0790da","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.35","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5r mayemszarunthen thenthren: y\u00eblp\u00c5r mayemszarunthen thenthren."}]},{"blockId":"block.5bbd83c99ec9436a985192389456e8d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.103","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0em y\u00eblverzetun tha y\u00eblp\u00c5r mayemszarunthen thenthren a\u00d9imowya, mavmin jo\u00d9 s\u00dflumun mayemszarunthen ni \u00e7l\u00d7on 3 lomih 4 venlunun i venal wemowya \u00d1etib."}]},{"blockId":"block.ee32cebe43d0496588636f58e8a0ae30","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.252","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet: y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet."}]},{"blockId":"block.060d297da8524090a86a17d52d90c389","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neksus p\u00e1l\u00dfn jem s\u00ebjem farvemr\u00d7owya, p\u00e1k\u00cfba\u00d1 s\u00dflumun y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet y\u00eblverzetun \u00d3\u00c5\u00e7owya."}]},{"blockId":"block.a6b8953a269b45039f8b902157cd1a7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.427","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rjw\u00c5b\u00cd: Y\u00eblp\u00c5r \u00cbers \u00d1etib s\u00dflum \u00e1pe\u00dbem\u2019m\u00e7 d\u00c7\u00d3 vingim f\u00d7owya."}]},{"blockId":"block.a4244937324843a389cf4d2b54347bd7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.493","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin r\u00e1 venim ma\u2019w\u00c5vumizya r\u00e1\u2019y\u00eblp\u00c5rjw\u00c5b\u00cd paven \u00e5\u00c3 d\u00c7\u00d3 elyi\u00d1izya."}]},{"blockId":"block.1655d325f576429ea721a3fd0298635c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.558","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rvevor: Threnin i y\u00eblp\u00c5r \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.18cd6eaafcd843f0baa2208b56f6879f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.623","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblp\u00c5r \u00e7ztizya. R\u00e1 y\u00eblp\u00c5rvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.b26c7efaf08c410495755d01396ea57c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.693","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rvenam: y\u00eblp\u00c5r venam."}]},{"blockId":"block.df272bcf4c3d4ebdba56e2e241d241e6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.720","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lam s\u00dflum vimin\u2019m\u00e7 dest\u00eb\u00c5izfu. Rav r\u00c7n\u00d3 mav y\u00eblp\u00c5rvenam ni wemkor mayemszarunizfu r\u00d7\u2019en t\u00d7 rav Venor i s\u00dflum thar l\u00e3t\u00d5owfu."}]},{"blockId":"block.f889e50b5c594e75b29b007c34fcdb68","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.844","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rvimin: y\u00eblp\u00c5r vimin."}]},{"blockId":"block.c92482dbf9ec462c842b9e69a74e46fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.871","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gwam i Indian s\u00dflumun yatnor\u00d3a vimin z\u00e1lun s\u00c7fowya, El\u00ebin y\u00eblp\u00c5rvimin mayemsyelz\u00e1lshalen r\u00c7n\u00d3 shalenim."}]},{"blockId":"block.4bcb139b12da4b43941e3ba8fd9b2acd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.975","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rvoril: Neks voril ni y\u00eblp\u00c5r \u00d1etib p\u00e1n murvor da\u00c3 \u00e3lumarowya."}]},{"blockId":"block.1e4b3f9c83ce48ba89d6c572959da1da","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1042","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 y\u00eblp\u00c5rvoril semizya \u00e3\u00d1 r\u00e1\u2019darum da\u00c3izya. Rav marin murvor m\u00e5rizya."}]},{"blockId":"block.12372ce1836849e1bb3f35e46bfb1ab1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1112","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rnil\u00ebm: y\u00eblp\u00c5r nil\u00ebm."}]},{"blockId":"block.b255757438d140598bd01f8da3f52b54","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1139","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Haren \u00e5v i zem\u2019y\u00eblp\u00c5rnoral y\u00eblverzetun y\u00eblp\u00c5rnil\u00ebm kloj\u2019en tha zemget r\u00d7owya, i \u00d1etib gim sil\u00ebmna r\u00d7owya zem."}]},{"blockId":"block.58d26718d2e74a399dea3cc7af4473b0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1249","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rnil\u00ebmm\u00ebr: y\u00eblp\u00c5r nil\u00ebm m\u00ebr."}]},{"blockId":"block.ed246981e1644086ade684ae469335cf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1283","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venam i renna lomih yems\u00d7 al, y\u00eblverzet tha y\u00eblp\u00c5rnil\u00ebmm\u00ebr \u00d3\u00c5\u00e7owya \u00d1etib m\u00ebrven klojowya zem. Melatyems\u00d7 l\u00ddn\u00c5r \u00d3\u00e1lun\u00c3owya po."}]},{"blockId":"block.e6142ea8089a46099b61ab5279d3ab52","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1409","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5rnoral: 1 y\u00eblp\u00c5r noral."}]},{"blockId":"block.77c3fa2bdf8448a39e35b37c6074b16c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1438","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Goryems thavvim gim\u00dfv y\u00eblp\u00c5rnoral y\u00eblverzetun a\u00d9owya l\u00ddn\u00c5rh\u00eb o\u00c3."}]},{"blockId":"block.9366610720eb46dbbc64c0a8ced219e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1503","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 melat."}]},{"blockId":"block.dcd2fd9d3f3e4721ba5683bc7161b8e0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1512","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venik lomih b\u00c5rum Melori mayemszarunthenvorun kamizizya ly \u00e3\u00d1 grem 10 goren y\u00eblp\u00c5rnoral jw\u00ebnenplesten shalenun, nel ol \u00e7ztthavimizfu p\u00c7n\u00df\u00eb jw\u00ebnenplesten shalen ol \u00d5\u00dfrjemimizfu maves vimin dul ni neksus h\u00eb\u00d5."}]},{"blockId":"block.f5c63993563b4534b6718afadd1145d7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1719","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"3 y\u00eblp\u00c5r noral."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":22,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":23,"end":34,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":35,"end":102,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":103,"end":251,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":252,"end":319,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":320,"end":426,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":427,"end":492,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":493,"end":557,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":558,"end":622,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":623,"end":692,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":693,"end":719,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":720,"end":843,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":844,"end":870,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":871,"end":974,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":975,"end":1041,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1042,"end":1111,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1112,"end":1138,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1139,"end":1248,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1249,"end":1282,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1283,"end":1408,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1409,"end":1437,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1438,"end":1502,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1503,"end":1511,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.