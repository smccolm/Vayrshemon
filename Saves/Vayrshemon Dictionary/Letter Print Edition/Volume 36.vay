"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrkerah\u00ebth"}]},{"blockId":"block.bf3fa83de85b42e2bc4a1c882e4b4ea8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrvensef\u00c7\u00c3"}]},{"blockId":"block.4e1267540bc04d23b0f252dd9ea32ec5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.28","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrkerah\u00ebth: \u00e2lumun \u00d1etib h\u00ebth y\u00eblvenorker f\u00e7sowya dlen\u00dbeminowya."}]},{"blockId":"block.9b70bad08c8f41c5bc3fb698637547ed","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.96","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venm\u00ebr y\u00eblvenorker h\u00eb\u00d5izya. Ni venser lym venim r\u00c7n\u00d3 y\u00eblvrkerah\u00ebth d\u00c7\u00d3izya."}]},{"blockId":"block.5a4ae49b88a64b38a1dd30f11d8ce8a5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.175","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrkerh\u00ebth: \u00e2lumun \u00d1etib h\u00ebth y\u00ebl venorker f\u00e7sowya dlen\u00dbeminowya."}]},{"blockId":"block.33f0a485260649d591aa27def9585c08","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.243","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venm\u00ebr y\u00ebl venorker h\u00eb\u00d5izya. Ni venser lym venim r\u00c7n\u00d3 y\u00eblvrkerh\u00ebth d\u00c7\u00d3izya."}]},{"blockId":"block.9b94d340b810480c843ccf988cd18d1c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.322","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrkervejem: Den gren y\u00ebl venorker \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.4f50f85ad8f1491583c3aefef9b8ec56","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.399","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebl venorker ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblvrkervejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.9ee48f797485461d940a81fbc1d84948","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.495","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrkerfader: Y\u00ebl venorker \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.fe9c2916ca1b471eb5ce708b334ecee5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.598","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblvrkerfader tav \u00e5vizya."}]},{"blockId":"block.6c9f01122c5a484a9e44763ffc8b95b8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.692","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrkers\u00ebven: Y\u00eblvenorker ni \u00d1etib s\u00ebven ven\u2019m\u00e7 r\u00d7izya \u00e3\u00d1 po\u2019venor lomih \u00e7l\u00d7on den\u2019jw\u00ebnowya."}]},{"blockId":"block.3e96379e896c403d8c01877fc4b36a8c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.786","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks threnin tha vesna s\u00dflum j\u00cdizya. Tha daral venra r\u00e1 y\u00eblvrkers\u00ebven f\u00c5w\u2019jw\u00ebnizya."}]},{"blockId":"block.96d1b3f4e8074c4d888407b0b5ebe25f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.870","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrhalp\u00e1in: Y\u00eblverzetverhal \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.054b8ab8d5a04cfab687794dddf6b1f3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.941","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblvrhalp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.a67e6c8a2b7d4a81b8fee59c65b314e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1034","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrhalvevor: Threnin i y\u00eblverzetverhal \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.9a7a661a4c744f7f83dd93ab18276e13","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1110","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblverzetverhal \u00e7ztizya. R\u00e1 y\u00eblvrhalvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.393c6397f3eb4059b83d37ce38c1f3c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1191","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrhalf\u00ebr: \u00e2lum i y\u00eblverzetverhal \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.9024f3fba6fc461f9e0e1c260efc0aa7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1256","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblverzetverhal \u00e3lumizya. \u00caers y\u00eblvrhalf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.55c1aa59f8fa4841bc47c1494b2fed27","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1336","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrvenjeem\u00e3: \u00e6l\u00d7on k\u00c7nib y\u00eblverzet\u00d3\u00ddrven vingim sezif\u00c7\u00c3owya t\u00d7 jemekjem\u00e3."}]},{"blockId":"block.06533334b0684b7eb96f1c6af125f6e7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1412","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n y\u00eblverzet\u00d3\u00ddrven kin o\u00c3braizya. Venyel tav. Lym tha y\u00eblvrvenjeem\u00e3 \u00c3\u00cdthavizya."}]},{"blockId":"block.0cb5af0026f04b1082aef382c52ea7bb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1496","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrvenden: Den i y\u00eblverzet\u00d3\u00ddrven \u00cbers \u00d1etib thavvim\u2019m\u00e7 y\u00eblverzet\u00d3\u00ddrven h\u00c5b\u00cdimowya."}]},{"blockId":"block.29e8fd7fb8eb48009705fbdab81bd23c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1581","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00eblverzet\u00d3\u00ddrven ma\u2019o\u00c3izya. Pel den t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 y\u00eblvrvenden gl\u00c9stizya."}]},{"blockId":"block.f044ab80050741cab67a2055e240d305","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1657","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrvensef\u00c7\u00c3: Y\u00eblverzet\u00d3\u00ddrven \u00d1etib vingim \u00e5\u00c3 ilna\u2019m\u00e7 \u00e7l\u00d7on sezif\u00c7\u00c3owya kom kinos wa\u00d9gum\u2019jw\u00ebnimowya."}]},{"blockId":"block.14564e21cbaa4649b3a63cb585fa2285","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1759","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n \u00e3\u00d1 venyel po ni ilna\u2019m\u00e7 kwesta \u00d3\u00e1lun\u00c3izya. Pel d\u00cdn\u00d7r ma\u2019f\u00c5wizya. Venim za za\u2019y\u00eblvrvensef\u00c7\u00c3 h\u00c5b\u00cdizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":95,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":96,"end":174,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":175,"end":242,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":243,"end":321,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":322,"end":398,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":399,"end":494,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":495,"end":597,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":598,"end":691,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":692,"end":785,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":786,"end":869,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":870,"end":940,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":941,"end":1033,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1034,"end":1109,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1110,"end":1190,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1191,"end":1255,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"s