":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinj\u00c9net"}]},{"blockId":"block.bed425b5fd31475189e52dfbaa48b0ac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalinportimostizya."}]},{"blockId":"block.aeba6abc2f0544129d00187b08073dbf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.38","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalintae\u00db\u00e7: Y\u00eblshalin tha p\u00e1nna\u2019m\u00e7 d\u00c7\u00d3 \u00e7ztimowya \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 d\u00c7\u00d3 tav \u00e5v\u2019jw\u00ebnimowya."}]},{"blockId":"block.f2a30311544c476bb6f479435d201521","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.130","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Po\u2019l\u00c7m \u00e3lumowfu. H\u00ebth kelde\u00dbon lym y\u00eblsalintae\u00db\u00e7 r\u00c7n\u00d3 nesh\u2019m\u00e7 voren jem\u00e3izya."}]},{"blockId":"block.e9330ccf8b1247ef860abb66ee84f4b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.208","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinvejem: Den gren y\u00ebl shalin \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.c791cf891ad44e60ad61cfe090a2748d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.283","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebl shalin ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblsalinvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.c5a19509ca494c68aadc59a9e05c0507","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.377","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00ebl shalin po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.8b866b964e36469cae6377534d2a7e18","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.439","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebl shalin b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblsalinvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.0a68c05bb8884789aabf07d9e48eb8b3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.514","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinfader: Y\u00ebl shalin \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.8661178c520e4a94b967d58c21ac9985","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.615","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblsalinfader tav \u00e5vizya."}]},{"blockId":"block.93406ae2ed5f4067833d3f5a682d9222","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.709","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinika\u00d9: Vimin\u2019m\u00e7 threnin i y\u00eblshalin \u00d1etib p\u00e1n \u00e3lum jem\u00e3imowya t\u00d7 l\u00e1mgl\u00c9st."}]},{"blockId":"block.af34f703844c44b59cdfd01456584b1f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.791","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth zarun ol vesna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Lym po r\u00c7n\u00d3 y\u00eblsalinika\u00d9 k\u00e3menizya."}]},{"blockId":"block.5da41c3eb0ee4db89e578480536a5ab2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.862","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshal: 1 y\u00ebl shalem."}]},{"blockId":"block.1e745106534d46198710c7f1c6e8f2c8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.885","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblshal i ni az, \u00e3\u00d1 ni ol m\u00ebren Indiz skiren skirena\u00d9\u2019en gimam \u00e5vimowya."}]},{"blockId":"block.5b729be417924841996aa9591b79ce40","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.958","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 krath\u2019m\u00e7 shalen\u00d1et i y\u00eblverzet\u2019i verzethalemin\u00d7."}]},{"blockId":"block.7e0374b010434642944304bffb0ea528","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1009","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi r\u00e1\u2019vemelverzet vutthavjo\u00d9 a\u00d9owfu \u00e3\u00d1 y\u00eblshal tha r\u00e1\u2019m\u00d7vral y\u00eblverzet \u00e7ztthavowfu zi po ol\u00ebw slefy a\u00d9owfu \u00e3\u00d1 po thav tarnowfu po\u2019y\u00eblenun ve\u00db a\u00d9imowya."}]},{"blockId":"block.fd3b0e72fc0342de8a4d443d9f9c38ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1161","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalke\u00dbon: H\u00c5b\u00cden i y\u00eblshal \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.c7515d860edd414eafed0ea652d5f5e5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1240","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblshalke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.3cf2df622ffe4f8f956bd60fedc35833","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1325","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalake\u00dbon: Y\u00eblshal \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.3d206918c21447d09ea405f75de6bd2d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1407","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblshalake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.4baa05b2d9184153b32f11ebf6fe2db8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1477","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalden: Neks w\u00c5vumen i y\u00eblshal \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.1d4acdbc23574da7ac27d554fad0083d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1564","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblshalden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.2822bf77164e406ca88d54d3c26e4e5b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1639","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblshalin: y\u00ebl shalin."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":37,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":38,"end":129,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":130,"end":207,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":208,"end":282,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":283,"end":376,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":377,"end":438,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":439,"end":513,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":514,"end":614,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":615,"end":708,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":709,"end":790,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":791,"end":861,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":862,"end":884,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":885,"end":957,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":958,"end":1008,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1009,"end":1160,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1161,"end":1239,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1240,"end":1324,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1325,"end":1406,"attributes":{"tracking":0,"wordSpacing":0.0,"