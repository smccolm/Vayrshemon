]}}]},{"pageId":"page.collected.00065","name":"yalta","width":"612000000","height":"792000000","margins":{"left":"54000000","right":"72000000","top":"48000000","bottom":"71000000"},"frames":[{"frameId":"frame.collected.00065","name":"yalta","x":"54000000","y":"48000000","width":"486000000","height":"673000000","overflow":"show","content":{"document":{"schemaVersion":"0.1.0","documentId":"document.conventionaldictionary.letter.36","revision":0,"title":"yalta","layoutProfile":"layout.qt-6.8.3-m2","languageRevision":null,"fonts":[{"fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemartarjo\u00d9shal"}]},{"blockId":"block.f062d597760945bb8d77623cf61ca97e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.19","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarviminy\u00eblyemar"}]},{"blockId":"block.18dda4c2232441edbba89a1a9daf5f29","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.41","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemartarjo\u00d9shal: y\u00eblyemar tar jo\u00d9shal."}]},{"blockId":"block.8905bf7c39634889ae8f2faf4db0e206","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.83","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib rav f\u00d7izya r\u00e1 p\u00c7n\u00df\u00eb venla\u2019m\u00e7 enifslebun muren\u00c9lmvenizya \u00e3\u00d1 zi falib tha zem\u2019zar\u00d7\u00d3 gorenkwestadulun zemget maserf\u00c5wizya, \u00e3\u00d1 \u00e5\u00c3 E\u00d9land prodf\u00c5w\u2019m\u00e7 goryemsthren enif\u00e7\u2019en lomih ly\u2019y\u00eblyemartarjo\u00d9shal gren marplesten\u2019m\u00e7 Gorenkwesta elyi\u00d1\u2019en nor\u00d3aizya r\u00e1 zemget?"}]},{"blockId":"block.7d08a4f72ecc4429914c3172b9934efd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.344","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarthiren: y\u00eblyemar thiren."}]},{"blockId":"block.94ad67ab5923433ab6a28b517416cfcc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.377","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Jo\u00d9haren tha enifthav vimin merlunor ni y\u00eblyemarthirenimizya vimin y\u00eblyemar t\u00d7y\u00dfb\u00dfizya ly, po \u00e7ztizya ly, ly\u2019k\u00cfba\u00d1 viminy\u00eblyemarun lyget \u00db\u00c7d\u2019en gimer vimin r\u00d7izya kenst."}]},{"blockId":"block.73517d987d1041cab2be7788ea517e39","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.547","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarthiril: y\u00eblyemar thiril."}]},{"blockId":"block.c788dea3220745d89ad90d1090da45cb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.580","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00f1in ni graf i po r\u00c7n\u00d3 y\u00eblyemarthirilget a\u00d9izya r\u00e1. Y\u00eblp\u00c5r thiril meranthiril y\u00eblyemarthirilun \u00d3\u00c5\u00e7imowya \u00d1em \u00e3\u00d1 gim faren dlen\u00dbeminvenoratya."}]},{"blockId":"block.79cfdaddbef441ba9c6c7121391b7374","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.722","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarthiril jw\u00ebnenplesten: 1 y\u00eblyemar thiril jw\u00ebnenplesten."}]},{"blockId":"block.a9e344f262bd4e89ac6489cdde24a149","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.785","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 h\u00c5b\u00cdmem p\u00e1ns\u00ebrizfu r\u00d7izya \u00d1e\u00d5 \u00cbers hefak gurs\u00dflum\u00e1pe\u00dbem haren. Zem\u2019vimjw\u00ebn len ni ma\u2019jorgor\u2019jw\u00ebnizya zi zemget \u00e3\u00d1 elin tonun vemyib\u2019\u00ebw marin sezif\u00c7\u00c3f\u00c5wen ven\u00e1l t\u00d7 kom gimam y\u00cd\u00d7 d\u00c7\u00d3 ma\u2019kl\u00e1rjem\u2019veizya. Y\u00eblyemar, enifelen \u00e3\u00d1 y\u00eblyemarthiril jw\u00ebnenplesten gimam ufol f\u00ebr\u00d3izya."}]},{"blockId":"block.ace34502660748e7b8e5928a2d68838b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1062","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00eblyemar thiril jw\u00ebnenplesten."}]},{"blockId":"block.bacc2728b6f14ce59f10289f6d834007","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1095","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren venik\u2019t yel ly r\u00c7n\u00d3 ly\u2019k\u00cfba\u00d1 tremb\u00c5run y\u00eblyemarthiril jw\u00ebnenplesten i y\u00eblyemar thar tarnizya."}]},{"blockId":"block.77e01c4bdfde47d1aa6a2d16725586d6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1194","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarvejem: Den gren y\u00eblyemarviminy\u00eblyemar \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.94aafe34077d4a11a90b6ec9b8a2ce05","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1280","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblyemarviminy\u00eblyemar ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblyemarvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.251ce7321a314ab495638c0782fdec93","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1385","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarvenorviminmeran: y\u00eblyemar venor viminmeran."}]},{"blockId":"block.8126d67f162e4f3f9169b15f40d3d19e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1437","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lyget \u00db\u00c7dizya \u00d1etib borelun y\u00eblyemarvenorviminmeran lomih venor viminy\u00eblyemar, neksus y\u00eblvorkinviminmeran, \u00e3\u00d1 nem ni stras\u00ebw kerdest\u00eb\u00c5s\u00ebnalimizfu vesna y\u00eblvorkinviminmeran r\u00d7izya."}]},{"blockId":"block.b7d5424e23544f99b3053809b9c5a8d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1617","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblyemar po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.7b4f7f1eede0400c870e3bd6536b9b4f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1677","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemar b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblyemarvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.bf54b300c3554b2dbcbaf91b83e72e1b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1750","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemarviminy\u00eblyemar: y\u00eblyemar viminy\u00eblyemar."}]},{"blockId":"block.7aa1b24b897d468ba5d992aeef74a8bc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1797","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tondaizfu r\u00e1 k\u00e3m, 4 y\u00eblyemarun n\u00d7\u00dbem r\u00d7izya ly, hefak gurs\u00dflum\u00e1pe\u00dbem haren Swan \u00e3\u00d1 "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":18,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":19,"end":40,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":41,"end":82,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":83,"end":343,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":344,"end":376,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":377,"end":546,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":547,"end":579,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":580,"end":721,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":722,"end":784,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":785,"end":1061,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1062,"end":1094,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1095,"end":1193,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1194,"end":1279,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start