n.qt.50","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvorenvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblviminmerangoren po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.388fb015f81f47458eefe25019953e45","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.120","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblviminmerangoren b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblvorenvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.cecce137ab194016ba3dc325bdb6a1f3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.203","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvorenfader: Y\u00eblviminmerangoren \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.9b2e1985eaea44f08998f0cb4c189afe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.312","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblvorenfader tav \u00e5vizya."}]},{"blockId":"block.964b937d226a48c5a86b56023102c565","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.406","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00df\u00d5enginv\u00d7: Ton i y\u00eblverzetel r\u00c7n\u00d3 y\u00ebletun v\u00df\u00d5\u2019en \u00e5\u00c3 vesna s\u00dflum kom ka zem zem\u2019falnthren o\u00c3owya."}]},{"blockId":"block.a5647b8a202147da8f90fabb477c8fbb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.507","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nemir r\u00e1\u2019falnthren o\u00c3izya \u00e3\u00d1 y\u00eblv\u00df\u00d5enginv\u00d7 f\u00c5wizya. Neks r\u00e1 po matondizya rav tav w\u00c5vumizya."}]},{"blockId":"block.d19006b3063d4643a704e23bceef573d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.600","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00df\u00d5enfaren: Falnthren i \u00d1etib y\u00eblverzetel r\u00c7n\u00d3 y\u00ebletun v\u00df\u00d5\u2019en giktenv\u00d7owya vin ni \u00d5\u00dfr fradowya."}]},{"blockId":"block.a89a378dfd2547339ae93386199c5318","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.699","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venor mavem y\u00eblverzetel r\u00c7n\u00d3 y\u00ebletun v\u00df\u00d5\u2019en tondaizya. H\u00ebthven lym ly\u2019k\u00cfba\u00d1 y\u00eblv\u00df\u00d5enfaren portimostizya."}]},{"blockId":"block.fcf32fac67bb4eca97168d63a1966e4e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.807","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00df\u00d5ensef\u00c7\u00c3: Falnthren i y\u00eblverzetel r\u00c7n\u00d3 y\u00ebletun v\u00df\u00d5\u2019en \u00d1etib tav fradowya \u00e3\u00d1 ni venor t\u00d7 p\u00e1f\u00d7\u2019m\u00e7 nerbyal portimostimowya."}]},{"blockId":"block.be1447b6c02a42b3abd6d9879cd0d63f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.933","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks venor h\u00ebth falnthren lym h\u00c5b\u00cdpomizya. Venyel y\u00eblv\u00df\u00d5ensef\u00c7\u00c3 p\u00e1n ly\u2019broft t\u00e7lizya."}]},{"blockId":"block.30ca0ca0b41047a8b2491bff7c45e645","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1019","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dflum\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00eblvenorjemeks\u00dflum vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]},{"blockId":"block.f42d9f2db0ab46cdab3d487d6acc30fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1118","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren nor\u00d3aint\u00dff\u00c9ben vesna den kojizya. Vin d\u00c7\u00d3 t\u00e7lizya ol \u00e5\u00c3 y\u00eblv\u00dflum\u00cb\u00cdnon elyi\u00d1izya."}]},{"blockId":"block.09939ec13b4941c19bee207de451e828","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1204","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dflumlarod: Y\u00eblvenorjemeks\u00dflum \u00e5\u00c3 falib s\u00dflumun jw\u00ebnenplesten\u2019m\u00e7 d\u00c7\u00d3 \u00cbers lamprod y\u00c9nenowya."}]},{"blockId":"block.7af80f0d80fe4fe4a1f5a2692e27b17e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1300","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den gren nor\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00eblv\u00dflumlarod wa\u00d9gumizya."}]},{"blockId":"block.fa80637db56a4eb6856273e1166d8931","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1414","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dflumnoven: S\u00dflum falib d\u00c7\u00d3 i y\u00eblvenorjemeks\u00dflum t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]},{"blockId":"block.b896803845cc4be48d137a613fa8488b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1504","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblvenorjemeks\u00dflum sezif\u00c7\u00c3izya. Y\u00eblv\u00dflumnoven taren f\u00c5wizya \u00e3\u00d1 braden sezif\u00c7\u00c3izya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":49,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":50,"end":119,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":120,"end":202,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":203,"end":311,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":312,"end":405,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":406,"end":506,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":507,"end":599,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":600,"end":698,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":699,"end":806,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":807,"end":932,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":933,"end":1018,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1019,"end":1117,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1118,"end":1203,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1204,"end":1299,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1300,"end":1413,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1414,"end":1503,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1504,"end":1586,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}],"paragraphs":[{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"ta