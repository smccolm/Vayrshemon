0cdn\u00d7r borel masif\u2019m\u00e7 r\u00d7izya. \u00caers y\u00eblporal\u00d1\u00e9\u00d9 r\u00e1 \u00d1etib lym wemizya h\u00c5b\u00cdizya."}]},{"blockId":"block.96a61be4395f4c5fbcc845f30de905b7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.353","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblporalin\u00dfb\u00df: Threnin i y\u00eblp\u00c5rnoral t\u00d7 s\u00dflum falib venim ma\u2019t\u00e7lh\u00eb\u00d5owfu jem\u00e3imowya."}]},{"blockId":"block.bd08a748f50e497d8cfc4fd2712c6937","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.437","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00cd\u00d7 y\u00eblp\u00c5rnoral w\u00cf\u00dfizya. R\u00e1 y\u00eblporalin\u00dfb\u00df shalenizya. Z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum velin gren marjo\u00d9 r\u00d7izya."}]},{"blockId":"block.d1e93f50933249c4881962c2d56aa01a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.534","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltarventhelir: y\u00ebl tarven thelir."}]},{"blockId":"block.3be8bdd86d9340988a9ee8786c07f4a7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.570","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e2\u00d1 n\u00e5\u00d1 thar \u00e3\u00d1 tar\u00c3\u00cdun, dest\u00eb\u00c5durunun \u00e3\u00d1 felenz\u00e1lun, y\u00ebltarventhelirun, thren jemzethun, bar\u00ebndarun denowfu nel. Memvorplestenzaruntomun, zaruntomun, venorzaruntom, \u00e7ztkl\u00e1rjems\u00dflumun\u2019maserv\u00df\u00d5, hefak gurs\u00dflumun grijimizfu, ol venun i krasel\u2019m\u00e7 hefak denowfu nel."}]},{"blockId":"block.0d31fe67f0f34d0cacd5c2a04d3a6836","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.832","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltae\u00db\u00e7: Y\u00ebl tha p\u00e1nna\u2019m\u00e7 d\u00c7\u00d3 \u00e7ztimowya \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 d\u00c7\u00d3 tav \u00e5v\u2019jw\u00ebnimowya."}]},{"blockId":"block.14f1949ea11e4cca8d4a7e0b116f8b59","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.913","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Po\u2019l\u00c7m \u00e3lumowfu. H\u00ebth kelde\u00dbon lym y\u00ebltae\u00db\u00e7 r\u00c7n\u00d3 nesh\u2019m\u00e7 voren jem\u00e3izya."}]},{"blockId":"block.2593fe697c1c4be6bcec75d307636910","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.986","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltal: y\u00ebl tal."}]},{"blockId":"block.07038fe5c2ad452cb5f7019f8cfd2ff2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1003","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0ed y\u00ebltalunget zhemirowya r\u00e1, \u00d1etib vemors\u00dfrn\u2019m\u00e7 talowya nel\u2019mel\u2019m\u00e7 tremb\u00c5rniget melomi\u2019en, vinel r\u00e1\u2019mavmin\u2019m\u00e7 melinun, \u00d1etib ka trornekget trornekowya\u2019jor, nel nerin ub\u00e1venaz\u2019es kojowya kenst y\u00ebl\u2019hefar."}]},{"blockId":"block.0de3bae0b6494d3a9737585df803fa9e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1208","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltalthirils\u00ebnal: y\u00ebltal thiril s\u00ebnal."}]},{"blockId":"block.846bbcad432648d5a80cfc8e5771ac1e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1248","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni bov\u00ebl i y\u00eblenun tw\u00ddnjybizya za ziget. \u00d0etib f\u00d7izya za kinos palir? Gren y\u00ebltalthirils\u00ebnal falnizya za?"}]},{"blockId":"block.6eacd773f8eb425f9314be31ea3dbc1b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1354","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltalvejem: Den gren y\u00ebltal \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.d49de876d9354f57bbc7033bab843fb7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1423","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebltal ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00ebltalvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.5454021d16c8420bab5be32061faabb8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1511","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltalvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00ebltal po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.2c62012295604253851a1b41e946274c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1567","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebltal b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00ebltalvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.b0509f96622c4160a3d06bb4703d76da","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1636","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltalfader: Y\u00ebltal \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"