ageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dbmelvevorw\u00cf\u00dfen broftimowya."}]},{"blockId":"block.1cf98cfcd3494bc792b7723c744ffd59","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.47","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblvfalnake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.78af1d4fa6a1462eba22f38d20e79c34","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.118","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvfalnden: Neks w\u00c5vumen i y\u00eblvenortarnfaln \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.d4901fb2c5bd4f6195d1047d17f87c4c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.215","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblvfalnden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.3992769d1ccc44189f5d9b9162099fa6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.291","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvmfel\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00eblverzetnimfel vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]},{"blockId":"block.bca6431e07a34c3782c6eb1124a0317d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.387","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren nor\u00d3aint\u00dff\u00c9ben vesna den kojizya. Vin d\u00c7\u00d3 t\u00e7lizya ol \u00e5\u00c3 y\u00eblvmfel\u00cb\u00cdnon elyi\u00d1izya."}]},{"blockId":"block.89bca9372eee4045a96351c305bc29db","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.473","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvmfellarod: Y\u00eblverzetnimfel \u00e5\u00c3 falib s\u00dflumun jw\u00ebnenplesten\u2019m\u00e7 d\u00c7\u00d3 \u00cbers lamprod y\u00c9nenowya."}]},{"blockId":"block.764057b248884745a7f00dd670b5fb01","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.566","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den gren nor\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00eblvmfellarod wa\u00d9gumizya."}]},{"blockId":"block.ef9daa01d1b447c9a6b1f19e88da7023","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.680","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvmfelnoven: S\u00dflum falib d\u00c7\u00d3 i y\u00eblverzetnimfel t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]},{"blockId":"block.b21fc18f36c44b258fb5b3fc8e415570","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.767","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblverzetnimfel sezif\u00c7\u00c3izya. Y\u00eblvmfelnoven taren f\u00c5wizya \u00e3\u00d1 braden sezif\u00c7\u00c3izya."}]},{"blockId":"block.313dd229d5ab47049671effdd5e9e58c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.847","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvmin\u00d7p\u00e1in: Y\u00eblverzetverzethalemin\u00d7 \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.8599deeb37794beeb16903d83a487f67","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.926","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblvmin\u00d7p\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.ca821f339dc54b6bbbf86b7f02f7ea88","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1019","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvmin\u00d7vevor: Threnin i y\u00eblverzetverzethalemin\u00d7 \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.c284791283ba4daf9b479658055dd5f0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1103","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblverzetverzethalemin\u00d7 \u00e7ztizya. R\u00e1 y\u00eblvmin\u00d7vevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.4d556e1625ab4387934cc9295bc62ae8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1192","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvmin\u00d7f\u00ebr: \u00e2lum i y\u00eblverzetverzethalemin\u00d7 \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.bee8ff547c514278812d8db0608b2636","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1265","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblverzetverzethalemin\u00d7 \u00e3lumizya. \u00caers y\u00eblvmin\u00d7f\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.4ca4eeaffa2447688783e0dbfa08c16e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1353","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dbmelp\u00e1in: Y\u00eblverzetve\u00dbmel \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.ae1aefacad3a412cb9626c3296dd8801","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1424","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblv\u00dbmelp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.f27d10d80dfa4dc98c41fb6a93b1a70d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1517","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dbmelvevor: Threnin i y\u00eblverzetve\u00dbmel \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":14,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":15,"end":46,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":47,"end":117,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":118,"end":214,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":215,"end":290,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":291,"end":386,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":387,"end":472,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":473,"end":565,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":566,"end":679,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":680,"end":766,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":767,"end":846,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":847,"end":925,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":926,"end":1018,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1