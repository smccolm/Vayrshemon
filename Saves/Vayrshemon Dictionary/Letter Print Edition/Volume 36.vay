ody","type":"unicode","normalization":"none","text":"y\u00ebl\u00ddmy\u00eblf\u00ebr"}]},{"blockId":"block.007c808d64334731a45d4089b6f9974a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.12","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfmvevor"}]},{"blockId":"block.074f98d153eb4ed9aa71bffbb7a2d00d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.23","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebl\u00ddmy\u00ebl \u00e3lumizya. \u00caers y\u00ebl\u00ddmy\u00eblf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.5ba83de1c44041479bf9cdb367d92ee8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.96","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfp\u00e1injebra: Y\u00ebl\u00dfmp\u00e1in \u00d1etib p\u00e1n klojvord\u00cdn\u00d7r \u00e5\u00c3 vesna s\u00dflum paven lametf\u00ebr\u00d3imowya."}]},{"blockId":"block.e4bae7084ac74677b504014f605b07bf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.182","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel venim ma\u2019t\u00e7lowfu. R\u00e1 z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum vesna d\u00cdn\u00d7r f\u00c5wizya \u00e3\u00d1 y\u00ebl\u00dfp\u00e1injebra t\u00d7 pel jem\u00e3izya."}]},{"blockId":"block.5c29b697be334c45a77f203a5b986884","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.274","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfp\u00e1in\u00d1\u00e9\u00d9: \u00d0\u00e9\u00d9 i y\u00ebl\u00dfmp\u00e1in \u00d1etib h\u00ebth klojvord\u00cdn\u00d7r dlen\u00dbeminowya."}]},{"blockId":"block.e1ca9d6bc8854dc0b2fa528a0b67c10d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.342","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00cdn\u00d7r borel masif\u2019m\u00e7 r\u00d7izya. \u00caers y\u00ebl\u00dfp\u00e1in\u00d1\u00e9\u00d9 r\u00e1 \u00d1etib lym wemizya h\u00c5b\u00cdizya."}]},{"blockId":"block.de00d54da6774fc790cb5737356ad2fb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.419","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfp\u00e1inin\u00dfb\u00df: Threnin i y\u00ebl\u00dfmp\u00e1in t\u00d7 s\u00dflum falib venim ma\u2019t\u00e7lh\u00eb\u00d5owfu jem\u00e3imowya."}]},{"blockId":"block.a2966dcd275b4181980e3ed841e34964","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.501","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00cd\u00d7 y\u00ebl\u00dfmp\u00e1in w\u00cf\u00dfizya. R\u00e1 y\u00ebl\u00dfp\u00e1inin\u00dfb\u00df shalenizya. Z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum velin gren marjo\u00d9 r\u00d7izya."}]},{"blockId":"block.acdb1ca71ae947f18d44776a12c5fc6d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.596","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfva: w\u00ddyaz\u2019m\u00e7 y\u00eblverzet."}]},{"blockId":"block.302e66de0097490a9bdcac15d59a67a2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.624","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 murfarsemlinget ni goren jw\u00ebnen \u00e3\u00d1 ziirget l\u00ddn\u00c5r y\u00d1t y\u00ebl\u00dfva strasf\u00c5w\u2019es o\u00c3owfu."}]},{"blockId":"block.c28037deaa9d45e2b5d7e7d0f50f03a5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.707","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfvap\u00e1in: Y\u00ebl\u00dfva \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.c189a7a43ccf4b10b519970a8ef9fae2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.767","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebl\u00dfvap\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.45511013bfbe413b99f37514df7883f8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.858","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfvavevor: Threnin i y\u00ebl\u00dfva \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.1943b0b4a4804801ac6ca7ab84e7aada","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.923","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebl\u00dfva \u00e7ztizya. R\u00e1 y\u00ebl\u00dfvavevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.ecac79b6c74a47eea0473dd72716d8e0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.993","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfvaf\u00ebr: \u00e2lum i y\u00ebl\u00dfva \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.e3461be899d74476851f59d8b07a890d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1047","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebl\u00dfva \u00e3lumizya. \u00caers y\u00ebl\u00dfvaf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.2527472bc5454bef91cb4626d1510d87","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1116","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfm: y\u00eblverzet."}]},{"blockId":"block.bd07c3d2d4c44047a570176040bffe77","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1134","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"I y\u00d1t y\u00eblv\u00d7m y\u00ebl venorunget \u00e3\u00d1 i y\u00eblr\u00ddm \u00e3\u00d1 y\u00ebl\u00dfm y\u00eblverzet Y\u00c5kovl\u00c9y \u00e7ztizya. \u00e2\u00d1 ve\u00db venorpirilunget ni zem zi shalem\u00e7ztthavizya, \u00e3\u00d1 ve\u00db \u00d1etib y\u00ebl venorun\u2019ni r\u00d7izya zi \u00d3\u00e1lun\u00c3arizya."}]},{"blockId":"block.3062fb39ac9843b588857663e5a4cc2e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1315","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfmap\u00e1in: Y\u00ebl\u00dfm \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.833cbf1efbcd41db9c96a6044453ddc1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1374","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebl\u00dfmap\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.71754c2b5a3f4a9b8a0f2c204c15d623","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1465","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfmp\u00e1in: y\u00ebl\u00dfm p\u00e1in."}]},{"blockId":"block.796601a8834545119cedaa26de92a07a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1488","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"I salena za\u2019tomil s\u00eb\u00dbgaowya ne r\u00e1el ka ma f\u00dflem\u00d1\u00e3 \u00dfd\u00d7um k\u00e