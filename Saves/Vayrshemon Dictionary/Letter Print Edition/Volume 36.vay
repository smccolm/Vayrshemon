vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gurin \u00d1em po neks\u2019m\u00e7 kojizya. Ni vesna \u00e7l\u00d7on y\u00eblygrenk\u00e3men vesnar\u00d7izya."}]},{"blockId":"block.fcd2f0614b594d9b85266d39fc0f62eb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.100","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblygrenthren: Mem i y\u00eblyemargren \u00d1etib grel jw\u00ebnenplesten\u2019m\u00e7 venka dlen\u00dbeminowya."}]},{"blockId":"block.04016552408b47f9b122fa55dca81cac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.183","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni dlenson\u2019m\u00e7 venor \u00d3\u00c5tusol ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Grel darum zem\u2019y\u00eblygrenthren vesnar\u00d7izya."}]},{"blockId":"block.5ed8d5ad097b49e6947d0a302fd22af4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.273","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblygrenmem: Y\u00eblyemargren mem\u2019m\u00e7 t\u00d7 \u00d1e\u00d5 d\u00c7\u00d3 venka y\u00cd\u00d7 jw\u00ebn\u2019m\u00e7 r\u00d7owya."}]},{"blockId":"block.d2b62abf4a0b420c8ed77bc58121cc16","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.343","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vimin\u2019m\u00e7 vesnalen o\u00c3\u2019jw\u00ebnizya. T\u00d7 \u00d1e\u00d5 \u00e5v \u00d3\u00c5tusol y\u00eblygrenmem r\u00d7izya \u00e3\u00d1 lym g\u00e7z\u00e9lizya."}]},{"blockId":"block.f5cf53ca081c4102bd45c653e9f095f9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.429","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytjemvejem: Den gren y\u00eblyemar\u00e7ztjem \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.e329f5e108fc47979729c404c3a731a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.508","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblyemar\u00e7ztjem ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblytjemvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.37f64f5806a04c9d8ad1b7bb33d9e789","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.606","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytjemvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblyemar\u00e7ztjem po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.2cdadb1e9f834b1cab5e2f15115e0755","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.672","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemar\u00e7ztjem b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblytjemvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.1997297a104148bebbde770038df58f0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.751","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytjemfader: Y\u00eblyemar\u00e7ztjem \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.b8f52cdccb5548e7b42b9a66612e89c3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.856","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblytjemfader tav \u00e5vizya."}]},{"blockId":"block.80791bd6a5e24e5cba8509bc5fc0299a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.950","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblythar\u00cb\u00cdnon: Y\u00eblyemar\u00e7ztthar \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.7e459519457c4e3c861dc8e3ced37af0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1039","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00eblythar\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]},{"blockId":"block.827aebb314584f089e46251ff5cce2cf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1131","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytharveerb: Y\u00eblyemar\u00e7ztthar \u00d1etib s\u00dflum \u00cbers nerbyal f\u00d7owya \u00e3\u00d1 t\u00d7 \u00d1etib broft\u2019jw\u00ebnowya."}]},{"blockId":"block.5bf058e974c7477bb870a91174ef8917","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1222","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna tremb\u00c5r ilna\u2019m\u00e7 falnthren \u00cbers vengraf f\u00d7izya. R\u00e1\u2019y\u00eblytharveerb r\u00e1 p\u00e1n s\u00ebvenun nerbyalizya."}]},{"blockId":"block.0cd6f7dc338c42188a922e4e15739042","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytharin\u00dfb\u00df: Y\u00eblyemar\u00e7ztthar k\u00e3m vesna s\u00dflum nerbyalizya f\u00d7\u2019en p\u00c7n\u00df\u00eb t\u00d7 k\u00cfba\u00d1\u2019m\u00e7 f\u00c7l broft\u2019en."}]},{"blockId":"block.38859dea94084b71bfd4201f1122ef65","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1417","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nerbyal za\u2019k\u00cfba\u00d1 r\u00d7izya. R\u00c7n\u00d3 r\u00e1\u2019tremb\u00c5r r\u00e1 y\u00eblytharin\u00dfb\u00dfizya \u00e3\u00d1 t\u00d7 murlametw\u00c5vum r\u00e1 broftizya."}]},{"blockId":"block.964291db2e4f4e53912ff62bbb939b4e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1513","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblythinke\u00dbon: H\u00c5b\u00cden i y\u00eblyemarh\u00ebthin \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":99,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":100,"end":182,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":183,"end":272,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":273,"end":342,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":343,"end":428,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":429,"end":507,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":508,"end":605,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":606,"end":671,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":672,"end":750,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":751,"end":855,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":856,"end":949,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":950,"end":1038,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1039,"end":1130,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1131,"end":1221,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1222,"end":1319,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1320,"end":1416,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1417,"end":1512,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1513,"end":1599,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}],"paragraphs":[{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]}]}}]},{"pageId":"page.collected.00060","name":"yalta","width":"612000000","height":"792000000","margins":{"left":"72000000","right":"54000000","top":"48000000","bottom":"71000000"},"frames":[{"frameId":"frame.collected.00060","name":"yalta","x":"72000000","y":"48000000","width":"486000000","height":"673000000","overflow":"show","content":{"document":{"schemaVersion":"0.1.0","documentId":"document.conventionaldictionary.letter.36","revision":0,"title":"yalta","layoutProfile":"layout.qt-6.8.3-m2","languageRevision":null,"fonts":[{"fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblythinke\u00dbon"}]},{"blockId":"block.2bdc63bae83141159b672d25e3b83637","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyz\u00cben\u00cb\u00cdnon"}]},{"blockId":"block.871b8243b2f2476ab889472823e9ef7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.28","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblythinke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.382cca609e144372b66547af695e8ca8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.114","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblythinake\u00dbon: Y\u00eblyemarh\u00ebthin \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.b241023727134b9291ff4b8fb3f0637a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.204","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblythinake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.9c97ab27909b4ccaa1bb493155f15a5c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.275","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblythinden: Neks w\u00c5vumen i y\u00eblyemarh\u00ebthin \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.f4f458824dc049f4895581cc115f1461","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.370","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblythinden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.4a8c721e4c8e4bea9dbbf0b018b05437","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.446","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytust\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00eblyemar marven \u00d3\u00c5tus\u2019t vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]},{"blockId":"block.ed57a0085bb440d3a83be53486866f0c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.550","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren nor\u00d3aint\u00dff\u00c9ben vesna den kojizya. Vin d\u00c7\u00d3 t\u00e7lizya ol \u00e5\u00c3 y\u00eblytust\u00cb\u00cdnon elyi\u00d1izya."}]},{"blockId":"block.fe8126981e414645bee83b2764a1944d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.636","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytustlarod: Y\u00eblyemar marven \u00d3\u00c5tus\u2019t \u00e5\u00c3 falib s\u00dflumun jw\u00ebnenplesten\u2019m\u00e7 d\u00c7\u00d3 \u00cbers lamprod y\u00c9nenowya."}]},{"blockId":"block.bbff9f7333d349e6a48c058c8126b238","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.737","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den gren nor\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00eblytustlarod wa\u00d9gumizya."}]},{"blockId":"block.b0928410378047b89a0c43f4d1dedcd6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.851","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblytustnoven: S\u00dflum falib d\u00c7\u00d3 i y\u00eblyemar marven \u00d3\u00c5tus\u2019t t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]},{"blockId":"block.3aabfb4067fb4061a81da850acea2ee8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.946","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemar marven \u00d3\u00c5tus\u2019t sezif\u00c7\u00c3izya. Y\u00eblytustnoven taren f\u00c5wizya \u00e3\u00d1 braden sezif\u00c7\u00c3izya."}]},{"blockId":"block.05ee49d3d739409b802653a917fce6cc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1034","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00d3vemgi\u00cden: Y\u00eblyemarr\u00c7n\u00d3vem vin threnins\u00dflumun r\u00c7n\u00d3 neksus giktenv\u00d7j\u00cden falnthrenowya."}]},{"blockId":"block.9a8b871b176340e388a57ba1305535aa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1124","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ol ven\u2019m\u00e7 r\u00d7izya. Yib\u2019\u00ebw h\u00ebth ikamo\u00d1ton y\u00ebly\u00d3vemgi\u00cden broftizya."}]},{"blockId":"block.ac2613acb31a4fdc982502043df7dbc0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1189","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00d3vemthren: S\u00dflumun thavvim y\u00eblyemarr\u00c7n\u00d3vem falibi d\u00c7\u00d3 r\u00c7n\u00d3 po kl\u00e1rimowya venka den ma\u2019\u00ddvimowya."}]},{"blockId":"block.c3ea58f3dc634b9bacb978c314792479","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1289","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nor\u00d3aint\u00dff\u00c9ben zyrizya. Rav lym y\u00ebly\u00d3vemthren \u00d3\u00c5\u00e7izya t\u00d7 zem\u2019d\u00c7\u00d3 gimer tarenizya."}]},{"blockId":"block.5ab1b48cdc7c4f2da97b0bece1655140","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1371","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00d3vemneyal: Y\u00eblyemarr\u00c7n\u00d3vem falibi threnins\u00dflumun \u00c3\u00cd\u2019jw\u00ebnizya p\u00c7n\u00df\u00eb t\u00d7 \u00d1e\u00d5 d\u00c7\u00d3 dlen\u00dbeminizya."}]},{"blockId":"block.31b6a4b98a934a7893576574d94a46b0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1468","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Daral \u00c5el\u2019m\u00e7 r\u00d7izya. Lym tav tarenizya yib\u2019\u00ebw \u00d1ed falib dlen\u00dbeminizya. \u00d0em y\u00ebly\u00d3vemneyal r\u00d7izya."}]},{"blockId":"bloc