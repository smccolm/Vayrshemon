frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblveranfader"}]},{"blockId":"block.295acc345c03474da1e5a2c995d16562","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzet\u00d3\u00ddrventremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.72286edba254495a80666a092c868144","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.69","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblveranfader tav \u00e5vizya."}]},{"blockId":"block.de99a257d76f480e939bc2c364ec5e88","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.163","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzet: 1 y\u00ebl verzet."}]},{"blockId":"block.e5a8a15c48304cb69377122ceddbb22d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 ven\u00e1l i y\u00eblverzet kinos r\u00d7owya m\u00dfrnav po vel dest\u00eb\u00c5imowya ka po tav verzetpelnaatya \u00e3\u00d1 ka po\u2019mel Y\u00eblen ma\u2019f\u00e7satya."}]},{"blockId":"block.3fb2ea7a8edc41478184d17e50f295ef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.306","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00ebl verzet."}]},{"blockId":"block.22c8eb75ae4a490abbfcac7ca3a3af1c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin komna venamget thar tinowya po, faren Jov\u2019y\u00eblverzet \u00d3\u00c5\u00e7imowya\u2019lah po."}]},{"blockId":"block.61ae36ffb1ae4ca6a90fc4d1f5b3207f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.394","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzet r\u00c7n\u00d3 velf\u00ebr ningi: S\u00dflum vesnaunel velin\u2019m\u00e7 \u00d3\u00e1lun\u00c3owya vinel ni w\u00c5vumen gimam d\u00c7\u00d3 v\u00c5lf\u00d7owya. Dlenson\u2019m\u00e7 s\u00dflum gurin d\u00c7\u00d3s\u00dflumun kom arvlamimowya."}]},{"blockId":"block.09557764d8dc449c855586654d0f1103","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.549","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni klojvor mav s\u00dflum r\u00e1\u2019melan j\u00cdizya. Ni harven za za\u2019ol govis r\u00c7n\u00d3 giktenv\u00d7j\u00cden zyrizya. Y\u00eblverzet r\u00c7n\u00d3 velf\u00ebr ningi r\u00d7izya za."}]},{"blockId":"block.a3dc79bd88674282b22c8efa6337fc81","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.678","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzet paven lunor s\u00c7fizya: T\u00d7 d\u00c7\u00d3 s\u00dflum lomih d\u00c7\u00d3\u00d1et nerbyal\u2019en falibi k\u00cfba\u00d1 f\u00c7l tw\u00ddnjybowya f\u00ebr\u00d3. \u00d0etib paven ragumowfu jem\u00e3e."}]},{"blockId":"block.94535eb074b14ebcac09ce407d40f8b7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.810","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venor giktenv\u00d7en ly\u2019melan ma\u2019f\u00c5w\u2019jw\u00ebnizya. \u00e4\u00d1hefak r\u00c7n\u00d3 neksus w\u00cf\u00dfen za h\u00eb\u00d5izya. Y\u00eblverzet paven lunor s\u00c7fizya, h\u00c5b\u00cdtorpgur tondaizya \u00e3\u00d1 zaget nerbyalizya."}]},{"blockId":"block.a779035cca69438f962e88de34c86e9c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.966","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzet mel kwesta venam: y\u00eblverzet mel kwesta venam."}]},{"blockId":"block.fe5d7a2cd80840fe8bbdbd6e3a05919b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1022","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna p\u00e1l\u00dfn var\u00ebl y\u00eblverzet mel kwesta venam \u00d3\u00c5\u00e7imowya. Po\u2019venam minlammarin, p\u00c7n\u00df\u00eb y\u00eblverzet jemin naor \u00e3\u00d1 gim jw\u00ebnenplesten; haren\u2019\u00ebw y\u00eblyemarkojun a\u00d9\u2019en \u00e5vimowya."}]},{"blockId":"block.9e98bbc4f51946218752aa6aed229725","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetkrannimel: y\u00eblverzet kranni mel."}]},{"blockId":"block.1671da4e05d748dc99c0eb541e15bd74","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1230","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vor \u00e3\u00d1 l\u00dfn y\u00eblp\u00c5rvimin lomih y\u00eblp\u00c5ry\u00ebletharen l\u00ddn\u00c5r p\u00c7n\u00df\u00eb h\u00eb\u00d5\u2019na k\u00e3m naor ma\u2019r\u00d7owya \u00d1e\u00d5 y\u00eblverzet. Y\u00eblverzetshalem \u00e3\u00d1 y\u00ebl jw\u00ebnenplesten thirilin jw\u00ebnenplesten shalen l\u00ddn\u00c5r, y\u00eblverzetkrannimel y\u00eblverzet i y\u00eblverzetve\u00dbmel l\u00ddn\u00c5r ve\u00db y\u00eblverzetve\u00dbmel i plesten r\u00d7owya."}]},{"blockId":"block.1b63e55fc3ce418c995f9afdb9dbc218","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1494","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetgorenvenam: y\u00eblverzet goren venam."}]},{"blockId":"block.a212fdb8eb3d4f6e84bb115ca6f5dc9c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1538","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblverzetgorenvenam, al y\u00eblverzetgorenvenam \u00d3\u00c5\u00e7im, gimen \u00e3\u00d1 l\u00dfn ni verzetjelgl\u00c9st venam r\u00e3b gim l\u00ddn\u00c5r r\u00d7owya. Y\u00eblverzetun a\u00d9\u00d5\u00dfrowya \u00d1etib \u00e3\u00d1 zem\u2019venam ragumowya f\u00c7l al gimam l\u00ddn\u00c5r."}]},{"blockId":"block.781f6d2eb31a4002bf952a7695d709b6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1719","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzet\u00d3\u00ddrven: y\u00eblverzet \u00d3\u00ddrven."}]},{"blockId":"block.290bcf51db4e49b09a46f7cea825237e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1754","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gim\u00dfv y\u00eblverzet\u00d3\u00ddrven \u00d5\u00dfrowya kinos, \u00d3\u00ddrven l\u00ddn\u00c5r p\u00c7n\u00df\u00eb gimam y\u00cd\u00d7goren \u00d5\u00dfrvor."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":68,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":69,"end":162,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":163,"end":187,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":188,"end":305,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}