d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyjem\u00e3twjyb"}]},{"blockId":"block.4666c74aab9e47c199fb8a5e94c74549","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyrjo\u00d9fader"}]},{"blockId":"block.4ed848d7a9304f44837a928bbeaa5da2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.28","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym ni y\u00eblyemarjem\u00e3 t\u00e7lh\u00eb\u00d5izya p\u00c7n\u00df\u00eb ma\u2019o\u00c3ilizya. Ni y\u00eblyjem\u00e3twjyb \u00d3\u00c5tusol wa\u00d9gumizya."}]},{"blockId":"block.d0d54420c30f48428da984546d46b598","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.115","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyaren\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum haren vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]},{"blockId":"block.0a2e037a24544f1d99ba4f371f9faad1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.224","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren nor\u00d3aint\u00dff\u00c9ben vesna den kojizya. Vin d\u00c7\u00d3 t\u00e7lizya ol \u00e5\u00c3 y\u00eblyaren\u00cb\u00cdnon elyi\u00d1izya."}]},{"blockId":"block.3876e7ae7e604072803b5d0c6796d3a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.310","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyarenlarod: Y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum haren \u00e5\u00c3 falib s\u00dflumun jw\u00ebnenplesten\u2019m\u00e7 d\u00c7\u00d3 \u00cbers lamprod y\u00c9nenowya."}]},{"blockId":"block.cf3168ce89a342e4874fd13e8c25cdea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.416","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den gren nor\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00eblyarenlarod wa\u00d9gumizya."}]},{"blockId":"block.836748911bee4b799ad0670c6f203398","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.530","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyarennoven: S\u00dflum falib d\u00c7\u00d3 i y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum haren t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]},{"blockId":"block.58c494d704f4482598ce97d235c54dfc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.630","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum haren sezif\u00c7\u00c3izya. Y\u00eblyarennoven taren f\u00c5wizya \u00e3\u00d1 braden sezif\u00c7\u00c3izya."}]},{"blockId":"block.da1d51523a514b9580fc178cd8182797","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.723","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyrjo\u00d9\u00cb\u00cdnon: Y\u00eblyemarmarjo\u00d9 \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.a663f5abba2745efb58b8643b3b086d8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.811","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00eblyrjo\u00d9\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]},{"blockId":"block.d51f93bd7ef8413d9cdae3236bdfcc89","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.903","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyrjo\u00d9vejem: Den gren y\u00eblyemaryems\u00d7marjo\u00d9 \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.134042e7ed724a46ba73b33239e10c02","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.987","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblyemaryems\u00d7marjo\u00d9 ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblyrjo\u00d9vejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.81ba94917e844ff3a69f3d3c897b2646","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1090","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyrjo\u00d9veerb: Y\u00eblyemarmarjo\u00d9 \u00d1etib s\u00dflum \u00cbers nerbyal f\u00d7owya \u00e3\u00d1 t\u00d7 \u00d1etib broft\u2019jw\u00ebnowya."}]},{"blockId":"block.cf60a1c5f50a492a95d6e72f2591cb21","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1180","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna tremb\u00c5r ilna\u2019m\u00e7 falnthren \u00cbers vengraf f\u00d7izya. R\u00e1\u2019y\u00eblyrjo\u00d9veerb r\u00e1 p\u00e1n s\u00ebvenun nerbyalizya."}]},{"blockId":"block.245ecd34982a4231992e46170ff48290","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1278","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyrjo\u00d9vesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblyemaryems\u00d7marjo\u00d9 po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.30238a99af094b0795d99016c1d17f76","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1349","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemaryems\u00d7marjo\u00d9 b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblyrjo\u00d9vesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.1e7d296d745c4ef4a95300863c975636","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1433","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyrjo\u00d9fader: Y\u00eblyemaryems\u00d7marjo\u00d9 \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.39213c7f4bce4df0898c452b9af85c25","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1543","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblyrjo\u00d9fader "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":114,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"sta