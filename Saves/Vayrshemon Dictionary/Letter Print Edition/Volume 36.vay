ntId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblprzetf\u00ebr"}]},{"blockId":"block.1ffeca83887f494eb3505fe2cce46eac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.12","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpnm\u00ebr\u00d1\u00e9\u00d9gl\u00c9stowya."}]},{"blockId":"block.8f18e17e9b8c4e5db415dde07ece7bbf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.34","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblp\u00c5r mayemszarunthen y\u00eblverzet \u00e3lumizya. \u00caers y\u00eblprzetf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.f78bc4d2df4a4a3fbecd03ad7c22591a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.131","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpenamke\u00dbon: H\u00c5b\u00cden i y\u00eblp\u00c5rvenam \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.3d1cf38a6ad04d0ab891078434d8f127","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.215","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblpenamke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.4636122017f94fa29257e5a0f5069fa2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.301","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpenamake\u00dbon: Y\u00eblp\u00c5rvenam \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.463c1706228c4ae2a5ccdca0bd52289d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.388","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblpenamake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.5e1e82d3cc8d4b5fa4b6f4c70334d791","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.459","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpenamden: Neks w\u00c5vumen i y\u00eblp\u00c5rvenam \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.c7fa84fe8b814220b2c9249b58692ff2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.551","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblpenamden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.cee8f730ea604b67808ece3c5d8ea336","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.627","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpmm\u00ebrjebra: Y\u00eblp\u00c5rnil\u00ebmm\u00ebr \u00d1etib p\u00e1n klojvord\u00cdn\u00d7r \u00e5\u00c3 vesna s\u00dflum paven lametf\u00ebr\u00d3imowya."}]},{"blockId":"block.97b955f5c53041e1b1ddaaae46e3f57d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.718","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel venim ma\u2019t\u00e7lowfu. R\u00e1 z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum vesna d\u00cdn\u00d7r f\u00c5wizya \u00e3\u00d1 y\u00eblpmm\u00ebrjebra t\u00d7 pel jem\u00e3izya."}]},{"blockId":"block.00743d3c2c614fac8c36dc691c387645","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.810","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpmm\u00ebr\u00d1\u00e9\u00d9: \u00d0\u00e9\u00d9 i y\u00eblp\u00c5rnil\u00ebmm\u00ebr \u00d1etib h\u00ebth klojvord\u00cdn\u00d7r dlen\u00dbeminowya."}]},{"blockId":"block.b379e0019d3947fb9640edd97b53950b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.883","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00cdn\u00d7r borel masif\u2019m\u00e7 r\u00d7izya. \u00caers y\u00eblpmm\u00ebr\u00d1\u00e9\u00d9 r\u00e1 \u00d1etib lym wemizya h\u00c5b\u00cdizya."}]},{"blockId":"block.846cb16af21244d0845f39860e2cfeca","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.960","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblpmm\u00ebrin\u00dfb\u00df: Threnin i y\u00eblp\u00c5rnil\u00ebmm\u00ebr t\u00d7 s\u00dflum falib venim ma\u2019t\u00e7lh\u00eb\u00d5owfu jem\u00e3imowya."}]},{"blockId":"block.313cd37483e0407e8fc36517134320f4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1047","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00cd\u00d7 y\u00eblp\u00c5rnil\u00ebmm\u00ebr w\u00cf\u00dfizya. R\u00e1 y\u00eblpmm\u00ebrin\u00dfb\u00df