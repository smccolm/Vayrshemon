"none","text":"y\u00ebleil\u00ebm\u00cb\u00cdnony\u00eblendest\u00eb\u00c5nil\u00ebmim m\u00dfrnav, vesna ol Venor venam a\u00d9\u00d5\u00dfrowya."}]},{"blockId":"block.82c72205bced4ea487ed5c08ae15469d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.89","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblengi\u00cden: Y\u00eblen vin threnins\u00dflumun r\u00c7n\u00d3 neksus giktenv\u00d7j\u00cden falnthrenowya."}]},{"blockId":"block.a17186d4b2b04b9c9e8e758c427a2f75","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.166","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ol ven\u2019m\u00e7 r\u00d7izya. Yib\u2019\u00ebw h\u00ebth ikamo\u00d1ton y\u00eblengi\u00cden broftizya."}]},{"blockId":"block.f038be02a0c84ea5af708ea2aa45b140","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.228","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblentarven: Y\u00eblen tarven."}]},{"blockId":"block.cc484e33bd064e82b0b5ea7de8445566","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.255","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"N\u00d7nen r\u00c7n\u00d3 kwestaarowya\u2019na zi\u2019slebteral t\u00e9z\u2019m\u00e7 \u00e3\u00d1 mayems\u2019m\u00e7 k\u00e3m y\u00eblentarven r\u00c7n\u00d3 slebizya \u00e3\u00d1 ufolizya k\u00e3m jw\u00ebnenplesten\u2019m\u00e7 k\u00e3m Delos veneks nivirowya\u2019na dlen zi\u2019veritas Gorgon\u2019na jw\u00ebnenplesten\u2019en r\u00c7n\u00d3 kl\u00e1rjemizya ma\u2019da\u00c3\u2019en."}]},{"blockId":"block.1861ee7e35e64f6da579ece560a4d19c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.479","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblenthren: S\u00dflumun thavvim y\u00eblen falibi d\u00c7\u00d3 r\u00c7n\u00d3 po kl\u00e1rimowya venka den ma\u2019\u00ddvimowya."}]},{"blockId":"block.ac7a77b4b7174729a2a78cd040c7a103","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.566","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nor\u00d3aint\u00dff\u00c9ben zyrizya. Rav lym y\u00eblenthren \u00d3\u00c5\u00e7izya t\u00d7 zem\u2019d\u00c7\u00d3 gimer tarenizya."}]},{"blockId":"block.88d62c96ddba432397a200322689a88f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.645","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblenthrenina\u00d9: Y\u00eblen threnina\u00d9."}]},{"blockId":"block.2f890b897e0a4065bfdd52d1f12ecc0c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.678","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Na greljo\u00d9 marjo\u00d9l\u00c9y y\u00eblenthrenina\u00d9izya."}]},{"blockId":"block.bd526a4e6c214fb18bd7a4530c6c5d15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.719","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblenneyal: Y\u00eblen falibi threnins\u00dflumun \u00c3\u00cd\u2019jw\u00ebnizya p\u00c7n\u00df\u00eb t\u00d7 \u00d1e\u00d5 d\u00c7\u00d3 dlen\u00dbeminizya."}]},{"blockId":"block.32aa1b6ee2e54d0b91c79cc01a820e45","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.803","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Daral \u00c5el\u2019m\u00e7 r\u00d7izya. Lym tav tarenizya yib\u2019\u00ebw \u00d1ed falib dlen\u00dbeminizya. \u00d0em y\u00eblenneyal r\u00d7izya."}]},{"blockId":"block.f295d49ccec84a188e196762571b2b63","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.897","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblest\u00eb\u00c5\u00cb\u00cdnon: Y\u00eblendest\u00eb\u00c5 \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.ccd52390879e4f4f98cce400e4bbec4c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.982","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00eblest\u00eb\u00c5\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]},{"blockId":"block.689c1aeda52c416080a3138bac4501ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1074","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblest\u00eb\u00c5veerb: Y\u00eblendest\u00eb\u00c5 \u00d1etib s\u00dflum \u00cbers nerbyal f\u00d7owya \u00e3\u00d1 t\u00d7 \u00d1etib broft\u2019jw\u00ebnowya."}]},{"blockId":"block.129b8e0943e945dab6505a97725749ba","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1161","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna tremb\u00c5r ilna\u2019m\u00e7 falnthren \u00cbers vengraf f\u00d7izya. R\u00e1\u2019y\u00eblest\u00eb\u00c5veerb r\u00e1 p\u00e1n s\u00ebvenun nerbyalizya."}]},{"blockId":"block.2b7e4168549c4c5db2e258c99b57b82b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1259","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblest\u00eb\u00c5in\u00dfb\u00df: Y\u00eblendest\u00eb\u00c5 k\u00e3m vesna s\u00dflum nerbyalizya f\u00d7\u2019en p\u00c7n\u00df\u00eb t\u00d7 k\u00cfba\u00d1\u2019m\u00e7 f\u00c7l broft\u2019en."}]},{"blockId":"block.d543d7a2319c4cb080499dee126f8b74","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1352","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nerbyal za\u2019k\u00cfba\u00d1 r\u00d7izya. R\u00c7n\u00d3 r\u00e1\u2019tremb\u00c5r r\u00e1 y\u00eblest\u00eb\u00c5in\u00dfb\u00dfizya \u00e3\u00d1 t\u00d7 murlametw\u00c5vum r\u00e1 broftizya."}]},{"blockId":"block.898b43fc8d7843c9bb644cff0a119d7a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1448","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebleil\u00ebm\u00cb\u00cdnon: Y\u00eblendest\u00eb\u00c5nil\u00ebm \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":16,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":17,"end":88,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":89,"end":165,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":166,"end":227,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":228,"end":254,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":255,"end":478,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":479,"end":565,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":566,"end":644,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":645,"end":677,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":678,"end":718,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":719,"end":802,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":803,"end":896,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":897,"end":981,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":982,"end":1073,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1074,"end":1160,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{