00000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebllunivel murlametw\u00c5v"}]},{"blockId":"block.916a3743a5594d7dafebb6a3578880ec","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.23","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelw\u00cfn\u00c7\u00e7ztthavim\u2019jw\u00ebnowya vinel y\u00cd\u00d7 y\u00ebl dlen\u00dbeminowya. Ni neks kelde\u00dbon s\u00dflumget marin murarsevar \u00e3lum\u2019en \u00c3ahe."}]},{"blockId":"block.2079e44db7314851a57a2c8d154726ad","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.138","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks \u00ddvton tarthav\u2019m\u00e7 r\u00e1\u2019pelen dest\u00eb\u00c5izya. Y\u00ebllunivel murlametw\u00c5vum jem\u00e3\u2019en \u00c3ahe, y\u00ebld\u00c7\u00d3s\u00dflum tondaizya \u00e3\u00d1 yat\u2019m\u00e7 ub\u00e1nt\u00e9v gl\u00c9stizya."}]},{"blockId":"block.75246f4e9d2e4532bc2b779903140b29","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.271","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmel: 1 y\u00eblverzet falibi venam melyemget f\u00c5wowya."}]},{"blockId":"block.cd15a646b4c14b18a810c1bbf4d1b30e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.323","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venm\u00ebr\u2019ni\u2019\u00e3 ziel murill\u00c9y t\u00e7lizya ni. \u00e2\u00d1 o\u00c3, za\u2019tom\u2019ni \u00e7ztdestim\u2019na y\u00eblmel\u2019y\u00ebletl\u00c9y r\u00d7izya. Kom jo\u00d9ol\u2019tha yems\u00d7l\u00c9y vimar gim\u00cba\u00d5izfu, ka Noahl\u00c9y h\u00c5b\u00cdizya."}]},{"blockId":"block.a476452198fc4dd0bfe76ed09280c6a4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.477","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00eblverzet falibi venam melyem f\u00c5wmarjo\u00d9owya."}]},{"blockId":"block.3f99bc9d75cc407689d635104e123ecd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.524","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"M\u00dfrnav farvengraf\u2019m\u00e7 Yel r\u00d7owya \u00d1e\u00d5, jo\u00d9ol r\u00c7n\u00d3 venik maser\u00c3\u00cdzarilun maser\u00ebw y\u00eblmelget a\u00d9\u00d5\u00dfratya."}]},{"blockId":"block.8ad333c87ea74850ae64e42b4b7a47a8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.622","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelp\u00e1in: Y\u00eblmel \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.29241f0b01df4e4d8d5e7041a8a6461b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.682","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblmelp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.0d8ff6285c0d44a3b22dd72b73359f7d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.773","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelvevor: Threnin i y\u00eblmel \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.5e4f2f8536d54b6a9b515d3d5ae95b13","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.838","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblmel \u00e7ztizya. R\u00e1 y\u00eblmelvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.23911e90e2ae47db8670f4029119331e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.908","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelf\u00ebr: \u00e2lum i y\u00eblmel \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.86f670164d324a00957913ad62ba4eb1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.962","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblmel \u00e3lumizya. \u00caers y\u00eblmelf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.2b1a70a5fa0f4953b68ce4a553fbee5b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1031","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelnavejem: Den gren y\u00eblmlapv\u00d7sta grelna \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.eb489a77ed3a4307ad67e2c20061b9f3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1115","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblmlapv\u00d7sta grelna ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblmelnavejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.9cd787a7f9f94c2ea8a2843a47ad4088","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1218","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelnavesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblmlapv\u00d7sta grelna po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.24dd5ff82db648369f2ffe42d0153d90","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1289","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblmlapv\u00d7sta grelna b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblmelnavesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.12a3175219cd4b86b6be4a7d6e1b946d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1373","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelnafader: Y\u00eblmlapv\u00d7sta grelna \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.1235f69aacee4c83874beed366b52cb3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1483","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblmelnafader tav \u00e5vizya."}]},{"blockId":"block.a4934b2421834cd98a4459fd811fc185","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1577","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmelw\u00cfn\u00c7: m\u00c5rum i melyem."}]},{"blockId":"block.b3e90cb950b04cc5b21c13f5173e6c47","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1605","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ne\u2019w\u00cfn\u00c7un \u00e3\u00d1 ne\u2019vemelw\u00cfn\u00c7un \u00e3\u00d1 ne\u2019y\u00eblmelw\u00cfn\u00c7un aleth farol i zemget zi \u00e7ztatya \u00e3\u00d1 \u00e5\u00c3 zi\u2019d\u00c7vun zemget f\u00c5watya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":22,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":23,"end":137,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":138,"end":270,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":271,"end":322,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":323,"end":476,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":477,"end":523,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":524,"end":621,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":622,"end":681,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":682,"end":772,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":773,"end":837,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":838,"end":907,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":908,"end":961,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":962,"end":1030,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1031,"end":1114,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1115,"end":1217,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1218,"end":1288,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1289,"end":1372,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1373,"end":1482,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1483,"end":1576,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1577,"end":1604,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1605,"end":1714,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}],"paragraphs":[{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","b