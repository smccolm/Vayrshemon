unId":"run.qt.337","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00e9\u00dbnain\u00dfb\u00df: Voril i y\u00eblthrenin ni y\u00e9\u00dbna \u00d1etib vesna s\u00dflum p\u00e1n k\u00cfba\u00d1s\u00dflum giktenv\u00d7owya denowya."}]},{"blockId":"block.a6e26e1974e24d9698252f60cdef4fb7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.435","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 tonun venim ma\u2019s\u00c7fizya. Vin za den f\u00c5wizya r\u00e1 ni za\u2019tonun r\u00e1\u2019y\u00eblt\u00e9\u00dbnain\u00dfb\u00df t\u00d7y\u00dfb\u00dfizya."}]},{"blockId":"block.c901e3f4513d447f8a18a805cf3c57c5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.525","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00ebnalavejem: Den gren y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnal \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.7604f805d5eb4dd8bbe9e591338798c4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.623","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnal ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblt\u00ebnalavejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.16f7c7bcdc40401eba939f33a1f09bad","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.740","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00ebnalavesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnal po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.f72cd6e7538640f3b9e386d94e155400","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.825","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnal b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblt\u00ebnalavesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.d186a71ff9c44f0ba72036fff8401343","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.923","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00ebnalafader: Y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnal \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.bd221575855e4170ae296249ebf3cff6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1047","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblt\u00ebnalafader tav \u00e5vizya."}]},{"blockId":"block.8b392f21705b49278fa2ecf38990dfa9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1142","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00ebnalvejem: Den gren y\u00ebltalthirils\u00ebnal \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.72b319f0f2b8454abfe5885e3396c790","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1224","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebltalthirils\u00ebnal ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblt\u00ebnalvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.eb3dc8e2919640a9b0c7ab2979159d42","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1325","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00ebnalvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00ebltalthirils\u00ebnal po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.79769363f9144553bf76fb9905527f45","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1394","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebltalthirils\u00ebnal b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblt\u00ebnalvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.dea635fa1b2a4512983e3fd8bc1f1371","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1476","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblt\u00ebnalfader: Y\u00ebltalthirils\u00ebnal \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.842b0052e7c94e54a0f7c8be2813780b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1584","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblt\u00ebnalfader tav \u00e5vizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":116,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":117,"end":176,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":177,"end":265,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start