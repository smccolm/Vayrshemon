nt":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]}]}}]},{"pageId":"page.collected.00039","name":"yalta","width":"612000000","height":"792000000","margins":{"left":"54000000","right":"72000000","top":"48000000","bottom":"71000000"},"frames":[{"frameId":"frame.collected.00039","name":"yalta","x":"54000000","y":"48000000","width":"486000000","height":"673000000","overflow":"show","content":{"document":{"schemaVersion":"0.1.0","documentId":"document.conventionaldictionary.letter.36","revision":0,"title":"yalta","layoutProfile":"layout.qt-6.8.3-m2","languageRevision":null,"fonts":[{"fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletm\u00ebr"}]},{"blockId":"block.21a289216311410b92159990cb6cd5f6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.9","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblemvorden"}]},{"blockId":"block.c8257ec84c444c12ba3c86ddf439cbc2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.21","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gimam v\u00eblinmel ni \u00d1e\u00d5 jo\u00d9 a\u00d9imowya, \u00e3\u00d1 kinos tha ni gimamem y\u00ebletm\u00ebr y\u00c9nenimowya, gimam \u00e5vim\u2019es kinos \u00e3\u00d1 Tonkin \u00e3\u00d1 Ko\u00d1in\u00d1ina ni t\u00d7 \u00e1pe\u00dbem m\u00ebr."}]},{"blockId":"block.6d3496906a1f4d71800326fe0b92f503","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.164","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletm\u00ebrjebra: Y\u00ebletm\u00ebr \u00d1etib p\u00e1n klojvord\u00cdn\u00d7r \u00e5\u00c3 vesna s\u00dflum paven lametf\u00ebr\u00d3imowya."}]},{"blockId":"block.8e30aae2660c46528b3a3afa0aa50340","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.249","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel venim ma\u2019t\u00e7lowfu. R\u00e1 z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum vesna d\u00cdn\u00d7r f\u00c5wizya \u00e3\u00d1 y\u00ebletm\u00ebrjebra t\u00d7 pel jem\u00e3izya."}]},{"blockId":"block.b9274efeab5a41298e6eaf44429c347c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.341","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletm\u00ebr\u00d1\u00e9\u00d9: \u00d0\u00e9\u00d9 i y\u00ebletm\u00ebr \u00d1etib h\u00ebth klojvord\u00cdn\u00d7r dlen\u00dbeminowya."}]},{"blockId":"block.1ee947517f5d488093dfc39fccaf459e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.408","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00cdn\u00d7r borel masif\u2019m\u00e7 r\u00d7izya. \u00caers y\u00ebletm\u00ebr\u00d1\u00e9\u00d9 r\u00e1 \u00d1etib lym wemizya h\u00c5b\u00cdizya."}]},{"blockId":"block.899e5e5629dc41b7b5241153cb9a528b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.485","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletm\u00ebrin\u00dfb\u00df: Threnin i y\u00ebletm\u00ebr t\u00d7 s\u00dflum falib venim ma\u2019t\u00e7lh\u00eb\u00d5owfu jem\u00e3imowya."}]},{"blockId":"block.c7cd91e0393c47a98a88c87763b7008b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.566","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00cd\u00d7 y\u00ebletm\u00ebr w\u00cf\u00dfizya. R\u00e1 y\u00ebletm\u00ebrin\u00dfb\u00df shalenizya. Z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum velin gren marjo\u00d9 r\u00d7izya."}]},{"blockId":"block.2acbec153b0f40e7ab84224377dc39df","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.660","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletsh\u00eblen: y\u00eblet sh\u00eblen."}]},{"blockId":"block.03d8eb57a8d94712959d2106d35cc719","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.687","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Falib tha azar lomih rennave\u00dbzar lomih y\u00ebletsh\u00eblen t\u00d7 r\u00e1el k\u00e3m gim\u00dfv stras vorenetun klojatya k\u00e3m stras\u2019jw\u00ebnowya r\u00e1 tha m\u00ebrikkw\u00d7sil lomih nil\u00ebm i vemelun ni vesna marjo\u00d9un f\u00d7r\u00c7n\u00d3im\u2019na, pomf\u00c5w\u2019lahowya r\u00e1el graf\u00d1et \u00d1etib r\u00c7n\u00d3 gimam farbroft pomatya r\u00e1."}]},{"blockId":"block.47d76e871e884a588d7279f306632358","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.938","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblez\u00cbenvejem: Den gren y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cben \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.b0a7436359a8452b8012b81247a7f484","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1027","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cben ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblez\u00cbenvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.c3ffd124ef2a415e856694df38578222","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1135","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblez\u00cbenvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cben po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.0783846b6b36489bac4f7a6ec1ea17de","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1211","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cben b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblez\u00cbenvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.a9a22f99b0a244ffbb7554c5aa4210d2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1300","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblez\u00cbenfader: Y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cben \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.f230416d739042a2b7e47edac88f5d20","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1415","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblez\u00cbenfader tav \u00e5vizya."}]},{"blockId":"block.d9f740e1927743b592aa7806eb1d2706","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1509","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblemvorjeem\u00e3: \u00e6l\u00d7on k\u00c7nib y\u00ebletvimvor vingim sezif\u00c7\u00c3owya t\u00d7 jemekjem\u00e3."}]},{"blockId":"block.99331cb461ba4c32b44ec9f086ed66c6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1581","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n y\u00ebletvimvor kin o\u00c3braizya. Venyel tav. Lym tha y\u00eblemvorjeem\u00e3 \u00c3\u00cdthavizya."}]},{"blockId":"block.2c2e1a8262d54db4a65c51a3c161cf12","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1661","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblemvorden: Den i y\u00ebletvimvor \u00cbers \u00d1etib thavvim\u2019m\u00e7 y\u00ebletvimvor "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":8,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":9,"end":20,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":21,"end":163,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":164,"end":248,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":249,"end":340,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":341,"end":407,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":408,"end":484,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":485,"end":565,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":566,"end":659,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":660,"end":686,"attributes":{"tracking":0,"wordSpacing":0.0,"bas