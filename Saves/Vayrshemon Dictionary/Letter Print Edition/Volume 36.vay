aragraph","direction":"ltr","runs":[{"runId":"run.qt.302","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblg\u00e7z\u00e9lvejem: Den gren y\u00eblg\u00e7z\u00e9l \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.017f4738b33a44f3aa51b4dd2d2b2e78","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.375","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblg\u00e7z\u00e9l ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblg\u00e7z\u00e9lvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.3c6ec9b0dd5543a5bf271f01d0fa28a3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.467","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblg\u00e7z\u00e9lvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblg\u00e7z\u00e9l po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.35b923ddcb314ad784d4bb21f384e9ac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.527","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblg\u00e7z\u00e9l b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblg\u00e7z\u00e9lvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.4f4de7b747d6411887f5b07b5e7cedb7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.600","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblg\u00e7z\u00e9lfader: Y\u00eblg\u00e7z\u00e9l \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.bfa8baddba0e40aba1a103b1303a44ad","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.699","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblg\u00e7z\u00e9lfader tav \u00e5vizya."}]},{"blockId":"block.61250424ae4445838e5b2e8008c32ec6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.793","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblparenp\u00e1in: Y\u00eblp\u00c5ry\u00ebletharen \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.7f32e304ab68443cbdbebd7b748544fc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.865","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblparenp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.28811d5d465a404ba8806d573aa74e33","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.958","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblparenvevor: Threnin i y\u00eblp\u00c5ry\u00ebletharen \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.f4a686768c0646b1ae3d2d137f37ed5c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1035","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblp\u00c5ry\u00ebletharen \u00e7ztizya. R\u00e1 y\u00eblparenvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.29babceb43af4286b2c64cc15b2d5f61","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1117","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblparenf\u00ebr: \u00e2lum i y\u00eblp\u00c5ry\u00ebletharen \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.4d0d2cb65918498e8e742255f5b1b791","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1183","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblp\u00c5ry\u00ebletharen \u00e3lumizya. \u00caers y\u00eblparenf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.2789c73c1bb542c0ab199d14105ad240","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1264","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5r: 1 y\u00eblverzet r\u00c7n\u00d3 goren\u2019m\u00e7 y\u00ebletun gren naor\u2019m\u00e7 verzethalemin\u00d7."}]},{"blockId":"block.9d7c3218723e42e991202cea09c36694","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1335","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblp\u00c5r \u00e1pe\u00dbem y\u00ebl\u00d7\u00d3 k\u00e3m goren r\u00d7owya, grem 18 lomih 26 palesun naor ragumowya."}]},{"blockId":"block.7b695dea2d874ae5b91e0ca729486067","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1414","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00eblverzet r\u00c7n\u00d3 goren\u2019m\u00e7 y\u00ebletun gren naor\u2019m\u00e7 verzethalemin\u00d7."}]},{"blockId":"block.a95fe1ad08774736893329112d903521","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1477","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00cd\u00d7goren z\u00e1lget zi ningi r\u00c7n\u00d3 y\u00eblvar y\u00eblverzet shalenizya \u00d1etib zi r\u00c7n\u00d3 elin azar shalenizya \u00e3\u00d1 gren po y\u00eblp\u00c5run \u00e3\u00d1 zernunget hy\u00c5v\u00cdizya."}]},{"blockId":"block.484cc80dc2234776944eeb3a1750b1f8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1614","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblp\u00c5r thiril meranthiril: y\u00eblp\u00c5r thiril meranthiril."}]},{"blockId":"block.6e8b4a52b98a44fa8586faee2f98a983","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1668","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00f1in ni graf i po r\u00c7n\u00d3 y\u00eblyemarthirilget a\u00d9izya r\u00e1. Y\u00eblp\u00c5r thiril meranthiril y\u00eblyemarthirilun \u00d3\u00c5\u00e7imowya \u00d1em \u00e3\u00d1 gim faren dlen\u00dbeminvenoratya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":11,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":12,"end":37,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":38,"end":132,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":133,"end":224,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":225,"end":245,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":246,"end":301,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":302,"end":374,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":375,"end":466,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":467,"end":526,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":527,"end":599,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":600,"end":698,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":699,"end":792,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":793,"end":864,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":865,"end":957,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":958,"end":1034,"attributes":{"tracking":0,"w