e":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.7","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvrker\u00c3efah"}]},{"blockId":"block.e7ad931bcf6749c6b9d5dfaa2eaf6c08","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.21","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d3\u00c5m: y\u00eblverzet falibi verzethalemin\u00d7 h\u00ebth gaktriv dlen\u00dbeminowya."}]},{"blockId":"block.b71d84316b5c452db15445d13023fc20","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.89","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb venim ni po neksus threnin tha e\u00dbn\u00c9 ilmem threnin r\u00d7atya \u00e3\u00d1 po sezif\u00c7\u00c3atya \u00e3\u00d1 wemimatya k\u00e3m y\u00ebl\u00d3\u00c5m \u00e3\u00d1 k\u00e3m dornel falibi y\u00eblverzetverhal ni zem r\u00d7owya vin zem zem\u2019y\u00ebletunget tarnowya kom prodna p\u00e1in po\u2019y\u00eblverzetverhal r\u00d7atya."}]},{"blockId":"block.0825aba21841436f94134709475d9471","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d3\u00c5mp\u00e1in: Y\u00ebl\u00d3\u00c5m \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.55b9e01757ba46eea85194edd7de6d10","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.380","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebl\u00d3\u00c5mp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.58b7904f61f244fe852c216585943bc7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.471","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d3\u00c5mvevor: Threnin i y\u00ebl\u00d3\u00c5m \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.9219f6e104cf42139309f42512d7a2e7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.536","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebl\u00d3\u00c5m \u00e7ztizya. R\u00e1 y\u00ebl\u00d3\u00c5mvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.e8f9d53ee4c744dca99c215220f7b370","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.606","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d3\u00c5mf\u00ebr: \u00e2lum i y\u00ebl\u00d3\u00c5m \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.12487ef8f04f45dcbae2677796b398b4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.660","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebl\u00d3\u00c5m \u00e3lumizya. \u00caers y\u00ebl\u00d3\u00c5mf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.7177931d877d4aa0886ffaf883023475","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.729","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvar: y\u00eblverzet \u00d1etib ni vernil y\u00d1t dlen\u00dbeminowya."}]},{"blockId":"block.03d484bba6ee46cc9c95bbb54a5f0c0a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.782","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00cd\u00d7goren z\u00e1lget zi ningi r\u00c7n\u00d3 y\u00eblvar y\u00eblverzet shalenizya \u00d1etib zi r\u00c7n\u00d3 elin azar shalenizya \u00e3\u00d1 gren po y\u00eblp\u00c5run \u00e3\u00d1 zernunget hy\u00c5v\u00cdizya."}]},{"blockId":"block.e7caa9d4802c4b1f96fa5ef7d6b02894","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.919","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvarp\u00e1in: Y\u00eblvar \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.190915967e7b47daa6f38a2dd0bb0031","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.979","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblvarp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.5b46ebfed0eb4a6d810728176c36a993","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1070","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvarvevor: Threnin i y\u00eblvar \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.8f09329c4a644b679c81127ef7ad3a61","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1135","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblvar \u00e7ztizya. R\u00e1 y\u00eblvarvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.02f962dbf6c3497fa1679a660403bbf4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1205","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvarf\u00ebr: \u00e2lum i y\u00eblvar \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.5abd9edb6d1d4d0f82aa735f4b1a4f58","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1259","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblvar \u00e3lumizya. \u00caers y\u00eb