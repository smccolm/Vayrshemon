\u00ebl\u00dfm \u00e7ztizya. R\u00e1 y\u00ebl\u00dfmvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.1c670f539be1489eb717747eb001b55c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.93","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfmf\u00ebr: \u00e2lum i y\u00ebl\u00dfm \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.8ac8ce97de244330a4fa416538deae7c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.145","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebl\u00dfm \u00e3lumizya. \u00caers y\u00ebl\u00dfmf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.738284d73bd4496492c4c12850036fdb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.212","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfml\u00c7m: y\u00ebl\u00dfm l\u00c7m."}]},{"blockId":"block.3ecbb9692f5c4bd1880e9aad5aa005ff","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.233","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Faror\u2019m\u00e7 l\u00c7m. Vingraf yib\u2019\u00ebw\u2019m\u00e7 l\u00c7m y\u00ebl\u00dfml\u00c7m r\u00d7izya."}]},{"blockId":"block.c96f526b44bd4d32875c2115278d8fef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.286","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfml\u00c7mp\u00e1in: Y\u00ebl\u00dfml\u00c7m \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.1801e88502794ccfb23746b11b20e836","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.350","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebl\u00dfml\u00c7mp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.e1d06d9aaf994dc9a490a9e8a60118ac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.443","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfml\u00c7mvevor: Threnin i y\u00ebl\u00dfml\u00c7m \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.f2033f3570f34e5b92ca63c9d82dcb5a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.512","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebl\u00dfml\u00c7m \u00e7ztizya. R\u00e1 y\u00ebl\u00dfml\u00c7mvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.191957015c764d21b329dd75c5f288d7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.586","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00dfml\u00c7mf\u00ebr: \u00e2lum i y\u00ebl\u00dfml\u00c7m \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.5c14febeec364f8e9d521ee39116a7b8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.644","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebl\u00dfml\u00c7m \u00e3lumizya. \u00caers y\u00ebl\u00dfml\u00c7mf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.b92a04a1541e472fbc5097dd8ceba17a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.717","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebluowyaginv\u00d7: Ton i y\u00ebl shalinsilen dar ub\u00e1nt\u00e9vowya \u00e5\u00c3 vesna s\u00dflum kom ka zem zem\u2019falnthren o\u00c3owya."}]},{"blockId":"block.4f1600d422264f168d3774a033a4cd8b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.818","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nemir r\u00e1\u2019falnthren o\u00c3izya \u00e3\u00d1 y\u00ebluowyaginv\u00d7 f\u00c5wizya. Neks r\u00e1 po matondizya rav tav w\u00c5vumizya."}]},{"blockId":"block.10b7b81238a04eeca37f12a0e312ccc5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.911","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebluowyafaren: Falnthren i \u00d1etib y\u00ebl shalinsilen dar ub\u00e1nt\u00e9vowya giktenv\u00d7owya vin ni \u00d5\u00dfr fradowya."}]},{"blockId":"block.872163a75e4c425a95cdebb2477187b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1010","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venor mavem y\u00ebl shalinsilen dar ub\u00e1nt\u00e9vowya tondaizya. H\u00ebthven lym ly\u2019k\u00cfba\u00d1 y\u00ebluowyafaren portimostizya."}]},{"blockId":"block.f35f4c436b824d72991a08e1a1837772","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1118","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebluowyasef\u00c7\u00c3: Falnthren i y\u00ebl shalinsilen dar ub\u00e1nt\u00e9vowya \u00d1etib tav fradowya \u00e3\u00d1 ni venor t\u00d7 p\u00e1f\u00d7\u2019m\u00e7 nerbyal portimostimowya."}]},{"blockId":"block.af254a99d5504ef68b81ee01ba4b726e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1244","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks venor h\u00ebth falnthren lym h\u00c5b\u00cdpomizya. Venyel y\u00ebluowyasef\u00c7\u00c3 p\u00e1n ly\u2019broft t\u00e7lizya."}]},{"blockId":"block.0adf74a318df474ba88ecb66d5eb4ad5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1330","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyjem\u00e3jelin: Y\u00eblyemarjem\u00e3 k\u00c7nib s\u00dflum p\u00e1n man\u00d7njemlen t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 tav \u00c3\u00cd\u2019jw\u00ebnowya."}]},{"blockId":"block.735da99c941843a9802e3a86a75777ca","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1417","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Mav jelam kinos kojizya. Vin nabyems t\u00e7lizya za \u00e5\u00c3 y\u00eblyjem\u00e3jelin marin ef\u2019w\u00cf\u00df lym miktaz\u00d7rizya."}]},{"blockId":"block.ce1bdec4c43a43e6aebbe775ff709dc6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1513","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyjem\u00e3tht\u00e7l: Marjo\u00d9 gren \u00d1etib p\u00e1n ef\u2019t\u00e7lh\u00eb\u00d5 r\u00ddy\u00d3s\u00dflum y\u00eblyemarjem\u00e3 neks portimostowya."}]},{"blockId":"block.9c29c16eb7544d3bb7458c56f69c08a8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1603","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym venim ma\u2019t\u00e7lh\u00eb\u00d5izya. Tha y\u00eblyjem\u00e3tht\u00e7l pel y\u00eblyemarjem\u00e3 denizya."}]},{"blockId":"block.9be9e082c07846c9806a399d129ec3f8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1672","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyjem\u00e3twjyb: Threnin i y\u00eblyemarjem\u00e3 k\u00c7nib s\u00dflumun tw\u00ddnjybowya t\u00d7 le\u00db\u00c7f\u00c5w."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":10,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":11,"end":24,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":25,"end":92,"attrib