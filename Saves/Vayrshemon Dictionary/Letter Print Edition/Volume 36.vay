":"unicode","normalization":"none","text":"Ka azar\u2019na var\u00dfnenteral \u00d1etib thavtarnizya nel ven kranzar\u2019m\u00e7 y\u00eblvenor r\u00d7owya nel\u2019manor\u00d3asem slebmurf\u00d7\u2019en \u00e3\u00d1 ika\u00d9\u2019en. Faren h\u00c5b\u00cdtorpizya nel."}]},{"blockId":"block.fc7b5234a5d84b9892fe7d1260aad16c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.442","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenorjeem\u00e3: \u00e6l\u00d7on k\u00c7nib y\u00ebl venor vingim sezif\u00c7\u00c3owya t\u00d7 jemekjem\u00e3."}]},{"blockId":"block.9b9b93d97f6246509b22ea890c974cda","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.512","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n y\u00ebl venor kin o\u00c3braizya. Venyel tav. Lym tha y\u00eblvenorjeem\u00e3 \u00c3\u00cdthavizya."}]},{"blockId":"block.2fe3d11696374b61afac6361e2851f0b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.590","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenorjemeks\u00dflum: y\u00eblvenor jemek."}]},{"blockId":"block.6f2acb0a5785443a83b015b859255747","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.626","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murarsevarmarin\u2019m\u00e7 y\u00eblvenorjemeks\u00dflumun lymget k\u00e3m \u00e3\u00d1ta\u00d9zsalenaun \u00e7ztjematya; gr\u00ebnawfarvem\u2019m\u00e7 sonsezif\u00c7\u00c3s\u00dflumun grem lym thar i valemhif\u00e5ror t\u00cdnlilunget lilatya."}]},{"blockId":"block.6410dd1fcfa449a3a8f781ee3d3f3c99","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.788","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenorker: y\u00eblvenor ker."}]},{"blockId":"block.94c45053e46445a6b2ffb98fd6fe49a6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.815","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 tarven \u00e3\u00d1 y\u00eblvenorker \u00d1e\u00d5 f\u00d7izya zem \u00e3\u00d1 r\u00c7n\u00d3 zem\u2019k\u00cfba\u00d1 thalhefak gurs\u00dflum kl\u00e1rim\u2019m\u00e7."}]},{"blockId":"block.bf55ee34021546678192a12d352c9b6e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.905","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenorajeem\u00e3: \u00e6l\u00d7on k\u00c7nib y\u00eblvenor vingim sezif\u00c7\u00c3owya t\u00d7 jemekjem\u00e3."}]},{"blockId":"block.26642533c7f640e68a9d4295b2905164","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.975","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n y\u00eblvenor kin o\u00c3braizya. Venyel tav. Lym tha y\u00eblvenorajeem\u00e3 \u00c3\u00cdthavizya."}]},{"blockId":"block.582d5ca43b5246b7a82a83fa7850124a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1053","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenoraden: Den i y\u00eblvenor \u00cbers \u00d1etib thavvim\u2019m\u00e7 y\u00eblvenor h\u00c5b\u00cdimowya."}]},{"blockId":"block.42f05c24e8194c5493febf6c1ddf8788","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1125","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00eblvenor ma\u2019o\u00c3izya. Pel den t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 y\u00eblvenoraden gl\u00c9stizya."}]},{"blockId":"block.42013d24382244198fa7f595e04a2e05","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1195","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenorasef\u00c7\u00c3: Y\u00eblvenor \u00d1etib vingim \u00e5\u00c3 ilna\u2019m\u00e7 \u00e7l\u00d7on sezif\u00c7\u00c3owya kom kinos wa\u00d9gum\u2019jw\u00ebnimowya."}]},{"blockId":"block.4b483aebd1944c4c93a28c2726beab0d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1291","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n \u00e3\u00d1 venyel po ni ilna\u2019m\u00e7 kwesta \u00d3\u00e1lun\u00c3izya. Pel d\u00cdn\u00d7r ma\u2019f\u00c5wizya. Venim za za\u2019y\u00eblvenorasef\u00c7\u00c3 h\u00c5b\u00cdizya."}]},{"blockId":"block.7491bfd191ac40b99ecf33bf3c013f4a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1400","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenorden: Den i y\u00ebl venor \u00cbers \u00d1etib thavvim\u2019m\u00e7 y\u00ebl venor h\u00c5b\u00cdimowya."}]},{"blockId":"block.de0affede7ce4c55acd99892d8027d1d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1473","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00ebl venor ma\u2019o\u00c3izya. Pel den t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 y\u00eblvenorden gl\u00c9stizya."}]},{"blockId":"block.80508b86f13a4056bc82a02e01536bab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1543","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenortarnfaln: y\u00eblvenor tarn faln."}]},{"blockId":"block.4badbe55ad574a30813995a8e27cdb96","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1581","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Mav y\u00cd\u00d7 not\u2019v\u00df\u00d5gimenizya \u00d1em kranun \u00e5\u00c3 naora\u00d9\u2019en k\u00e3v ka r\u00c7n\u00d3 zem y\u00eblvenortarnfaln faln\u2019lah lym."}]}