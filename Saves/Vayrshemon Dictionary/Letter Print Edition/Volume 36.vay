","runs":[{"runId":"run.qt.310","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lam k\u00e3m gorenkwestaun piw\u00c5vumenowya \u00d1ed falib y\u00eblyemarika\u00d9 marowya."}]},{"blockId":"block.435f32ff073540249747823c85ffcdd8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.378","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemar\u00e7ztjem: y\u00eblyemar \u00e7ztjem."}]},{"blockId":"block.91a8dc8cd1574ac09d47b60cafa3b12f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.411","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e2\u00d1 kom \u00c9lmvenizya hefak gurs\u00dflum\u00e1pe\u00dbem haren Yankes i s\u00dflumun, yibgim jo\u00d9 thrin ly r\u00c7n\u00d3 t\u00e7lizya ol, p\u00e1f\u00d7 hefak gurs\u00dflum\u00e1pe\u00dbem haren Kuk grel \u00d1e\u00d5 y\u00eblyemar\u00e7ztjem gren meranybs\u00dfizya."}]},{"blockId":"block.5b42a17910b64d308fb0add8e3d1597d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.591","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemar\u00e7ztthar: y\u00eblyemar \u00e7ztthar."}]},{"blockId":"block.959358a4a2c3465c8908050b326db28c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.626","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kom goren jorgor r\u00c7n\u00d3 y\u00eblyemar\u00e7zttharimowya y\u00eblvorkinviminmeran vinto goryemsbor\u00c5 i jw\u00ebnenplesten omenatowya."}]},{"blockId":"block.bf8bccbe62a74c208c550ed39abeaa25","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.736","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemaryems\u00d7 nerda\u00c3: 1 y\u00eblyemar yems\u00d7 nerda\u00c3."}]},{"blockId":"block.83a955153baf491da21023c08eb57819","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.783","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1\u2019\u00ddvtonun \u00c9nimus yamen y\u00eblyemaryems\u00d7 nerda\u00c3un tondaowya."}]},{"blockId":"block.b6e71503791943feb50fb3c30e2529c5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.841","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 meranyems\u00d7 nerda\u00c3."}]},{"blockId":"block.40b60904c4bd459abd7c55eb437b2b32","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.862","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb kinos arvb\u00e7orna Denarvenek \u00e5\u00c3 ly \u00e7l\u00d7on i gimkin nilomun \u00e3\u00d1 yems\u00d7renun r\u00d7atya k\u00c7nibni mav y\u00eblyemaryems\u00d7 nerda\u00c3 r\u00c7n\u00d3 yems\u00d7 nerda\u00c3un \u00c3\u00cdatya maneks hefakfarelin y\u00eblyemar \u00cbers\u00d1e\u00d5 thrin\u00c3\u00cdatya."}]},{"blockId":"block.4c4162c40a4f41408fb1c7abfdbf5e71","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1055","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemaryems\u00d7marjo\u00d9: y\u00eblyemar yems\u00d7marjo\u00d9."}]},{"blockId":"block.b9349fef778c4015a9ba3ef069fdcbee","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1098","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Graf marin h\u00c5b\u00cden goryemss\u00dflumun zemget krivel\u2019en lomih, k\u00e3m tondaowya zem, y\u00eblyemaryems\u00d7marjo\u00d9un o\u00c3t\u00e7 r\u00ddy\u00d3\u2019en o\u00c3owfu zem k\u00e3nib s\u00eb\u00dbga\u2019es j\u00cdowfu r\u00e1, ni komna venorun fradizya gim\u00dfv jw\u00ebnenplesten ub\u00e1nt\u00e9v t\u00cdnun giktenv\u00d7\u2019es."}]},{"blockId":"block.94f137dd88774cba9c87ba24bfa43795","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1319","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemaryems\u00d7onega: y\u00eblyemar yems\u00d7 onega."}]},{"blockId":"block.d6dc1c077faf4b49ba76e69679208ab6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1361","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus vorkin vorelun n\u00d7\u00dbem kl\u00e1rimizfu vin y\u00eblyemaryems\u00d7onega borel ni nem gl\u00c9z\u00cben\u2019en gimkin mem a\u00d9imizya."}]},{"blockId":"block.aa4fe586ac5147b2a1ae6e7921686446","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1467","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyeminv\u00c5lf\u00d7: Y\u00eblyemardlen\u00dbemin \u00d1etib h\u00ebth neks kelde\u00dbon f\u00e7sowya v\u00c5lf\u00d7owya."}]},{"blockId":"block.e2dda549dd9147218a35b78009b53525","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1544","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tremb\u00c5r velin\u2019m\u00e7 gim\u00cba\u00d5izya. Venim y\u00eblyeminv\u00c5lf\u00d7 vimin\u2019m\u00e7 marjo\u00d9 v\u00c5lf\u00d7izya."}]},{"blockId":"block.7ce9e5a2aea843298cea0ebba0afd3e5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1620","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyeminmajo\u00d9: Threnin i y\u00eblyemardlen\u00dbemin \u00d1etib \u00cbers nerbyal miktaz\u00d7rs\u00dflum\u2019jw\u00ebnimowya."}]},{"blockId":"block.1b9aeffd0dc542f1a8fd2c8169837db2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1708","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Enif lym thav \u00db\u00c7dizya. Vin meranelyi\u00d1 broftizya y\u00eblyeminmajo\u00d9 p\u00e1izya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":12,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":13,"end":26,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":27,"end":58,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":59,"end":292,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":293,"end":309,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":310,"end":377,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":378,"end":410,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":411,"end":590,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":591,"end":625,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":626,"end":735,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":736,"end":782,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":783,"end":840,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":841,"end":861,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":862,"end":1054,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1055,"end":1097,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1098,"end":1318,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1319,"end":1360,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1361,"end":1466,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1467,"end":1543,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1544,"end":1619,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1620,"end":1707,"attributes":{"tracking":0,"wordSpacing":0.0,"baselin