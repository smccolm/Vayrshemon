ge.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"B\u00c5rume\u00dbn\u00c9 venalun thiril thiravun a\u00d9owfu r\u00e1 \u00e3\u00d1 velin vin z\u00ebrel verzetpelowya r\u00e1\u2019palpalil\u2019i y\u00eblthrenin i venel semowya r\u00e1."}]},{"blockId":"block.a2fb9d274bc34d4dbf4d9385f4118c55","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.236","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnal: y\u00eblthrenin tremb\u00c5r yems\u00d7slebs\u00ebnal."}]},{"blockId":"block.c838fb7a68c641e0b9bce1fc17b10166","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.305","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"B\u00e7orvel Indiz ni Koromandel jo\u00d9thren gren y\u00eblthrenintremb\u00c5r yems\u00d7slebs\u00ebnalun \u00d3\u00c5\u00e7owya zem zemget."}]},{"blockId":"block.72d1966f5fff46b7bdfc98885844fbfd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.402","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblthreninel nerbven f\u00c5w\u2019en: \u00d0on\u00d1\u2019en d\u00c7\u00d3\u00d1et poir \u00e3lum\u2019en w\u00c5vumenvennerb. A\u00d9s\u00dflum vennerb jem\u00e3owya vinel l\u00dfn \u00e3lumowya."}]},{"blockId":"block.0ea6c06b87e24481ae032f3263461feb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.520","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tremborel \u00d3\u00c5tus tremb\u00c5rgl\u00c9z\u00cbenun jorin s\u00c7fizya. Ni y\u00ebl gumen\u2019m\u00e7 y\u00eblen o\u00c3izya za. Y\u00eblthreninel nerbven f\u00c5wizya za \u00e3\u00d1 neksus far\u2019m\u00e7 tremb\u00c5rgl\u00c9z\u00cben dest\u00eb\u00c5l\u00dfnizya."}]},{"blockId":"block.1cc5085f52c444adbed8f20a19c5447e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.680","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltgrij\u00cb\u00cdnon: Y\u00eblthargrij \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.5ae8b7242e274ddc8872b3de42b11e15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.765","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00ebltgrij\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]},{"blockId":"block.b71fce3da5e44e1ab690037f4155f652","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.857","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltgrijveerb: Y\u00eblthargrij \u00d1etib s\u00dflum \u00cbers nerbyal f\u00d7owya \u00e3\u00d1 t\u00d7 \u00d1etib broft\u2019jw\u00ebnowya."}]},{"blockId":"block.cdcbb7437c87435c97a99267dcddaff8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.944","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna tremb\u00c5r ilna\u2019m\u00e7 falnthren \u00cbers vengraf f\u00d7izya. R\u00e1\u2019y\u00ebltgrijveerb r\u00e1 p\u00e1n s\u00ebvenun nerbyalizya."}]},{"blockId":"block.44ee18f222ca43c187e7018f7b287723","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1042","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltgrijin\u00dfb\u00df: Y\u00eblthargrij k\u00e3m vesna s\u00dflum nerbyalizya f\u00d7\u2019en p\u00c7n\u00df\u00eb t\u00d7 k\u00cfba\u00d1\u2019m\u00e7 f\u00c7l broft\u2019en."}]},{"blockId":"block.4049c40cee6549339509052ceb9ffc37","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1135","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nerbyal za\u2019k\u00cfba\u00d1 r\u00d7izya. R\u00c7n\u00d3 r\u00e1\u2019tremb\u00c5r r\u00e1 y\u00ebltgrijin\u00dfb\u00dfizya \u00e3\u00d1 t\u00d7 murlametw\u00c5vum r\u00e1 broftizya."}]},{"blockId":"block.b5432700ea524f9a8cc8046646c7fdfe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1231","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblteranke\u00dbon: H\u00c5b\u00cden i y\u00eblthrenin viminmeran \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.21f633bf1b3d416aa273bd2739d90b3c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1325","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblteranke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.87a48469c5434d779e8bd415d13c4a2b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1411","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblteranake\u00dbon: Y\u00eblthrenin viminmeran \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.aa40200dc52c4630a2bc93ffb415ed0f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1508","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblteranake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.92f06644cfc643f4b5f99bb3e7145ea3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1579","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\