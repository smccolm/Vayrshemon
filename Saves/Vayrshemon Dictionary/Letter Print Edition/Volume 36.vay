e","normalization":"none","text":"y\u00eblverzetmurmayatr\u00e3b"}]},{"blockId":"block.4037fe300da3492a927998021056628f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.37","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetverhal: y\u00eblverzet verzethalemin\u00d7."}]},{"blockId":"block.cc30da16250f4ff984f3b1d3c4a7aa7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.80","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb venim ni po neksus threnin tha e\u00dbn\u00c9 ilmem threnin r\u00d7atya \u00e3\u00d1 po sezif\u00c7\u00c3atya \u00e3\u00d1 wemimatya k\u00e3m y\u00ebl\u00d3\u00c5m \u00e3\u00d1 k\u00e3m dornel falibi y\u00eblverzetverhal ni zem r\u00d7owya vin zem zem\u2019y\u00ebletunget tarnowya kom prodna p\u00e1in po\u2019y\u00eblverzetverhal r\u00d7atya."}]},{"blockId":"block.bd2cf55b7679409580889f12ff1f6868","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.311","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetverzethalemin\u00d7: y\u00eblverzet verzethalemin\u00d7."}]},{"blockId":"block.f41f7842faf94976a195391c202fa74b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.362","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ma\u2019prodizfu\u2019jorin nel r\u00e1get. Farsemlin vorn\u2019m\u00e7 y\u00eblverzetverzethalemin\u00d7 i lym kom ma\u2019kl\u00e1rverzet\u2019jw\u00ebn p\u00c7n\u00df\u00eb po\u2019\u00d1\u00e9\u00d9 ni lym dlen\u00dbeminatya. Ma\u2019a\u00d9zizya r\u00e1 nelget."}]},{"blockId":"block.b3d9da0090024f3688998f73435c053d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.519","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetve\u00dbmel: y\u00eblverzet ve\u00db mel."}]},{"blockId":"block.e36b6851f9604cfca6a02158ca4bfcea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.555","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblverzetget dest\u00eb\u00c5owya vel \u00e3\u00d1 nem vel strasowya zem, ol y\u00eblverzetve\u00dbmelget rul\u00e7ztthavowya thar. Y\u00ebl gr\u00c9truld\u00c7\u00d3s\u00ebnal r\u00c7n\u00d3 goren gr\u00c9trulkular lomih venorborel ni jw\u00ebnenplesten\u00ebw slebowya zem poget."}]},{"blockId":"block.83aa1830eb664904a444ab77ecdc5fa3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.752","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetvimvenam: y\u00eblverzet vimvenam."}]},{"blockId":"block.c20f5f6459a64783b3c8dbdbd40a107c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.791","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni ragum\u00e7l\u00d7ono\u00c3t\u00e7 y\u00eblverzetvimvenam ragumizya."}]},{"blockId":"block.09197fb2197c47ee8d685d3c714fb725","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.838","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetvor: y\u00eblverzet vor."}]},{"blockId":"block.be934225040b4523ae4c303914e7ec98","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.867","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venam ni venamz\u00dfgu\u00d9un ol o\u00c3t\u00e7 y\u00eblverzetvor ragumowya, Jak, Durian \u00e3\u00d1 Kakao venamun l\u00ddn\u00c5r."}]},{"blockId":"block.23247aa0d7604e13ace4e3fd6e2be385","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.957","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetel r\u00c7n\u00d3 y\u00ebletun v\u00df\u00d5\u2019en: T\u00d7 durun\u2019m\u00e7 farmin yib\u2019\u00ebw jelam i ilna\u2019m\u00e7 farmin sezif\u00c7\u00c3\u2019en vinel l\u00e1m\u2019m\u00e7 f\u00ebr\u00d3 o\u00c3jems\u00e3\u00d1ma\u2019en."}]},{"blockId":"block.39fb9bb3e1cc4849abc4a5901e928dd3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1083","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym pomf\u00c5ws\u00dflum fart\u00e7lizya r\u00c7n\u00d3 lil p\u00c7n\u00df\u00eb kinem ma\u2019f\u00c5wizya. R\u00c7n\u00d3 y\u00ebletun y\u00eblverzetel v\u00df\u00d5izya lym."}]},{"blockId":"block.6eddc2619f504821bc73f3633fa5de49","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1181","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetfadery\u00ebl: y\u00eblverzet fader y\u00ebl."}]},{"blockId":"block.297fb76183774e26a2d33514115ef84a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1221","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Aleth gurin rennaun r\u00c7n\u00d3 fary\u00cd\u00d7 lamet k\u00e3v \u00d1ed paven denim\u2019na \u00e5\u00c3 den i ner\u00c3\u00cdmerinun vesnalen yjafunim\u2019jw\u00ebnowya: Ner\u00c3\u00cdmerin i dornel t\u00d7 gl\u00c9stvoren tha ka i m\u00ebrvenkwesta amo\u00d1owya, \u00d1e\u00d5 tha ka i y\u00ebl\u00ddmy\u00ebl lomih y\u00eblverzetfadery\u00ebl."}]},{"blockId":"block.0eeb7d073d464d10bdcd463c451a0141","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1445","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetmelun: y\u00eblverzet melun."}]},{"blockId":"block.1c15535f2a1b4ec7848ae7c801095b0e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1478","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0ed flerilun al \u00e3\u00d1 \u00d1ed tinowya y\u00eblverzetmelunun \u00d1etib grash \u00e3\u00d1 mailmem strasf\u00c5wim\u2019na dlenowya \u00e7ztthav\u2019en w\u00cf\u00dfowya m\u00dfrnav venel\u2019m\u00e7 palespalen\u2019en vennerbowya ly; vinel\u00d1e\u00d5 k\u00e3m Jo\u00d9\u00d5\u00dfren \u00c9lmowya \u00c4\u00d9gif ly dlen\u2019en nor\u00d3aowya."}]},{"blockId":"block.91e399a042ab40d7a49408a1ee45c5d5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1695","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblverzetmurmayatr\u00e3b: y\u00eblverzet murmayatr\u00e3b."}]},{"blockId":"block.0329ed9aecb54639bafb02034d9ed74b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1740","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Veritase lomib mayemslevimizfu y\u00eblverzetmurmayatr\u00e3b zi\u2019haren l\u00ddn\u00c5r giktenv\u00d7enwil jerandest\u00eb\u00c5imowya ma\u2019s\u00c7fowya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":15,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":16,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":79,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":80,"end":310,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":311,"end":361,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":362,"end":518,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":519,"end":554,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":555,"end":751,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":752,"end":790,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":791,"end":837,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start"