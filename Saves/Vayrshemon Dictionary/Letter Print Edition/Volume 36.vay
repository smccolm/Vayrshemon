ype":"unicode","normalization":"none","text":"Zem y\u00ebletvimvor ma\u2019o\u00c3izya. Pel den t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 y\u00eblemvorden gl\u00c9stizya."}]},{"blockId":"block.09ab40e0ad334f89baff5be5a228cfdc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.112","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblemvorsef\u00c7\u00c3: Y\u00ebletvimvor \u00d1etib vingim \u00e5\u00c3 ilna\u2019m\u00e7 \u00e7l\u00d7on sezif\u00c7\u00c3owya kom kinos wa\u00d9gum\u2019jw\u00ebnimowya."}]},{"blockId":"block.922e4fca46174a98a60ce29f68621c62","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.210","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Yelp\u00e1n \u00e3\u00d1 venyel po ni ilna\u2019m\u00e7 kwesta \u00d3\u00e1lun\u00c3izya. Pel d\u00cdn\u00d7r ma\u2019f\u00c5wizya. Venim za za\u2019y\u00eblemvorsef\u00c7\u00c3 h\u00c5b\u00cdizya."}]},{"blockId":"block.796cc8af786d40e992171cfdb026d680","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.318","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblen: 1 threnin \u00d1etib tha y\u00eblverzet\u2019i goren\u2019m\u00e7 vor ragumowya."}]},{"blockId":"block.9fa22c6bc98f49b29c363ff9647ef6fd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.381","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 ven\u00e1l i y\u00eblverzet kinos r\u00d7owya m\u00dfrnav po vel dest\u00eb\u00c5imowya ka po tav verzetpelnaatya \u00e3\u00d1 ka po\u2019mel Y\u00eblen ma\u2019f\u00e7satya."}]},{"blockId":"block.3b271652de19416ba15cf8adbe96a571","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.499","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 d\u00c7v."}]},{"blockId":"block.fa88e8d98a784d5abe8691fa1d6ad109","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.506","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ven j\u00cde ai Yo\u00dbua naor prodvard\u00c7vens\u00dflum nel \u00e3\u00d1 nel\u2019s\u00dflumun ka p\u00e1n nel ve\u00d5owya t\u00d7 zem s\u00dflumun h\u00c9ft\u00cdim\u2019na r\u00d7owya t\u00d7 o\u00c3 r\u00e1un r\u00e1un\u2019d\u00c7v Y\u00eblen thar y\u00c9nenatya."}]},{"blockId":"block.7d6f7631a7ec41b680b173ea3ce0aeef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.659","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblenkerilharen: Y\u00eblen keril haren."}]},{"blockId":"block.a8cdd8263685425599c7cfbe9a537b6c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.695","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venim mavmin\u2019m\u00e7 pirilna\u2019m\u00e7 lofun, p\u00e1k\u00cfba\u00d1\u2019m\u00e7 z\u00e1lagurs\u00dflumun i \u00d1e\u00d5 ma\u2019z\u00e1linim\u2019m\u00e7 z\u00e1lagur, ni k\u00cfba\u00d1\u2019m\u00e7 zem\u2019threnun r\u00c7n\u00d3 y\u00eblenkerilharenun olen\u2019m\u00e7 zem\u2019kil\u00ebnunget thrinterastnerda\u00c3im\u2019en r\u00e1get w\u00e9asemowya."}]},{"blockId":"block.797026ed134a4a1680d78249fb599755","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.895","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblendest\u00eb\u00c5: 1 Y\u00eblen dest\u00eb\u00c5."}]},{"blockId":"block.3587f89fb39b4914ae6b0ecd8e6cdafa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.924","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00ded\u00d7um venalun nel\u2019w\u00cfn\u00c7get nel p\u00e1instrasf\u00c5watya \u00e3\u00d1 \u00dfd\u00d7um venalun nel\u2019vemelw\u00cfn\u00c7get nel y\u00eblendest\u00eb\u00c5atya \u00e3\u00d1 po\u2019venamget z\u00dfgu\u00d9atya ni."}]},{"blockId":"block.18492c70d8cf45eea1974eb7e7db258d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1054","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 Y\u00eblen dest\u00eb\u00c5."}]},{"blockId":"block.8d098506facd4a91964386fca611cb1a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1070","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb mavmin\u2019m\u00e7 vorn\u2019m\u00e7 s\u00dflum, muram\u2019m\u00e7 y\u00eblverzetget y\u00eblendest\u00eb\u00c5owya nel, \u00d1etib aleth flerilget ma\u2019f\u00c5wowya\u2019jw\u00ebn ni sezif\u00c7\u00c3 t\u00d7 ol ne\u2019d\u00c7\u00d3 \u00e3\u00d1 w\u00cfn\u00c7d\u00c7\u00d3."}]},{"blockId":"block.611a7e679cf34096aaf2c2d06f5da453","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1218","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblendest\u00eb\u00c5hukin: y\u00eblendest\u00eb\u00c5 lunor gl\u00c9z\u00cben."}]},{"blockId":"block.5e589dab48294678a17cc551957e5aa2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1263","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ne\u2019jo\u00d9destlenirun nira keranun \u00e3\u00d1 ne\u2019y\u00eblendest\u00eb\u00c5hukinun nira tarvenun slebe vimjw\u00ebn tonda\u2019ne r\u00e1 jw\u00ebnenplesten r\u00d7owya."}]},{"blockId":"block.6d01a2b93017444fbe685cbfe9f6f687","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1381","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cben: y\u00eblendest\u00eb\u00c5 lunor gl\u00c9z\u00cben."}]},{"blockId":"block.06c483c5453e483e887138077927212d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1434","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ne\u2019jo\u00d9destlenirun nira keranun \u00e3\u00d1 ne\u2019y\u00eblendest\u00eb\u00c5lunor gl\u00c9z\u00cbenun nira tarvenun slebe vimjw\u00ebn tonda\u2019ne r\u00e1 jw\u00ebnenplesten r\u00d7owya."}]},{"blockId":"block.3045c845f9864ed1a76db2b8e0a03d2c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1560","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblendest\u00eb\u00c5nil\u00ebm: dest\u00eb\u00c5den."}]},{"blockId":"block.2c55c9fcb774460cadc887d3bd6ba471","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1589","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venarna 3 venamplesten y\u00eblenun s\u00c7fowya y\u00eblverzet. Ol kom y\u00eblendest\u00eb\u00c5nil\u00ebmim m\u00dfrnav venal \u00d1e\u00d5 venam ma\u2019a\u00d9\u00d5\u00dfrowya y\u00eblverzet. P\u00c7n\u00df\u00eb neksus lomih \u00d3\u00c5tus vemyib\u2019\u00ebw "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":11,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":12,"end":39,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":40,"end":111,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":112,"end":209,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":210,"end":317,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":318,"end":380,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":381,"end":498,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":499,"end":505,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":506,"end":658,"attributes":{"tracking":0,"wordSpacing"