tyles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyz\u00cben\u00cb\u00cdnon"}]},{"blockId":"block.2b97084415f34de6a4e46fd3657f52c3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum harenw\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.6541013736fd470eacf6743205054d01","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.60","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00eblyz\u00cben\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]},{"blockId":"block.de2dbe11eb1f48b6bcc4df598ea8d454","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.152","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyz\u00cbenveerb: Y\u00eblyemargl\u00c9z\u00cben \u00d1etib s\u00dflum \u00cbers nerbyal f\u00d7owya \u00e3\u00d1 t\u00d7 \u00d1etib broft\u2019jw\u00ebnowya."}]},{"blockId":"block.e0eafe8a2eb3450f949c5231b1bb4063","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.243","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna tremb\u00c5r ilna\u2019m\u00e7 falnthren \u00cbers vengraf f\u00d7izya. R\u00e1\u2019y\u00eblyz\u00cbenveerb r\u00e1 p\u00e1n s\u00ebvenun nerbyalizya."}]},{"blockId":"block.4aab5ba42bdc4b8b8a1eaaba00209c11","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.341","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyz\u00cbenin\u00dfb\u00df: Y\u00eblyemargl\u00c9z\u00cben k\u00e3m vesna s\u00dflum nerbyalizya f\u00d7\u2019en p\u00c7n\u00df\u00eb t\u00d7 k\u00cfba\u00d1\u2019m\u00e7 f\u00c7l broft\u2019en."}]},{"blockId":"block.c59999359ea4419a966473c548d300ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.438","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nerbyal za\u2019k\u00cfba\u00d1 r\u00d7izya. R\u00c7n\u00d3 r\u00e1\u2019tremb\u00c5r r\u00e1 y\u00eblyz\u00cbenin\u00dfb\u00dfizya \u00e3\u00d1 t\u00d7 murlametw\u00c5vum r\u00e1 broftizya."}]},{"blockId":"block.0667d30f0e7641548095863bf439fe86","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.534","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyeranvejem: Den gren y\u00eblyemarvenorviminmeran \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.71589332363e47459f7a95862b65a569","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.622","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblyemarvenorviminmeran ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblyeranvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.450be53801454e98a20c32e015a94304","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.729","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyeranvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblyemarvenorviminmeran po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.5c35703f116a41a1b3c7dbbc253b4b2a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.804","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemarvenorviminmeran b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblyeranvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.d9c01137099b4bc583dcbcf66d9f2314","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.892","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyeranfader: Y\u00eblyemarvenorviminmeran \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.6f51c7403cf04760a072cdf12ca6e8f7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1006","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblyeranfader tav \u00e5vizya."}]},{"blockId":"block.055b3671c76e4e65a3a3a9a9db1a245e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1100","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemar: 1 goren\u2019m\u00e7 borel \u00d1etib s\u00dflum \u00e3\u00d1 \u00d1etun thrin goryems \u00db\u00c7dowya."}]},{"blockId":"block.3f466857140f469992b700e4b89b5c09","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1171","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"3 y\u00eblyemarun r\u00c7n\u00d3 Rokas goryemsjo\u00d9un \u00e5\u00c3 sezif\u00c7\u00c3izya ly, ly\u2019tarmil threnina\u00d9izya \u00e3\u00d1 threninizya, kenst ol gimol memil w\u00c5vumizya ly k\u00c7nib \u00db\u00c7d\u2019en borelun mem s\u00c7fizya ly."}]},{"blockId":"block.e0ff15732db946dfa0b86fc405d3cfb8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1338","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00ebl yems\u00d7."}]},{"blockId":"block.9ae7c9cb21d04e7395b41f50698ff99a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1351","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00dfv m\u00ebren tha jemekjem\u00e3owya jo\u00d9 jelgl\u00c9st goren w\u00ddyaz \u00e3\u00d1 y\u00eblyemarun dlen\u2019en Siv\u00ebl yems\u00d7 a\u00d9owya."}]},{"blockId":"block.6d3c3130cbb54e8fa0f3d5e30ce5fc68","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1446","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"3 goren\u2019m\u00e7 borel \u00d1etib s\u00dflum \u00e3\u00d1 \u00d1etun thrin goryems \u00db\u00c7dowya."}]},{"blockId":"block.31d66433fb564a9ca83a33d611d99900","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1507","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Var\u00dfn \u00daelom\u00c5n i y\u00eblyemarun y\u00eblyemargurget ni Eziongeber a\u00d9izya \u00d1etib thavvim Elo\u00d5 gren i Azgoryems goryemsthren ni i Edom jo\u00d9 r\u00d7owya."}]},{"blockId":"block.879314b8100b4e9cad7810d0a18b6a20","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1641","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum haren: y\u00eblyemar kamiz\u00e3\u00d1ts\u00dflum haren."}]}]}]}