1cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblde\u00d9enginv\u00d7"}]},{"blockId":"block.07be61f3dd054288a8f6d115e2718731","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldst\u00eb\u00c5\u00cb\u00cdnonw\u00c5vumizya."}]},{"blockId":"block.abab1ddd0ab547c582b9c571b14fd5b7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.38","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblde\u00d9enfaren: Falnthren i \u00d1etib y\u00ebl shalinsilen venor\u2019m\u00e7 mem t\u00d7 dwe\u00d9en giktenv\u00d7owya vin ni \u00d5\u00dfr fradowya."}]},{"blockId":"block.561b05e0df964a129903758fba639cdb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.144","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venor mavem y\u00ebl shalinsilen venor\u2019m\u00e7 mem t\u00d7 dwe\u00d9en tondaizya. H\u00ebthven lym ly\u2019k\u00cfba\u00d1 y\u00eblde\u00d9enfaren portimostizya."}]},{"blockId":"block.9d6228e2a556454a9ae4a1e1499b2fae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.259","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblde\u00d9ensef\u00c7\u00c3: Falnthren i y\u00ebl shalinsilen venor\u2019m\u00e7 mem t\u00d7 dwe\u00d9en \u00d1etib tav fradowya \u00e3\u00d1 ni venor t\u00d7 p\u00e1f\u00d7\u2019m\u00e7 nerbyal portimostimowya."}]},{"blockId":"block.a5cef65a42fd42598167b0b4bbf24c09","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.392","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks venor h\u00ebth falnthren lym h\u00c5b\u00cdpomizya. Venyel y\u00eblde\u00d9ensef\u00c7\u00c3 p\u00e1n ly\u2019broft t\u00e7lizya."}]},{"blockId":"block.59687208824d4d459ded25f257f69774","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.478","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldest\u00eb\u00c5: 1 y\u00ebl dest\u00eb\u00c5."}]},{"blockId":"block.36b734e35200418b8fc12070ff7df035","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.503","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e0pe\u00dbem\u2019m\u00e7 n\u00d7nenmarvenens\u00dflum, falibi sevarget h\u00c5b\u00cdnerin\u2019m\u00e7 o\u00c3 i N\u00d7nen jw\u00ebnenplestenarowya, gren grelna\u2019m\u00e7 harenkl\u00e1r y\u00ebldest\u00eb\u00c5get ma\u2019gaktrivarowya m\u00dfrnavma neksus\u2019t murlamvutget w\u00cfinowya."}]},{"blockId":"block.0cbd7b31870a472c998067f7cc39646d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.690","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00ebl dest\u00eb\u00c5."}]},{"blockId":"block.a36bf2e435384e14a517a4be66711efb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.704","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb k\u00e3m vem memilvorteralget gaktrivarizya y\u00ebldest\u00eb\u00c5 haren nira yems\u00d7 gaktrivizya \u00e3\u00d1 zi goren\u00d3\u00c5\u00e7izya \u00e3\u00d1 tondaizya: Awen marven\u2019h\u00c5 t\u00d7 po \u00e5vlemv\u00c7himizya."}]},{"blockId":"block.ed6d48be28b8489684284995c25f6489","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.858","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"3 y\u00ebldest\u00eb\u00c5\u2019en."}]},{"blockId":"block.36867822f6d2460da9e14550cb4a83b5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.874","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 k\u00e3m ni h\u00eb\u00d5\u2019na s\u00dflumun tha nor\u00d3amamemil nerda\u00c3\u2019es \u00e3\u00d1 ilvem y\u00ebldest\u00eb\u00c5\u2019es levna gim\u00cba\u00d5owya, \u00e3\u00d1 r\u00c7n\u00d3 ol zem\u2019sevarun nira neksus jw\u00ebnenplesten \u00e3\u00d1 dlen\u00dbeminvenor\u2019na ef\u2019z\u00e1la kl\u00e1rir\u2019en \u00c9lmowya."}]},{"blockId":"block.27045c68ab464589942be90281f68a5a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1063","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"4 dest\u00eb\u00c5."}]},{"blockId":"block.918fc2015d254b14ac2e51d894d01c65","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1073","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi gorenj\u00cden\u2019\u00ebw goren\u00d3\u00c5\u00e7izya \u00e3\u00d1 kom tondaizya y\u00eblverzet vel y\u00ebldest\u00eb\u00c5 \u00e3\u00d1 zi\u2019y\u00eblenun thav dest\u00eb\u00c5 zi\u2019y\u00ebletun thav zivel \u00e3\u00d1 zi\u2019venam strasf\u00c5w; \u00d5\u00dfrvorun tha grel po thav \u00c3\u00cdowya\u2019ne \u00e3\u00d1 wilun tha zi\u2019y\u00eblenun."}]},{"blockId":"block.d192c4818b2c4215b56399e7c60f3049","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1274","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldest\u00eb\u00c5teral: y\u00ebldest\u00eb\u00c5 teral."}]},{"blockId":"block.e7c66e16344642e0b309d7fa83f2a539","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1307","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"B\u00cfeb marin far\u2019m\u00e7 f\u00c7l\u2019h\u00c5 koje nel vin nor\u00d3aowya r\u00e1. Y\u00cd\u00d7naor\u2019m\u00e7 k\u00e3v r\u00e1\u2019bar\u00ebn nel\u2019y\u00ebldest\u00eb\u00c5teral naora\u00d9e lomih \u00cbers prodnas\u00dflum P\u00c5vol \u00e5\u00c3 r\u00e1\u2019pales slebatya r\u00e1 nelget \u00e3\u00d1 ni nel palesslebatya r\u00e1 w\u00cfins\u00dflum\u2019h\u00c5 t\u00d7 nel\u2019hefar."}]},{"blockId":"block.513d592f3363427282fa36491f310b16","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1524","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldst\u00eb\u00c5\u00cb\u00cdnon: Y\u00ebldest\u00eb\u00c5 \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.e1b0a5a7b75643d697263ff4d61f1a7d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1607","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00ebldst\u00eb\u00c5\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":37,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":38,"end":143,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":144,"end":258,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":259,"end":391,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":392,"end":477,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":478,"end":502,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":503,"end":689,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":690,"end":703,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":704,"end":857,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":858,"end":873,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":874,"end":1062,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1063,"end":1072,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1073,"end":1273,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1274,"end":1306,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1307,"end":1523,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1524,"end":1606,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1607,"end":1698,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}],"paragraphs":[{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{"alignment":"left","before":0.0,"after":0.0,"tabs":[]},{