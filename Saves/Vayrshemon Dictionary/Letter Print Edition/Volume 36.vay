flumlarod"}]},{"blockId":"block.bb1526c480154779a27c386278541c23","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurtharlamprod y\u00c9nenowya."}]},{"blockId":"block.b38657d105d54145a311396f549b85b5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.43","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den gren nor\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00ebld\u00dflumlarod wa\u00d9gumizya."}]},{"blockId":"block.f13692f3832d4d059127d280c2a25796","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.157","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00dflumnoven: S\u00dflum falib d\u00c7\u00d3 i y\u00ebld\u00c7\u00d3s\u00dflum t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]},{"blockId":"block.3d8107b5b40b44a9b11c37c54acd6ab3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.240","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebld\u00c7\u00d3s\u00dflum sezif\u00c7\u00c3izya. Y\u00ebld\u00dflumnoven taren f\u00c5wizya \u00e3\u00d1 braden sezif\u00c7\u00c3izya."}]},{"blockId":"block.8383cc696a3940acae02d7cc06bb0ac3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.316","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldur: 1 threnin \u00d1etib ni jo\u00d9 verzetget gl\u00c9z\u00cbenowya \u00e3\u00d1 wemarowya."}]},{"blockId":"block.e08bb5f2292647b5adf723ba1b6e221a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.383","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nel zemget verzetowfu lam zem y\u00ebldurget \u00e7ztowfu zem ragumowya lam zem venamget thar y\u00c9nenowya nel thavvim ni zem\u2019tom r\u00d7owya \u00e3\u00d1 thavim tha zem\u2019v\u00dfrjilun."}]},{"blockId":"block.aae74bb246c7457ea1be5950e436c1dc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.535","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 h\u00eb tha \u00d1etib voren ner\u00c3\u00cdowya."}]},{"blockId":"block.6d98ae0538464d03afa0b05ea25e7938","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.567","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Marl\u00c9y y\u00ebldur i \u00e5\u00d1hefak r\u00d7izya."}]},{"blockId":"block.22ba9bf59f9a49c6a70d18a80fe9f7ec","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.599","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"3 threnin i verzet grel jo\u00d9 thrin \u00d1etib yems\u00d7 ybs\u00dfowya."}]},{"blockId":"block.36b4cd14ea5c42dfb49504977b2e5696","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.655","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebldurun i y\u00eblverzet yems\u00d7get \u00e7ztowya."}]},{"blockId":"block.769ae366ccc544849ba814af736f97a8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.694","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"4 threnin \u00d1etib ni jo\u00d9 verzetget gl\u00c9z\u00cbenowya \u00e3\u00d1 wemarowya."}]},{"blockId":"block.c9ea0692f50f42cd957eb3f4283ecc5b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.753","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murenna\u2019m\u00e7 w\u00c5vumen d\u00c7ven\u2019jw\u00ebnowya nel ma, tha tar\u00d5 y\u00ebldur\u2019m\u00e7 w\u00e9asem \u00e7ztdest\u2019en, \u00ddv\u2019m\u00e7 w\u00e9asemun i nenal thavrul\u2019en, \u00e3\u00d1 r\u00c7n\u00d3 mel\u2019m\u00e7 fadervoren \u00d1etib for\u00d9\u2019en h\u00ebowya plestizfu bar\u00ebn i ka murdatplesten\u2019m\u00e7 vorenet yata\u00d9\u2019en \u00d1etib gren sevar memvorowya?"}]},{"blockId":"block.4ec4e7067f2b4731a6557bb4e528f171","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.999","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldur grel d\u00c7\u00d3v\u00df\u00d5f\u00c5w: V\u00d7dlehm \u00e5\u00c3 jo\u00d9 lomih z\u00e1l y\u00cd\u00d7 vorn\u2019m\u00e7 k\u00e3v \u00ddv\u2019m\u00e7 lamet r\u00d7owya. Po \u00cbers seral vemyib\u2019\u00ebw ma\u2019fij\u00ddyl\u2019jw\u00ebnowya."}]},{"blockId":"block.61e63bc85e5347d68e873ece9dcaa829","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1127","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Z\u00e1l ven kamiz\u00e3\u00d1ts\u00dflum\u2019i r\u00d7owya. Grel d\u00c7\u00d3v\u00df\u00d5f\u00c5w y\u00ebldur dlen\u00dbeminowya. Venik i ly\u2019v\u00d7dlehmgur kinos neks\u2019m\u00e7 palenun \u00e7ztizya."}]},{"blockId":"block.8432dbbff45a455086a58b2729d593ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1249","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurda\u00c3: \u00e7l\u00d7on."}]},{"blockId":"block.f345580b1b5742d78dc43f00e2107492","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1267","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e2\u00d1 prodnar b\u00e7orinun r\u00c7n\u00d3 gumen\u2019m\u00e7 k\u00e3m w\u00cfn\u00c7 p\u00e1instrasf\u00c5wizya B\u00d7\u00c7r i thavim y\u00cd\u00d7goren\u2019m\u00e7 threnin \u00e7ztizya zi za\u2019kumul\u2019na prodvarz\u00e1l tha y\u00ebldurda\u00c3im\u2019na \u00e3\u00d1 b\u00e7orgor\u2019olenvor ni \u00e7l\u00d7onizya vimindul\u2019m\u00e7 a\u00d9im\u2019na renna\u2019m\u00e7 B\u00d7\u00c7r mlapv\u00d7sta\u2019en \u00e3\u00d1 m\u00ebr\u2019en jw\u00ebnenplesten\u2019m\u00e7 za\u2019z\u00dfgu\u00d9im\u2019na b\u00d7\u00c7rthirilun jem\u00e3\u2019en ven goren\u2019m\u00e7 b\u00d7\u00c7r\u2019el\u00ebinz\u00e1la."}]},{"blockId":"block.7ae94d0906114e6ebfc30eca69250bb4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1584","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurp\u00e1in: Y\u00ebldur \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.67c4b36f4f494254a31a11bf71e634ea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1644","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebldurp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.2936cafc45314ec795a82bbd40d8e412","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1735","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurthar: 1 y\u00ebldur thar."}]},{"blockId":"block.8c6f95905f674bb3ba4b7d84779df14b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1762","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00c7n\u00df\u00eb zi broftizya \u00e3\u00d1 tondaizya elenol y\u00ebldury\u00eblet \u00d1etib r\u00e1un\u2019prodnar pala ma\u2019verzetowfu y\u00ebldurtharimatya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":42,"attributes":{"tracking":0,"wordSpacing":0.0,"ba