d":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblynmemfader"}]},{"blockId":"block.8d0a2b01e4d242e6b0b19694aee76503","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblystenvejemtav \u00e5vizya."}]},{"blockId":"block.1875e083f0e84c099301ad88c606039a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.39","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyns\u00ebnhy\u00c5v\u00cd: Y\u00eblyemarp\u00e1ns\u00ebn \u00d1etib h\u00ebth po\u2019h\u00eb \u00c3\u00cdthavowya venim dlen\u00dbeminowya."}]},{"blockId":"block.8a7e8d415eb74b63864faa437c542ddc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.118","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem h\u00eb \u00e7ztthavizya \u00e3\u00d1 neksus yel wa\u00d9gumizya. Y\u00eblyns\u00ebnhy\u00c5v\u00cd dlen\u00dbeminizya."}]},{"blockId":"block.f7e573ca45c4419a808f74c1e181961c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.192","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyns\u00ebndlmin: Y\u00eblyemarp\u00e1ns\u00ebn kom thavim \u00e3lum\u2019en ka vin h\u00eb \u00c3\u00cdthavowya p\u00e1nna\u2019m\u00e7 len ma\u2019sezif\u00c7\u00c3owya."}]},{"blockId":"block.b1e7ded71380463db0ca42ed54c7690d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.291","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym h\u00eb \u00e7ztthavizya. Vin thavvimna venser ilna\u2019m\u00e7 \u00e3lum dlen\u00dbeminizya lym po y\u00eblyns\u00ebndlminowfu tondaizya."}]},{"blockId":"block.70d0a7c9e783457aa38b1912ac1efb43","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.395","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyns\u00ebnshal: Y\u00eblyemarp\u00e1ns\u00ebn \u00d1etib vin po\u2019h\u00eb \u00c3\u00cdthavowya tav elyi\u00d1owya."}]},{"blockId":"block.a806ca7098f34e78a0e2f00e6c2c9fe8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.466","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin tremb\u00c5r \u00e7ztthavimizya vorn\u2019m\u00e7 l\u00dfn sezif\u00c7\u00c3izya. \u00d0e\u00d5 y\u00eblyns\u00ebnshal r\u00d7izya."}]},{"blockId":"block.c208a173ea2c4a42a4bedd9a5420b7f2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.542","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyshalke\u00dbon: H\u00c5b\u00cden i y\u00eblyemartarjo\u00d9shal \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.e0c9b178df8c42e8924ec7308fee8ad1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.633","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblyshalke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.6fa89c13b9974ba2823d6d816aecf418","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.719","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyshalake\u00dbon: Y\u00eblyemartarjo\u00d9shal \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.5e97553357cd4ba2846d08d3dbc4cf7f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.813","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblyshalake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.6b63d8e3371e4413a5dd190b8beefe1e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.884","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyshalden: Neks w\u00c5vumen i y\u00eblyemartarjo\u00d9shal \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.f02e42daef134abeb3eb4e1f5d9aaf8e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.983","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblyshalden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.ade992a706e8490199413e2e9abdeee1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1059","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyshalvejem: Den gren y\u00eblyemarjo\u00d9shal \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.72f7f94236bf4343bfc379b75178e31e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1139","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblyemarjo\u00d9shal ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblyshalvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.20a36c5fe0c64726b1d3d7a672aac3f0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1238","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyshalvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblyemarjo\u00d9shal po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.0f03fd6abc4a47e198836dd281aa60fa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1305","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemarjo\u00d9shal b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblyshalvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.bb7f8d70e4a14328b21513df046d58e7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1385","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyshalfader: Y\u00eblyemarjo\u00d9shal \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.2c05ab43f96d486392f8ee081cf32a26","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1491","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblyshalfader tav \u00e5vizya."}]},{"blockId":"block.81859f8afb2f4de9aaac921adfc3054e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1585","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblystenvejem: Den gren y\u00eblyemarthiril jw\u00ebnenplesten \u00d1etib tremb\u00c5r thrin "}]}]}]},"styleFeatures":{"style.body"