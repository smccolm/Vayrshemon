,{"blockId":"block.d8e3fd9096c442b7bf6632a693723aa4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.20","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d1\u00d7: 1 y\u00eblverzet dest\u00eb\u00c5imowfu t\u00d7 d\u00c7\u00d3 i y\u00ebl."}]},{"blockId":"block.6756980b6e394afb887178f9c6be3924","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.66","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni y\u00ebl\u00d1\u00d7\u2019y\u00ebljo\u00d9 wa\u00d9gumimowya r\u00e1."}]},{"blockId":"block.3f9b1315e43f43c281c1e3b365ab7ec5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.99","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00eblverzet dest\u00eb\u00c5imowfu t\u00d7 d\u00c7\u00d3 i y\u00ebl."}]},{"blockId":"block.6c4cb3cce32848e180bb77bc32926be6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.138","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi t\u00d7 ziir y\u00ebl\u00c5runget vel y\u00ebldest\u00eb\u00c5owya \u00e3\u00d1 y\u00ebl\u00d1\u00d7get \u00e3\u00d1 dornelget \u00e7ztowya \u00d1etib zi t\u00d7 ziir gurin y\u00eblverzetun i y\u00ebljo\u00d9 jw\u00ebnenplestena\u00d9owya zi y\u00ebl\u00d7\u00d3get verzetowya \u00e3\u00d1 nabyems poget wemar\u00d5\u00dfrowya."}]},{"blockId":"block.9e5275f3968047c6b99fa653875ea338","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.329","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d1\u00d7p\u00e1in: Y\u00ebl\u00d1\u00d7 \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.082b07963e9f40f0a619dfa724e729b0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.387","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebl\u00d1\u00d7p\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.1aedf12d97cd497a9c2642bb70f592ef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.477","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d1\u00d7vevor: Threnin i y\u00ebl\u00d1\u00d7 \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.c1f390d8bef14ca586a6728b252af9b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.540","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebl\u00d1\u00d7 \u00e7ztizya. R\u00e1 y\u00ebl\u00d1\u00d7vevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.1f67195291d7454384406044fd8b4f55","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.608","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebl\u00d1\u00d7f\u00ebr: \u00e2lum i y\u00ebl\u00d1\u00d7 \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.ffa5d17008c24c22a6b39f612b6791a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.660","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebl\u00d1\u00d7 \u00e3lumizya. \u00caers y\u00ebl\u00d1\u00d7f\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.5356d480f49f45c0a7a77e86125c7da6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.727","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldar: 1 y\u00ebldury\u00ebletun ni threnin \u00d1etib thren a\u00d9owya."}]},{"blockId":"block.377a3786247e4e2aa420cfc2ee53b351","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.782","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nel ol zi\u2019y\u00ebldarunget vel ika\u00d9owfu nel zi\u2019jw\u00ebnenplesten\u00e7l\u00d7onunget \u00e5\u00c3 \u00cdg\u00c5 y\u00c9nenowfu."}]},{"blockId":"block.c9b56ed32d6649b2a4fb1e9f214444d8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.866","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"2 y\u00ebl dar."}]},{"blockId":"block.55d3c2500927487fa99969e6ba228134","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.877","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0e\u00d5 s\u00dflum yib\u2019\u00ebw neget n\u00d7\u00dbem kl\u00e1ratya k\u00e3m y\u00ebldarget kl\u00e1rowya zem."}]},{"blockId":"block.25fa3836109d43fa83ba34eb9ae75905","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.943","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldarvejem: Den gren y\u00ebldar \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.98faa3e71c994da783d75351f0914a82","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1012","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebldar ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00ebldarvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.478c0bbd6e5e4a528e72c008dcdf2dd7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1100","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldarvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00ebldar po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.09f8b483d9cb4baea2b0b7d2bcda5a62","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1156","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebldar b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00ebldarvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.537670d0be2441fc9e1505e7377a42b9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1225","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldarfader: Y\u00ebldar \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.a6445c584fd240dba690b9a99c8723a5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00ebldarfader tav \u00e5vizya."}]},{"blockId":"block.3f0d837374904d1eaf25520f582d50e9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1412","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00c7\u00d3s\u00dflum: y\u00ebl d\u00c7\u00d3s\u00dflum."}]},{"blockId":"block.d845e10fe435462d94a207a03da36e56","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1439","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Falib y\u00cd\u00d7 jw\u00ebnenplesten\u2019m\u00e7 z\u00e1laowya k\u00e3v kwestad\u00c7\u00d3s\u00dflum, meranz\u00e1las\u00dflum lomih y\u00ebld\u00c7\u00d3s\u00dflum?"}]},{"blockId":"block.1e9b4cb1d59e434d9c82e1db53e8f884","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1529","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldrda\u00c3v\u00c5lf\u00d7: Y\u00ebldurda\u00c3 \u00d1etib h\u00ebth neks kelde\u00dbon f\u00e7sowya v\u00c5lf\u00d7owya."}]},{"blockId":"block.1e021cc28e02485bb75c5b11309d79d4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1598","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tremb\u00c5r velin\u2019m\u00e7 gim\u00cba\u00d5izya. Venim y\u00ebldrda\u00c3v\u00c5lf\u00d7 vimin\u2019m\u00e7 marjo\u00d9 v\u00c5lf\u00d7izya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":5,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":6,"end":19,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":20,"end":65,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":66,"end":98,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":99,"end":137,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":138,"end":328,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":329,"end":386,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":387,"end":476,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":477,"end":539,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":540,"end":607,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":608,"end":659,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":660,"end":726,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":727,"end":781,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":782,"end":865,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":866,"end":876,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":877,"end":942,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":943,"end":1011,"attributes