u00cdn\u00d7r ma\u2019f\u00c5wizya. Venim za za\u2019y\u00eblvenorsef\u00c7\u00c3 h\u00c5b\u00cdizya."}]},{"blockId":"block.dbc946d785634f6ca3ceff404a182333","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.161","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvenory\u00eblverzet: y\u00eblvenor y\u00eblverzet."}]},{"blockId":"block.2173d1444eab4c2c83f281ebf02a26f9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.200","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni ragum\u00e7l\u00d7ono\u00c3t\u00e7 y\u00eblvenory\u00eblverzet ragumizya."}]},{"blockId":"block.55f74033f2d045278615caeceaa3047c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.247","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7m: y\u00eblverzet."}]},{"blockId":"block.3f58c9c7b7b241b7a25752297f5f0c1f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.266","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"I y\u00d1t y\u00eblv\u00d7m y\u00ebl venorunget \u00e3\u00d1 i y\u00eblr\u00ddm \u00e3\u00d1 y\u00ebl\u00dfm y\u00eblverzet Y\u00c5kovl\u00c9y \u00e7ztizya. \u00e2\u00d1 ve\u00db venorpirilunget ni zem zi shalem\u00e7ztthavizya, \u00e3\u00d1 ve\u00db \u00d1etib y\u00ebl venorun\u2019ni r\u00d7izya zi \u00d3\u00e1lun\u00c3arizya."}]},{"blockId":"block.84d518e259ab44b1a1eca79d42360223","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.447","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7mp\u00e1in: Y\u00eblv\u00d7m \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.23037a57969a4ee9866347fad566ca21","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.507","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblv\u00d7mp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.75b93c307bb042d4ab7e908266fed7f5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.598","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7mvevor: Threnin i y\u00eblv\u00d7m \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.e8aaf4416e4647e4b6e958d948f60bd7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.663","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblv\u00d7m \u00e7ztizya. R\u00e1 y\u00eblv\u00d7mvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.43e1da8a4e4f4e81b069dae6011773d6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.733","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7mf\u00ebr: \u00e2lum i y\u00eblv\u00d7m \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.8005ae3c38fa4cdfaee3ac62e2a536c8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.787","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblv\u00d7m \u00e3lumizya. \u00caers y\u00eblv\u00d7mf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.79fa1248920745689841cd482e7e2c25","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.856","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7silj\u00c9net: Vimin\u2019m\u00e7 threnin i y\u00eblverzetnel\u00ebrkw\u00d7sil \u00d1etib ma\u2019\u00e7zt\u2019jw\u00ebnowya p\u00c7n\u00df\u00eb j\u00c9gwa\u00c3vorenet \u00e3lumowya."}]},{"blockId":"block.23496ad4f0e74709b459e5c1572978ec","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.963","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha j\u00c9gwa\u00c3vorenet y\u00eblverzetnel\u00ebrkw\u00d7sil ma\u2019z\u00dfgu\u00d9\u2019jw\u00ebnizya. \u00caers \u00e3lum lym y\u00eblv\u00d7silj\u00c9net portimostizya."}]},{"blockId":"block.4c0a20b9ab3a44ea87dcc3fbbbbcb9c2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1064","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7siltae\u00db\u00e7: Y\u00eblverzetnel\u00ebrkw\u00d7sil tha p\u00e1nna\u2019m\u00e7 d\u00c7\u00d3 \u00e7ztimowya \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 d\u00c7\u00d3 tav \u00e5v\u2019jw\u00ebnimowya."}]},{"blockId":"block.7f93099a46214a17878d0acc0ebf9bc3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1167","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Po\u2019l\u00c7m \u00e3lumowfu. H\u00ebth kelde\u00dbon lym y\u00eblv\u00d7siltae\u00db\u00e7 r\u00c7n\u00d3 nesh\u2019m\u00e7 voren jem\u00e3izya."}]},{"blockId":"block.738dadad69fd4b05a5b30f29243b50e3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1245","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00d7silika\u00d9: Vimin\u2019m\u00e7 threnin i y\u00eblverzetnel\u00ebrkw\u00d7sil \u00d1etib p\u00e1n \u00e3lum jem\u00e3imowya t\u00d7 l\u00e1mgl\u00c9st."}]},{"blockId":"block.e81a4c818ef3455c951d83c831e3aec8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1338","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth zarun ol vesna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Lym po r\u00c7n\u00d3 y\u00eblv\u00d7silika\u00d9 k\u00e3menizya."}]},{"blockId":"block.25325d21f2de4c5289fe41640cd51994","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1409","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvfalnke\u00dbon: H\u00c5b\u00cden i y\u00eblvenortarnfaln \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.050657cc0c6d48bca6765318ad9f330b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1498","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblvfalnke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.83d446a03873421d9016940154c99fed","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1584","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvfalnake\u00dbon: Y\u00eblvenortarnfaln \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":52,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":53,"end":160,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":161,"end":199,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":200,"end":246,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":247,"end":265,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":266,"end":446,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":447,"end":506,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":507,"end":597,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":598,"end":6