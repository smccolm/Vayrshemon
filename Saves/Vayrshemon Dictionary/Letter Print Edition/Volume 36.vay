runs":[{"runId":"run.qt.55","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thirilin y\u00ebl velvor\u00e7ztthavun \u00cbers y\u00eblsiv\u00ebl a\u00d9im\u2019na ni graf \u00d1et tha thirilin lunor\u2019jw\u00ebn\u2019na threninun i y\u00ebl \u00cbers duldestd\u00c7\u00d3s\u00ebnalun ze\u00db\u00e7im\u2019na amo\u00d1owya, \u00e3\u00d1 \u00d1em tha vesnaun \u00cbers thavimy\u00cd\u00d7 d\u00c7\u00d3s\u00ebnalun ze\u00db\u00e7im\u2019jw\u00ebn\u2019na."}]},{"blockId":"block.b299770a6ff24c93b41a4ce570f49750","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.265","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsiv\u00eblvejem: Den gren y\u00eblsiv\u00ebl \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.fea39e73520c4678a5b4f816112ca73b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.338","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblsiv\u00ebl ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblsiv\u00eblvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.076da3a5c9e44af3ba3deed122abd3c9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.430","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsiv\u00eblvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblsiv\u00ebl po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.47a4279211a640f3951812d0b8614188","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.490","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblsiv\u00ebl b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblsiv\u00eblvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.c906afd111b14b0c96c14bee8ec40b5e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.563","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsiv\u00eblfader: Y\u00eblsiv\u00ebl \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.396ea006d1fa4755b81a8b9c065f34bc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.662","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblsiv\u00eblfader tav \u00e5vizya."}]},{"blockId":"block.74f9ec01db5f448cab665e81b2b7ecc3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.756","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsilenvejem: Den gren y\u00ebl shalinsilen \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.0ce2f21679ea4650bceb41d44a192b47","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.836","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebl shalinsilen ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblsilenvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.2f9ecc2d8bc4407d9a04a94ae39abfb9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.935","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsilenvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00ebl shalinsilen po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.45f9ce4b00c448ddb1c08dce1c9f4ac2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1002","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebl shalinsilen b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblsilenvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.b2bcd5ca9ab94373aaccc8b49e3a2ab2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1082","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsilenfader: Y\u00ebl shalinsilen \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.73ef70bfb2c54bd5a7e742d9a9836e30","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblsilenfader tav \u00e5vizya."}]},{"blockId":"block.a1235930afb140ce8860c83c1472727d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1282","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsowyaginv\u00d7: Ton i y\u00eblslebd\u00c7\u00d3s\u00ebnal \u00d3\u00c5tus jorinun s\u00c7fowya \u00e5\u00c3 vesna s\u00dflum kom ka zem zem\u2019falnthren o\u00c3owya."}]},{"blockId":"block.376e121206904b0885fd2ed1c707ecfb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1389","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nemir r\u00e1\u2019falnthren o\u00c3izya \u00e3\u00d1 y\u00eblsowyaginv\u00d7 f\u00c5wizya. Neks r\u00e1 po matondizya rav tav w\u00c5vumizya."}]},{"blockId":"block.bacf853d727b4062ba2f623b9f0ef22e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1482","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsowyafaren: Falnthren i \u00d1etib y\u00eblslebd\u00c7\u00d3s\u00ebnal \u00d3\u00c5tus jorinun s\u00c7fowya giktenv\u00d7owya vin ni \u00d5\u00dfr fradowya."}]},{"blockId":"block.981af1e5a0ca48048fd01e1012175036","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1587","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni venor mavem y\u00eblslebd\u00c7\u00d3s\u00ebnal \u00d3\u00c5tus jorinun s\u00c7fowya tondaizya. H\u00ebthven lym ly\u2019k\u00cfba\u00d1 y\u00eblsowyafaren portimostizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":12,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":13,"end":33,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":34,"end":54,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":55,"end":264,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":265,"end":337,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":338,"end":429,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":430,"end":489,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":490,"end":562,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":563,"end":661,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":662,"end":755,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":756,"end":835,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":836,"end":934,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":935,"end":1001,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1002,"end":1081,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1082,"end":1187,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"s