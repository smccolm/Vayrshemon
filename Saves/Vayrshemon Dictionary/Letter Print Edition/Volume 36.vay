language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00dflumlarod"}]},{"blockId":"block.95ad469d822c4b4194c12536b78ed7ce","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.28","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldst\u00eb\u00c5vejem: Den gren y\u00ebldest\u00eb\u00c5 \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.5dfc153d725d4e47bc699bdd8fed3deb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.102","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00ebldest\u00eb\u00c5 ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00ebldst\u00eb\u00c5vejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.fb8624b839f44bb9be517f61f6d47c55","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.195","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldst\u00eb\u00c5fader: Y\u00ebldest\u00eb\u00c5 \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.aeb6788344aa486a882b366f4ec6dc5c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.295","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00ebldst\u00eb\u00c5fader tav \u00e5vizya."}]},{"blockId":"block.5f666e9eba37484a915ee7db2da5761c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.389","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldorenjebra: Y\u00ebldurfadervoren \u00d1etib p\u00e1n klojvord\u00cdn\u00d7r \u00e5\u00c3 vesna s\u00dflum paven lametf\u00ebr\u00d3imowya."}]},{"blockId":"block.b2d94b7fd44340adb66cd6d5941f3d5b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.482","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel venim ma\u2019t\u00e7lowfu. R\u00e1 z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum vesna d\u00cdn\u00d7r f\u00c5wizya \u00e3\u00d1 y\u00ebldorenjebra t\u00d7 pel jem\u00e3izya."}]},{"blockId":"block.87e68a939cf14a2f870009651ceba1b2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.574","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldorenke\u00dbon: H\u00c5b\u00cden i y\u00ebldurvoren \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.8a8ce2d76a844faa8440623c3c5e5a3a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.658","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00ebldorenke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.ad3960f2aeef4301b10d1d06bf73d42b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.744","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldorenake\u00dbon: Y\u00ebldurvoren \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.e1ce414dc53f43daa55d8f574f1c3445","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.831","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00ebldorenake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.74def414d9fa4407b0630943df2e4ce5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.902","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldoren\u00d1\u00e9\u00d9: \u00d0\u00e9\u00d9 i y\u00ebldurfadervoren \u00d1etib h\u00ebth klojvord\u00cdn\u00d7r dlen\u00dbeminowya."}]},{"blockId":"block.8fb0b4c1d64e4518970847538804723f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.977","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00cdn\u00d7r borel masif\u2019m\u00e7 r\u00d7izya. \u00caers y\u00ebldoren\u00d1\u00e9\u00d9 r\u00e1 \u00d1etib lym wemizya h\u00c5b\u00cdizya."}]},{"blockId":"block.7a0b7ff90dad4e779e04504aef562f81","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1054","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldorenden: Neks w\u00c5vumen i y\u00ebldurvoren \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.bf6bb0c5f69b4d99b9bde2d5ee84f963","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1146","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00ebldorenden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.31a5ccb1362c4625b121cc3e2e647570","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1222","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldorenin\u00dfb\u00df: Threnin i y\u00ebldurfadervoren t\u00d7 s\u00dflum falib venim ma\u2019t\u00e7lh\u00eb\u00d5owfu jem\u00e3imowya."}]},{"blockId":"block.6199ce688e4a4a4784f844045fa9a2a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1311","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem y\u00cd\u00d7 y\u00ebldurfadervoren w\u00cf\u00dfizya. R\u00e1 y\u00ebldorenin\u00dfb\u00df shalenizya. Z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum velin gren marjo\u00d9 r\u00d7izya."}]},{"blockId":"block.677d45c792454efc95ed6c46bb0b736d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1413","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00dflum\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00ebld\u00c7\u00d3s\u00dflum vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]},{"blockId":"block.5d7a2928a79040648557d58babfbc5b0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1505","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren nor\u00d3aint\u00dff\u00c9ben vesna den kojizya. Vin d\u00c7\u00d3 t\u00e7lizya ol \u00e5\u00c3 y\u00ebld\u00dflum\u00cb\u00cdnon elyi\u00d1izya."}]},{"blockId":"block.8f0e104c0449425c9b963bb38332a695","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1591","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00dflumlarod: Y\u00ebld\u00c7\u00d3s\u00dflum \u00e5\u00c3 falib s\u00dflumun jw\u00ebnenplesten\u2019m\u00e7 d\u00c7\u00d3 \u00cbers "}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":101,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":102,"end":194,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":195,"end":294,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":295,"end":388,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0