\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00ebly\u00dflumilarod wa\u00d9gumizya."}]},{"blockId":"block.574a0525dc9247189d29b2f8ce13b7d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1488","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00dfluminoven: S\u00dflum falib d\u00c7\u00d3 i y\u00eblyemard\u00c7\u00d3s\u00dflum t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":14,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":15,"end":29,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":30,"end":116,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":117,"end":212,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":213,"end":327,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":328,"end":417,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":418,"end":500,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":501,"end":605,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":606,"end":691,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":692,"end":793,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":794,"end":907,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":908,"end":1003,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1004,"end":1092,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1093,"end":1190,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1191,"end":1277,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1278,"end":1372,"attributes":{"tracking":0,"wordSpacing":0.0,"baselin