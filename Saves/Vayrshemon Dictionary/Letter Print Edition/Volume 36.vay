tion":"none","text":"y\u00ebly\u00dfluma\u00cb\u00cdnon"}]},{"blockId":"block.887f201cb5904e86858d87b3b24f524c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.29","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyirilj\u00cdnda: Y\u00eblyemarthiril \u00d1etib j\u00cds\u00dflum tavtondaowya p\u00c7n\u00df\u00eb po\u2019l\u00e1m ma\u2019h\u00c5b\u00cdowya."}]},{"blockId":"block.f7a55ba6c8384c6f8496881ce5cfc32c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.112","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 giktenv\u00d7s\u00dflum j\u00cdizya. Falnthren ma\u2019o\u00c3izya. K\u00e3m y\u00eblyirilj\u00cdnda r\u00e1 ton f\u00c5wizya."}]},{"blockId":"block.6e1f7d04f455433da9b0c2a22e83e3ac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.192","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyiriljogor: Falnthren \u00d1etib h\u00ebth y\u00eblyemarthiril j\u00cds\u00dflum tha giktenv\u00d7s\u00dflum ven\u00e1lw\u00c5vumenowya."}]},{"blockId":"block.fa970e13cadf48ac8c9666ffdc3b43fd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.287","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tonun ilna\u2019m\u00e7 dlen\u00dbeminizya. P\u00e1n s\u00ebvenun y\u00eblyiriljogor y\u00cd\u00d7goren\u2019m\u00e7 gim\u00cba\u00d5izya."}]},{"blockId":"block.a80839a95a30411c8aaaf6acf22dfadb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.366","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyirilbroft: Y\u00eblyemarthiril falibi giktenv\u00d7s\u00dflum venim t\u00d7y\u00dfb\u00dfkelde\u00dbon\u2019jw\u00ebnimowya \u00e3\u00d1 tav broft\u2019jw\u00ebnowya."}]},{"blockId":"block.19ffa1de07254984b0fb8b4c9704d434","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.472","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ilna\u2019m\u00e7 tonun ni dalar j\u00cdizya. Yib\u2019\u00ebw ni klojvor y\u00eblyirilbroft mlapv\u00d7staizya t\u00d7 kinos giktenv\u00d7s\u00dflum dlen\u00dbeminizya."}]},{"blockId":"block.b07692abef394e98aafc36eea170bfa8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.587","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyinemvejem: Den gren y\u00eblyemarkinem \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.302cfd9349dd4bbcabbfb07a3fac1263","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.665","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblyemarkinem ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblyinemvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.e78d434462ff4bf7946e1700e69d9de6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.762","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyinemvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblyemarkinem po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.cdfaeb4f0dfe4ddbb995906444daa7b1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.827","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblyemarkinem b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblyinemvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.f865c63531f940da8cdd386dd72c36c4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.905","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyinemfader: Y\u00eblyemarkinem \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.c0a04769b4eb4a5ea30822ee3be70eea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1009","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblyinemfader tav \u00e5vizya."}]},{"blockId":"block.fcf2733194544482ba65f24499b69231","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1103","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00dfgu\u00d9gi\u00cden: Y\u00eblyemarz\u00dfgu\u00d9 vin threnins\u00dflumun r\u00c7n\u00d3 neksus giktenv\u00d7j\u00cden falnthrenowya."}]},{"blockId":"block.cd1697c820ec4088ac74ac9783bd69ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1191","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ol ven\u2019m\u00e7 r\u00d7izya. Yib\u2019\u00ebw h\u00ebth ikamo\u00d1ton y\u00ebly\u00dfgu\u00d9gi\u00cden broftizya."}]},{"blockId":"block.69d89d37876e4d3ba8f697319eba1577","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1256","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00dfgu\u00d9thren: S\u00dflumun thavvim y\u00eblyemarz\u00dfgu\u00d9 falibi d\u00c7\u00d3 r\u00c7n\u00d3 po kl\u00e1rimowya venka den ma\u2019\u00ddvimowya."}]},{"blockId":"block.a2f19832dc174f5caf0768e0ce8a6830","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1354","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nor\u00d3aint\u00dff\u00c9ben zyrizya. Rav lym y\u00ebly\u00dfgu\u00d9thren \u00d3\u00c5\u00e7izya t\u00d7 zem\u2019d\u00c7\u00d3 gimer tarenizya."}]},{"blockId":"block.6eedfd7900e1462597d6b41abe8bdf02","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1436","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00dfgu\u00d9neyal: Y\u00eblyemarz\u00dfgu\u00d9 falibi threnins\u00dflumun \u00c3\u00cd\u2019jw\u00ebnizya p\u00c7n\u00df\u00eb t\u00d7 \u00d1e\u00d5 d\u00c7\u00d3 dlen\u00dbeminizya."}]},{"blockId":"block.b06ebaac10004ae99204aa9bd1e5f822","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1531","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Daral \u00c5el\u2019m\u00e7 r\u00d7izya. Lym tav tarenizya yib\u2019\u00ebw \u00d1ed falib dlen\u00dbeminizya. \u00d0em y\u00ebly\u00dfgu\u00d9neyal r\u00d7izya."}]},{"blockId":"block.b4261b9d8754420c9ed3ab2978108a4f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1628","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebly\u00dfluma\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00eblyemarr\u00ddy\u00d3s\u00dflum vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":28,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":29,"end":111,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":112,"end":191,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":192,"end":286,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":287,"end":365,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":366,"end":471,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":4