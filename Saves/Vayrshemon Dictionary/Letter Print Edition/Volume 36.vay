,"sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletj\u00cden"}]},{"blockId":"block.b68d10ffaa96452b8ee6863dbf69d796","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.10","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletm\u00ebr"}]},{"blockId":"block.2a1e55895700493187134f839dde4f45","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.19","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletj\u00cden: y\u00eblet j\u00cden."}]},{"blockId":"block.811e7ed7b06f4291aae8bce4f9f37898","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.42","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za d\u00c7\u00d3plesten\u2019m\u00e7 y\u00ebletj\u00cdenowya\u2019na y\u00ebletun\u2019j\u00cden j\u00cdizya p\u00c7n\u00df\u00eb ma\u2019o\u00c3jems\u00e3\u00d1izya k\u00e3m \u00e5vim\u2019na komna faln p\u00e1n zaget thrin w\u00cfn\u00c7 tha elenol \u00d5\u00dfrvor y\u00cd\u00d7 norven\u2019na za\u2019\u00d3\u00c5\u00e7 ni k\u00e3v Kirke\u2019na \u00d3\u00c5\u00e7 ni dlenvelvorim\u2019na velngur."}]},{"blockId":"block.124046e5f35a43ffa422b7dc07408935","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.249","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletharen: y\u00eblet haren."}]},{"blockId":"block.f0d88b1761c14a50a94762234796e66c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.274","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Far\u2019m\u00e7 yelinun? Far\u2019m\u00e7 y\u00ebletharen\u2019h\u00c5. Thirilin ne\u2019haren r\u00e1 ika\u00d9izya. \u00d0etib nerbw\u00c5vumenvoren zeth r\u00e1 \u00d1\u00c5zowya ne?"}]},{"blockId":"block.94dc812a01ca4c7182619fa8d7ad52cb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.386","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblethareny\u00eblverzet: y\u00ebletharen y\u00eblverzet."}]},{"blockId":"block.063f9b7e78b64b6a9dc88cb1494eb2f7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.429","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0e\u00d5 goryemsjo\u00d9 i y\u00eblethareny\u00eblverzetun vimin \u00e3\u00d1 grelna r\u00d7owya; venim far haren f\u00c5wmarjo\u00d9owya \u00e3\u00d1 y\u00ebletharen gim mel r\u00d7owya. Govisy\u00cd\u00d7f\u00c5w ni Kampe\u00f1i i w\u00ddyaz grem \u00d1e\u00d5 y\u00eblverzet \u00db\u00d7b\u00dfatya r\u00e1."}]},{"blockId":"block.3031018792e64968a4e77e743dbe4633","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.615","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletr\u00ebmen: verzet r\u00c7n\u00d3 venor\u2019m\u00e7 y\u00ebletun i r\u00ebmen\u2019i p\u00e1l\u00dfn wemimowfu k\u00e3m d\u00cdn\u00d7r."}]},{"blockId":"block.875d99cf93214e3ba22f9533f5a7090e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.693","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Drig\u00e1lget \u00d1etib ni Ejipt maser\u00ebw ly wemizya ly tar\u00d5owya, venamyems\u00d7un \u00e3\u00d1 venamolenun \u00e3\u00d1 y\u00ebletr\u00ebmenun \u00e3\u00d1 r\u00ebmenun \u00e3\u00d1 r\u00ebmaj."}]},{"blockId":"block.65bd7938244f4cec9854336a036bd05f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.815","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletp\u00e1in: Y\u00eblet \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.d74148cf59d64a17908ba4c8d8436292","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.873","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebletp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.c5c001e2433b428782b9ad58b3000199","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.963","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletvermil: y\u00eblet vimvor."}]},{"blockId":"block.85694aac28c84f3f8340f528febddc01","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.990","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Slebe. Vel r\u00c7n\u00d3 zem. Murens\u00dflumun\u2019tommarjo\u00d9un dest\u00eb\u00c5e. Ai \u00e3\u00d1ta\u00d9zsalena\u2019pelen y\u00ebletvermilun, merkw\u00d7silpor\u00ebnvorin wemarimizfu murd\u00c7vun, lymget nev\u2019m\u00e7 s\u00dflumunget vehenowya zem. Vel r\u00c7n\u00d3 zem. K\u00e3m sh\u00ebral velvor\u00e7ztthave zemget."}]},{"blockId":"block.85002c464e3841779059d6ea906df031","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1212","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletvevor: Threnin i y\u00eblet \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.ed176b5823214673adee372f96ed3c37","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1275","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblet \u00e7ztizya. R\u00e1 y\u00ebletvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.0578f9b101904a2d9c0bb560ac7d2a5c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1343","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletvimvor: y\u00eblet vimvor."}]},{"blockId":"block.e6f6cc9a33d14f26b03796da9ac4fd6e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1370","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ai arzi\u2019h\u00c5 var\u00dfnkinf\u00c7l \u00d1etib m\u00dfrnav matondizya lym gimol yib\u2019m\u00e7 prodvar t\u00d7 elen kl\u00e1rverzet y\u00ebletvimvor gaz\u00e9m\u2019ve \u00e3\u00d1 lym\u2019jo\u00d9 kom murtar\u2019ve."}]},{"blockId":"block.3041e30e436f4c1c9b02e400a889e561","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1508","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletf\u00ebr: \u00e2lum i y\u00eblet \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.ff5ca699209444759d0c3be81e215f33","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1560","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblet \u00e3lumizya. \u00caers y\u00ebletf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.6f97bb8533524084a8e77c1aad1214d4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1627","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletmelunfader: y\u00eblet melunfader."}]},{"blockId":"block.e38a32d0d6af4c5883172b0551e1df66","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1662","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni ragum\u00e7l\u00d7ono\u00c3t\u00e7 y\u00ebletmelunfader ragumizya."}]},{"blockId":"block.ae3d38e0e2704b46a9f5d52499ba3475","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1707","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebletm\u00ebr: y\u00eblet m\u00ebr."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":9,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":10,"end":18,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":19,"end":41,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":42,"end":248,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":249,"end":273,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":274,"end":385,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":386,"end":428,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":429,"end":614,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":615,"end":692,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":693,"end":814,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":815,"end":872,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":873,"end":962,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":963,"end":989,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":990,