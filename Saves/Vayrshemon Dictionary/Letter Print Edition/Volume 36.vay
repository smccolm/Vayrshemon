anguage.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyl\u00d7onjelin: Y\u00eblyemardlen\u00e7l\u00d7on k\u00c7nib s\u00dflum p\u00e1n man\u00d7njemlen t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 tav \u00c3\u00cd\u2019jw\u00ebnowya."}]},{"blockId":"block.0fdf30bbf22f4ac99ce9d109fc6286d9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.306","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Mav jelam kinos kojizya. Vin nabyems t\u00e7lizya za \u00e5\u00c3 y\u00eblyl\u00d7onjelin marin ef\u2019w\u00cf\u00df lym miktaz\u00d7rizya."}]},{"blockId":"block.05def164aad74a04bfa89b6092638943","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.402","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyl\u00d7onajelin: Y\u00eblyemargl\u00c9z\u00cben \u00e7l\u00d7on k\u00c7nib s\u00dflum p\u00e1n man\u00d7njemlen t\u00d7y\u00dfb\u00dfizya \u00e3\u00d1 tav \u00c3\u00cd\u2019jw\u00ebnowya."}]},{"blockId":"block.a252447e475f40899cbffd6733821d2c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.499","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Mav jelam kinos kojizya. Vin nabyems t\u00e7lizya za \u00e5\u00c3 y\u00eblyl\u00d7onajelin marin ef\u2019w\u00cf\u00df lym miktaz\u00d7rizya."}]},{"blockId":"block.179037f7b78244019205f795d345e36f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.596","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyl\u00d7onatht\u00e7l: Marjo\u00d9 gren \u00d1etib p\u00e1n ef\u2019t\u00e7lh\u00eb\u00d5 r\u00ddy\u00d3s\u00dflum y\u00eblyemargl\u00c9z\u00cben \u00e7l\u00d7on neks portimostowya."}]},{"blockId":"block.7f97b562ef754d88a2d55e16e601f4ce","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.696","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym venim ma\u2019t\u00e7lh\u00eb\u00d5izya. Tha y\u00eblyl\u00d7onatht\u00e7l pel y\u00eblyemargl\u00c9z\u00cben \u00e7l\u00d7on denizya."}]},{"blockId":"block.e7db8f572b2646b0a56af7aa1d187dc7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.775","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyl\u00d7onatwjyb: Threnin i y\u00eblyemargl\u00c9z\u00cben \u00e7l\u00d7on k\u00c7nib s\u00dflumun tw\u00ddnjybowya t\u00d7 le\u00db\u00c7f\u00c5w."}]},{"blockId":"block.7a1f032a886145bc868fc1716f7cd0e2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.861","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym ni y\u00eblyemargl\u00c9z\u00cben \u00e7l\u00d7on t\u00e7lh\u00eb\u00d5izya p\u00c7n\u00df\u00eb ma\u2019o\u00c3ilizya. Ni y\u00eblyl\u00d7onatwjyb \u00d3\u00c5tusol wa\u00d9gumizya."}]},{"blockId":"block.d4bbcc4e1bd544a1823badf3db304bac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.958","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblyl\u00d7ontht\u00e7l: Marjo\u00d9 gren \u00d1etib p\u00e1n ef\u2019t\u00e7lh\u00eb\u00d5 r\u00ddy\u00d3s\u00dflum y\u00eblyemardlen\u00e7l\u00d7on neks portimostowya."}]},{"blockId":"block.12a84dcd2e984723ba11586f9099f42c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1053","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym venim ma\u2019t\u00e7lh\u00eb\u00d5izya. Tha y\u00eblyl\u00d7ontht\u00e7l pel y\u00eblyemardlen\u00e7l\u00d7on denizya."}]},{"blockId":"block.1a867b8d23964d48b862629bcccfa2fb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1127","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization"