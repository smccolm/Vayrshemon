ge.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblv\u00dbmelf\u00ebr: \u00e2lum i y\u00eblverzetve\u00dbmel \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.6976040dfc914ad184b467848c3a7b23","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.172","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00eblverzetve\u00dbmel \u00e3lumizya. \u00caers y\u00eblv\u00dbmelf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.37241043dc3e42da9ae06a96cc96ee45","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.252","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvizyajw\u00c5b\u00cd: H\u00c5b\u00cden i y\u00eblverzet paven lunor s\u00c7fizya \u00d1etib p\u00e1n falnthren thavvimna nerbyal miktaz\u00d7rs\u00dflumowya."}]},{"blockId":"block.614491823adc4175a215691c24444c9c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.363","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n d\u00c7\u00d3 grasnotimizya y\u00eblvizyajw\u00c5b\u00cd ly\u2019tremb\u00c5r elyi\u00d1izya."}]},{"blockId":"block.c75c68d3895f4dccb88e2519485f8e98","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.421","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvizyah\u00ebth: H\u00c5b\u00cden i y\u00eblverzet paven lunor s\u00c7fizya \u00d1etib h\u00ebth venor i nerbyal thrin\u00c3\u00cdowya t\u00e7lowya."}]},{"blockId":"block.1b8999d86f7040498eab5405d8414b8a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.522","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth lym sezif\u00c7\u00c3izya y\u00eblvizyah\u00ebth t\u00e7lizya. Ni goryems po ma\u2019t\u00e7lizya."}]},{"blockId":"block.4709c9c453aa4f658ac28a229be61e73","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.591","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvizyapof\u00c5w: H\u00c5b\u00cden i y\u00eblverzet paven lunor s\u00c7fizya \u00d1etib \u00cbers ef\u2019gl\u00c9st vin \u00e5\u00c3 falnthren \u00e5\u00c3 vesna s\u00dflum f\u00c5wimowya."}]},{"blockId":"block.5961fb0736134d379d2b715d2b4a6d57","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.708","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi ton tavtondaizya p\u00c7n\u00df\u00eb pel venim wa\u00d9gumizya. Vin zi\u2019tremb\u00c5r da\u00c3izya pel y\u00eblvizyapof\u00c5w mlapv\u00d7staizya."}]},{"blockId":"block.d36079bd32fe41e6b8ed3ca5dd59ea41","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.812","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvil\u00ebmj\u00c9net: Vimin\u2019m\u00e7 threnin i y\u00eblverzetnil\u00ebm \u00d1etib ma\u2019\u00e7zt\u2019jw\u00ebnowya p\u00c7n\u00df\u00eb j\u00c9gwa\u00c3vorenet \u00e3lumowya."}]},{"blockId":"block.91cd1ce65fd64c759452b5dbb73925aa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.913","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha j\u00c9gwa\u00c3vorenet y\u00eblverzetnil\u00ebm ma\u2019z\u00dfgu\u00d9\u2019jw\u00ebnizya. \u00caers \u00e3lum lym y\u00eblvil\u00ebmj\u00c9net portimostizya."}]},{"blockId":"block.b86e0144de944d25a4926e72025e8f94","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1008","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvil\u00ebmtae\u00db\u00e7: Y\u00eblverzetnil\u00ebm tha p\u00e1nna\u2019m\u00e7 d\u00c7\u00d3 \u00e7ztimowya \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 d\u00c7\u00d3 tav \u00e5v\u2019jw\u00ebnimowya."}]},{"blockId":"block.69850935bfea42d8b096d95fd851801f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1105","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Po\u2019l\u00c7m \u00e3lumowfu. H\u00ebth kelde\u00dbon lym y\u00eblvil\u00ebmtae\u00db\u00e7 r\u00c7n\u00d3 nesh\u2019m\u00e7 voren jem\u00e3izya."}]},{"blockId":"block.193abde9ba224a5ea376b6549a63f2ac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1183","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvil\u00ebmika\u00d9: Vimin\u2019m\u00e7 threnin i y\u00eblverzetnil\u00ebm \u00d1etib p\u00e1n \u00e3lum jem\u00e3imowya t\u00d7 l\u00e1mgl\u00c9st."}]},{"blockId":"block.54b35684874f4b3a9b87e30eee08d63a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1270","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth zarun ol vesna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Lym po r\u00c7n\u00d3 y\u00eblvil\u00ebmika\u00d9 k\u00e3menizya."}]},{"blockId":"block.c5303d6456e24ff4b24f382b29e6d21f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1341","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvimelp\u00e1in: Y\u00eblverzetkrannimel \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.446c13f0698c4dc5b19d603c4894be31","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1415","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblvimelp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.15b248377f43451e9c299a7f1b4d8e19","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1508","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvimelvevor: Threnin i y\u00eblverzetkrannimel \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.0e6368e99a784b78a9dca4ea52e3ada0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1587","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00eblverzetkrannimel \u00e7ztizya. R\u00e1 y\u00eblvimelvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.3566a078f72842919f5a111cf9782780","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1671","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblvimelf\u00ebr: \u00e2lum i y\u00eblverzetkrannimel \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":25,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":26,"end":106,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":107,"end":171,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":172,"end":251,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":252,"end":362,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":363,"end":420,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":421,"end":521,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":522,"end":590,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":591,"end":707,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":708,"end":811,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":812,"end":912,"attributes":{"