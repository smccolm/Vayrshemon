0ebltarventhelir po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.92694b973d7a4a5d936e8e26071bfaa9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.385","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00ebltarventhelir b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00ebltelirvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.7c7c96fbcd7a4def9412b9b4c1be65c8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.465","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltelirfader: Y\u00ebltarventhelir \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.94cb9428c4dc4362ac4f62b5cb09a6ad","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.571","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00ebltelirfader tav \u00e5vizya."}]},{"blockId":"block.c00151601fef4050babdbec923ca6d03","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.665","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltenelpoost: Voril i y\u00eblthrenin i venel \u00d1etib ni tonun i vesna s\u00dflum portimostimowya."}]},{"blockId":"block.a67b4297dd604d26920dbdf2ba9e48d0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.753","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za neks giktenv\u00d7izya. Za\u2019tonun ni r\u00e1 y\u00ebltenelpoost \u00cb\u00df\u00dbizya."}]},{"blockId":"block.4b3fd77381134cc69bc6a36f04290e09","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.813","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblteneltar\u00d5: Voril i y\u00eblthrenin i venel \u00d1etib venim p\u00e1n vesna s\u00dflum ma\u2019giktenv\u00d7imowya."}]},{"blockId":"block.0494223cf6224b328ba0e20d3535d786","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.901","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 zem r\u00e1 dlenson\u2019m\u00e7 r\u00d7izya. Vemyib\u2019\u00ebw r\u00e1 y\u00eblteneltar\u00d5 den\u2019jw\u00ebnizya."}]},{"blockId":"block.f7649b885bef490ab2fb4f4e7acdbd15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.972","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltenelin\u00dfb\u00df: Voril i y\u00eblthrenin i venel \u00d1etib vesna s\u00dflum p\u00e1n k\u00cfba\u00d1s\u00dflum giktenv\u00d7owya denowya."}]},{"blockId":"block.8d112c403ee04a709af0fd8b26fa16d5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1069","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 tonun venim ma\u2019s\u00c7fizya. Vin za den f\u00c5wizya r\u00e1 ni za\u2019tonun r\u00e1\u2019y\u00ebltenelin\u00dfb\u00df t\u00d7y\u00dfb\u00dfizya."}]},{"blockId":"block.7b10bcdead7749b78bed10702c9fce4c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1159","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblteninj\u00c9net: Vimin\u2019m\u00e7 threnin i y\u00eblthrenin \u00d1etib ma\u2019\u00e7zt\u2019jw\u00ebnowya p\u00c7n\u00df\u00eb j\u00c9gwa\u00c3vorenet \u00e3lumowya."}]},{"blockId":"block.dc203c8f128a4201bf807b7d0f40443c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1256","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha j\u00c9gwa\u00c3vorenet y\u00eblthrenin ma\u2019z\u00dfgu\u00d9\u2019jw\u00ebnizya. \u00caers \u00e3lum lym y\u00eblteninj\u00c9net portimostizya."}]},{"blockId":"block.552def82594d495e85f7c8aa8624ff30","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1347","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebltenink\u00e3men: Y\u00eblthrenin k\u00e3m r\u00c7n\u00d3 thavvim\u2019m\u00e7 \u00d1etun k\u00e3menimowya."}]},{"blockId":"block.dfe857c09a034db7a171d5b7d0f4fb83","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1412","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gurin \u00d1em po neks\u2019m\u00e7 kojizya. Ni vesna \u00e7l\u00d7on y\u00ebltenink\u00e3men vesnar\u00d7izya."}]},{"blockId":"block.7a8ec037f3014ea186e1a5b0edc4d420","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1484","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblteninmem: Y\u00eblthrenin mem\u2019m\u00e7 t\u00d7 \u00d1e\u00d5 d\u00c7\u00d3 venka y\u00cd\u00d7 jw\u00ebn\u2019m\u00e7 r\u00d7owya."}]},{"blockId":"block.4e2c9b0bbc704c89ab1e20fe415998f5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1552","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vimin\u2019m\u00e7 vesnalen o\u00c3\u2019jw\u00ebnizya. T\u00d7 \u00d1e\u00d5 \u00e5v \u00d3\u00c5tusol y\u00eblteninmem r\u00d7izya \u00e3\u00d1 lym g\u00e7z\u00e9lizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":11,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":12,"end":62,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":63,"end":138,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":139,"end":218,"attributes":{"tracking":0,"wordSpacing":0