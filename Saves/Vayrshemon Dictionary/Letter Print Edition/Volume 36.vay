18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmlapv\u00d7sta grelna"}]},{"blockId":"block.3dc3c9f3bd9f4762b4cd4dce48cb94f1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.20","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinj\u00c9net"}]},{"blockId":"block.97d80e88159d46f2a42693d629e0a678","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.34","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmlapv\u00d7sta grelna: y\u00ebl mlapv\u00d7sta grelna."}]},{"blockId":"block.879050d6c17849368967f7a95dfc4b27","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.77","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"M\u00dfrnav gren goryems l\u00ddn\u00c5r kraths\u00dflum kom falnthrenowfu po, \u00d1etib vorelkranun i dornel vin naorjo\u00d9olun gren zem velrenowya y\u00eblmlapv\u00d7sta grelna gl\u00c9z\u00cben\u2019jw\u00ebnowya?"}]},{"blockId":"block.14c19d6849084c168cb4dbfa4c755cbe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.237","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmw\u00cfn\u00c7ke\u00dbon: H\u00c5b\u00cden i y\u00eblmelw\u00cfn\u00c7 \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.cff3f9c987ff4f0fbf73c4e59f161f15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.320","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00eblmw\u00cfn\u00c7ke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.f5c31d4b1f6d4c189d5e3ca440625741","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.406","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmw\u00cfn\u00c7ake\u00dbon: Y\u00eblmelw\u00cfn\u00c7 \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.8bcf971ce2494424bc97804422b720fa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.492","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00eblmw\u00cfn\u00c7ake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.a52cc0a6252d411c962045436f87fb61","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.563","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblmw\u00cfn\u00c7den: Neks w\u00c5vumen i y\u00eblmelw\u00cfn\u00c7 \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.7af481f98a864a4fab4c14d0b7dfb6db","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.654","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00eblmw\u00cfn\u00c7den r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.f8e2fa03ba804a8798d81f69c60648ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.730","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblnmfel\u00cb\u00cdnon: S\u00dflum falib d\u00c7\u00d3 i y\u00eblnimfel vingim f\u00d7owya p\u00e1n arventhrenden mlapv\u00d7staowya."}]},{"blockId":"block.453418b419594c5dba196ad2bddce295","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.820","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren nor\u00d3aint\u00dff\u00c9ben vesna den kojizya. Vin d\u00c7\u00d3 t\u00e7lizya ol \u00e5\u00c3 y\u00eblnmfel\u00cb\u00cdnon elyi\u00d1izya."}]},{"blockId":"block.b7e6950a840a40c8b542d1619d4df072","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.906","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblnmfellarod: Y\u00eblnimfel \u00e5\u00c3 falib s\u00dflumun jw\u00ebnenplesten\u2019m\u00e7 d\u00c7\u00d3 \u00cbers lamprod y\u00c9nenowya."}]},{"blockId":"block.8e3649c3f7924e00ad0a9eb4adb783b8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.993","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den gren nor\u00d3aint\u00dff\u00c9ben vesna\u2019m\u00e7 r\u00d7izya. T\u00d7 jw\u00ebnenplesten\u2019m\u00e7 voren zem ni dar\u00c5el i y\u00eblnmfellarod wa\u00d9gumizya."}]},{"blockId":"block.1761d347f9944988b24ebad65682a3cf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1107","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblnmfelnoven: S\u00dflum falib d\u00c7\u00d3 i y\u00eblnimfel t\u00d7 vimin\u2019m\u00e7 venor ni po\u2019\u00e7l\u00d7on f\u00d7owya."}]},{"blockId":"block.b810b29cc5e8444b9b1ef82260b95a03","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblnimfel sezif\u00c7\u00c3izya. Y\u00eblnmfelnoven taren f\u00c5wizya \u00e3\u00d1 braden sezif\u00c7\u00c3izya."}]},{"blockId":"block.737f7988eb904b47b94167397e8d4eeb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1262","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblnimfel: y\u00ebl nimfel."}]},{"blockId":"block.52e62ed7e782487682dca2ddc0c0c3f4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1285","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kom y\u00ebljo\u00d9\u2019m\u00e7 z\u00e1ldlen\u00dbeminel t\u00e7lizya zem ka Pomona\u2019bov\u00ebl l\u00ddn\u00c5r far\u00d3emizya yelfalun r\u00c7n\u00d3 \u00e7\u00db\u00c9im\u2019na \u00e3\u00d1 nel\u00ebr\u2019m\u00e7 r\u00e3bun; p\u00c7n\u00df\u00eb Ev ma\u2019\u00e7\u00db\u00c9im\u2019na maves zair r\u00c7n\u00d3 y\u00cd\u00d7 a\u00d9zna elin k\u00e3v y\u00eblnimfel lomih gimolelin\u2019m\u00e7 prodvara fengolh\u00dfmim\u2019na i venik ka ner\u00c3\u00cd Ida slefy\u2019m\u00e7 kelde\u00dbonjw\u00ebnenizya."}]},{"blockId":"block.9f0f6d5c6d3d45509e4876795987673d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1560","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblsalinj\u00c9net: Vimin\u2019m\u00e7 threnin i y\u00eblshalin \u00d1etib ma\u2019\u00e7zt\u2019jw\u00ebnowya p\u00c7n\u00df\u00eb j\u00c9gwa\u00c3vorenet \u00e3lumowya."}]},{"blockId":"block.be99bb199f8e488e85deda8f0d580467","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1656","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha j\u00c9gwa\u00c3vorenet y\u00eblshalin ma\u2019z\u00dfgu\u00d9\u2019jw\u00ebnizya. \u00caers \u00e3lum lym y\u00eblsalinj\u00c9net "}]}]}]},"styleFeature