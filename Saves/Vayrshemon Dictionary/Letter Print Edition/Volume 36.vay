:"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00d5f\u00c5wginv\u00d7"}]},{"blockId":"block.212946d76bd746e48beea79525f7f18a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.28","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldrda\u00c3majo\u00d9: Threnin i y\u00ebldurda\u00c3 \u00d1etib \u00cbers nerbyal miktaz\u00d7rs\u00dflum\u2019jw\u00ebnimowya."}]},{"blockId":"block.bf057df106a244e4a185b48d28d33ef5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.108","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Enif lym thav \u00db\u00c7dizya. Vin meranelyi\u00d1 broftizya y\u00ebldrda\u00c3majo\u00d9 p\u00e1izya."}]},{"blockId":"block.d3ba108ea6544ad59c523852b34d8e12","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.178","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldrda\u00c3melum: Y\u00ebldurda\u00c3 f\u00d7\u2019en vinel \u00cbers denun gren marjo\u00d9 marjo\u00d9 tav \u00e3\u00d1 tav \u00e3lum\u2019en."}]},{"blockId":"block.194cf4c8f2fd4c2f84094e5375971934","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.265","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni neks threnin jemin\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. \u00caers kwesta rav \u00cbers y\u00eblverzet lym y\u00ebldrda\u00c3melumizya."}]},{"blockId":"block.c47489e49c8946a3ad162f265418691c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.356","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldthar\u00cb\u00cdnon: Y\u00ebldurthar \u00d1etib \u00cbers venor\u2019m\u00e7 \u00cb\u00cdnon marin p\u00e1f\u00d7\u2019m\u00e7 w\u00c5vumen f\u00d7imowya."}]},{"blockId":"block.4a82a4f02d8740dc8382df90134b9d91","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.440","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel pel giktenv\u00d7izya za\u2019tremb\u00c5r y\u00ebldthar\u00cb\u00cdnon grasnotizya. Yib\u2019\u00ebw rav za vel veritasizya."}]},{"blockId":"block.a3ebdb63d1bd4f52a31ab4effe9085ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.532","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldtharveerb: Y\u00ebldurthar \u00d1etib s\u00dflum \u00cbers nerbyal f\u00d7owya \u00e3\u00d1 t\u00d7 \u00d1etib broft\u2019jw\u00ebnowya."}]},{"blockId":"block.bd5607532aeb4185872b56b7e0e1972f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.618","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna tremb\u00c5r ilna\u2019m\u00e7 falnthren \u00cbers vengraf f\u00d7izya. R\u00e1\u2019y\u00ebldtharveerb r\u00e1 p\u00e1n s\u00ebvenun nerbyalizya."}]},{"blockId":"block.851f87db71c04856a8b2342eb333f60a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.716","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldtharin\u00dfb\u00df: Y\u00ebldurthar k\u00e3m vesna s\u00dflum nerbyalizya f\u00d7\u2019en p\u00c7n\u00df\u00eb t\u00d7 k\u00cfba\u00d1\u2019m\u00e7 f\u00c7l broft\u2019en."}]},{"blockId":"block.f401ac214eb34482926eb880be75e16c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.808","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nerbyal za\u2019k\u00cfba\u00d1 r\u00d7izya. R\u00c7n\u00d3 r\u00e1\u2019tremb\u00c5r r\u00e1 y\u00ebldtharin\u00dfb\u00dfizya \u00e3\u00d1 t\u00d7 murlametw\u00c5vum r\u00e1 broftizya."}]},{"blockId":"block.ca9685ac2f9f4941a4ee8291c5d97958","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.904","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldthavke\u00dbon: H\u00c5b\u00cden i y\u00ebldur\u00e7ztthav \u00d1etib ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren marin m\u00d7s \u00e5vimowya."}]},{"blockId":"block.f7212230b7db4bd8b3fe45a15f1c4ea8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.990","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 gl\u00c9stvoren thav \u00e7ztimizya. Pel ni p\u00e1f\u00d7\u2019m\u00e7 gl\u00c9stvoren y\u00ebldthavke\u00dbon gl\u00c9stizya."}]},{"blockId":"block.77b90e972ae04ea3b21120b7d8ffa7d5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1076","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldthavake\u00dbon: Y\u00ebldur\u00e7ztthav \u00d1etib t\u00d7 venor jem\u00e3imowya vinto h\u00c5b\u00cd\u2019m\u00e7 w\u00cf\u00dfen broftimowya."}]},{"blockId":"block.9204b7a280154badb5cc62efd1483a7c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1165","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za y\u00ebldthavake\u00dbon f\u00c5wizya \u00e3\u00d1 rav \u00d1etib l\u00e1mgl\u00c9st po \u00e3lumatya s\u00eb\u00dbgaizya."}]},{"blockId":"block.c707c00b87ec4ad79edfb3239b9e8859","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1236","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldthavden: Neks w\u00c5vumen i y\u00ebldur\u00e7ztthav \u00d1etib w\u00cf\u00dfen miktaz\u00d7rs\u00dflumowya p\u00e1n l\u00e1mgl\u00c9st t\u00e7lowya."}]},{"blockId":"block.d74927c4aa7f4f6eaea293679ac9793c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1330","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 broft venim ma\u2019s\u00c7fizya. \u00caers y\u00ebldthavden r\u00e1 \u00d1etib w\u00cf\u00dfen ef\u2019w\u00cf\u00df h\u00c5b\u00cdizya."}]},{"blockId":"block.c402a5976a4f4c50b131026778496378","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1406","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebld\u00d5f\u00c5wginv\u00d7: Ton i y\u00ebldur grel d\u00c7\u00d3v\u00df\u00d5f\u00c5w \u00e5\u00c3 vesna s\u00dflum kom ka zem zem\u2019falnthren o\u00c3owya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":27,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":28,"end":107,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":108,"end":177,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":178,"end":264,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":265,"end":355,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":356,"end":439,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":440,"end":531,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":532,"end":617,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":618,"end":715,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":716,"end":807,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":808,"end":903,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":904,"end":989,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":990,"end":1075,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1076,"end":1164,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1165,"end":1235,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1236,"end":