00000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblej\u00cdenke\u00dbon"}]},{"blockId":"block.2a1b9f9bf9af4367993131fbab0890f4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.14","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebleaderf\u00ebr"}]},{"blockId":"block.588553e403974e33a630466645b8e5a8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.26","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblej\u00cdenke\u00dbon: Y\u00ebletj\u00cden portimost\u2019en yib\u2019\u00ebw vin \u00d3\u00c5tus\u2019t den neks den gl\u00c9stl\u00e1mowya."}]},{"blockId":"block.0809df2ee3d441899f51a9a9c4859cb4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.110","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Giktenv\u00d7j\u00cden vemyib\u2019\u00ebw mem\u2019m\u00e7 ma\u2019r\u00d7izya. Vin za elyi\u00d1izya r\u00e1 y\u00eblej\u00cdenke\u00dbonizya."}]},{"blockId":"block.5480cb7abaca4a8bae620bb07d1a6494","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.190","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblej\u00cdenpoost: H\u00c5b\u00cden i y\u00ebletj\u00cden \u00cbers \u00d3\u00c5tus stras\u2019m\u00e7 denun."}]},{"blockId":"block.ea2b5613ed104ca5aa1bdc511311fd9b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.251","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks den vesna \u00d1et memilizya. \u00d2\u00c5tus\u2019t den t\u00e7lizya. Rav y\u00eblej\u00cdenpoost tonda\u2019jw\u00ebnizya."}]},{"blockId":"block.494b519dc39a441b98ef4f0cc003aa66","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.336","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblej\u00cdeno\u00c3: Neks den i y\u00ebletj\u00cden \u00d1etib omi lomih jorin \u00e7ztowya p\u00e1n l\u00e1mgl\u00c9st."}]},{"blockId":"block.d9b64e3db6444daaa85cff63e2a2ac7a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.413","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni sulmar r\u00e1 y\u00eblej\u00cdeno\u00c3 mlapv\u00d7staizya. R\u00e1 elyi\u00d1izya t\u00d7 tav ef\u2019t\u00d7y\u00dfb\u00dfkelde\u00dbon."}]},{"blockId":"block.c18bf1b514ce4ddf9e55e3feafc17e87","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.491","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblearenp\u00e1in: Y\u00ebletharen \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.c64fa7046bbe4129b8bb99b6a3752870","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.557","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00eblearenp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.83e1fcc5bc7e451090d59d4a30f1f4b4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.650","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblearenvejem: Den gren y\u00eblenkerilharen \u00d1etib tremb\u00c5r thrin venor\u2019m\u00e7 \u00e5v a\u00d9owya."}]},{"blockId":"block.3eb88b531e2d4c84a306410d875e53c8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.730","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d2\u00c5tus y\u00eblenkerilharen ilna\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya. Ni y\u00eblearenvejem r\u00e1\u2019mela h\u00c5b\u00cdizya \u00d1etib za\u2019k\u00cfba\u00d1 r\u00d7izya."}]},{"blockId":"block.285d8a3a7258492098b2f7ff37e4f573","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.829","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblearenvevor: Threnin i y\u00ebletharen \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.fe0a901f7d774a1fbbdf8aab23ae0538","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.900","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebletharen \u00e7ztizya. R\u00e1 y\u00eblearenvevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.df06621fe6b544c399bc57c452208e87","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.976","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblearenvesna: \u00d0et \u00d1etib ni \u00e7l\u00d7on i y\u00eblenkerilharen po\u2019d\u00c7\u00d3 f\u00d7owya."}]},{"blockId":"block.c8fdce56f84d4615abe883a21527e23c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1043","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Y\u00eblenkerilharen b\u00e9rvimizya. Vinto po t\u00d7y\u00dfb\u00dfimizya y\u00eblearenvesna ly\u2019d\u00c7\u00d3 \u00db\u00c7dizya."}]},{"blockId":"block.2f630312474e49209856492e9a1bbdd0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1123","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblearenfader: Y\u00eblenkerilharen \u00d1etib h\u00ebth a\u00d9s\u00dflum \u00c3\u00cdthavowya \u00cbers tremb\u00c5run i k\u00cfba\u00d1s\u00dflumun venim d\u00c7\u00d3owya."}]},{"blockId":"block.d6b312a8920941c08d0df6e1242ebf1d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1229","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"A\u00d9s\u00dflum venor\u2019m\u00e7 venor thav r\u00d7izya. Lym venik\u2019t threnin \u00e3lumizya \u00e3\u00d1 y\u00eblearenfader tav \u00e5vizya."}]},{"blockId":"block.e91f89e5564c411ab64ddd673a0eb5c5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1323","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00eblearenf\u00ebr: \u00e2lum i y\u00ebletharen \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.5999ddf7fbce4f63bbea64b4eabf8e24","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1383","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebletharen \u00e3lumizya. \u00caers y\u00eblearenf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]},{"blockId":"block.8d6b6f9412c14dee923e12cade82a058","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1458","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebleaderp\u00e1in: Y\u00ebletmelunfader \u00d1etib kin marin ef\u2019verzet tav ragumowya."}]},{"blockId":"block.f0e0741cb75246c2bad0ef44e4b69902","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1529","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lym kin p\u00e1in ma\u2019\u00c7pibaizya. Vin y\u00ebleaderp\u00e1in t\u00e7lizya vorny\u00cd\u00d7 vorn\u2019m\u00e7 ragum\u00e7l\u00d7ono\u00c3t\u00e7 tar\u00d5izya."}]},{"blockId":"block.e6a9b98b1f4d40249d4b0b08d9f01d7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1622","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebleadervevor: Threnin i y\u00ebletmelunfader \u00d1etib t\u00d7 thavvimna f\u00ebr jem\u00e3imowya."}]},{"blockId":"block.39cb353dd4aa46cfaf8451bf616c7ad4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1698","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem gimam y\u00ebletmelunfader \u00e7ztizya. R\u00e1 y\u00ebleadervevor t\u00d7 thavvimna venal jem\u00e3izya."}]},{"blockId":"block.c8edf1a1d97e493db3ce64aeb17978c3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1779","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebleaderf\u00ebr: \u00e2lum i y\u00ebletmelunfader \u00d1etib venor i d\u00c7\u00d3 gl\u00c9stowya."}]},{"blockId":"block.e217d21af75f44828fd965620953c7b2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1844","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren tav\u00ebr y\u00ebletmelunfader \u00e3lumizya. \u00caers y\u00ebleaderf\u00ebr zem venor i d\u00c7\u00d3 h\u00c5b\u00cdizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":13,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":14,"end":25,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":26,"end":109,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":110,"end":189,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":190,"end":250,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":251,"end":335,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":336,"end":412,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":413,"end":490,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":491,"end":556,"attributes":{"tracking":0,"wordSpacing