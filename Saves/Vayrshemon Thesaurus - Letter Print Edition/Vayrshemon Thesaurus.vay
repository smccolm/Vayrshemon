h","direction":"ltr","runs":[{"runId":"run.qt.392","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"mem: k\u00e3m gimam k\u00e3m f\u00ebr\u00d3 f\u00ebr\u00d3owya."}]},{"blockId":"block.4b33d8e81050403fa7614fa8dc5a1f94","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.426","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Mayemszarunthen mem t\u00d7 y\u00eblyemard\u00c7\u00d3s\u00dflum dlen\u00dbeminizya m\u00dfrnav neksus threnin i mayemszarunthen elen mlapv\u00d7staizya."}]},{"blockId":"block.0c36feb0098d4e29823d45cfd79c77e7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.540","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gimkin: y\u00cd\u00d7 k\u00e3v f\u00ebr\u00d3 f\u00ebr\u00d3owya."}]},{"blockId":"block.58530d66ada044f9859136b5436695b6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.571","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni gimkin\u2019m\u00e7 w\u00ddyaz aleth ni grelna\u2019m\u00e7 yems\u00d7 gimkin\u2019m\u00e7 kinem t\u00d7 ef\u2019elyi\u00d1 dlen\u00dbeminizya."}]},{"blockId":"block.42d640bfe49646e6817a9e8a372ec311","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.658","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Minlam"}]},{"blockId":"block.68c35054362d44b39d370e41db271ec0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.665","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"v\u00df\u00d5gimen: zarven t\u00d7 \u00d1et w\u00cf\u00dfimowya."}]},{"blockId":"block.bcfe16300a164023a83e3ba843abed64","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.700","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin y\u00eblyemarun t\u00e7lh\u00eb\u00d5izya merkw\u00d7sil\u2019i v\u00df\u00d5gimen gaktrivizya."}]},{"blockId":"block.edbfeb9dfbfb4c6ba402111fa41017d4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.760","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"marjo\u00d9v\u00df\u00d5gimen: \u00d1etib \u00e5\u00c3 ner\u00e7zt f\u00c5wgl\u00c9st v\u00df\u00d5\u2019jorimowya aleth m\u00dfrnav \u00d1et ma\u2019kamizimowya."}]},{"blockId":"block.84487bf27a034969bb7993de41a326d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.848","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Merkw\u00d7sil maser\u2019m\u00e7 r\u00d7izya. Marjo\u00d9v\u00df\u00d5gimen \u00d3\u00c5tus yelun i ef\u2019goryemskloj r\u00d7izya aleth t\u00d7 \u00d1ed falib mav merkw\u00d7sil t\u00d7y\u00dfb\u00dfizya."}]},{"blockId":"block.1ac1601ae86646e6ab94a4ef2fec63c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.971","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"n\u00d7rvis: v\u00df\u00d5gimen \u00d1etib neksus ma\u2019v\u00df\u00d5owya kenst vesna ilna\u2019m\u00e7 d\u00c7\u00d3 jem\u00e3\u2019jorowya \u00e3\u00d1 tav \u00e3\u00d1 tav v\u00df\u00d5\u2019jorowya."}]},{"blockId":"block.58d02dce08604caba23dac588df9db7e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1076","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Z\u00e1lagur neksus b\u00d7\u00c7rborel \u00c7piba tharizya. \u00c4\u00d9gif\u00ebw\u2019m\u00e7 melyem ni elen viminmeran r\u00d7izya ly\u2019n\u00d7rvis."}]},{"blockId":"block.0832605a03164b849672b0a21eace61f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1172","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"minlam: far \u00d1etib \u00d1et \u00e5\u00c3 s\u00dflum y\u00c9nenowya."}]},{"blockId":"block.1e7b54784da54bf4b22399c5808f7c00","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1214","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni mayems\u2019m\u00e7 var\u00ebljo\u00d9 neksus tremborel i yems\u00d7 y\u00cd\u00d7goren\u2019m\u00e7 minlam k\u00e3v azar s\u00c7fizya."}]},{"blockId":"block.b7b049ea62a04812bcb83eb0f72cfa3f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1298","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"M\u00e5r"}]},{"blockId":"block.8a8ef2b3a37c4371b2073208a59de5ef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1302","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"m\u00e5r: \u00cbers pales \u00c3\u00cd\u2019en."}]},{"blockId":"block.841ca290376b43c2ab79a73ac6d9391b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1325","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel thal dlenizya lym thavvim olirborel m\u00e5rizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":40,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":41,"end":44,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":45,"end":80,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":81,"end":139,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":140,"end":179,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":180,"end":253,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":254,"end":297,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":