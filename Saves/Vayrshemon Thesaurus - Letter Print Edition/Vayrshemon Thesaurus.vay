,"microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Govis i tonun r\u00c7n\u00d3 thavvim\u2019m\u00e7 eznaun"}]},{"blockId":"block.0c15fad3c0a5421ea69565b3824d5f95","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.37","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00c5vum \u00e3\u00d1 nerbw\u00c5vumen"}]},{"blockId":"block.062b900e5c2a40dabc2c4d05cd3d42f2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.58","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"daskel: k\u00cfba\u00d1\u2019m\u00e7 \u00e3lum ma\u2019o\u00c3\u2019en \u00e3\u00d1 nerbw\u00c5vumen\u2019en ka vesna \u00e3lumowfu."}]},{"blockId":"block.92a5947aa32b4d9fae70be22e2398022","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.126","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth venal gurin lils\u00dflumun r\u00e1 daskelizya ka r\u00e1\u2019palil\u2019i giktenv\u00d7j\u00cden y\u00cd\u00d7 vimjw\u00ebn\u2019m\u00e7 gim\u00cba\u00d5izfu. Zi\u2019giktenv\u00d7j\u00cden ilna\u2019m\u00e7 dlen\u00dbeminizfu. R\u00e1\u2019jorin \u00e3lumizfu."}]},{"blockId":"block.c8633d5d98234e2f82d2058ac883acf0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.280","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00c5vumjem: venor\u2019m\u00e7 venor r\u00c7n\u00d3 neksus w\u00c5vumen dlen\u00dbemin\u2019en."}]},{"blockId":"block.17e1c085eadf4022bf1dd3cb723ae30b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.339","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren h\u00eb\u00d5\u2019na threnin za w\u00c5vumjemizya p\u00e1n govisget braizya."}]},{"blockId":"block.dac5b4804c4f4b4285111d64e852c6fb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.397","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00c5vumen jw\u00ebnenplesten\u00ebw zeth \u00d1et elyi\u00d1owya"}]},{"blockId":"block.80b8a076a1dc4ea8aefbc22d9c6e87ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.440","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"vehen: r\u00c7n\u00d3 jw\u00ebnenplesten\u2019m\u00e7 w\u00c5vumen zeth \u00d1et r\u00d7\u2019en."}]},{"blockId":"block.68223588affa42f49d373c4e2d62fe96","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.493","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth ka vernil zi j\u00cden i bra\u2019m\u00e7 daralget vehenizya."}]},{"blockId":"block.3331f481238f45f08ac1612fc47ead1f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.545","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jw\u00ebnenplestenvehen: r\u00c7n\u00d3 ol\u2019m\u00e7 w\u00c5vumen thav elyi\u00d1\u2019en."}]},{"blockId":"block.0d419715ca0f41f88de71370763f1cb8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.599","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za falnthrenget jw\u00ebnenplestenvehenizya \u00e3\u00d1 po\u2019sezif\u00c7\u00c3f\u00c5wen ma\u2019vorilizya."}]},{"blockId":"block.61ce254bb04d421bbbae619c06758dd2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.671","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grelnaw\u00c5vumf\u00d7: \u00d1et marin minlam nerbw\u00c5vumen\u2019en."}]},{"blockId":"block.76b9a38d353242f5b4f964a9d1e2ea1c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.719","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem\u2019fartondaget zi grelnaw\u00c5vumf\u00d7izya kenst t\u00d7 zarzarven po kamiz\u2019jw\u00ebnimizya."}]},{"blockId":"block.1cd30499a3c94e96b05e769c30bfcd59","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.796","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00c5vumen grem h\u00eb"}]},{"blockId":"block.052bed414998419bb4b4f52af8070a29","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.812","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00c5vum: nerbw\u00c5vumen \u00d1etib s\u00dflum gl\u00c9z\u00cbenowya."}]},{"blockId":"block.920a5fc6872142faa98c52351dc785f4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.856","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni za\u2019w\u00c5vum strasj\u00cd p\u00e1n z\u00e1lshalenshalet her\u00dbimizya l\u00dfnimizya."}]},{"blockId":"block.80c1ebe722a84722b28d562a6c2fb904","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.918","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00c5vumenjo\u00d9halemin\u00d7: w\u00c5vumen \u00d1etib \u00cbers kelde\u00dbon kelde\u00dbonimowya."}]},{"blockId":"block.062f9e3ba2b5428c8dd352aec22c1d50","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.982","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem\u2019w\u00c5vumenjo\u00d9halemin\u00d7 ka her\u00db strasj\u00cd h\u00ebizya zem r\u00c7n\u00d3 \u00d3\u00c5tus z\u00e1lshalenshaletun kelde\u00dbonizya."}]},{"blockId":"block.b0e7f9adadab49cc894366135927ff12","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1075","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tel\u00df\u00db: w\u00c5vumen \u00d1etib h\u00ebth kelde\u00dbon l\u00e1m\u2019m\u00e7 dlen\u00dbeminowya yib\u2019\u00ebw ningi h\u00c5b\u00cd\u2019m\u00e7 thren."}]},{"blockId":"block.edb379b24f494843bf620294718fbb0a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1159","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks zem tondaizya elenol thiril vimingim\u00cba\u00d5owya. H\u00ebth kelde\u00dbon zem\u2019tel\u00df\u00db yib\u2019\u00ebw i yems\u00d7\u2019m\u00e7 n\u00d7\u00dbfelen l\u00e1m\u2019m\u00e7 dlen\u00dbeminizya."}]},{"blockId":"block.9db2cc98aa3f48a6a28f5eec9d25594a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1282","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"h\u00ebpomton: taren \u00d1etib grafvesna h\u00ebun kl\u00e1rowya."}]},{"blockId":"block.e900d0c275f946e3a58bc2e80ac27111","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1329","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi\u2019h\u00ebpomton \u00d3\u00c5tusol strasj\u00cd \u00e3\u00d1 \u00e3lum i l\u00c7m fij\u00ddylizya."}]},{"blockId":"block.7e5cf59459cd4c72b106e145221cc6f7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1383","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d3\u00cf\u00cb\u00e9\u00d1: w\u00c5vumen p\u00e1n mem\u2019m\u00e7 l\u00e1mgl\u00c9st."}]},{"blockId":"block.2e19f710107f48c79a2dae1ce0530a59","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1419","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ka \u00d3\u00c5tus\u2019t tremb\u00c5r threninget y\u00cd\u00d7f\u00c5wizya za\u2019\u00d3\u00cf\u00cb\u00e9\u00d1 r\u00d7izya vinto vesna ilna\u00ddv t\u00d7y\u00dfb\u00dfimizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":57,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":58,"end":125,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":126,"end":279,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":280,"end":338,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":339,"end":396,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":397,"end":439,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":440,"end":492,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":493,"end":544,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":545,"end":598,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":599,"end":670,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":671,"end":718,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":719,"end":795,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":796,"end":811,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":812,"end":855,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":856,"end":917,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":918,"end":981,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start"