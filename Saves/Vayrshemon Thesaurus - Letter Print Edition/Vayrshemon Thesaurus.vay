unId":"run.qt.37","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murlamet \u00cbers ton gl\u00c9st\u2019en"}]},{"blockId":"block.685d864012334dc8a0f9c60fdc95f695","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.64","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murlamtonda: ton ka s\u00dflum murlamet f\u00d7owfu."}]},{"blockId":"block.3c91bdbc783f4c13b404b3a12baa4aaa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.107","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi\u2019murlamtonda denizya s\u00dflum falib mem \u00e3lumizfu."}]},{"blockId":"block.f977e3d4d23042b4a6bb5324034077d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.156","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murlamet \u00e3\u00d1 murlam"}]},{"blockId":"block.51fd931a9b9145e5833512af9998c847","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.175","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murf\u00d7venors\u00c7fef: murlam t\u00d7 murlamet falnthren."}]},{"blockId":"block.b7e12fb0c0284472b29d63152615de88","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.222","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka mav s\u00ebven r\u00d7izya zi\u2019murf\u00d7venors\u00c7fef dlen\u00dbeminizya."}]},{"blockId":"block.d853cf9cbbfd4bd18aad31ee9fee12cb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.279","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"denmemvor: lamf\u00ebren vin neksus pomowya ka arvlam mlapv\u00d7staizfu t\u00d7 vesna\u2019i falnthren."}]},{"blockId":"block.48adbfac36f54b088b433fb4d08fe1a8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.364","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 r\u00c7n\u00d3 l\u00e1m\u2019m\u00e7 sevar farbroft mlapv\u00d7staizya. R\u00e1\u2019denmemvor \u00c3efahizya vin r\u00e1 o\u00c3izya falibi tremb\u00c5r dul braizfu. Ni y\u00e9\u00dbna r\u00e1 kojizya \u00e3\u00d1 za\u2019den tondaizya."}]},{"blockId":"block.0b606d3d6e3d442b93d5715da4121c8d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.515","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murarsevar: murvor tha marven."}]},{"blockId":"block.5439292d87bf402090cefdb2448340db","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.546","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin dlen\u2019m\u00e7 taren p\u00e1n s\u00dflum zyrimizya za ni murarsevar za\u2019ub\u00e1nt\u00e9vget o\u00c3braizya."}]},{"blockId":"block.4009b5994b94490bab9d183e9b7ba646","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.626","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murlametn\u00d7nsem: w\u00e9asem t\u00d7 k\u00cfba\u00d1 murlamet."}]},{"blockId":"block.c74541d1ed5346a2aa01cdbcb8e93a2c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.668","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni murlametn\u00d7nsem zi k\u00cfba\u00d1\u00d1et sezif\u00c7\u00c3izya p\u00e1n k\u00cfba\u00d1s\u00dflum w\u00cf\u00dfizya."}]},{"blockId":"block.b54f2beb71f2404e96425671f6756ada","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.734","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Naor\u2019m\u00e7 slefy\u2019m\u00e7 gorenkwesta"}]},{"blockId":"block.361d6126f6284ff3896232fc447d0f1f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.763","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kar\u00ebn: naor\u2019m\u00e7 dar i gorenkwesta."}]},{"blockId":"block.c083f4a417a94815b45308736274fdbc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.797","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha viminmeran ly kar\u00ebn o\u00c3izya. Wilun ni po\u2019ub\u00e1nt\u00e9v wilz\u00e1lizya."}]},{"blockId":"block.43a3b07dcc284fa48990b3e8537bff67","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.861","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"krathgorenkwesta: krath\u2019m\u00e7 gorenkwesta na jo\u00d9."}]},{"blockId":"block.144253104aea4622bee7733039492b0e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.908","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren h\u00eb\u00d5\u2019na krathgorenkwesta na marjo\u00d9 neksus y\u00eblverzet ragumizya."}]},{"blockId":"block.f27cad00af494d62ae5f604656ed0d03","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.975","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"karm\u00ebr: naor\u2019m\u00e7 jo\u00d9 nira goryems ner\u00e7ztowya."}]},{"blockId":"block.72aa41806df94295838a0eef77ebdd16","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1020","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth ly karm\u00ebr olenizya vesna vorel i merlunor o\u00c3izya."}]},{"blockId":"block.6e07b82bfbc1447393fe1271636d45c4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1075","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neksus