lock.80c0e13533a64c0ebe1334324f6de5be","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.743","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Borel t\u00d7 renna"}]},{"blockId":"block.b5bcd7df2a114b429ee5feea52ab5953","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.758","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"yems\u00d7borel: vimin\u2019m\u00e7 borel t\u00d7 ef\u2019\u00db\u00c7d i m\u00ebr."}]},{"blockId":"block.b3ee91769b8c4003a9af2b03ad70482a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.802","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 m\u00e5r zi yems\u00d7borel i yems\u00d7 ni borel \u00c7pibaizya."}]},{"blockId":"block.1229320e42434126a247f66f688fdaf9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.851","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"nilvarn: borel t\u00d7 yems\u00d7 ef\u2019yemsda\u00c3."}]},{"blockId":"block.717ae7571e2d41c3941bf645eda7b7dc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.887","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha nilvarn za \u00dfd\u00d7um tremborelun plestizya p\u00e1n ve\u00d5izya."}]},{"blockId":"block.85a72dfd5c8642f0a4ea1d8ee42b7c98","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.943","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"m\u00c5rumborel: borel \u00e5\u00c3 jem\u00e3 d\u00cdn\u00d7r lomih m\u00ebr."}]},{"blockId":"block.b67ca82d322a437cb3682048d89dcd0a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.986","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 venor\u2019m\u00e7 goryemmarin elen m\u00c5rumborel i m\u00ebrven zem braizya \u00e3\u00d1 tarenizya."}]},{"blockId":"block.0aaec4a088584d5485973d73f2599538","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1061","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"B\u00e7oren"}]},{"blockId":"block.8995c71473644683b07bd3445b93433f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1068","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"b\u00e7oren: b\u00d7\u00c7r f\u00c5w\u2019en lomih b\u00d7\u00c7r tar gaz\u00e9m\u2019en."}]},{"blockId":"block.f779f5ec53e5420285e737b0c92234d5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1113","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Grel b\u00e7orgor siv\u00ebl\u2019m\u00e7 ve\u00dbzar tremborel b\u00e7orenizya."}]},{"blockId":"block.966206ec59dc414181b0f2952796e7a3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1164","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"glov\u00ebl: vimin\u2019m\u00e7 b\u00d7\u00c7r t\u00d7 venor f\u00c5w\u2019en."}]},{"blockId":"block.d1583808195944cd8efb3cac35c474b4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1203","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venor h\u00ebth zarun n\u00d7nizya zarimun velin glov\u00eblizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":49,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":50,"end":62,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":63,"end":98,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":99,"end":163,"attri