":[{"runId":"run.qt.515","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"b\u00d7\u00c7r\u00c5el: marin ka \u00d1etib o\u00c3 zarilowya."}]},{"blockId":"block.78b903cdfb814e07b813254db42369e3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.553","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth yems\u00d7kumul ner\u00c3\u00cdizya o\u00c3 i tav\u00ebr b\u00d7\u00c7r\u00c5el r\u00d7izya."}]},{"blockId":"block.0dfce08cf0d34cb4b69dd79dd6cb59d7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.606","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib \u00e5\u00c3 jem\u00e3s\u00dflum lamprodimowya"}]},{"blockId":"block.2f943f388b73436182f502b59a094c61","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.639","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"norven: d\u00c7ven \u00d1etib neksus lametf\u00ebr\u00d3owya."}]},{"blockId":"block.28c964abfed74feda0ebf98eca8dc78b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.681","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Aleth gren h\u00eb\u00d5\u2019na \u00c5\u00d9gif za\u2019norven f\u00ebr\u00d3izya ka b\u00d7\u00c7rborel zarunfalnthrenowya."}]},{"blockId":"block.dbccadf4525c46e4b59a02922583257f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.757","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jemekd\u00c7\u00d3: s\u00dflum lomih \u00e7l\u00d7on \u00e5\u00c3 neksus jem\u00e3s\u00dflum lamprodimowya."}]},{"blockId":"block.3723485cf4154f8599d1eb482d00d87c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.820","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinto palun sezif\u00c7\u00c3izya \u00d3\u00c5tus pelun ni za\u2019jemekd\u00c7\u00d3 r\u00d7izya."}]},{"blockId":"block.2e540afc87054153850cb86d97dd9195","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.879","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jemekvenor: venor ni \u00d1etib jem\u00e3s\u00dflum jemekowya."}]},{"blockId":"block.cb154413aa87439984bcd504526bb9b2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.927","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin b\u00e7orvel ragumizya ve\u00dbin\u2019m\u00e7 zi\u2019jemekvenor h\u00eb\u00d5izya \u00e3\u00d1 r\u00e1 zi\u2019\u00e7l\u00d7on \u00e7ztizya."}]},{"blockId":"block.34fa07929c0b4d21aa6b4c8d165b2594","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1004","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib \u00e5\u00c3 vesna lametf\u00ebr\u00d3owya"}]},{"blockId":"block.fbb3e1df139444909c2da45a6254160c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1033","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"lamf\u00ebren: \u00d1etib sezif\u00c7\u00c3 lomih v\u00df\u00d5 f\u00ebr\u00d3owya."}]},{"blockId":"block.3c841ca582674d6cab3b9e7d333128c5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1077","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth h\u00eb\u00d5\u2019na kular i drig\u00e1l f\u00c5wizya zi\u2019lamf\u00ebren h\u00eb\u00d5izya."}]},{"blockId":"block.d997a03c6c064e1c8fb87d658eadc9fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1133","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"norven: d\u00c7ven ka \u00e7l\u00d7on lomih 