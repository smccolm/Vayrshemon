en\u00e1l \u00e3\u00d1 ven\u00e1lw\u00c5vumen"}]},{"blockId":"block.0128773eda82498fbb5f02129a5b1b16","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.332","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00c9lmven: h\u00ebthvenor\u2019m\u00e7 \u00d1et \u00c9lm\u2019en."}]},{"blockId":"block.37e2c23e38bd4da4a1f2998a4f7f9e99","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.365","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka merren zeth lymget r\u00d7izya lym t\u00d7 p\u00e1nvenor\u2019m\u00e7 t\u00e7lh\u00eb\u00d5 \u00c9lmvenizya."}]},{"blockId":"block.7076d443b9014520b13500cd34b48035","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.435","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"ven\u00e1l: far\u2019m\u00e7 h\u00ebthvenor jw\u00ebn\u2019m\u00e7 gl\u00c9z\u00cben\u2019en."}]},{"blockId":"block.e06022058fa9409c926ca54cb7793298","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.479","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"B\u00d7\u00c7r velin zarunfalnthrenizya \u00e3\u00d1 lym t\u00d7 fart\u00e7l ven\u00e1lizya."}]},{"blockId":"block.a6cb6c3e02774aedb85e77ddbdcdc8ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.537","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"ven\u00e1lw\u00c5vumen: h\u00ebthvenor\u2019m\u00e7 \u00d1et d\u00df\u00c3\u00dfl\u00e1mgl\u00c9st\u2019m\u00e7 gl\u00c9z\u00cben\u2019en."}]},{"blockId":"block.a8d2151b16114006ab3467f89a1cc8cb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.596","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kenst marjo\u00d9 grel yems\u00d7 r\u00d7izya lym h\u00ebthvenget ven\u00e1lw\u00c5vumenizya."}]},{"blockId":"block.1deee77ac05d4df6a856d9cb892714d0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.660","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesnalen \u00cbers o\u00c3jem h\u00c5b\u00cd\u2019en"}]},{"blockId":"block.2d1920c1ecc64f44b942bc4acef7dff0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.688","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"o\u00c3vesnah\u00c5b\u00cd: \u00cbers s\u00e3\u00d1plesten\u2019m\u00e7 ef\u2019veritas o\u00c3bra\u2019m\u00e7 den t\u00d7y\u00dfb\u00df\u2019en."}]},{"blockId":"block.1a6be3028ab74681b171a411783f9b84","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.755","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Grel vorn\u2019m\u00e7 threnin r\u00e1 vesna\u2019i \u00ddv\u2019m\u00e7 denget nerinmemma o\u00c3vesnah\u00c5b\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.fe535f3e2fc04b39bd793d8ef11d3021","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.833","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"vesnah\u00c5b\u00cd: \u00cbers den neksus tha vesna h\u00c5b\u00cd\u2019en."}]},{"blockId":"block.57073693af1a4d8b8032aea88f0a610a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.879","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers zem\u2019giktenv\u00d7j\u00cdenun vemyib\u2019\u00ebw za \u00d3\u00c5tus palilaunget vesnah\u00c5b\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.cb2b86cfa69b43b08d2b31fd48d0cb59","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.954","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna\u2019m\u00e7 s\u00dflum \u00cbers tonun miktaz\u