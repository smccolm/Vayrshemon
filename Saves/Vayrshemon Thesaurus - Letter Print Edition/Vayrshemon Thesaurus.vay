u00d9olyems\u00d7 za za\u2019mela\u2019i l\u00dfnil a\u00d9izya tha tar\u00d5."}]},{"blockId":"block.7d69af84baf14681998409fcc8a53477","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.193","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"l\u00ddn\u00c5rl\u00dfn: ilna\u2019m\u00e7 den ni \u00d3\u00c5tus vesna\u2019m\u00e7 \u00d1etun."}]},{"blockId":"block.09283453135a42ed83be5742f5e3addb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.240","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Etni zem\u2019tremb\u00c5run l\u00ddn\u00c5rl\u00dfn slefy\u2019m\u00e7 r\u00d7izya vin \u00d3\u00c5tusol ner\u00e7ztizya t\u00d7 tremborel."}]},{"blockId":"block.986c55ea398d4114afac2f7d32a6acaa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.321","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kwist"}]},{"blockId":"block.e3532215c9494412be1d285ec6037be9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.327","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kamiz: t\u00d7 zarven \u00d1et mlapv\u00d7sta\u2019en."}]},{"blockId":"block.2316d827a33e4b68b9bdae547db4fd12","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.362","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 h\u00eb\u00d5\u2019na\u2019m\u00e7 zarzarven za jelinget kamizizya."}]},{"blockId":"block.4edcc180d8c54106ac40434ce1f92273","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.410","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"le\u00db\u00c7f\u00c5w\u00d1et: \u00d1et t\u00d7 vesna \u00d1et le\u00db\u00c7f\u00c5w\u2019en."}]},{"blockId":"block.00d2ec5723734cb2912c41a750640c1b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.451","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Marin zarzarven lym drig\u00e1l t\u00d7 melyem le\u00db\u00c7f\u00c5w\u00d1etizya."}]},{"blockId":"block.ff7d6e4a1a3248caa441f92223c25d84","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.504","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kwist: ni kwist\u00e7l\u00d7on kamiz\u2019en \u00e3\u00d1 \u00e3\u00d1t\u2019en."}]},{"blockId":"block.ddf621051b814982854630159bfd8140","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.545","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Elen verzetnevf\u00ebr kamiz\u00e3\u00d1ts\u00dflum etni merjo\u00d9un kwistizya."}]},{"blockId":"block.c5dad7c0248e43e0a372fbf10a7f0b7c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.602","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00c8lm i \u00d1et"}]},{"blockId":"block.46de376dda224d7fb8599c9268cfe6cc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.612","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00c9lm: \u00d1et r\u00c7n\u00d3 jw\u00ebnenplesten\u2019m\u00e7 w\u00c5vumen \u00c9lmven\u2019en."}]},{"blockId":"block.ccde66a6963544809249579a0cc0b230","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.662","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth venor\u2019m\u00e7 kran za yib\u2019\u00ebw neksus dlenson\u2019m\u00e7 ventinget \u00c9lmizya."}]},{"blockId":"block.c87c87d699424efdb21d1cc83396a1ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.728","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"i\u00d3rel: ni \u00c9lm vesna jemekjem\u00e3\u2019en \u00d1etib vesna f\u00ebr\u00d3owya \u00e7zt\u2019en \u00e3\u00d1 kom vesna murf\u00d7\u2019en."}]},{"blockId":"block.cf9b147561d5450884f6764d4860916e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.812","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ragum\u00e7l\u00d7ono\u00c3t\u00e7d\u00c7\u00d3 vimin\u2019m\u00e7 y\u00eblverzetget i\u00d3relizya. \u00e4\u00c3 jem\u00e3 enif tha po zi o\u00c3t\u00e7 po dar z\u00e1laizya vinto y\u00eblverzet ol yel ni swif kojizya."}]},{"blockId":"block.ef58c72c4e124edb82c53150a489c2b5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.947","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"v\u00d7dun: t\u00d7 \u00c9lm\u2019m\u00e7 h\u00eb\u00d5 b\u00e9rv\u2019en k\u00cfba\u00d1\u2019m\u00e7 \u00e5v\u00d1et \u00cbers \u00d1etib po\u2019pisen mlapv\u00d7sta\u2019jw\u00ebnimowya."}]},{"blockId":"block.88438e4c9d23463dbfc8262c7ec57812","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1033","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 arvlam i ef\u2019lil ni y\u00e9\u00dbna zi v\u00d7dunizya. \u00c4\u00d9gif h\u00ebth \u00c5\u00d9gif zi lilizya vinto gren y\u00e9\u00dbna yel giktenv\u00d7j\u00cden omenatizya \u00e3\u00d1 yib\u2019\u00ebw j\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.2f442af2406a4b5bbf0717bae697707c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1171","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gor\u00dbai: t\u00d7 k\u00cfba\u00d1\u2019m\u00e7 \u00c9lm\u2019m\u00e7 h\u00eb\u00d5 murdat \u00e5\u00c3 vesna f\u00c5w\u2019en falib \u00d1e\u00d5 h\u00eb\u00d5 ma\u2019nerbyalizya \u00e3\u00d1 ni m\u00e3n mav inst\u00dfb\u00df mlapv\u00d7staowya."}]},{"blockId":"block.3