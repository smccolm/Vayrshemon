ockId":"block.53ae477b56da4a54884aec9234689f51","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.782","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"L\u00dfnil ni w\u00c5vumen"}]},{"blockId":"block.ac3d1d7f5170459697c0023321413656","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.799","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"o\u00c3se\u00dbo\u00c3l\u00dfn: l\u00dfnil k\u00e3m m\u00dfrnav p\u00e1n omiun kojowya."}]},{"blockId":"block.e97fd87f7da74262a9e4a4a894ae7216","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.847","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni yel\u00c5el za\u2019o\u00c3se\u00dbo\u00c3l\u00dfn i masif\u2019m\u00e7 viminmeran velin b\u00d7\u00c7r\u00c5el\u2019m\u00e7 kojizya ni w\u00c5vumen."}]},{"blockId":"block.1e950e4f87764380b2fc55e4eec1d574","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.930","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00c5vumelin: l\u00dfnil \u00d1etib \u00c9lmven lomih w\u00c5vumen a\u00d9owya."}]},{"blockId":"block.c7913701ae4c45268562bcb916dcf768","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.982","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni zi\u2019w\u00c5vumelin aleth kumul na merjo\u00d9 l\u00dfn i enifelen \u00e7ztizya."}]},{"blockId":"block.e30311ac77d546f5b09101bf011677a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1044","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"L\u00e1mgl\u00c9st"}]},{"blockId":"block.586da0cb96cf4566b225e6ce6910ce97","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1053","languageId":"language.vayrshemon","styleId":"style.b