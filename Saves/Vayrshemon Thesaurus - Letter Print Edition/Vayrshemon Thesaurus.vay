 \u00d1etib jemekjem\u00e3\u2019jorowya."}]},{"blockId":"block.02c8550ca7424f0a9adaf6dafb5d30a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.509","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thrin brasar ni dar kr\u00c5v\u00ebmun nira ragum\u00e7l\u00d7ono\u00c3t\u00e7 \u00c3\u00cdizya."}]},{"blockId":"block.83ae2407e6e44605ad5f554842cecfe2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.566","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kran gurin s\u00dflum"}]},{"blockId":"block.604b54b19dfd4d27ba509442d9e572ec","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.583","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kranz\u00dfgu\u00d9: gim\u00dfv giktenv\u00d7j\u00cdenun ner\u00c3\u00cdowya ni nor\u00d3amamemil."}]},{"blockId":"block.2f3d746fafcd458a998d965e8f4aa4ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.642","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha daral kranz\u00dfgu\u00d9 kom gorenj\u00cden\u2019m\u00e7 r\u00d7izya ka zarviminolen ma\u2019j\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.35323e6c47014de4ad1c5dff59ce4d2b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.718","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kranda\u00c3: gim\u00dfv s\u00dflumun ni s\u00dfrn o\u00c3t\u00e7 fradef."}]},{"blockId":"block.bb06e1b279ed426385fd4386364d7b7c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.762","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni h\u00ebthven\u2019m\u00e7 z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum\u2019i t\u00e7lh\u00eb\u00d5 kranda\u00c3 \u00cb\u00df\u00dbizya pel na."}]},{"blockId":"block.17d6a