00d1 margrelun krivelizya."}]},{"blockId":"block.2942232c237d47e3a15bf85dc80a9fd9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.239","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murhan \u00e3\u00d1 hanmavgrij"}]},{"blockId":"block.ff534dd1c35c4d17a73ae2a40ebb2fd0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.260","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murhan: w\u00e9asem vin vesna murvor semowya."}]},{"blockId":"block.027bca49e9a942189ce0b0daae8663a7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.301","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin za pel\u2019i slefy\u2019m\u00e7 palesun o\u00c3izya za murhan semizya."}]},{"blockId":"block.9b90bd41f9c845bb8eb7469f8bea4e70","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.357","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"hanmavgrij: tha murhan murtar gl\u00c9z\u00cbentar\u2019en."}]},{"blockId":"block.eb1f12e66d6a4c84aac698fa564299c4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.402","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Nerbw\u00c5vumenvar\u00dfnen hanmavgrij gl\u00c9stizya \u00e3\u00d1 zarvenmurtarget murlamvutizya."}]},{"blockId":"block.9f8165273fad4fb9be748b3b9c79ebbd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.476","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"sulai: h\u00ebth murarsevar \u00e1pe\u00dbem\u2019m\u00e7 d\u00c7\u00d3 \u00e5\u00c3 s\u00dflum f\u00c5w\u2019en kom gurin vesnaun tav koj\u2019jw\u00ebnowya."}]},{"blockId":"block.c43735ce92054e469f0bf6b40887f38b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.565","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth pel kular tinizya zi\u2019melan\u2019i sulai r\u00d7izya \u00e5\u00c3 w\u00cf\u00df zi t\u00d7 mayemszarunthen k\u00e3m vinol."}]},{"blockId":"block.7bad99861730422283fbac464e0c9f41","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.652","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"dalves: vengraf \u00e5\u00c3 tarze\u00db\u00e7 f\u00c5w\u2019en \u00e3\u00d1 k\u00c7nib po r\u00d7owya ma\u2019gl\u00c9st\u2019en."}]},{"blockId":"block.94ca121d2c5a463ca4f9c3ad5b44de7e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.718","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni dalves vorn\u2019m\u00e7 falns\u00dflum neksus vorel \u00c5el\u2019m\u00e7 vutizya. Pel ma\u2019o\u00c3izya po \u00e3\u00d1 faln h\u00eb\u00d5izya."}]},{"blockId":"block.818002fccaf142d182dabd214ed38174","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.809","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"farf\u00c5w: \u00c9lm \u00e5\u00c3 f\u00d7 far \u00e5\u00c3 vesna."}]},{"blockId":"block.c373ea6faf0e4702b6f3b788b4db5857","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.841","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za\u2019farf\u00c5w ni vel\u2019m\u00e7 klojvord\u00cdn\u00d7r \u00d1etib za t\u00d7 elenol r\u00ddy\u00d3s\u00dflum hy\u00c5v\u00cdizya gl\u00c9stimizya."}]},{"blockId":"block.af36bcae8bf1499d8ea36c92312b8059","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.926","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"seminst\u00dfb\u00df: r\u00c7n\u00d3 vesna zi\u2019w\u00e9asem sem\u2019en."}]},{"blockId":"block.c8638efaedc549ffb54036fccba73b3f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.967","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni seminst\u00dfb\u00df r\u00c7n\u00d3 z\u00ebrna z\u00e1l\u00c3\u00cdo\u00c3s\u00dflumun zem\u2019lil f\u00e7sizya."}]},{"blockId":"block.43465622752a4374a3ca3ed67182b56e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1024","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"n\u00dfsir: r\u00c7n\u00d3 vesna p\u00e1n jw\u00ebnenplesten\u2019m\u00e7 fradef dlen\u00dbemin\u2019en vin vesna vemyib\u2019\u00ebw \u00c3\u00cd\u2019jorowya."}]},{"blockId":"block.746b414786bc46689abc7635f2592d07","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1115","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers n\u00dfsir zi\u2019palila \u00e5\u00c3 nerbw\u00c5vumens\u00dflum\u2019i dar\u00c5el r\u00c7n\u00d3 zi \u00c3\u00cdizya. Kinos za zi\u2019tremb\u00c5r maserf\u00c5wizya."}]},{"blockId":"block.64fb9f036f8840a7b29f11177c4fe9b9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1215","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"sevarw\u00e9asem: vesna\u2019i murvor o\u00c3\u2019en \u00e3\u00d1 m\u00d7s \u00c9lm\u2019en."}]},{"blockId":"block.2ddf4bb40bed4c62abf2dd4468978d31","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1264","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Da\u00c3imizfu \u00cbers sevarw\u00e9asem za vesnap\u00e1s\u00dflum\u2019i yems\u00d7\u2019m\u00e7 f\u00eblen mayemsizya \u00cbers zarun."}]},{"blockId":"block.9410e6ad448c4277aebb9457cd815b7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1347","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murf\u00d7 ka fradowya"}]},{"blockId":"block.1289ab4f3f864c2eb6bfdd5b498f94fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1365","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murvengraf: murf\u00d7 \u00cbers vengraf."}]},{"blockId":"block.1993a71cfa6e429daf6756ba56c42a42","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1397","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neksus vimin\u2019m\u00e7 murvengraf h\u00ebthvenizya klojvord\u00cdn\u00d7r. Borel gren vorel gaktrivizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":40,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":41,"end":75,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":76,"end":139,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":140,"end":166,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":167,"end":238,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":239,"end":259,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":260,"end":300,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":301,"end":356,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":357,"end":401,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":402,"end":475,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":476,"end":564,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":565,"end":651,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":652,"end":717,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":718,"end":808,"attributes":{"tracking":0,"wordSpacing":0.0,"basel