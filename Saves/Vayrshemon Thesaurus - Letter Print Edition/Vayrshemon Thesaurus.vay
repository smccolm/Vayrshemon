n":"none","text":"mi\u00d3\u00e3: broft t\u00d7y\u00dfb\u00dfimowya kenst ef\u2019omenat gl\u00c9stowya \u00d1etib w\u00c5vumen dlen\u2019m\u00e7 r\u00d7izya."}]},{"blockId":"block.b1aa35aa69134c6898f40c2023b08edc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.134","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth h\u00eb\u00d5\u2019na threnin gaktrivizya za\u2019mi\u00d3\u00e3 t\u00e7lizya. Daral za jemzethizfu r\u00d7izya zethir\u2019i marjo\u00d9 thar."}]},{"blockId":"block.a6e3e734a9984d8a8e00e1f399c45afd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.233","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00cf\u00df"}]},{"blockId":"block.628a42c2daa74100a2f648105d70deb2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.237","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00cf\u00df: broft t\u00d7y\u00dfb\u00dfkelde\u00dbon\u2019en."}]},{"blockId":"block.a6564a42ee5a4b558206dadcb25602d2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.267","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib daral \u00c5el\u2019m\u00e7 r\u00d7izya r\u00ddy\u00d3s\u00dflum w\u00cf\u00dfizya."}]},{"blockId":"block.880532ba12f841c68a06e46ec486047b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.312","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"fevul: \u00cbers vesna\u2019i k\u00cfba\u00d1\u2019m\u00e7 r\u00ddy\u00d3 w\u00cf\u00df\u2019en \u00e3\u00d1 venor i broft \u00e5\u00c3 vesna vut\u2019en."}]},{"blockId":"block.d71face408274bc5aaecfb5a3283e968","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.387","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin za \u00e5\u00c3 kwist\u00e7l\u00d7on \u00c3\u00cdizya r\u00e1 fevulizya lomib \u00c7\u00d9y\u2019m\u00e7 thiril dlen\u00dbeminizya. Thavvimna kwist\u00e7l\u00d7on yel za broftizya."}]},{"blockId":"block.a0e9b718789944b3bbcea885c8537658","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.502","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00cfin: tha f\u00ebr\u00d3 m\u00d7s w\u00cf\u00df\u2019en."}]},{"blockId":"block.8cdbe4164bce4c88b4ef6d2097554c1b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.529","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 masif\u2019m\u00e7 kular zi t\u00d7 mayemszarunthen w\u00cfinizya."}]},{"blockId":"block.9ae7d38b4e1a4323bb49dacea36784cb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.581","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00cf\u00dfhoren: t\u00d7 w\u00cf\u00dfen horenun f\u00c5w\u2019en."}]},{"blockId":"block.900c381328d14fc38f4ffbbf0c43c0ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.616","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za t\u00d7 y\u00cd\u00d7 venor w\u00cf\u00dfhorenizya kenst nilom marjo\u00d9 shalenizya."}]},{"blockId":"block.5c62237e12154af688098e674e568b65","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.676","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"prodw\u00cf\u00df: \u00e5\u00c3 prodvar w\u00cf\u00dfen f\u00c5wgl\u00c9st\u2019en."}]},{"blockId":"block.d0b6a9e620c94abfb8915bd19c7862a2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.715","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin zem\u2019y\u00eblyemar h\u00ebthven\u2019m\u00e7 r\u00d7izya v\u00d7dlehmgur t\u00d7 zem\u2019y\u00eblyemar\u2019i sezif\u00c7\u00c3 ni man\u00d7njemlen prodw\u00cf\u00dfizya."}]},{"blockId":"block.175e381d984c4a8fb362bd953ca92a0e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.815","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Wil ni s\u00ebra da\u00c3owya"}]},{"blockId":"block.12e265c4c74d4fba931130317a0ce115","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.835","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"v\u00ddl\u00e1w: thrin s\u00ebra \u00c3\u00cd\u2019en."}]},{"blockId":"block.c87ab2ec645d4698a31035b365c9e341","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.860","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha merjo\u00d9 \u00e5\u00c3 merjo\u00d9 vimin\u2019m\u00e7 wilun v\u00ddl\u00e1wizya."}]},{"blockId":"block.0363460960864b1bb7bac8c481315cfc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.907","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"naorv\u00ddl\u00e1w: naor\u2019m\u00e7 na jo\u00d9ol ner\u00c3\u00cd\u2019en."}]},{"blockId":"block.9e2d39fa8d6d45d8a2b07f6b79ab8eae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.945","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Na naor\u2019m\u00e7 enifelen wil naorv\u00ddl\u00e1wizya vinto po\u2019v\u00ddlawinun vimin\u2019m\u00e7 \u00d3\u00e1lun\u00c3izya."}]},{"blockId":"block.2f46dee0b19c4f16bd7182c32376ef19","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1023","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00ebradlen\u00dbemin: na neksus \u00e7l\u00d7on ni s\u00ebra dlen\u00dbemin\u2019en."}]},{"blockId":"block.61389af759fd4071b372a5379a9ff7ef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1076","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Wil na neksus felenthrenin i yems\u00d7 s\u00ebradlen\u00dbeminizya p\u00e1n vel\u00c3\u00cdizya."}]},{"blockId":"block.bda4055850c44c78988e42c44196d94c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1144","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"siv\u00eblda\u00c3: siv\u00ebl\u2019\u00ebw marin o\u00c3jw\u00ebn\u2019m\u00e7 kelde\u00dbon da\u00c3\u2019en."}]},{"blockId":"block.da71762bd4a54184919021037887be4d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1196","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 v\u00ddlawinun velin\u2019m\u00e7 wil vel \u00e5\u00c3 kwesthren siv\u00eblda\u00c3izya."}]},{"blockId":"block.c6264d117c0f449691196044ae808306","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1255","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00e9asem"}]},{"blockId":"block.99b24cd58ab147909c05f6f733d82881","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1262","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00e9asem: murvor h\u00ebth b\u00e9rven."}]},{"blockId":"block.b2a432166b3344a99096d0b3848b2c1e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1290","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth nemir thav \u00c3\u00cdizya elen venor za masif\u2019m\u00e7 kinem ybs\u00dfizya za\u2019w\u00e9asem sezif\u00c7\u00c3izya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"w