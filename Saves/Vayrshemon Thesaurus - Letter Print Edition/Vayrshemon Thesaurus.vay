"blockId":"block.be1ce6c8f30c429da65e3051243d7ef4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.189","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"giktenv\u00d7j\u00cdenf\u00c5w: p\u00e1f\u00d7j\u00cdtonda p\u00e1n s\u00dflum giktenv\u00d7\u2019en."}]},{"blockId":"block.6e6d81ac47ef4cf9b55bc82fccde86e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.241","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni kwist\u00e7l\u00d7on daral p\u00e1ngiktenv\u00d7j\u00cdenf\u00c5ws\u00dflum yel i y\u00e9\u00dbna giktenv\u00d7j\u00cdenf\u00c5wizya."}]},{"blockId":"block.3fb6e595c94b49718555287909f30a4c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.318","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"o\u00c3bra\u00c5el: o\u00c3bra\u2019m\u00e7 \u00d1et o\u00c3bra\u00c5el\u2019en."}]},{"blockId":"block.9278dd5ebeb4409885fa9cc608ce7aae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.354","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin yems\u00d7kumul ner\u00c3\u00cdizya po \u00d3\u00c5tus\u2019t\u2019m\u00e7 y\u00eblyemar o\u00c3bra\u00c5elizya."}]},{"blockId":"block.4fba8fa5413441839edb17349d11a135","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.416","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"olventonda: p\u00e1n ol r\u00c7n\u00d3 jw\u00ebnenplesten\u2019m\u00e7 giktenv\u00d7j\u00cden tonda\u2019en."}]},{"blockId":"block.0861bea9739941098c83723777bb337a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.480","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni daral p\u00e1ngiktenv\u00d7j\u00cdenf\u00c5ws\u00dflum yel i kwist\u00e7l\u00d7onget olventondaizya."}]},{"blockId":"block.4f672cde6fe643b097a5d618a8869005","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.549","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n tegliz\u2019m\u00e7 w\u00c5vumen falnthren\u2019en"}]},{"blockId":"block.c87fd1f3be45450a84422e3c9d81c823","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.584","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00dfrnw\u00c5vumenmarin: p\u00e1n h\u00c5b\u00cdtorp falnthren\u2019en."}]},{"blockId":"block.80afddab423148b9a994b32837d57e6b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.629","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks b\u00d7\u00c7r o\u00c3\u2019es za s\u00dfrnw\u00c5vumenmarin\u2019m\u00e7 jama i jo\u00d9 a\u00d9izya."}]},{"blockId":"block.24e67300f53148f9b46b61b12f5d94a2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.687","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00e3\u00d1marin: h\u00c5b\u00cd\u2019m\u00e7 murdat ma\u2019o\u00c3jems\u00e3\u00d1\u2019en."}]},{"blockId":"block.60c0e8fd5e4a4eb7ad4ab2e17347212e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.728","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1nmartonda j\u00cdizfu, s\u00e3\u00d1marin\u2019m\u00e7 goryemsd\u00c7\u00d3s\u00dflum velin viminmeran nira enifetyeks terastizya."}]},{"blockId":"block.f228a1d602664af88cf398814809f138","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.821","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00e3\u00d1mavsif: lametf\u00ebr\u00d3\u2019m\u00e7 o\u00c3jem ma\u2019f\u00c5w\u2019en."}]},{"blockId":"block.20285f83c66e48ca9