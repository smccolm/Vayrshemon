body","type":"unicode","normalization":"none","text":"\u00d0etib w\u00c5vumen ens\u00e1b\u00ebowya"}]},{"blockId":"block.2546f034a8594ae2945335f30bbceec1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.315","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"prod: \u00d1et k\u00e3m l\u00e1m\u2019m\u00e7 ef\u2019ens\u00e1b\u00eb."}]},{"blockId":"block.5243e3c9928345cea95ef7378fef89a9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.347","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi\u2019prod ka viminmeran sezif\u00c7\u00c3atya dlenizya gren neksus \u00ddvton vemyib\u2019\u00ebw."}]},{"blockId":"block.a56f2619bf604b0fadf6f82d2d228df1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.419","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"lamprod: lamprod r\u00c7n\u00d3 \u00d1etib s\u00dflum gl\u00c9z\u00cbenowya \u00e5\u00c3 vesna."}]},{"blockId":"block.c4aa09ac44764b3c8de313e35a113f95","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.475","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin \u00ddvtonun f\u00e7sizya za\u2019lamprod ni za\u2019r\u00c7n\u00d3vem dlen\u00dbeminizya."}]},{"blockId":"block.7ef900a906c04e3b99b0c818dc5ee9c9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.535","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"lamemsevar: marin gimam lamves k\u00c7fag\u00eba ef\u2019ven\u00e1lw\u00c5vumen."}]},{"blockId":"block.433e9e24266d43be9069dc7de39338f5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.591","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth venik\u2019t k\u00c7fag\u00ebaplesten\u2019m\u00e7 ef\u2019thar zem\u2019lamemsevar ni viminmeran ragumizya."}]},{"blockId":"block.c4f0af6a903e4a549039c308cedd6338","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.670","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etun \u00cbers tonun k\u00e3men\u2019en"}]},{"blockId":"block.a4c0cbdad47441719e998da3a5780a9e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.696","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"k\u00e3men: \u00d3\u00c5tus \u00d1etun n\u00d7\u00dbem ef\u2019s\u00e3\u00d1plestenveritas."}]},{"blockId":"block.3567b31f4a544bffaa19b569aa1ca377","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.743","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za\u2019k\u00e3men i w\u00e9asem r\u00c7n\u00d3 merren gl\u00c9stizya horib w\u00e9asem t\u00e7lizya tav."}]},{"blockId":"block.901e1ddb1ae24cb19f9c4541a79a5dd6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.809","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"giktenv\u00d7enl\u00dfnil: ni giktenv\u00d7en neksus l\u00dfnil vesna ezna \u00db\u00c7dowya."}]},{"blockId":"block.e4ba802d218c4745aeddf78534681a73","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.873","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers giktenv\u00d7enl\u00dfnil za mayems\u2019m\u00e7 faren selin\u2019i masif\u2019m\u00e7 tom \u00d3\u00c5\u00e7izya."}]},{"blockId":"block.041c692c038f48b3841900e6d4b8cb7e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.943","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00c7\u00d3 ma\u2019f\u00e7s\u2019en"}]},{"blockId":"block.451ae90dacdd4c3d95b88fffe725b281","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.957","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"panenra\u00c3\u00cd: \u00e5\u00c3 thavvimna threnin i d\u00c7\u00d3 \u00c3\u00cd\u2019en."}]},{"blockId":"block.5f60448e587a4d3f8be0013d73ffed18","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1002","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth \u00d3\u00c5tusol s\u00ebvenun ve\u00d5izya h\u00c5b\u00cdtorpgur \u00e5\u00c3 \u00d3\u00c5tus\u2019t w\u00cf\u00dfen panenra\u00c3\u00cdizya."}]},{"blockId":"block.44f43262c9be4cd0939edf3049466bb1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1075","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"v\u00c5lf\u00d7: thrin omenatizfu kelde\u00dbon tav d\u00c7\u00d3\u2019en."}]},{"blockId":"block.62fc4be1c63d4a8dbe073c52e2822447","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1120","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venik venorun neks threnin ika\u00d9izya. Velin pel v\u00c5lf\u00d7izya vinto z\u00ebrel gl\u00c9z\u00cbenizya."}]},{"blockId":"block.1fdb7a1cc87b400fbfeff3dcc14e05e0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1202","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00c7\u00d3 \u00e5\u00c3 h\u00ebthven\u2019m\u00e7 venor da\u00c3\u2019en"}]},{"blockId":"block.5728b3a58a694842a37f563b3687e4df","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1233","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"h\u00ebthven: a\u00d9 \u00d1et h\u00ebthven frad\u2019en."}]},{"blockId":"block.ee71e01a040f4a94951f63854d4148bc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1266","languageId":"langu