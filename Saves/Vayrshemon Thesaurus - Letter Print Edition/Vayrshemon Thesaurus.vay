,"normalization":"none","text":"Ni vesnap\u00e1s\u00dflum zi omigl\u00c9z\u00cbenizya vinto za thav elyi\u00d1izya."}]},{"blockId":"block.a64801cddd484554b3fcc96c5b1d5fcd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.517","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vel\u00c3\u00cd"}]},{"blockId":"block.27b816e931ad4f76a5c58ea13c586e81","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.523","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"vel\u00c3\u00cd: tha naor\u2019m\u00e7 \u00e7l\u00d7on vel \u00c3\u00cd\u2019en."}]},{"blockId":"block.18865f02c6c24f209fe73900db2cb987","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.559","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 b\u00d7\u00c7rborel za nerpalenun venimna\u00ebw vel\u00c3\u00cdizya."}]},{"blockId":"block.1d1d495acaf74d37a106b1c64a400e6d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.609","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gaktriv: marin halemin\u00d7 vel \u00c3\u00cd\u2019en."}]},{"blockId":"block.8a3db5164d574ae5b9204e70463d4ea6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.644","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin thiril ika\u00d9izya bidil gaktrivizya."}]},{"blockId":"block.8c2d73c41cc544ccb6d6118aa65de568","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.683","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"velgaktriv: nira yems\u00d7 lomih mel\u2019m\u00e7 jo\u00d9ol \u00c3\u00cd\u2019en."}]},{"blockId":"block.451f2cf3575c45eea8c6b6e3221d0475","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.732","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Memvorplesten\u2019m\u00e7 viminolen grel yems\u00d7 velgaktrivizya."}]},{"blockId":"block.5febd0d4177a426896579beeecb02208","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.786","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venar"}]},{"blockId":"block.71c3d66ddf4f4ef5aea339352a972930","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.792","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"venar: \u00d1etib s\u00dflum vingim f\u00d7owya."}]},{"blockId":"block.ebcd0fe4ff1c4d1fa47f7991c9f1c78e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.826","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers venar neks viminmeran ni kwist\u00e7l\u00d7on zarviminolen j\u00cdenizya."}]},{"blockId":"block.c2332820ed494f3b9d4be172491cdf88","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.890","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tremb\u00c5rf\u00c5wpomf\u00c5w: venar tha pal \u00e5\u00c3 pel thrin\u00c3\u00cdimowya."}]},{"blockId":"block.dce791327ce44e699a0f6bec44a271a1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.944","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Mela vorn\u2019m\u00e7 lil pomf\u00c5wizya ka tremb\u00c5rf\u00c5wpomf\u00c5w h\u00ebth za\u2019n\u00d7nen \u00d5\u00dfratya."}]},{"blockId":"block.74fb2a709ca84971be02cb3138cf165f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1015","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venla\u2019m\u00e7 f\u00c7l"}]},{"blockId":"block.60068450e794409aaa54c86334a9e579","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1028","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"venla: marin krath\u2019m\u00e7 jw\u00ebnenplesten falnthrenowya."}]},{"blockId":"block.badaed2161234840932cf705f2ad4415","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1079","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 venla\u2019m\u00e7 tremb\u00c5r za pelna\u2019m\u00e7 wil tha thiril thirav onegaizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":58,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":59,"end":101,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":102,"end":174,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":175,"end":188,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":189,"end":220,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":221,"end":254,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":255,"end":280,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":281,"end":322,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":323,"end":359,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":360,"end":411,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":412,"end":457,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":458,"end":516,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":517,"end":522,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":523,"end":558,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":559,"end":608,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":609,"end":643,"attri