ckId":"block.6ed56f24ced04d00b45544e230a26ff1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.364","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00c5wsezif\u00c7\u00c3: \u00d1et vinto sezif\u00c7\u00c3 f\u00c5w\u2019en."}]},{"blockId":"block.5b1485711df74f59a3698e5bbb9cb9ee","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.402","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 r\u00e1\u2019thiril thiravget \u00e5\u00c3 zael f\u00c5wsezif\u00c7\u00c3izya vinto za\u2019viminmeran sezif\u00c7\u00c3izya."}]},{"blockId":"block.d42597168b364e9794f48f8a4423cc74","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.481","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Felen na vesna felen"}]},{"blockId":"block.3e1dcb8f8c664fb1bfcf0a109140e861","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.502","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00eblen: felen na vesna velvor."}]},{"blockId":"block.742de55e024845029209514b3780a745","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.532","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n t\u00e9z\u2019m\u00e7 m\u00e5r zi zi\u2019f\u00eblen kl\u00e1rjem\u00e3izya."}]},{"blockId":"block.6b13792e158546c488386ef5e0cc514b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.573","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"shalenfelen: maserf\u00c5w\u2019m\u00e7 felen o\u00c3t\u00e7 larnaorthreninun."}]},{"blockId":"block.bdc67c169ae84991817f6d419151ff9d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.627","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zeth nabyems za shalenfelen na se\u00dbna\u2019m\u00e7 pel strasf\u00c5wizya."}]},{"blockId":"block.c523026e70e84011b664aa766a93ace5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.685","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"thani felen: venor\u2019m\u00e7 thani\u2019m\u00e7 felen."}]},{"blockId":"block.6b0cfba87e364c7c8ff5e4d0c1bd7fe8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.723","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 y\u00e9\u00dbna prodvard\u00c7vens\u00dflum venor\u2019m\u00e7 thani felen velvorjemizya."}]},{"blockId":"block.e157504174024ed7bb20f9dbcbfb6c68","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.786","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"F\u00e7s"}]},{"blockId":"block.accea91ec31d4fc0b5d659abb32def3f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.790","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00e7s: d\u00c7\u00d3 grafel venor g\u00e7z\u00e9l\u2019en."}]},{"blockId":"block.5fa355bef69b46b789829715f0a71cc1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.822","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin nabyems p\u00e1izya d\u00c7\u00d3 gren marjo\u00d9 f\u00e7sizya."}]},{"blockId":"block.bf72a09bb9dd4d65b158430081d5cda2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.866","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grasnot: d\u00c7\u00d3 \u00e5\u00c3 h\u00eb\u00d5 y\u00c9nen\u2019en."}]},{"blockId":"block.ba291ded7b964a65a37a3c8250e60ec7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.896","languageId":"language.vayrshemo