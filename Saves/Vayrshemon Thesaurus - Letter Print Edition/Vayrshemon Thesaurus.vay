.body","type":"unicode","normalization":"none","text":"gaz\u00e9ms\u00dflum: s\u00dflum falib \u00c3\u00cdowya r\u00c7n\u00d3 ton."}]},{"blockId":"block.a4c47daca39146bf979e49c005591edc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.562","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gaz\u00e9ms\u00dflum \u00ddvton f\u00c5wizya \u00e3\u00d1 broft wa\u00d9gumizya."}]},{"blockId":"block.f3f4f634d0fb45bfb32369e9d2068697","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.608","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"p\u00e1ngiktenv\u00d7j\u00cdenf\u00c5ws\u00dflum: p\u00e1n s\u00dflum p\u00e1f\u00d7j\u00cdtonda olvens\u00eb\u00dbgas\u00dflum."}]},{"blockId":"block.cd3496157a5d4b0eba977f9ca8bef3c2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.672","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin kwist\u00e7l\u00d7onz\u00dfgu\u00d9 p\u00e1izya p\u00e1ngiktenv\u00d7j\u00cdenf\u00c5ws\u00dflum var\u00dfn\u2019i ton giktenv\u00d7izya."}]},{"blockId":"block.bbb0c5943ae047d7a7314c2c5807b28b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.749","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00dfrngaz\u00e9ms\u00dflum: svel\u2019m\u00e7 \u00db\u00c7ds\u00dflum i p\u00e1f\u00d7j\u00cdtonda."}]},{"blockId":"block.698730e7291e45f192eaa069cc536066","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.797","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n merren elyi\u00d1izya s\u00dfrngaz\u00e9ms\u00dflum thrin nilom \u00c3\u00cdizya."}]},{"blockId":"block.5d42e80007634d6cba55b017323eb7e1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.853","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"marvenengaz\u00e9ms\u00dflum: ni var\u00dfnens\u00dflum\u2019i den giktenv\u00d7s\u00dflum."}]},{"blockId":"block.bf97234a565a4477b09f696b7f094b24","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.910","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Marvenengaz\u00e9ms\u00dflum j\u00cdizya \u00d3\u00c5tusol blemfun \u00e3\u00d1 ni var\u00dfna\u2019i den broftizya."}]},{"blockId":"block.d8a7c362c453412883ecdc03d182f4c9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.982","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"F\u00c5w"}]},{"blockId":"block.81f13cbfa955432289b79c90f3ccd00c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.986","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00c5w: \u00d1et \u00e5\u00c3 vesna thrin\u00c3\u00cd\u2019en."}]},{"blockId":"block.3070db336b6f4671a315b1bb6eda6a84","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1016","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za za\u2019h\u00eb\u00d5\u2019na\u2019m\u00e7 mayemszarunthenget \u00e5\u00c3 vesnap\u00e1s\u00dflum f\u00c5wizya."}]},{"blockId":"block.30302bbd4a8b40cabf811ee64353a44b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1076","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"mavr\u00d7n: f\u00c5w\u2019en kom vesna ens\u00e1b\u00eb\u2019jw\u00ebnowya marin ub\u00e1nt\u00e9v gl\u00c9st\u2019en lomih ton f\u00c5w\u2019en."}]},{"blockId":"block.575d6475d38849dcb1240e74475745d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1158","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za d\u00cdn\u00d7ryems\u00d