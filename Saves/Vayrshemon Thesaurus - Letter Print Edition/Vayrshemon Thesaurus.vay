f\u00c7\u00c3izya selin\u2019i farvengraf h\u00eb\u00d5\u2019naizya t\u00d7 venalun."}]},{"blockId":"block.5f1a9c7240c84ed2b3df78e3c66c7b55","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.344","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Voren tha grafvesna threninun"}]},{"blockId":"block.ac07ce7325df421c8b08d13eb953ef1e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.374","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"j\u00c9gwa\u00c3l\u00dfn: vor ni \u00d1etib grafvesna \u00d1etun kl\u00e1rowfu."}]},{"blockId":"block.06b8dda3acc2406893123fb0f2854b33","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.424","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n ef\u2019her\u00db \u00d3\u00c5tusol vorenetthreninun ni j\u00c9gwa\u00c3l\u00dfn o\u00c3\u2019jw\u00ebnimizya."}]},{"blockId":"block.77b05bbf4e1a4d5e98d686e5967317f2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.489","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"zarj\u00c9gwa\u00c3: zar r\u00c7n\u00d3 vesna zar j\u00c9gwa\u00c3imowfu."}]},{"blockId":"block.c7250ccca7484bbb977b9fa538968da0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.533","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni viminolen ve\u00dbzar r\u00c7n\u00d3 zar\u00dfm zarj\u00c9gwa\u00c3 a\u00d9izya."}]},{"blockId":"block.fc88ff6c8154409c9205811a36457e4d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.582","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Voren n\u00d7\u00dbem ni neksus \u00e7l\u00d7on"}]},{"blockId":"block.5d5b947ddd8a4a329b19ddfea5cb3204","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.610","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gurnel: gim\u00dfv \u00d1etun ni neksus naor\u2019m\u00e7 \u00e7l\u00d7on."}]},{"blockId":"block.d1a45f0fa53b49dd99069254eda96af1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.655","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers daral elen r\u00ddy\u00d3s\u00dflum neksus kwesta gren gurnel \u00d1\u00c7lnokizya."}]},{"blockId":"block.a856a935f4524b3892a76233239edfe2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.719","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"z\u00dfgu\u00d9vor: grafvesna threninun n\u00d7\u00dbem k\u00e3m neksus vor."}]},{"blockId":"block.82aa8fc2e22942728dbaa5fb161ce5c5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.771","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka az\u2019m\u00e7 \u00e3\u00d1 ve\u00db\u2019m\u00e7 threninun o\u00c3\u2019jw\u00ebnimizya, neksus z\u00dfgu\u00d9vor ni kular dlen\u00dbeminizya."}]},{"blockId":"block.2ec2f523b3684829b9e0a001e9f4138d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.858","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"V\u00df\u00d5"}]},{"blockId":"block.e2b57213aa244ad69466a35e4eb772df","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.862","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"v\u00df\u00d5: t\u00d7 d\u00c7\u00d3 lomih \u00d1et zarven f\u00c5w\u2019en."}]},{"blockId":"block.26afbe7eeccd4f68af2e7ec9f1a888d7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.899","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth z\u