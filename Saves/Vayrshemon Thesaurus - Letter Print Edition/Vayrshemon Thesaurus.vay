":"unicode","normalization":"none","text":"K\u00e3m zem n\u00d7\u00dbem \u00e7zttharizya goryemsklojs\u00dflumun neksus lil lilizya."}]},{"blockId":"block.43d6f67214814f0897ea7f71ff0e05d6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1027","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"prodnalil: lil i fartonda \u00e5\u00c3 prodvar."}]},{"blockId":"block.4ad14806f455478fb8ac1c5667182a5d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1065","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin prodnavenar p\u00e1izya s\u00dflum kojizya \u00e3\u00d1 prodnalil lilizya."}]},{"blockId":"block.1643c90a38fe470d86211fe0d1d5a4d3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1124","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00e9asemlil: lil i w\u00e9asem."}]},{"blockId":"block.d0f9108225824435bb09a50ae0b9be40","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1149","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lilthrenina\u00d9s\u00dflum t\u00d7 nemir falib n\u00d7nowfu w\u00e9asemlil \u00ddvizya."}]},{"blockId":"block.27b3cfb4172a4df299dc1a8c3613be0d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1208","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Lomib ton l\u00e1m\u2019m\u00e7 r\u00d7owya t\u00d7y\u00dfb\u00dfkelde\u00dbon\u2019en"}]},{"blockId":"block.943abc1a0eef49ad96acb93cabc6e494","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1250","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"l\u00e1mgl\u00c9stl\u00e1m: r\u00c7n\u00d3 vesna l\u00e1mgl\u00c9st k\u00e3men\u2019en."}]},{"blockId":"block.eac472f937154b91a45238e18b5cd6ed","type