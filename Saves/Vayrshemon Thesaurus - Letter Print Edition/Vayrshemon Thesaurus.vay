v kl\u00e1r\u2019en."}]},{"blockId":"block.b7f222d7bcc24a4b9d97a00b2d60c33b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.304","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00c7n\u00d3 vorn\u2019m\u00e7 thiril za thiril thiravget faderizya gren y\u00eblyemar."}]},{"blockId":"block.deaef0ae87c5471e883dd2f4fa5fee38","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.369","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"z\u00d7mar: jelam i murf\u00d7venor \u00e7ztthav\u2019en vinel h\u00eb dlen\u00dbeminowya kom murf\u00d7venor o\u00c3bra\u2019m\u00e7 gim\u00cba\u00d5owya."}]},{"blockId":"block.2213d9fb9c774b26abe987820a30e9d5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.465","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi dar\u00c5elget z\u00d7marizya. Dar\u00c5elelyi\u00d1 tav maserf\u00c5w\u2019m\u00e7 gim\u00cba\u00d5izya p\u00c7n\u00df\u00eb ven j\u00cden ma\u2019a\u00d9izya."}]},{"blockId":"block.b67410b367f24d3eadcf1574f88bbfc2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.554","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tarf\u00c5w: \u00e5\u00c3 p\u00e1nna\u2019m\u00e7 len y\u00c9nen\u2019en."}]},{"blockId":"block.02323faa505e4620bfa1e95838c7fde5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.588","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha neks l\u00dfnil za dar\u00c5el\u2019i vorn\u2019m\u00e7 l\u00dfnget tarf\u00c5wizya."}]},{"blockId":"block.86114c7d27e648b4b05ef579e7613f35","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.642","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ir na vesnaun ma\u2019onega\u2019en"}]},{"blockId":"block.6ae8621bfc9d42dbbef0c66613f25c1a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.668","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grelna: k\u00cfba\u00d1\u2019m\u00e7 f\u00ebr\u00d3 lomih vimin\u2019m\u00e7 \u00e7l\u00d7on l\u00e1mtonda\u2019en."}]},{"blockId":"block.28f1aa7038c24ee8a06ca714ad80cdb9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.724","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka marven, zi grelna\u2019m\u00e7 mem r\u00d7izya \u00e5\u00c3 w\u00cf\u00df pomd\u00c7v t\u00d7 m\u00d7s."}]},{"blockId":"block.febe0e1fa68745fc861bd4fb510dc2d3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.784","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grelenlamsenel: vimin\u2019m\u00e7 fartonda t\u00d7 ir lamettonda\u2019en."}]},{"blockId":"block.25daa7becc1a456c9895fd942f217de6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.839","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za\u2019grelenlamsenel\u2019m\u00e7 taren ni dwe\u00d9en thrin\u00c3\u00cdizya na za\u2019k\u00cfba\u00d1\u2019m\u00e7 threnin."}]},{"blockId":"block.d07d63a3766d4f1ebc00a80072d506ac","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.912","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00dcv"}]},{"blockId":"block.2ec9b844a29646eea6c83a506642b8ea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.915","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00ddv: tonun \u00cbers jelamun a\u00d9\u2019en."}]},{"blockId":"block.4dee4a25f0f241b6865e83b7204773e9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.945","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel gren \u00ddvy\u00eblet za\u2019denget \u00ddvizya."}]},{"blockId":"block.594b4c918efe410f8d8ff30bdccb059b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.980","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"int\u00dff\u00c9ben: \u00d1et t\u00d7 h\u00ebthven\u2019m\u00e7 h\u00c5b\u00cden \u00ddv\u2019en."}]},{"blockId":"block.0717c93897ed4a30b361e0fd94ad4a01","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1023","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Elen yel\u00c5el meranmiktaz\u00d7rs\u00dflum enif\u2019i marjo\u00d9 ni govis int\u00dff\u00c9benizya."}]},{"blockId":"block.0f1669943caf4caaa2506c7330cdf70f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1092","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"O\u00c3bra"}]},{"blockId":"block.181d6dd58b074cce9dda287ee2d0b7ff","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1098","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"shalen: \u00d1et na vesna \u00c7piba\u2019en."}]},{"blockId":"block.8f680d83dbae4aaf97f3b9615f926c4f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1129","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n \u00c5\u00d9gif ragum\u00e7l\u00d7ono\u00c3t\u00e7d\u00c7\u00d3 pelna\u2019m\u00e7 verzetun r\u00c7n\u00d3 felen shalenizya."}]},{"blockId":"block.564e827b0a8d4b67b9a04349a08ec4b6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1198","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"o\u00c3bra: tha vesna\u2019i h\u00c5b\u00cden o\u00c3bra\u2019en."}]},{"blockId