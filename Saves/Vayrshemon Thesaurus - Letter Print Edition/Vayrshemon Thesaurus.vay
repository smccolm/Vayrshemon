","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kenst m\u00ebrven gimer jw\u00ebnenplesten\u2019m\u00e7 r\u00d7izya z\u00e1lven po r\u00c7n\u00d3 yems\u00d7 vimjw\u00ebnh\u00ebizya."}]},{"blockId":"block.50379c79835e4915adf837525b5daafa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.426","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"J\u00cd \u00e3\u00d1 e\u00d3\u00c7ra"}]},{"blockId":"block.41ed4e2703614d39892db76ad5bb5318","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.438","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"j\u00cd: j\u00cden yjafun\u2019en."}]},{"blockId":"block.c4165f013cd444eb82fda60c100a2a15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.458","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Aleth ni se\u00db za thrin dar\u00c5el zarviminolenget j\u00cdizya."}]},{"blockId":"block.841565eb2c9f45b699a916af92ff5ee4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.511","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00dbav\u00e3: venor\u2019m\u00e7 ef\u2019wa\u00d9gum a\u00d9owya vesna j\u00cden a\u00d9zna\u2019m\u00e7 s\u00dflum\u2019i sezif\u00c7\u00c3 \u00d3\u00e1lun\u00c3\u2019en."}]},{"blockId":"block.b0dbfb7866f24de0a67f31ada58273b7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.590","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin daral thavvimna dar\u00c5el braizya r\u00e1 r\u00e1\u2019palilaget \u00dbav\u00e3izya. Za\u2019y\u00eblyemar velin ni goryems r\u00d7izya."}]},{"blockId":"block.09009fe18f4f43658bd278860f21c309","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.688","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"e\u00d3\u00c7ra: \u00e5\u00c3 j\u00cden o\u00c3jem f\u00c5w\u2019en."}]},{"blockId":"block.8bb16a082c274a9eb22dbb8a32c3bddb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.717","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni bra\u2019m\u00e7 dar\u00c5el zi e\u00d3\u00c7raizya p\u00c7n\u00df\u00eb mav\u00d1et j\u00cdizya."}]},{"blockId":"block.6abcd34ec2c24b08a16e395684ec3719","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.768","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"o\u00c3jems\u00e3\u00d1: p\u00e1nmartonda j\u00cd\u2019en \u00e3\u00d1 \u00cbers po f\u00d7\u2019en."}]},{"blockId":"block.73bc651f4a184d52953fd5669ebf86f8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.814","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Goryemsd\u00c7\u00d3s\u00dflum p\u00e1nmartondaget o\u00c3jems\u00e3\u00d1izya \u00e3\u00d1 ni meranjem\u00e3 dlen\u00dbeminizya."}]},{"blockId":"block.eb3aa4ed8af14207b1a436fa7cc209b4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.889","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"J\u00cden"}]},{"blockId":"block.c616d6f3026146c6ae45d3de0b77828e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.894","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"j\u00cden: \u00d1etib jorin yjafunowya."}]},{"blockId":"block.38deba7edac64bc0a62bda3e713d4c01","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.924","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni k\u00ebr r\u00e1 neksus j\u00cden j\u00cdizya \u00e3\u00d1 zarviminolen portimostizya."}]},{"blockI