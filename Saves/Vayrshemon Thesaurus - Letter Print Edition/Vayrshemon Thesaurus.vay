"}]},{"blockId":"block.cf4e894068824f4db620e428e83eac0f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.202","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth zarkelde\u00dbon azard\u00c7\u00d3s\u00dflum t\u00d7 ve\u00dbzar grelnaa\u00d9\u2019m\u00e7 v\u00df\u00d5gimen hy\u00c5v\u00cdizya."}]},{"blockId":"block.fd218219f2c940cebc9bcf18bbccbff3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.274","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kl\u00e1rjem\u00e3"}]},{"blockId":"block.5e25c634cee84875b93ba457c391d8b9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.283","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kl\u00e1rjem: n\u00d7\u00dbem gl\u00c9z\u00cben\u2019en."}]},{"blockId":"block.96af7b868591466db459be1489f9cd2b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.310","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za ika\u00d9\u2019m\u00e7 y\u00eblenun n\u00d7\u00dbem kl\u00e1rjemizya vinto zem n\u00d7\u00dbem ragumizya."}]},{"blockId":"block.42274b3707524e0693a0c3e9a41b692f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.374","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"thiren: r\u00c7n\u00d3 z\u00ebrel kl\u00e1rjem\u00e3\u2019en."}]},{"blockId":"block.2f152de78d174cf988db63808991037c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.406","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi borel\u2019i tom r\u00c7n\u00d3 thiril jw\u00ebnenplesten thirenizya."}]},{"blockId":"block.d3ec54676f6b4f73a181b24dc3836630","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.459","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kl\u00e1rjem\u00e3: \u00d1et ni \u00e7l\u00d7on gl\u00c9z\u00cben\u2019en."}]},{"blockId":"block.54112b1e6e2347c3a76aebeb03ecc22f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.494","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n enifetyeks zem daromi r\u00c7n\u00d3 kranzar lunor gl\u00c9z\u00cben kl\u00e1rjem\u00e3izya."}]},{"blockId":"block.e5d4bd7d771c471f81e9f6f00a765e74","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.561","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kinemplest\u2019m\u00e7 \u00d1et po\u2019l\u00dfn b\u00e9rvowya"}]},{"blockId":"block.607d70c2b7bc4b27bc4653ba7f9f5a95","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.595","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"velren: \u00cbers her\u00db renna gim\u00cba\u00d5\u2019en."}]},{"blockId":"block.615ddbd2b79640d59d6002bdf2ba7826","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.630","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni zarun thren melsakor velrenizya \u00e3\u00d1 nira tremborel renizya."}]},{"blockId":"block.c000636ff01a422a857d8d8e50d4a6e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.692","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"rennastras: ni vesna renna strasf\u00c5w\u2019en."}]},{"blockId":"block.5aee28575f804cd6bea5c8d1fe64d24e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.732","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Marin zarun merkw\u00d7sil ni t\u00e9z\u2019m\u00e7 yems\u00d7 rennastrasizya."}]},{"blockId":"block.4ca5079deca14203bc2e3044ba74b051","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.786","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"K\u00e3men \u00cbers tonun"}]},{"blockId":"block.2d36779caa974b08a40864f4c9d8e417","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.803","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"k\u00e3men: \u00cbers ton i l\u00dfnil \u00d1etun k\u00e3men\u2019en."}]},{"blockId":"block.80718ad93f23427396e72696e07bc92e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.843","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni za\u2019k\u00e3men lilthrenina\u00d9s\u00dflum tondaizya \u00c5\u00d9b\u00d7r viminmeran gren goryems l\u00dfnilowya."}]},{"blockId":"block.d1d7a07b447b43b4bda7e77ffaf6579c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.924","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tonthrinda\u00c3: neksus \u00d1et \u00cbers vesna\u2019i den \u00d3\u00c5\u00e7\u2019en."}]},{"blockId":"block.4265043fdc4c4ba8a461589573b4a370","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.973","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers tonthrinda\u00c3 lilthrenina\u00d9s\u00dflum \u00c5\u00d9b\u00d7r \u00c5\u00d9gif\u2019i viminmeran \u00d3\u00c5\u00e7izya."}]},{"blockId":"block.30a0efc2ff734dd3ad05e7df1c2766e9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1042","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"K\u00e3nib z\u00e1ls\u00dflum \u00cbers a\u00d9\u00d5\u00dfr kl\u00e1rimowya"}]},{"blockId":"block.e23717ef2c5c4e5584a5c4758dafba63","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1079","languageId":"language.vayrshemon","style