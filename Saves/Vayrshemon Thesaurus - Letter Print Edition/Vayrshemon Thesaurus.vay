\u2019m\u00e7 eznaun"}]},{"blockId":"block.a56e5a1471bf45aeafe1b735ddd476ce","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.37","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murf\u00d7 ka fradowya"}]},{"blockId":"block.badec0726cb44432b5a6a44f866033d6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.55","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murfraad: fradef r\u00c7n\u00d3 goren\u2019m\u00e7 b\u00e9rven."}]},{"blockId":"block.cd4410d4ed73428cb286d95fbbdc98fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.94","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth murfraad venik z\u00e1ls\u00dflumun grel neksus z\u00e1lshalen se\u00dbizya."}]},{"blockId":"block.bdb519d36bb34f1daacceeb082572200","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.156","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murenvenor: jw\u00ebnenplesten\u2019m\u00e7 venka thrin venor."}]},{"blockId":"block.eb6d5a34de2641bf8f690e30b832f719","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.204","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thrin venalun i murenvenor zem elen yems\u00d7p\u00e1 tav verzetizya."}]},{"blockId":"block.a24c2158dac940289d4f6592bac353c3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.264","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murf\u00d7 \u00d1etib vor mlapv\u00d7staowya"}]},{"blockId":"block.355349da880840b3b910411ea3324205","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.294","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murvorh\u00eb: murf\u00d7 tha \u00d1etib vor mursemowya."}]},{"blockId":"block.bc5c27dfe705473c8063dc0c9905a34c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.336","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za\u2019murvorh\u00eb tha gaktriv jem\u00e3izya zaget ni z\u00e1lin venka shalem ol\u2019m\u00e7 r\u00d7izya."}]},{"blockId":"block.1a81dd68ef6f4f79b52bdd52d0762e49","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.411","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"sar: ika\u00d9 ni vorin ni neksus \u00e7l\u00d7on."}]},{"blockId":"block.c34c19c33c9a47478fca100376b2cacc","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.447","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth gaktriv zi felen na sar ni margrel gl\u00c9z\u00cbenizya."}]},{"blockId":"block.633dba9a971745f3b6f3056be9e7c819","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.500","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murlam"}]},{"blockId":"block.7ffb7ea222ec4e8da08083dfe7969ba6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.507","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murlamtonda: murlamet falnthren \u00e5\u00c3 s\u00dflum itonda\u2019en."}]},{"blockId":"block.998a53b8a41949d59bc3775b63bd279e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.559","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n nerbw\u00c5vumenvar\u00dfnen kamiz\u00e3\u00d1ts\u00dflum \u00ddvs\u00dflumget i shel murlamtondaizya."}]},{"blockId":"block.59a8f48e61da40fc8d21ff1f43f384e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.631","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murlam: \u00e5\u00c3 s\u00dflum i murf\u00d7venor giktenv\u00d7\u2019en."}]},{"blockId":"block.9a18939df26d4cf8bbca7d505730c903","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.674","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pomz\u00e1lpomf\u00c5ws\u00dflum pelnapelenget kenst zi zi\u2019ton ika\u00d9owfu murlamizya."}]},{"blockId":"block.898ddc8d0576475a8755f66fd42d34ad","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.743","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e5\u00d1giktenv\u00d7en: ni gorenj\u00cden\u2019m\u00e7 giktenv\u00d7j\u00cden murlam\u2019en."}]},{"blockId":"block.a3a905a57c494b74b9446f6df724e43f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.797","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha n\u00ddz\u00e1l dar\u00c5el za pelnapelenunget \u00e5\u00d1giktenv\u00d7enizya vinto zem ol \u00c3\u00cdthavizya."}]},{"blockId":"block.86bbb81ba2c2454e97e59487482ef946","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.875","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"destnamurlam: ub\u00e1nt\u00e9v \u00e5\u00c3 ub\u00e1nt\u00e9v t\u00d7 murf\u00d7venor \u00e5\u00d1giktenv\u00d7en\u2019en."}]},{"blockId":"block.5d2219d9f3d648c8b71c1cb5d0a71887","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.939","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 yems\u00d7\u2019m\u00e7 jo\u00d9l\u00dfnil gren jo\u00d9shal palilaget r\u00e1 destnamurlamizya."}]},{"blockId":"block.ac277522ca0c48c6b397585420963b12","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1004","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murlamvut"}]},{"blockId":"block.6070918fbddf49729b8cba8bc5ebedee","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1014","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"zar\u00ebn: s\u00dflum tha murlamtonda maserf\u00c5w\u2019en."}]},{"blockId":"block.b91f0c2658184d1592a379d93933f9e6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1056","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin s\u00ebven taren tar\u00c3\u00cdizya nerbw\u00c5vumensilen kl\u00e1rjems\u00dflumget zar\u00ebnizya."}]},{"blockId":"block.bceffda2ae694a958ee586dce0e40dfb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1126","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murlamvut: h\u00ebth murlamet murlam maserf\u00c5w\u2019en."}]},{"blockId":"block.d1a88d62b9a0487c8c2386245d515984","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1171","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka murf\u00d7venors\u00c7fef lamem\u2019m\u00e7 r\u00d7izya var\u00dfn kl\u00e1rjems\u00dflumget murlamvutizya."}]},{"blockId":"block.fd1eeff4335c43969865c4e18828c42c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1246","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murlamet \u00cbers ton gl\u00c9st\u2019en"}]},{"blockId":"block.edbabf13790e4c1491ad3c900818bb96","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1273","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murlamgiktenv\u00d7en: ton i neksus falib murlamet mursemowya."}]},{"blockId":"block.8bf2681d499b406db8d16a2ae0a4ce28","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1331","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za\u2019murlamgiktenv\u00d7en s\u00e3\u00d1v\u00d7dlehmizya venor\u2019m\u00e7 wa\u00d9gum p\u00e1n yems\u00d7 f\u00c5wimizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":54,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":55,"end":93,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":94,"end":155,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":156,"end":203,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":204,"end":263,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":264,"end":293,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":294,"end":335,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":336,"end":410,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":411,"end":446,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":447,"end":499,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":500,"end":506,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":507,"end":558,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":559,"end":630,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":631,"end":673,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":674,"end":742,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":743,"end":796,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":797,"end":874,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":875,"end":938,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":939,"end":1003,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline"