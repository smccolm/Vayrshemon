ext":"O\u00c3ub\u00e1nt\u00e9v ni daromi s\u00dfrnb\u00d7\u00c7rizya veneks rav k\u00ebr\u2019m\u00e7 gim\u00cba\u00d5izya."}]},{"blockId":"block.da4f12f61d464e1fa2f670a4d06ffc8e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.161","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"B\u00e9rven \u00e5\u00c3 vesna a\u00d9 far"}]},{"blockId":"block.df084d979b8349479ef4db011ce1fa05","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.184","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tarv\u00df\u00d5: \u00d1etib \u00e5vlemv\u00c7howfu tar f\u00c5w\u2019en."}]},{"blockId":"block.a827074a8b4142129c547aa9eb66982a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.223","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kular i p\u00e1in ni yems\u00d7p\u00e1 za \u00e5vlemv\u00c7hizya. Ni harven za po tarv\u00df\u00d5izya."}]},{"blockId":"block.f67aa50e649947e0a19ce735ac248ea4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.292","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"farmin: t\u00d7 vesna\u2019i b\u00e9rven f\u00c5wen f\u00c5w\u2019en."}]},{"blockId":"block.651f50571dae485bb894b72efdd16d40","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.332","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 \u00d3\u00c5tus yelun b\u00e9rvimizfu zem gaz\u00e9ms\u00dflumget r\u00c7n\u00d3 felen farminizya."}]},{"blockId":"block.b85752c745cc4085883a696a1130cd70","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.399","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0et \u00cbers \u00d1etib vesna \u00d1et pomimowya"}]},{"blockId":"block.3aebc80325f94e5995bfb658c67d5de6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.434","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"falnel: vimin\u2019m\u00e7 l\u00dfn i vesna \u00d1et."}]},{"blockId":"block.ff1b13a7165e423aa6f55ec6cab43a86","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.468","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren falnel i y\u00eblyemar pel o\u00c3izya horib y\u00eblyemar ni neksus h\u00eb\u00d5 gimkin\u2019m\u00e7 r\u00d7owya."}]},{"blockId":"block.13915227535d4b988f823f303c637cb5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.549","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"l\u00dfngl\u00c9st: l\u00dfn \u00e5\u00c3 akrad\u2019en ni d\u00c7\u00d3."}]},{"blockId":"block.190dd94512ee47bebd679890caa13d85","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.583","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha ilna\u2019m\u00e7 l\u00dfngl\u00c9st \u00d3\u00c5tusol larfelenun za dest\u00eb\u00c5izya."}]},{"blockId":"block.07f384ebcf054e1db5bf067e2d1f3c96","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.638","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tremb\u00c5rmem: vesna\u2019i tremb\u00c5r k\u00e3m mem vinto poms\u00dflum k\u00cfba\u00d1\u2019m\u00e7 mem h\u00c5b\u00cdowya."}]},{"blockId":"block.f66057a397a34d1ca8e40079c51f0695","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.712","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 neks venik thirilviminolenun r\u00e1\u2019tremb\u00c5rjel za\u2019tremb\u00c5rmem r\u00d7izya. B\u00c5rum\u2019t za \u00cbers za\u2019k\u00cfba\u00d1\u2019m\u00e7 jel a\u00d9izya."}]},{"blockId":"block.a595f5aef9b645f4a7cdd90ba8e0ad92","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.820","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gl\u00c9stvoren: neksus \u00d1et \u00d1etib olgimkin\u2019m\u00e7 ton gl\u00c9stowya."}]},{"blockId":"block.2317691fec7a4ffe91072e2c6ba55335","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.876","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neksus yemsininna\u2019m\u00e7 enifelen zi k\u00e3m gl\u00c9stvoren i murf\u00d7 \u00cbers enif gl\u00c9stizya."}]},{"blockId":"block.522a52a65b9940bda5a729bd361ecd25","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.953","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0et \u00d1etib falnthren zarilowya"}]},{"blockId":"block.41e36ffe5b024bebafe6310cb734d76a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.983","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"zaril\u00d1et: \u00d1et thrin y\u00eblyemar\u2019i marjo\u00d9."}]},{"blockId":"block.216c0a9856e34c998571b9536fa0c018","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1022","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha viminmeran zem zaril\u00d1et ma\u2019o\u00c3izya vinto teral dur\u00ebn vorilizya."}]},{"blockId":"block.59faac086576480289d61ec13840b8a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1089","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"zaril: \u00d1et \u00d1etib d\u00c7\u00d3 venimna\u2019m\u00e7 a\u00d9owya."}]},{"blockId":"block.1246a4fd5b414eb0b6d55fe073231e27","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1129","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem\u2019yib\u2019\u00ebw zaril r\u00d7izya ka maneks s\u00ebven vesna\u2019i giktenv\u00d7en h\u00c5b\u00cdpomizya."}]},{"blockId":"block.15c6fe4f5ab24fd5978e4d6995d54c5f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1201","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0et tha ir elyi\u00d1\u2019en"}]},{"blockId":"block.91c8167734a24fd583a57d42b4a8b73d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1221","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"matond: \u00d1etib f\u00c5wgl\u00c9stimowya ma\u2019ens\u00e1b\u00eb\u2019en."}]},{"blockId":"block.b1e9ba387193467aaf33a6d6e74307f3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1264","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za v\u00df\u00d5get matondizya \u00e3\u00d1 t\u00d7 yems\u00d7 vemyib\u2019\u00ebw w\u00cf\u00dfizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":43,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":44,"end":97,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":98,"end":160,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":161,"end":183,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":184,"end":222,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":223,"end":291,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":292,"end":331,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":332,"end":398,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":399,"end":433,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{