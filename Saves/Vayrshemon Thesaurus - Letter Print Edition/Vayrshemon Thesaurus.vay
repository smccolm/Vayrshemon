e.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e4\u00c3 vesna\u2019i \u00c9lm f\u00c5wmarjo\u00d9\u2019en"}]},{"blockId":"block.3fff7ff448a94e81aefd8c3abef26d07","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.93","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"nor\u00d3asem: \u00cbers vesna\u2019i nor\u00d3a falnthren\u2019en."}]},{"blockId":"block.57a263d79e5a4af9a6a431d3a580de9d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.136","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zarviminolen j\u00cdenizya \u00e3\u00d1 elen viminmeran sezif\u00c7\u00c3izya. Y\u00eblyemard\u00c7\u00d3s\u00dflum nor\u00d3aget nor\u00d3asemizya."}]},{"blockId":"block.eaeb1a342b0a4c20a5ae67a16c0ec852","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.230","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grelf\u00c5w: k\u00cfba\u00d1\u2019m\u00e7 \u00c9lm grel vesna\u2019i jw\u00ebnen \u00c7piba\u2019en."}]},{"blockId":"block.3641097ecd734ee0b33509cb295b5fb5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.282","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venor\u2019\u00ebw zi horenizya. Ni h\u00eb\u00d5\u2019na \u00e5\u00c3 h\u00c5b\u00cdtorpgur\u2019i nerb zi grelf\u00c5wizya."}]},{"blockId":"block.14090470c12745e5b9772647d6924895","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.353","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e4\u00d1"}]},{"blockId":"block.a1a2855fec2b4000a2fa49325bd43c65","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.356","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e5\u00d1: murvor vin murlamet mlapv\u00d7staimowya."}]},{"blockId":"block.c01e083f8a32469e8ee7374cc549e4ab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.397","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin tarmen mem \u00e3lumizya za\u2019\u00e5\u00d1 gl\u00c9stimizya."}]},{"blockId":"block.952454bdc7924b9593c854d357b88115","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.440","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e5\u00d1o\u00c3jem: \u00e5\u00d1 ni vesna falib murdat nerbyalizya vinel t\u00d7 vesna\u2019i man\u00d7njemlen wa\u00d9gumowya."}]},{"blockId":"block.9abc4e10887a41d093552ad93427ec1e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.527","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ol \u00c5\u00d9gif ni za\u2019\u00e5\u00d1o\u00c3jem za b\u00d7\u00c7rborel b\u00e7orna\u2019m\u00e7 jem\u00e3izya. Vin zi sezif\u00c7\u00c3izya ni h\u00eb\u00d5\u2019na za ziget \u00e5\u00d1giktenv\u00d7en\u2019jw\u00ebnizya."}]},{"blockId":"block.f5ccd2165a4d4f3cbf21b54621efce3e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.644","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e5\u00d1goren: goren\u2019m\u00e7 \u00e5\u00d1 \u00d1etib murtar t\u00d7y\u00dfb\u00dfkelde\u00dbonowya."}]},{"blockId":"block.9bc9e156e0d046aebf586d0424849a8f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.698","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"S\u00dflum var\u00dfn\u2019i \u00e5\u00d1goren marizya vin zi zem\u2019w\u00cfin\u00ddv dest\u00eb\u00c5ika\u00d9izya."}]},{"blockId":"block.fbb86e3d8b55439db46cfe7489581810","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.762","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e5\u00d1jem\u00e3: \u00e5\u00d1 ni sevar jem\u00e3\u2019en."}]},{"blockId":"block.c8c86329c59a485da1e9b98ae43d2c14","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.791","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka zem ni ilna\u2019m\u00e7 klojvor wemizya zi\u2019\u00e5\u00d1jem\u00e3 thrin vernil dlen\u00dbeminizya."}]},{"blockId":"block.6bb17b93d53c4ef2a34dc6015a7eea58","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.866","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"lamet\u00e5\u00d1: \u00e5\u00d1 kenst falnthren yibmarin\u2019m\u00e7 \u00d3\u00e1lun\u00c3owya."}]},{"blockId":"block.9155cf0580ec44738174145c16fd84c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.918","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin h\u00eb\u00d5\u2019na z\u00e1ls\u00dflum yems\u00d7 ma\u2019mlapv\u00d7staizya za\u2019lamet\u00e5\u00d1 ner\u00c3\u00cdizya."}]},{"blockId":"block.27e488593dfe4a8699396ffa91e6a02c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.983","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"pisensemmarin: w\u00c5vumen elyi\u00d1owya zeth \u00d1etib fradowya."}]},{"blockId":"block.7b2660527ea248df91829332b080bcc8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1037","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers elyi\u00d1imizfu \u00ddvton vemyib\u2019\u00ebw marven zi\u2019pisensemmarin gl\u00c9stizya."}]},{"blockId":"block.75806f1b39f3416bb84f480706766bce","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1105","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"n