."}]},{"blockId":"block.51b432f0bffc4044b043f460fa893c25","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1328","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n minem threnina\u00d9imizya jem\u00e3s\u00dflum \u00d3\u00c5tusol viminolenunget minlamizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":56,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":57,"end":153,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":154,"end":260,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":261,"end":328,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":329,"end":391,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":392,"end":443,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":444,"end":531,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":532,"end":569,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":570,"end":642,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":643,"end":663,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":664,"end":702,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":703,"end":757,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":758,"end":800,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":801,"end":860,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":861,"end":890,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":891,"end":929,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":930,"end":1007,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":1008,"end":1055,"attributes":{"tracking":0,"wordSpacin