d1744a394d4c268054cdad923ac075","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.122","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za\u2019jovetz\u00e1l\u00ddv yib\u2019\u00ebw venik tonun tondaizya: Za vinol sezif\u00c7\u00c3izya."}]},{"blockId":"block.795dd5c4076747c3bfdc3161936dad37","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Den gren shal"}]},{"blockId":"block.4757456343d24018ab2f18c5c20bf487","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.202","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"piril: vimin\u2019m\u00e7 den i l\u00c7m."}]},{"blockId":"block.b1d6ee8dc52046a68ee2c6d2b9eee897","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.229","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren ve\u00db\u2019m\u00e7 pelshal neksus w\u00ddy\u2019m\u00e7 piril r\u00d7izya."}]},{"blockId":"block.776c2791291345079e55c32e003f92f6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.277","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murden: den ka h\u00ebth ef\u2019yemyat dlen\u00dbeminowya."}]},{"blockId":"block.fae1049be2f641a6bae356e5dde82871","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.322","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth m\u00ebrven mayemsizya olen\u2019m\u00e7 murden gren felen dlen\u00dbeminizya."}]},{"blockId":"block.ed1afeaf53f64b038862746b15c20ba8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.386","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Den ni shal dest\u00eb\u00c5\u2019en"}]},{"blockId":"block.e396d4c7a8bb412f9698f94e03dc2836","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.408","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"dest\u00eb\u00c5\u00ddv: \u00ddv\u2019m\u00e7 jelam nira jw\u00ebnenplesten\u2019m\u00e7 shal dest\u00eb\u00c5\u2019en."}]},{"blockId":"block.7748abe5b15d4c268fdef192eff171be","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.468","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren thren i tremborel za venamget dest\u00eb\u00c5\u00ddvizya kom po yemyat thav ma\u2019\u00c3\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.9ff051d3c8fc4238a3d453ffc1e9c172","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.551","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"dest\u00eb\u00c5l\u00dfn: \u00cbers ef\u2019dest\u00eb\u00c5 l\u00dfn a\u00d9\u2019en."}]},{"blockId":"block.36dd7165b2bb4181b092ae408993f096","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.588","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha ilna\u2019m\u00e7 y\u00ebl zi wilget dest\u00eb\u00c5l\u00dfnizya \u00e3\u00d1 po\u2019v\u00ddlawinun siv\u00ebl\u2019m\u00e7 a\u00d9izya."}]},{"blockId":"block.1438df76a7144c15948ec7e2709102d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.661","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Dlenson\u2019m\u00e7 giktenv\u00d7j\u00cden"}]},{"blockId":"block.c571edcf7a864d63867985362e78e30e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.685","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"vimingiktenv\u00d7: ni grelna\u2019m\u00e7 giktenv\u00d7j\u00cden giktenv\u00d7\u2019en."}]},{"blockId":"block.8ad42ae7e3784846b4920d8690093edf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.739","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thavvim za\u2019jorin zi broftget vimingiktenv\u00d7izya kom vesnaun ma\u2019j\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.84a6a302ca8243eda071008525c45722","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.814","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"krangiktenv\u00d7: vinel j\u00cden vesna jorinun plestowya \u00e5\u00c3 neksus s\u00dflum giktenv\u00d7\u2019en kom vesnaun tonun ma\u2019j\u00cd\u2019jw\u00ebnowya."}]},{"blockId":"block.dbad507e196849f0b527f09bf3763d70","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.925","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel zarviminolen j\u00cdenizya mela ni r\u00e1\u2019jorin krangiktenv\u00d7izya. \u00e2\u00d1ts\u00dflum ly\u2019ub\u00e1nt\u00e9vun o\u00c3izya p\u00c7n\u00df\u00eb v\u00df\u00d5gimen ma\u2019j\u00cdizya."}]},{"blockId":"block.e8d69b87d3854b25bc30fe9eebd1ead2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1043","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grelnamurlamgiktenv\u00d7en: r\u00c7n\u00d3 grelna\u2019m\u00e7 giktenv\u00d7j\u00cden zeth \u00d1et murlamgiktenv\u00d7en\u2019en."}]},{"blockId":"block.67213c7097704189a1d10f5765055206","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1125","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin mayemszarunthen vimin\u2019m\u00e7 tav r\u00d7izya s\u00dflum zeth jem\u00e3s\u00dflum grelnamurlamgiktenv\u00d7enizya."}]},{"blockId":"block.f03ed000b14f47f39bc1521d7481945e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1214","language