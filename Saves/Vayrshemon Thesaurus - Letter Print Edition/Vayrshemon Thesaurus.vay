uage.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni \u00e1pe\u00dbem\u2019m\u00e7 klojvor h\u00ebth d\u00c7\u00d3 zem\u2019s\u00dflumkl\u00e1rjem ragumizya."}]},{"blockId":"block.31fed2aa6a2b4a4497fbcb61cb201c8b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.169","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib ni renna gaktrivowya \u00e5\u00c3 dur\u00ebn"}]},{"blockId":"block.0c8296a98b554af0a10f5548eb8f1893","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.205","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"velgaktrivthren: voren ni dur\u00ebn i renna."}]},{"blockId":"block.8ef0ea6c1d824016a9e94a400012faa9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.246","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth yems\u00d7 velin\u2019m\u00e7 r\u00d7izya thirilin\u2019m\u00e7 w\u00ddy\u2019m\u00e7 velgaktrivthren shalenizya dur\u00ebn i tremborel."}]},{"blockId":"block.41bb5c0ee4df46a8b658e5f603a3a101","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.338","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"velgaktrivdlen\u00dbemin: \u00d1etib thavtarnimowya h\u00eb\u00d5\u2019na threnin i m\u00ebr."}]},{"blockId":"block.076222f4b4114bca8ea2e04e4e1c6dcf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.402","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Neks tremborel b\u00d7\u00c7r\u00c5el\u2019m\u00e7 r\u00d7izya. Tha h\u00eb\u00d5\u2019na tremborel z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum velgaktrivdlen\u00dbemin tarnthavizya."}]},{"blockId":"block.8357b592bbbd4ac2ad84f586a38d1d6b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.504","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"m\u00ebrvendlendlen\u00dbemin: m\u00ebrven\u2019i velgaktrivthren."}]},{"blockId":"block.3de7ba77179f4960bf38a2aa86b34217","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.551","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"M\u00ebrven nira yat\u2019m\u00e7 borel yemsda\u00c3izya \u00e3\u00d1 m\u00ebrvendlendlen\u00dbemin ni vorn\u2019m\u00e7 gorenm\u00ebrvenborel dlen\u00dbeminizya."}]},{"blockId":"block.d1121342fc404512affe781fe5960fff","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.654","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib ni vor k\u00e3m threnin r\u00d7owya"}]},{"blockId":"block.c24978856f3a4abab1d8713fd8826d77","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.686","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"y\u00ebldurvoren: neks\u2019m\u00e7 voren \u00d3\u00cf\u00cb\u00e9\u00d1imowya ni vesna vorun."}]},{"blockId":"block.427673d282384037bde885c01f81e265","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.741","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha neksus renna vemyib\u2019\u00ebw zi lomib merkw\u00d7sil y\u00ebldurvoren i ol vorun r\u00d7izya ma\u2019h\u00c5b\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.c4deca34cf4b4c9089db243aed87bd79","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.835","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jo\u00d9olvoren: jo\u00d9ol lomih yems\u00d7 lomih s\u00ebra lomih zarun k\u00e3m neks\u2019m\u00e7 voren."}]},{"blockId":"block.72509bba434d40e28aa0422c72d8d352","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.907","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni zem\u2019taren yems\u00d7 jo\u00d9olvoren r\u00d7izya aleth p\u00e1n nabyems \u00e5\u00c3 jo\u00d9ol gaktrivizya."}]},{"blockId":"block.d30316f1e1194a59af3477e860d135f7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.984","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib ni s\u00dflum hanenowya"}]},{"blockId":"block.249d86bef02c43cd821756ed5c129420","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1009","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"farprod: el\u00ebin ni ef\u2019da\u00c3 lomih ef\u2019giktenv\u00d7."}]},{"blockId":"block.7e9ecd87a89b4c65ae9dbd29dfbd12ba","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1053","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Aleth gren mailmem\u2019m\u00e7 kwesta za r\u00c7n\u00d3 farprod m\u00e5rizya."}]},{"blockId":"block.fb9f46ee388f40869664769778a99b46","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1107","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"farvemen: neksus a\u00d9zimowya noten ni lil fartondaimowya."}]},{"blockId":"block.2aeed41136e44543a1a9a3688a365306","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1163","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gurin za\u2019farprodun lilthrenina\u00d9s\u00dflum neksus farvemen na el\u00ebin denizya: Br\u00c9hn."}]},{"blockId":"block.9d558fb65a904536beb850dc1101364b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1241","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0etib n\u00ebr yjafunowya"}]},{"blockId":"block.c312cf15db244b758c6761c9091fbfd8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1262","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"nel\u00ebr: noten \u00d1etib \u00cbers n\u00ebr yjafunimowya."}]},{"blockId":"block.a0656008bd034dc3883bfe33a9c0c48e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1304","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka m\u00c5rumborel braimizfu, nel\u00ebr i pol ni felen dlen\u00dbeminizya."}]},{"blockId":"block.7d3bad96da9640309efefcff355b9051","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1368","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"oden: ton i falnjo\u00d9 t\u00d7 \u00d1etib n\u00ebr yjafunowya."}]},{"blockId":"block.d92eb839a40e48a59d9360ea3c19c7db","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1413","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren falnjo\u00d9 falnthrens\u00dflum masif\u2019m\u00e7 tremb\u00c5r onegaizya \u00e3\u00d1 fartondaizya oden i pol."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":62,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":63,"end":110,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":111,"end":168,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":169,"end":204,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":205,"end":245,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":246,"end":337,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":338,"end":401,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":402,"end":503,"attributes":{"trac