.body","type":"unicode","normalization":"none","text":"nasevar: k\u00cfba\u00d1\u2019m\u00e7 minlam naor\u2019m\u00e7 gl\u00c9z\u00cben\u2019en."}]},{"blockId":"block.4b1b7d0d6e234b51937ba37715508630","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1133","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za r\u00c7n\u00d3 nasevar neks enifelen i za\u2019a\u00d9 strasf\u00c5wizya."}]},{"blockId":"block.5d8bca9f0b124d708f72f68b865a3e01","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1185","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"nasevargimeren: ir na vesnaun marin h\u00eb \u00c7piba\u2019en."}]},{"blockId":"block.41b54c410acb44b183cc0e67ba6ea6f5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1234","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni zi\u2019nasevargimeren p\u00e1n y\u00eblyemarmiktaz\u00d7rs\u00dflum giktenv\u00d7izya zi marjo\u00d9 nerbyalizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":74,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":75,"end":112,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":113,"end":155,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":156,"end":225,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":226,"end":264,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":265,"end":331,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":332,"end":361,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":362,"end":397,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":398,"end":464,"attributes":{"tracking":0,"wordSpacing":0.0,