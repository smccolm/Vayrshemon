Id":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth \u00d3\u00c5tusol tarenun zyrizya nerbw\u00c5vumen neksget thavtarnizya."}]},{"blockId":"block.5779d0d18a1c4d6c9566b4230afe0ab8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.392","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tarnthav: vorn\u2019m\u00e7 \u00d1et \u00d1etib ma\u2019\u00e5vatya tarn\u2019en thav."}]},{"blockId":"block.73c508a6e8c141feb9742a0c9bb770ca","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.444","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Veneks p\u00e1f\u00d7\u2019m\u00e7 thiril thirav p\u00e1ns\u00ebn\u2019m\u00e7 r\u00d7izya zem yemsininna\u2019m\u00e7 neksusget tarnthavizya."}]},{"blockId":"block.71c861ff012f4f958d7de33e8ba031a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.532","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"vutthav: \u00d1et vut\u2019en \u00e3\u00d1 tav ma\u2019\u00c9lm\u2019en."}]},{"blockId":"block.665d2441e3374e6ab121d2ebf2a5a4c3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.570","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth yems\u00d7p\u00e1 mayems\u2019m\u00e7 gim\u00cba\u00d5izya h\u00eb\u00d5\u2019na z\u00e1ls\u00dflum w\u00cfn\u00c7unget vutthavizya."}]},{"blockId":"block.c0ea034b0ef148348bb972214e7c9ee5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.643","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0et \u00e3\u00d1 po\u2019k\u00cfba\u00d1s\u00dflum"}]},{"blockId":"block.f671df791ee7476da8a56f5881fcd982","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.664","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"k\u00cfba\u00d1len: \u00d1et k\u00e3m k\u00cfba\u00d1\u2019m\u00e7 ef\u2019gl\u00c9z\u00cben."}]},{"blockId":"block.9926a735bf3c4917ac2d379ed8c05bc0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.703","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"I w\u00cfn\u00c7 za k\u00cfba\u00d1len jem\u00e3izya venka vesna po verzetizya."}]},{"blockId":"block.e923f9d2bd7b418780f8e668a3877f14","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.758","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d1\u00c5z\u00d1et: \u00d1et \u00d1etib k\u00cfba\u00d1s\u00dflum \u00e3\u00d1t\u2019jw\u00ebnowya."}]},{"blockId":"block.d71b617359f94920824f29b6cced70e5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.801","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e4\u00c3 lamf\u00ebren v\u00df\u00d5\u2019en neksus \u00d1\u00c5z\u00d1et nathavim nilom za \u00e3\u00d1tizya."}]},{"blockId":"block.a2aa87af2285425eb83d91865d748e49","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.861","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d0et \u00e5\u00c3 vesna\u2019i tremb\u00c5r f\u00c5w\u2019en"}]},{"blockId":"block.2254c2696f10451fa62ed485d7575b26","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.891","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00c5w\u00e7l\u00d7on: far\u2019m\u00e7 \u00d1et k\u00e3m f\u00c5wen f\u00c5w\u2019en."}]},{"blockId":"block.f9217ef2959c472e9f720cb364dd782f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.930","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni h\u00eb\u00d5 i y\u00e9\u00dbna z\u00e1lagur po\u2019