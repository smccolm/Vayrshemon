 p\u00e1n nilommarjo\u00d9 gaktrivizya kojowya."}]},{"blockId":"block.38826aabd9d648d1b44dabcbbdcf950d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.743","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Prod"}]},{"blockId":"block.9dd254fa69004a7d9fcc65ff78f83ec4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.748","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"prod: ton k\u00e3m l\u00e1m\u2019m\u00e7 ens\u00e1b\u00eb\u2019en."}]},{"blockId":"block.f6ab5853cee147aea53a1bbca41368ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.780","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka zi jo\u00d9thren ma\u2019o\u00c3owfu zi meranmiktaz\u00d7rs\u00dflum\u2019i tarenget prodizya."}]},{"blockId":"block.b9464b5dc32f4a36b26cb71a2cbe3d56","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.851","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"lamprod: gren vesna\u2019i lamprod lamprod\u2019en."}]},{"blockId":"block.5c5164b8430c41c28e68922bade7a812","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.893","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za yib\u2019\u00ebw neksus y\u00eblyemar s\u00c7fizya venim meranmiktaz\u00d7rs\u00dflumget lamprodizya \u00e3\u00d1 y\u00eblyemarget \u00e5\u00c3 ziel f\u00c5wizya."}]},{"blockId":"block.6006925415d14dd7aa3f7e7f629afadb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.999","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00d3\u00cf\u00cb\u00e9\u00d1: t\u00d7 venor k\u00e3m l\u00e1m\u2019m\u00e7 \u00e7zt\u2019en."}]},{"blockId":"block.314789590fbb4294bdc73f794bbc132e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1034","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 horen zem nilom jemin\u2019m\u00e7 r\u00d7izya \u00d3\u00cf\u00cb\u00e9\u00d1izya."}]},{"blockId":"block.001c42e1e5dc4ab287d542dccdb75c2e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1080","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pisen"}]},{"blockId":"block.b578123191114ad784c7a369ef649741","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1086","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"pisen: pi vin far\u2019m\u00e7 \u00d1et fradowya."}]},{"blockId":"block.9dd7610baef94c2bb8d41d39e9bd461b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1121","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin y\u00eblyemar\u2019i zarviminolen j\u00cdenizya kinem r\u00c7n\u00d3 pisen plestimizya."}]},{"blockId":"block.7177c813055843f4b015c0bdd8c8f462","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1188","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"d\u00d7lis: pisen vin h\u00c5b\u00cdowya falib komna\u2019m\u00e7 t\u00cdn gimol a\u00d9zizya \u00e3\u00d1 r\u00c7n\u00d3 zi tav ma\u2019giktenv\u00d7\u2019jw\u00ebnowya."}]},{"blockId":"block.3eef57277e114914a373b2a7a7b60bf4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1284","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Kr\u00c5v\u00ebm zi\u2019harenfelen wemizya. R\u00c7n\u00d3 d\u00d7lis za hahaizya. Za\u2019palil komna\u2019m\u00e7 t\u00cdn gimol a\u00d9zizya. Venalun p\u00e1n zi n\u00d7nizfu."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking