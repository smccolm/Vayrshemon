nt":{"document":{"schemaVersion":"0.1.0","documentId":"document.thesaurus.letter","revision":0,"title":"Joy and pleasure","layoutProfile":"layout.qt-6.8.3-m2","languageRevision":null,"fonts":[{"fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","sha256":"a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc","faceIndex":0}],"styles":[{"styleId":"style.body","fontId":"font:a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc:0","fontSizeMicroPoints":"26000000","lineHeight":{"mode":"exact","microPoints":"18000000"},"color":"#111111FF"}],"pages":[{"pageId":"page.1","widthMicroPoints":"486000000","heightMicroPoints":"673000000","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"486000000","heightMicroPoints":"673000000","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.1","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Govis i tonun r\u00c7n\u00d3 thavvim\u2019m\u00e7 eznaun"}]},{"blockId":"block.5eb74631130144cabc55ceef4d3dc9ff","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.37","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pisen"}]},{"blockId":"block.c351fcde0e064f9a99602c47a5cf1eab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.43","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"ivr\u00d7: pisen vin vorn\u2019m\u00e7 lofmel ni h\u00eb\u00d5\u2019na h\u00c5b\u00cdpomimowya \u00e3\u00d1 vesna falib po s\u00eb\u00dbgaizya thav r\u00d7owya."}]},{"blockId":"block.57f0900780d343dabaec0885cdc92c6d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.139","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni nem i merlunor r\u00e1\u2019ivr\u00d7 t\u00e7lizya. Ven r\u00e1 h\u00c5b\u00cdizya horib vorn\u2019m\u00e7 salena \u00d3\u00c5tusol yems\u00d7slebs\u00ebnalun tarenizfu. Za ni meranmerthrenjo\u00d9shal r\u00d7izya."}]},{"blockId":"block.86ced8efbe124a378796ad8d2f7d28ef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.282","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"pisensem: far\u2019m\u00e7 \u00d1et pisens\u00c7f\u2019en."}]},{"blockId":"block.f8143479bf6649f1a15d92d7c7bc71c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.316","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Za tha her\u00db i tremborel ni za\u2019tremb\u00c5ret pisensem \u00e7ztizya."}]},{"blockId":"block.01bf4f692d784e1bb99596eedd4cb71f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.374","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"pi: pisen ni ef\u2019haha r\u00c7n\u00d3 vesnaun."}]},{"blockId":"block.b3422e5312fb484ab40ad32e4eea6955","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.409","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Aleth tha merthren ly pi ni zem\u2019klojvor j\u00cdizya."}]},{"blockId":"block.08202845a09e41c4aa2da6609e3dfd9b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.457","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pisen gren ub\u00e1nt\u00e9v lomih ni giktenv\u00d7j\u00cden"}]},{"blockId":"block.c13efe661033472a85c528e2106e2984","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.498","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"far\u00d3em: pisen \u00cbers tom dlenson\u00ebw gl\u00c9st\u2019en."}]},{"blockId":"block.2763ac8401de41a08e4864f6235703bb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.541","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Tha vesna h\u00eb\u00d5 i kinem za far\u00d3emizya \u00e3\u00d1 r\u00e1 vemyib\u2019\u00ebw o\u00c3izya."}]},{"blockId":"block.9d9ab81ae535484c84b398f74946bd59","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.601","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kerfar\u00d3em: tom \u00c5el\u2019en \u00e3\u00d1 kerun gl\u00c9st\u2019en."}]},{"blockId":"block.bf8848b9796d4a72b91c3333165bff05","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.642","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel kerfar\u00d3emizya vinto stras i b\u00e9rvlen\u2019m\u00e7 ker slefy\u2019m\u00e7 r\u00d7izya."}]},{"blockId":"block.c7336970455c4bff93d8799efefc7722","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.706","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"haha: pisen ni giktenv\u00d7j\u00cden \u00d1on\u00d1 thar."}]},{"blockId":"block.b2fad3ce63e747229db05fd78d2c23c4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.745","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebthin dar r\u00e1 zemget ma\u2019o\u00c3\u2019jw\u00ebnizya p\u00c7n\u00df\u00eb j\u00cdizya k\u00e3nib zem hahaizya."}]},{"blockId":"block.5bba3f03ac5747a5a731c34c54e7952e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.814","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pom"}]},{"blockId":"block.af6acf5577df42b7960b765f349c750d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.818","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"pom: p\u00e1f\u00d7\u2019m\u00e7 h\u00c5b\u00cden ze\u00db\u00e7\u2019en."}]},{"blockId":"block.a063fbf25c2f4e7699a9759c7b23ac94","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.847","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth venik goryemmarinun zi meranjem\u00e3\u2019i denun pomizya."}]},{"blockId":"block.d3247b2465284181848a47c0e4a0f9e0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.902","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jemai: da\u00c3 pom\u2019en vin vesna\u2019i tremb\u00c5r f\u00e7sowya \u00e5\u00c3 m\u00d7s\u2019en \u00e3\u00d1 k\u00cfba\u00d1\u2019m\u00e7 tremb\u00c5r ilna\u2019m\u00e7 da\u00c3 vemyib\u2019\u00ebw jem\u00e3owya."}]},{"blockId":"block.b907efae02f3477f98bfcfea7b2bb0c6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1010","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin zi\u2019tremb\u00c5rjel thav \u00c3\u00cdizya r\u00e1 neks z\u00ebrelget jemaiizya. Thavvimna thirilviminolen ilna\u2019m\u00e7 gimkin dlen\u00dbeminizya."}]},{"blockId":"block.e1d68e5c64a14d6d9ea3c565ade21781","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1124","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"savrin: k\u00cfba\u00d1\u2019m\u00e7 murlametw\u00c5vum fij\u00ddyl\u2019jw\u00ebn\u2019en vinel tremb\u00c5r velin ilna\u2019m\u00e7 murlametw\u00c5vum a\u00d9owya."}]},{"blockId":"block.f63b80f15068454f9ebefd33c5621632","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1220","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"R\u00e1 elyi\u00d1 i yems\u00d7slebs\u00ebnalget savrinizya. R\u00e1 s\u00eb\u00dbga\u2019jw\u00ebnizya horib yems\u00d7 ni r\u00e1\u2019ub\u00e1nt\u00e9v ner\u00c3\u00cdizya \u00e3\u00d1 velin yems\u00d7\u2019m\u00e7 z\u00e1lin sezif\u00c7\u00c3izya."}]},{"blockId":"block.24535a15bdd54b59a5d0b1defce748e5","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1352","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tar\u00d5tavtondapom: \u00cbers tavtonda tonun tar\u00d5\u2019en."}]},{"blockId":"block.d93a41b8d2054db0b9a5fda50f78eb87","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1398","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Pel prodw\u00cf\u00dfget tar\u00d5tavtondapomizya p\u00e1n po\u2019ezna h\u00c5b\u00cdpomizya."}]},{"blockId":"block.a4677bfbca2e4c3eb7b005601e353f68","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1458","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"h\u00c5b\u00cdpom: ezna h\u00c5b\u00cdpom\u2019en."}]},{"blockId":"block.73230d3dbf6a42b3add4f1d7bdb46a44","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1484","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin za \u00d3\u00c5tus jo\u00d9l\u00dfnilun k\u00e3menizya za horib y\u00eblyemar elyi\u00d1izya h\u00c5b\u00cdpomizya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":42,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":43,"end":138,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":139,"end":281,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":282,"end":315,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":316,"end":373,"attributes":{"tracking":0,"wordSpa