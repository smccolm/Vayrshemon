396","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.57","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"wa\u00d9gum: vinto \u00d1et fradowya dlen\u00dbemin\u2019en."}]},{"blockId":"block.238ad108c4a6478ab9d0088062fa68ef","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.98","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni daral za vinto zarviminolen j\u00cdenizya wa\u00d9gumizya."}]},{"blockId":"block.b57b23fcb2d14023bc57445ba984efe0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.150","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"nel\u00e7\u00d3: far\u2019m\u00e7 p\u00e1f\u00d7j\u00cdtonda t\u00d7 ol paven h\u00c5b\u00cdimowya p\u00c7n\u00df\u00eb velin t\u00d7 jelam i k\u00cfba\u00d1\u2019m\u00e7 a\u00d9zna\u2019m\u00e7 s\u00dflum wa\u00d9gum\u2019en."}]},{"blockId":"block.fa28cbf186ef4a10b03e00cc80b555bb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.257","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Z\u00e1lagur zarviminolen j\u00cdenizya t\u00d7 sezif\u00c7\u00c3 i y\u00eblyemar. Ni daral pala velin nel\u00e7\u00d3izya vinto h\u00eb\u00d5\u2019na pel tha y\u00eblyemar vel\u00c3\u00cdizya."}]},{"blockId":"block.b9d00c7d5ccc446c9ae4fab2731358e2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.381","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"r\u00ebven: t\u00d7 vesna wa\u00d9gum\u2019en \u00e3\u00d1 ni neks \u00e3lum vesna \u00d3\u00c5\u00e7\u2019en jama\u2019en kom vesna vut\u2019jw\u00ebnowya."}]},{"blockId":"block.2344ee4834a345a2b7802bdde449a8c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.468","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00c2\u00cde \u00e3\u00d1 se\u00dbe. R\u00e1 r\u00ebvenatya. P\u00e1n r\u00e1 daral \u00c5elatya nel zi\u2019den j\u00cdatya."}]},{"blockId":"block.eb7cef9727f74911a14ef63ed8476998","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.535","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"dlen\u00dbemin: ni ilna\u2019m\u00e7 \u00e7l\u00d7on dlen\u00dbemin\u2019en."}]},{"blockId":"block.c2db4189caba4aefbc166fc0514d073f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.577","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth ol vesnaun \u00c3\u00cdthavizya neksus b\u00d7\u00c7rborel gren klojvor dlen\u00dbeminizya."}]},{"blockId":"block.33b346ec5b314be18cb4693d8211da86","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.649","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"h\u00ebthven: f\u00d7venor \u00e5\u00c3 h\u00ebthven\u2019m\u00e7 venor da\u00c3\u2019en."}]},{"blockId":"block.e58d503c08394e2d8950c373c0285bd3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.694","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinto tonmel mayems\u2019m\u00e7 gim\u00cba\u00d5izya \u00ddvs\u00dflum \u00ddvtonget denlamet\u2019en h\u00ebthvenizya."}]},{"blockId":"block.c43f67d56c704b84810984e70769124a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.770","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gr\u00c9t"}]},{"blockId":"block.73793ec80a174c53a4a6c9ae73a86ceb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.775","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gr\u00c9t: \u00cbers memvor ika\u00d9\u2019en."}]},{"blockId":"block.01f31213d1f54cde88eadc9409d54bcb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.802","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Grel olir v\u00dfrmel gr\u00c9timizya \u00e3\u00d1 nil\u00ebm renizya."}]},{"blockId":"block.bf49b618f7924790a3c73feeff9b8fd7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.848","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gr\u00c9trul: \u00cbers tavtonda i nerda\u00c3\u2019en vimin\u2019m\u00e7 threninun a\u00d9\u2019en."}]},{"blockId":"block.af5efac2a61e45729debdcae4ce8e431","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.909","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Etni \u00d3\u00c5tus kwestaun za nelget gr\u00c9trulizya vinto thenthren dlen\u00dbeminizya."}]},{"blockId":"block.54df4c97ecb7444cbe26a09a15ddc0fe","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.982","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Grij"}]},{"blockId":"block.60e76589793e45f98c513da36ddcd08c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.987","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grij: h\u00eb ka \u00d5\u00dfrna\u2019m\u00e7 \u00d1et n\u00d7nowya."}]},{"blockId":"block.6693a8086051476c9336ab6c963a3473","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1021","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00e9zniv pelna\u2019m\u00e7 y\u00eblverzetget grijizya."}]},{"blockId":"block.ff9baad1697349b6956a56716c05f382","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1060","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murgrij: s\u00dflum marin l