yrimizya."}]},{"blockId":"block.6857bb233467479f8e8f76971e2abcd1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.403","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"D\u00c7\u00d3 \u00e5\u00c3 vennerb"}]},{"blockId":"block.05daf0a4c5004355abafeaf34528040e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.418","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kelde\u00dbon: lomib falnthren r\u00d7\u2019jw\u00ebnowya t\u00d7y\u00dfb\u00dfkelde\u00dbon\u2019en."}]},{"blockId":"block.6c3c19e6c62b4100a7b10c50395a01e8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.475","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Veneks y\u00cd\u00d7 r\u00e1 dar\u00c5elget onega\u2019en kelde\u00dbonizya."}]},{"blockId":"block.77fe882363994722869039f7014d763e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.522","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kelde\u00dbonjw\u00ebnen: r\u00c7n\u00d3 jw\u00ebnenplesten thrin jw\u00ebnenplestenlen d\u00c7\u00d3\u2019en."}]},{"blockId":"block.19f5a6c1afdc47a3a42156d94e4da880","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.588","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thrin ol\u2019m\u00e7 vernil \u00d3\u00c5tusol selinun \u00e5\u00c3 farenget tav \u00c5el\u2019en kelde\u00dbonjw\u00ebnenizya."}]},{"blockId":"block.b3077c35ffa04a3c8520f3e47d7ed76c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.666","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Den \u00cbers \u00d1etib \u00d1et h\u00c5b\u00cdimowya"}]},{"blockId":"block.132ea7cafd09447d8966ccc13a0b3210","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.696","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jelam: den tha \u00d1etib vesna \u00d1et h\u00c5b\u00cdimowya."}]},{"blockId":"block.be27f83d64e948d7bc6d72f9ebb985c1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.739","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"N\u00ebr\u2019m\u00e7 threnin i y\u00ebletun gren merthren jelam i naor\u2019m\u00e7 yems\u00d7 r\u00d7izya."}]},{"blockId":"block.c9209f4078dc40eeae2bd2e946a73b82","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.808","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"den: \u00d1et k\u00e3m jelam etni s\u00dflumun f\u00c5wimowya."}]},{"blockId":"block.36358dad78fb46b794942275330d9faa","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.851","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"K\u00e3m den i sezif\u00c7\u00c3 za vesna \u00d3\u00c5tusthrenin i jw\u00ebnenplesten shalen f\u00c5wizya."}]},{"blockId":"block.f0da070df9c5411eb44653c6b9fd4a8e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.923","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"jelden: den \u00cbers \u00d1etib tremb\u00c5r h\u00c5b\u00cdowya falib \u00d1et a\u00d9izya venka omi den ma\u2019o\u00c3\u2019jw\u00ebnowya."}]},{"blockId":"block.5d9d5214b83f43c9b8b010b13c0f13af","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1010","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ol l\u00c7m tha kular l\u00c7m\u00c5\u00d9b\u00d7rvimizfu. Marin veritas\u2019en za pala\u2019i kular \u00cbers jelden grel thren h\u00c5b\u00cdizya."}]},{"blockId":"block.0d8e1c8cf2c54b988371d7f4e2a1b157","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1110","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"v\u00d7dlehmjelam: o\u00c3jw\u00ebn\u2019m\u00e7 den i neksus gur."}]},{"blockId":"block.398d4de3591b4d5699337bd9d15301c7","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1152","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni nabyems yib\u2019\u00ebw \u00cbers po\u2019v\u00d7dlehmjelam ly ly\u2019r\u00c7n\u00d3vem h\u00c5b\u00cd\u2019jw\u00ebnizya."}]},{"blockId":"block.1ca706b03abe4cce9c3a5861ea664111","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1220","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Den \u00cbers \u00d1etib pavenna tar\u00d5imowya"}]},{"blockId":"block.c9d76f8a2bd648ffa9f7fab30c061496","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1254","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"dentar\u00d5: \u00d1et jem\u00e3imowya kom s\u00dflum tar\u00d5owya."}]},{"blockId":"block.08549a81848d44d7947b03330fc0fcda","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1298","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vorn\u2019m\u00e7 b\u00d7\u00c7rborel k\u00e3m dentar\u00d5 i neks goryemmarin ni goren\u2019m\u00e7 kinem zarnizya."}]},{"blockId":"block.988e3300b28f4b9893e0a90be0ca3e2e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1375","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"tar\u00d5kwesta: venor\u2019m\u00e7 d\u00c7\u00d3 \u00d1etib tar\u00d5 p\u00e1n s\u00dflum jem\u00e3owya."}]},{"blockId":"block.9428a1a35fb54fb28f9e49297d901145","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1431","languageId":"language.vayrshemon","styleId":"style.body","