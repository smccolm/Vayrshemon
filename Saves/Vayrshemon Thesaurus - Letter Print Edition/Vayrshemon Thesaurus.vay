fl\u00dfnget r\u00d7izya. R\u00e1 p\u00e1tondaizya. Ly\u2019falns\u00dfluml\u00c9y ef\u2019eni\u00d1\u00d7get yib\u2019\u00ebw gim\u00cba\u00d5owfu.","translation":"Our-play(nom.) \u00b7 end(prs.,perf.). Our-actors(nom.) \u00b7 shade-form(th.,acc.) \u00b7 be(pst.,simp.). I(sg.) \u00b7 foretell(pst.,simp.). Our-actors(nom.) \u00b7 breath(n.,acc.) \u00b7 only \u00b7 become(prs.,perf.).","transliteration":"","rawGloss":"Our-play(nom.) \u00b7 end(prs.,perf.). Our-actors(nom.) \u00b7 shade-form(th.,acc.) \u00b7 be(pst.,simp.). I(sg.) \u00b7 foretell(pst.,simp.). Our-actors(nom.) \u00b7 breath(n.,acc.) \u00b7 only \u00b7 become(prs.,perf.).","orthographyId":"thimfora-79","sourceFonts":["a9bb4075285df9acf2bf75c08446d44cfd83b29f6940937671cc07bd68f9f6cc"],"tokens":[{"start":0,"end":10,"surface":"Ly\u2019falnl\u00c9y","morphemes":["Ly\u2019falnl\u00c9y"],"glosses":["Our-play(nom.)"],"entryIds":["m8.ourplay"],"senseIds":["m8.ourplay.sense1"],"morphologyIds":[],"status":"draft"},{"start":11,"end":18,"surface":"f\u00e7sowfu","morphemes":["f\u00e7sowfu"],"glosses":["end(prs.,perf.)"],"entryIds":["m8.cease"],"senseIds":["m8.cease.sense1"],"morphologyIds":[],"status":"draft"},{"start":20,"end":35,"surface":"Ly\u2019falns\u00dfluml\u00c9y","morphemes":["Ly\u2019falns\u00dfluml\u00c9y"],"glosses":["Our-actors(nom.)"],"entryIds":["m8.ouractors"],"senseIds":["m8.ouractors.sense1"],"morphologyIds":[],"status":"draft"},{"start":36,"end":52,"surface":"g\u00df\u00d1et\u2019swifl\u00dfnget","morphemes":["g\u00df\u00d1et\u2019swifl\u00dfnget"],"glosses":["shade-form(th.,acc.)"],"entryIds":["m8.spirit"],"senseIds":["m8.spirit.sense1"],"morphologyIds":[],"status":"draft"},{"start":53,"end":59,"surface":"r\u00d7izya","morphemes":["r\u00d7izya"],"glosses":["be(pst.,simp.)"],"entryIds":["forge.be"],"senseIds":["forge.be.sense1"],"morphologyIds":[],"status":"draft"},{"start":61,"end":63,"surface":"R\u00e1","morphemes":["R\u00e1"],"glosses":["I(sg.)"],"entryIds":["forge.I"],"senseIds":["forge.I.sen