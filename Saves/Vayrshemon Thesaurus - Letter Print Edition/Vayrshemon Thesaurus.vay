25","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka nabyems za kwist\u00e7l\u00d7on \u00c5el\u2019en \u00c3ahizya."}]},{"blockId":"block.6619787d64db45ddbfec29032c4a2df3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.169","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"ga\u00d3ren: t\u00d7 makin\u2019m\u00e7 s\u00dflum lam tonda\u2019en vin makin\u2019m\u00e7 s\u00dflum broft ma\u2019f\u00c5w\u2019jw\u00ebnizya."}]},{"blockId":"block.81bd32e4fa2e4bd5a92ca56556acefa3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.250","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vinel drig\u00e1ls\u00dflumun ni goryems r\u00d7izya h\u00c5b\u00cdtorpgur ni zem\u2019den p\u00e1f\u00d7\u2019m\u00e7 kwistvar\u00dfnv\u00df\u00d5get ga\u00d3renizya."}]},{"blockId":"block.c7fa0958563c4cbc88ff33602528a39f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.348","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00c5wmarvenen: k\u00cfba\u00d1\u2019m\u00e7 jw\u00ebnen \u00e5\u00c3 vesna t\u00d7 falnthren f\u00c5w\u2019en."}]},{"blockId":"block.bd5ef02e90c541d280033a055227f19a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.407","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e4\u00c3 giktenv\u00d7\u2019en ni zem\u2019den vorns\u00dflumun neksus gaz\u00e9ms\u00dflumget f\u00c5wmarvenenizya."}]},{"blockId":"block.98ef2070c88f47c1995578642f3aec0c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.483","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vesna\u2019i minlam grelna\u2019m\u00e7 nerbw\u00c5vumen\u2019en"}]},{"blockId":"block.9e1f6c3b12854a00b51567f6c295cfe6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.523","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"grelnaw\u00c5vum: w\u00c5vumen ka vesna minlam mavsifowya."}]},{"blockId":"block.b18bb6cc333f4cddbc7d9d9bfee73685","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.572","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi\u2019grelnaw\u00c5vum t\u00d7 d\u00c7\u00d3 slefy\u2019m\u00e7 r\u00d7izya aleth p\u00e1n zi po kelde\u00dbonizya."}]},{"blockId":"block.0552a1ffbdf24af6ac326c11ca6f8e7f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.640","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"lofna: grelnaw\u00c5vum \u00cbers ef\u2019haha gl\u00c9stimowya."}]},{"blockId":"block.41466009a3b24bb49316edf2d5943a7b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.685","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin jem\u00e3s\u00dflum zyrizya dlen\u2019m\u00e7 taren sulmar\u2019i lofna broftizya."}]},{"blockId":"block.569be7c14dc442f69770236f65c6927c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.747","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vimin\u2019m\u00e7 venor"}]},{"blockId":"block.ef90613c555e488298a8e1c988d6c7d1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.762","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00dfrn: t\u00d7 vimin\u2019m\u00e7 venor h\u00eb\u00d5\u2019na\u2019en."}]},{"blockId":"block.86de480005dd4e2daa5eb83bb9d4cd9c","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.797","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zem\u2019s\u00dfrn\u2019m\u00e7 tw\u00ddnjybgiktenv\u00d7 etni \u00d3\u00c5tus zarviminolenun grasnotizya."}]},{"blockId":"block.70c0531c4ca14c55ac85bf52fa8d0852","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.864","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00dfrnvenorna: t\u00d7 neksus s\u00dfrnvenor vemyib\u2019\u00ebw."}]},{"blockId":"block.526011a128a94b078f57e5f3210754a2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.908","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00caers s\u00dfrnvenorna\u2019m\u00e7 b\u00d7\u00c7r i nab\u00e7or ly thavim\u2019m\u00e7 merthren o\u00c3izya."}]},{"blockId":"block.dfecbbb7a7ed4c00b64f352104a6130f","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.972","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vimin\u2019m\u00e7 mayems\u2019m\u00e7 threninun"}]},{"blockId":"block.26b339d3d97545cebb5f50b47c3f3ebb","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1001","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"thren: vimin\u2019m\u00e7 mayems\u2019m\u00e7 threninun gren \u00d1et."}]},{"blockId":"block.74f46331d3b54118a4c81bf4b237651e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1047","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth velf\u00ebr marin nabyems thren gren elenol y\u00eblet dlenizya."}]},{"blockId":"block.e03637bd0c7941cfaf3953c0ab5eb398","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1107","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"gr\u00c9trulthren: threninun \u00d1etib \u00cbers gr\u00c9trul\u2019en a\u00d9imowya."}]},{"blockId":"block.971cbcd300eb4754b4f7e6a248dbfb1c","type":"paragraph","direct