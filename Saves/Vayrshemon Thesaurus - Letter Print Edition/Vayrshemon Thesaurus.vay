0d7\u00dbem f\u00d7izya."}]},{"blockId":"block.a46f2dfd1a674386831a9e52db21a8c0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.158","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni meranmerthrenjo\u00d9shal za far\u00d3emizya. Yib\u2019\u00ebw vin za \u00d3\u00c5tusol yems\u00d7slebs\u00ebnalun onegaizya z\u00e1linmemvor t\u00e7lizya."}]},{"blockId":"block.2310cecf6d2d436fb2a4df8af7c24f84","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.267","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"veskar: h\u00ebth vesna \u00c3\u00cdthavowya \u00c9lm t\u00d7 ir \u00d1etib r\u00c7n\u00d3 vesna vemyib\u2019\u00ebw \u00d5\u00dfrizya."}]},{"blockId":"block.6aa98071d3da4739b4537002f9c92fd9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.343","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 r\u00e1\u2019marven r\u00e1 ma\u2019\u00c9lmizya. R\u00e1\u2019veskar t\u00d7 pel falib r\u00c7n\u00d3 zi elenol w\u00cf\u00dfen w\u00cf\u00df\u2019jw\u00ebnizya r\u00d7izya."}]},{"blockId":"block.3c75da8fb5f24a5db68e15b4b0991500","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.436","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"n\u00d7nenw\u00e9asem: w\u00e9asem h\u00ebth n\u00d7nen."}]},{"blockId":"block.5f367967b5e844f08a5502aeeb434603","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.468","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thrin p\u00c9rsus yelun i n\u00d7nenw\u00e9asem z\u00e1l dlenson\u2019m\u00e7 dlen\u00dbeminizya."}]},{"blockId":"block.c53469ab4e934512a939c3af4f763d5d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.531","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"n\u00d7nsemtonda: w\u00e9asem ni tonun giktenv\u00d7\u2019en."}]},{"blockId":"block.fc62776f10d14bbd86244d5703b408c6","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.573","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni masif\u2019m\u00e7 meranmerthrenjo\u00d9shal za b\u00e9rvlen\u2019m\u00e7 y\u00eblyemarget n\u00d7nsemtondaizya."}]},{"blockId":"block.cc9597e03023411e834ac98b2f91ae03","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.649","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"murvor durun: goren\u2019m\u00e7 murvor i vor lomih w\u00c5vumen."}]},{"blockId":"block.940cb61b6c5d4d2480525a6115f41292","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.700","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thrin \u00c5\u00d9gif ni murvor durun za e\u00d3\u00c7raizya t\u00d7 palen ka ma\u2019t\u00e7lizya."}]},{"blockId":"block.e4316c332ec747e1a05dc100f53a2cea","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.765","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00e9asem tha s\u00dflum onegaimowya"}]},{"blockId":"block.dd95f4db54824123a4eff8ebec4652ce","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.794","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"venel: w\u00e9asem ni w\u00c5vumen vimar\u2019m\u00e7 gim\u00cba\u00d5owya."}]},{"blockId":"block.77823cddf7a642f7959b95bf42d638c1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.840","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Ni j\u00cden i h\u00c5b\u00cd\u2019m\u00e7 giktenv\u00d7j\u00cden ni nov\u00ebl goren\u2019m\u00e7 venel t\u00e7lizya na y\u00eblyemard\u00c7\u00d3s\u00dflum."}]},{"blockId":"block.8c60f265bbf747b385d2958823730d1b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.924","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"maserkinem: tha targl\u00c9z\u00cben \u00c5el\u2019m\u00e7 marjo\u00d9 t\u00d7y\u00dfb\u00dfimowya."}]},{"blockId":"block.58a3118d630f49b9a9e577dfd263e63a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.979","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Vin daral \u00c5elimizya \u00e3\u00d1 z\u00e1ls\u00dflum thrin\u00c3\u00cd\u2019jw\u00ebnizya ni h\u00eb\u00d5\u2019na zem\u2019maserkinem t\u00e7lizya."}]},{"blockId":"block.4b7623a1689f4ace805d4478b1bdac02","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1062","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00e9asem ni vor \u00e3\u00d1 giktenv\u00d7j\u00cden"}]},{"blockId":"block.2cda373b2ab1413295bda1cef830dab8","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1092","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"yemsen: yems\u00d7 tha omiun gaktrivowya."}]},{"blockId":"block.2b04cccfcb814c54985bc9a0d9f10122","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1129","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Marin j\u00cden za yemsenizya nira za\u2019felen."}]},{"blockId":"block.af74d3a9effa43d985f56d4244be891e","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1169","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"yemsinineni\u00d1\u00d7: ni ef\u2019yemsen eni\u00d1\u00d7 ika\u00d9owya."}]},{"blockId":"block.4b1b7d38e2204b42b8202054789a26e0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1213",