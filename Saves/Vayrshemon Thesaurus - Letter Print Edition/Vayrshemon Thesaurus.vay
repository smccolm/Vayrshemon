ody","type":"unicode","normalization":"none","text":"Kom f\u00c5wjem\u00e3\u2019m\u00e7 r\u00d7izya zi ka plesten\u2019m\u00e7 gorenborel thavvim t\u00e9z\u2019m\u00e7 zarun jem\u00e3izya."}]},{"blockId":"block.aa92b6b822ca4b3481d5e5fb0ff199fd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.333","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"minemvor\u00c9lm: vesna\u2019i minem t\u00d7 ir \u00c9lmowya."}]},{"blockId":"block.4386a6e2a54a41ba846c647dc0a4d870","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.375","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Zi\u2019k\u00cfba\u00d1\u2019m\u00e7 gorenborel plesten\u2019m\u00e7 r\u00d7izya. Velin r\u00c7n\u00d3 minemvor\u00c9lm\u2019m\u00e7 omi thavvims\u00dflum\u2019i gorenborel zi veritasizya."}]},{"blockId":"block.933664ade0d149a1bfd256c8bc50a3cd","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.489","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00c8lm \u00e3\u00d1 mar i ilna \u00c9lm s\u00dflum"}]},{"blockId":"block.b7e918d1b08f4b9fa0f5a66685fd424b","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.517","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"zhemir: vesna\u2019i far \u00c9lm\u2019en."}]},{"blockId":"block.1370e61b4284468e99c4006873a94ec2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.545","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Venka zi\u2019m\u00c5rum masif\u2019m\u00e7 ma\u2019r\u00d7izya zi thavvims\u00dflumget t\u00d7 y\u00cd\u00d7goren\u2019m\u00e7 then m\u00c5rum zhemirizya."}]},{"blockId":"block.0e643eda56c54753bf478a56df7d4904","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.636","languageId":"language.vayrshemon","styl