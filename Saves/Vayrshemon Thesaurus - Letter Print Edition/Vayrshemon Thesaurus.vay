eadword":"Pip\u00c9sem","id":"terms.t0.r26","ipa":"","label":"Phrase","notes":"Original cells and direct font-family hints retained. Exact historical face/orthography unresolved. Parallel chart versions are not merged.","orthographyId":null,"partOfSpeech":"","pronunciation":"Pip\u00c9sem","senses":[{"citations":[{"locator":"table 0, row 26; 3 cells: English / script / transliteration (zero-based)","sourceId":"terms"}],"definition":"Phrase","id":"terms.t0.r26.sense1","status":"attested"}],"status":"attested","variants":[{"note":"Verbatim script cell","script":"archived script slots","sourceFonts":["transliteration 5"],"text":"Pip\u00c9sem"},{"note":"Verbatim transliteration cell; not IPA","script":"archived transliteration slots","sourceFonts":["test seven"],"text":"Pip\u00c9sem"}]},"0bb03459a39839bd6028cd04e5c8153fd4f09c807313314ce898edbaca1377e7":{"audioLinks":[],"citations":[{"locator":"table 0, row 27; 3 cells: English / script / transliteration (zero-based)","sourceId":"terms"}],"etymology":"","exampleIds":[],"headword":"K\u00d7gw\u00c9d","id":"terms.t0.r27","ipa":"","label":"Sentence","notes":"Original cells and direct font-family hints retained. Exact historical face/orthography unresolved. Parallel chart versions are not merged.","orthographyId":null,"partOfSpeech":"","pronunciation":"K\u00d7gw\u00c9d","senses":[{"citations":[{"locator":"table 0, row 27; 3 cells: English / script / transliteration (zero-based)","sourceId":"terms"}],"definition":"Sentence","id":"terms.t0.r27.sense1","status":"attested"}],"status":"attested","variants":[{"note":"Verbatim script cell","script":"archived script slots","sourceFonts":["transliteration 5"],"text":"K\u00d7gw\u00c9d"},{"note":"Verbatim transliteration cell; not IPA","script":"archived transliteration slots","sourceFonts":["test seven"],"text":"K\u00d7gw\u00c9d"}]},"2b38bc478cf8ad3a27cc55f6307cf8f6fa26d4260a3a09bcd372b1561ac41878":{"audioLinks":[],"citations":[{"locator":"table 0, row 28; 3 cells: English / script / tr