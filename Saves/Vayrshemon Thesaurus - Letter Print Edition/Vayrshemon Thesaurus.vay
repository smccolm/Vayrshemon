code","normalization":"none","text":"\u00e4v\u00d1et t\u00d7 d\u00c7\u00d3 f\u00c5w\u2019en"}]},{"blockId":"block.46f67c7a3cc142b688bd1a13c7e9a1ae","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.77","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"p\u00e1ns\u00ebnf\u00c5w: \u00d1etib f\u00ebr\u00d3imowya f\u00c5w\u2019en."}]},{"blockId":"block.f9163b369da242adb41c0ab225afc236","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.113","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 elen z\u00e1l h\u00c5b\u00cdtorpgur yat\u2019m\u00e7 yems\u00d7get p\u00e1ns\u00ebnf\u00c5wizya."}]},{"blockId":"block.09fd7c9c4bc943f391f8efcc084f8184","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.168","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"kilas: t\u00d7 s\u00dflum velin mah\u00c5b\u00cd\u2019m\u00e7 inst\u00dfb\u00df jem\u00e3\u2019en p\u00e1n m\u00d7s w\u00cf\u00dfimowya."}]},{"blockId":"block.9c5f5a9be9eb4624bc13e54499c1e2ed","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.235","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n y\u00eblyemarr\u00ddy\u00d3s\u00dflumun t\u00e7lizya t\u00d7 elen goryemmarin zem t\u00d7 neksus y\u00cd\u00d7 s\u00dflum kinem kilasizya. Mav zarvenborel \u00c5el\u2019jorizya."}]},{"blockId":"block.a2a4bd7a75ac48aab8156589cf1c1b27","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.357","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00db\u00d7var: ni f\u00ebr\u00d3 m\u00d7s f\u00c5w\u2019en \u00e3\u00d1 neksus l\u00e1m\u2019m\u00e7 nerbyal \u00e5\u00c3 s\u00dflum falib m\u00d7s mlapv\u00d7staowya f\u00c5w\u2019en."}]},{"blockId":"block.e44916a5dc1442f6a28a6bac3e48ec84","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.449","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Murvor\u2019m\u00e7 s\u00dflum z\u00e1l ma\u2019vut\u2019jw\u00ebnizya. Lym ziel \u00db\u00d7varizya. \u00d0etib z\u00e1l\u00c3\u00cdo\u00c3s\u00dflum neks ybs\u00dfatya zi nerbyalizya."}]},{"blockId":"block.e5a15cd35abd413f8cb8fce6a68514cf","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.555","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"pelur: t\u00d7 poms\u00dflum mem\u2019m\u00e7 y\u00ebl lomih venor vut\u2019en kom h\u00ebth k\u00cfba\u00d1\u2019m\u00e7 murlametw\u00c5vum ilna\u2019m\u00e7 d\u00c7\u00d3 fader\u2019jw\u00ebnowya."}]},{"blockId":"block.5a2c53cbf47a47ea96233330a23b9498","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.664","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Gren neks y\u00eblshalin a\u00d9s\u00dflum r\u00e1el pelurizya. Vin r\u00e1 threnin thrin\u00c3\u00cdizya mem\u2019m\u00e7 y\u00ebl t\u00d7 \u00d3\u00c5tus\u2019t dest\u00eb\u00c5 dlen\u00dbeminizya."}]},{"blockId":"block.97fda9f909ea4f8990321aef1996c12a","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.779","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"\u00e5v\u00d1etf\u00c5w: t\u00d7 d\u00c7\u00d3 d\u00c7\u00d3s\u00ebnalun f\u00c5w\u2019en."}]},{"blockId":"block.0b70ec5a99754240b76b36d2ff002d15","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.815","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 \u00c5\u00d9gif ni goryems zem viminmeranget r\u00c7n\u00d3 b\u00d7\u00c7rborel \u00e3\u00d1 thiril jw\u00ebnenplesten \u00e5v\u00d1etf\u00c5wizya."}]},{"blockId":"block.fa3c12856a1542a0bacbaa815964b6a0","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.906","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"plestf\u00c5w: \u00e7l\u00d7on r\u00c7n\u00d3 memil\u2019m\u00e7 t\u00d7 \u00e5v \u00d1etun plest\u2019en."}]},{"blockId":"block.06a32c0bddc54df0880946a6c34bba19","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.958","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"T\u00d7 z\u00e1l\u00c3\u00cdo\u00c3s\u00dflumun za kinemget r\u00c7n\u00d3 belen \u00e3\u00d1 klojvor plestf\u00c5wizya."}]},{"blockId":"block.d5d65ed1ccf749efb3a3ce16984c4dab","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1024","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"W\u00c5vum \u00e3\u00d1 nerbw\u00c5vumen"}]},{"blockId":"block.975435fede594c3da7657b2025254118","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1045","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"w\u00c5vum: w\u00c5vumen \u00e5\u00c3 \u00d1et elyi\u00d1\u2019en."}]},{"blockId":"block.ba4ab2e5521149b482f68044c978f2b2","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1077","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"Thrin \u00c5\u00d9gif za i za\u2019\u00ddvton venim ma\u2019grasnotimowfu w\u00c5vumizya."}]},{"blockId":"block.86ca5012e0354907ba21decfb56acad9","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1137","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"s\u00e3\u00d1plestenw\u00c5vum: horenun r\u00c7n\u00d3 o\u00c3jem memvor\u2019en."}]},{"blockId":"block.2e416350ab384e8b927c404d38fe611d","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1184","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"P\u00e1n denden\u2019en zi v\u00df\u00d5gimen \u00e3\u00d1 venor \u00d3\u00c5tusol s\u00e3\u00d1plestenw\u00c5vumizya."}]},{"blockId":"block.ee27af33420e40439038e0b87c323af1","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1248","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"f\u00d7nur: p\u00e1nna\u2019m\u00e7 falnthrenun tar\u00d5\u2019en \u00e3\u00d1 p\u00e1f\u00d7\u2019m\u00e7 falnthren \u00cbers poir nerbw\u00c5vumen\u2019en."}]},{"blockId":"block.97ee0a8e4bc348b782757b1f1968e833","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1331","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth lamf\u00ebrenun za velin braden \u00e5\u00c3 zi ma\u2019f\u00c5wizya. Venim vin zi z\u00ebrna m\u00d7sizya za f\u00d7nurizya \u00e3\u00d1 ziget farbroftizya."}]},{"blockId":"block.2a73e871efa04f0888e75a9a0ef640e3","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1444","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"nerbw\u00c5vumenh\u00eb\u00d5: h\u00ebth kelde\u00dbon nerbw\u00c5vumen ner\u00e7zt\u2019en."}]},{"blockId":"block.802a1f940e7a4de4a6fac69574ecb1b4","type":"paragraph","direction":"ltr","runs":[{"runId":"run.qt.1497","languageId":"language.vayrshemon","styleId":"style.body","type":"unicode","normalization":"none","text":"H\u00ebth elen dar\u00c5el kelde\u00dbonizya zi z\u00e1l masif\u2019m\u00e7 r\u00d7izya nerbw\u00c5vumenh\u00eb\u00d5izya."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true}},"characters":[{"start":0,"end":36,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":37,"end":56,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":57,"end":76,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":77,"end":112,"attributes":{"tracking":0,"wordSpacing":0.0,"bas