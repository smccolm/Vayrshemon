finition":"Ashes/cinders, residue of burning. Keeps the lovers\u2019 fire and urn connected without adding resurrection.","id":"shakespeare014.lex.ashes.sense","status":"draft"}],"status":"draft","variants":[]},"cb1d14f24ce9be733f862837b79d07c814e9edf5726505fe540da1412a8e7092":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"a\u00dbford","id":"shakespeare014.lex.ashford_kent_town","ipa":"","label":"ashford_kent_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ashford","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Kentish town from which York says John Cade comes.","id":"shakespeare014.lex.ashford_kent_town.sense","status":"draft"}],"status":"draft","variants":[]},"de0083c0d6e3ec24bc05cb15db3d88f6dd09a60a2e79ba89cac3c251edac56a6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_asia_acts","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_asia_acts","exampleIds":[],"headword":"asia","id":"shakespeare014.lex.asia_region","ipa":"","label":"asia_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"asia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Asia as the regional territory overrun in the messenger\u2019s report; not silently expanded to the whole modern continent or given Acts participants.","id":"shakespeare014.lex.asia_region.sense","status":"draft"}],"status":"draft","variants":[]},"970c8e6729b892178d44a64f1e3026e6a0ad2bcf2f838717db38606fed2611e0":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: side + look","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: side + look","exampleIds":[],"headword":"vorelveritas","id":"shakespeare014.lex.askance_look","ipa":"","label":"askance_look","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vorelveritas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Look obliquely or with averted regard, the speaker\u2019s treatment of truth in Sonnet 110. Native side-look; distinct from an actor\u2019s aside and not a claim about a permanent ocular condition.","id":"shakespeare014.lex.askance_look.sense","status":"draft"}],"status":"draft","variants":[]},"9ab24462f1cd2678c3482a4f1ae26dfd90ddebffff9eb555df447f361dd0e611":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"asmat","id":"shakespeare014.lex.asmath_spirit","ipa":"","label":"asmath_spirit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"asmat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The spirit whom Jourdain compels to answer.","id":"shakespeare014.lex.asmath_spirit.sense","status":"draft"}],"status":"draft","variants":[]},"3d04b02d6e030a84b3b40edc72843ddb3b1e063c8c7cfd5b74c4a8c171b92dae":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_asp","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_asp","exampleIds":[],"headword":"silj\u00d7n","id":"shakespeare014.lex.asp_serpent","ipa":"","label":"asp_serpent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"silj\u0113n","s