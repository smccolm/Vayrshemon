"#E4E9F0FF","styleId":"style.3a6e197999bea489"},{"fontId":"font:931c5de5c70401d9324d5014c123802b4fb753000360ceb2f56c589403cd58c5:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"exact","microPoints":"38000000"},"color":"#E4E9F0FF","styleId":"style.bafcb097b4f75dc4"},{"fontId":"font:931c5de5c70401d9324d5014c123802b4fb753000360ceb2f56c589403cd58c5:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"exact","microPoints":"38000000"},"color":"#E4E9F0FF","styleId":"style.archive-punctuation"}],"pages":[{"pageId":"page.1","widthMicroPoints":"339411255","heightMicroPoints":"992777921","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"339411255","heightMicroPoints":"992777921","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.54a715da11a34e018bd64e0a70f400b1","type":"paragraph","direction":"auto","runs":[{"runId":"run.0b6d234f9eaf4389a881d7e271cfa980","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"At length Castruccio, seeing how long the battle had lasted, and that both his men and the enemy were utterly exhausted,"}]},{"blockId":"block.79757876880e4081992da49a9c6b1e27","type":"paragraph","direction":"auto","runs":[{"runId":"run.e8bd65a3104340338519cfb1391e9e58","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"and that both sides had many killed and wounded, pushed forward another body of infantry to take up a position at the rear of those who were fighting;"}]},{"blockId":"block.4713a20a47104ccc868c6054f4cf99ac","type":"paragraph","direction":"auto","runs":[{"runId":"run.78193695e6df4f9897def8bfe0b99188","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"he then commanded these latter "},{"runId":"run.56a97cc167ae4d83afec