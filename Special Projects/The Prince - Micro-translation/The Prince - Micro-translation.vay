"proper","pronunciation":"gonzago","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The title victim of the play Hamlet requests from the actors.","id":"shakespeare014.lex.gonzago_play.sense","status":"draft"}],"status":"draft","variants":[]},"42610a997d66172a41cc522d10ec55f87f73a9fef8233c50bac7570adca8c407":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gonzalo","id":"shakespeare014.lex.gonzalo_naples_councillor","ipa":"","label":"gonzalo_naples_councillor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gonzalo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"Councillor who secretly supplied Prospero and Miranda before they were set adrift.","id":"shakespeare014.lex.gonzalo_naples_councillor.sense","status":"draft"}],"status":"draft","variants":[]},"67cfdca0b2d4e270ac93e5e42e888d20b82259557296288d244f8c8e5cdd29c7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: holy + friday_source","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: holy + friday_source","exampleIds":[],"headword":"prodna\u00dfd\u00d7um\u2019t yel","id":"shakespeare014.lex.good_friday_observance","ipa":"","label":"good_friday_observance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodna\u014dd\u0113um\u2019t yel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The Christian fast day evoked in the Bastard's flesh-eating joke, named by sacredness and the established native designation for the source weekday.","id":"shakespeare014.lex.good_friday_observance.sense","status":"draft"}],"status":"draft","variants":[]},"937db3a85f5c1acff78f2083e64048831876e9ab61a82a781fc048ba5930cc92":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gudman","id":"shakespeare014.lex.goodman_cardinal_man","ipa":"","label":"goodman_cardinal_man","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gudman","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Family name borne by the cardinal's man who is said to withhold the petitioner's house, lands and wife.","id":"shakespeare014.lex.goodman_cardinal_man.sense","status":"draft"}],"status":"draft","variants":[]},"b63824b55128fa6b18be27913c89828f233d7aee8f6bc3da8c401ea05e9fa7d5":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"gudri\u00d1","id":"shakespeare014.lex.goodrich_title","ipa":"","label":"goodrich_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gudrich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"One of the two places paired with Lord Talbot's name.","id":"shakespeare014.lex.goodrich_title.sense","status":"draft"}],"status":"draft","variants":[]},"16f7845a6975d1faebbed88b7c532587077ac34a8942dd1571174a6d6b9be141":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"gudwin","id":"shakespeare014.lex.goodwin_sands_name","ipa":"","label":"goodwin_sands_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gudwin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The name in Goodwin Sands, where the Dauphin's reinforcements are wrecked. Distinct from the Lincoln Washes.","id":"shakespeare014.lex.goodwin_sands_name.sense","status":"draft"}],"status":"draft","variants":[]},"ee1172df74a5b252cbd136ebad0de6c920763809783aaa417196477af8ff9bb9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: goose","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Authored native derivation or sense: goose","exampleIds":[],"headword":"gansil","id":"shakespeare014.lex.goose_tailors_iron","ipa":"","label":"goose_tailors_iron","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gansil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"A tailor's smoothing iron called a goose. Its native form matches the bird, so the Porter's talk of roasting it has both readings.","id":"shakespeare014.lex.goose_tailors_iron.sense","status":"draft"}],"status":"draft","variants":[]},"72aec64134d763461fd3ec70d3cff2910c5b9695f466a42561785123d8fa249f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sour + berry","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: sour + berry","exampleIds":[],"headword":"m\u00ebrikberil","id":"shakespeare014.lex.gooseberry_fruit","ipa":"","label":"gooseberry_fruit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrikberil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The single small fruit by which Falstaff measures t