45ae09c3e3cd65":{"cells":[],"citations":[{"locator":"paragraph 13; examples 58\u201363","sourceId":"hadthem"}],"entryIds":[],"features":{"distance":"agnostic","tense":"future"},"form":"at","id":"hadthem.future-general","kind":"inflection","label":"future-general","notes":"","status":"attested"},"6a869cda3b408ea10591dbec43185993364dced88e9abd9170eea87e7b4bc706":{"cells":[],"citations":[{"locator":"paragraph 23; examples 58\u201363","sourceId":"hadthem"}],"entryIds":[],"features":{"distance":"immediate","tense":"future"},"form":"dat","id":"hadthem.future-immediate","kind":"inflection","label":"future-immediate","notes":"Future table and paired script/transliteration example rows disagree; no winner selected.","status":"disputed"},"4efdf7f7504da7092719b9cfe20c4715b0bcbf0cb331daf8c69b87cf678c660b":{"cells":[],"citations":[{"locator":"paragraph 16; examples 58\u201363","sourceId":"hadthem"}],"entryIds":[],"features":{"distance":"distant","tense":"past"},"form":"diz","id":"hadthem.past-distant","kind":"inflection","label":"past-distant","notes":"","status":"attested"},"edf091b452f2c73a724a4c1903e928390b3e024e4bb3cc5be9e53dd9a569b4f0":{"cells":[],"citations":[{"locator":"paragraph 6; examples 58\u201363","sourceId":"hadthem"}],"entryIds":[],"features":{"distance":"agnostic","tense":"past"},"form":"iz","id":"hadthem.past-general","kind":"inflection","label":"past-general","notes":"","status":"attested"},"bd113085881b49e71dc6c882bb086d3d551d270ed87988e2c2350f344c3a340e":{"cells":[],"citations":[{"locator":"paragraph 19; examples 58\u201363","sourceId":"hadthem"}],"entryIds":[],"features":{"distance":"immediate","tense":"past"},"form":"riz","id":"hadthem.past-immediate","kind":"inflection","label":"past-immediate","notes":"","status":"attested"},"39ee11dd1b47bebdd515cab9a5d038a46fdd41640ad84a0cb7c70ad3fe38a08a":{"cells":[],"citations":[{"locator":"paragraph 10; examples 58\u201363","sourceId":"hadthem"}],"entryIds":[],"features":{"distance":"present","tense":"present"},"form":"ow","id":"hadthem.present","kind":"inflection","label":"present","notes":"","status":"attested"},"a69f69811371182f313fe2c72e3092e36ee242459900530829f2ae75e2912740":{"cells":[],"citations":[],"entryIds":[],"features":{"function":"perceived proposition","gloss":"appr.","version":"0.9"},"form":"\u2019s\u00ebm","id":"midsummer.morph.app","kind":"affix","label":"Apparent proposition","notes":"Authored in 0.9; interpretation and scope in the Midsummer grammar wiki.","status":"draft"},"1708441449ac97c5f37d48bffd69c96a184afeac51a4f630210c967da520611a":{"cells":[],"citations":[],"entryIds":[],"features":{"function":"different subject","gloss":"cv.ds.","version":"0.9"},"form":"\u2019esta","id":"midsummer.morph.cvds","kind":"affix","label":"Different-subject converb","notes":"Authored in 0.9; interpretation and scope in the Midsummer grammar wiki.","status":"draft"},"709959865a07e58200b498f701985dc5fc240950e6b5791ce428252ff94dfab9":{"cells":[],"citations":[],"entryIds":[],"features":{"function":"ritual imposition","gloss":"rit.juss.","version":"0.9"},"form":"\u2019rai","id":"midsummer.morph.juss","kind":"affix","label":"Ritual jussive","notes":"Authored in 0.9; interpretation and scope in the Midsummer grammar wiki.","status":"draft"},"bd2e666436f5411b1acaf06d27237074817e197013bb4d6f4002061f70ab5da6":{"cells":[],"citations":[],"entryIds":[],"features":{"function":"attributed proposition","gloss":"rep.","version":"0.9"},"form":"\u2019v\u00eb","id":"midsummer.morph.rep","kind":"affix","label":"Reportative","notes":"Authored in 0.9; interpretation and scope in the Midsummer grammar wiki.","status":"draft"},"51ebdaf29beeb35ee8efe6b3f40e9ae29f6adaf8b9a4be84ac975588ca21baa5":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.1","label":"1. Clause order and reference","morphologyIds":[],"notes":"","statement":"1. Clause order and reference\n\nNeutral transitive clauses prefer object\u2013subject\u2013verb. A continuing topic can precede its object; a focused object can precede the subject. Case, discourse and punctuation must keep participant roles recoverable. This permits variation with a reason, not arbitrary permutations. Lexical subjects can take nominative -l\u00e4y; fronted objects and nominal predicates use accusative -get. Nominative may be absent on an established, unambiguous subject. Pronouns are ordinarily unmarked as subjects. Restore the subject after a speaker change, topic shift, competing referent or contrast. Never let a page break decide who did an action.\n\nTitles, vocatives, headings, dictionary citation forms and answer fragments may be bare. Lists can share a predicate. Balanced proverbial or antithetical clauses may omit a recoverable copula. An unfinished sentence stays unfinished. A source-unit split used for pagination is not a new sentence.\n","status":"draft","topic":"construction"},"8e210dbb560efa665620c73e1e582d02fc7e9d1b47e8cac09a2767276eb1138c":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.10","label":"10. Orthography, gloss and testing","morphologyIds":[],"notes":"","statement":"10. Orthography, gloss and testing\n\nUse the approved Maxima/Minima identity map at real sentence starts and proper names. Never Unicode-uppercase or normalize legacy font slots. A continuing sentence split across source units remains a continuing sentence. Thimfora and Transliteration 7 receive identical slots and case. The gloss follows target order and abbreviates grammatical roles; the English remains the supplied source, not a reverse translation of the gloss.\n\nCanonical compiler checks cover declared vocabulary, compatible case/number/tense, clause-form exclusivity, voice order and particle placement. The minimal pairs include valid constructions and intentional invalid contrasts. Neither successful compilation nor a Forge page test proves literary equivalence. The two full ledgers preserve every source unit, explicit edits, lexical migration and paragraph starts. The old editions and their original test results remain historical evidence. New translation work begins by loading the pinned 0.10 package and branching the consolidated Forge project, then records its own additions and review decisions.\n","status":"draft","topic":"construction"},"d11955de0ef5e63932d35c56eddb0ea968dfab84271aa8d3ea51e96bc6248a6d":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.2","label":"2. Nouns, modifiers, case and possession","morphologyIds":[],"notes":"","statement":"2. Nouns, modifiers, case and possession\n\nThe thing-class prefix remains available for classification, contrast and emphatic introduction. A known lexical noun does not require it on every appearance. This is the 0.8 dramatic extension of earlier restricted omission; do not apply old prefix-required tests to new dramatic prose without their historical context.\n\nCount plural -un and dual -et precede case. A collective or generic class need not be pluralized; mass nouns receive count marking only for portions or kinds. A light descriptive attribute may precede its head. A heavier descriptive modifier follows with \u2019m\u016b, or uses an explicit relative. Qualifying stems precede heads in compounds. One head receives one outer case: nominative, accusative, dative, genitive, source, location, goal or means. Modifier/adverb conversion is a separate category.\n\nBound possessors precede a head with \u2019; nested possessors scope inward. The final head bears the outer case. Free genitive \u2019i or linker i replaces an opaque chain. Use each:dat of you, not you:gen:dat: the latter attaches competing cases to one head. Spatial adpositions remain available alongside \u2019tha (source), \u2019ni (location), \u2019ra (goal) and \u2019rin (means). An external agent, an instrument and a companion are different relations, even when English uses with/by for several of them.\n","status":"draft","topic":"construction"},"e3de3b2862a108062eb85aa0b15ec459ed099c95a67585603b7b958d97ba5baf":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.3","label":"3. People and social register","morphologyIds":[],"notes":"","statement":"3. People and social register\n\nKeep I singular, collective/institutional we and individuated plural we distinct. A ruler\u2019s institutional we is not evidence of several bodies. Formal/plural you and familiar singular you reflect intimacy, public formality, rebuke or rank in the scene; they are not assigned mechanically from speaker rank. He, she, animate they and inanimate it retain the inherited proposed paradigm.\n\nGeneric vem denotes a person or a human anaphor (someone, one who). Cardinal neksus denotes one counted member, including a selected person. A measured mile, one grape, one in ten, one by one and one shared cry require quantity. Nonhuman elliptical one can use the cardinal with its recoverable noun. This distinction is now applied to both plays. Do not blindly replace every English one.\n","status":"draft","topic":"construction"},"0feab7ab3501f44435e1bc6612a76a6d849dc29cbbec5fb9e49c7c42d72d2532":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.4","label":"4. Tense, aspect and voice","morphologyIds":[],"notes":"","statement":"4. Tense, aspect and voice\n\nThe finite pattern is root + voice/derivation + tense/aspect. Present ow, past iz and future at combine with simple ya, progressive am or perfect fu where declared in morphology.json. A perfect relates an earlier event to a reference state; it is not a stylistic synonym for past. The reduced generic ya expresses dispositions or maxims, not necessarily an event happening now. A source will may express desire or intention rather than future tense.\n\nPassive im, causative ar, reflexive ir and reciprocal il precede the clause ending. Ordered combinations preserve scope: passive then causative means causing something to be undergone; causative then passive means undergoing a caused event. Do not sort the suffixes alphabetically or equate these constructions. A passive need not supply an agent absent from the source. Commands, imposed marriage, consent, promises and contractual conditions remain semantically distinct.\n\nInfinitive \u2019en marks a complement; a perfect infinitive is licensed for anteriority, as in having amended one\u2019s faults. It retains the inherited perf:inf spelling; it does not locate an independent present-tense event. Other finite-tense-plus-infinitive stacks are not licensed by this baseline. Event nominalization ef\u2019 and zero conversion remain available, with the grammatical role determined by the construction.\n","status":"draft","topic":"construction"},"e607535f4893a5913cd4d8d0185c9a0c89fee48dd2105cd35ef5003eea839260":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.5","label":"5. Attendant actions and subject tracking","morphologyIds":[],"notes":"","statement":"5. Attendant actions and subject tracking\n\nThe converb \u2019es has a same-subject interpretation in an attendant-action chain. Different-subject \u2019esta requires an explicit or locally unambiguous background subject. Titania sleeping while the clowns enter is not the clowns sleeping as they enter. The suffix itself identifies neither person nor gender. An overt while-clause is an ordinary alternative. Both converbs follow voice and exclude an independent finite tense. An infinitive complement is not an attendant action.\n\nThese are discourse rules. The compiler checks incompatible endings; it cannot infer the correct referent from Shakespeare. The editor must record participants in the source-aligned analysis and review ambiguous pronouns.\n","status":"draft","topic":"construction"},"a585a8c2f8ec75b128da73b77d135a29d127bc7452aca88c7bada22a3c5978aa":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.6","label":"6. Mood, modality and negation","morphologyIds":["consolidation.morph.excl"],"notes":"","statement":"6. Mood, modality and negation\n\nImperative e directs an action. Optative \u2019ne expresses a wish, including inherited tenseless wishes. Ritual jussive \u2019rai follows a finite form and presents a state as imposed by a ritual utterance. It describes the speaker\u2019s performative intention, not guaranteed success. Preserve the distinction in spells and their reversals.\n\nPossibility/permission, ability, necessity and defeasible expectation remain distinct. A free modal precedes its scope; an unstressed bound modal can follow the finite predicate. Do not duplicate a free modal with its bound equivalent. Irrealis \u2019ve expresses a hypothetical/counterfactual interpretation and may follow a modal.\n\nNegative ma before a constituent is narrow in scope. Predicate negation before a necessity ending means necessity of not acting: must not slumber. Negating need means absence of obligation: need not slumber. Final ma can deny a completed assertion or ability. Keep these scopes explicit. Lest already encodes avoidance; adding a negative can reverse it. A negative quantifier is not automatically a redundant second negation.\n\nThimfora has no exclamation mark. Marked expressive force uses the new clause-final enclitic **\u2019h\u0101** (encoded **\u2019h\u00c5**, gloss **excl.**). It attaches to the final host after that host\u2019s case, tense, mood or reportative ending; its scope is the completed utterance. Thus an emphatic statement, urgent command, intense wish and expressive ritual utterance remain different constructions: pr:excl, imp:excl, opt:excl and pr:juss:excl. It can also follow a nominal fragment or vocative without inventing a missing verb. Close with the ordinary sentence separator, not a borrowed exclamation glyph.\n\nThe enclitic marks the speaker\u2019s heightened affect or emphatic delivery. It does not specify anger versus joy, increase factual certainty, impose a command by itself, or change negation scope. An unmarked command remains a command; an emotionally charged event does not automatically require expressive grammar. Existing authored exclamations are migrated with their original command/wish/statement distinctions; the English retains its punctuation. In new writing, choose the marked form for discourse reasons, not for every sentence. This is a 0.10 authored construction, not an archival discovery.\n","status":"draft","topic":"construction"},"d2c8d3b4c987d00b39d9efa59b88e123e9af32b616f8dcbc1c78d10a86d8217d":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.7","label":"7. Claims, appearance, subordination and comparison","morphologyIds":[],"notes":"","statement":"7. Claims, appearance, subordination and comparison\n\nReportative \u2019v\u00eb follows a finite predicate and attributes the proposition to a report. Apparent \u2019s\u00ebm marks a perceived or seeming proposition; it asserts neither certainty nor necessarily deception. Keep a materially relevant reporter visible. Arbitrary stacking of these particles is not licensed; express a reporting clause plus an apparent proposition when both matter.\n\nUse explicit content and relative boundaries where roles could be confused. A resumptive participant or overt relation can identify a relative\u2019s role. An initial framing subordinator or a clearly punctuated clause-final subordinator is licensed for temporal, causal, conditional and concessive clauses. Open if and counterfactual asif differ. Venki introduces imagined resemblance; irrealis belongs on the imagined predicate. Ordinary role/comparison uses the inherited comparison construction.\n\nPolar questions, interrogative families, interrupted dialogue and quoted assertions keep their inherited readings. Quoted soldiers\u2019 feigned speech is marked as such and is not assigned fictitious dictionary meanings.\n","status":"draft","topic":"construction"},"5cc22a973b7bc6300483c21ce211f0d98dea2c063147e11ba6a287cdf59c5480":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.8","label":"8. Lexicon, variation and ambiguity","morphologyIds":[],"notes":"","statement":"8. Lexicon, variation and ambiguity\n\nUse the canonical semantic keys in lexicon.json. Each key has one current form, meaning, provenance and stable semantic identifier. Distinct meanings may share a headword. Explicit historical forms are readable alternatives for old editions, not fallback defaults for new work. The package resolves the old twelve competing TSV declarations once; future file ordering cannot choose a word\u2019s meaning.\n\nBar as a rigid object remains zaril; bar_obstruct restores boundary+close for preventing action. Mortal now uses die+able, distinct from dead. Existing deadly serves lethal danger. All\u2019s Well 0024 retains its ambiguous historical mortal wording under mortal_legacy: this audit does not pretend to settle that literary reading. Do not generalize this exception to new prose.\n\nRelated polysemy, nominal/verbal conversion, conventional names and contextual homophones remain. Ten unrelated homophone groups are explicitly listed for contextual review (for example bone/noise and parent/leg). They have separate semantic keys. Similar sound alone is not proof of an error; equally, dictionary grouping is not proof of shared meaning. Expand an ambiguous phrase with an existing descriptive constituent or propose a reviewed lexical distinction when a new passage requires it.\n\nChoose variants for reference, scope and register. Courtly address, fairy refrains, hesitant craftsmen, paired rebuttals, parallel more\u2026more constructions and a character\u2019s deliberately wrong words may repeat. Do not optimize diversity by random synonym replacement. Frequency and repetition reports are diagnostics, not a substitute for a readable scene. Rare reportative and different-subject forms remain proposals with limited examples, not evidence of a complete dialect history.\n","status":"draft","topic":"construction"},"2ab0418a29773b00d7951e56a206a37b90b003522c0fa09fd441e41e59a522f9":{"alternatives":[],"citations":[],"exampleIds":[],"id":"consolidation.rule.9","label":"9. Quantity and the Unta evidence","morphologyIds":[],"notes":"","statement":"9. Quantity and the Unta evidence\n\nThe directly checked names for values zero through twelve are f\u014dlem, neksus, th\u0101tus, venik, b\u0101rum, jensis, \u014dd\u0113um, p\u00e4rsus, krizum, deksin, eshn\u00e4, yamen, \u00e4m\u0113n\u014d. Note b\u0101rum\u2019s macron and p\u00e4rsus\u2019s diaeresis. The package preserves exact Thimfora symbol identities through the approved Roman mapping.\n\nNew composition uses those names. Earlier tatus, tren, ketren, pent, sept and d\u00fckal remain historical readings in versioned records. Declared productive compounds follow their updated components. Ordinal second, third and fourth use the corresponding cardinal plus \u2019t; lexical first/neks and once/veneks remain conventional inherited exceptions. Cardinal two and ordinal second are no longer one form.\n\nSource quantities retain their mathematical value. Decimal hundred and thousand remain explicit source-culture quantities; they do not become 144 or 1728. Ten-fourteen/fifty-type conventional decimal compounds retain the declared additive or multiplicative interpretation; new source quantities should be recorded with an exact value. Written Unta 10 means twelve, while the word eshn\u00e4 denotes decimal ten. Act and scene labels retain their original displayed values. This consolidation does not change page-number glyphs or the formatter. The chart\u2019s higher numeral readings need further systematic treatment; do not extrapolate unverified spoken forms from its highest powers.\n","status":"draft","topic":"construction"},"3cfcb020aea9880bc9dff4c69009dcc7b55a0dee9a1cbd5ce3c8d1cb1615b3aa":{"alternatives":[],"citations":[],"exampleIds":[],"id":"drama.grammar","label":"Dramatic literary grammar 0.8","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Vayrshemon 0.8 \u2014 dramatic literary branch\n\nScope and ancestry\nThis branch develops the 0.7 construction-gloss language for All's Well That Ends Well. It is an authored continuation, not a claim that Shakespearean dialogue was already expressible in the surviving specimens. The original archive records and frozen 0.7 history remain available. Dictionary records distinguish archive adaptations, previously proposed forms, new compounds, and new roots. No machine-selected random syllables or English-token substitution is used. The editorial transcription is written in target order and compiled only after every word and inflection is declared.\n\nReading the four columns\nThe first column is Thimfora 79; the second contains exactly the same encoded characters in Transliteration 7. The third is a compact construction gloss in target order. The fourth preserves the supplied Folger English, including speakers and stage directions. Paragraph boundaries may divide a long speech for page fit; they do not authorize omitted lines or reassigned speakers. The source index retains original line ranges and source-file hash. Separator lines made only of equals signs are excluded. The work begins at ACT 1, with no imported cast list or front matter.\n\nOrder, case and reference\nNeutral transitive clauses prefer object\u2013subject\u2013verb. An established subject may precede its object or nominal predicate when discourse continuity makes that natural. A focused object remains before the subject. Lexical subjects take -l\u00c9y (nom.); direct objects and nominal predicates take -get (acc.). Unmarked pronouns are subjects; the new branch extends -get to their object forms instead of pretending to have deciphered every historical pronoun-chart cell. Titles, vocatives, headings and dictionary citation forms may be bare. Nominal juxtaposition in lists shares a finite predicate; a recoverable copula may be absent in balanced proverbial or antithetical clauses. These are licensed constructions, not arbitrary word shuffling.\n\nCase endings remain on the noun head. Adjectives follow their heads and take \u2019m\u00e7 in ordinary count modification. Predicative adjectives may be followed by the copula and receive predicate case when explicitly substantivized. The nominative ending contains a legacy Maxima-looking slot internally; this is a vowel identity, not an invitation to Unicode recasing. Ordinary prose capitals come from the named Maxima/Minima pairs.\n\nNominal classes and number\nThe earlier thing-class g\u00df\u00d1et\u2019 remains available for explicit classification and emphatic introduction. In this dramatic branch, a dictionary noun's lexical class permits a bare classified noun with overt case. This deliberately extends the earlier restricted discourse deletion rule: dialogue does not require the same thing-class prefix on every new participant. The change applies only in 0.8, and does not reinterpret earlier test failures. Count plurality uses -un, dual -et, before case. Collective nouns and generic classes need not be pluralized when no separate individuals are asserted. Mass nouns do not receive a count plural unless a portion/type reading is intended. The speaker collective ly remains; lym is a newly proposed individuated we. English singular/plural is interpreted, not mechanically copied.\n\nPossession and relations\nA possessor is placed before its head with \u2019: r\u00e1\u2019son-root, ly\u2019life-root. Nested possessors scope inward from the left. The head alone receives outer case. For clarity, free genitive -\u2019i or the linker i can replace a long bound chain. The bound construction generalizes the earlier ly\u2019 forms. Spatial relations normally use adpositions; optional clitics -\u2019tha (source/abl.), -\u2019ni (location), -\u2019ra (goal), -\u2019rin (means) keep the noun phrase compact. These are new productive relations. The source's on/about and instrumental with/external-agent by distinctions survive as separate inherited lexical roots.\n\nTense, aspect, voice and mood\nRetain root + tense + aspect: -ow- present, -iz- general past, -at- general future; -ya simple, -am progressive, -fu perfect. Thus a present perfect expresses a past event with a relevant present result, whereas an ordinary narrated past uses -izya. Past perfect is -izfu. The source's will is not automatically future: volition uses the desire verb or a modal, and proverbial futures may be generic predictions. Temporal remoteness remains available under the older rules but is not forced into each past event.\n\nNew voice suffixes precede tense: -im passive, -ar causative, -ir reflexive, -il reciprocal. Passive changes the promoted participant without inventing an agent; an expressed agent is introduced by \u00cbers. -e is a direct imperative. -\u2019en marks a nonfinite complement; -\u2019es a simultaneous or attendant-action converb. ef\u2019 nominalizes an event, retaining the archived conversion family. Modal particles precede their scope: jor necessity, lah permission/possibility, jw\u00ebn ability, ve irrealis. Unstressed postverbal \u2019jor, \u2019lah and \u2019jw\u00ebn are permitted when the scope is the whole preceding predicate, especially in subordinate clauses. They do not duplicate a separately expressed modal. -\u2019ve after a finite form marks irrealis; -\u2019ne marks a wish or blessing. Negative ma precedes the constituent it denies; whole-clause negation is placed before the predicate/modal group. A positive imperative does not become negative merely by describing a bad action.\n\nQuestions, subordination and ellipsis\nClause-final ib closes polar questions; interrogatives retain the chart's semantic families: \u00d1etib thing, falib person, horib reason, k\u00e3nib manner, k\u00c7nib location. ka introduces a content clause; ki a relative clause. A resumptive pronoun or explicit relation identifies the relative's role when a gap would be unclear. m\u00dfrnav introduces an open conditional, rav its optional consequent. Counterfactual tense/mood is expressed on the verb, not inferred from English if alone. vin is temporal when, vinel while, vinto until; kenst is because; venka although; maka lest. Lest already encodes avoidance and does not require an extra negative that would reverse its meaning.\n\nAn immediately continued subject can remain unspoken only while reference is secure. A new speaker, topic change, competing referent or contrast restores it. Dialogue answers can be fragments. Interrupted sentences remain interrupted: Parolles and Helena's broken exchange must not be repaired into assertions they never finish. A standalone at represents a suspended future auxiliary in that particular construction, not a general replacement for finite verbs.\n\nPeople, register and address\nKeep r\u00e1 I, ly collective we, po inanimate it. This branch proposes ne respectful or plural you, nel familiar/downward singular you, zi he, za she, zem animate they, vem generic one, and lym individuated we. These are authored paradigms rather than purported transcriptions of the older chart. The English thou/you distinction guides social distance, but irony, intimacy and rank are considered in each exchange. arza, arzi and arvenek distinguish madam, sir and lord. Kinship terms can be literal or socially offered; Countess calling Helena daughter must not silently become a claim of biological parentage.\n\nWord formation and lexical limits\nCompounds are semantic proposals with their components recorded. They are not required to be fully transparent after lexicalization. New roots fill lexical gaps in bodily life, society and affect, while established verbs remain productive. Synonyms are chosen for meaning and voice, not to maximize a diversity statistic. Repeated words remain repeated when Shakespeare uses anaphora, mockery or an argument's key term. Names are adapted consistently, with original spellings visible in the English column. Unknown historical phonetic values remain unknown; the Roman font is authoritative for this edition's reading display, and dictionary text does not invent an IPA pronunciation for unresolved letters.\n\nNumerals\nAct/scene numbers in the range used here preserve their ordinary values. Larger source quantities preserve decimal meanings: ten means decimal 10 (the Unta eshna value), not the Unta written string 10, which would mean twelve. Mil names the source culture's decimal thousand. Conventional time units such as hour and year retain the source's intended duration. No rhetorical thousand is silently converted into a different quantity.\n\nGloss key\nnom. subject; acc. object/predicate; dat. recipient; gen./poss. possessor; mod. postnominal modifier; adv. adverb; prs./pst./fut. tense; pf. perfect; prog. progressive; pass. passive; caus. causative; recp. reciprocal; refl. reflexive; imp. command; inf. nonfinite complement; cv. converb; opt. wish; irr. irrealis; pl./du. plural/dual; nmlz. event noun; th. explicit thing classification; abil./possib./necess. ability/possibility/necessity. A dot separates gloss words; hyphens expose a compound's lexical construction. Labels explain structure, not a claim of perfect word-for-word English equivalence.\n\nAct II register refinements\nUnmarked lexical subjects are also licensed in continuous dialogue when person, order and argument structure identify the subject without a rival reading. Full nominative marking restores a contrast, introduces a competing participant, or separates adjacent clauses. This is differential subject marking, not deletion of all case. Accusative remains especially useful on fronted objects. Noun compounds place their qualifying stem before the head; separate descriptive modifiers normally follow and use the modifier ending. A short finite modifier may precede a noun in a restrictive reading; ki remains the explicit relative boundary for longer or potentially ambiguous attachments.\n\nThe reduced generic ending -ya, without the present segment -ow-, is used for maxims and recurring dispositions: it does not locate a particular present event. The full -owya remains appropriate to an event now or a state asserted now. The distinction lets the King's maxims and the Fool's supposed general truths differ from immediate stage action without arbitrary synonym replacement.\n\nNegative ma before a constituent has narrow scope. Clause-final ma is a dialogue variant with scope over the completed assertion, particularly a denial or correction; it does not reverse an embedded conditional. An overt negative beside a permission or necessity modal must be read with that modal's stated scope, not as a blanket equivalent of English cannot or must not. In the construction gloss, negation remains visible as its own word.\n\nProductive zero conversion permits a root naming an action to name its event or result, and a state root to serve as a predicate adjective. Finite endings identify verbal use; case identifies nominal use. The dictionary groups the same written form's related senses rather than counting happy/happiness or know/known as invented separate words. Homophonous but unrelated senses are recorded separately within that headword and must not be conflated by a translator.\n\nLexicalization is explicit. The long newly composed contempt-speech expression is conventionalized as gr\u00ebnaw, scorn; z\u00e1linhif\u00e5r is steward, and mermiktaz\u00d7r is navigator. These are 0.8 authorial decisions. The original archive forms and the earlier working compounds remain recoverable in version history. Long possessive chains may be unpacked with free genitive: the calendar of my past endeavours is not forced into a single unwieldy word. This improves both spoken plausibility and typesetting without reducing the approved font size.\n\nThe King's we may be a sovereign's institutional singular, distinct from lym for several individuals and from ly's earlier collective reading. Context and speaker identity establish that use; the English column and notes preserve it. Bertram's imposed marriage is grammatically an imposed act, not mutual consent. Consent, command, vow and contractual condition have separate lexical entries.\n\nNumbers in the drama retain decimal source values even when the language's own number-writing system is duodecimal. Ten-four names fourteen; two-ten names twenty. The conventional vel\u00adtatren (encoded veltatren) names twenty-four hours in Helena's medical deadline. These are lexical quantities, not a reinterpretation of the printed strings 14 or 24 as base-twelve values.\n\nDictionary archive policy\nThe current dramatic dictionary contains current-encoding headwords with grouped senses. Duplicate historical chart witness lists are retained in the inherited immutable Forge revisions and the ancestry bundle; they are not presented as hundreds of extra contemporary synonyms. No original input or earlier language release is overwritten. New drama entries remain marked draft until editorial review is complete.\n\n\nActs III\u2013V: discourse, quotation and argument\nTemporal and causal clauses may frame the sentence before the main clause. In continuous dialogue a subordinator may close its own clause: [clause] because, [clause] if, and [clause] though are licensed counterparts of the initial framing construction. The boundary is retained with punctuation. This is a head-final subordinate construction, not arbitrary English word scrambling. Long relative descriptions keep the referent expressed when two women, two rings, two letters or competing speakers make a gap unsafe.\n\nAn attributive state root can stand directly before its noun in a compact descriptive phrase (noble lady, fresh clothes); a heavier predication follows with the modifier construction or relative clause. Unbound genitives replace overly long compound possessors. These options are grammatical alternatives with different information weight, not random rotation through surface patterns.\n\nNonfinite complements can retain aspect when anteriority matters: an event nominal or perfect infinitive can distinguish having done something from intending to do it. Aspect alone does not claim an event was voluntary. Passive and causative constructions preserve the distinction between marriage commanded by a king, a promise made by a suitor, and freely offered consent.\n\nA finite verb followed by a postposed necessity clitic scopes the obligation over the predicate. Prohibitions use ma- on the predicate before the necessity/imperative ending. A final ma after ability denies ability. When the speaker means absence of an obligation, the negated predicate is need/necessity, not the commanded act. The edited transcription records these distinctions rather than treating all English modal negatives as interchangeable.\n\nFeigned speech in 4.1 and 4.3 is quotation, not vocabulary. Double-braced material in the editorial transcription denotes the soldiers' deliberately unintelligible performance. The readable target gives a consistent pronounceable stage sequence; the gloss explicitly says [feigned speech]. No false dictionary definitions have been invented for those syllables. The exact English-source sequences remain in the English column. Actors must not infer a hidden foreign-language translation from them.\n\nPerson and testimony\nThe same ring is referred to differently by a witness's claim, actual ownership and present possession. A free genitive or possessive expresses the claim in that utterance; it does not certify it. The two ring exchanges remain distinct. Diana's denials in 5.3 are intentionally incompatible on their surface. They are not normalized into a single consistent story before Helena appears.\n\nThe second-person familiar form follows downward address, intimacy and rebuke; the respectful/plural form follows formal petitions and public examination. Social rank is not the only factor. Formulaic court address is allowed to repeat, while subject expression and clause framing vary with reference and emphasis. The King's institutional we, ordinary individual I and plural we remain distinct.\n\nStage labels, directions and the epilogue are translated as part of the source. Proper names keep consistent adapted forms and Maxima initials. Text remains literal legacy slots: neither Unicode uppercasing nor normalization substitutes for the Thimfora identity-pair map. The transliteration column is exactly the same string in the intended Transliteration 7 font, including case.\n\nDictionary presentation\nRegularly declared adverbs, comparatives and superlatives are listed as variants under the base headword, with their complete surface forms and separate gloss senses. This avoids counting a form like more-bright as an unrelated new root. Equal inherited headwords acquire new explicitly draft senses without discarding their old definitions or record IDs. The complete editorial dictionary export also contains component roots and every semantic key used by the transcription, including compound components that never occur alone.\n\nEditorial status\nThis is a complete authored first translation in the proposed 0.8 dramatic branch, not a claim that a mature community has attested these new rules. It is designed to be read and revised: the source ledger, construction analyses, lexical derivations and commentary remain available. Automated checks establish coverage, valid symbols and layout; they do not establish literary equivalence. Uncertain readings and untransferred puns remain documented.\n","status":"draft","topic":"construction"},"d64825ada1481e72a8fb3f5222032ec73966218a5c9c84685b52aa537657a650":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"correlative-chart"}],"exampleIds":[],"id":"forge.rule.correlatives","label":"Correlatives, negation and open questions","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"The correlative chart distinguishes action, quality, reason, time, location, manner, quantity, human association, thing identity and truth. Definitive and indefinite prefixes and an interrogative pattern are visible; several columns are blank. Retain the gaps. The polished clause supplies a causative conjunction. Internal/external negation and passive derivations need further source alignment before productive generalization.","status":"draft","topic":"construction"},"0fb67f35236dd5de17e65f37447fa64d4463f120c759927577176333bef3628c":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"chart-1"}],"exampleIds":[],"id":"forge.rule.lexicon","label":"Dictionary policy and frequency","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Keep original chart entries and stable sense IDs. Proposed current spellings are separate records with source links. Prefer attested roots and transparent inflections over randomly generated syllables. Measure running-text token frequencies separately from dictionary type counts and historical font slots. The tiny surviving corpus cannot establish population frequencies or justify smoothing away rare letters.","status":"draft","topic":"other"},"1e194a0d0abb4bcf95a747a70469f05fc5bf45b430801d5995878420bcdec5b8":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"polished"}],"exampleIds":[],"id":"forge.rule.nominals","label":"Nominal classes and modifiers","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Retain noun classes and overt conversion clitics. Use the polished thing determiner with count nouns and the quality determiner with beauty; -get marks the object. Count-noun modifiers follow the noun and take the attested count-modifier clitic. The clitic chart distinguishes mass, count, collective and title nouns; do not collapse those distinctions into English articles.","status":"draft","topic":"construction"},"61cf3fdd26d3bdd8f07acef088dc084f186542bccc46021f1152b16bea847fbb":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"polished"}],"exampleIds":[],"id":"forge.rule.order","label":"Clause order and case","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Use object/predicate\u2013subject\u2013verb as the neutral order in this draft. Noun direct objects take -get; lexical subjects take -l\u00c4y (chart-2 slots l\u00c9y). Pronouns use their subjective forms. This generalizes the polished examples; it is not proof that other orders are impossible.","status":"draft","topic":"construction"},"7a4d81713d36ad55819e604309cf022c0b84edb31d1de618ef167cb15f2c59f1":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"mapping-79"}],"exampleIds":[],"id":"forge.rule.orthography","label":"Encoding and sound","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Thimfora 79 chart 2 is the adopted display inventory: 47 letter identities with maxima/minima. Historical font slots are not Unicode phonetic values. Adapt U+00BE to U+2019 only in the review edition as in the approved page. Venik spellings used in the demo are mapped by named letter correspondence. Unresolved readings remain unknown; no invented IPA, stress rules or phonotactic constraints.","status":"draft","topic":"phonology"},"62a57d01a7d8eddea3cf58f404045ee932c9f53a6796c7c3060e60e0c13d6bda":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"pronoun-chart"}],"exampleIds":[],"id":"forge.rule.pronouns","label":"Collective we and pronoun paradigms","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Interpret the attested we(singular) as a collective singular speaker group for this branch. The pronoun chart explicitly distinguishes we(pr), we(d), we(s); their exact pragmatic scope is unresolved. Use only I, collective we and inanimate singular it in the first novel test. Do not infer the complete person/number paradigm from these three forms.","status":"draft","topic":"pronouns"},"8f54f7bb840e92399388359049824b7207ddbfb9658f0b2e50ebb4522d89dc46":{"alternatives":[],"citations":[{"locator":"M7 source review and explicit branch proposal","sourceId":"hadthem"}],"exampleIds":[],"id":"forge.rule.tense","label":"Tense and aspect","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Verb = root + tense + aspect. Adopt -iz general past, -ow present, -at general future, -diz distant past, -riz immediate past, -dat immediate future, -rat distant future. Prefer the prose table and transliteration examples for the conflicting future pair. Use -ya simple, -am progressive, -fu perfect. The chart also lists compound aspect contractions; these remain under review. Bare infinitives are licensed only as dictionary citation forms in this draft.","status":"draft","topic":"tense"},"822b211a9d7f767396ce4846805c54eee44d1523687789dd8452f79311f21302":{"alternatives":[{"citations":[{"locator":"paragraphs 23, 26, 58\u201359, 62\u201363","sourceId":"hadthem"}],"statement":"Immediate/distant future table: -dat / -rat. Script examples: -rat / -dat. Transliteration examples: -dat / -rat. Retain all readings pending adjudication.","status":"disputed"}],"citations":[{"locator":"paragraphs 1\u20132 and 58\u201363","sourceId":"hadthem"}],"exampleIds":[],"id":"hadthem.tense","label":"Tense and aspect ordering","morphologyIds":["hadthem.past-general","hadthem.present","hadthem.future-general","hadthem.past-distant","hadthem.past-immediate","hadthem.future-immediate","hadthem.future-distant"],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Tense is indicated seperately from aspect in Vayrshemon. There are seven forms for each verb that communicate tense. Three indicate the past, one indicates the present and three indicate the future. Both the past and the future tense, unlike the present tense, can convey a range of temporal immediacy. An action is specified to have occured in a contextually dependant relative time frame. The frame of refernce for an action\u00bes tense is that which is considered normal for the action. (The distant past with regard to a geological process is distinct from the distant past with regard to a human life span or from a nuclear process like the decay of a specific radioactive isotope.) In this way an event that occured 10 years ago with regard to the invention of a micro electronic device may be described in the distant past tense but an event that occured 10 years ago with regard to the development of technology in western societies may be described in the immediate past tense even though both examples refer to the same event. \nThe general form of the past and future tense is agnostic of temporal immediacy and simply conveys that an event does not occur in the present but that it occurs sometime in the past or sometime in the future. Greater specificity is possible by using the immediate or distant variant of the past and future tense. Tense is affixed before aspect and either of the two inflections can be absent but not both. ","status":"disputed","topic":"tense"},"b6554fd683a6dc17e8d2d9189dfcefdeef1d9f42c72d1b316cd4899f6b797be0":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.1","label":"1. What the chronology means","morphologyIds":[],"notes":"","statement":"1. What the chronology means\n\nThe frozen Bible is the historical literary witness. The two plays use a later dramatic standard. Project creation dates are not fictional language dates: 0.10 was assembled before the Bible, and 0.11 reconciles that work with the subsequently developed historical witness. This is authored language history, not a claim of archaeological attestation. The awkward Biblical translation is a particular foreign-text register, not a specimen of every ancient speaker's ordinary conversation.\n\nThe Bible is never rewritten by this work. Historical forms can survive in ritual, quotation and deliberate archaism. New translations start from 0.11 and record their own versioned additions. They must not silently start from either an earlier play compiler or the frozen Biblical dictionary.\n","status":"draft","topic":"construction"},"08991b7050aff25ad24159f6446792592a76ed718eb34f628425126cfcb50540":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.2","label":"2. Inherited grammar and later developments","morphologyIds":[],"notes":"","statement":"2. Inherited grammar and later developments\n\nThe ordinary tense, aspect, voice, case and mood inventory remains conservative. There is no invented wholesale sound shift and no random replacement of suffixes. Later change is visible in wordhood, reference and register: familiar compounds can become single inflecting words; case marking becomes less obligatory for an established, recoverable topic; dialogue permits carefully licensed omission rather than repeating a full formal introduction at every turn.\n\nThe inherited thing-class prefix remains productive in explicit classification, unfamiliar referents and marked ritual diction. It is not mechanically attached to every noun in a later conversation. Preserve the actual numeral values, negation, modal strength and participant roles. A source page break cannot reset reference.\n\nThe specific lexicalizations are listed in lexical-decisions.json. For example, historical **hefak gur** becomes ordinary **hefakgur** (war), and **pom s\u014dlum** becomes **poms\u014dlum** (scholar). Old spaced phrases remain available as deliberate formal constructions. These are bounded conventional words, not a rule stripping spaces from arbitrary text. Long descriptive names can remain phrases. Outer inflection belongs to the final head of such a phrase; ordinary free phrases should instead be authored with explicit constituent analyses when internal roles matter.\n","status":"draft","topic":"construction"},"e09611865596b61147ee038b47527b5dd8d8756ff13a3133b81e0b184ede8844":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.3","label":"3. Four first-person perspectives","morphologyIds":[],"notes":"","statement":"3. Four first-person perspectives\n\n**I(sg.)** is one speaking self; **I(pl.)** is internal plurality within a speaking identity; **we(sg.)** is a group or office construed as one acting whole; **we(pl.)** is several individuated participants. Later speech inherits all four possibilities. The plural-I construction remains marked and available; it is not compulsory for gods, magical characters, emotional conflict or actors playing a part.\n\nThe King can invoke his office with singular-we, then return to personal I. This alternation conveys a change of stance. It does not authorize changing an English personal *me* into royal *us*. The 0.11 review restores four such personal references in All's Well. Bertram's formal response on accepting military command uses office-oriented singular-we, while *my strength* remains personal; this is explicitly an interpretive decision.\n\nGeneric observations about several people, paired individuals and an audience usually use plural-we unless the passage presents one corporate agency. **ourpl/**, **ourspl** and **ourselvespl** keep possessive and reflexive number consistent. **ourone/** explicitly selects collective possession. The older **our/** remains collective for compatibility, not a catch-all English-our translation. Spell out the intended interpretation in an analysis rather than relying on the surface ambiguity of English *we*.\n","status":"draft","topic":"construction"},"90c8ada5335e63c13fc065ec56f9956f1a80129ddafb3758c19ec6d98d5d08f9":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.4","label":"4. Dialogue economy and its limits","morphologyIds":[],"notes":"","statement":"4. Dialogue economy and its limits\n\nUnmarked established subjects and recoverable same-subject continuations are ordinary later usage. A local nominative can be omitted when case or discourse still uniquely identifies the roles. An overt subject returns after a competing participant or meaningful contrast; it must never disappear merely to reduce repeated shapes.\n\nThe paired Hermia/Helena *more I hate/love, more he follows/hates me* exchange licenses first-person subject ellipsis in its first half: each speaker supplies the deictic centre of her own antiphonal turn. The second half retains **I(acc.)** and overt **he**, keeping the role reversal explicit. This is a narrow conversational development from the older overt-subject preference, not permission to erase all turn-initial pronouns. Parallel syntax is deliberately preserved because it carries the joke and emotional contrast.\n\nThe independent examples and source-linked revision ledger document this permission. Mechanical compilation does not decide whether a referent is recoverable. In particular Helen's *he desires some private speech* retains **he** after her own *I have spoken*: the subject changes there.\n","status":"draft","topic":"construction"},"e6306dfbe1ef9ac3d75f271f4c360acd064deb58f207966fda0cdaaadfe496a3":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.5","label":"5. Native vocabulary and editorial repairs","morphologyIds":[],"notes":"","statement":"5. Native vocabulary and editorial repairs\n\nCommon words use native stems and transparent native derivations. Person and place names may retain adapted source sounds. Source-culture ranks, coins, measures, animals and objects retain their distinctions: translating them natively does not turn a groat into a penny or a thousand into a different quantity.\n\nSome 0.10 forms were unjustified imitations of source words. Their replacement is an editorial correction, not evidence that the fictional language passed through an English-like phase. Native corrections developed in the historical project are adopted where applicable, and additional dramatic terms receive explicit native derivations or deliberately authored roots. The frozen Bible is not silently repaired where it still contains a problematic older form.\n\nThe **marry** key is an assent-oath, now a native emphatic assent. It is not the verb **wed**. Every inflected use mistakenly expressing marriage through the oath is repaired in the plays; passive and causative order is preserved. The native ratification **kom r\u0113\u2019ne**, approximately *so may it be*, replaces the sound *amen* while retaining repeated assent where the source repeats it.\n","status":"draft","topic":"construction"},"03295e6e0e36203541c0ea5f0eba3d6c87845c30fdf3351e798c51318411068c":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.6","label":"6. Wordplay and social voice","morphologyIds":[],"notes":"","statement":"6. Wordplay and social voice\n\nQuince's confused *paramour/paragon* pair receives the deliberately authored native pair **yalangz/farangz**, illicit-beloved versus admired-exemplar. Both share the love stem; the first is a conventional colloquial contraction of forbidden-love, the second a courtly good-love epithet. Flute corrects that same pair. This preserves a plausible native verbal mistake and its explanation; it does not claim to reproduce English sounds exactly or change every use of paragon into this epithet.\n\nBottom's pretentious address keeps an inflated native title. Correcting every comic malapropism into polished language would destroy his voice. The dolphin/dauphin and married/marred sound plays do not transfer intact; their literal claims remain and the commentary records the loss. Do not pretend a footnote recreates a spoken joke.\n\nThe Countess's *mortal* in All's Well 0024 remains a narrow, explicitly unresolved literary reading, retained as **mortal_legacy**. It is an editorial exception, not productive later vocabulary. Metre, every pun and independent literary certification remain outside the structural validation claim.\n","status":"draft","topic":"construction"},"540c727b3b6742348d0955c3eac14990a4250a91932e64df78f92b406b56d157":{"alternatives":[],"citations":[],"exampleIds":[],"id":"later011.rule.7","label":"7. Dictionary scopes and reproducible continuation","morphologyIds":[],"notes":"","statement":"7. Dictionary scopes and reproducible continuation\n\nThe package distinguishes **later-standard**, **later-literary**, **historical-reference** and **editorial-exception** entries. Historical-only vocabulary remains searchable and traceable to the frozen witness; its availability is not automatic approval for ordinary later speech. Promote it consciously, recording semantic or register change and provenance. Stable semantic keys keep histories distinct from preferred spellings.\n\nThe Forge branch descends from the pinned consolidated 0.10 head. It does not clone the huge Bible ancestry or modernize its commits. The new snapshot contains dictionary records, a current grammar wiki, decisions, source-linked play tests and focused grammatical contrasts. Original source text, all 1,970 units, Maxima and the four-column reading structure remain traceable. Save/reopen, coverage, paragraph alignment and folio tests validate the edition's construction; they do not certify literary equivalence.\n","status":"draft","topic":"construction"},"db27f42321c95d0f6f9283eb901d4e71cdad6fa35444dc83bafeb5baf615b0dc":{"alternatives":[],"citations":[{"locator":"Later grammatical development","sourceId":"later012.source"}],"exampleIds":[],"id":"later012.rule.1","label":"Additive clauses and recoverable continuation","morphologyIds":[],"notes":"","statement":"Additive clauses and recoverable continuation\n\nThe inherited independent conjunction remains available, particularly for\nantiphonal replies, cumulative oaths, lists, rhetorical emphasis and performance.\nAn additive clause can instead place **\u2019\u00e3** (Roman **\u2019oi**, analysis `:add`)\nafter its first complete phonological host. It preserves addition: it does not\nmean \u201ctherefore\u201d, \u201cthen\u201d, or \u201cbut\u201d. A speaker label or punctuation is not a host.\nThe host keeps case, number, possession, tense and force. The clause clitic is\noutside these word endings. It can mark a licensed additive answer fragment.\n\nUnmarked juxtaposition (`:cont`, no spoken segment) is licensed for a locally\nrecoverable same-actor sequence, with every original argument and verb retained.\nIt is not random deletion of \u201cand\u201d, not automatic subject omission, and not\npermission to merge speakers. In this edition two explicitly reviewed narrative\nsequences in Oberon's speech use it. Other cases retain an audible link.\n","status":"draft","topic":"construction"},"9261196ae6be642d707ce9655970cec4cf6e4143ce47bc7280d747721cfcd154":{"alternatives":[],"citations":[{"locator":"Later grammatical development","sourceId":"later012.source"}],"exampleIds":[],"id":"later012.rule.2","label":"Relations and dependent roles","morphologyIds":[],"notes":"","statement":"Relations and dependent roles\n\nInherited bound relational chains `:relpair` **\u2019y\u00eb**, `:reltriple` **\u2019y\u00ebr**,\nand `:relquad` **\u2019y\u00ebl** preserve two, three, or four analytical relation levels.\nThey follow the first host of the governed phrase and expand back to the same\nleft-edge relation stack. They are an available literary construction, not a\ncommand to replace ordinary possessives. The two 0.11 play ledgers contain no\nadjacent `of of` stacks; this edition therefore invents none to demonstrate them.\nDistinct nested heads can retain ordinary genitive marking. A human-authored\nscope analysis is required: shorter print alone does not validate a relation.\n\nThe dependent personal-pronoun allomorph `:dep` **\u2019em** can distinguish an\noblique pronoun beside a free pronoun. It retains BOTH pronouns, their referents\nand all number distinctions, including I(pl.) and we(sg.). It cannot attach to a\npossessive chain or arbitrary noun. No such collision was found in either play.\nThe finite dependent-boundary clitic `:subend` **\u2019eth** makes a clause boundary\naudible where dependent and matrix predicates happen to be identical. It does\nnot erase either predicate. An author must establish that dependency first.\n","status":"draft","topic":"construction"},"895bd09816a8b166c8c7d94a30389bedc82d66c3b81f6be158a4739874e871c3":{"alternatives":[],"citations":[{"locator":"Later grammatical development","sourceId":"later012.source"}],"exampleIds":[],"id":"later012.rule.3","label":"Dramatic repetition is evidence","morphologyIds":[],"notes":"","statement":"Dramatic repetition is evidence\n\nAll 19 adjacent repeated-word/predicate cases found in the two prior ledgers are\nretained. \u201cNo, no\u201d, \u201cwrite, write\u201d, \u201cpray, pray, pray\u201d, \u201cever, ever\u201d, \u201ca truth's a\ntruth\u201d, and \u201cwhich is which\u201d have semantic or dramatic jobs. The fairies' three\n\u201cAnd I\u201d replies, Titania's \u201cfor her sake\u201d parallelism, Hermia's cumulative oath,\nQuince's stilted instructions, Bottom's doggerel and Robin's closing appeal keep\ntheir deliberate patterns. Twenty explicit source-unit decisions replace only\nclause linkage. There is no random synonym cycling and no global deduplication.\n","status":"draft","topic":"construction"},"ccd3fc429355cfec6977379bfb1ecf85fb2de43784798fb9f4c230cb422eb5d0":{"alternatives":[],"citations":[{"locator":"Later grammatical development","sourceId":"later012.source"}],"exampleIds":[],"id":"later012.rule.4","label":"Vocabulary, identity and typography","morphologyIds":[],"notes":"","statement":"Vocabulary, identity and typography\n\nSix inherited bound grammatical forms are added to the versioned dictionary;\nthere are no new lexical roots and no changes to existing lexical forms. The\nzero continuation is a construction, not a seventh dictionary word. All 0.11\nscope labels, native vocabulary, literary exceptions, four first-person voices,\npronoun choices, wordplay decisions and exclamatory grammar remain in force.\nMaxima follows actual sentence/speaker boundaries, never page breaks. The two\nscript/reading columns retain byte-identical legacy-slot text. Source English,\nsource-unit order, line ranges, continuation metadata and quantities are exact.\n","status":"draft","topic":"construction"},"ec5eb4fc2c7e5115befd9900d50883be34973e965c0b0c91abc7b64ac62fc539":{"alternatives":[],"citations":[{"locator":"Later grammatical development","sourceId":"later012.source"}],"exampleIds":[],"id":"later012.rule.5","label":"Validation limits","morphologyIds":[],"notes":"","statement":"Validation limits\n\nBoth plays are complete; every source unit is checked and newly laid out with\nthe approved sizes, geometry, paint, leading and paragraph alignment. The delta\nlists the exact changed windows and reasons. Structural checks and translator\nself-review do not constitute independent literary certification or recovery of\nall Shakespearean metre and wordplay.\n","status":"draft","topic":"construction"},"d8ffadeddc7ddccd6b5fa196fb5df48327623b96dd637085f291289fe0e50488":{"alternatives":[],"citations":[{"locator":"Explicit source review","sourceId":"later013.source"}],"exampleIds":[],"id":"later013.names","label":"Names, homonyms and construction labels","morphologyIds":[],"notes":"","statement":"# Later dramatic Vayrshemon 0.13 \u2014 names without lookup labels\n\nThis is a targeted audit of both complete plays against the pinned 0.12 language.\nThe completed historical Bibles are untouched. No biblical text is recompiled.\n\n## Printed words and dictionary identities\n\nBottom, Flute, Snout, Cobweb and Mote are printed without the internal \u201c-name\u201d\nqualifier. Bear and odour lose the \u201c-animal\u201d and \u201c-stage\u201d lookup qualifiers.\nExplicit resolved labels also apply inside possessive chains: Bottom\u2019s name\nmust not become \u201cbottom-name\u201d again when used before another noun. Pronominal\npossessives retain my/your/our and their existing number distinctions. This is\na construction-gloss correction; it never substitutes English into native text.\n\n## Separate referents, including homonymous names\n\nDiana\u2019s altar in Midsummer belongs to Dian the goddess, not to the Widow\u2019s\ndaughter in All\u2019s Well. The two Helen allusions in Midsummer refer to Helen of\nTroy, not Helen of All\u2019s Well or Helena of Athens. Francis Flute receives his\nown identity, distinct from the Saint Francis inn-sign. Equal name sounds do\nnot establish equal people. The two new semantic entries preserve existing\nname forms; Diana\u2019s altar uses the established native goddess-name Dian.\n\n## Native ordinary vocabulary\n\nPuritan, Papist, Shrove Tuesday, centaur, Bacchanal and the epithet le Grand\nwere wrongly excused as names. Their new forms use existing native roots,\nwith precise source-specific meanings retained in the dictionary. Papist keeps\nthe source speaker\u2019s polemical context; it is not a neutral label imposed on\nmodern people. The Shrove Tuesday phrase retains that exact calendar referent.\nNo Unta weekday correspondence is invented. Centaur describes a creature class;\nBacchanal denotes the wine deity\u2019s adherent, not generic drunkenness.\n\n\u201cAmen, amen\u201d already has native **kom r\u0113\u2019ne** twice. Preserve both ratifications\nand their optative force; display the construction as **so-be(opt.)** rather\nthan hiding it behind the foreign formula. Neither play uses a Jesus entry.\nThe author\u2019s Yesh\u016ba spelling remains the choice for future occurrences.\n\n## Deliberate forms retained\n\nBottom\u2019s Ercles, Phibbus and Thisne, and the play-within-the-play\u2019s Limander,\nShafalus and Procrus, are source-grounded theatrical distortions. Do not silently\nnormalize them. Genuine names such as Mile End and the literal fairy names\nretain their referents. Limbo is a named otherworld region; the Muses and Furies\nare named mythic collectives in these passages. Low Dutch is a named language\nwith an inherited geographic form; this audit does not invent a more precise\nmodern dialect identity. Regional affiliation terms are retained as documented\nname-derived forms, not treated as unrelated ordinary lexical loans.\n\nAll four first-person perspectives, inherited clause variation, deliberate\nrepetitions, source order and English are preserved. Maxima follows names and\nactual sentence boundaries. The source-linked audit is not independent literary\ncertification or an assertion that no other translation issue can exist.\n","status":"draft","topic":"construction"},"18cbbe7d28de1d26321333a6c202ed52857db17b096a2c37cdee7a2b016e97fc":{"alternatives":[{"citations":[],"statement":"Retain full marking for deliberate anaphora, solemnity or ambiguity avoidance.","status":"draft"},{"citations":[],"statement":"Reject these proposals if human reading finds the short forms unclear.","status":"draft"}],"citations":[],"exampleIds":[],"id":"m10.rule.discourse","label":"Optional classification in discourse","morphologyIds":[],"notes":" M11 metadata correction: M10 described this as a proposal but inherited an attested default. It is not attested; the earlier frozen record remains inspectable.\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"NEW PROPOSAL for literary register: the full thing-class form remains available in every context. Optionally suppress only its outer class marker on an established, noncontrast subject/object; on a neutral predicative nominal; or on a continuing same-class nominal subject in a coordinated enumeration. First items, new subject/object referents and contrast focus retain full marking. Case and ef\u2019 event nominalization remain. These conditions supplement the M8 full-form paradigm; they are not attested facts or a universal deletion rule.","status":"draft","topic":"other"},"0daa9046698d8c1371b73c8de37958f6358306a74bedfc1453c9c16f6c6ca5b8":{"alternatives":[],"citations":[],"exampleIds":[],"id":"m11.rule.maxima","label":"Maxima at sentence initials","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Use the paired Maxima letter at each mapped sentence initial. Preserve interior spelling, clitics, roots and suffixes. Physical line wrapping never introduces capitals. Letter identities come from the chart; this explicit prose policy is a proposal informed by the archived capitalized sentence openings, not a recovered complete capitalization grammar.","status":"draft","topic":"other"},"c1c973bde3546f5b2fddcc35ffd94b1bff74bd6e8b72c5a590d8d65d30e4b9b6":{"alternatives":[],"citations":[],"exampleIds":[],"id":"m11.rule.topic","label":"Established subject as topic","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"In literary narrative, an established, noncontrast subject topic may precede its nominal predicate and final verb. A predicate-associated only adverb remains with the predicate. Retain the earlier predicate-first construction as an available alternative; do not shuffle clauses for variety. Case endings remain authoritative. This is a new discourse proposal, not attested word-order evidence.","status":"draft","topic":"other"},"cce78b8a92ca3cb1d81efd534e32d8739ee5f8c57538817a33f3325a93724418":{"alternatives":[],"citations":[],"exampleIds":[],"id":"m12.rule.continuity","label":"Optional continuous subject","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"A literary continuation may leave its immediately preceding explicit subject unspoken when the same lexical participant remains established and noncontrast. Preserve predicate, adverb scope and finite tense. Use an explicit subject at a topic change, after an interruption, for contrast or when reference is unclear. Full subject clauses remain available. This is a new proposal, not an attested rule.","status":"draft","topic":"other"},"1c6eb985f45551a57b7d808c76531a97f0578a0e4c92035c5181dd2f6c18354f":{"alternatives":[],"citations":[{"locator":"M8 literary extrapolation","sourceId":"polished"}],"exampleIds":[],"id":"m8.rule.metaphor","label":"Tempest compounds and semantic choices","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Lexicalize the proposed cloud-tower, beauty-building, belief-building, earth-dweller and sleep-see-form compounds. Interpret ly\u2019 + life as collective-our life. Use sleep as the nominal agent of surround. The temporal after-play phrase and -h\u00ebth boundary are explicit new proposals. These meanings need author review; the compiler only checks declared forms.","status":"draft","topic":"other"},"46938462e15187ecf3769d66da901e1bae459f556c845f12d9023f0566991e68":{"alternatives":[],"citations":[{"locator":"M8 literary extrapolation","sourceId":"polished"}],"exampleIds":[],"id":"m8.rule.poetic","label":"Poetic nominal classes and enumeration","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"In this literary register, lexicalized compound noun heads use the thing determiner g\u00df\u00d1et\u2019 and retain case: -get predicate/object and -l\u00c9y subject. An asyndetic list of 1\u20138 nominative subjects shares the final verb. Number is generic collective here. This does not license arbitrary English word order. Existing explicit-class constructions remain available.","status":"draft","topic":"construction"},"ac00397e70867e4ba8ab005e0e05092b8da9c33a28044fe17b24e83803102865":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.1","label":"Tracking the subject of attendant actions","morphologyIds":["midsummer.morph.cvds","midsummer.morph.juss","midsummer.morph.rep","midsummer.morph.app"],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"1. Tracking the subject of attendant actions\nThe inherited converb -\u2019es now has an explicit same-subject interpretation within an attendant-action chain. A subject switch must be stated. New -\u2019esta (cv.ds.) marks a background action whose subject differs from the main clause's subject. The background subject is explicit or locally unambiguous; the ending itself supplies no person, gender, or number. Thus Titania sleep:cvds, clowns enter:pr says that Titania sleeps while the clowns enter, not that the clowns sleep. In 0257 and 0511 this matters for stage directions; in 0372 one faithful man's holding his oath contrasts with the million who fail. A named subject with while remains an ordinary alternative; the new suffix is not required merely because English contains while. An infinitive complement is not an attendant action.\n\nThe annotated production order is stem + derivation/voice + converb. A finite tense and a converb are alternative clause forms here. Temporal anchoring comes from the main clause and context. A change from dreamer to visitor is never licensed by simply dropping the subject. Unit 0142 uses ordinary -\u2019es: the aunt telling her story is also the aunt who mistakes Puck for a stool. This contrast is a useful regression example.","status":"draft","topic":"construction"},"b25585ecb27f970dadec639da34ad71dd7db6c7c8b5eb975bf35835f231bb6c0":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.2","label":"Wishes, commands, and spells","morphologyIds":["midsummer.morph.cvds","midsummer.morph.juss","midsummer.morph.rep","midsummer.morph.app"],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"2. Wishes, commands, and spells\nThe ordinary direct imperative remains -e (imp.); an invitation or command can be refused. The inherited -\u2019ne (opt.) expresses a wish. New -\u2019rai (rit.juss.) presents a state as being imposed by a ritual utterance. It follows the tense/aspect form in the spell register: love:pr:juss, be:pr:juss. It is used in the love enchantments, reversal, and final household blessing. The ending expresses the speaker's performative intention, not an omniscient guarantee that a spell succeeds. A character can misapply a spell. An enchantment producing attraction is not consent.\n\nNegation has an explicit scope. neg:imp prohibits the imperative action. neg:pr:juss imposes the absence of the specified state. A negative quantifier such as never may instead range over a positive predicate; it is not then a second negating morpheme. In Oberon's final blessing (0750), no mark is to stand in the offspring. Translating a protective spell as a positive prediction of harm would reverse the sense. The lullaby retains its repetition as an intentional refrain. Ritual repetition is distinct from a default prefix accidentally added to every sentence.","status":"draft","topic":"construction"},"d28161b4e8a492a2065ec5b2015bc12e2ba03b9a02990b59dc6ea16959f890d7":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.3","label":"Reported claims and apparent identity","morphologyIds":["midsummer.morph.cvds","midsummer.morph.juss","midsummer.morph.rep","midsummer.morph.app"],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"3. Reported claims and apparent identity\nNew -\u2019v\u00eb (rep.) follows a finite predicate and marks information attributed to a prior speaker or report. An explicitly named source is retained when material. In 0232 Robin's identification of the sleeping man is based on his master's description; the reportative keeps that identification inside Robin's mistaken inference. It does not certify that Lysander is Demetrius. A quoted assertion is still quoted speech and need not be redundantly reportative.\n\nNew -\u2019s\u00ebm (appr.) marks an apparent or perceived proposition: seem-to-be, appear-to-do. It is not a generic past tense and does not assert deception or falsehood. Hermia's apparent scorn in 0414 belongs to a character's perception. Awakening lovers can describe appearances without settling whether the night was a dream. Attach these particles after the finite tense/aspect form; do not stack them as decoration. This edition has no productive rule for arbitrary evidential stacking. Where attribution and appearance both matter, use a full reporting clause plus an apparent predicate.","status":"draft","topic":"construction"},"5daaa27ec452054f7f611c45e96e27a0845806f4297d315b10f93cbdc9d18401":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.4","label":"Counterfactual resemblance","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"4. Counterfactual resemblance\nvenki (asif) introduces a comparison to an imagined situation. It differs from ordinary as (role/comparison) and from an open if condition. The comparison's predicate carries -\u2019ve when the situation is counterfactual or imagined as unreal. Oberon's arrow might have pierced a hundred thousand hearts (0173): the narrator need not assert that it did. Titania's pregnant friend imitates a swelling ship (0162\u20130163): woman, belly, ship, and sails remain distinct participants. This extension gives comparisons explicit scope without turning every poetic image into a literal identity.","status":"draft","topic":"construction"},"b021387b4809e404f65ca6dda497a46f95906167af0d13e00108017bf48d2856":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.5","label":"Controlled variation and information structure","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"5. Controlled variation and information structure\nKeep 0.8's object\u2013subject\u2013verb preference, differential subject marking, and recoverable topical subjects. Topic-first, contrastive object-first, direct address, and finite predicate ellipsis have discourse reasons. The lovers often repeat another speaker's exact construction to contradict it. Hermia and Helena's matched more...more clauses (0065\u20130066) preserve that parallelism rather than manufacturing synonyms. The craftsmen's hesitant fragments, fairy refrains, courtly periods, and Robin's compact asides remain different registers.\n\nBare noun adjuncts form compact classifications; descriptive count modifiers can follow the head with \u2019m\u00e7. A light preposed attribute is available in established dramatic phrases, especially names, vocatives, and predicates. This does not abolish case on the phrase head. Head-internal possessors have genitive scope; the final head bears outer case. Prefer a free relation with of or a genitive when a stack obscures the relationship: queen of the fairies, rather than an indefinitely concatenated possessive. Layout never changes the font to rescue an opaque compound.\n\nThe choice of a bare noun, thing-class introduction, pronoun, or lexical synonym follows reference and register. It is not randomized. New wood, garden, craft, and theatre vocabulary reduces pressure to reuse generic thing/person/make compounds for every image. Deliberate rhetorical recurrence remains recurrence. This is a written dramatic register, not a claim that all speakers in an imagined community use the same style.","status":"draft","topic":"construction"},"21307c209ebbe387a170140930837d4878054106ccd770d3edddf66a1dd0a555":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.6","label":"Quantity, collective reference, and numeral identity","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"6. Quantity, collective reference, and numeral identity\nGeneric one (vem) is a pronoun, not the numeral one. Numeric one uses the attested neksus; eight uses the attested krizum. The inherited ly is collective/royal we; lym identifies plural participants. Singular collective reference is not a typographical error. Dual forms are used where a pair is intended, including eyes and arms; a collective crowd is not automatically dual.\n\nDo not reinterpret the play's hundred thousand, million, miles, or leagues as different quantities because Unta is duodecimal. Decimal source quantities retain their value; lexical quantity phrases and units are explicit. Older 0.8 authored counting forms are retained for compatibility and remain separately documented from the Unta archive. This edition clarifies one versus generic one; it does not silently recase or replace every numeral in the inherited dictionary.","status":"draft","topic":"construction"},"9be49d0c085ccc31a9a902657dc1640f1b374e26d2fac98190a10b8653d51e75":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.7","label":"Orthography and the four reading columns","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"7. Orthography and the four reading columns\nThimfora and Transliteration 7 receive identical legacy slots, including Maxima. A source speech split for pagination does not create a new sentence capital. Capitalization follows actual Maxima/Minima identity pairs at sentence starts and proper names; Unicode upper/lower conversion is invalid for these encodings. Speaker labels keep their own identities. A spelling that resembles an accented Latin letter is a font slot, not an instruction to normalize it.\n\nThe construction gloss is abbreviated, in target word order: nominal case, number, person/register, voice, tense/aspect, and the new clause distinctions are explicit. pr = prs.; pa = pst.; cv.ds. = different-subject converb; rit.juss. = ritual jussive; rep. = reportative; appr. = apparent proposition; irr. = irrealis; opt. = wish. The free English column preserves the supplied text. The gloss is an explanation of construction, not a second claim to reproduce Shakespeare's English rhythm.","status":"draft","topic":"construction"},"df1da5b2edafaff65c5cbe91105423b2e4c034c74e36d41694892e7ec19371a8":{"alternatives":[],"citations":[],"exampleIds":[],"id":"midsummer.grammar.8","label":"Boundaries of this revision","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"8. Boundaries of this revision\nFour new productive suffixes are declared: -\u2019esta, -\u2019rai, -\u2019v\u00eb, -\u2019s\u00ebm. venki is a new comparative subordinator. There is no new iterativity suffix in the released transcription. Existing repetition, frequentative lexical meanings, and adverbs suffice. More extensive evidential combinations, dialect histories, phonological allomorphy, and metrical scansion remain open research topics; they are not asserted to have been solved by this play.\n","status":"draft","topic":"construction"},"291db1b6021fe6414afc936f47202d78fb9a9ebc65d86338cb777fb657eb925d":{"alternatives":[],"citations":[{"locator":"paragraphs 2 and 19","sourceId":"polished"}],"exampleIds":["polished.1","polished.2"],"id":"polished.construction","label":"Nominal conversions and clause construction","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"Retain the complete source glosses, including [b>n], [v>n], case labels, passive/perfect and modifier descriptions. Unsegmented forms remain unresolved rather than receiving guessed morpheme boundaries.","status":"uncertain","topic":"construction"},"91df2946455e4159da15d461e970efa29da5b69ba41116c4ba7734125543478f":{"alternatives":[],"citations":[{"locator":"paragraphs 0, 2, 17, 19","sourceId":"polished"}],"exampleIds":["polished.1","polished.2"],"id":"polished.pronouns","label":"Pronouns attested in the polished gloss","morphologyIds":[],"notes":"\nHistorical/reference scope: for new dramatic composition use the consolidated 0.10 reference; earlier rules retain their original version context.","statement":"The archived gloss explicitly identifies I(singular), we(singular), and it(inanimate, singular, subjective). The first two have token-level gloss alignment in polished.1; no full pronoun paradigm is inferred.","status":"attested","topic":"pronouns"},"d0674c8952197622bd024542c174b453d99bf50de8685603078c3d54c00b1ade":{"alternatives":[],"citations":[{"locator":"Complete authored source review","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"exampleIds":[],"id":"shakespeare014.review.antony-and-cleopatra.r1","label":"Antony and Cleopatra \u00b7 source decisions","morphologyIds":[],"notes":"","statement":"Complete source-linked translation review: 1322 original source blocks; 1658 layout units.\nWiki antony-and-cleopatra review 1: 00001a\u201300024a\nWiki antony-and-cleopatra review 2: 00025a\u201300064a\nWiki antony-and-cleopatra review 3: 00065a\u201300100a\nWiki antony-and-cleopatra review 4: 00101a\u201300123f\nWiki antony-and-cleopatra review 5: 00124a\u201300154a\nWiki antony-and-cleopatra review 6: 00155a\u201300173a\nWiki antony-and-cleopatra review 7: 00174a\u201300196b\nWiki antony-and-cleopatra review 8: 00197a\u201300217b\nWiki antony-and-cleopatra review 9: 00218a\u201300240a\nWiki antony-and-cleopatra review 10: 00241a\u201300266a\nWiki antony-and-cleopatra review 11: 00267a\u201300291a\nWiki antony-and-cleopatra review 12: 00292a\u201300317a\nWiki antony-and-cleopatra review 13: 00317b\u201300339a\nWiki antony-and-cleopatra review 14: 00340a\u201300364a\nWiki antony-and-cleopatra review 15: 00365a\u201300392a\nWiki antony-and-cleopatra review 16: 00393a\u201300417a\nWiki antony-and-cleopatra review 17: 00417b\u20