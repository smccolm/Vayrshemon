himfora-79","partOfSpeech":"proper","pronunciation":"hertford","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The first earldom in the sergeant's recital of Buckingham's titles.","id":"shakespeare014.lex.hertford_buckingham_title.sense","status":"draft"}],"status":"draft","variants":[]},"b351c623f0fb9b48325cd6aadb149f3dbce77944520bf5fd640ed91958e2c8a7":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"hesperides","id":"shakespeare014.lex.hesperides_garden","ipa":"","label":"hesperides_garden","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hesperides","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The garden of the Hesperides where Berowne pictures Hercules climbing trees.","id":"shakespeare014.lex.hesperides_garden.sense","status":"draft"}],"status":"draft","variants":[]},"a17a2af6fb44d795ea8f5b6630faf440d7632af8358273f5e60a9b643952328b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_hew","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_hew","exampleIds":[],"headword":"y\u00ebldest\u00eb\u00c5","id":"shakespeare014.lex.hew_cut","ipa":"","label":"hew_cut","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"y\u00fcldest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Chop or cut forcefully, applied to a shield carried on the arm. Reviewed native cutting action, without restricting the shield material to wood.","id":"shakespeare014.lex.hew_cut.sense","status":"draft"}],"status":"draft","variants":[]},"26632c5372944c09bcb8a41de299c43ca0e033d241a12873a0a962ef501db807":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from hide, wait","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from hide, wait","exampleIds":[],"headword":"o\u00c3brawa\u00d9gum","id":"shakespeare014.lex.hidden_wait","ipa":"","label":"hidden_wait","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ojzhbrawanggum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Remain hidden, here fear showing itself in the eye; native formation rather than the unreviewed lur\u00ebn spelling.","id":"shakespeare014.lex.hidden_wait.sense","status":"draft"}],"status":"draft","variants":[]},"4341ec6fd0bbb42f36dff8c31a4ee975a1f683d10906faa954d8ed9511ccb86f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: winter","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: winter","exampleIds":[],"headword":"vernil","id":"shakespeare014.lex.hiems_winter_figure","ipa":"","label":"hiems_winter_figure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"vernil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The personification introduced by a Latin name in the source. The native name uses the seasonal root.","id":"shakespeare014.lex.hiems_winter_figure.sense","status":"draft"}],"status":"draft","variants":[]},"f023b9d4e024fe1a252c97a37817cdf3a13a819f65881834605bff45602fc673":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"hinkli","id":"shakespeare014.lex.hinckley_fair","ipa":"","label":"hinckley_fair","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hinkli","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Fair where William lost a sack.","id":"shakespeare014.lex.hinckley_fair.sense","status":"draft"}],"status":"draft","variants":[]},"084d08145b2637182c8225481ba775035ced929c95098a52310002a8f1546cf6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: foreknow + thwart","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: foreknow + thwart","exampleIds":[],"headword":"p\u00e1nh\u00c5b\u00cdzaril","id":"shakespeare014.lex.hindering_knowledge","ipa":"","label":"hindering_knowledge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4nh\u0101b\u0117rzaril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Prior intelligence enabling anticipation or frustration of a plan. Aufidius asks what could become action before Rome could circumvent it; no specific spy or completed Roman attack is invented.","id":"shakespeare014.lex.hindering_knowledge.sense","status":"draft"}],"status":"draft","variants":[]},"4ebbe3ec409c283a7713f81214106b7a887b62b8dd1ce2d28614077e92cb191c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: hinder","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: hinder","exampleIds":[],"headword":"zaril","id":"shakespeare014.lex.hindrance_obstacle","ipa":"","label":"hindrance_obstacle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zaril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Something obstructing the intended action, source impediment in the account the tribunes propose. Explicit nominal hinder without inventing a particular obstruction.","id":"shakespeare014.lex.hindrance_obstacle.sense","status":"draft"}],"status":"draft","variants":[]},"abac7ca57b4141de67a4f87d725d6f76ca34eb0d96335eb40929cbe4ffa12b93":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"hiparkus","id":"shakespeare014.lex.hipparchus_freedman","ipa":"","label":"hipparchus_freedman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hiparkus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The man Antony describes as his freed bondman, offered for retaliation. Not a namesake astronomer or a generic slave title.","id":"shakespeare014.lex.hipparchus_freedman.sense","status":"draft"}],"status":"draft","variants":[]},"bda30c3a06b136423e8b45ad2ce2729294c1ab376dd6114ae12f7ed5e744bdb0":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hipokrates","id":"shakespeare014.lex.hippocrates_physician","ipa":"","label":"hippocrates_physician","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hipokrates","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The medical authority whom Evans calls Hibbocrates alongside Galen.","id":"shakespeare014.lex.hippocrates_physician.sense","status":"draft"}],"status":"draft","variants":[]},"63415f929e33047fe709b53d9d5619ecefcb94e2d61a4a64902d6a143f