","variants":[]},"e0e43aa30fe408099ff1e7df3a3be240797314533efd928bf1f98cfd21e270c8":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","sourceId":"shakespeare014.source.henry-vi-part-2.r2"}],"etymology":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","exampleIds":[],"headword":"viminy\u00eblyemar","id":"shakespeare014.lex.drama_native_pinnace_vessel","ipa":"","label":"drama_native_pinnace_vessel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminy\u00fclyemar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r2"}],"definition":"The small vessel at anchor in the Downs, later named in Suffolk's scorn for its captain.","id":"shakespeare014.lex.drama_native_pinnace_vessel.sense","status":"draft"}],"status":"draft","variants":[]},"f851cf872756b15ce146188afdd18f8621f7d36e58a74025bbcb0cd0cfd7f44c":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","exampleIds":[],"headword":"tremborelmem","id":"shakespeare014.lex.drama_native_pint_measure","ipa":"","label":"drama_native_pint_measure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tremborelmem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The source pint as a liquid-volume unit in the guard\u2019s threat to shed blood. Native cup-measure names the unit. Its historical size is left unspecified.","id":"shakespeare014.lex.drama_native_pint_measure.sense","status":"draft"}],"status":"draft","variants":[]},"16b9a6e09bffec189c94f51bc0d1fa13c76f26c6ff177433686de21db871854f":{"audioLinks":[],"citations