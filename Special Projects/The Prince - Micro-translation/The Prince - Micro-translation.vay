.r1"}],"definition":"Deal in evasive words, Antony\u2019s palter alongside dodge. Native evade-speak; preserves verbal prevarication without asserting a particular new false statement.","id":"shakespeare014.lex.evasive_speech.sense","status":"draft"}],"status":"draft","variants":[]},"b1dd102854ce90a65c08c241f894ad9d78fddceddbba60015d2a7d88309dc5df":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_eve","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_eve","exampleIds":[],"headword":"ev","id":"shakespeare014.lex.eve_source","ipa":"","label":"eve_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ev","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Eve, the named figure evoked by the apple comparison in Sonnet 93. Retains the historical proper-name form; the apple is Shakespeare\u2019s allusion, not an alteration of Genesis or an ordinary borrowed noun.","id":"shakespeare014.lex.eve_source.sense","status":"draft"}],"status":"draft","variants":[]},"f90af46db96bbc6a288137a354f4d6161ea1707ac9d85e2f16081b753d913053":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: drama_native_pair + complete","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: drama_native_pair + complete","exampleIds":[],"headword":"\u00d5\u00c5tus gurgrasna","id":"shakespeare014.lex.even_numerical_parity","ipa":"","label":"even_numerical_parity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"\u0167h\u0101tus gurgrasna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"All members can be paired. Dumaine remarks that four lovers now make an even company.","id":"shakespeare014.lex.even_numerica