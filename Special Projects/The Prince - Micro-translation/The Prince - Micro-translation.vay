turn","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: tongue + turn","exampleIds":[],"headword":"tomilelyi\u00d1","id":"shakespeare014.lex.translate_tongue","ipa":"","label":"translate_tongue","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tomilelyich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Change from one language or register into another; Westmoreland applies the verb to the archbishop himself.","id":"shakespeare014.lex.translate_tongue.sense","status":"draft"}],"status":"draft","variants":[]},"5a04c42358d1e510717e20f7be323bffe9325d0f05ee84e2f649c5c9a39e60ac":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: beyond + go","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: beyond + go","exampleIds":[],"headword":"nathavim\u00c3\u00cd","id":"shakespeare014.lex.transmigrate_depart","ipa":"","label":"transmigrate_depart","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"nathavimjzh\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Pass beyond the present embodied condition, Antony\u2019s pompous circumlocution for what occurs when the animal\u2019s elements leave. Native beyond-go preserves the evasive joke without imposing a specific destination or doctrine of rebirth.","id":"shakespeare014.lex.transmigrate_depart.sense","status":"draft"}],"status":"draft","variants":[]},"eff00935293ba8bd5cf7efbedf7e31fc2a75ab4b86d73e28bc878f19c5be2415":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: change + art","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: change + art","exampleIds":[],"headword":"\u00e3lumjw\u00eb