":"thimfora-79","partOfSpeech":"noun","pronunciation":"pomz\u00f4lborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Carrying bag associated here with schooling, native school + bag. Does not add a book inventory or a particular strap construction.","id":"shakespeare014.lex.satchel_bag.sense","status":"draft"}],"status":"draft","variants":[]},"931cd31aaa86e3eb2262fbbaf95bada1f85650235cde2dcede21efa29fe4f32c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: smooth + silk","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: smooth + silk","exampleIds":[],"headword":"siv\u00eblshilin","id":"shakespeare014.lex.satin_cloth","ipa":"","label":"satin_cloth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"siv\u00fclshilin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The smooth silk ordered on credit by Falstaff.","id":"shakespeare014.lex.satin_cloth.sense","status":"draft"}],"status":"draft","variants":[]},"331574b5b2ad418f207070f7fc276a65707998a366f52cd8f4979a78e830974c":{"audioLinks":[],"citations":[{"locator":"Authored source-calendar label: Unta spoken ordinal plus day; not a native-calendar equivalence.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored source-calendar label: Unta spoken ordinal plus day; not a native-calendar equivalence.","exampleIds":[],"headword":"p\u00c9rsus\u2019t yel","id":"shakespeare014.lex.saturday_source","ipa":"","label":"saturday_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00e4rsus\u2019t yel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Saturday in the source English seven-day week. Authored native calendar label using Unta word ordinal seven + day, with Sunday explicitly first in this source-calendar convention. Not a claim about an attested native calendar or a forced substitution of the religious Sabbath observance.","id":"shakespeare014.lex.saturday_source.sense","status":"draft"}],"status":"draft","variants":[]},"d0c7ee524c2fd6cee0fab7eaa394d80e126a8fe61ba09bf6024465a3dc689390":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic proper-name adaptation, distinct from native common vocabulary.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Author-permitted phonetic proper-name adaptation, distinct from native common vocabulary.","exampleIds":[],"headword":"saturn","id":"shakespeare014.lex.saturn_source","ipa":"","label":"saturn_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"saturn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Saturn, the named heavy and slow planetary/deity figure made to laugh and leap by April in Sonnet 98; retains the source personification and does not become an ordinary word for heaviness.","id":"shakespeare014.lex.saturn_source.sense","status":"draft"}],"status":"draft","variants":[]},"d623bf8365a018812eafe291f7b19efbce50a36a326a47246e591051a09a28f1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"saturnin","id":"shakespeare014.lex.saturnine_emperor_short","ipa":"","label":"saturnine_emperor_short","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"saturnin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"The shorter address for the same emperor Saturninus.","id":"shakespeare014.lex.saturnine_emperor_short.sense","status":"draft"}],"status":"draft","variants":[]},"9f7cd231ab9afeca8040b07997fd14471ee4f25ee9946be7ea175f7105491aae":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"saturninus","id":"shakespeare014.lex.saturninus_roman_emperor","ipa":"","label":"saturninus_roman_emperor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"saturninus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"The late emperor's firstborn son and Bassianus's elder brother.","id":"shakespeare014.lex.saturninus_roman_emperor.sense","status":"draft"}],"status":"draft","variants":[]},"5623b0633fe00c4e6c9194d8447d665700006d4a4e034ef1753e105ccdcb63b3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: goat_animal + person","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: goat_animal + person","exampleIds":[],"headword":"kr\u00c5v\u00ebms\u00dflum","id":"shakespeare014.lex.satyr_mythic","ipa":"","label":"satyr_mythic","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kr\u0101v\u00fcms\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The goatlike mythic figure of Hamlet's comparison. Distinct from a mortal given a foreign proper name.","id":"shakespeare014.lex.satyr_mythic.sense","status":"draft"}],"status":"draft","variants":[]},"545a683c1548144cec33b55aae30681e89f3fab8fd68a212d4352734b600aabd":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: taste + liquid","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: taste + liquid","exampleIds":[],"headword":"\u00d1\u00e9\u00d9renna","id":"shakespeare014.lex.sauce","ipa":"","label":"sauce","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ch\u00e9ngrenna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A flavouring accompaniment to food, the bitter sauces of Sonnet 118; native taste-liquid, distinct from a medical potion although the poem links the metaphors.","id":"shakespeare014.lex.sauce.sense","status":"draft"}],"status":"draft","variants":[]},"4761aedb591348fdde63011421afea2192883147dc7c19558b973d17dd4ac0f3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of sauce","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of sauce","exampleIds":[],"headword":"\u00d1\u00e9\u00d9renna","id":"shakespeare014.lex.sauce_bitter_words","ipa":"","label":"sauce_bitter_words","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ch\u00e9ngrenna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Season or accompany with sauce, used figuratively for answering with bitter words. Explicit action use of native taste-liquid; no actual food preparation is added to the scene.","id":"shakespeare014.lex.sauce_bitter_words.sense","status":"draft"}],"status":"draft","variants":[]},"b26cb776a189511267151f6caef7bd3e9e7c4b8a8ff7794b9896877800c32645":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: leap + dance","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: leap + dance","exampleIds":[],"headword":"talvalen","id":"shakespeare014.lex.saultier_rustic_dancer","ipa":"","label":"saultier_rustic_dancer","notes":"","orthographyId":"t