rceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The Nurse's deceased child who was the same age as Juliet.","id":"shakespeare014.lex.susan_nurse_child.sense","status":"draft"}],"status":"draft","variants":[]},"e8a20eaedce84d4f35297c4ecad77b1019f51f96274b1161b9994179becf3dd3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of suspect","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of suspect","exampleIds":[],"headword":"lamvesw\u00c5vum","id":"shakespeare014.lex.suspicion","ipa":"","label":"suspicion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamvesw\u0101vum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"An adverse possibility entertained without proof, the suspect of Sonnets 70 and following; nominal suspicion, not a demonstrated fault.","id":"shakespeare014.lex.suspicion.sense","status":"draft"}],"status":"draft","variants":[]},"3ea48297ef80023aaf7f6722ccd801ab8f29976e15b193dd932416df677e05cb":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of doubt","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of doubt","exampleIds":[],"headword":"lamves","id":"shakespeare014.lex.suspicion_personified","ipa":"","label":"suspicion_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lamves","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Suspicion personified as a watchful doorkeeper at the sensory feast; not a new human character.","id":"shakespeare014.lex.suspicion_personified.sense","status":"draft"}],"status":"draft","variants":[]},"6e46a401dc43f114ad76eb1f6fa23ec31dc6fcfe8e66243c6fe8f27ba09b3e58":{"audioLinks":[],"citations":[{"locator":"Author-permitted geograph