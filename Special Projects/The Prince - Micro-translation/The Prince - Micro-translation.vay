dmp\u00f4in","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The nut which bursts in a farmer's fire in Petruchio's comparison.","id":"shakespeare014.lex.chestnut_edible_nut.sense","status":"draft"}],"status":"draft","variants":[]},"33e38d8e511ac225b25a3251120374232f2b859618dd6098c99661bdf578dcde":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"ketas","id":"shakespeare014.lex.chetas_trojan_gate","ipa":"","label":"chetas_trojan_gate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ketas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"definition":"Fourth gate in the Prologue's list.","id":"shakespeare014.lex.chetas_trojan_gate.sense","status":"draft"}],"status":"draft","variants":[]},"da2230bdf696d800d2bc90bbdb90a58c838eb2c394e790ab059bb1497c4ddab9":{"audioLinks":[],"citations":[{"locator":"Authored native compound: mouth + crush","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: mouth + crush","exampleIds":[],"headword":"tomgr\u00c9t","id":"shakespeare014.lex.chew_food","ipa":"","label":"chew_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tomgr\u00e4t","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Work food with the mouth, native mouth-crush, used metaphorically for Orlando considering sweet and bitter fancy. Not an assertion that he was actually eating.","id":"shakespeare014.lex.chew_food.sense","status":"draft"}],"status":"draft","variants":[]},"4d3da3fca2f6e6881e5334055e41ad18a8b1f3942f2aff2bbd4f1a4622b9233d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: hen + child","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: hen + child","exampleIds":[],"headword":"keklapel","id":"shakespeare014.lex.chick_endearment","ipa":"","label":"chick_endearment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"keklapel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A young domestic bird used affectionately by Antony to Cleopatra. Native bird-and-child compound, not a respelled English chuck.","id":"shakespeare014.lex.chick_endearment.sense","status":"draft"}],"status":"draft","variants":[]},"1f76d5a364ba8a46856b1a71cd7809c311ac2cebcf6e9fb1b954a1b687da6963":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: chief + kjv_bishop_philippians","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: chief + kjv_bishop_philippians","exampleIds":[],"headword":"harennao\u00c3s\u00dflum","id":"shakespeare014.lex.chief_bishop","ipa":"","label":"chief_bishop","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harennaojzhs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The Archbishop of York whom the conspirators intend to recruit.","id":"shakespeare014.lex.chief_bishop.sense","status":"draft"}],"status":"draft","variants":[]},"31ec2407f0d54185b032d6105fc2bfbad36e4a3391dc6bc013c2167479a2e291":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: chief + magistrate_official","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: chief + magistrate_official","exampleIds":[],"headword":"harennerbw\u00c5vumenvar\u00dfnen","id":"shakespeare014.lex.chief_justice_lord","ipa":"","label":"chief_justice_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harennerbw\u0101vumenvar\u014dnen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The senior judge who questioned Falstaff about the Gad's Hill robbery.","id":"shakespeare014.lex.chief_justice_lord.sense","status":"draft"}],"status":"draft","variants":[]},"da017701267d8f454a06681a527ef61b0483753e4ed8188eadd6a7425711db16":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: birth + bed","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: birth + bed","exampleIds":[],"headword":"a\u00d9\u00d5\u00dfrbelen","id":"shakespeare014.lex.childbed_recovery","ipa":"","label":"childbed_recovery","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ang\u0167h\u014drbelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Bed-rest associated with childbirth, the lady who lies in; not mere confinement in a room and no invented infant outcome or illness.","id":"shakespeare014.lex.childbed_recovery.sense","status":"draft"}],"status":"draft","variants":[]},"0721e175965bb1422f266c4889e75821a5538b10c4519a000b73b35073dab69c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"\u00d1ilderik","id":"shakespeare014.lex.childeric_king","ipa":"","label":"childeric_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"childerik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The king deposed by Pepin in Canterbury's account.","id":"shakespeare014.lex.childeric_king.sense","status":"draft"}],"status":"draft","variants":[]},"f44e1c76af1bf587c8efb108c32574b3d38d40a5daf82c8117ac879bf4e5c82e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_chimney","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_chimney","exampleIds":[],"headword":"s\u00ebrunmarjo\u00d9","id":"shakespeare014.lex.chimney_smoke","ipa":"","label":"chimney_smoke","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"s\u00fcrunmarjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The smoke passage from a house, native smoke-way, reused for wit escaping with smoke. Not a window or a newly added fire onstage.","id":"shakespeare014.lex.chimney_smoke.sense","status":"draft"}],"status":"draft","variants":[]},"55747f11ba2c6d714f2b122eac29554a64618ae6c9116c4d137345c0af2caeed":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fine + clay_material + vessel","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: fine + clay_material + vessel","exampleIds":[],"headword":"elinjo\u00d9olyems\u00d7borel","id":"shakespeare014.lex.china_dish_porcelain","ipa":"","label":"china_dish_porcelain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elinjongolyems\u0113borel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"Fine ceramic tableware beyond the price of the household's ordinary dish. A material designation for the serving vessel.","id":"shakespeare014.lex.china_dish_porcelain.sense","status":"draft"}],"status":"draft","variants":[]},"71f1f7d22d2df607b101b45c3cd4062c2ecf3d9e811b6e2663479cbaa3ddeaeb":{"audioLinks":[],"citations":[{"locator":