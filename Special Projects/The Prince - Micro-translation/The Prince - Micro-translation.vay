ally Coriolanus in this scene; not arithmetic addition or a different person.","id":"shakespeare014.lex.honorific_addition.sense","status":"draft"}],"status":"draft","variants":[]},"6b3a6fdfef2a8e35e1bb24cc2093acc39cb2584a891bfae86083c3dfbf3dade1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: honour + achieve + ability + state","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: honour + achieve + ability + state","exampleIds":[],"headword":"arvlamk\u00c7fag\u00ebajw\u00ebnlen","id":"shakespeare014.lex.honours_long_word","ipa":"","label":"honours_long_word","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arvlamk\u00e3fag\u00fcajw\u00fcnlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"An ostentatiously long native word for the state of being able to attain honours in Costard's comparison with the page's height.","id":"shakespeare014.lex.honours_long_word.sense","status":"draft"}],"status":"draft","variants":[]},"1142c01069f38c25a0569260bd0610d1d1dd49364f628a9dfa49905dccd17108":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: blindfold + game","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: blindfold + game","exampleIds":[],"headword":"omifelenkl\u00e1rjemfaln","id":"shakespeare014.lex.hoodman_game","ipa":"","label":"hoodman_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"omifelenkl\u00f4rjemfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A game played blindfolded. Hamlet asks what devil could have duped his mother at it.","id":"shakespeare014.lex.hoodman_game.sense","status":"draft"}],"status":"draft","variants":[]},"a11adf1945391c6e040f84785e233c7e866bd0f85b20f1b