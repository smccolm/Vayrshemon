.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kaliban","id":"shakespeare014.lex.caliban_sycorax_son","ipa":"","label":"caliban_sycorax_son","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kaliban","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"Sycorax's son, who claims the island through his mother.","id":"shakespeare014.lex.caliban_sycorax_son.sense","status":"draft"}],"status":"draft","variants":[]},"c9fb1de8563d5243d44b9c1841d2ecc760e6a24b56aaa17640eb11c1d22ce4e4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kalipolis","id":"shakespeare014.lex.calipolis_stage","ipa":"","label":"calipolis_stage","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kalipolis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The theatrical name in Pistol's quotation about feeding and growing fat.","id":"shakespeare014.lex.calipolis_stage.sense","status":"draft"}],"status":"draft","variants":[]},"9bccbdcfd9fd2a8e2db0fc687b9bf8ff150d4718dda0a84430c500e43833dee5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: shoulder + gun_weapon","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: shoulder + gun_weapon","exampleIds":[],"headword":"larnaorthreninzarunkerth","id":"shakespeare014.lex.caliver_gun","ipa":"","label":"caliver_gun","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"larnaorthreninzarunkerth","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henr