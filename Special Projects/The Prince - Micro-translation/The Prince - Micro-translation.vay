"id":"shakespeare014.lex.laura_petrarch_beloved.sense","status":"draft"}],"status":"draft","variants":[]},"29195f8dfb89267a5c6f854d39d59fa5acf1270a42cf67e8b1b60698b4fdc1af":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: victory + leaf","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: victory + leaf","exampleIds":[],"headword":"zifty\u00eblet","id":"shakespeare014.lex.laurel_leaf","ipa":"","label":"laurel_leaf","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zifty\u00fclet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The laurel leaf/crown convention associated with victory in Cleopatra\u2019s farewell. Native victory-leaf retains that emblem without claiming every victory leaf is the same botanical species.","id":"shakespeare014.lex.laurel_leaf.sense","status":"draft"}],"status":"draft","variants":[]},"45f8f7234c5ad326e77c67dc62482c8abb356686fdedee19116b2cb352423d36":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"lorens pultni","id":"shakespeare014.lex.laurence_poultney_parish","ipa":"","label":"laurence_poultney_parish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lorens pultni","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The London parish named in the surveyor's recollection of Buckingham's questioning.","id":"shakespeare014.lex.laurence_poultney_parish.sense","status":"draft"}],"status":"draft","variants":[]},"ebcae72cec438de952d013c920e236f51714c32c25259f3deac6f8482af76504":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: purple + herb","sourc