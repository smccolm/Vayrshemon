\u00e7l\u00d7ono\u00c3t\u00e7","id":"shakespeare014.lex.priory_religious_house","ipa":"","label":"priory_religious_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grelprod\u00f4peshem\u016bl\u0113onojzht\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"A religious house under a prior, named alongside the abbeys in John's order.","id":"shakespeare014.lex.priory_religious_house.sense","status":"draft"}],"status":"draft","variants":[]},"3f7959f72482d357aa628d4995dc8d4b73f432f79aae2fd16218c49639d32f7a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"priskian","id":"shakespeare014.lex.priscian_grammarian","ipa":"","label":"priscian_grammarian","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"priskian","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The grammarian figuratively scratched by Nathaniel's faulty Latin.","id":"shakespeare014.lex.priscian_grammarian.sense","status":"draft"}],"status":"draft","variants":[]},"d79c1e1c3039aa4efd93c2d159c4be041cee73d68f849207bec9340843e40e42":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_prisoner","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_prisoner","exampleIds":[],"headword":"kl\u00e1rjems\u00dflum","id":"shakespeare014.lex.prisoner","ipa":"","label":"prisoner","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kl\u00f4rjems\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A person or personified honour held captive; confinement does not imply justified conviction.","id":"shakespeare014.lex.prisoner.sense","status":"draft"}],"status":"draft","variants":[]},"05541df2c78bb8588745d4529094196cdde3db011c03d3a643b99e341b19d43c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: secret + know","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: secret + know","exampleIds":[],"headword":"o\u00c3brenh\u00c5b\u00cd","id":"shakespeare014.lex.private_knowing","ipa":"","label":"private_knowing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"ojzhbrenh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Privately aware of someone\u2019s wishes, Alexas\u2019s personification of bed sheets. Distinct from privy meaning latrine.","id":"shakespeare014.lex.private_knowing.sense","status":"draft"}],"status":"draft","variants":[]},"f1303d0001d6978fc2729b992032f92a86cc51f00c49f0703f296c9abbcae7bf":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of reward","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of reward","exampleIds":[],"headword":"sezif\u00c7\u00c3f\u00c5wen","id":"shakespeare014.lex.prize","ipa":"","label":"prize","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sezif\u00e3jzhf\u0101wen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The precious object sought by the rival poet\u2019s figurative voyage in Sonnet 86; the beloved as desired reward, not an asserted competition payment.","id":"shakespeare014.lex.prize.sense","status":"draft"}],"status":"draft","variants":[]},"6d1fcf38d3bfa6f852227368735baeb00d011bc037b771859f43aa72e95b2b27":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of value","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of value","exampleIds":[],"headword":"minlam","id":"shakespeare014.lex.prize_value","ipa":"","label":"prize_value","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"minlam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Hold in high value or esteem, verbal conversion of native value. Distinct from the prize as a reward won or sought.","id":"shakespeare014.lex.prize_value.sense","status":"draft"}],"status":"draft","variants":[]},"11b6942ce21e8d7b2b662cb818d3ba0b476a639a9d971924a1957e8f8b987445":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"prokne","id":"shakespeare014.lex.procne_philomels_sister","ipa":"","label":"procne_philomels_sister","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prokne","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"Philomela\u2019s sister, invoked by Titus as the precedent for his revenge on the mother of Lavinia\u2019s attackers.","id":"shakespeare014.lex.procne_philomels_sister.sense","status":"draft"}],"status":"draft","variants":[]},"9384f74e681aa8393cfcfbdde7c0c28b25b82bd6231019536e620adece1ec0d2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: province_region + kjv_governor","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: province_region + kjv_governor","exampleIds":[],"headword":"var\u00dfnenjo\u00d9var\u00dfnens\u00dflum","id":"shakespeare014.lex.proconsul_command","ipa":"","label":"proconsul_command","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnenjongvar\u014dnens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The provincial command conferred on Lucius by the emperor, distinguished from his earlier role as ambassador.","id":"shakespeare014.lex.proconsul_command.sense","status":"draft"}],"status":"draft","variants":[]},"d537ad1289c666c9b7ab7626d8d73433d96267d089575f017ac3bd5839a18e59":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"prokuleius","id":"shakespeare014.lex.proculeius_caesar_agent","ipa":"","label":"proculeius_caesar_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prokuleius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Caesar\u2019s agent whom dying Antony recommends Cleopatra trust. His identity is not merged with another Roman officer or given an internal suffix in the printed name.","id":"shakespeare014.lex.proculeius_caesar_agent.sense","status":"draft"}],"status":"draft","variants":[]},"d972aacfc6ed7aadbe4c7e28d07e91dc43ff5cabc446b45018fca9861c385c75":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from give, abundance","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from give, abundance","exampleIds":[],"headword":"f\u00c5wgimamem","id":"shakespeare014.lex.prodigal_give","ipa":"","label":"prodigal_give","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"f\u0101wgimamem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Lavish or freely spending, in Venus\u2019s procreation argument; not simply charitable or morally condemned.","id":"shakespeare014.lex.prodigal_give.sense","status":"draft"}],"status":"draft","variants":[]},"1c50a0a9a5f7f325cd22f95a6c8635f5467e32bbe4b5392cbae65c9e2922bb45":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: prodigal_give","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: prodigal_give","exampleIds":[],"headword":"f\u00c5wgimamems\u00dflum","id":"shakespeare014.lex.prodigal_person","ipa":"","label":"prodigal_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u0101wgimamems\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A prodigal giver, here the paradoxical miserly spendthrift tongue, not a runaway child.","id":"shakespeare014.lex.prodigal_person.sense","status":"draft"}],"status":"draft","variants":[]},"bdb83e0c2cbc1f80f685da103822c08a92daa804a418526b19b61f5d22526f8e":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from wonder, sign","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from wonder, sign","exampleIds":[],"headword":"h\u00c9ft\u00cdjelam","id":"shakespeare014.lex.prodigy_omen","ipa":"","label":"prodigy_omen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"h\u00e4ft\u0117rjelam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An extraordinary sign interpreted as portentous, not a talented child.","id":"shakespeare014.lex.prodigy_omen.sense","status":"draft"}],"status":"draft","variants":[]},"595a6c61675d0cc5ab6c142d712632bd6abf15b09810eab456dd474bd1cb6157":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_profane","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_profane","exampleIds":[],"headword":"\u00e1pe\u00dbema\u00d9","id":"shakespeare014.lex.profane","ipa":"","label":"profane","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"\u00f4peshemang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Violate or desecrate what is treated as sacred; applied to virtue in a deceptive man.","id":"shakespeare014.lex.profane.sense","status":"draft"}],"status":"draft","variants":[]},"4648f91b185e8930b324f185d200424e66b9dbc9485d12c67117b16707b42318":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of benefit","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of benefit","exampleIds":[],"headword":"farmin","id":"shakespeare014.lex.profit_advantage","ipa":"","label":"profit_advantage","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farmin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Benefit found through refusal of harmful prayers; no compulsory monetary return or new amount.","id":"shakespeare014.lex.profit_advantage.sense","status":"draft"}],"status":"draft","variants":[]},"4634e3b27f1713e5188fb1a2bfd3ee2e026ac2538929f6cc3f3f31fd483cb23e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"prometeus","id":"shakespeare014.lex.prometheus_fire_giver","ipa":"","label":"prometheus_fire_giver","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prometeus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The fire-bringer named in Berowne's praise of women's eyes.","id":"shakespeare014.lex.prometheus_fire_giver.sense","status":"draft"}],"status":"draft","variants":[]},"b5ff49631ca3eb9150f347daed0ea3905ca838b7245eb24fe82d6deb0092f5f8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: defend","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: defend","exampleIds":[],"headword":"jemzeth","id":"shakespeare014.lex.proof_resistant","ipa":"","label":"proof_resistant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"jemzeth","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Resistant to penetration or attack, comparing hearts with shields; not a proof of a proposition or printed proof page.","id":"shakespeare014.lex.proof_resistant.sense","status":"draft"}],"status":"draft","variants":[]},"f21c6b0a5d8c817ea3f72b25ef819743bf04f418ea004645c50c35cb2b3c7b8a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of possession","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of possession","exampleIds":[],"headword":"k\u00cfba\u00d1len","id":"shakespeare014.lex.property_interest","ipa":"","label":"property_interest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"k\u00cfbachlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A claimed proprietary stake in the source\u2019s marital rhetoric; not monetary interest, a rate, or translator endorsement of ownership of a person.","id":"shakespeare014.lex.property_interest.sense","status":"draft"}],"status":"draft","variants":[]},"d21dfded6cdf84c4831275d2409b06487f686b077042310d0e5fe50c9fe8263c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_prophesy","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_prophesy","exampleIds":[],"headword":"p\u00e1tonda","id":"shakespeare014.lex.prophesy","ipa":"","label":"prophesy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"p\u00f4tonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Speak a prophecy, explicitly of the youth\u2019s death here; the fear-driven source is retained.","id":"shakespeare014.lex.prophesy.sense","status":"draft"}],"status":"draft","variants":[]},"ecb483741b5d4196656180e102aff03aa698f4cf1c5737c3fc9e922533a27a72":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"propontik","id":"shakespeare014.lex.propontic_sea_water","ipa":"","label":"propontic_sea_water","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"propontik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The water Othello names between the Pontic and the Hellespont.","id":"shakespeare014.lex.propontic_sea_water.sense","status":"draft"}],"status":"draft","variants":[]},"9a6a29e0a14ffcfb92c51b6f0ad83f8b43389485b526222bcc55cbc6fa2fd4db":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"proserpin","id":"shakespeare014.lex.proserpine_flower_queen","ipa":"","label":"proserpine_flower_queen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"proserpin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The goddess with whom the Daughter imagines gathering flowers among the blessed.","id":"shakespeare014.lex.proserpine_flower_queen.sense","status":"draft"}],"status":"draft","variants":[]},"e259f2a6d2bac08eab1c7ae081e91376160bb6ba98e47a9c4465195465352946":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"prosper","id":"shakespeare014.lex.prosper_caliban_short","ipa":"","label":"prosper_caliban_short","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prosper","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The shortened form of Prospero's name used by Caliban and later by Alonso when he hears it in the thunder.","id":"shakespeare014.lex.prosper_caliban_short.sense","status":"draft"}],"status":"draft","variants":[]},"556197de70f8667e06e20c5ab98427ca84ab10d5f351bd062820ab6bf4e69e7d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"prospero","id":"shakespeare014.lex.prospero_milan_duke","ipa":"","label":"prospero_milan_duke","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prospero","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The former duke of Milan, Miranda's father and Ariel's master.","id":"shakespeare014.lex.prospero_milan_duke.sense","status":"draft"}],"status":"draft","variants":[]},"2f6956fbefe8586c5d32a54e3be189d4b38395cd14fc14b6db0b2e776