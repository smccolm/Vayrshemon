564d7da6cf2a80d3ceda7bc66706b87619c7c78ed969a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"mankus","id":"shakespeare014.lex.manchus_king","ipa":"","label":"manchus_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"mankus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Manchus of Arabia as printed in the local source. Preserve the personal designation rather than harmonizing to another historical spelling.","id":"shakespeare014.lex.manchus_king.sense","status":"draft"}],"status":"draft","variants":[]},"906a9587297cc1c2b432284565f769ff1573a3a44a287ddbe211724faf45aa5c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_mandrake","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_mandrake","exampleIds":[],"headword":"yel\u00c5ven","id":"shakespeare014.lex.mandragora_plant","ipa":"","label":"mandragora_plant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yel\u0101ven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The mandrake preparation Cleopatra asks to drink to sleep through Antony\u2019s absence. Reuses the native plant name, without importing Genesis participants or asserting medical efficacy or dosage.","id":"shakespeare014.lex.mandragora_plant.sense","status":"draft"}],"status":"draft","variants":[]},"cb79c30c784bc51ca2e70eb5cec4801ed868a62d0697aaae6fbe2a78c08de2cd":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from neck, hair","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from neck, hair","exampleIds":[],"headword":"harenkl\u00e1rf\u00ebl","id":"shakespeare014.lex.mane","ipa":"","label":"mane","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harenkl\u00f4rf\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The long hair along a horse\u2019s neck.","id":"shakespeare014.lex.mane.sense","status":"draft"}],"status":"draft","variants":[]},"941cac8a4ff0b6f95bae774d324e1b7c768fb785cbcd184fe3340b57d020feca":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: cut + break","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: cut + break","exampleIds":[],"headword":"dest\u00eb\u00c5ika\u00d9","id":"shakespeare014.lex.mangle_tear","ipa":"","label":"mangle_tear","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dest\u00fc\u0101ikang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Tear or cut destructively, figuratively dishonor mangling judgment. Native cut-break distinguishes the action from a tear shed by the eye.","id":"shakespeare014.lex.mangle_tear.sense","status":"draft"}],"status":"draft","variants":[]},"9a5edcefde04a4fe2abf34585e5be064ef94f3fb49b4c9d17fe2ad6aa519212c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of fill","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of fill","exampleIds":[],"headword":"plest","id":"shakespeare014.lex.manned_staffed","ipa":"","label":"manned_staffed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"plest","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Fill a ship with the necessary personnel, in the comparison of fleets and proposed fully manned remainder. Native fill made contextually specific; no implied requirement that a generic crew can only contain males.","id":"shakespeare014.lex.manned_staffed.sense","status":"draft"}],"status":"draft","variants":[]},"74d88633e60c0c75c70c48ac33bc6266bbb5767039e271cdbb1c857dea078942":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"maningtr\u00dd","id":"shakespeare014.lex.manningtree_town","ipa":"","label":"manningtree_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"maningtr\u012b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Place name attached to the roast ox in Hal's catalogue of insults.","id":"shakespeare014.lex.manningtree_town.sense","status":"draft"}],"status":"draft","variants":[]},"12ac3dd3aed1ec8e7dcf3f852372d81b3278ddf82bfa3951d31c376c06b5b77a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of dwelling","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of dwelling","exampleIds":[],"headword":"z\u00e1lin\u00e7l\u00d7on","id":"shakespeare014.lex.mansion","ipa":"","label":"mansion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lin\u016bl\u0113on","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The soul\u2019s dwelling, metaphorically the body; no additional claim of a luxurious building.","id":"shakespeare014.lex.mansion.sense","status":"draft"}],"status":"draft","variants":[]},"740b400fded5758b594ba39984277f5de2a2de12487916fe0eb541ac7ee8bddb":{"audioLinks":[],"citations":[{"lo