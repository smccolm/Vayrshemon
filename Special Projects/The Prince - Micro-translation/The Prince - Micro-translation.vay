rivation from faith, father","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from faith, father","exampleIds":[],"headword":"lamprodpala","id":"shakespeare014.lex.godfather_patron","ipa":"","label":"godfather_patron","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamprodpala","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Godfather/sponsor, metaphorically the patron of a newborn work. Faith-father is lexicalized, not father of a god.","id":"shakespeare014.lex.godfather_patron.sense","status":"draft"}],"status":"draft","variants":[]},"83daf04828834557472a7da5e11a582c5fefb7bc7ca4bf50329b0b456b6bbe16":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sponsor + son","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: sponsor + son","exampleIds":[],"headword":"denf\u00c5wpelen","id":"shakespeare014.lex.godson_sponsored_child","ipa":"","label":"godson_sponsored_child","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"denf\u0101wpelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Edgar is Gloucester's son and Lear's godson. The relationship records Lear's sponsorship and naming of Edgar.","id":"shakespeare014.lex.godson_sponsored_child.sense","status":"draft"}],"status":"draft","variants":[]},"e8405dff282bc7437461f933ec5c8d03c1f84d6338ccfc4b371035ac28dafcab":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: gold + change","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: gold + change","exampleIds":[],"headword":"azar\u00e3lum","id":"shakespeare014.lex.gold_transmutation","ipa":"","label":"gold_transmutation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azaroilum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Transmutation into gold, the heavenly alchemy of sunrise on streams; native gold-change, not a borrowed ordinary word.","id":"shakespeare014.lex.gold_transmutation.sense","status":"draft"}],"status":"draft","variants":[]},"826b50df7e67cab8bf6818c0c5e3ecb3f630d827d00635cf76fe241945b8b32a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: gold","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: gold","exampleIds":[],"headword":"azar","id":"shakespeare014.lex.golden_colour","ipa":"","label":"golden_colour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"azar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Gold-coloured or shining like gold, the gilded butterfly. No literal metal coating or alchemical transformation is asserted.","id":"shakespeare014.lex.golden_colour.sense","status":"draft"}],"status":"draft","variants":[]},"1861191638ea5dafe434842d3b8ce9085a44b1069f64a6b0bd47265287a6cc1c":{"audioLinks":[],"citations":[{"locator":"Authored native compound: gold + work + person","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: gold + work + person","exampleIds":[],"headword":"azard\u00c7\u00d3s\u00dflum","id":"shakespeare014.lex.goldsmith_craft","ipa":"","label":"goldsmith_craft","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azard\u00e3ths\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A worker in gold, especially jewellery in Jaques\u2019s ring-motto joke. Native gold + work + person; the wives remain distinct participants, not substituted for the craftsmen.","id":"shakespeare014.lex.goldsmith_craft.sense","status":"draft"}],"status":"draft","variants":[]},"8393c5d3dc595f0efe207f79d3cd9c4710010828df37e27f3d4e162832902f97":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: gold + work + person","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: gold + work + person","exampleIds":[],"headword":"azard\u00c7\u00d3s\u00dflum","id":"shakespeare014.lex.goldsmith_ephesus_trade","ipa":"","label":"goldsmith_ephesus_trade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azard\u00e3ths\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The craft practised by Angelo, maker of the chain.","id":"shakespeare014.lex.goldsmith_ephesus_trade.sense","status":"draft"}],"status":"draft","variants":[]},"d06ec2a7413cbe120d52eb26bdc1658450648811675e694e3f74e51586fd2bd0":{"audioLinks":[],"citations":[{"locator":"Authored native compound: city + boat","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: city + boat","exampleIds":[],"headword":"z\u00e1lagurviminmeran","id":"shakespeare014.lex.gondola_boat","ipa":"","label":"gondola_boat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurviminmeran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The Venetian gondola category, native city + boat. Its source-cultural referent is retained without borrowing the ordinary foreign word or adding Venice to the spoken line. No modern motor or specific dimensions are asserted.","id":"shakespeare014.lex.gondola_boat.sense","status":"draft"}],"status":"draft","variants":[]},"8e2316891c7bbae18a7a475317ddda15898f7d098837b4428d988bc94537c63