_return.sense","status":"draft"}],"status":"draft","variants":[]},"c9bf32a5a95145f5ed869869983d76e27bead8f3f783386bbcde154d9b97b67c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_sound_depth_acts","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_sound_depth_acts","exampleIds":[],"headword":"yems\u00d7mem","id":"shakespeare014.lex.sound_water_depth","ipa":"","label":"sound_water_depth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"yems\u0113mem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Measure depth, especially of water, in Rosalind\u2019s fathom/bay image. Native water-measure; not audible sound or reporting a known numerical depth.","id":"shakespeare014.lex.sound_water_depth.sense","status":"draft"}],"status":"draft","variants":[]},"1718decafc474c27fbf8275fd7d9aeb737654e14bc20b4f1a04b282edcbf808e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: music + sound","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: music + sound","exampleIds":[],"headword":"valemj\u00cden","id":"shakespeare014.lex.sounded_musical_note","ipa":"","label":"sounded_musical_note","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"valemj\u0117ren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"An individual musical sound, as distinct from a written memorandum.","id":"shakespeare014.lex.sounded_musical_note.sense","status":"draft"}],"status":"draft","variants":[]},"29e79d99f4e722f3ceb92ceaf1c22870f497c907bf938523b756ff42b0e073ac":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sound + staff","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"