14.lex.blindworm_legless_lizard.sense","status":"draft"}],"status":"draft","variants":[]},"45b921399b911b2a1a370808cf9f13345866a57ed2362cc33c09b530761b0088":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"blithild","id":"shakespeare014.lex.blithild_ancestor","ipa":"","label":"blithild_ancestor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"blithild","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Daughter of Clothair and ancestor through whom Pepin makes his claim.","id":"shakespeare014.lex.blithild_ancestor.sense","status":"draft"}],"status":"draft","variants":[]},"7082ddafce51387b8b498663bc8d5b2b106716d7633f982bf2910675bf12a990":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: wood + head","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: wood + head","exampleIds":[],"headword":"y\u00eblharen","id":"shakespeare014.lex.blockhead_insult","ipa":"","label":"blockhead_insult","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The wooden-head insult holding the second citizen\u2019s wit, preserving the head-and-block image without translating it as a new actual wooden person.","id":"shakespeare014.lex.blockhead_insult.sense","status":"draft"}],"status":"draft","variants":[]},"f06f87b1eaf59f111356c6648b89c275e95bd6ac7908f2f30c4dca533a685ae3":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"blwa","id":"shakespeare014.lex.blois_town","ipa":"","label":"blois_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"blwa","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The French place in York's list of losses.","id":"shakespeare014.lex.blois_town.sense","status":"draft"}],"status":"draft","variants":[]},"dc55334a5dd79a0c1a1ade6096d7bdfd116ae16658e92984957eb4198d6f9305":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: first + blood","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: first + blood","exampleIds":[],"headword":"neksz\u00e1r","id":"shakespeare014.lex.blood_blade_first","ipa":"","label":"blood_blade_first","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"neksz\u00f4r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Initiate a sword in its first shedding of blood. The Bastard says the young Talbot did this to his sword in French blood.","id":"shakespeare014.lex.blood_blade_first.sense","status":"draft"}],"status":"draft","variants":[]},"dbc7af553aa7e0f188bb41413ce5e18dc9bf9a90a298d387d7508287e2115183":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: blood + kjv_delivery_pipe","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: blood + kjv_delivery_pipe","exampleIds":[],"headword":"z\u00e1rvorkinthrinmarjo\u00d9","id":"shakespeare014.lex.blood_conduit","ipa":"","label":"blood_conduit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4rvorkinthrinmarjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The figurative pipes and conveyances of blood in Menenius\u2019s account of hunger and persuasion. Native blood plus hollow passage; preserves the speaker\u2019s historical physiology without asserting it as modern medical fact.","id":"shakespeare014.lex.blood_conduit.sense","status":"draft"}],"status":"draft","variants":[]},"ca83c071132578a65bff68502182ecb39bdac4291f61b8675082a23372914b30":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: blood","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: blood","exampleIds":[],"headword":"z\u00e1r","id":"shakespeare014.lex.blood_temperament","ipa":"","label":"blood_temperament","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The bodily disposition or temperament believed to answer to the heavens in the opening comparison. The blood image remains available alongside the courtiers\u2019 outward imitation.","id":"shakespeare014.lex.blood_temperament.sense","status":"draft"}],"status":"draft","variants":[]},"8c96bdbe0877faaa97c45be2700bfad22f759c4b3fd8018ac1d03985ac7a7c6c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of stain","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of stain","exampleIds":[],"headword":"murden","id":"shakespeare014.lex.blot_native","ipa":"","label":"blot_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun/verb","pronunciation":"murden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"An irregular stain or the act of obscuring with such a mark; the ink/reputation play remains. Uses native stain, avoiding the undocumented blot\u00ebn lookalike.","id":"shakespeare014.lex.blot_native.sense","status":"draft"}],"status":"draft",