eare014.lex.philoten_dionyzas_daughter.sense","status":"draft"}],"status":"draft","variants":[]},"ebfb2cf3ed7ae82cd3ad7b84a72f6290c3e4adcd7ab4943705df3fc01d7ab37a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"filotos","id":"shakespeare014.lex.philotus_athenian_agent","ipa":"","label":"philotus_athenian_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"filotos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"definition":"One of the men demanding money from Timon's household.","id":"shakespeare014.lex.philotus_athenian_agent.sense","status":"draft"}],"status":"draft","variants":[]},"a4d3e98e0e110428f0730e0e32d2653ae14c78c310c4ecbb389d8880916f116c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cold + dull","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: cold + dull","exampleIds":[],"headword":"t\u00e9zmajel","id":"shakespeare014.lex.phlegmatic_quickly_error","ipa":"","label":"phlegmatic_quickly_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"t\u00e9zmajel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"Quickly misnames the doctor's heated temper with the cold, slow humour. She wants him to calm down.","id":"shakespeare014.lex.phlegmatic_quickly_error.sense","status":"draft"}],"status":"draft","variants":[]},"fbbba0452811619539ff696b762910a425367d17b72324f21a9d07f8da4159e1":{"audioLinks":[],"citations":[{"locator":"Authored native compound: phoebe_shepherdess + act","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: phoebe_shepherdess + act","exampleIds":[],"headword":"febifalnthren","id":"shakespeare014.lex.phoebe_address","ipa":"","label":"phoebe_address","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"febifalnthren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Rosalind\u2019s local coined verb for being treated in Phoebe\u2019s supposedly cruel manner. The personal name plus native act preserves the name-to-verb joke. A source-bound theatrical coinage, not ordinary imported vocabulary or a productive insult for unrelated women.","id":"shakespeare014.lex.phoebe_address.sense","status":"draft"}],"status":"draft","variants":[]},"fb7af38ecd3d73846d48035ff2bdd28d3913a8d9ba93827bba8c12d79476e9b3":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"febi","id":"shakespeare014.lex.phoebe_shepherdess","ipa":"","label":"phoebe_shepherdess","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"febi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The shepherdess loved by Silvius. Distinct from the moon deity Phoebe, despite the same permitted phonetic personal-name form.","id":"shakespeare014.lex.phoebe_shepherdess.sense","status":"draft"}],"status":"draft","variants":[]},"34d79b1a28795a4d3fd269df5d3bd91422b323ac9c4037235e0ab48c2c9777a7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"foebus","id":"shakespeare014.lex.phoebus_sun","ipa":"","label":"phoebus_sun","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"foebus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Phoebus, the personified sun whose amorous pinches darken Cleopatra in her speech. The named allusion remains rather than replacing it with an unnamed weather process.","id":"shakespeare014.lex.phoebus_sun.sense","status":"draft"}],"status":"draft","variants":[]},"e6e9b4a19ad6f574a47a205a3d7c1d7ff15a19b88e927910be3b562538fd26e9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"fenisiya","id":"shakespeare014.lex.phoenicia_region","ipa":"","label":"phoenicia_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"fenisiya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Phoenicia in the territory assignment to Ptolemy. Author-permitted place-name adaptation, not an ordinary translated ethnic description or a modern border claim.","id":"shakespeare014.lex.phoenicia_region.sense","status":"draft"}],"status":"draft","variants":[]},"2764e8d214d8f7b73d15834854d5dcffac315160d7f6b015afd74c6b28f41618":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: phoenix","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: phoenix","exampleIds":[],"headword":"nerfal","id":"shakespeare014.lex.phoenix_ephesus_house","ipa":"","label":"phoenix_ephesus_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nerfal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The mythical bird is the house sign to which Adriana sends for her Ephesian husband.","id":"shakespeare014.lex.phoenix_ephesus_house.sense","status":"draft"}],"status":"draft","variants":[]},"47a3986b942a402921407e9b53f74741bb01e952eef7a7a1152121cdec07f7e0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: phoenix","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Authored native derivation or sense: phoenix","exampleIds":[],"headword":"nerfal","id":"shakespeare014.lex.phoenix_illyrian_ship","ipa":"","label":"phoenix_illyrian_ship","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nerfal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Ship Antonio captured with its cargo from Candy.","id":"shakespeare014.lex.phoenix_illyrian_ship.sense","status":"draft"}],"status":"draft","variants":[]},"7f73206d0b802732097e3f89a2c322e3c754e31d52f29d01129bedda7f2c403c":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: The personified Phoenix of this poem, without identifying a historical human allegorical referent. Native base phoenix retained.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: The personified Phoenix of this poem, without identifying a historical human allegorical referent. Native base phoenix retained.","exampleIds":[],"headword":"nerfal","id":"shakespeare014.lex.phoenix_symbol","ipa":"","label":"phoenix_symbol","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nerfal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"The personified Phoenix of this poem, without identifying a historical human allegorical referent.","id":"shak