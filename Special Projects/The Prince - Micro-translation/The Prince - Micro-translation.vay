iation":"varinzyrs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"An interpreter of omens, the gloomy prognosticator in Sonnet 107; native omen-read agent. No specific religious office, bird species or historical person is inserted.","id":"shakespeare014.lex.augur.sense","status":"draft"}],"status":"draft","variants":[]},"cef93527f2e0be7d2df6688db61f369006fd54855d6e36adbb2398b1919ccdba":{"audioLinks":[],"citations":[{"locator":"Source-calendar reference using the Unta ordinal eight and the native month term.","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Source-calendar reference using the Unta ordinal eight and the native month term.","exampleIds":[],"headword":"krizum\u2019t venlun","id":"shakespeare014.lex.august_month","ipa":"","label":"august_month","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"krizum\u2019t venlun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"August, the eighth month in the source calendar. The day within it is the spoken tenth.","id":"shakespeare014.lex.august_month.sense","status":"draft"}],"status":"draft","variants":[]},"6df50034ec0e1e491fefaeb63ffbfd1d6ab2c0c6307bbeeb79f017680fde7b0b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"augustus","id":"shakespeare014.lex.augustus_caesar","ipa":"","label":"augustus_caesar","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"augustus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Augustus as named in the British play. Same ruler as Octavius Caesar, distinct from Julius Caesar in the next speech.","id":"shakespeare014.lex.augustus_caesar.sense","status":"draft"}],"status":"draft","variants":[]},"623b7c33733fd4954646ed65559b46f8428027a5f1c3b958d048571bdd303808":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"aulis","id":"shakespeare014.lex.aulis_muster_place","ipa":"","label":"aulis_muster_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"aulis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The banks where Theseus directs Artesius to muster troops.","id":"shakespeare014.lex.aulis_muster_place.sense","status":"draft"}],"status":"draft","variants":[]},"47eec7f767f2d9f2a8bd2262fc87f4f368ab451c31a6a6aed149ebd1af4e4553":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"omerl","id":"shakespeare014.lex.aumerle_york_son","ipa":"","label":"aumerle_york_son","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"omerl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"The son of Edmund of Langley. His parents call him Aumerle even when the forfeited title is in question.","id":"shakespeare014.lex.aumerle_york_son.sense","status":"draft"}],"status":"draft","variants":[]},"8db6c1dce1edeb21747d597e2813f957d5271c806a0f912af5f02f3a555ea459":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"ostria","id":"shakespeare014.lex.austria_lion_duke","ipa":"","label":"austria_lion_duke","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ostria","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The duke who wears a lion's skin and whose deed the Dauphin blames for Richard's early death. Austria used as the man's title; separate from the place.","id":"shakespeare014.lex.austria_lion_duke.sense","status":"draft"}],"status":"draft","variants":[]},"78225e1e0067aee99dd1e26462ab3bb7068861a52af0145261441cbf00112abd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_author_salvation_hebrews","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_author_salvation_hebrews","exampleIds":[],"headword":"p\u00e1s\u00dflum","id":"shakespeare014.lex.author_originator","ipa":"","label":"author_originator","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4s\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The originating or responsible agent of an act, not necessarily the writer of a book; no theological relation imported.","id":"shakespeare014.lex.author_originator.sense","status":"draft"}],"status":"draft","variants":[]},"9d9c9a5961000e93932a002c458d2f4a0861884a63d99b4703f32445aebae3e9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: write + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: write + person","exampleIds":[],"headword":"\u00ddvs\u00dflum","id":"shakespeare014.lex.author_person","ipa":"","label":"author_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u012bvs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A writer or originating maker. Coriolanus imagines a man as author of his own existence.","id":"shakespeare014.lex.author_person.sense","status":"draft"}],"status":"draft","variants":[]},"ed50477faccd5958c971163ef560cbb135959c5930559e6675d39f6007c52687":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"autolikos","id":"shakespeare014.lex.autolycus_itinerant_thief","ipa":"","label":"autolycus_itinerant_thief","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"autolikos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The Bohemian singer, thief and traveling seller who identifies himself by his father's naming and the sign of Mercury.","id":"shakespeare014.lex.autolycus_itinerant_thief.sense","status":"draft"}],"status":"draft","variants":[]},"91995339469654445f4c4e1d374674bb807cfe5e54adaeda61013520bcd48b0c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"autolikos","id":"shakespeare014.lex.autolycus_mythic_namesake","ipa":"","label":"autolycus_mythic_namesake","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"autolikos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The legendary thief invoked through the singer's name and association with Mercury. The naming in the dialogue does not give the singer's father a separate personal name.","id":"shakespeare014.lex.autolycus_mythic_namesake.sense","status":"draft"}],"status":"draft","variants":[]},"bdb33da2cee656c8fdf398825ec9ea3d8e867f0ff0a21730cca4380680a03877":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"overnye","id":"shakespeare014.lex.auvergne_county","ipa":"","label":"auvergne_county","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"overnye","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The county of the lady who plans to capture Talbot.","id":"shakespeare014.lex.auvergne_county.sense","status":"draft"}],"status":"draft","variants":[]},"402b976a78c86aa7dae1ef1dfc15093169991c203193c33f9b086af02025bc4c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: greeting + kjv_mary_jesus","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: greeting + kjv_mary_jesus","exampleIds":[],"headword":"tahmmari","id":"shakespeare014.lex.ave_mary_prayer","ipa":"","label":"ave_mary_prayer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tahmmari","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"A prayer beginning with a greeting to Mary. Margaret says Henry counts these prayers on his beads.","id":"shakespeare014.lex.ave_mary_prayer.sense","status":"draft"}],"status":"draft","variants":[]},"1b1edf7c07baca1879694e6a7fcdfa3fffbc14db57610f981defafab5d6e9fed":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_avenge","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_avenge","exampleIds":[],"headword":"murf\u00d7sezif\u00c7\u00c3","id":"shakespeare014.lex.avenge","ipa":"","label":"avenge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murf\u0113sezif\u00e3jzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Seek revenge or vindication for a wrong in the speakers\u2019 oath, with agency retained.","id":"shakespeare014.lex.avenge.sense","status":"draft"}],"status":"draft","variants":[]},"ca5d54e0a0f688aae88aef74e0d722c180d6fa1918399022534a2a3ab67a5b4c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_awe","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_awe","exampleIds":[],"headword":"marh\u00c9ft\u00cd","id":"shakespeare014.lex.awe","ipa":"","label":"awe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"marh\u00e4ft\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Fearful astonishment or intimidation, qualifying resistance rather than consenting admiration.","id":"shakespeare014.lex.awe.sense","status":"draft"}],"status":"draft","variants":[]},"a5d08a8ba0c39dd24f8874e835fc28c37ef6f331badf2456e146851c4c72262f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: leather + needle","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Authored native derivation or sense: leather + needle","exampleIds":[],"headword":"skirenjelin","id":"shakespeare014.lex.awl_leather_tool","ipa":"","label":"awl_leather_tool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"skirenjelin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The pointed tool the cobbler uses to make holes in leather. It draws a source sound-play with all and withal.","id":"shakespeare014.lex.awl_leather_tool.sense","status":"draft"}],"status":"draft","variants":[]},"23e330ba594161908e8ea0ae35b5a46329ca5c8b239a951ddd79d6fa13ce92ed":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_axe","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_axe","exampleIds":[],"headword":"y\u00ebldest\u00eb\u00c5","id":"shakespeare014.lex.axe_tool","ipa":"","label":"axe_tool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fcldest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The axe used by the executioner in Silvius\u2019s comparison. Reviewed extension of native wood-cut tool to the same weapon/tool category, without adding a type of blade.","id":"shakespeare014.lex.axe_tool.sense","status":"draft"}],"status":"draft","variants":[]},"5243b3aa918179b2e74fbb5b6447f080da529fff73b45f56a9c076471a584f9f":{"audioLinks":[],"citations":[{"locator":"Native dramatic spelling for the source's sound play.","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Native dramatic spelling for the source's sound play.","exampleIds":[],"headword":"ba","id":"shakespeare014.lex.ba_sheep_sound","ipa":"","label":"ba_sheep_sound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"interjection","pronunciation":"ba","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The source exercise's reversed B and A pronounced together, also performed as a bleat. This is a quoted sound, not the native name of the animal.","id":"shakespeare014.lex.ba_sheep_sound.sense","status":"draft"}],"status":"draft","variants":[]},"c57f6d57424bf262e03bd3a4838efa3d4189e7feb5ba7495233117b0527f7ebf":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: sheep + cry","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: sheep + cry","exampleIds":[],"headword":"sh\u00ebralgoren\u00d3\u00c5\u00e7","id":"shakespeare014.lex.baa_sheep","ipa":"","label":"baa_sheep","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"sh\u00fcralgorenth\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Cry like a sheep, the impossible lamb-that-baas-like-a-bear sarcasm. Native animal-cry construction rather than an imported English onomatopoeia.","id":"shakespeare014.lex.baa_sheep.sense","status":"draft"}],"status":"draft","variants":[]},"dba57c331ed3ccac2c0e12ad5cebf3ef4eae6269a1eeca184de907e1182f9be6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_infant","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_infant","exampleIds":[],"headword":"nevpel","id":"shakespeare014.lex.baby_infant","ipa":"","label":"baby_infant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nevpel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An infant at a nursing breast, Cleopatra\u2019s metaphor for the asp. The metaphor does not add an actual child to the stage.","id":"shakespeare014.lex.baby_infant.sense","status":"draft"}],"status":"draft","variants":[]},"57ad375661aeb76d5ca1a68d6af579064618ef189a3856f0127ad5fd15918e40":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: wine + dance","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: wine + dance","exampleIds":[],"headword":"m\u00ebrvenvalen","id":"shakespeare014.lex.bacchanal_dance","ipa":"","label":"bacchanal_dance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrvenvalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A revel dance honoring the wine god, source bacchanals. Native wine-dance, distinct from the worshipper noun in the Thracian comparison and without an ordinary borrowed ritual name.","id":"shakespeare014.lex.bacchanal_dance.sense","status":"draft"}],"status":"draft","variants":[]},"780983cf0cebfb69d97b7031ddf448e3ae9a52a8b6e8b8395eca2c3d9134c766":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"bakkus","id":"shakespeare014.lex.bacchus_god","ipa":"","label":"bacchus_god","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"bakkus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The wine god addressed by name in the banquet song. A permitted personal divine name, not a loan replacing the native word for wine or revelry.","id":"shakespeare014.lex.bacchus_god.sense","status":"draft"}],"status":"draft","variants":[]},"70dc6d187acf6068885e030112adc74bba73c6307ae595656ef7727d6c77a500":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: reverse + thrust","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: reverse + thrust","exampleIds":[],"headword":"tarelyi\u00d1terastnerda\u00c3","id":"shakespeare014.lex.back_thrust_fencing","ipa":"","label":"back_thrust_fencing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarelyichterastnerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The punto reverso of Mercutio's catalogue of fencing terms.","id":"shakespeare014.lex.back_thrust_fencing.sense","status":"draft"}],"status":"draft","variants":[]},"487aa68acc92415c6c555a2b5c0412e2172e2a46fe2f9e467df909ffd376a7fe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: bag","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: bag","exampleIds":[],"headword":"borel","id":"shakespeare014.lex.bag_plunder_jest","ipa":"","label":"bag_plunder_jest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"borel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The disguised French soldier turns the sack he carries into a verb for taking the city as plunder.","id":"shakespeare014.lex.bag_plunder_jest.sense","status":"draft"}],"status":"draft","variants":[]},"aaebda4a759e9fd0977a01dd9469b8f915f16be3ef3514a723c3f95350607162":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_baggage","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_baggage","exampleIds":[],"headword":"\u00db\u00c7dk\u00cfba\u00d1\u00d1et","id":"shakespeare014.lex.baggage_goods","ipa":"","label":"baggage_goods","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sh\u00e3dk\u00cfbachchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Carried possessions accompanying departure, native carry-goods promoted from the historical witness. In the stock military leave-taking phrase, not a wheeled carriage or the insult for a person.","id":"shakespeare014.lex.baggage_goods.sense","status":"draft"}],"status":"draft","variants":[]},"361946fb94b3628ca6c3bfd063ef052264dff43c87572a95c29112a07a4b7043":{"audioLinks":[],"citations":[{"locator":"Author-permi