14.source.shakespeares-sonnets.r1"}],"definition":"A line of verse, with drawn line and lineage resonances available where the source invokes them; not an invented number of lines.","id":"shakespeare014.lex.poetic_line.sense","status":"draft"}],"status":"draft","variants":[]},"52c0c7db8ab91254903a243074cf4d621349f1d4fa957655169a5f6cb6c1f994":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: verse + spirit","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: verse + spirit","exampleIds":[],"headword":"lilthreninswifl\u00dfn","id":"shakespeare014.lex.poetic_spirit","ipa":"","label":"poetic_spirit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lilthreninswifl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Poetic inspiration personified in the rival muse of Sonnet 21; no named Greek goddess is specified by this masculine source figure.","id":"shakespeare014.lex.poetic_spirit.sense","status":"draft"}],"status":"draft","variants":[]},"87055d20490ec3b29f10514d3847b7c1180560c5f8fa3e33fb3daf7c6454fe16":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of subject","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of subject","exampleIds":[],"headword":"voren","id":"shakespeare014.lex.poetic_theme","ipa":"","label":"poetic_theme","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"voren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The subject supplied to poetic invention, source subject and argument in Sonnet 38; distinct from a subject under a sovereign or a quarrel.","id":"shakespeare014.lex.poetic_theme.sense","status":"draft"}],"status":"draft","variants":[]},"02c1735a35910cd19086394a27377c2620942317d41f710dbf6260159cade4d3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of verse","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of verse","exampleIds":[],"headword":"lilthrenin","id":"shakespeare014.lex.poetry_art","ipa":"","label":"poetry_art","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lilthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Poetry as an art or generic composition, a collective non-count sense of native verse. No exact count of lines or specific classical metre is asserted.","id":"shakespeare014.lex.poetry_art.sense","status":"draft"}],"status":"draft","variants":[]},"6bc872d66664bd1a43cad64f83f85cccf3c4f1a567a19cd91004e1a2b5e4fa0a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"poinz","id":"shakespeare014.lex.poins_companion","ipa":"","label":"poins_companion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"poinz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Companion who arranges a robbery and a second trick against the robbers.","id":"shakespeare014.lex.poins_companion.sense","status":"draft"}],"status":"draft","variants":[]},"334ca221c74f32f2685971f8a475c2a033c51693ddc153234c8c60f4c7321efa":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"pwatye","id":"shakespeare014.lex.poitiers_city","ipa":"","label":"poitiers_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pwatye","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The last place named in the first messenger's list.","id":"shakespeare014.lex.poitiers_city.sense","status":"draft"}],"status":"draft","variants":[]},"15233b852dd157fff399ffdc54798c77217b8c3c0bbffb9845f4a6c1dd9f404e":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"poland","id":"shakespeare014.lex.poland_country","ipa":"","label":"poland_country","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"poland","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The territory named by the affiliation of the Poles on sledges in the supplied source.","id":"shakespeare014.lex.poland_country.sense","status":"draft"}],"status":"draft","variants":[]},"e6bcb1e78c7fa9df4acf0aad4fc8254d5604b63b137f85dc59667012d542d67e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: staff + blade","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: staff + blade","exampleIds":[],"headword":"terallenir","id":"shakespeare014.lex.polax_heraldic_weapon","ipa":"","label":"polax_heraldic_weapon","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"terallenir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The long-handled bladed weapon carried by the lion in Alexander's painted device.","id":"shakespeare014.lex.polax_heraldic_weapon.sense","status":"draft"}],"status":"draft","variants":[]},"e1750ae181a4cf60180d528bae4777e2756d24729357de7