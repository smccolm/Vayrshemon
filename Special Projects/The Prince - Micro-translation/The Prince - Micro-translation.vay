variants":[]},"f0b2815c282a18dc181e3e9bee7217a572d9911f7fe9fb89874f88839619d610":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: throat + cough","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: throat + cough","exampleIds":[],"headword":"tommarjo\u00d9kafar","id":"shakespeare014.lex.hawk_throat","ipa":"","label":"hawk_throat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tommarjongkafar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Clear the throat noisily before singing; not hunt with a falcon.","id":"shakespeare014.lex.hawk_throat.sense","status":"draft"}],"status":"draft","variants":[]},"8b821ad880ba9e4f6c1f284da8d5f6036abed131c28d03804cb842cc39771470":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: risk + dice","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: risk + dice","exampleIds":[],"headword":"murdatkelde\u00dbontarik","id":"shakespeare014.lex.hazard_dice","ipa":"","label":"hazard_dice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murdatkeldeshontarik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A game of dice. The risk root recurs in the Constable's reply that Rambures must go to hazard in battle.","id":"shakespeare014.lex.hazard_dice.sense","status":"draft"}],"status":"draft","variants":[]},"c0dd2aae314ef6622df90abc2d3e040570b764605767df1a82b11b14d759ee72":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_hazel + seed","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: kjv_hazel + seed","exampleIds":[],"headword":"y\u00eblr\u00ddmp\u00e1in","id":"shakespeare014.lex.hazelnut_hazel_seed","ipa":"","label":"hazelnut_hazel_seed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclr\u012bmp\u00f4in","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The nuts whose brown hue and kernels Petruchio compares with Katherine.","id":"shakespeare014.lex.hazelnut_hazel_seed.sense","status":"draft"}],"status":"draft","variants":[]},"52c00b116f1bc7d2ad0aadaddf3040f59534090c788d9d70aff0eede5255c262":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: head + ornament","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: head + ornament","exampleIds":[],"headword":"harenel\u00ebin\u00d1et","id":"shakespeare014.lex.head_adornment","ipa":"","label":"head_adornment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harenel\u00fcinchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Ornament or dress for the head, Cleopatra\u2019s tires placed on Antony. Not fatigue, a vehicle tyre or a specified crown.","id":"shakespeare014.lex.head_adornment.sense","status":"draft"}],"status":"draft","variants":[]},"fd5a3456f12cb635fdfde1d8202b3004469d7573ca91b59d488e87968be48131":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: blockhead_insult + head","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: blockhead_insult + head","exampleIds":[],"headword":"y\u00eblharenharen","id":"shakespeare014.lex.head_block_insult","ipa":"","label":"head_block_insult","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclharenharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The severed clotpole, Cloten's foolish head. The ridicule conjoins the literal head and the insult.","id":"shakespeare014.lex.head_block_insult.sense","status":"draft"}],"status":"draft","variants":[]},"4dcf434a85700e45159772cd373e4628a43ce713ae4cfecccde1bd04ccd29e24":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: town + guard","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: town + guard","exampleIds":[],"headword":"z\u00e1lagurjemek","id":"shakespeare014.lex.headborough_messina_watch","ipa":"","label":"headborough_messina_watch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurjemek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Verges's local watch office in the entrance before Leonato, distinct from Dogberry's constable title.","id":"shakespeare014.lex.headborough_messina_watch.sense","status":"draft"}],"status":"draft","variants":[]},"2530605b0032f5964701b763ee52d9fb03be93a95fce6d5a609b436952824558":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: land + head","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: land + head","exampleIds":[],"headword":"jo\u00d9haren","id":"shakespeare014.lex.headland_cape","ipa":"","label":"headland_cape","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The projecting land at Actium from which Antony proposes a sea attack. Native land-head; no new coordinates or an asserted cliff height.","id":"shakespeare014.lex.headland_cape.sense","status":"draft"}],"status":"draft","variants":[]},"f5c07b75a4de4cde858902a9ed21c7f0e0d9ca5e82e28437aedd0015ba123c6c":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from heal, cover","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from heal, cover","exampleIds":[],"headword":"fadershalen","id":"shakespeare014.lex.healing_plaster","ipa":"","label":"healing_plaster","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"fadershalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A dressing or plaster for a wound, figuratively the licking tongue; distinct from building plaster.","id":"shakespeare014.lex.healing_plaster.sense","status":"draft"}],"status":"draft","variants":[]},"a0bfddff336a10beccaed882da05d8f17dce2c925fa1e2663bdacb3ca8787eee":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: health + drink","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: health + drink","exampleIds":[],"headword":"faren\u00d5\u00dfrm\u00ebr","id":"shakespeare014.lex.health_toast","ipa":"","label":"health_toast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"faren\u0167h\u014drm\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A drinking salute to another\u2019s health offered by Menas. Native health-drink, distinct from literal physical wellness or a medical treatment.","id":"shakespeare014.lex.health_toast.sense","status":"draft"}],"status":"draft","variants":[]},"320f708e07d8fb1186b193b8c57bf629739e9ed94fa38ff74bc9ba5953264292":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_heap","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_heap","exampleIds":[],"headword":"gurnel","id":"shakespeare014.lex.heap_mound","ipa":"","label":"heap_mound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gurnel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A gathered mound, extended by Celia to the fool\u2019s supposed store of knowledge. No exact amount or textile nap is implied.","id":"shakespeare014.lex.heap_mound.sense","status":"draft"}],"status":"draft","variants":[]},"1ddeb5cbbe283f5d4d8b7108d55471e045a4c4927afa5dc719adb2dda63cf5a7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: heap_mound","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: heap_mound","exampleIds":[],"headword":"gurnel","id":"shakespeare014.lex.heap_pile","ipa":"","label":"heap_pile","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gurnel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Gather into a heap, used figuratively of overflowing joy at the final dance.","id":"shakespeare014.lex.heap_pile.sense","status":"draft"}],"status":"draft","variants":[]},"1af8b6157658e51b93e68bbaa8c97c4f5536711fe98236266b8e3ff7c6d535b0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_hearth","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_hearth","exampleIds":[],"headword":"zarunjo\u00d9shal","id":"shakespeare014.lex.hearth_fire","ipa":"","label":"hearth_fire","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarunjongshal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The domestic fireplace or fire-floor where the stranger asks to stand. Reviewed native historical hearth; not the whole home or the host\u2019s heart.","id":"shakespeare014.lex.hearth_fire.sense","status":"draft"}],"status":"draft","variants":[]},"caecaa1afbfc8688bc5f3676232d2471441d4f881315b09331fe400be8ec0dda":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_heathen","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_heathen","exampleIds":[],"headword":"thanis\u00dflum","id":"shakespeare014.lex.heathen_source","ipa":"","label":"heathen_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"thanis\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Outside the speaker\u2019s Christian religious tradition, as Touchstone labels the unnamed philosopher. Native outside-people expression reviewed for this new source; not an imported Israel-versus-neighbours reference or the translator\u2019s disparagement.","id":"shakespeare014.lex.heathen_source.sense","status":"draft"}],"status":"draft","variants":[]},"eff290d7c0e5792a29cb851512cb18a912e6c251489fa6b1190a05581aa00d94":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: heavenly + apportion_allot","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: heavenly + apportion_allot","exampleIds":[],"headword":"prodnarthreninf\u00c5w","id":"shakespeare014.lex.heavenly_limiter","ipa":"","label":"heavenly_limiter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodnarthreninf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The unnamed heavenly disposer who determines where the cousins' vessels arrive. No additional named god is supplied.","id":"shakespeare014.lex.heavenly_limiter.sense","status":"draft"}],"status":"draft","variants":[]},"4573976991bf01164a150e86b0a2f3a20aaf05aa69a51cefebda5b458d3a2544":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of heaviness","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of heaviness","exampleIds":[],"headword":"memvorplestenef","id":"shakespeare014.lex.heaviness_grief","ipa":"","label":"heaviness_grief","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memvorplestenef","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Weight with a grief sense in Cleopatra\u2019s lifting speech. Her company\u2019s strength has become heaviness: the native weight-family word deliberately carries both physical burden and sorrow in this passage.","id":"shakespeare014.lex.heaviness_grief.sense","status":"draft"}],"status":"draft","variants":[]},"7a7f985e4e0abbb309abb187e96be04c68b90107d80bb6717516bf7469a3980b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: curse + poison + juice","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: curse + poison + juice","exampleIds":[],"headword":"muren\u00c9lmvenmurnamnil\u00ebm","id":"shakespeare014.lex.hebona_poison","ipa":"","label":"hebona_poison","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"muren\u00e4lmvenmurnamnil\u00fcm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The poisonous plant juice in the Ghost's account of the murder. Its botanical identity is left unspecified.","id":"shakespeare014.lex.hebona_poison.sense","status":"draft"}],"status":"draft","variants":[]},"8e2bdba38e4e8873f64a7d970c0c1415363ed50c9b060a987b1110c7e380344e":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"hektor","id":"shakespeare014.lex.hector","ipa":"","label":"hector","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hektor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Troy\u2019s defender in the painting, associated with the mothers\u2019 hope.","id":"shakespeare014.lex.hector.sense","status":"draft"}],"status":"draft","variants":[]},"5bbea83d3e13d20fabcfe349e4cdcd1a2df291ad8f74e7f58f0971b22b0abe77":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"hekuba","id":"shakespeare014.lex.hecuba","ipa":"","label":"hecuba","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hekuba","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Priam\u2019s wife in the painted Troy scene, the aged woman whose grief Lucrece mirrors.","id":"shakespeare014.lex.hecuba.sense","status":"draft"}],"status":"draft","variants":[]},"7e701f71bf04703a78f7faaaecde4a9d119573ef9acc3bb59832b51b255c1dba":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from bristle, beast","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from bristle, beast","exampleIds":[],"headword":"jw\u00ebnenplestenf\u00ebl\u00d5\u00dfrvor","id":"shakespeare014.lex.hedgehog_native","ipa":"","label":"hedgehog_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jw\u00fcnenplestenf\u00fcl\u0167h\u014drvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The small spiny animal named urchin in the boar-snout comparison; not a human child or sea urchin.","id":"shakespeare014.lex.hedgehog_native.sense","status":"draft"}],"status":"draft","variants":[]},"ea2dced43104ce15416d9e9a6c905d40eb211b7e0955d90d0c83c78ca7879dec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: heel + sore_wound","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: heel + sore_wound","exampleIds":[],"headword":"grelmarmurvorh\u00eb\u00c5el","id":"shakespeare014.lex.heel_sore","ipa":"","label":"heel_sore","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grelmarmurvorh\u00fc\u0101el","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A kibe, or sore spot on the courtier's heel chafed by the peasant's toe.","id":"shakespeare014.lex.heel_sore.sense","status":"draft"}],"status":"draft","variants":[]},"50d73951a3c85a58a8fe7600de60657fdea8f44455120517816f3bf2b7020a80":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of height","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of height","exampleIds":[],"headword":"naor","id":"shakespeare014.lex.height_pitch","ipa":"","label":"height_pitch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"naor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Highest elevation in the sun\u2019s apparent course; not sticky pitch or a musical note.","id":"shakespeare014.lex.height_pitch.sense","status":"draft"}],"status":"draft","variants":[]},"bdc73b8785a30caf3f43c8265069166096f5b86a1808a4dfd92a94d089cc1757":{"audioLinks":[],"citations":[{"loc