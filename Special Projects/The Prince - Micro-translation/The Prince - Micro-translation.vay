red lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The strong-smelling elder shrub representing grief beside the growing vine of patience. Distinct from an older person.","id":"shakespeare014.lex.elder_bush.sense","status":"draft"}],"status":"draft","variants":[]},"8ad2e4710c80af8d90bb84341a75f45efaf7c931c0ac427ca58fcd47cf308508":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"elenor","id":"shakespeare014.lex.eleanor_gloucester","ipa":"","label":"eleanor_gloucester","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"elenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Gloucester's wife, who dreams that Henry and Margaret crown her.","id":"shakespeare014.lex.eleanor_gloucester.sense","status":"draft"}],"status":"draft","variants":[]},"7d37a4f9d9e11387bc06fe65b1a4866df762f53f08760434afa7298dbcea6a9a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"elenor","id":"shakespeare014.lex.eleanor_john_mother","ipa":"","label":"eleanor_john_mother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"elenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Mother of John and Richard, widow of Henry II. She acknowledges the newly knighted Bastard as her grandson.","id":"shakespeare014.lex.eleanor_john_mother.sense","status":"draft"}],"status":"draft","variants":[]},"81e8ce05ac55d36831ecd655df8ab94a0ebbde509b15e04b1494bef664e89d8e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"elenor","id":"shakespeare014.lex.eleanor_march_sister","ipa":"","label":"eleanor_march_sister","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"elenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Roger's daughter listed after Anne. Distinct from Duchess Eleanor Cobham.","id":"shakespeare014.lex.eleanor_march_sister.sense","status":"draft"}],"status":"draft","variants":[]},"c191434ba2c333fd11e82a9b323c6f21d3b65856f5259d21828bd1f109a596dd":{"audioLinks":[],"citations":[{"locator":"Authored native compound: sorrow + song","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: sorrow + song","exampleIds":[],"headword":"w\u00e9asemlil","id":"shakespeare014.lex.elegy_lament","ipa":"","label":"elegy_lament","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00e9asemlil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A plaintive lyric or lament, native sorrow + song. Orlando\u2019s love elegies need not announce a death; no funeral event is invented.","id":"shakespeare014.lex.elegy_lament.sense","status":"draft"}],"status":"draft","variants":[]},"39adab10e38760aed9600eb61006e7bc24e78c08ce659e4b6d5484ebd90feab6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of matter","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of matter","exampleIds":[],"headword":"voren","id":"shakespeare014.lex.element_medium","ipa":"","label":"element_medium","notes":"","orthographyId":"thimfora-79","partOfSpeech"