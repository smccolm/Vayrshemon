cal decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A body-front protective covering worn by the workmen Cleopatra imagines. Reuses the native apron noun without retaining the Genesis leaf material.","id":"shakespeare014.lex.apron_front_cover.sense","status":"draft"}],"status":"draft","variants":[]},"2c881550db96d909651493f9889a9e8014e0488bd2eebe8613ce42448326b91a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"akwilon","id":"shakespeare014.lex.aquilon_north_wind","ipa":"","label":"aquilon_north_wind","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"akwilon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"definition":"North wind personified in Ajax's challenge to the trumpeter.","id":"shakespeare014.lex.aquilon_north_wind.sense","status":"draft"}],"status":"draft","variants":[]},"14efda992b55f8de16ac013a27cf76ce165c7f0069c9d61dc030e6689cb00dbc":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"akiten","id":"shakespeare014.lex.aquitaine_french_territory","ipa":"","label":"aquitaine_french_territory","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"akiten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The territory whose surrender is to be discussed with the French princess.","id":"shakespeare014.lex.aquitaine_french_territory.sense","status":"draft"}],"status":"draft","variants":[]},"313ea255f2177cbc23a423a5f188673d41d3207e65d4f