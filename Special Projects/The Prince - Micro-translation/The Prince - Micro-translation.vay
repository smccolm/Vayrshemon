:[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Show mercy by waiving ransom in the contrasted ransoming-or-pitying clause. Not a second ransom demand or an invented universal pardon.","id":"shakespeare014.lex.pity_exempt_ransom.sense","status":"draft"}],"status":"draft","variants":[]},"089b9591d64783188d8de501c83e483e7b8499f4bf00fb2e396e496f360ce87f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: devout","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Authored native derivation or sense: devout","exampleIds":[],"headword":"lamzar","id":"shakespeare014.lex.pius_titus_epithet","ipa":"","label":"pius_titus_epithet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lamzar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"The honorific Pius accorded to Titus for services to Rome, rendered by the native word for devotion.","id":"shakespeare014.lex.pius_titus_epithet.sense","status":"draft"}],"status":"draft","variants":[]},"808e14b2766f19a6b5d0ac37b15a7e1267e718feab47f8ae7389c73f55c95445":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"plasentyo","id":"shakespeare014.lex.placentio_verona_guest","ipa":"","label":"placentio_verona_guest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"plasentyo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"Named with his nieces on the invitation list.","id":"shakespeare014.lex.placentio_verona_guest.sense","status":"draft"}],"status":"draft","variants":[]},"f7363f34c18b8b102cbceae0f854998