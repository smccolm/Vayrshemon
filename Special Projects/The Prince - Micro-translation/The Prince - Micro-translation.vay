ed lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The opening of armed action delayed by Octavia\u2019s letters. Native war-begin as an event noun, not a prison escape or a medical outbreak.","id":"shakespeare014.lex.war_outbreak.sense","status":"draft"}],"status":"draft","variants":[]},"11f0fa8f5f73c2e9e1418e33f7eaac49197650e9d4360e729aa3417f03ea962e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cook + pear","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: cook + pear","exampleIds":[],"headword":"n\u00ddpelum","id":"shakespeare014.lex.warden_baking_pear","ipa":"","label":"warden_baking_pear","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u012bpelum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The firm culinary pear used in a warden pie.","id":"shakespeare014.lex.warden_baking_pear.sense","status":"draft"}],"status":"draft","variants":[]},"e3b05a274d60c9ecb15a6b851539936315faeab316b46982ac6bf0a29089caed":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_wardrobe_store","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_wardrobe_store","exampleIds":[],"headword":"velvorm\u00c5rum","id":"shakespeare014.lex.wardrobe","ipa":"","label":"wardrobe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velvorm\u0101rum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The clothing repository hiding a splendid robe in Sonnet 52; not the private chamber of the heart in Sonnet 46.","id":"shakespeare014.lex.wardrobe.sense","status":"draft"}],"status":"draft","variants":[]},"971369b5f14056d27dfe72544c757a3f81eaedd16a8cfc6a597c96