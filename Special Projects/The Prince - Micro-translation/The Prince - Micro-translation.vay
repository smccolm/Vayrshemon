ceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_lease_property","exampleIds":[],"headword":"d\u00c7\u00d3v\u00df\u00d5f\u00c5w","id":"shakespeare014.lex.lease_tenure","ipa":"","label":"lease_tenure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u00e3thv\u014d\u0167hf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Temporary holding of property rather than outright ownership; beauty\u2019s lease and its ending in Sonnets 13 and 18.","id":"shakespeare014.lex.lease_tenure.sense","status":"draft"}],"status":"draft","variants":[]},"ae8fa333bcb48b17b26e08071feee4f4271e02bdc7e0ec4e002690167cff0a8e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: dog + bind","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: dog + bind","exampleIds":[],"headword":"b\u00cfebkl\u00e1rjem","id":"shakespeare014.lex.leash_restraint","ipa":"","label":"leash_restraint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u00cfebkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A restraint on a dog that can be released, native dog-bind; applied figuratively to the captive city without inventing the material or mechanism.","id":"shakespeare014.lex.leash_restraint.sense","status":"draft"}],"status":"draft","variants":[]},"152dd3fa69dee501d684906c8efe2355395d2df4a4ddaed278bb9f7b9f5c24a1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: leather + coat","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: leather + coat","exampleIds":[],"headword":"skirenf\u00eblen","id":"shakespeare014.lex.leather_jerkin","ipa":"","label":"leather_jerkin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"skirenf\u00fclen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The buff leather garment associated in the jest with arrest and confinement.","id":"shakespeare014.lex.leather_jerkin.sense","status":"draft"}],"status":"draft","variants":[]},"f3bb164d3ee690a7bcb4d79f472c4ab390e8fead5028c81f701e0cac45456493":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: lust","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: lust","exampleIds":[],"headword":"vor\u00c9lms\u00dflum","id":"shakespeare014.lex.lecher","ipa":"","label":"lecher","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vor\u00e4lms\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"One represented as pursuing illicit lust; Tarquin\u2019s fabricated label for the victims.","id":"shakespeare014.lex.lecher.sense","status":"draft"}],"status":"draft","variants":[]},"b8196549d0dfe23b82bad46c1afaa17adfd14b0a691a985f370ba9687cad890f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"leda","id":"shakespeare014.lex.leda_jupiters_beloved","ipa":"","label":"leda_jupiters_beloved","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"leda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The woman in Falstaff's recollection of Jupiter in the form of a swan.","id":"shakespeare014.lex.leda_jupiters_beloved.sense","status":"draft"}],"status":"draft","variants":[]},"eedda415e84da3ec20812d35b4f49b2e46837c4fbaeb710489eb3f5aca90a4d5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of look","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of look","exampleIds":[],"headword":"veritas","id":"shakespeare014.lex.leer_countenance","ipa":"","label":"leer_countenance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"veritas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A look or cast of countenance, source better leer. Nominal native look; not necessarily a lascivious expression or a taunt about poor eyesight.","id":"shakespeare014.lex.leer_countenance.sense","status":"draft"}],"status":"draft","variants":[]},"2043e8eccd8f0309edc0ac748ad014b7c16c230e632f6487c28e63eaacd7ace8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: town + judgment","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: town + judgment","exampleIds":[],"headword":"z\u00e1lagurnerbw\u00c5vumen","id":"shakespeare014.lex.leet_local_court","ipa":"","label":"leet_local_court","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurnerbw\u0101vumen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The local court invoked alongside law days in Iago's image of improper thoughts sitting in judgment.","id":"shakespeare014.lex.leet_local_court.sense","status":"draft"}],"status":"draft","variants":[]},"90fabb62f8ba8b9df491e2f900c50ea8fe67d9dc22322133e0781350d555dae1":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_advocate_john_epistle","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_advocate_john_epistle","exampleIds":[],"headword":"t\u00d7vengiktenv\u00d7s\u00dflum","id":"shakespeare014.lex.legal_advocate","ipa":"","label":"legal_advocate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"t\u0113vengiktenv\u0113s\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"One speaking on another\u2019s behalf in a legal case; the wronged speaker defending the beloved in Sonnet 35. Native inherited behalf-speaker form, with no divine identity carried into the new sense.","id":"shakespeare014.lex.legal_advocate.sense","status":"draft"}],"status":"draft","variants":[]},"839145371059188c4f67b049ad93f50deef43e9522ae72278546b03b10fb736a":{"audioLinks":[],"citations":[{"locator":"Authored native compound: value + seize","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: value + seize","exampleIds":[],"headword":"minlam\u00e7ztjem","id":"shakespeare014.lex.legal_extent","ipa":"","label":"legal_extent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"minlam\u016bztjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Official valuation of property for seizure, source make an extent upon house and lands. Native value + seize names this legal act, not spatial extent or a new modern statute.","id":"shakespeare014.lex.legal_extent.sense","status":"draft"}],"status":"draft","variants":[]},"01c5467a9385e594b026456f6e1aee9990191bbc11016b47778822da73bdc12b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: law + process","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: law + process","exampleIds":[],"headword":"lamthr\u00ebnv\u00c7lda\u00c3","id":"shakespeare014.lex.legal_process","ipa":"","label":"legal_process","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcnv\u00e3ldajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The regular course of legal proceedings, urged instead of summary force. Native law-process; not a generic task workflow or a promise that the tribunal is impartial.","id":"shakespeare014.lex.legal_process.sense","status":"draft"}],"status":"draft","variants":[]},"fc1e1d8488577e08bc31b49c5b471606f746487fce00b53a09fcda7526bb8b39":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: law + subtle + trick","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: law + subtle + trick","exampleIds":[],"headword":"lamthr\u00ebnelino\u00c3bravenar","id":"shakespeare014.lex.legal_quibble","ipa":"","label":"legal_quibble","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcnelinojzhbravenar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A subtle legal evasion; repeats the first two roots of the preceding legal nicety.","id":"shakespeare014.lex.legal_quibble.sense","status":"draft"}],"status":"draft","variants":[]},"c32932b5896f85eabb9e0463e1fca346d5ef8315c062932739b77e8c4c60a007":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: law + subtle","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: law + subtle","exampleIds":[],"headword":"lamthr\u00ebnelino\u00c3bra","id":"shakespeare014.lex.legal_quiddity","ipa":"","label":"legal_quiddity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcnelinojzhbra","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A fine legal distinction, coupled by sound with quillities in Hamlet's skull speech.","id":"shakespeare014.lex.legal_quiddity.sense","status":"draft"}],"status":"draft","variants":[]},"cace6cfd851cd7773ae13aeda285e5594b0fbfd803b5f6eb0b7d9119e21d69b2":{"audioLinks":[],"citations":[{"locator":"Authored native compound: law + rest","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: law + rest","exampleIds":[],"headword":"lamthr\u00ebndlen","id":"shakespeare014.lex.legal_recess","ipa":"","label":"legal_recess","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcndlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The interval when courts are not sitting, native law + rest. Source lawyers sleep between legal terms; not a modern holiday package or the assertion that legal work always ceases.","id":"shakespeare014.lex.legal_recess.sense","status":"draft"}],"status":"draft","variants":[]},"0dac4c0915cd40ca8aea9aa3dfb4d5f78b3a0627893daf255a18955c65e91607":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: law + summon","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: law + summon","exampleIds":[],"headword":"lamthr\u00ebnkin\u00d3\u00c5\u00e7","id":"shakespeare014.lex.legal_summons","ipa":"","label":"legal_summons","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcnkinth\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Legal process as a summons or authoritative demand, Cleopatra\u2019s ironic comparison of Fulvia\u2019s and Caesar\u2019s claims; not a workflow or an invented lawsuit.","id":"shakespeare014.lex.legal_summons.sense","status":"draft"}],"status":"draft","variants":[]},"15619153447d1919adf53c53e9606426ce0a8c682c3af5cb76ef4186fa8bbc51":{"audioLinks":[],"citations":[{"locator":"Authored native compound: law + time","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: law + time","exampleIds":[],"headword":"lamthr\u00ebnvenor","id":"shakespeare014.lex.legal_term","ipa":"","label":"legal_term","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcnvenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A period when courts conduct their business, native law + time. The periods in the lawyers\u2019 joke, not an arbitrary school term or a specified statutory calendar.","id":"shakespeare014.lex.legal_term.sense","status":"draft"}],"status":"draft","variants":[]},"58119e47fb5a07237cca43c7e2d2f4edb7cc09cdcd70f0b82cdffe933197d2b9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: law + permission","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: law + permission","exampleIds":[],"headword":"lamthr\u00ebn\u00c3ah","id":"shakespeare014.lex.legal_warrant","ipa":"","label":"legal_warrant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcnjzhah","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Authority or permission limited by law, source modest warrant. Native law-permission, distinct from the verb guarantee and without inventing a written document.","id":"shakespeare014.lex.legal_warrant.sense","status":"draft"}],"status":"draft","variants":[]},"066c398baa112a58f0a46fd518a3408518ff4591ebcb77173af220f9c44a8a83":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_legion","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_legion","exampleIds":[],"headword":"hefak gurs\u00dflum\u00e1pe\u00db