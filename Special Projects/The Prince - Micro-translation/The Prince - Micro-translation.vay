ator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A fast-running horse, the source of the hair imagined to turn into a serpent; no particular breed is imposed.","id":"shakespeare014.lex.horse_courser.sense","status":"draft"}],"status":"draft","variants":[]},"76380b0cb35f157fff98a0552dc9a800a0002877208d7d356747ee7650be9f61":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from horse, yoke","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from horse, yoke","exampleIds":[],"headword":"thalyeren","id":"shakespeare014.lex.horse_team","ipa":"","label":"horse_team","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalyeren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A team of harnessed horses drawing a vehicle; retains the sun-chariot image without inventing a horse count.","id":"shakespeare014.lex.horse_team.sense","status":"draft"}],"status":"draft","variants":[]},"6c615c93e680f15fe5c44a039baae7406c7173213840bdba815fbad9c553aed3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of manage","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of manage","exampleIds":[],"headword":"k\u00c7fag\u00eba","id":"shakespeare014.lex.horse_training","ipa":"","label":"horse_training","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"k\u00e3fag\u00fca","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The trained handling and movements taught to horses, source manage; distinct from management of a household or holding political office.","id":"shakespeare014.lex.horse_training.sense","status":"draft"}],"status":"draft","variants":[]},"945c215689d255f39e7d49a3eb4224cdac288227