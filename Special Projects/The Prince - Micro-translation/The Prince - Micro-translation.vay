ations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Cut a sign or impression into a surface, figuratively soft sighs engraving a heart.","id":"shakespeare014.lex.engrave.sense","status":"draft"}],"status":"draft","variants":[]},"f09fb38c578350fcffa30c2caa5a1c97faf9c2d03d1accb0f0b89960f4b5aa87":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_enjoy","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_enjoy","exampleIds":[],"headword":"pisens\u00c7f","id":"shakespeare014.lex.enjoy","ipa":"","label":"enjoy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"pisens\u00e3f","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Have the benefit or enjoyment of something, including short-lived good fortune.","id":"shakespeare014.lex.enjoy.sense","status":"draft"}],"status":"draft","variants":[]},"6636713f78d30548ae5e1cf0e36e475870b249fa2d8207f14241d1602a557095":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: compel + gather","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: compel + gather","exampleIds":[],"headword":"jorgorz\u00dfgu\u00d9","id":"shakespeare014.lex.enlist_force","ipa":"","label":"enlist_force","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"jorgorz\u014dgung","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Gather or levy people into armed service, the letter\u2019s pressed a power. Not a printing press, financial tribute or a claim of voluntary enlistment.","id":"shakespeare014.lex.enlist_force.sense","status":"draft"}],"status":"draft","variants":[]},"c512a751adde24f924c3c4acfe7976015e1a5ac4678180af53424f08d37f9e48":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"enobarb","id":"shakespeare014.lex.enobarb_variant","ipa":"","label":"enobarb_variant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"enobarb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The shortened Enobarb form in Caesar\u2019s farewell, same Enobarbus who is present at the feast. Not a second character or a printed internal identifier.","id":"shakespeare014.lex.enobarb_variant.sense","status":"draft"}],"status":"draft","variants":[]},"22f22049a4b8360b23686fb6133339e2c345bcec9b3d6e1fa9dbfb97535ac6e3":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"enobarbus","id":"shakespeare014.lex.enobarbus","ipa":"","label":"enobarbus","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"enobarbus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Enobarbus, Antony\u2019s follower in the play.","id":"shakespeare014.lex.enobarbus.sense","status":"draft"}],"status":"draft","variants":[]},"707911cdf466d4f8f85930ac12cd11b13b6f94a423b9512443d59803762113b4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: fault","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fault","exampleIds":[],"headword":"murf\u00d7venor","id":"shakespeare014.lex.enormity_fault","ipa":"","label":"enormity_fault","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murf\u0113venor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A grave fault or outrageous vice in Menenius\u2019s taunting comparison; not merely physical size.","id":"shakespeare014.lex.enormity_fault.sense","status":"draft"}],"status":"draft","variants":[]},"a629223de28559a92b4b04781436ed7a27792541a91e931d58b8f93fd4641843":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: banner + carry","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: banner + carry","exampleIds":[],"headword":"felendewy\u00c9\u00db\u00c7d","id":"shakespeare014.lex.ensign_rank","ipa":"","label":"ensign_rank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"felendewy\u00e4sh\u00e3d","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The military rank of standard-bearer, called ancient in the source. Distinct from elderly.","id":"shakespeare014.lex.ensign_rank.sense","status":"draft"}],"status":"draft","variants":[]},"329e09fac1762d2f2663af0dfc1f0d48dc9dfede922cb452c5cbf675d0784193":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of throne","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of throne","exampleIds":[],"headword":"var\u00dfnsilen","id":"shakespeare014.lex.enthrone_rule","ipa":"","label":"enthrone_rule","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"var\u014dnsilen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Install or display someone as a ruler upon a ceremonial seat, in Caesar\u2019s account of Antony and Cleopatra. Native throne made verbal, without adding another physical throne above their golden chairs.","id":"shakespeare014.lex.enthrone_rule.sense","status":"draft"}],"status":"draft","variants":[]},"f2a86e0d0b25235e2d48567eecd08081a6ba5508e5f13d1666adb684bf87ead2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of enter","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of enter","exampleIds":[],"headword":"ybs\u00df","id":"shakespeare014.lex.entrance_event","ipa":"","label":"entrance_event","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ybs\u014d","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The action of entering, especially a performer\u2019s arrival onstage. Nominal use of native enter, distinct from a physical door or a fee for admission.","id":"shakespeare014.lex.entrance_event.sense","status":"draft"}],"status":"draft","variants":[]},"eea4bb5ba678781b205ea434e906151f2daf77dacac10c8e71cf865352638950":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of entreat","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of entreat","exampleIds":[],"headword":"w\u00cfin","id":"shakespeare014.lex.entreaty_request","ipa":"","label":"entreaty_request","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00cfin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An earnest appeal, Lepidus\u2019s request that the others stop provoking one another. Nominal use of the native entreat root, not an already granted command.","id":"shakespeare014.lex.entreaty_request.sense","status":"draft"}],"status":"draft","variants":[]},"b50c5b897a3f44984b8bbd943cd496aa998a7479aba8bd81feba88ef066a302a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_envy","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_envy","exampleIds":[],"headword":"zhemir","id":"shakespeare014.lex.envy","ipa":"","label":"envy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb/noun","pronunciation":"zhemir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Desire or resent another\u2019s advantage; distinct from jealousy of a sexual rival.","id":"shakespeare014.lex.envy.sense","status":"draft"}],"status":"draft","variants":[]},"dff613f750842a7770d01a2b92209964d2a44eae6111b754627e781e00945e59":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of envy","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of envy","exampleIds":[],"headword":"zhemir","id":"shakespeare014.lex.envy_malice","ipa":"","label":"envy_malice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"zhemir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Envious in Celia\u2019s reproach means spiteful or malicious in disposition. Contextual extension of envy, distinct from merely wanting another person\u2019s possessions.","id":"shakespeare014.lex.envy_malice.sense","status":"draft"}],"status":"draft","variants":[]},"a23fbf83098c838f8a675292bd7c71d3a8e5f1d1b5bba6f7eadd993fbc251583":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"efesus","id":"shakespeare014.lex.ephesus_temple_city","ipa":"","label":"ephesus_temple_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"efesus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The city of Cerimon and Diana's temple.","id":"shakespeare014.lex.ephesus_temple_city.sense","status":"draft"}],"status":"draft","variants":[]},"2241792ac33c262f5efeb56551bce63353740da95b004a3bc8a27e9b35b6c8ce":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_epicurean_acts","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_epicurean_acts","exampleIds":[],"headword":"pomj\u00d7v","id":"shakespeare014.lex.epicure_dramatic","ipa":"","label":"epicure_dramatic","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pomj\u0113v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A person labelled through the native philosophical-school term in Antony\u2019s joke: possibly a pleasure-seeker hard to satisfy, possibly a doubter of the proposed transmigration. Both readings remain in the review. This later literary sense does not assert the school\u2019s doctrine as a narrator fact or import the Acts audience.","id":"shakespeare014.lex.epicure_dramatic.sense","status":"draft"}],"status":"draft","variants":[]},"65dbc8a18a3fd49a0534202053703d2c8c1ed2c79b8e9221b1b35837d89b9d60":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"epikurus","id":"shakespeare014.lex.epicurus_philosopher","ipa":"","label":"epicurus_philosopher","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"epikurus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The philosopher whose views Cassius says he formerly held firmly before giving partial credence to omens.","id":"shakespeare014.lex.epicurus_philosopher.sense","status":"draft"}],"status":"draft","variants":[]},"b5b869eac7ac344e52cd2f39715a542e1a2ebf7cd64dae41205b38df2e4f2cb2":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"epidamium","id":"shakespeare014.lex.epidamium_trade_city","ipa":"","label":"epidamium_trade_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"epidamium","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The trading city where the twins were born. Keep the local spelling and distinguish Epidaurus, named separately in the rescue account.","id":"shakespeare014.lex.epidamium_trade_city.sense","status":"draft"}],"status":"draft","variants":[]},"5c032e6145591fe40cca920eee1c239222b2744af9e509be8e48bae14ae39153":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"epid\u00e5rus","id":"shakespeare014.lex.epidaurus_rescue_port","ipa":"","label":"epidaurus_rescue_port","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"epidourus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The port named for one approaching ship in Egeon's account. The abbess later speaks of men from Epidamium.","id":"shakespeare014.lex.epidaurus_rescue_port.sense","status":"draft"}],"status":"draft","variants":[]},"dc6972061331c27ae4bff2891c87c8e38426d256ead2e32262d9aeef4f74ade3":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic p