iii.sense","status":"draft"}],"status":"draft","variants":[]},"f236c9cd349a9d5050eedae8f936d35058229e3ed9ca440a8308f4370ac5663e":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"sufok","id":"shakespeare014.lex.suffolk_pole_title","ipa":"","label":"suffolk_pole_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sufok","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The earldom held in this play by William de la Pole, distinct from the Suffolk killed at Agincourt.","id":"shakespeare014.lex.suffolk_pole_title.sense","status":"draft"}],"status":"draft","variants":[]},"87da2b71e66b79be1c5ee600d60b711b3e5542b39de892d3af1d1c2a1487ee71":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: choose + voice","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: choose + voice","exampleIds":[],"headword":"nerbyalgiktenv\u00d7son","id":"shakespeare014.lex.suffrage_vote","ipa":"","label":"suffrage_vote","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerbyalgiktenv\u0113son","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The citizens\u2019 consenting voice in choosing a consul, native choose-voice. Keeps the political sense without assuming paper ballots or deleting the associated breath metaphor.","id":"shakespeare014.lex.suffrage_vote.sense","status":"draft"}],"status":"draft","variants":[]},"9846afbedfccb3d54427e9d76d9960a7dc06fabea6e642bf62236ecb88c59187":{"audioLinks":[],"citations":[{"locator":"Authored native compound: reed + sweet","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"