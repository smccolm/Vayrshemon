":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The red coloration of a lip, nominal colour use of native red; no added blood or injury.","id":"shakespeare014.lex.redness_colour.sense","status":"draft"}],"status":"draft","variants":[]},"1111c9d43ab03a2718bcdafb680141f23941311e95f5cff89fbd15caea511df7":{"audioLinks":[],"citations":[{"locator":"Authored native lexical root, not a claim of documented historical sound change.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Authored native lexical root, not a claim of documented historical sound change.","exampleIds":[],"headword":"lamfil","id":"shakespeare014.lex.redress","ipa":"","label":"redress","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"lamfil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Set a grievance right, native juridical lam- family; distinct from possess a right and from mere causation.","id":"shakespeare014.lex.redress.sense","status":"draft"}],"status":"draft","variants":[]},"5bf0909cb25e2f7577350a12d1875cd53377aceb70849d1e65b87b1b9378e978":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: smoke + dirty","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: smoke + dirty","exampleIds":[],"headword":"s\u00ebrunmurmayat","id":"shakespeare014.lex.reechy_grimy","ipa":"","label":"reechy_grimy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"s\u00fcrunmurmayat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Smoky or greasy-grimy, Brutus\u2019s contemptuous description of the kitchen servant\u2019s neck; not a skin colour or medical diagnosis.","id":"shakespeare014.lex.reechy_grimy.sense","status":"draft"}],"status":"draft","variants":[]},"819e46f913a9c0d7e38211c01f2ef198b335ce4869f97ab0ceacb01c6946252e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: stink","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: stink","exampleIds":[],"headword":"murmayatr\u00e3b","id":"shakespeare014.lex.reek_odour","ipa":"","label":"reek_odour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murmayatroib","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An offensive smell or vapor in Coriolanus\u2019s insult to the crowd, explicit nominal stink. Not narrator confirmation that the citizens carry a disease.","id":"shakespeare014.lex.reek_odour.sense","status":"draft"}],"status":"draft","variants":[]},"85be7e0e4b4bb4c0a7d3ce79e790ae9e383b6cf139fc3ad04b12bed535cf0ba9":{"audioLinks":[],"citations":[{"locator":"Authored native formation; motivation in definition, not claimed historical attestation.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native formation; motivation in definition, not claimed historical attestation.","exampleIds":[],"headword":"rilyan","id":"shakespeare014.lex.reel_stagger","ipa":"","label":"reel_stagger","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"rilyan","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Move unsteadily from side to side; authored turn/motion-family formation, the aged sun\u2019s departure.","id":"shakespeare014.lex.reel_stagger.sense","status":"draft"}],"status":"draft","variants":[]},"571098587484a276d200f4053d2af7162cb99ebcedb9800cbf04d4667bc8b1e2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: turn + revel","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: turn + revel","exampleIds":[],"headword":"elyi\u00d1y\u00e9\u00dbnafaln","id":"shakespeare014.lex.reeling_revel","ipa":"","label":"reeling_revel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elyichy\u00e9shnafaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Revelry with a turning or reeling image in the wheels/reels exchange. Native turn-revel keeps the festive motion link, though it does not recreate the English rhyme and does not specify a named later dance.","id":"shakespeare014.lex.reeling_revel.sense","status":"draft"}],"status":"draft","variants":[]},"ed4e110e35676277b7c8abee5baf242473bd70dbc6adb155b1cc79ed0e0c3505":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from return, image","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from return, image","exampleIds":[],"headword":"sezif\u00c7\u00c3l\u00dfnil","id":"shakespeare014.lex.reflection","ipa":"","label":"reflection","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sezif\u00e3jzhl\u014dnil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An image returned by a reflecting surface, specifically water here; not an independent person or cast shadow.","id":"shakespeare014.lex.reflection.sense","status":"draft"}],"status":"draft","variants":[]},"614f9805e53bd71ce6f761830f518de4bfe6436109ae634ab1a2eb5d3ee9f680":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: keep + back","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: keep + back","exampleIds":[],"headword":"jem\u00e3tar","id":"shakespeare014.lex.refrain_action","ipa":"","label":"refrain_action","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"jemoitar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Hold oneself back from an action; differs from ceasing an action already underway.","id":"shakespeare014.lex.refrain_action.sense","status":"draft"}],"status":"draft","variants":[]},"8757afceb44ea5cbfab63b2507b390c9e5d2c4d11163f755c321588be20af615":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"jemlin","id":"shakespeare014.lex.refuge","ipa":"","label":"refuge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jemlin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A sheltering place or defensible ground of safety; authored guard/place-family term, here the innocence of Lucrece\u2019s mind.","id":"shakespeare014.lex.refuge.sense","status":"draft"}],"status":"draft","variants":[]},"94b812471990eeb0021955ffdd7ef1d5a4c933e28f79caacff696c9fd733167d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of refuse","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of refuse","exampleIds":[],"headword":"matond","id":"shakespeare014.lex.refusal","ipa":"","label":"refusal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"matond","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The act of refusing a request, in Tarquin\u2019s minimization of consequences.","id":"shakespeare014.lex.refusal.sense","status":"draft"}],"status":"draft","variants":[]},"63b73217c22207