e014.lex.seigniory_land.sense","status":"draft"}],"status":"draft","variants":[]},"a060f7eeb40d478029c5428aec67d762879d448d29f3b85cb9a7b9785f216b6b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"seleukus","id":"shakespeare014.lex.seleucus_treasurer","ipa":"","label":"seleucus_treasurer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"seleukus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Cleopatra\u2019s treasurer in the final scene. Distinct from any Seleucid monarch; the source supplies this office and no dynasty.","id":"shakespeare014.lex.seleucus_treasurer.sense","status":"draft"}],"status":"draft","variants":[]},"0882d3e13bc512ca9f28a0360b7a01d2231934cf0eeb74b713bd58ebfda0aefe":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: self + control","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: self + control","exampleIds":[],"headword":"irnor\u00d3ajem\u00e3","id":"shakespeare014.lex.self_control","ipa":"","label":"self_control","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"irnorthajemoi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Regulation of one\u2019s own expression or action, smiling government in Ulysses.","id":"shakespeare014.lex.self_control.sense","status":"draft"}],"status":"draft","variants":[]},"d43713e8b534ac008d77aa8c07a8739beb6330b8fd5fa9511750a9079bfc52e6":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Native compound of self, property. Property personified: defining individuality with a possessive resonance. Not merely real estate or a moral prohibition on ownership.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Native compound of self, property. Property personified: defining individuality with a possessive resonance. Not merely real estate or a moral prohibition on ownership.","exampleIds":[],"headword":"irteglizl\u00dfnden","id":"shakespeare014.lex.self_distinction","ipa":"","label":"self_distinction","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"irteglizl\u014dnden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Property personified: defining individuality with a possessive resonance. Not merely real estate or a moral prohibition on ownership.","id":"shakespeare014.lex.self_distinction.sense","status":"draft"}],"status":"draft","variants":[]},"a600f7277457316bf249604f10e5466b012b3ae0756d2f38e8f3f738ab050752":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: self + will","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: self + will","exampleIds":[],"headword":"ir\u00c9lm","id":"shakespeare014.lex.self_will_personified","ipa":"","label":"self_will_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ir\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The will serving only itself, personified as a tired horse; native self-will, no extra agent in the action.","id":"shakespeare014.lex.self_will_personified.sense","status":"draft"}],"status":"draft","variants":[]},"010c9816e8159bc530908df560687198d4e97c100b3ab5a2716944f8bbfd4592":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from seem, form","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from seem, form","exampleIds":[],"headword":"\u00d3\u00e1lun\u00c3l\u00dfn","id":"shakespeare014.lex.semblance","ipa":"","label":"semblance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"th\u00f4lunjzhl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Outward likeness or appearance, here an innocent disguise; not a second actual identity.","id":"shakespeare014.lex.semblance.sense","status":"draft"}],"status":"draft","variants":[]},"b8074bd2cd6c2804732574b6fd4a63907bbc9e3e260e58d9cedc5c1b9cfa8bca":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_seed_copulation","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_seed_copulation","exampleIds":[],"headword":"p\u00e1in","id":"shakespeare014.lex.seminal_seed","ipa":"","label":"seminal_seed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4in","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Seminal seed in Cleopatra\u2019s unseminared description of Mardian; no borrowed medical term or invented diagnosis beyond the source eunuch designation.","id":"shakespeare014.lex.seminal_seed.sense","status":"draft"}],"status":"draft","variants":[]},"71712b68214301a35662991fc21af3b006674bc64d44fe08d90fcd60e85b67c7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"semiramis","id":"shakespeare014.lex.semiramis_assyrian_queen","ipa":"","label":"semiramis_assyrian_queen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"semiramis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The queen whose luxurious bed the lord invokes to tempt Sly.","id":"shakespeare014.lex.semiramis_assyrian_queen.sense","status":"draft"}],"status":"draft","variants":[]},"d5aa7a31991021b99f2d799c6496bedad8f63ca6d67b92399a30700d1148bb31":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"sempronius","id":"shakespeare014.lex.sempronius_andronici_kinsman","ipa":"","label":"sempronius_andronici_kinsman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sempronius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"A gentleman named among the archers, distinct from Timon's guest.","id":"shakespeare014.lex.sempronius_andronici_kinsman.sense","status":"draft"}],"status":"draft","variants":[]},"ed10e79b6b6b0474d88020f4b83fdecffadae7c761e7379e59be65888847c407":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"sempronius","id":"shakespeare014.lex.sempronius_timon_guest","ipa":"","label":"sempronius_timon_guest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sempronius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"definition":"A lord who resents being asked for aid after the other guests.","id":"shakespeare014.lex.sempronius_timon_guest.sense","status":"draft"}],"status":"draft","variants":[]},"762e7d2e6fca4a74775e7ac11ff45abe784a1470348e0