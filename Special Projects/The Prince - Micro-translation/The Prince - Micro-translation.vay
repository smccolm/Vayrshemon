ind.sense","status":"draft"}],"status":"draft","variants":[]},"7969e860a55e007b012579165a47a18af76bd0da1656b5df273d8743ece8ede2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: memory + herb","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: memory + herb","exampleIds":[],"headword":"tar\u00d5yelin","id":"shakespeare014.lex.rosemary_memory","ipa":"","label":"rosemary_memory","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tar\u0167hyelin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The fragrant herb Ophelia gives for remembrance. Its native name carries the association she makes herself.","id":"shakespeare014.lex.rosemary_memory.sense","status":"draft"}],"status":"draft","variants":[]},"62f64f0e7080f6b70ef6a44256b277e96ee5e53acdf3de45540a3098f0b8091f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"rosenkrants","id":"shakespeare014.lex.rosencrantz_companion","ipa":"","label":"rosencrantz_companion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"rosenkrants","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A childhood companion of Hamlet summoned by the king and queen.","id":"shakespeare014.lex.rosencrantz_companion.sense","status":"draft"}],"status":"draft","variants":[]},"15c48a670c9b8e341f77c2adb4fac01e129c4962ff58208913ee9003fe71e363":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: rose + water","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: rose + water","exampleIds":[],"headword":"polyems