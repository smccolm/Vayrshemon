ech":"noun","pronunciation":"dlenfartonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Coaxing praise or pleasing self-persuasion, the speaker\u2019s openly named consolation in Sonnet 42.","id":"shakespeare014.lex.flattery.sense","status":"draft"}],"status":"draft","variants":[]},"c2709fe0b31d81efbc26a541e46240d30734247b4e2a1a9fcc66d104cf5688f4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"flavina","id":"shakespeare014.lex.flavina_emilia_beloved","ipa":"","label":"flavina_emilia_beloved","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"flavina","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"Emilia's childhood companion, who died when they were both eleven. Emilia compares their attachment with that of Pirithous and Theseus.","id":"shakespeare014.lex.flavina_emilia_beloved.sense","status":"draft"}],"status":"draft","variants":[]},"e3afebf50bfb220951ab7aad5435f591ab6afd5a1f9a966e5112bafd327e1956":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"flavius","id":"shakespeare014.lex.flavius_brutus_officer","ipa":"","label":"flavius_brutus_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"flavius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The officer appearing with Labeo at Philippi, distinct from the tribune in the first street scene.","id":