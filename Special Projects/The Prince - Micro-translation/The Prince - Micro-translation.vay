113rdlenshemin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A leftover portion of food, the orts craved by the imagined beggar; not a fragment of metal or paper.","id":"shakespeare014.lex.food_scrap.sense","status":"draft"}],"status":"draft","variants":[]},"5f54d750fe84e13f29c040279ffb33d0f4cb65cc9b3da68c23fedbb32391e89b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: short + arrow","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: short + arrow","exampleIds":[],"headword":"s\u00dfrnkeril","id":"shakespeare014.lex.fool_bolt","ipa":"","label":"fool_bolt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"s\u014drnkeril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The blunt short arrow of the fool\u2019s-bolt proverb, not a door fastener.","id":"shakespeare014.lex.fool_bolt.sense","status":"draft"}],"status":"draft","variants":[]},"41c0abf30df1452893483a0c6f62e5d31d4915c922afe7856cc6df7a253569e0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: fool","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fool","exampleIds":[],"headword":"lof","id":"shakespeare014.lex.foolery_behavior","ipa":"","label":"foolery_behavior","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lof","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Foolish conduct, explicit nominal fool in the warning that bravery against a falling structure is folly. Not a new court fool or a claim that the danger is theatrical entertainment.","id":"shakespeare014.lex.foolery_behavior.sense","status":"draft"}],"status":"draft","variants":[]},"0fba58676a6ebbf52ed9bcc97424f45deaeb8d2466f579665c21c7199b970d57":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: rash","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: rash","exampleIds":[],"headword":"s\u00dfrnw\u00c5vumenmarin","id":"shakespeare014.lex.foolhardiness_rash","ipa":"","label":"foolhardiness_rash","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"s\u014drnw\u0101vumenmarin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Reckless daring as the soldier judges Martius\u2019s entry; nominal use of native rash, distinct from a skin eruption.","id":"shakespeare014.lex.foolhardiness_rash.sense","status":"draft"}],"status":"draft","variants":[]},"e829ffa4d2944bf69f6097bb94d1048dbf27f619806628db265e1c23c146fed2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fool + cap_bonnet","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: fool + cap_bonnet","exampleIds":[],"headword":"lofharen felen","id":"shakespeare014.lex.fools_cap_coxcomb","ipa":"","label":"fools_cap_coxcomb","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lofharen felen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The cap the Fool offers Kent. Its name transfers the office and the charge of folly to whoever wears it.","id":"shakespeare014.lex.fools_cap_coxcomb.sense","status":"draft"}],"status":"draft","variants":[]},"073a58bf47776c06feb52dde2e4311d2cd8fa5a4db6da84149173d50c32fc2f5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: foot","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: foot","exampleIds":[],"headword":"pales","id":"shakespeare014.lex.foot_g