","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murilyelfal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The columbine offered with fennel. Native dove-flower; no specific recipient assigned by the stage direction.","id":"shakespeare014.lex.columbine_flower.sense","status":"draft"}],"status":"draft","variants":[]},"b0223e508c89ddc5c4231794803987a77887d8e2007478a2839a2619e6571d45":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"komagen","id":"shakespeare014.lex.comagen_region","ipa":"","label":"comagen_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"komagen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Comagen, the supplied territorial spelling associated with Mithridates; keep the printed variant without inserting a modern state.","id":"shakespeare014.lex.comagen_region.sense","status":"draft"}],"status":"draft","variants":[]},"af70ac1d6759fcbf3b1c0d80ca97709e8f9d9e378f51d25c76177ba6e9c21c78":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: star + hair","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: star + hair","exampleIds":[],"headword":"b\u00e7orinf\u00ebl","id":"shakespeare014.lex.comet_portent","ipa":"","label":"comet_portent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u016borinf\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"A star with streaming hair, the portent with crystal tresses in Bedford's invocation.","id":"shakespeare014.lex.comet_portent.sense","status":"draft"}],"status":"draft","variants":[]},"c2ceac0b5e2814b1b1e88585992b87cd33a8e7e0bcf22134097eb8d2aef4a26c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sweetmeat","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: sweetmeat","exampleIds":[],"headword":"meld\u00cdn\u00d7r","id":"shakespeare014.lex.comfect_confection_nickname","ipa":"","label":"comfect_confection_nickname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"meld\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The mocking sweetmeat title Beatrice gives Claudio in her fury at the denunciation.","id":"shakespeare014.lex.comfect_confection_nickname.sense","status":"draft"}],"status":"draft","variants":[]},"d6c836dfa01542800a8c512fe267461c5fd17868c0a8e0b93c79887f3d27a13e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: comfort","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: comfort","exampleIds":[],"headword":"han","id":"shakespeare014.lex.comfort_consolation","ipa":"","label":"comfort_consolation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"han","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Comfort offered for loss, Enobarbus\u2019s proposed compensatory replacement of a wife.","id":"shakespeare014.lex.comfort_consolation.sense","status":"draft"}],"status":"draft","variants":[]},"ee09abc7b5b11ab1cc70ec073c842e89936f8761e38b3af4293195f51f569c3c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kominius","id":"shakespeare014.lex.cominius_general","ipa":"","label":"cominius_general","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kominius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The Roman commander in Coriolanus.","id":"shakespeare014.lex.cominius_general.sense","status":"draft"}],"status":"draft","variants":[]},"ac0bd5ec17193cbe27195f7f2fc348bb09e47c4b18d66c6ef22dd4e5d83ef2c9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: command + army","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: command + army","exampleIds":[],"headword":"nor\u00d3ahefak gurs\u00dflum\u00e1pe\u00dbem","id":"shakespeare014.lex.command_force","ipa":"","label":"command_force","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"northahefak gurs\u014dlum\u00f4peshem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The force selected to serve under Martius\u2019s command, not the content of a spoken order or the whole Roman army.","id":"shakespeare014.lex.command_force.sense","status":"draft"}],"status":"draft","variants":[]},"40b902b2a3944d95fba0a5ab1ec8ce9a6cf7d0f1c3b6965e3e0da4e6c19a0c64":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of command","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of command","exampleIds":[],"headword":"nor\u00d3a","id":"shakespeare014.lex.command_order","ipa":"","label":"command_order","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"northa","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Give an authoritative order, the beloved\u2019s eyes commanding the speaker\u2019s best qualities in Sonnet 149.","id":"shakespeare014.lex.command_order.sense","status":"draft"}],"status":"draft","variants":[]},"866979bf07b3dd9f0172ed1cf9e1fd367fe1dbd48ba208d35085ea4f8b5acc4d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: present + praise","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: present + praise","exampleIds":[],"headword":"venfartonda","id":"shakespeare014.lex.commend_intro","ipa":"","label":"commend_intro","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"venfartonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Introduce a person favorably so that a host may receive him. The requested recommendation is a condition of access.","id":"shakespeare014.lex.commend_intro.sense","status":"draft"}],"status":"draft","variants":[]},"fa6b65c4d4d05db1ea1c440b83002c801d7a77ba0dcf06383535eb53bc662a82":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: army + authority","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: army + authority","exampleIds":[],"headword":"hefak gurs\u00dflum\u00e1pe\u00dbemmarvenen","id":"shakespeare014.lex.commission_command","ipa":"","label":"commission_command","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlum\u00f4peshemmarvenen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Military command/authority offered in equal shares to the former opponent. Native army-authority; distinct from a sales fee or an unspecified written letter.","id":"shakespeare014.lex.commission_command.sense","status":"draft"}],"status":"draft","variants":[]},"1a77849dd37fa77fff47845e27835d7906b3a6757f042211d8010ee4b6eba3c8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: own + advantage","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: own + advantage","exampleIds":[],"headword":"k\u00cfba\u00d1farmin","id":"shakespeare014.lex.commodity_self_interest","ipa":"","label":"commodity_self_interest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"k\u00cfbachfarmin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Commodity personified in the Bastard's soliloquy is the advantage one seeks for oneself. He ends by worshipping Gain.","id":"shakespeare014.lex.commodity_self_interest.sense","status":"draft"}],"status":"draft","variants":[]},"5850eafed039c7b42ab13c73cbee046076c365d90a97289f734232168cce849d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: all + share","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: all + share","exampleIds":[],"headword":"olinst\u00dfb\u00df","id":"shakespeare014.lex.common_indiscriminate","ipa":"","label":"common_indiscriminate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"olinst\u014db\u014d","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Given indiscriminately to everyone, the source common in my love. Retains the connection to sharing and the common people; does not introduce a sexual promiscuity claim.","id":"shakespeare014.lex.common_indiscriminate.sense","status":"draft"}],"status":"draft","variants":[]},"29095a27a534f9e0ffa502dff3022506485946063b24c652efc552c98f098e74":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: common + person","sourceId":"shakespeare014.source.antony-and-c