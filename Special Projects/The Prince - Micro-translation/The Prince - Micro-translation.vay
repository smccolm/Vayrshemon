ymology":"Authored native derivation/sense: calm","exampleIds":[],"headword":"etyeksf\u00e7s","id":"shakespeare014.lex.calmness_composure","ipa":"","label":"calmness_composure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"etyeksf\u016bs","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Composure as a possible defense against the crowd, explicit nominal calm. It is offered as a course of action, not asserted to be Coriolanus\u2019s present temperament.","id":"shakespeare014.lex.calmness_composure.sense","status":"draft"}],"status":"draft","variants":[]},"e2e941982cd761c88345a0ecba289d230900415bc62e7945e214a4843ec04394":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kalfurnia","id":"shakespeare014.lex.calphurnia_caesar_wife","ipa":"","label":"calphurnia_caesar_wife","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kalfurnia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"Caesar's wife, whom he asks Antony to touch during the ritual race. The witness spells the name Calphurnia.","id":"shakespeare014.lex.calphurnia_caesar_wife.sense","status":"draft"}],"status":"draft","variants":[]},"8cb5b9a583880979ed4bedbc04f4103e140def86ae016a439195616117a2181a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_calf + bear","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_calf + bear","exampleIds":[],"headword":"nev borala\u00d9\u00d5\u00dfr","id":"shakespeare014.lex.calve_birth","ipa":"","label":"calve_birth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciati