019s eyes; no throne or biblical scene imported.","id":"shakespeare014.lex.rainbow.sense","status":"draft"}],"status":"draft","variants":[]},"d6ad09b5b730e7139e1497a21cc9758cdb31a4012acd5be0245323c3419a3737":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"reinold","id":"shakespeare014.lex.rainold_cobham_given","ipa":"","label":"rainold_cobham_given","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"reinold","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"Given name of Lord Cobham in Northumberland's report from Brittany.","id":"shakespeare014.lex.rainold_cobham_given.sense","status":"draft"}],"status":"draft","variants":[]},"5abf2b2da7dc083cd5b6adb5842ed84d96ed1ea5059cb2e43e119c856cb4cb09":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: field + tooth","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: field + tooth","exampleIds":[],"headword":"w\u00cfn\u00c7ker","id":"shakespeare014.lex.rake_tool","ipa":"","label":"rake_tool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00cfn\u00e3ker","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A toothed farm implement, used for the gaunt citizen\u2019s shape. Native field-tooth category; not a libertine.","id":"shakespeare014.lex.rake_tool.sense","status":"draft"}],"status":"draft","variants":[]},"042fc4486f621c9e92cf6d6ba0da3b9d3b9263bb4df4dc0311a9f4f5f9dd7d76":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted ph