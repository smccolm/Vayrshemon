ource.the-two-noble-kinsmen.r1"}],"definition":"Countrywoman who arrives with Fritz; distinct from the daughter who joins the dance later.","id":"shakespeare014.lex.maudlin_may_dancer.sense","status":"draft"}],"status":"draft","variants":[]},"ad8054053a1bbbbbc25b5fdf6bf94edba5b6e13d25987470b625833696497912":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"mauritaniya","id":"shakespeare014.lex.mauritania_iago_destination","ipa":"","label":"mauritania_iago_destination","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"mauritaniya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The destination Iago tells Roderigo the couple will visit. It conflicts with the recall to Venice.","id":"shakespeare014.lex.mauritania_iago_destination.sense","status":"draft"}],"status":"draft","variants":[]},"3ea8efe2077b0b02bd9abf3f260ed5abc3d451a45df9c411b34f6d243651af83":{"audioLinks":[],"citations":[{"locator":"Source-calendar reference expressed with the exact Unta ordinal five and the native month term.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Source-calendar reference expressed with the exact Unta ordinal five and the native month term.","exampleIds":[],"headword":"jensis\u2019t venlun","id":"shakespeare014.lex.may_source","ipa":"","label":"may_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jensis\u2019t venlun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"May, the fifth month of the source poet\u2019s English calendar; native Unta ordinal plus month, not an invented Vayrshemon calendar equivalence.","id":"shakespeare014.lex.may_source.sense","status":"draft"}],"status":"draft","variants":[]},"7128f283981aa193aaa149b57668f0e5b6b6fa5dcac8b59689b5c3f4e6483012":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: city + chief","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: city + chief","exampleIds":[],"headword":"z\u00e1lagurharen","id":"shakespeare014.lex.mayor_london","ipa":"","label":"mayor_london","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The leading civic officer who comes out with his brethren to welcome the returning king.","id":"shakespeare014.lex.mayor_london.sense","status":"draft"}],"status":"draft","variants":[]},"970aa6d7278f213c805e50e8032a68a942cd4de58856d8814e81881be2691018":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from flesh, lack","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from flesh, lack","exampleIds":[],"headword":"vorinmavsif","id":"shakespeare014.lex.meagre","ipa":"","label":"meagre","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"vorinmavsif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Wasted or scant of flesh, the appearance of personified Death, distinct from leaning on something.","id":"shakespeare014.lex.meagre.sense","status":"draft"}],"status":"draft","variants":[]},"df5133c914619511c79e3e9b901bd61d4a2de281ef0c747902707d006b6c01fd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: meal + blessing","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: meal + blessing","exampleIds":[],"headword":"klojvord\u00cdn\u00d7rprodf\u00c5w","id":"shakespeare014.le