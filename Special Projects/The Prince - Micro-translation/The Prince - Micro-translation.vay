ing.sense","status":"draft"}],"status":"draft","variants":[]},"f086d03ec0a40d152d59ed232730587bb0f17586baa7ff52560d5ff682f0bfbc":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","exampleIds":[],"headword":"y\u00eblyemarviminy\u00eblyemar","id":"shakespeare014.lex.drama_native_cockboat_tender","ipa":"","label":"drama_native_cockboat_tender","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclyemarviminy\u00fclyemar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The small tender of the larger vessel in Edgar's account of the supposed cliff.","id":"shakespeare014.lex.drama_native_cockboat_tender.sense","status":"draft"}],"status":"draft","variants":[]},"9e192ee4c88add231601ecf54b2e7e154e7c806d01073b9cca79693b9cbeafaf":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. Become set, as a liquid does.","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Dramatic native reading. Become set, as a liquid does.","exampleIds":[],"headword":"t\u00e9zjem","id":"shakespeare014.lex.drama_native_congeal","ipa":"","label":"drama_native_congeal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"root","pronunciation":"t\u00e9zjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"thicken or solidify from liquid","id":"shakespeare014.lex.drama_native_congeal.sense","status":"draft"}],"status":"draft","variants":[]},"c143ca350a68bca8e04788fbd97b66b85cabe07606c2374925f66b8987fe8074":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. The smaller horn instrument. Keep its separate instrument key.","sourceId":"shakespeare0