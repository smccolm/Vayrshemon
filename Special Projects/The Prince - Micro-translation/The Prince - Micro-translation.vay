"senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A drinking revel Caesar urges Antony to abandon; native drink-revel, not a borrowed toast formula.","id":"shakespeare014.lex.wassail_drinking.sense","status":"draft"}],"status":"draft","variants":[]},"48650023b223e9407f314bddea38c2fe61e6a70350c84b7000eb444a8739c473":{"audioLinks":[],"citations":[{"locator":"Permitted personal/place-name sound approximation.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Permitted personal/place-name sound approximation.","exampleIds":[],"headword":"wat","id":"shakespeare014.lex.wat_hare","ipa":"","label":"wat_hare","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Wat, the poem\u2019s familiar personal name for the hunted hare; the generic animal retains its native hare word.","id":"shakespeare014.lex.wat_hare.sense","status":"draft"}],"status":"draft","variants":[]},"3f6ed68a1569d9aff40600a33ce370b3c16ed5db48e7be8d983360e9416af222":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_hook + blade + staff","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: kjv_hook + blade + staff","exampleIds":[],"headword":"lunor gl\u00c9z\u00cbenlenirteral","id":"shakespeare014.lex.watch_bill_hooked_weapon","ipa":"","label":"watch_bill_hooked_weapon","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lunor gl\u00e4zhwenlenirteral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The watchman's hooked pole weapon. Borachio also hears a merchant's bill in the joke about being taken up on credit.","id":"shakespeare014.lex.watch_bill_hooked_weapon.sense","status":"draft"}],"status":"draft","variants":[]},"86d2ae71b167a50f700d651c7196661066df03984f3c33e5ec49fe33385e7b7b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_duty_watch","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_duty_watch","exampleIds":[],"headword":"jemekvenor","id":"shakespeare014.lex.watch_duty","ipa":"","label":"watch_duty","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jemekvenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The assigned guard watch limiting the soldiers\u2019 following of the music; the time or scope of duty, not a numerical quarter.","id":"shakespeare014.lex.watch_duty.sense","status":"draft"}],"status":"draft","variants":[]},"5b63b2630a639836dd3bfedb6fb9b71353de5b7891f4678c2707434c8a7768cb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: question + record","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: question + record","exampleIds":[],"headword":"w\u00cf\u00dfenint\u00dff\u00c9ben","id":"shakespeare014.lex.watch_examination_record","ipa":"","label":"watch_examination_record","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00cf\u014denint\u014df\u00e4ben","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The formal questioning and its written record. Dogberry later forces the noun into a verb in his instructions.","id":"shakespeare014.lex.watch_examination_record.sense","status":"draft"}],"status":"draft","variants":[]},"bb134d5fdcc71e70e0c8961cae9108b56c3fc3f23d0130df2e23029de0e6d046":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: watch + floor","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: watch + floor","exampleIds":[],"headword":"o\u00c3jemjo\u00d9shal","id":"shakespeare014.lex.watch_platform","ipa":"","label":"watch_platform","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ojzhjemjongshal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The elevated standing place where the sentinels and Hamlet keep the night watch.","id":"shakespeare014.lex.watch_platform.sense","status":"draft"}],"status":"draft","variants":[]},"fcfd87fd67ad1905d127b5d49c0a67996af35b975654e01b2728e6d2c8cae453":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from water, path","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from water, path","exampleIds":[],"headword":"yems\u00d7marjo\u00d9","id":"shakespeare014.lex.water_channel","ipa":"","label":"water_channel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113marjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A course carrying water, figuratively the bosom\u2019s channel carrying tears.","id":"shakespeare014.lex.water_channel.sense","status":"draft"}],"status":"draft","variants":[]},"121eb93dbe287b4a087bb59b200912825381621c92eb0cdccae68aed331994c1":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of freeze","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of freeze","exampleIds":[],"headword":"t\u00e9zkl\u00e1rjem","id":"shakespeare014.lex.water_congeal","ipa":"","label":"water_congeal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"t\u00e9zkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Water freezing or forming a distorted icy surface, the source waters warp. A contextual frozen-water image, not an assertion of a particular crystal structure; the English weave/distort resonance is not fully reproduced.","id":"shakespeare014.lex.water_congeal.sense","status":"draft"}],"status":"draft","variants":[]},"b69081b68a1e50c7c34432116071ca04c9aad7c7bc3dd1d5d2f14ebc373abd47":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of deep","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of deep","exampleIds":[],"headword":"durun","id":"shakespeare014.lex.water_depth","ipa":"","label":"water_depth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"durun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Distance below a water surface, metaphorically the patron\u2019s inexhaustible worth in Sonnet 80; nominal depth rather than silent sound.","id":"shakespeare014.lex.water_depth.sense","status":"draft"}],"status":"draft","variants":[]},"2dccc57c75224a055c4aa558dda6ee3988515d097d06554192c4ee4cb8f8cbe8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_well","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_well","exampleIds":[],"headword":"yems\u00d7dul","id":"shakespeare014.lex.water_well","ipa":"","label":"water_well","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113dul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A well used to obtain water in the love-god story of Sonnet 154; no Biblical actors, promises or historical capacity measure are imported.","id":"shakespeare014.lex.water_well.sense","status":"draft"}],"status":"draft","variants":[]},"d92bc57dd5c7d61fb7782efb2d4a2547c1212e8584cfdb22869eb7ba186ac1ad":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"wotarford","id":"shakespeare014.lex.waterford_title","ipa":"","label":"waterford_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wotarford","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Earldom in Lucy's recitation of Talbot's titles.","id":"shakespeare014.lex.waterford_title.sense","status":"draft"}],"status":"draft","variants":[]},"ea01b28a7b95a0ec68a61c577083550f0b833d3ef1819da5e55627566e5b63af":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: water + bird","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: water + bird","exampleIds":[],"headword":"yems\u00d7wil","id":"shakespeare014.lex.waterfowl_native","ipa":"","label":"waterfowl_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113wil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A water bird, used with explicit wild and male modifiers for Scarus\u2019s mallard image. Native water-bird avoids an unnecessary foreign bird-name sound.","id":"shakespeare014.lex.waterfowl_native.sense","status":"draft"}],"status":"draft","variants":[]},"372b21c3235e7254c9ed793293eb5d3fd3da5756f44c9debb0e762c7c57cef8b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"waterton","id":"shakespeare014.lex.waterton_returning_knight","ipa":"","label":"waterton_returning_knight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"waterton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"Sir Robert Waterton, named among the returning party.","id":"shakespeare014.lex.waterton_returning_knight.sense","status":"draft"}],"status":"draft","variants":[]},"2f5a09a2d81f61eb080f735437a966626f0832e627c585ec9c9a95c895b2d7b7":{"audioLinks":[],"citations":[{"locator":"Reviewed literary sense of kjv_wave","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed literary sense of kjv_wave","exampleIds":[],"headword":"yems\u00d7ner\u00c3\u00cd","id":"shakespeare014.lex.wave","ipa":"","label":"wave","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113nerjzh\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Travelling rise of water, retaining the small bird\u2019s disappearing/reappearing simile.","id":"shakespeare014.lex.wave.sense","status":"draft"}],"status":"draft","variants":[]},"38a91144a4fe49caa65fbf83f9ffcf4244a40ba9dc4118842965c86379596365":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from wax, red","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from wax, red","exampleIds":[],"headword":"melsakoraz","id":"shakespeare014.lex.wax_red","ipa":"","label":"wax_red","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"melsakoraz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Red like sealing wax in the lips-as-seal metaphor.","id":"shakespeare014.lex.wax_red.sense","status":"draft"}],"status":"draft","variants":[]},"c6860ce6a13a382c87d377de16c1fc6f074676086be090124f6bfcbd183bcea1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wax + seal","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: wax + seal","exampleIds":[],"headword":"melsakordenlamet","id":"shakespeare014.lex.wax_seal_shut","ipa":"","label":"wax_seal_shut","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melsakordenlamet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Close as with wax. Posthumus imagines his embraces sealed against any later partner by the bonds of death.","id":"shakespeare014.lex.wax_seal_shut.sense","status":"draft"}],"status":"draft","variants":[]},"9ae3f46f2dbc0642270332a680153e1987de825c8fb9c63809010cff13383a22":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from own, will","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from own, will","exampleIds":[],"headword":"k\u00cfba\u00d1\u00c9lm","id":"shakespeare014.lex.wayward","ipa":"","label":"wayward","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"k\u00cfbach\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Bent on one\u2019s own course, here the narrator\u2019s description of the resisting youth.","id":"shakespeare014.lex.wayward.sense","status":"draft"}],"status":"draft","variants":[]},"f9b952692ffd89a41a53b2be84844bbde10b677b7f8c107e809bc98cc53c3275":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: polity_state + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: polity_state + person","exampleIds":[],"headword":"\u00e1pe\u00dbemvar\u00dfnens\u00dflum","id":"shakespeare014.lex.wealsman_official","ipa":"","label":"wealsman_official","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u00f4peshemvar\u014dnens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A public man serving or professing to serve the commonwealth, source wealsmen. Menenius\u2019s use is sarcastic; not an assertion of good governance.","id":"shakespeare014.lex.wealsman_official.sense","status":"draft"}],"status":"draft","variants":[]},"74be005c26a79f2f02261234530daab0f61871c5ec02aec68e03d4a8bb6378f7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_weasel","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_weasel","exampleIds":[],"headword":"\u00d3\u00ddrjil","id":"shakespeare014.lex.weasel","ipa":"","label":"weasel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"th\u012brjil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The source\u2019s nocturnal weasels; retains the established native creature category without zoological overprecision.","id":"shakespeare014.lex.weasel.sense","status":"draft"}],"status":"draft","variants":[]},"2793d04fc7cc4d5afedea854d93ba1a46d4854c65635faf167c61e23bc1fb225":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of classical_element","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of classical_element","exampleIds":[],"headword":"jo\u00d9olvoren","id":"shakespeare014.lex.weather_elements","ipa":"","label":"weather_elements","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongolvoren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The forces of nature or atmosphere wished kindly to Octavia during travel. Keeps the old elemental category without asserting modern chemical substances or the crocodile\u2019s life-forces as identical senses.","id":"shakespeare014.lex.weather_elements.sense","status":"draft"}],"status":"draft","variants":[]},"dae3e2b34941fb3903b413c5caff33496ba33308d38a592c34b50c8ce7b7bec0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wind + cock_fowl","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: wind + cock_fowl","exampleIds":[],"headword":"enifkeklen","id":"shakespeare014.lex.weathercock_roof","ipa":"","label":"weathercock_roof","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"enifkeklen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The bird-shaped vane above the steeple which Lear dares the storm to submerge.","id":"shakespeare014.lex.weathercock_roof.sense","status":"draft"}],"status":"draft","variants":[]},"b8f58df407180bcf73528257f60f1c9ac3b0271b122127b300e898d38de19dc9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: strong + fasten","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: strong + fasten","exampleIds":[],"headword":"jw\u00ebnenplestenkl\u00e1rjem\u00e3","id":"shakespeare014.lex.wedge_fast","ipa":"","label":"wedge_fast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"jw\u00fcnenplestenkl\u00f4rjemoi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Jam or fasten tightly, the wit stuck in the blockhead. Native strong-fasten; not a geometric measurement or a specified tool.","id":"shakespeare014.lex.wedge_fast.sense","status":"draft"}],"status":"draft","variants":[]},"e4e12629ff244c632f37203ffd08bc96d6232844aee684e1c390cb8f79cf0f31":{"audioLinks":[],"citations":[{"locator":"Authored source-calendar label: Unta spoken ordinal plus day; not a native-calendar equivalence.","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored source-calendar label: Unta spoken ordinal plus day; not a native-calendar equivalence.","exampleIds":[],"headword":"b\u00c5rum\u2019t yel","id":"shakespeare014.lex.wednesday_source","ipa":"","label":"wednesday_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u0101rum\u2019t yel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Wednesday in the source English seven-day week, named with native Unta spoken ordinal four plus day under the already documented Sunday-first source-calendar convention. Not a claim about an attested Vayrshemon calendar or four Wednesdays.","id":"shakespeare014.lex.wednesday_source.sense","status":"draft"}],"status":"draft","variants":[]},"29f2f524737f204d21f8ff27cb6ae852dcd0e9b49bf5a07548e74ed76f8166bd":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from plant, refuse","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from plant, refuse","exampleIds":[],"headword":"verzetmatond","id":"shakespeare014.lex.weed_plant","ipa":"","label":"weed_plant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"verzetmatond","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A plant treated as unwanted in the flower/weed contrast; not a specific species.","id":"shakespeare014.lex.weed_plant.sense","status":"draft"}],"status":"draft","variants":[]},"9596e8cfee2fe57e34cb2843efc65bc713fac674622ac40a0e6de033e21409b5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fate + sister","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Authored native derivation or sense: fate + sister","exampleIds":[],"headword":"vinjorpalila","id":"shakespeare014.lex.weird_sisters_fate","ipa":"","label":"weird_sisters_fate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"vinjorpalila","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"A sister of fate. The witches use the name of themselves during their winding charm.","id":"shakespeare014.lex.weird_sisters_fate.sense","status":"draft"}],"status":"draft","variants":[]},"6f464c30b4b96a98f330ef011775bc4044cf1dd54b62372fdeba6e5a5d924564":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_welfare","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_welfare","exampleIds":[],"headword":"farlen","id":"shakespeare014.lex.welfare_condition","ipa":"","label":"welfare_condition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Caesar\u2019s state as his welfare or political position, threatened by plotting; not a modern welfare benefit or simply the geographic state.","id":"shakespeare014.lex.welfare_condition.sense","status":"draft"}],"status":"draft","variants":[]},"3ad127f8e9fdb9f0cfab1eefb4c94e3e441c8ecca4b75602a8553de8b5b5bd16":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from breath, strong","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from breath, strong","exampleIds":[],"headword":"eni\u00d1\u00d7jw\u00ebnenplesten","id":"shakespeare014.lex.well_breathed","ipa":"","label":"well_breathed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"enich\u0113jw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Having stamina/wind for the chase; lexicalized breathing strength rather than a claim of poetic eloquence.","id":"shakespeare014.lex.well_breathed.sense","status":"draft"}],"status":"draft","variants":[]},"07ed6a86a4900c5aed2a41ebc333f5a9de7e23b11abcb2bc1d0ea48347a8eb1c":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"mar\u00d1","id":"shakespeare014.lex.welsh_marches","ipa":"","label":"welsh_marches","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"march","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The border country where Warwick hears Edward and Richard are raising a fresh force.","id":"shakespeare014.lex.welsh_marches.sense","status":"draft"}],"status":"draft","variants":[]},"4ae796b7f3c836c79f7bbbe9f16d952dcbb85149ee7423a49b65af4cc52e7745":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"m\u00ebrenindia","id":"shakespeare014.lex.western_ind_place","ipa":"","label":"western_ind_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"m\u00fcrenindia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Western Ind in the poem\u2019s east-to-west sweep, commonly understood as the West Indies. Native west plus the permitted India/Ind name; no modern border or journey is asserted.","id":"shakespeare014.lex.western_ind_place.sense","status":"draft"}],"status":"draft","variants":[]},"78a097fd8063557e37aa91feee47fef5df1129db8c6cfa93c55f737be44831a9":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"westminster","id":"shakespeare014.lex.westminster_seat","ipa":"","label":"westminster_seat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"westminster","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Seat where Peto reports the king is staying.","id":"shakespeare014.lex.westminster_seat.sense","status":"draft"}],"status":"draft","variants":[]},"76ce21e12903c450524ac1ea41859d830381e2bf487b4eedb5e27aaaf1c84557":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"westmorland","id":"shakespeare014.lex.westmoreland_earl","ipa":"","label":"westmoreland_earl","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"westmorland","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Earl and royal councillor, first to relate the news from Wales.","id":"shakespeare014.lex.westmoreland_earl.sense","status":"draft"}],"status":"draft","variants":[]},"a6fdb03f761e3777e67a82736d78e0f3e5cc2054a0db8309057fd3d585a34142":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"westmorland","id":"shakespeare014.lex.westmorland_henry_ally","ipa":"","label":"westmorland_henry_ally","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"westmorland","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The earl who urges Henry to pull York from the throne and leaves when Henry agrees to disinherit the prince.","id":"shakespeare014.lex.westmorland_henry_ally.sense","status":"draft"}],"status":"draft","variants":[]},"8dd8e786e49f7379d9fc83321a8ba9149589905d392dd380ef28bf0674dd1afa":{"audioLinks":[],"citations":[{"locator":"Authored native compound: cut + sheep","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: cut + sheep","exampleIds":[],"headword":"dest\u00eb\u00c5sh\u00ebral","id":"shakespeare014.lex.wether_sheep","ipa":"","label":"wether_sheep","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dest\u00fc\u0101sh\u00fcral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Castrated male sheep, native cut + sheep as a lexicalized livestock category. Bell-wether here has a bell and leads sheep; retain Touchstone\u2019s deliberately incongruous bawdy personification, not a biologically corrected ram.","id":"shakespeare014.lex.wether_sheep.sense","status":"draft"}],"status":"draft","variants":[]},"ad0865f1b86b01ea3099a340b6147b07c2c41a614ac500f9597c2ea6be01afb4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: ship + shore + floor","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: ship + shore + floor","exampleIds":[],"headword":"meranmerthrenjo\u00d9shal","id":"shakespeare014.lex.wharf_landing","ipa":"","label":"wharf_landing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"meranmerthrenjongshal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A constructed waterside landing, the adjacent wharfs personified as sensing perfume. Native ship-shore-floor.","id":"shakespeare014.lex.wharf_landing.sense","status":"draft"}],"status":"draft","variants":[]},"fe9ea7709a448db2d88cf3b21760064f0d127ee34791c3d4fd845c7a4c969ffd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_whet","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_whet","exampleIds":[],"headword":"destnaa\u00d9","id":"shakespeare014.lex.whet","ipa":"","label":"whet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"destnaang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Sharpen an edge, here the boar\u2019s tusks in the threatening personification.","id":"shakespeare014.lex.whet.sense","status":"draft"}],"status":"draft","variants":[]},"21d51bd5ab9c2024fee2fea7cfa1baa227fcbc28e8ad0a70a8c14299345a5da6":{"audioLinks":[],"citations":[{"locator":"Authored native compound: whet + stone","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: whet + stone","exampleIds":[],"headword":"destnaa\u00d9kwesta","id":"shakespeare014.lex.whetstone_edge","ipa":"","label":"whetstone_edge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"destnaangkwesta","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A stone for sharpening an edge, extended to sharpening wit through the fool\u2019s apparent dullness. Native sharpen + stone; the same sharpening image is repeated deliberately.","id":"shakespeare014.lex.whetstone_edge.sense","status":"draft"}],"status":"draft","variants":[]},"88e4b89fcf337a175097542f1c45ca86402390aabbffa0974f6c953d3d37e1fe":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of complain","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of complain","exampleIds":[],"headword":"murlamgiktenv\u00d7en","id":"shakespeare014.lex.whine_complain","ipa":"","label":"whine_complain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murlamgiktenv\u0113en","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Complain in a plaintive tone, the reluctant schoolboy\u2019s action. Contextual extension of native voiced complaint.","id":"shakespeare014.lex.whine_complain.sense","status":"draft"}],"status":"draft","variants":[]},"f45d1713ee06ebd77f50168e99e09a04760f2e2f3aca06819e7471292ccf5c4a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: lament + sound","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: lament + sound","exampleIds":[],"headword":"n\u00d7nsemtondason","id":"shakespeare014.lex.whine_plead","ipa":"","label":"whine_plead","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"n\u0113nsemtondason","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Make a plaintive begging sound, in Antony\u2019s imagined humiliation of the envoy.","id":"shakespeare014.lex.whine_plead.sense","status":"draft"}],"status":"draft","variants":[]},"7f710933c9fe00b2a865f006c175790bcd08fbff1f49ff73f91764bcf46dba32":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: whip","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: whip","exampleIds":[],"headword":"vern","id":"shakespeare014.lex.whip_scourge","ipa":"","label":"whip_scourge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vern","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A scourge as an instrument of punishment, figuratively Hector as the formidable warrior of Rome\u2019s claimed Trojan stock; no change of the local ancestry claim.","id":"shakespeare014.lex.whip_scourge.sense","status":"draft"}],"status":"draft","variants":[]},"0759207f96d8a191e0cbce43757bfdd4f7703bccb98fe49c3779cff5c21832a0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: whip + mark","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: whip + mark","exampleIds":[],"headword":"vernden","id":"shakespeare014.lex.whip_weal","ipa":"","label":"whip_weal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vernden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A bodily mark of whipping, source stripes; not patterned clothing.","id":"shakespeare014.lex.whip_weal.sense","status":"draft"}],"status":"draft","variants":[]},"8a9b576a302c3c871b89a3f07bae2b3d134e2788fc657e0631a0915c4056a941":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: turn + game","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: turn + game","exampleIds":[],"headword":"elyi\u00d1faln","id":"shakespeare014.lex.whipping_gig_top","ipa":"","label":"whipping_gig_top","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elyichfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The child's top which Hercules incongruously whips.","id":"shakespeare014.lex.whipping_gig_top.sense","status":"draft"}],"status":"draft","variants":[]},"06daf9cb012da71a6b335a223954de563e71de80d177d1ad2a9e3dd2e7d0a9d7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_whirlwind","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_whirlwind","exampleIds":[],"headword":"enifelyi\u00d1","id":"shakespeare014.lex.whirlwind","ipa":"","label":"whirlwind","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"enifelyich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A turning wind, figuratively the sighs that strive to drive Tarquin away; no older narrative is imported.","id":"shakespeare014.lex.whirlwind.sense","status":"draft"}],"status":"draft","variants":[]},"1c7004ff3309e52fd2c714faf857d06ef520100bc4327b76cb3a3b46b0c0ac17":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: white + stag_deer","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: white + stag_deer","exampleIds":[],"headword":"ve\u00dbz\u00c5nvelnor","id":"shakespeare014.lex.white_hart_inn","ipa":"","label":"white_hart_inn","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"veshz\u0101nvelnor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The inn in Southwark where Cade says his followers will abandon him. Its sign is a white stag.","id":"shakespeare014.lex.white_hart_inn.sense","status":"draft"}],"status":"draft","variants":[]},"7554fc8ad0b7910db220f1f588460fd9f0740b64d5621029dc42b4d5bdb0ec6b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: white + friar","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Authored native derivation or sense: white + friar","exampleIds":[],"headword":"ve\u00dbprod\u00e1pe\u00dbempalil","id":"shakespeare014.lex.whitefriars_london_house","ipa":"","label":"whitefriars_london_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"veshprod\u00f4peshempalil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The London religious house to which Richard privately redirects Henry's bier after sending Anne away. The translated name retains the color and religious order.","id":"shakespeare014.lex.whitefriars_london_house.sense","status":"draft"}],"status":"draft","variants":[]},"52199a1bcc8af47967c341ba85359d86c423cc77590e2f805c78660fa28de2ea":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"waitol","id":"shakespeare014.lex.whitehall_palace","ipa":"","label":"whitehall_palace","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"waitol","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The royal palace's new name, distinguished from the familiar York Place.","id":"shakespeare014.lex.whitehall_palace.sense","status":"draft"}],"status":"draft","variants":[]},"32946cd3e8444588993a363f216350a35b009a2bfcef21f6757b7a989836797c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"witmor","id":"shakespeare014.lex.whitmore_sailor","ipa":"","label":"whitmore_sailor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"witmor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The sailor who takes Suffolk away and returns with his head and body.","id":"shakespeare014.lex.whitmore_sailor.sense","status":"draft"}],"status":"draft","variants":[]},"173fc1f51374095d2ac86dcc2b93eb9c23ecb20f30a59ccb1db0146b2a840165":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spirit + feast","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: spirit + feast","exampleIds":[],"headword":"swifl\u00dfny\u00e9\u00dbna","id":"shakespeare014.lex.whitsun_feast","ipa":"","label":"whitsun_feast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"swifl\u014dny\u00e9shna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The Pentecost feast in Quickly's phrase Wheeson week. Carries the religious reference through native vocabulary.","id":"shakespeare014.lex.whitsun_feast.sense","status":"draft"}],"status":"draft","variants":[]},"b36c2352ddbd7212be25b86fae290d950faaffbfc2604a6d0ff49f036094af9d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: healthy","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: healthy","exampleIds":[],"headword":"faren\u00d5\u00dfr","id":"shakespeare014.lex.wholesome_food","ipa":"","label":"wholesome_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"faren\u0167h\u014dr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Fit or healthful to eat, before the rulers\u2019 surplus spoils. The later wholesome-law sense is separately contextual.","id":"shakespeare014.lex.wholesome_food.sense","status":"draft"}],"status":"draft","variants":[]},"ca771d0cc0c1eb02f8abf335723ed95e0e517ef699faaeee53662be34a323bae":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: benefit","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: benefit","exampleIds":[],"headword":"farmin","id":"shakespeare014.lex.wholesome_law","ipa":"","label":"wholesome_law","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"farmin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Beneficial or salutary when applied to a law, not literally safe to eat.","id":"shakespeare014.lex.wholesome_law.sense","status":"draft"}],"status":"draft","variants":[]},"7109ec1e64cd38042a6b16f2d79f5942f32c2d5577d5d5b5c8b8b7fa76707073":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: benefit","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: benefit","exampleIds":[],"headword":"farmin","id":"shakespeare014.lex.wholesome_manner","ipa":"","label":"wholesome_manner","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"farmin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A salutary, agreeable way of addressing the people, Menenius\u2019s advice; neither food safety nor a medical treatment.","id":"shakespeare014.lex.wholesome_manner.sense","status":"draft"}],"status":"draft","variants":[]},"9ab6bee12f41708dafa036a59bdf73153223bb16e71a78ef183fb130b34941c3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: candle + end","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: candle + end","exampleIds":[],"headword":"melsakorb\u00d7\u00c7rh\u00eb\u00d5","id":"shakespeare014.lex.wick_end","ipa":"","label":"wick_end","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melsakorb\u0113\u00e3rh\u00fc\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The little smoldering end of a light, here the dungeon\u2019s poor substitute for the sun.","id":"shakespeare014.lex.wick_end.sense","status":"draft"}],"status":"draft","variants":[]},"a35debd2f55a96151e16ac0d301c4e14679814e059a6889aef8e1c854aeb9c9a":{"audioLinks":[],"citations":[{"locator":"Authored native compound: neck + water + bird","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: neck + water + bird","exampleIds":[],"headword":"harenkl\u00e1ryems\u00d7wil","id":"shakespeare014.lex.wild_goose_native","ipa":"","label":"wild_goose_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harenkl\u00f4ryems\u0113wil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The wild goose in Jaques\u2019s unclaimed-criticism comparison. Native neck + water + bird is a lexicalized category, not a diagnosis of a modern species or every waterbird; avoids unsupported source-like gansil.","id":"shakespeare014.lex.wild_goose_native.sense","status":"draft"}],"status":"draft","variants":[]},"af405064f4e8785778edc5fc9b70310cf1f949866b9c325b18cad09ead30ca0d":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: wild + rose_flower","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: wild + rose_flower","exampleIds":[],"headword":"var\u00eblpol","id":"shakespeare014.lex.wild_rose","ipa":"","label":"wild_rose","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u00fclpol","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The canker bloom or dog rose contrasted with the fragrant cultivated rose in Sonnet 54; distinct from the rose-damaging worm called canker in Sonnet 35.","id":"shakespeare014.lex.wild_rose.sense","status":"draft"}],"status":"draft","variants":[]},"301433e2432a8573018cfd618200240520dcb7801c5e90ee166f1bdaf2d2180d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_wilderness","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_wilderness","exampleIds":[],"headword":"var\u00ebljo\u00d9","id":"shakespeare014.lex.wilderness","ipa":"","label":"wilderness","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u00fcljong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Unmanaged wild land, figuratively beyond law; does not specifically assert a sand desert.","id":"shakespeare014.lex.wilderness.sense","status":"draft"}],"status":"draft","variants":[]},"8534604d700b5150db62425eb336440c8560f8c02ac6dc8836584273ff0cf4da":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: wild + fire","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: wild + fire","exampleIds":[],"headword":"var\u00eblzarun","id":"shakespeare014.lex.wildfire","ipa":"","label":"wildfire","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u00fclzarun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Fiercely spreading fire in the comparison to Sinon\u2019s destructive words; the source does not specify an incendiary recipe.","id":"shakespeare014.lex.wildfire.sense","status":"draft"}],"status":"draft","variants":[]},"97282342e5ef9b6fe4f7c2a045039bcd9edde0003cfe492f719044d0ad941c58":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"wil","id":"shakespeare014.lex.will_apprentice","ipa":"","label":"will_apprentice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The companion to whom Peter bequeaths his hammer.","id":"shakespeare014.lex.will_apprentice.sense","status":"draft"}],"status":"draft","variants":[]},"e574a81312be9b8af05c64af0d4f7337e737fc61982d4d42ada7f11b3b35e9e2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: death + bequest","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: death + bequest","exampleIds":[],"headword":"n\u00d7nenh\u00ebthn\u00d7nf\u00c5w","id":"shakespeare014.lex.will_bequest","ipa":"","label":"will_bequest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u0113nenh\u00fcthn\u0113nf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A declaration assigning possessions after death, Caesar\u2019s publicly read will. Death-bequest distinguishes it from desire, command or the covenant sense of testament.","id":"shakespeare014.lex.will_bequest.sense","status":"draft"}],"status":"draft","variants":[]},"a34256bee3f63507a9dfd09c9a9cd02c800eafe59084db72f982f47a4699eb63":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of will","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of will","exampleIds":[],"headword":"\u00c9lm","id":"shakespeare014.lex.will_desire","ipa":"","label":"will_desire","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Volition, appetite and sexual desire in the repeated will wordplay of Sonnets 135\u2013136. Uses the native desire root. Bodily sexual metonymy is licensed by this context, not forced into every occurrence; the sound pun with the personal name Will cannot be reproduced exactly.","id":"shakespeare014.lex.will_desire.sense","status":"draft"}],"status":"draft","variants":[]},"3977a758d7d2523e3146e6f9ddb9baaf9dbe640e0baf289431a8265668f26d73":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"wil","id":"shakespeare014.lex.will_drawer","ipa":"","label":"will_drawer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The tavern servant who brings advance word of the prince's disguise.","id":"shakespeare014.lex.will_drawer.sense","status":"draft"}],"status":"draft","variants":[]},"4b7fb99571e0ada6886f35c9f90a3f7af58c2ef736bbd2a9d0b237f6fa9975dc":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation. The source pun and its sound loss are documented in the verse review.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation. The source pun and its sound loss are documented in the verse review.","exampleIds":[],"headword":"wil","id":"shakespeare014.lex.will_source","ipa":"","label":"will_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Will, the personal name explicitly identified by the speaker in Sonnet 136. The native word for desire is different; this adaptation preserves the name without 