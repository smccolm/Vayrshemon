b55410598968c3ad8ce5768e6e4fedc2407cc2134b04c9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: belt + join","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: belt + join","exampleIds":[],"headword":"thir\u00ebnkl\u00e1r","id":"shakespeare014.lex.belt_clasp","ipa":"","label":"belt_clasp","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thir\u00fcnkl\u00f4r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A clasp joining or fastening a bodily strap, the buckles on Antony\u2019s breast. Distinct from a buckler shield; no particular metal or mechanism is imposed.","id":"shakespeare014.lex.belt_clasp.sense","status":"draft"}],"status":"draft","variants":[]},"f82a250cbd442988eea75cd7702251e2cd0750dc708f5a1614fcc5230b165c9b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: form + seat","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: form + seat","exampleIds":[],"headword":"l\u00dfnsilen","id":"shakespeare014.lex.bench_form_costard","ipa":"","label":"bench_form_costard","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"l\u014dnsilen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Costard hears a seat in the legal word form. The native compound echoes the same word for form in his formula.","id":"shakespeare014.lex.bench_form_costard.sense","status":"draft"}],"status":"draft","variants":[]},"4c36aca38acdc8d3d7972300818cf058fa2b2bcaec8e07bd4dc7556c33c4f03f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: seat + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: seat + person","exampleIds":[],"headword":"silens\u00dflum","id":"shakespeare014.lex.bencher_council","ipa":"","label":"bencher_council","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"silens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A seated member of the civic council, source necessary bencher in the Capitol; not a mere furniture user or a modern legal professional.","id":"shakespeare014.lex.bencher_council.sense","status":"draft"}],"status":"draft","variants":[]},"a2555af7d300d11eb579271fc4bc15fb0e5ca747bebae6c9d09dfaec5df1e1bc":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: blessed","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: blessed","exampleIds":[],"headword":"prodf\u00c5w","id":"shakespeare014.lex.benedick_paduan_soldier","ipa":"","label":"benedick_paduan_soldier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prodf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Pedro's Paduan soldier. His name is rendered with the native root for blessed so the sound of the blessed thistle in Margaret's teasing prescription recalls his name throughout the play.","id":"shakespeare014.lex.benedick_paduan_soldier.sense","status":"draft"}],"status":"draft","variants":[]},"49bd6224dcf4230d8f527cd8991902661974f455c4a6c11f4db7a87efe5efa24":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: blessed","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: blessed","exampleIds":[],"headword":"prodf\u00c5w","id":"shakespeare014.lex.benedictus_herb_epithet","ipa":"","label":"benedictus_herb_epithet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"prodf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The blessed in blessed thistle. The same native root names Benedick. Beatrice isolates this epithet three times, sensing that Margaret is teasing her.","id":"shakespeare014.lex.benedictus_herb_epithet.sense","status":"draft"}],"status":"draft","variants":[]},"1c09b3dfe5761bef3653f5f7eda3dd0e71b836a8c0e6fa571ae125a4dc787145":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"benet","id":"shakespeare014.lex.bennet_bell_saint","ipa":"","label":"bennet_bell_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"benet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Saint whose bells Feste evokes when counting coins.","id":"shakespeare014.lex.bennet_bell_saint.sense","status":"draft"}],"status":"draft","variants":[]},"b30286f60a7544624d1d4f245baa26e33edf40a5e79ce4f5e53555d9d0f96728":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"benet","id":"shakespeare014.lex.bennet_seely_given","ipa":"","label":"bennet_seely_given","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"benet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"Given name of Sir Bennet Seely.","id":"shakespeare014.lex.bennet_seely_given.sense","status":"draft"}],"status":"draft","variants":[]},"c0d9b055e0ff38cb1b419ebb78e4e1fc00db6e15f0302062eb0ab72c0e4cf51c":{