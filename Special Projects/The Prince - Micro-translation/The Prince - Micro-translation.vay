adword":"venka","id":"shakespeare014.lex.circumstance","ipa":"","label":"circumstance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venka","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The surrounding conditions constraining action, not merely a stipulated future condition.","id":"shakespeare014.lex.circumstance.sense","status":"draft"}],"status":"draft","variants":[]},"d11b5be0a18c813a0dec602a5dd360526f2b09a8d1022798b62f2ca19dc0ba8c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_cistern","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_cistern","exampleIds":[],"headword":"yems\u00d7m\u00c5rumjo\u00d9dul","id":"shakespeare014.lex.cistern","ipa":"","label":"cistern","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113m\u0101rumjongdul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A vessel or reservoir receiving water; the coral receptacles in the ivory-conduit metaphor.","id":"shakespeare014.lex.cistern.sense","status":"draft"}],"status":"draft","variants":[]},"d3867a7ff24e76e60e1f0814b2a660e13475d916da5d8ecbe414f0b0bfe827f2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_cistern","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_cistern","exampleIds":[],"headword":"yems\u00d7m\u00c5rumjo\u00d9dul","id":"shakespeare014.lex.cistern_reservoir","ipa":"","label":"cistern_reservoir","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113m\u0101rumjongdul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A reservoir or water-holding pit in Cleopatra\u2019s wish that half Egypt be flooded. Native water-store-pit, without importing a siege or drinking-water claim.","id":"shakespeare014.lex.cistern_reservoir.sense","status":"draft"}],"status":"draft","variants":[]},"cdd925ccd58be01c69798f13e28623bbbaf3a557d19c43887fd2a83e0fb94527":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: string + lute_plucked","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: string + lute_plucked","exampleIds":[],"headword":"thirilthirilvalem","id":"shakespeare014.lex.cittern_instrument","ipa":"","label":"cittern_instrument","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thirilthirilvalem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"A plucked stringed instrument whose carved head Boyet compares with the schoolmaster's face.","id":"shakespeare014.lex.cittern_instrument.sense","status":"draft"}],"status":"draft","variants":[]},"b55d7b3ff5a32bac79cc52cae18cb80b5593b2870c7c29de28942a1233c9e2ed":{"audioLinks":[],"citations":[{"locator":"Authored native compound: cat + odour","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: cat + odour","exampleIds":[],"headword":"miyalnel\u00ebr","id":"shakespeare014.lex.civet_perfume","ipa":"","label":"civet_perfume","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"miyalnel\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The animal-derived aromatic secretion used to scent courtiers\u2019 hands. Native cat + odour as a lexicalized substance name reflecting the source category. Not ordinary house-cat scent, and Touchstone\u2019s uncleanly flux characterization stays his judgment.","id":"shakespeare014.lex.civet_perfume.sense","status":"draft"}],"status":"draft","variants":[]},"d3a8301797b858ee678956f84b4861b531fc35a58055103b2e0f8ab454cedb76":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: free","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: free","exampleIds":[],"headword":"maser","id":"shakespeare014.lex.civic_liberty","ipa":"","label":"civic_liberty","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"maser","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A freedom or civic liberty the people are warned they may lose; native free as a noun. Distinct from personal licence and from a newly asserted modern constitutional guarantee.","id":"shakespeare014.lex.civic_liberty.sense","status":"draft"}],"status":"draft","variants":[]},"d2b3a3932b98aefcb40dfd60c841d36d019c020a3f702886b92e45f99eb77407":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: rule + officer","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: rule + officer","exampleIds":[],"headword":"var\u00dfnenmarvenens\u00dflum","id":"shakespeare014.lex.civic_magistrate","ipa":"","label":"civic_magistrate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnenmarvenens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A holder of civic governing authority, here the elected tribunes naming themselves the people\u2019s magistrates. Native rule-officer; not a modern specialist court judge or a new office different from their tribunate.","id":"shakespeare014.lex.civic_magistrate.sense","status":"draft"}],"status":"draft","variants":[]},"c7853c55f371f2b10154b2a835282167856b7c2c04dbc09fa4a06f453c14eaa5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: citizen + gown","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: citizen + gown","exampleIds":[],"headword":"z\u00e1lagurs\u00dflumvelvorgor","id":"shakespeare014.lex.civic_toga","ipa":"","label":"civic_toga","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurs\u014dlumvelvorgor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The Roman civic garment worn for the consular petition, source toge. Native citizen-gown names its institutional category without importing an ordinary foreign word or specifying an unattested cut.","id":"shakespeare014.lex.civic_toga.sense","status":"draft"}],"status":"draft","variants":[]},"342192e5584c7cbc81d992d234dc864e304b21dc25fc2db2c0165c6f63b2ac22":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: citizen + group","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: citizen + group","exampleIds":[],"headword":"z\u00e1lagurs\u00dflumgur","id":"shakespeare014.lex.civic_tribe","ipa":"","label":"civic_tribe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurs\u014dlumgur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A Roman civic grouping used to organize the citizens and their votes. Native citizen-group, not a newly asserted kinship lineage; the source supplies no number of tribes.","id":"shakespeare014.lex.civic_tribe.sense","status":"draft"}],"status":"draft","variants":[]},"37d71ce2489d4008903d544aa94401dae85cb961b66d993bc84976ce4057a30a":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"nerbven","id":"shakespeare014.lex.civic_vote","ipa":"","label":"civic_vote","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerbven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A civic voice of choice or approval, the people\u2019s suffrages. Native choose-voice formation; not a claim of modern universal suffrage.","id":"shakespeare014.lex.civic_vote.sense","status":"draft"}],"status":"draft","variants":[]},"9a436ec74b4d58ad3af4619d173dafee2f8749f185c3cbe36ee1bd220f0b6551":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: pledge + word","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: pledge + word","exampleIds":[],"headword":"jamakl\u00e1rjemton","id":"shakespeare014.lex.civil_covenant","ipa":"","label":"civil_covenant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jamakl\u00f4rjemton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"An agreement binding the parties to conditions, here drawn up with legal counsel after a handshake.","id":"shakespeare014.lex.civil_covenant.sense","status":"draft"}],"status":"draft","variants":[]},"3d7182524d086e0292aaee4be5ceef6095f7ebef1f7ba87fb5da8ead86bfbe21":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: own + country","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: own + country","exampleIds":[],"headword":"k\u00cfba\u00d1jo\u00d9","id":"shakespeare014.lex.civil_internal","ipa":"","label":"civil_internal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"k\u00cfbachjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Internal to the same polity, the civil swords in Italy; not politeness or a modern legal category.","id":"shakespeare014.lex.civil_internal.sense","status":"draft"}],"status":"draft","variants":[]},"ecbcd144032ade6a6b1b369bda76a01b8061f5f5ee1316b1eea79113001d9543":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from people, strife","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from people, strife","exampleIds":[],"headword":"s\u00dflumhefak","id":"shakespeare014.lex.civil_strife","ipa":"","label":"civil_strife","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"s\u014dlumhefak","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Conflict within one people or community, source civil homebred strife; not polite disagreement.","id":"shakespeare014.lex.civil_strife.sense","status":"draft"}],"status":"draft","variants":[]},"e371eb6bc6682e7a3e207cfe6d9a8e658c045fc46622480be0f221dde9fd2e27":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of courtesy","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of courtesy","exampleIds":[],"headword":"var\u00dfnkinf\u00c7l","id":"shakespeare014.lex.civility_manners","ipa":"","label":"civility_manners","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnkinf\u00e3l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Socially cultivated courtesy and good manners, contrasted with Orlando\u2019s desperate threats. No requirement of aristocratic birth or modern citizenship is asserted.","id":"shakespeare014.lex.civility_manners.sense","status":"draft"}],"status":"draft","variants":[]},"b96656506666eed728f1bd36f3c80052e332e241ecb6641f3055952332eb22a9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: knock + bowl","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: knock + bowl","exampleIds":[],"headword":"takkular","id":"shakespeare014.lex.clack_dish_alms","ipa":"","label":"clack_dish_alms","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"takkular","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The noisy alms dish into which Lucio says the duke put a ducat.","id":"shakespeare014.lex.clack_dish_alms.sense","status":"draft"}],"status":"draft","variants":[]},"9daa9d55ede7acbcc5f5d72e5b0e43db761ec164869b1a7ed269e3971991d352":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: crowd + cry","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: crowd + cry","exampleIds":[],"headword":"sulmargoren\u00d3\u00c5\u00e7","id":"shakespeare014.lex.clamour","ipa":"","label":"clamour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sulmargorenth\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A loud confused outcry, the overlapping daughter/wife laments.","id":"shakespeare014.lex.clamour.sense","status":"draft"}],"status":"draft","variants":[]},"95cda1b96a93f9df64482be39585a2af14a0aec6cf57c5094f04e4f7289e117d":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from hand, strike","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from hand, strike","exampleIds":[],"headword":"tremb\u00c5rsleb","id":"shakespeare014.lex.clap_cheek","ipa":"","label":"clap_cheek","notes":"","orthographyId":"t