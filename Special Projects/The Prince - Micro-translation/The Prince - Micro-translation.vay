r":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Critical personal reproach, source taxation in Celia\u2019s warning to the fool. It is not levying money or an Unta quantity.","id":"shakespeare014.lex.censure_rebuke.sense","status":"draft"}],"status":"draft","variants":[]},"6154eb09556697f3b6cfe7d0f13cec5bf21cd928bcdc1d4a66e48db6d146cf1e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: centaur","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: centaur","exampleIds":[],"headword":"thals\u00dflum","id":"shakespeare014.lex.centaur_inn_ephesus","ipa":"","label":"centaur_inn_ephesus","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"thals\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The sign of the inn at which the visitors have deposited the money. Distinguish Adriana's home, the Phoenix.","id":"shakespeare014.lex.centaur_inn_ephesus.sense","status":"draft"}],"status":"draft","variants":[]},"ee297e532232af1b16acae67ff1d941e5bbccd2b188c2736eff8f7250c048430":{"audioLinks":[],"citations":[{"locator":"Authored source military-unit label: Unta spoken hundred plus company","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored source military-unit label: Unta spoken hundred plus company","exampleIds":[],"headword":"\u00c9nimus b\u00c5rum r\u00c7n\u00d3vem","id":"shakespeare014.lex.century_military","ipa":"","label":"century_military","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u00e4nimus b\u0101rum r\u00e3nthvem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A Roman hundred-unit company, source century/centuries. Native Unta spoken one hundred plus company names the formation; nominal establishment is distinct from the actual surviving strength of any unit. No total number of these companies is stated.","id":"shakespeare014.lex.century_military.sense","status":"draft"}],"status":"draft","variants":[]},"a90c049ffc4b636e6e095b18ebac3a4d0a65705c7a2a9888e1ee1d3d49536045":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kerberus","id":"shakespeare014.lex.cerberus_hound","ipa":"","label":"cerberus_hound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kerberus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The infernal hound grandiosely called King Cerberus by Pistol.","id":"shakespeare014.lex.cerberus_hound.sense","status":"draft"}],"status":"draft","variants":[]},"af48c72a611595c11670ad11aff513047de457435db0374259a4741c2a0a316d":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: honour + cloth","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: honour + cloth","exampleIds":[],"headword":"arvlamfelen","id":"shakespeare014.lex.ceremonial_canopy","ipa":"","label":"ceremonial_canopy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arvlamfelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The overhead cloth borne in a ceremony of honour in Sonnet 125, native honour-cloth. Does not assume a particular royal procession or identify the poet as a historical participant.","id":"shakespeare014.lex.ceremonial_canopy.sense","status":"draft"}],"status":"draft","variants":[]},"3761981cbf5301664a65c14a265ace2de4199c6b3da96b42e57d7f6b