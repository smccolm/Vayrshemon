:"shakespeare014.lex.drama_native_christen_naming","ipa":"","label":"drama_native_christen_naming","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"yemyatprodna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The source Christian baptism/naming occasion in Orlando\u2019s answer about Rosalind\u2019s name. Reviewed native ritual-washing term; do not assign an unprinted age or mode of baptism, or reduce the occasion to merely painting or washing an object.","id":"shakespeare014.lex.drama_native_christen_naming.sense","status":"draft"}],"status":"draft","variants":[]},"e5b09a4e9b331c7f83e809f36be24a92fcbd7577d551c81b19ab0510d7a1411e":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. The place of worship. An assembled congregation has its own key.","sourceId":"shakespeare014.source.henry-vi-part-2.r2"}],"etymology":"Dramatic native reading. The place of worship. An assembled congregation has its own key.","exampleIds":[],"headword":"arvenz\u00e1l","id":"shakespeare014.lex.drama_native_church","ipa":"","label":"drama_native_church","notes":"","orthographyId":"thimfora-79","partOfSpeech":"root","pronunciation":"arvenz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r2"}],"definition":"building for the source culture's Christian worship","id":"shakespeare014.lex.drama_native_church.sense","status":"draft"}],"status":"draft","variants":[]},"520e75b3c7907b764b18faa8ea0c14ec5159602d5926d613c9f966d55c802e87":{"audioLinks":[],"citations":[{"locator":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Dramatic native reading. Preserve the native constituents in this dramatic sense.","exampleIds":[],"headword":"arvenz\u00e1ljo\u00d9","id":"shakespeare014.lex.drama_native_churchyard","ipa"