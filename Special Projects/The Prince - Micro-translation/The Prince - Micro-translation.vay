hakespeare014.source.henry-vi-part-3.r1"}],"definition":"The last recruiting ground assigned to Montague.","id":"shakespeare014.lex.leicestershire_county.sense","status":"draft"}],"status":"draft","variants":[]},"dcc6d9ad551cfe86d2eb4a6750b69c2184cd4b3b18f10fc59c620738a02abfb0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sour + yellow + fruit","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: sour + yellow + fruit","exampleIds":[],"headword":"m\u00ebrikfrenvenam","id":"shakespeare014.lex.lemon_citrus_fruit","ipa":"","label":"lemon_citrus_fruit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrikfrenvenam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The lemon that Berowne imagines in Hector's hand.","id":"shakespeare014.lex.lemon_citrus_fruit.sense","status":"draft"}],"status":"draft","variants":[]},"1904df105fb6170fbab30dcbd8b7a71d155744f15f2dea72b87a12fb928ec97f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"lena","id":"shakespeare014.lex.lena_popilius_surname","ipa":"","label":"lena_popilius_surname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lena","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The surname Cassius uses for Popilius as he approaches Caesar.","id":"shakespeare014.lex.lena_popilius_surname.sense","status":"draft"}],"status":"draft","variants":[]},"41b116a6ab1790f5f3b7d02aaa9156263dc1dc7f299fa8a968dab8b681bb78f0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of gain","sourceId":"shakespeare014.sourc