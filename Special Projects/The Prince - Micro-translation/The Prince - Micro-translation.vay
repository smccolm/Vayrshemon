"}],"definition":"Facial appearance, source favor, by which Duke Senior recognizes his daughter; not kindness.","id":"shakespeare014.lex.favoured_features.sense","status":"draft"}],"status":"draft","variants":[]},"b1b62b5ea5b50d40b2eee4d37870d340e554269dd69afcb7dd3cbff5b752f0c2":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: favour + child","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: favour + child","exampleIds":[],"headword":"m\u00ddnam\u00d7pel","id":"shakespeare014.lex.favoured_minion","ipa":"","label":"favoured_minion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u012bnam\u0113pel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A cherished favourite or dependent of personified Nature in Sonnet 126, native favour-child; does not assert biological descent.","id":"shakespeare014.lex.favoured_minion.sense","status":"draft"}],"status":"draft","variants":[]},"09fe7e45a2da24ccbd650b07afaed0c205592a7849e284eac36218fccbf7661a":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from deer, child","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from deer, child","exampleIds":[],"headword":"velnorpel","id":"shakespeare014.lex.fawn_deer","ipa":"","label":"fawn_deer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velnorpel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A young deer, the offspring the nursing doe hastens to feed; distinct from submissively courting favour.","id":"shakespeare014.lex.fawn_deer.sense","status":"draft"}],"status":"draft","variants":[]},"5d8652fb797e449e05d65cdf490a4dbb4e16ec931ab78c528511840b8961afad":{"audioLinks":[],"citations":[{"locator":"Au