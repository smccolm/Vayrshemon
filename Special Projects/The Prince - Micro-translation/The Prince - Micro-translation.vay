tor":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A constricted passage, in this case a water channel under an arch; not a straight line.","id":"shakespeare014.lex.narrow_passage.sense","status":"draft"}],"status":"draft","variants":[]},"dbc87f9180340d70533fd346ff7c34bcdee7b816c9ed379a6d08ed9d36decc42":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"naso","id":"shakespeare014.lex.naso_ovid_cognomen","ipa":"","label":"naso_ovid_cognomen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"naso","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Ovid's cognomen, which Holofernes connects with smelling out poetic flowers.","id":"shakespeare014.lex.naso_ovid_cognomen.sense","status":"draft"}],"status":"draft","variants":[]},"d6308230f7499e702467320835410d33f3bf66df8d8de2d2a7a169d94aaff29d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"na\u00d5aniel","id":"shakespeare014.lex.nathaniel_curate","ipa":"","label":"nathaniel_curate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"na\u0167haniel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The curate at the hunt and later in the Worthies' entertainment.","id":"shakespeare014.lex.nathaniel_curate.sense","status":"draft"}],"status":"draft","variants":[]},"365f74cf670af10561c67eaa3709c3e91718b4db51528b16258c9433a610fd32":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"na\u00d5aniel","id":"shakespeare014.lex.nathaniel_petruchio_servant","ipa":"","label":"nathaniel_petruchio_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"na\u0167haniel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Servant called to greet Grumio and the wedding couple.","id":"shakespeare014.lex.nathaniel_petruchio_servant.sense","status":"draft"}],"status":"draft","variants":[]},"21d2a3be6339d6650b222b7727612c957790814b485f59a76946110d3ebb0073":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: save + person","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: save + person","exampleIds":[],"headword":"man\u00d7njems\u00dflum","id":"shakespeare014.lex.nativity_saviour","ipa":"","label":"nativity_saviour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"man\u0113njems\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The Christian title for the one whose birth the sentinels say is celebrated. The ancient saving-person formation is reused for this named festival context.","id":"shakespeare014.lex.nativity_saviour.sense","status":"draft"}],"status":"draft","variants":[]},"c4ff5b7d5d7160714dbb703ebc46476a6017974458339b6836031b1be9783af8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_elements_cosmos_peter","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_elements_cosmos_peter","exampleIds":[],"headword":"jo\u00d9olthrenin","id":"shakespeare014.lex.natural_element","ipa":"","label":"natural_element","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongolthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Constituents or life-forces in Antony\u2019s natural-philosophy joke about an animal\u2019s life. Native world-part does not decide between a material or vital-force reading, assert a modern chemical element, or import an apocalypse.","id":"shakespeare014.lex.natural_element.sense","status":"draft"}],"status":"draft","variants":[]},"21b6bb4447a5f13e1b353223e0ae909b2f1185e0599a6802f154359244518438":{"audioLinks":[],"citations":[{"locator":"Authored native compound: nature + fool","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: nature + fool","exampleIds":[],"headword":"jo\u00d9\u00d5\u00dfrenlof","id":"shakespeare014.lex.natural_fool","ipa":"","label":"natural_fool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jong\u0167h\u014drenlof","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The dialogue\u2019s teasing designation of a fool by nature, contrasted with cultivated wit and the professional entertainer. Native nature + fool retains the recurrent Nature family; no narrator diagnosis of Touchstone is asserted.","id":"shakespeare014.lex.natural_fool.sense","status":"draft"}],"status":"draft","variants":[]},"21c4472d7b59ef60914dbbe35509682693531ef0320c4d09d4358d2e461b3cf7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of nature","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of nature","exampleIds":[],"headword":"jo\u00d9\u00d5\u00dfren","id":"shakespeare014.lex.nature_personified","ipa":"","label":"nature_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"jong\u0167h\u014dren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Nature personified as a female maker in Venus\u2019s speech; same native nature form, distinct rhetorical identity.","id":"shakespeare014.lex.nature_personified.sense","status":"draft"}],"status":"draft","variants":[]},"e17d0bf6444e0ed22bf9611d14c04a15966dc643f1ef774849d0b0d39439cf3f":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from land, spirit","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from land, spirit","exampleIds":[],"headword":"jo\u00d9swifl\u00dfn","id":"shakespeare014.lex.nature_spirit","ipa":"","label":"nature_spirit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongswifl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Nymph: a female nature spirit of the classical source. Native land-spirit compound with this specified mythic sense; not a phonetic loan from nymph.","id":"shakespeare014.lex.nature_spirit.sense","status":"draft"}],"status":"draft","variants":[]},"8bc4dc0a06169c70df25c07bcf6d87c8f2570d8616098a0165d31f2bafc98e5a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of nothing","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of nothing","exampleIds":[],"headword":"mav\u00d1et","id":"shakespeare014.lex.naught_dismissal","ipa":"","label":"naught_dismissal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mavchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The contemptuous be-naught dismissal in Oliver\u2019s make/mar exchange. Nothingness as insult, not numerical zero in a reckoning.","id":"shakespeare014.lex.naught_dismissal.sense","status":"draft"}],"status":"draft","variants":[]},"255ec412434e438a5b1cfa4d01f5e1c4ce5206e67d719c08e4945bac60daf959":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: ship + gather","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: ship + gather","exampleIds":[],"headword":"meranz\u00dfgu\u00d9","id":"shakespeare014.lex.naval_fleet","ipa":"","label":"naval_fleet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"meranz\u014dgung","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A gathered force of ships, here Pompey\u2019s war fleet. Native ship-gather, no ship count supplied.","id":"shakespeare014.lex.naval_fleet.sense","status":"draft"}],"status":"draft","variants":[]},"64d2f9388520459fc6140f761b3f63d80958875198b7d40d06ec3153ae7ba0e8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: study + house","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: study + house","exampleIds":[],"headword":"\u00c3\u00eb\u00d5\u00ebr\u00ebz\u00e1l","id":"shakespeare014.lex.navarre_academe","ipa":"","label":"navarre_academe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jzh\u00fc\u0167h\u00fcr\u00fcz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The little house of study Ferdinand intends his court to become.","id":"shakespeare014.lex.navarre_academe.sense","status":"draft"}],"status":"draft","variants":[]},"e4a329d6eca355411876dd2a487a741ddeb8a8b2493c815d1c296023541f60fb":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-