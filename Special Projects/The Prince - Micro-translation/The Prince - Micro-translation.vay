"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Supply someone with drink, the repeated imperative in the song. Native cup made verbal; the repetition is intentional and must stay identical.","id":"shakespeare014.lex.cup_serve.sense","status":"draft"}],"status":"draft","variants":[]},"f380d556b86cac31f66585e5aa69bded8177ae9a811d6b2f4e74efe3cbcca6f0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: store","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: store","exampleIds":[],"headword":"m\u00c5rum","id":"shakespeare014.lex.cupboard_store","ipa":"","label":"cupboard_store","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"m\u0101rum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Put away food in storage, the accusation against the fable\u2019s belly; not a new architectural room.","id":"shakespeare014.lex.cupboard_store.sense","status":"draft"}],"status":"draft","variants":[]},"c97ec0b0dfc1684badef9470bee91b00ad1fcae3f56b1ae6e0e172dc3d7be62b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kuran","id":"shakespeare014.lex.curan_household","ipa":"","label":"curan_household","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kuran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The member of Gloucester's household who tells Edmund of the duke's coming and of a whispered dispute between the two dukes.","id":"shakespeare014.lex.curan_household.sense","status":"draft"}],"status":"draft","variants":[]},"e5a5156a4e855d3a2bf69201d54c