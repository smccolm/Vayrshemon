ocator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Orodes, addressed as the father of the slain Pacorus. A permitted personal name; the source relationship remains without invented dates or family members.","id":"shakespeare014.lex.orodes_king.sense","status":"draft"}],"status":"draft","variants":[]},"d51d4edb8b1923098d0f97198589cd5e8c1274e41701f223ed96d756a37af2a2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_orphan","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_orphan","exampleIds":[],"headword":"pelpelb\u00e9rven","id":"shakespeare014.lex.orphan","ipa":"","label":"orphan","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pelpelb\u00e9rven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A bereaved child in the contrast with a feeding oppressor; no unprinted number of deceased parents is supplied.","id":"shakespeare014.lex.orphan.sense","status":"draft"}],"status":"draft","variants":[]},"34184a253cbd84536f5d2a36fca435b03ebfc8a60d940f4a682de9595d2bc6b1":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"orfeus","id":"shakespeare014.lex.orpheus","ipa":"","label":"orpheus","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"orfeus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The mythic musician whose playing moves Pluto; retains identity without adding an unprinted episode.","id":"shakespeare014.lex.orpheus.sense","status":"draft"}],"status":"draft","variants":[]},"3fa8bcf1ae014d1938707a55278a1ac3a5c7b71fdcf61c9a6179913d17bb9080":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"orsino","id":"shakespeare014.lex.orsino_illyrian_duke","ipa":"","label":"orsino_illyrian_duke","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"orsino","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Ruler of Illyria, addressed by the source as duke and count.","id":"shakespeare014.lex.orsino_illyrian_duke.sense","status":"draft"}],"status":"draft","variants":[]},"43e16d10c881a152b5153234bc09d39de748d37442d61ce57bb95f977dec2760":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: exact + writing","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: exact + writing","exampleIds":[],"headword":"jem\u00ddv","id":"shakespeare014.lex.orthography_precise_spelling","ipa":"","label":"orthography_precise_spelling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jem\u012bv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Correct spelling personified, Benedick's caricature of Claudio's newly elaborate speech.","id":"shakespeare014.lex.orthography_precise_spelling.sense","status":"draft"}],"status":"draft","variants":[]},"83d18b91f4f2f63aa15eb93570399e59a1c89083f68af1e3515f40aad2d17338":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_willow","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_willow","exampleIds":[],"headword":"y\u00eblr\u00d7n","id":"shakespeare014.lex.osier_willow","ipa":"","label":"osier_willow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclr\u0113n","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The willow trees beside the stream, source osiers. Reviewed native willow category; no exact modern botanical species is assigned, and the rank is a row, not social status.","id":"shakespeare014.lex.osier_willow.sense","status":"draft"}],"status":"draft","variants":[]},"05d06334a3cd93eda267eba8bec1ccc4427cbe611ee6dabae74c8b011616f7b5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: fish_creature + hawk","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fish_creature + hawk","exampleIds":[],"headword":"drig\u00e1lv\u00ddlawor","id":"shakespeare014.lex.osprey_hawk","ipa":"","label":"osprey_hawk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"drig\u00f4lv\u012blawor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The fish-taking hawk in Aufidius\u2019s image of natural dominance. Native fish-hawk; preserves the source animal category and its attributed sovereignty without claiming the literary fascination belief as zoological fact.","id":"shakespeare014.lex.osprey_hawk.sense","status":"draft"}],"status":"draft","variants":[]},"3fed6b611ad8046de108b42dcc12dfe205bec84cb2f17ceda520aa1df7102e54":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"osrik","id":"shakespeare014.lex.osric_courtier","ipa":"","label":"osric_courtier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"osrik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The courtier who describes the wager and later adjudicates hits in the fencing match.","id":"shakespeare014.lex.osric_courtier.sense","status":"draft"}],"status":"draft","variants":[]},"3e25c2c4f0866d8d884e7e223c860367bca31325d1999f08243bcb14f2d83802":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"osa","id":"shakespeare014.lex.ossa_peak","ipa":"","label":"ossa_peak","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"osa","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The mountain Hamlet compares to a wart beside his proposed heap of earth.","id":"shakespeare014.lex.ossa_peak.sense","status":"draft"}],"status":"draft","variants":[]},"719324ab4dadb181d18864952a70cf17aecbbebce511065f0fad9fb527142bfc":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"oswald","id":"shakespeare014.lex.oswald_goneril_steward","ipa":"","label":"oswald_goneril_steward","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"oswald","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Goneril's steward. She tells him to provoke a quarrel with Lear by giving him poor service.","id":"shakespeare014.lex.oswald_goneril_steward.sense","status":"draft"}],"status":"draft","variants":[]},"96a55ce5f92d869d08540591d584b43ec0ee733e0494934f56f87ffb537ba241":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"otelo","id":"shakespeare014.lex.othello_venetian_general","ipa":"","label":"othello_venetian_general","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"otelo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"Venice's general and Desdemona's husband.","id":"shakespeare014.lex.othello_venetian_general.sense","status":"draft"}],"status":"draft","variants":[]},"868de468e1d732ec6e014047f25349a0aa8b97d8423fdf5c276cc29adcdccb1d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: water + beast","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: water + beast","exampleIds":[],"headword":"yems\u00d7\u00d5\u00dfrvor","id":"shakespeare014.lex.otter_animal","ipa":"","label":"otter_animal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113\u0167h\u014drvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The water animal Falstaff claims to be neither fish nor flesh.","id":"shakespeare014.lex.otter_animal.sense","status":"draft"}],"status":"draft","variants":[]},"db08a45168defd54f31833de4ab7dfe61462ec1eb046690125e5776067acc0a0":{"audioLinks":[],"citations":[{"locator":"Localized historical dynasty name used in the fleet reports.","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Localized historical dynasty name used in the fleet reports.","exampleIds":[],"headword":"otoman","id":"shakespeare014.lex.ottoman_dynastic_name","ipa":"","label":"ottoman_dynastic_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"otoman","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The dynastic name in the messenger's designation of the Ottomites and later references to the fleet.","id":"shakespeare014.lex.ottoman_dynastic_name.sense","status":"draft"}],"status":"draft","variants":[]},"f71d8db263f4e280dbd18cd09d547d1854f0b1de1227c5a20da26115f956bac9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: ottoman_dynastic_name + person","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: ottoman_dynastic_name + person","exampleIds":[],"headword":"otomans\u00dflum","id":"shakespeare014.lex.ottomite_dynastic_demonym","ipa":"","label":"ottomite_dynastic_demonym","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"otomans\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"A member of the Ottoman force named by the messenger, without declaring an individual's ancestry.","id":"shakespeare014.lex.ottomite_dynastic_demonym.sense","status":"draft"}],"status":"draft","variants":[]},"1acb3edbf7e4e209afc9079cf3c5d694690b0de1c70c7f55fa739980fa9e9340":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: small + weight + measure","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: small + weight + measure","exampleIds":[],"headword":"viminmemvormem","id":"shakespeare014.lex.ounce_weight","ipa":"","label":"ounce_weight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminmemvormem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The source ounce as a small historical weight unit in many an ounce of blood. A native measure-category label, not the feline ounce, a fluid-volume claim, or an assumed conversion between Roman, troy and avoirdupois standards. No exact number of ounces is supplied.","id":"shakespeare014.lex.ounce_weight.sense","status":"draft"}],"status":"draft","variants":[]},"0490a3abc86853f6620eb49e5ccb76c0a02efa849bcea2528825f541e3bf532e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: reckon + cheat","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: reckon + cheat","exampleIds":[],"headword":"tarentrat\u00e9k","id":"shakespeare014.lex.outcount_cheat","ipa":"","label":"outcount_cheat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tarentrat\u00e9k","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Cheat someone out of property by reckoning, Pompey\u2019s retort about his father\u2019s house. The shared native reckon component echoes outcount_force without asserting more houses than the source supplies.","id":"shakespeare014.lex.outcount_cheat.sense","status":"draft"}],"status":"draft","variants":[]},"16c0a838a4e352d9f0c0687f37bf55c36a292247f88597bc7447031ed6d2cb0d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: reckon + exceed","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: reckon + exceed","exampleIds":[],"headword":"tarenna\u00c3\u00cd","id":"shakespeare014.lex.outcount_force","ipa":"","label":"outcount_force","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tarennajzh\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Exceed in the number of forces, Antony\u2019s threat about land strength. No unstated ratio is supplied. Related reckoning imagery is preserved in Pompey\u2019s counting-cheat reply.","id":"shakespeare014.lex.outcount_force.sense","status":"draft"}],"status":"draft","variants":[]},"a0d789ac966842f5b5f3c6c03f31ca86a17fbeb5a2508d56faff2b4a2d10545e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of outside","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of outside","exampleIds":[],"headword":"thani","id":"shakespeare014.lex.outer_surface","ipa":"","label":"outer_surface","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"thani","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"On the exterior, the bodily walls painted bright in Sonnet 146; not a change to the underlying body metaphor.","id":"shakespeare014.lex.outer_surface.sense","status":"draft"}],"status":"draft","variants":[]},"a9a03ce1bd7626033943ceea4140afb1cfa4c47088002765e8993c145912f631":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: outside + law + man","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Authored native derivation or sense: outside + law + man","exampleIds":[],"headword":"thanilamthr\u00ebns\u00dflum","id":"shakespeare014.lex.outlaw_forest_band","ipa":"","label":"outlaw_forest_band","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thanilamthr\u00fcns\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"definition":"A member of the exiled band that intercepts Valentine and Speed. The three numbered speakers retain their individual ordinals.","id":"shakespeare014.lex.outlaw_forest_band.sense","status":"draft"}],"status":"draft","variants":[]},"fe50cb7d799b4cacefa935fce935d9103330a4a4d7f9c213b030a17b418e2a08":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: triumph + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: triumph + person","exampleIds":[],"headword":"ziftarvb\u00e7ors\u00dflum","id":"shakespeare014.lex.ovator_honouree","ipa":"","label":"ovator_honouree","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ziftarvb\u016bors\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A recipient of a Roman ovation or victory honour, the source ovator reading. Native triumph-person; no phonetic Latin loan or invented full triumph ceremony. The source\u2019s satirical proposal must not become a sincere appointment.","id":"shakespeare014.lex.ovator_honouree.sense","status":"draft"}],"status":"draft","variants":[]},"5d56324ec57cb276989de17acc5fa2f77c8be41142547d4066f848bf36b4e7b5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_oven","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_oven","exampleIds":[],"headword":"zarunz\u00e1l","id":"shakespeare014.lex.oven","ipa":"","label":"oven","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarunz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An enclosed space heated for baking; metaphor for constrained desire.","id":"shakespeare014.lex.oven.sense","status":"draft"}],"status":"draft","variants":[]},"d51514a18f7936916c8fba57aeaa3f6f8578ff39c6f9852c9656924a2658500a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: excess + do","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: excess + do","exampleIds":[],"headword":"gimerenf\u00d7","id":"shakespeare014.lex.overdone_brothel_keeper","ipa":"","label":"overdone_brothel_keeper","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gimerenf\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The bawd's speaking name, formed with native excess and do.","id":"shakespeare014.lex.overdone_brothel_keeper.sense","status":"draft"}],"status":"draft","variants":[]},"d1f85c8018949c8c9ef9408cf767f99b0c84cdd0f4f89f02a45f72511f27adf4":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: testament + manage","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: testament + manage","exampleIds":[],"headword":"palf\u00c5w\u00ddvk\u00c7fag\u00eba","id":"shakespeare014.lex.oversee_legal","ipa":"","label":"oversee_legal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"palf\u0101w\u012bvk\u00e3fag\u00fca","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Administer or supervise the fulfilment of a testament; distinct from being deceived in the source\u2019s oversee/overseen pun.","id":"shakespeare014.lex.oversee_legal.sense","status":"draft"}],"status":"draft","variants":[]},"71f823a63fd0e236b1bfc6c959a5c7d288c45d9156341f5cc3a899bee0deb6f3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: change + form","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Authored native derivation or sense: change + form","exampleIds":[],"headword":"\u00e3luml\u00dfn","id":"shakespeare014.lex.ovid_changes_title","ipa":"","label":"ovid_changes_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"oiluml\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"Ovid\u2019s poem, named in the singular in the supplied play. Its native title describes changes of form.","id":"shakespeare014.lex.ovid_changes_title.sense","status":"draft"}],"status":"draft","variants":[]},"7f34e2a6aded89a8c1954a7ddedd395e407a1c8a322d2e8b453a19bd8b3ceefa":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"ovid","id":"shakespeare014.lex.ovid_poet","ipa":"","label":"ovid_poet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ovid","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The Roman poet named in Touchstone\u2019s exile comparison. Keep the supplied name and the character\u2019s claim about Goths rather than silently repairing it to Getae.","id":"shakespeare014.lex.ovid_poet.sense","status":"draft"}],"status":"draft","variants":[]},"0a6c2805a505ee90389daa224a25a992f477ae2984219495bbf01a6ef55ba78b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"owen","id":"shakespeare014.lex.owen_glendower","ipa":"","label":"owen_glendower","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"owen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Given name of Glendower when Henry denies Mortimer fought him.","id":"shakespeare014.lex.owen_glendower.sense","status":"draft"}],"status":"draft","variants":[]},"d2ba737ce38c7dee0b17757671aa34747f310f162bf79e2cf448d6e95e276950":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"oksford","id":"shakespeare014.lex.o