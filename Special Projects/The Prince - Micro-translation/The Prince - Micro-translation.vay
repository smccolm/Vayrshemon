ical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A face-wrapping garment removed when Coriolanus identifies himself. Reviewed native face-wrap; neither an engine device nor a gag.","id":"shakespeare014.lex.muffler_wrap.sense","status":"draft"}],"status":"draft","variants":[]},"385ae120386b6f5bdb1c438d11d3d47b5eb4c266cf9ca72c0ad22e99aa114c2c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"mugz","id":"shakespeare014.lex.mugs_carrier","ipa":"","label":"mugs_carrier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"mugz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Neighbor Mugs, addressed by the Second Carrier as they leave.","id":"shakespeare014.lex.mugs_carrier.sense","status":"draft"}],"status":"draft","variants":[]},"45862b723752c07934edf2533c48516321b4f768fa6c14a176bc7b051d48ba0f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: mule + drive","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: mule + drive","exampleIds":[],"headword":"thalasterasts\u00dflum","id":"shakespeare014.lex.mule_driver","ipa":"","label":"mule_driver","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalasterasts\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A person who drives mules, now hastily recruited for naval service. Native mule-drive-person, not a mounted cavalry soldier.","id":"shakespeare014.lex.mule_driver.sense","status":"draft"}],"status":"draft","variants":[]},"362b3b0a2e60432433ad47ebb6f0f311c09f5e67e35d82da11a55965f1fdb646":{"audio