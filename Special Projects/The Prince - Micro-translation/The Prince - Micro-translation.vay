:"shakespeare014.source.king-lear.r1"}],"definition":"The woman addressed by a familiar name in the Fool's snatch of song. She has no entrance or assigned speech.","id":"shakespeare014.lex.jug_song_nickname.sense","status":"draft"}],"status":"draft","variants":[]},"5088222b0e1bf74c468ee9a4b327284e328e79a4d9f44e3dfb323c74502dccfd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"jul","id":"shakespeare014.lex.jule_nurse_pet_name","ipa":"","label":"jule_nurse_pet_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"jul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The Nurse's familiar short name for Juliet.","id":"shakespeare014.lex.jule_nurse_pet_name.sense","status":"draft"}],"status":"draft","variants":[]},"f9285befcec0f7f2c9cd3c9be0d1173e43dfb8ffc0452a4cc835631dfb087234":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"yulia","id":"shakespeare014.lex.julia_verona_beloved","ipa":"","label":"julia_verona_beloved","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"yulia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"definition":"Proteus's beloved in Verona. She later travels dressed as the page Sebastian.","id":"shakespeare014.lex.julia_verona_beloved.sense","status":"draft"}],"status":"draft","variants":[]},"4ed812cf3a494e040bcc2511b410be3953c27b5d13445b3c80b6b13600a377e3":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonet