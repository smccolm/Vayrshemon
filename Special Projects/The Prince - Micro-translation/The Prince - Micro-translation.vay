","variants":[]},"63cb551a9fc8aa46f7592da385a965c797c9bf88124f4f7b54d592eaf1222803":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hari","id":"shakespeare014.lex.harry_coin_name","ipa":"","label":"harry_coin_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hari","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The royal name on the ten-shilling coins used as a measure of the bribe paid in French crowns. Not a new encounter with the Prince or Hotspur.","id":"shakespeare014.lex.harry_coin_name.sense","status":"draft"}],"status":"draft","variants":[]},"7bad3bfe8795321365345232dd465ece14f676fa404a3bddb3aa7a8387863b5e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hari","id":"shakespeare014.lex.harry_guilford_steward","ipa":"","label":"harry_guilford_steward","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hari","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The familiar form by which the chamberlain addresses Sir Henry Guilford.","id":"shakespeare014.lex.harry_guilford_steward.sense","status":"draft"}],"status":"draft","variants":[]},"f793eb321b2f30a35d2426e48d9d53c81862cf7b6d115a312af3d5bed4b58e1a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hari","id":"shakes