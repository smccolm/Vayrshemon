4.lex.nicholas_saint","ipa":"","label":"nicholas_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nikolas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The saint Gadshill invokes through thieves' cant, calling robbers his clerks.","id":"shakespeare014.lex.nicholas_saint.sense","status":"draft"}],"status":"draft","variants":[]},"6293dd1e923585af701a5e85299562b9e7c787ba07e98d52be69759070a3f7ea":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nikolas","id":"shakespeare014.lex.nicholas_vaux_escort","ipa":"","label":"nicholas_vaux_escort","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nikolas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The knight to whom Lovell hands over the duke at the water.","id":"shakespeare014.lex.nicholas_vaux_escort.sense","status":"draft"}],"status":"draft","variants":[]},"09ff659f50b2ee253cc2e575d98c85aebb53e89e335ea2a0236cb792210ce561":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of cut","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of cut","exampleIds":[],"headword":"dest\u00eb\u00c5","id":"shakespeare014.lex.nick_damage","ipa":"","label":"nick_damage","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Damage or cut into command competence in Enobarbus\u2019s itch-of-affection accusation. The precise force of nicked is uncertain; this retains the injury image without using Nick as a personal name or pretending a literal wound was made.","id":"shakespeare014.lex.nick_damage.sense","status":"draft"}],"status":"draft","variants":[]},"38b81eb2fe2bd7ef2f1f52243665cfebaa15268978a7f7ca2b15f7ceed11b86b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: brother + daughter","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: brother + daughter","exampleIds":[],"headword":"palilpelena","id":"shakespeare014.lex.niece_kin","ipa":"","label":"niece_kin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"palilpelena","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A brother\u2019s daughter, here Duke Senior\u2019s niece Celia; not his literal daughter or a claim that sister\u2019s daughters are excluded from the broader kinship category.","id":"shakespeare014.lex.niece_kin.sense","status":"draft"}],"status":"draft","variants":[]},"2b6b1c9db462428c19c6c24b4bc5472f2f09ce18d127f8d3d44a87d7d0d6d479":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of night","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of night","exampleIds":[],"headword":"\u00c5\u00d9gif","id":"shakespeare014.lex.night_personified","ipa":"","label":"night_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"\u0101nggif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Night personified as the black-clad mother of fear, imprisoning Day; native time word with proper Maxima.","id":"shakespeare014.lex.night_personified.sense","status":"draft"}],"status":"draft","variants":[]},"094ca7fa91af8c539d8a93a12482172fc4033cfbdbd2a515808547e893c03ce7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: night + work","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: night + work","exampleIds":[],"headword":"\u00c5\u00d9gifd\u00c7\u00d3","id":"shakespeare014.lex.nightwork_family","ipa":"","label":"nightwork_family","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"\u0101nggifd\u00e3th","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Shared family name of Jane, Robin and the older Nightwork. Keep family name and individual bearers distinct.","id":"shakespeare014.lex.nightwork_family.sense","status":"draft"}],"status":"draft","variants":[]},"4431491e0cca0aea45ecb5b0f10c40019729b4752b71d92a3e0a147361746314":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"nil","id":"shakespeare014.lex.nile_river","ipa":"","label":"nile_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The source Nile variant for the same river elsewhere called Nilus. Distinct display form, shared geographic referent; no invented tributary.","id":"shakespeare014.lex.nile_river.sense","status":"draft"}],"status":"draft","variants":[]},"a052506884ebb6031e62b32095ec13346e7df1b2b0b7b964ee2d212407d471a9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"nilus","id":"shakespeare014.lex.nilus_river","ipa":"","label":"nilus_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nilus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The Nile river named Nilus in the source\u2019s fertility/famine joke.","id":"shakespeare014.lex.nilus_river.sense","status":"draft"}],"status":"draft","variants":[]},"80cfb2fd7859ba860a1ac7711ddf1421e8b0d87b09090289a23323b5a9d5fe2d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"niobe","id":"shakespeare014.lex.niobe_mourner","ipa":"","label":"niobe_mourner","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"niobe","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The bereaved figure of Greek myth used by Hamlet to describe Gertrude weeping at the burial.","id":"shakespeare014.lex.niobe_mourner.sense","status":"draft"}],"status":"draft","variants":[]},"9b5a39c88b57d7b951bcab8d57650a163cf4c8d5b24ed1dad49d8af432008888":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nob","id":"shakespeare014.lex.nob_mock_knight","ipa":"","label":"nob_mock_knight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nob","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The mock knight's name in Philip's rejection of his brother's looks and estate.","id":"shakespeare014.lex.nob_mock_knight.sense","status":"draft"}],"status":"draft","variants":[]},"7fe26fa9b3c7e4a5669ad4e77e4808437a1d0a379658c5e423c0cdcd6c319fcb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: noble + gold","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: noble + gold","exampleIds":[],"headword":"arvenazar","id":"shakespeare014.lex.noble_gold_coin","ipa":"","label":"noble_gold_coin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arvenazar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The gold coin in Quickly's offer of twenty nobles. Distinct from social rank.","id":"shakespeare014.lex.noble_gold_coin.sense","status":"draft"}],"status":"draft","variants":[]},"4df1016e5543ea3dcd0ee7c317a42de5c01df443a3ff21be111ba0b317157ca4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of noble","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of noble","exampleIds":[],"headword":"arven","id":"shakespeare014.lex.noble_magnanimous","ipa":"","label":"noble_magnanimous","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"arven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Admirable in courage or magnanimity rather than only hereditary rank. The native rank word gains an explicitly recorded moral sense in Cleopatra\u2019s noblest-of-men lament and her proposed noble conduct; not a random substitute for good.","id":"shakespeare014.lex.noble_magnanimous.sense","status":"draft"}],"status":"draft","variants":[]},"a78422fe1e0dfb44627a562f9161f22f238ecf8d7f2ba5d6470e54c48854e097":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: noble_magnanimous + evroot","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: noble_magnanimous + evroot","exampleIds":[],"headword":"arvenef","id":"shakespeare014.lex.nobleness_magnanimity","ipa":"","label":"nobleness_magnanimity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arvenef","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Magnanimous character expressed in conduct, the nobleness Proculeius claims Caesar can display. Explicit native abstract derivation rather than hereditary title alone.","id":"shakespeare014.lex.nobleness_magnanimity.sense","status":"draft"}],"status":"draft","variants":[]},"3283197ff3fc0693cd23f61e5bef3004529099ab85a696a41ddfd7efdc6730c0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of nobility","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of nobility","exampleIds":[],"headword":"arven","id":"shakespeare014.lex.nobleness_moral","ipa":"","label":"nobleness_moral","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Distinction earned by courage or magnanimity, not inherited rank alone. Antony judges the servant Eros and his queen to have surpassed him in this quality.","id":"shakespeare014.lex.nobleness_moral.sense","status":"draft"}],"status":"draft","variants":[]},"ca82a90d801e60e5e0024e0e14f41dab540d340b6909f0d300d95ba7e5ff0428":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: nod + yes","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Authored native derivation or sense: nod + yes","exampleIds":[],"headword":"harenvelda\u00c3lam","id":"shakespeare014.lex.nod_yes_fool","ipa":"","label":"nod_yes_fool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harenveldajzhlam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"definition":"Proteus's teasing name for a fool, built in this exchange by putting the native nod and assent together.","id":"shakespeare014.lex.nod_yes_fool.sense","status":"draft"}],"status":"draft","variants":[]},"bca2ce3c66214842b153694212ddcff23f699c8e429a08dcddba4e0bbaa2a8dd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of noise","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of noise","exampleIds":[],"headword":"kran","id":"shakespeare014.lex.noise_war","ipa":"","label":"noise_war","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"kran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Make a military stir with Antony\u2019s forces against Caesar\u2019s side, in Maecenas\u2019s accusation. Native noise used verbally; does not invent a specific instrument or actual troop count.","id":"shakespeare014.lex.noise_war.sense","status":"draft"}],"status":"draft","variants":[]},"947c29d762e3516828f33da9ef0122773dc12a35b24ac4aa6b39893c3503f85f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: no + mind","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: no + mind","exampleIds":[],"headword":"mavw\u00c5vumen","id":"shakespeare014.lex.noncome_dogberry_error","ipa":"","label":"noncome_dogberry_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mavw\u0101vumen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Dogberry's mangling of the legal phrase for being of unso