":[]},"8524fad52ea4388aa18dc2272573dc420767096975734f9e16524a0a7819aa00":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"rikas","id":"shakespeare014.lex.rycas_may_dancer","ipa":"","label":"rycas_may_dancer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"rikas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The third of the dancers praised in the countrymen's talk of the May festivities.","id":"shakespeare014.lex.rycas_may_dancer.sense","status":"draft"}],"status":"draft","variants":[]},"2b13b8b442396acbf2c0d05d9999e98e4e077f7f9a18bd01fc0d5590bcfaf5f5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: winter + corn","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: winter + corn","exampleIds":[],"headword":"vernilthen","id":"shakespeare014.lex.rye_grain","ipa":"","label":"rye_grain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vernilthen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Rye as the cereal in the lovers\u2019 field. Authored winter-grain lexical category, not an assertion that all winter grain is rye.","id":"shakespeare014.lex.rye_grain.sense","status":"draft"}],"status":"draft","variants":[]},"9009911a4ed3d79f85e825b2152433f811db044a410f172541a8c30063237b64":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"saba","id":"shakespeare014.lex.saba_wisdom_que