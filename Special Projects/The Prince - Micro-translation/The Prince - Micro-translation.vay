ft"}],"status":"draft","variants":[]},"d1ad2b52b49fe905c7d82927375aa28179c798f82f1285ed1d8516280161dd87":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"tarpeia","id":"shakespeare014.lex.tarpeian_place","ipa":"","label":"tarpeian_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tarpeia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The proper geographic designation of Rome\u2019s Tarpeian rock in the threatened execution. Used with the native word for rock; no unrelated person, modern location or extra victim is invented.","id":"shakespeare014.lex.tarpeian_place.sense","status":"draft"}],"status":"draft","variants":[]},"f3a1da1a4f1dbdc4fe1eea9bfeda92d3065b48992306dbabcb4c4b6a9722d540":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"tarkwin","id":"shakespeare014.lex.tarquin_family","ipa":"","label":"tarquin_family","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tarkwin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The Tarquin family named collectively at the close of the Argument; takes native plural inflection.","id":"shakespeare014.lex.tarquin_family.sense","status":"draft"}],"status":"draft","variants":[]},"59f82cef13ab94fefb16cf3bb248abaff1d148e2077b92634145d125628955f4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"tarkwin","id":"shakespeare014.lex.tarquin_king_short","ipa":"","label":"tarquin_king_short","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tarkwin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The king repulsed in the earlier fighting remembered by Volumnia, Lucius Tarquinius Superbus; not Sextus who assaulted Lucrece. Short source name only, without an internal identity suffix.","id":"shakespeare014.lex.tarquin_king_short.sense","status":"draft"}],"status":"draft","variants":[]},"8469955d11f43a3dc770c9bdeacda112f2fad59879360ea2c288a55c351e45b2":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"tarkwin","id":"shakespeare014.lex.tarquin_son","ipa":"","label":"tarquin_son","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tarkwin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The poem\u2019s shortened name for Sextus, established by the Argument and local actions; not the king.","id":"shakespeare014.lex.tarquin_son.sense","status":"draft"}],"status":"draft","variants":[]},"72578a97800d82e2d16a9268531337dc4ab0cc5dc15b0725c6c76c36f1429dbb":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"tarsus","id":"shakespeare014.lex.tarsus_famine_city","ipa":"","label":"tarsus_famine_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tarsus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The city relieved by Pericles's grain ships and the later foster home of Marina.","id":"shakespeare014.lex.tarsus_famine_city.sense","status":"draft"}],"status":"draft","variants":[]},"9e60465ed8685eeab39149abe57f92de910567b939df4d9eae9aa0677f3ee5b6":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"tartar","id":"shakespeare014.lex.tartarus_depth","ipa":"","label":"tartarus_depth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tartar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The infernal place called Tartar to which Henry imagines Scroop's deceiver returning. Distinct from the ethnic name.","id":"shakespeare014.lex.tartarus_depth.sense","status":"draft"}],"status":"draft","variants":[]},"09cf1d5cc17f2d7478d51d5f6a5b671c817adf8b620b12e246428d7e33e4c265":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: taste","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: taste","exampleIds":[],"headword":"\u00d1\u00e9\u00d9","id":"shakespeare014.lex.taste_flavour","ipa":"","label":"taste_flavour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ch\u00e9ng","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Flavour perceived by taste, explicit nominal native taste in the blended-voices comparison. The dominant flavor of the mixture represents the commoners\u2019 influence, not a literal meal.","id":"shakespeare014.lex.taste_flavour.sense","status":"draft"}],"status":"draft","variants":[]},"5c561f28bf54e4870f0c4a8e2a1b745ce14399179dcbd167b2b65d005397baa2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of taste","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of taste","exampleIds":[],"headword":"\u00d1\u00e9\u00d9","id":"shakespeare014.lex.taste_quality","ipa":"","label":"taste_quality","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ch\u00e9ng","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A trace or flavour of a quality, source race of heaven in the lovers\u2019 bodies; not a footrace, genealogy or ethnic classification.","id":"shakespeare014.lex.taste_quality.sense","status":"draft"}],"status":"draft","variants":[]},"4b4b71b2dc7c9444131466bb132e7046eea3d020be6997db106844f536f75822":{"audioLinks":[],"citations":[{"locator":"Authored native formation; motivation in definition, not claimed historical attestation.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native formation; motivation in definition, not claimed historical attestation.","exampleIds":[],"headword":"desfil","id":"shakespeare014.lex.tattered","ipa":"","label":"tattered","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"desfil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Torn and frayed in strips, a native cut/cloth-family formation; source weed here is clothing, not a plant.","id":"shakespeare014.lex.tattered.sense","status":"draft"}],"status":"draft","variants":[]},"5cec7ca74bf48afe2200065c1d1ddbf5e4cda62a43c869356f671543fbb237c7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"taurus","id":"shakespeare014.lex.taurus_commander","ipa":"","label":"taurus_commander","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"taurus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Taurus, the commander named as Caesar\u2019s lieutenant and then addressed by Caesar. Distinct from the zodiac sign or a bull as an ordinary noun.","id":"shakespeare014.lex.taurus_commander.sense","status":"draft"}],"status":"draft","variants":[]},"1dfae3e0e82e760d8a3272eed3a94c8ff9a525de8aa36d6874ec32f4e6327fe7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wine + house","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: wine + house","exampleIds":[],"headword":"m\u00ebrvenz\u00e1l","id":"shakespeare014.lex.tavern_house","ipa":"","label":"tavern_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrvenz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"A public drinking house where a reckoning is a bill and Falstaff's hostess offers credit.","id":"shakespeare014.lex.tavern_house.sense","status":"draft"}],"status":"draft","variants":[]},"878c54f6ca6fa20e5a1686964cef81fdf20e9b21538ee1b8293112c377898ecd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"teivi","id":"shakespeare014.lex.tavy_welsh_saint","ipa":"","label":"tavy_welsh_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"teivi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Fluellen's form of the saint's name, repeating Davy with a devoiced initial.","id":"shakespeare014.lex.tavy_welsh_saint.sense","status":"draft"}],"status":"draft","variants":[]},"304dea3165a7c2a08c54d41d4e04fa6167fe4645a2cb8b13ca7e029720b122d1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: rend_apart + sheet_bed","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: rend_apart + sheet_bed","exampleIds":[],"headword":"dest\u00eb\u00c5\u00e7zttharbelenfelen","id":"shakespeare014.lex.tearsheet_surname","ipa":"","label":"tearsheet_surname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dest\u00fc\u0101\u016bzttharbelenfelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Doll's bawdy surname rendered as the rending of a bedsheet.","id":"shakespeare014.lex.tearsheet_surname.sense","status":"draft"}],"status":"draft","variants":[]},"cc08483ca3619283ded0955b45d0f35cd453a8bb943b6a5604a6058c087c4348":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: tedious + weary","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: tedious + weary","exampleIds":[],"headword":"venorlevnalevna","id":"shakespeare014.lex.tediosity_schoolmaster","ipa":"","label":"tediosity_schoolmaster","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venorlevnalevna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"Gerald's overgrown term of complaint, formed by adding weary again to the native word for tedious.","id":"shakespeare014.lex.tediosity_schoolmaster.sense","status":"draft"}],"status":"draft","variants":[]},"a9a0cbc6f4ae753a2b3795f512c2dc67c12fe8791bd6d635b92dcce52279b07c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"telamon","id":"shakespeare014.lex.telamon_ajax","ipa":"","label":"telamon_ajax","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"telamon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The source designation for Telamonian Ajax in the lost-shield comparison. Preserve the printed name rather than replace it with Ajax or mistake the allusion for an action of his father.","id":"shakespeare014.lex.telamon_ajax.sense","status":"draft"}],"status":"draft","variants":[]},"f65a15b3cbcf6b1a2ad54cf9cf50ae90622c2bc09e5ee64c04f548c9dc5222f3":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"telamon","id":"shakespeare014.lex.telamon_father","ipa":"","label":"telamon_father","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"telamon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Father of Ajax. York's Telamonius is a patronymic, rendered as Ajax son of Telamon.","id":"shakespeare014.lex.telamon_father.sense","status":"draft"}],"status":"draft","variants":[]},"9c37b3e02eefd4e4f2f7f4830e08646246b59ebdae10091688e51048998c1f05":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"telus","id":"shakespeare014.lex.tellus_earth","ipa":"","label":"tellus_earth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"telus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"Earth personified and named alongside Phoebus, Neptune and Hymen in the Player King's verse.","id":"shakespeare014.lex.tellus_earth.sense","status":"draft"}],"status":"draft","variants":[]},"79f44bf74396ff741e68d06abcb33e47f73c49e414e44c5d095173bb51b3dedd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of temperance","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of temperance","exampleIds":[],"headword":"irtargl\u00c9z\u00cben","id":"shakespeare014.lex.temper_restraint","ipa":"","label":"temper_restraint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"irtargl\u00e4zhwen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Self-command, firmness and measured disposition renounced by Antony\u2019s heart in Philo\u2019s accusation. Not bodily temperature; the martial metal-temper resonance is documented separately.","id":"shakespeare014.lex.temper_restraint.sense","status":"draft"}],"status":"draft","variants":[]},"cefadd52a9a6c6d3e273a06d301abf4eb526e88497b0aac6138c9b0b7b7eb886":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_temperance_acts","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_temperance_acts","exampleIds":[],"headword":"irtargl\u00c9z\u00cben","id":"shakespeare014.lex.temperance","ipa":"","label":"temperance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"irtargl\u00e4zhwen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Self-restraint in the fire/thaw image; not limited to abstinence from alcohol.","id":"shakespeare014.lex.temperance.sense","status":"draft"}],"status":"draft","variants":[]},"cb76c31bef7910fd2a533443262281058c37785d763ee0a74438f6375cc903cf":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: temperate_mild","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: temperate_mild","exampleIds":[],"headword":"memna","id":"shakespeare014.lex.temperance_imagined_wench","ipa":"","label":"temperance_imagined_wench","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"memna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"Antonio takes the preceding word for mild climate as a woman's name. Both senses deliberately have the same native form.","id":"shakespeare014.lex.temperance_imagined_wench.sense","status":"draft"}],"status":"draft","variants":[]},"2fe7091adee924330cfe8eaab5ba10cb333f0fd8af73f08e765cefe58a3edf34":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of moderate","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of moderate","exampleIds":[],"headword":"memna","id":"shakespeare014.lex.temperate_mild","ipa":"","label":"temperate_mild","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"memna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Mild and well-tempered, with both climate and character available in the summer comparison.","id":"shakespeare014.lex.temperate_mild.sense","status":"draft"}],"status":"draft","variants":[]},"dc76b02cd41a546385f8b155fa922fb012bc19685a4e815b6bf6ed9a250c20bb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: restrain + gentle","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: restrain + gentle","exampleIds":[],"headword":"targl\u00c9z\u00cbenvenla","id":"shakespeare014.lex.temperate_restrained","ipa":"","label":"temperate_restrained","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"targl\u00e4zhwenvenla","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Restrained and measured in proceeding, Menenius\u2019s contrast with violent redress. Native restrained-gentle; not an assertion about climate or bodily temperature.","id":"shakespeare014.lex.temperate_restrained.sense","status":"draft"}],"status":"draft","variants":[]},"d3862a19bc1843d6f27e4dcdd581d599d7f7a8ee7491abf668087f41eb7fe36c":{"audioLinks":[],"citations":[{"locator":"Authored native lexical root, not a claim of documented historical sound change.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Authored native lexical root, not a claim of documented historical sound change.","exampleIds":[],"headword":"jw\u00ebrel","id":"shakespeare014.lex.tempered_metal","ipa":"","label":"tempered_metal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"jw\u00fcrel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Metal treated to attain its requisite strength; native root motivated by jw\u00ebnen (strength), without inserting a particular modern metallurgical process.","id":"shakespeare014.lex.tempered_metal.sense","status":"draft"}],"status":"draft","variants":[]},"bdd428907ea3e39ec9400e48a80b26b2392f673582d63bd9cc320d9766a4eb45":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: law + house","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: law + house","exampleIds":[],"headword":"lamthr\u00ebnz\u00e1l","id":"shakespeare014.lex.temple_inn_law","ipa":"","label":"temple_inn_law","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lamthr\u00fcnz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"London's legal precinct with a hall, garden and chambers. Richard's followers meet here.","id":"shakespeare014.lex.temple_inn_law.sense","status":"draft"}],"status":"draft","variants":[]},"83996cebffdbe6d967c8bf59fa9acb0ce2d935ab18e57cc495570a9810f7dd2e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: time + yield","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: time + yield","exampleIds":[],"headword":"venorf\u00c5wmarjo\u00d9","id":"shakespeare014.lex.temporize_adapt","ipa":"","label":"temporize_adapt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"venorf\u0101wmarjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Accommodate one\u2019s conduct to the circumstances of the time. Native time-yield; Menenius imagines the outcome if Coriolanus could have done this, not a claim that he did or merely delayed.","id":"shakespeare014.lex.temporize_adapt.sense","status":"draft"}],"status":"draft","variants":[]},"0f888d82b47164402529a47871870ee1e2c28297d43af5e659551fbb6c424a19":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of tempt","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of tempt","exampleIds":[],"headword":"nelam","id":"shakespeare014.lex.temptation","ipa":"","label":"temptation","notes":"","o