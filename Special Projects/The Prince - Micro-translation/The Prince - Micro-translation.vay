hakespeare014.lex.lancaster_gaunt_duchy","ipa":"","label":"lancaster_gaunt_duchy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lankaster","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The dukedom held by John of Gaunt and then by Henry Bolingbroke. Distinct from the dynasty and the later royal son's title.","id":"shakespeare014.lex.lancaster_gaunt_duchy.sense","status":"draft"}],"status":"draft","variants":[]},"05ac42420c6884d968118ee34f70b12ea40ad29c8c52442842f0c6bd876a2bce":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"lankaster","id":"shakespeare014.lex.lancaster_title","ipa":"","label":"lancaster_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lankaster","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Territorial title attached to Lord John.","id":"shakespeare014.lex.lancaster_title.sense","status":"draft"}],"status":"draft","variants":[]},"945bf97ddb7f38fee918081183a08085018173ccd7d64f6302a0d07114f64dc3":{"audioLinks":[],"citations":[{"locator":"Reviewed literary sense of kjv_lance","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed literary sense of kjv_lance","exampleIds":[],"headword":"tarven","id":"shakespeare014.lex.lance","ipa":"","label":"lance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The pointed martial weapon offered on Venus\u2019s altar; no unprinted metal or length is added.","id":"shakespeare014.lex.lance.sense","status":"draft"}],"status":"draft","variants":[]},"90952dfedc688d69d277a21c412536c100cb8c9bd86207b17b0f8c6469534da5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of pierce","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of pierce","exampleIds":[],"headword":"thrinterastnerda\u00c3","id":"shakespeare014.lex.lance_infection","ipa":"","label":"lance_infection","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thrinterastnerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Open a diseased swelling by piercing to release its contents, Caesar\u2019s bodily metaphor for destroying Antony. Native pierce, not a claim to be wielding the long military lance.","id":"shakespeare014.lex.lance_infection.sense","status":"draft"}],"status":"draft","variants":[]},"f1e43edaf383192f29edeb9a61598e1803791fd525114f90827dd00bb9ae77eb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: lance","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Authored native derivation or sense: lance","exampleIds":[],"headword":"tarven","id":"shakespeare014.lex.lance_proteus_servant","ipa":"","label":"lance_proteus_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"definition":"Proteus's servant and Crab's keeper. The familiar name shares its form with the native weapon word.","id":"shakespeare014.lex.lance_proteus_servant.sense","status":"draft"}],"status":"draft","variants":[]},"77e8871515aed5029c7bb372d5dc2f2da34fcdb505ea35043867303aa5a29b94":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare0