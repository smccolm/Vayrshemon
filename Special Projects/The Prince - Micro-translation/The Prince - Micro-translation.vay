steward","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: prison + steward","exampleIds":[],"headword":"kl\u00e1rjemz\u00e1lz\u00e1linhif\u00e5r","id":"shakespeare014.lex.provost_vienna_prison","ipa":"","label":"provost_vienna_prison","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kl\u00f4rjemz\u00f4lz\u00f4linhifour","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The official in charge of the Viennese prison and its condemned prisoners.","id":"shakespeare014.lex.provost_vienna_prison.sense","status":"draft"}],"status":"draft","variants":[]},"d92881e5bba5977399dff34327f81f398e7b4d2b1f938ed5c64be45b7783e196":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_discretion","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_discretion","exampleIds":[],"headword":"p\u00e1nw\u00c5vum","id":"shakespeare014.lex.prudent_judgment","ipa":"","label":"prudent_judgment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4nw\u0101vum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Forethought in deciding how to act; Oliver invokes it while encouraging violence. The noun itself does not approve his purpose.","id":"shakespeare014.lex.prudent_judgment.sense","status":"draft"}],"status":"draft","variants":[]},"8ef66469dbb8dfec26ca59b363e99904b039089ba9933be8f5bb8dca7282ef53":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dry + plum","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: dry + plum","exampleIds":[],"headword":"mayemsvemul","id":"shakespeare014.lex.prune_dried_plum","ipa":"","label":"prune_dried_plum","notes":"","o