9v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Face or confront the present emergency with available land and sea forces, source front. Native nominal face converted to a verb; no specified battle opponent is inserted.","id":"shakespeare014.lex.face_confront.sense","status":"draft"}],"status":"draft","variants":[]},"1debb46e8d0f597e21f6757e8ebf711f3d54f0bad9e5d7437c9edcf504c2eb40":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of political_faction","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of political_faction","exampleIds":[],"headword":"threnina\u00d9gur","id":"shakespeare014.lex.faction_party","ipa":"","label":"faction_party","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"threninanggur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A partisan group brought into a quarrel, the threatened bandying in faction. Native divided-party sense; no modern political institution or new group appearing onstage.","id":"shakespeare014.lex.faction_party.sense","status":"draft"}],"status":"draft","variants":[]},"a9fed92e18651dd1a1df8b7dfe4df805cb744ea36d8d968231a6380807b04e84":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from weak, see","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from weak, see","exampleIds":[],"headword":"vimjw\u00ebno\u00c3","id":"shakespeare014.lex.faint_sight","ipa":"","label":"faint_sight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"vimjw\u00fcnojzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Dim/limited in sight as the source characterizes the hare; not a newly diagnosed condition.","id":"shakespeare014.lex.faint_sight.sense","status":"draft"}],"status":"draft","variants":[]},"4c5433d972164e3f111421e0f3cb1a1f137f4e52ac11dcc7305f3c42f88dd4e4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: market + gift","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: market + gift","exampleIds":[],"headword":"kwist\u00e7l\u00d7onf\u00c5wen","id":"shakespeare014.lex.fairing_gift","ipa":"","label":"fairing_gift","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kwist\u016bl\u0113onf\u0101wen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"A present of the sort bought at a fair, used of the suitors' gifts.","id":"shakespeare014.lex.fairing_gift.sense","status":"draft"}],"status":"draft","variants":[]},"4f5b542258b0f3fa38395a99d5b41b556575e2296ce206692c8de9e7e6a54101":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: faith + break","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: faith + break","exampleIds":[],"headword":"lamprodika\u00d9s\u00dflum","id":"shakespeare014.lex.faith_breaker","ipa":"","label":"faith_breaker","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamprodikangs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A breaker from an allegiance or professed faith, personified Policy opposed to constant love in Sonnet 124; native faith-break agent, without assigning a historical denomination or legal punishment.","id":"shakespeare014.lex.faith_breaker.sense","status":"draft"}],"status":"draft","variants":[]},"c067649724cf3c212916781aa72ce67c069d4daa7df371bad29836c4c34fc1f9":{"audioLinks":[],"citations":[{"locator":"Authore