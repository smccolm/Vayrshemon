se","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Ease from sorrow or distress, the relief Silvius asks should follow pity; not food or a relief sculpture.","id":"shakespeare014.lex.relief_ease.sense","status":"draft"}],"status":"draft","variants":[]},"325d139f53fd4cc5a7cf3421366b0f5469ec2cfd8892c6b45cf45e29c9e7da7a":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from need, food","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from need, food","exampleIds":[],"headword":"f\u00ebr\u00d3d\u00cdn\u00d7r","id":"shakespeare014.lex.relief_food","ipa":"","label":"relief_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u00fcrthd\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Food/support available to the deer within the park metaphor; not modern welfare or emotional relief alone.","id":"shakespeare014.lex.relief_food.sense","status":"draft"}],"status":"draft","variants":[]},"3a0718f273dea0af1aa4da964540b75c5f3767f98b1c81e987e6b76b35139b43":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: change + guard","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: change + guard","exampleIds":[],"headword":"\u00e3lumjemek","id":"shakespeare014.lex.relieve_watch","ipa":"","label":"relieve_watch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"oilumjemek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"Take over another guard\u2019s shift. Distinct from alleviating want or distress.","id":"shakespeare014.lex.relieve_watch.sense",