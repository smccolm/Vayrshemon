or":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Philosopher whose counsels of moderation Tranio contrasts with Ovid.","id":"shakespeare014.lex.aristotle_philosopher.sense","status":"draft"}],"status":"draft","variants":[]},"1503593f64d802822b0a87470aa207d556a5dfe33f76ffb14ec60d4fa7a3caa5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: measure + reckon","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: measure + reckon","exampleIds":[],"headword":"memtaren","id":"shakespeare014.lex.arithmetic_reckoning","ipa":"","label":"arithmetic_reckoning","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memtaren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Numerical reckoning in the claim that the hostile odds exceed calculation. Native measure-reckon names the discipline; no unstated count or decimal system is substituted for Unta.","id":"shakespeare014.lex.arithmetic_reckoning.sense","status":"draft"}],"status":"draft","variants":[]},"f5f5aa73c8f0714d7301fad732fca256c760e4c06d773a670242fa2ce9abf039":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: weapon + give","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: weapon + give","exampleIds":[],"headword":"hefakd\u00c7\u00d3s\u00ebnalf\u00c5w","id":"shakespeare014.lex.arm_equip","ipa":"","label":"arm_equip","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"hefakd\u00e3ths\u00fcnalf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Equip with weapons or martial force, including arming one\u2019s wit; distinct from a bodily arm.","id":"shakespeare014.lex.arm_equip.sense","status":"draft"}],"status":"draft","variants":[]},"eee8d56cab3485c83894c54d4ed25a2e4bf1dbd6eb93c567ff42693a3bc45ac8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: arm + thin","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: arm + thin","exampleIds":[],"headword":"larthirilin","id":"shakespeare014.lex.arm_gaunt_literary","ipa":"","label":"arm_gaunt_literary","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"larthirilin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A deliberately literal native arm-thin rendering of the unsettled source arm-gaunt. Proposed source readings include lean limbs, fine condition and armoured trappings. This literary exception does not certify one interpretation or create a general horse condition.","id":"shakespeare014.lex.arm_gaunt_literary.sense","status":"draft"}],"status":"draft","variants":[]},"1ed262f54288a8e31c83c416ce91ad5fee99cf62a763487b2d5bd5463d3f93f8":{"audioLinks":[],"citations":[{"locator":"Authored native compound: arm + hang","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: arm + hang","exampleIds":[],"headword":"larzarn","id":"shakespeare014.lex.arm_sling","ipa":"","label":"arm_sling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"larzarn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A support suspending an injured arm, native arm-hang. Distinct from the stone-throwing weapon; no modern medical construction or treatment instructions are inserted.","id":"shakespeare014.lex.arm_sling.sense","status":"draft"}],"status":"draft","variants":[]},"f97fb3c9c902d95a2c752d917e75f3b66adf9927180f73185f909019f70b9137":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"ar","id":"shakespeare014.lex.armado_interrupted_name","ipa":"","label":"armado_interrupted_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Dull's twice interrupted attempt at Armado's name. This is a fragment of this person's localized name.","id":"shakespeare014.lex.armado_interrupted_name.sense","status":"draft"}],"status":"draft","variants":[]},"35fd07ca05513294487db4c8fd12eeadc40323f71322ade64b626a1caf06939d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"armado","id":"shakespeare014.lex.armado_spanish_traveler","ipa":"","label":"armado_spanish_traveler","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"armado","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The Spanish traveler whose style of speaking delights Ferdinand.","id":"shakespeare014.lex.armado_spanish_traveler.sense","status":"draft"}],"status":"draft","variants":[]},"c16bb6c155aa856b60a092193b3d6eff411edad26b13637db215d1e534c68878":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"armanyak","id":"shakespeare014.lex.armagnac_earldom","ipa":"","label":"armagnac_earldom","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"armanyak","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The earldom of the father of Henry's proposed first bride. His daughter is not Margaret.","id":"shakespeare014.lex.armagnac_earldom.sense","status":"draft"}],"status":"draft","variants":[]},"cf1ed0ec4b37e93d40f5522923cdaeabb8f1dcfcc0046a961a4f9af655a22f01":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_armenia","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_armenia","exampleIds":[],"headword":"armenia","id":"shakespeare014.lex.armenia_region","ipa":"","label":"armenia_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"armenia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Armenia in the territory grants and Caesar\u2019s demand for reciprocal shares. The named region, not a new modern boundary claim.","id":"shakespeare014.lex.armenia_region.sense","status":"draft"}],"status":"draft","variants":[]},"d76fac6281c417d0dd849e55b42dea548d75c4fd7f05d4c333b0b8a8f3575ec5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: shield + carry","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: shield + carry","exampleIds":[],"headword":"jemzethf\u00c5w\u00db\u00c7d","id":"shakespeare014.lex.armigero_esquire_style","ipa":"","label":"armigero_esquire_style","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jemzethf\u0101wsh\u00e3d","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The Latin legal style of an armiger. Rendered as the mock grand style shield-bearer in Slender's twofold utterance.","id":"shakespeare014.lex.armigero_esquire_style.sense","status":"draft"}],"status":"draft","variants":[]},"02fb2a9a15c02d58b68f3145bb096acfd4cf8039d29229d02443e7fcb16d9c15":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: armour + make + person","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: armour + make + person","exampleIds":[],"headword":"hefakgur\u00e5v\u00d1eta\u00d9s\u00dflum","id":"shakespeare014.lex.armorer_trade","ipa":"","label":"armorer_trade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgurouvchetangs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"A maker of armor. Horner is Peter's trade master.","id":"shakespeare014.lex.armorer_trade.sense","status":"draft"}],"status":"draft","variants":[]},"42056c06980d534af3c49b7a0a24816a343840f4d364eca57c47c899cadeee9d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of heraldry","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of heraldry","exampleIds":[],"headword":"arventhrendewy\u00c9","id":"shakespeare014.lex.armorial_coat","ipa":"","label":"armorial_coat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arventhrendewy\u00e4","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A coat of arms and its inherited heraldic display; not an ordinary coat of clothing.","id":"shakespeare014.lex.armorial_coat.sense","status":"draft"}],"status":"draft","variants":[]},"c811e9184fd7d5fde9d6c066159b384bb8e7eb4740d059d75a540ac6762af197":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_armour","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_armour","exampleIds":[],"headword":"hefakgur\u00e5v\u00d1et","id":"shakespeare014.lex.armour","ipa":"","label":"armour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgurouvchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Military protective gear; applies to the battered arms of the campaign and to Tarquin\u2019s naked-armour paradox.","id":"shakespeare014.lex.armour.sense","status":"draft"}],"status":"draft","variants":[]},"bd1f337c91a40e4924c0d210871bb26f2fb9a396b5d078fc45b75b183195829e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: armour + craft","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: armour + craft","exampleIds":[],"headword":"hefakgur\u00e5v\u00d1et jw\u00ebnh\u00c5b\u00cds\u00dflum","id":"shakespeare014.lex.armour_craftsman","ipa":"","label":"armour_craftsman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgurouvchet jw\u00fcnh\u0101b\u0117rs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"One who makes or fits armour; Cleopatra becomes the figurative armourer of Antony\u2019s heart. Analytic equipment modifier plus craft-person, with a word boundary rather than an indivisible agglutinated chain.","id":"shakespeare014.lex.armour_craftsman.sense","status":"draft"}],"status":"draft","variants":[]},"cecbe5678ce9b9a6775d2513bf55bd1cc9b0464be550a84e211c0677d2dbff7e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: armour + cover","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: armour + cover","exampleIds":[],"headword":"hefakgur\u00e5v\u00d1etshalen","id":"shakespeare014.lex.armour_plated","ipa":"","label":"armour_plated","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"hefakgurouvchetshalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Covered in armour plates, the visual comparison to Mars in Philo\u2019s opening speech.","id":"shakespeare014.lex.armour_plated.sense","status":"draft"}],"status":"draft","variants":[]},"3139fc4d95e1693f98a970f834704901ec8fb55b856ad937390ed6e3bdd5468d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: knight + kjv_skirt_garment","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: knight + kjv_skirt_garment","exampleIds":[],"headword":"hefak arvlam s\u00dflumfelenthren","id":"shakespeare014.lex.armour_skirt_bases","ipa":"","label":"armour_skirt_bases","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak arvlam s\u014dlumfelenthren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"A knight's tournament skirts, to be made from the fisherman's gown. A pair describes the outfit.","id":"shakespeare014.lex.armour_skirt_bases.sense","status":"draft"}],"status":"draft","variants":[]},"d8cba3c618f848c9e9c6b63e4746e42fd6652628ca6aab8b4e11f1a5d6d1cf97":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of employ","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of employ","exampleIds":[],"headword":"\u00e5v","id":"shakespeare014.lex.army_employment","ipa":"","label":"army_employment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ouv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Admission into Caesar\u2019s service, the entertainment granted to deserters without trusted rank. Not diversion or a meal.","id":"shakespeare014.lex.army_employment.sense","status":"draft"}],"status":"draft","variants":[]},"751359ea0f656ecc013ff87a7133f730f9b027bb656fe1857fd29854d0fdf44f":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of rank","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of rank","exampleIds":[],"headword":"arventhren","id":"shakespeare014.lex.army_rank","ipa":"","label":"army_rank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arventhren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"An ordered line of an army, extended to the metaphorical lilies and roses; distinct from social rank.","id":"shakespeare014.lex.army_rank.sense","status":"draft"}],"status":"draft","variants":[]},"d5fc36f306bf06775845eabecca0156a864fa98a6f3b4f59fa26ae57e255465a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wall + weave + image","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: wall + weave + image","exampleIds":[],"headword":"darthiravl\u00dfnil","id":"shakespeare014.lex.arras_hanging","ipa":"","label":"arras_hanging","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"darthiravl\u014dnil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A figured wall hanging recounting a story. Iachimo records its subject as evidence of access to the room.","id":"shakespeare014.lex.arras_hanging.sense","status":"draft"}],"status":"draft","variants":[]},"7ceb7518fc96fc5b8ea3f96247f15cdb4d998c5ddc571fee8f1264bc968282f9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: arrow + shoot","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: arrow + shoot","exampleIds":[],"headword":"kerilkerth","id":"shakespeare014.lex.arrow