_county","ipa":"","label":"lincolnshire_county","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"linkolnshir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Regional name in the comparison to the drone of a Lincolnshire bagpipe.","id":"shakespeare014.lex.lincolnshire_county.sense","status":"draft"}],"status":"draft","variants":[]},"c067a2b615e17ce11ce5a95baaa8b32685790ca607f6bae456e8fe2b51bba478":{"audioLinks":[],"citations":[{"locator":"Authored native compound: inside + cloth","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: inside + cloth","exampleIds":[],"headword":"nifelen","id":"shakespeare014.lex.line_clothing","ipa":"","label":"line_clothing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"nifelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Put an inner layer in a garment, native inside + cloth. Touchstone applies the same term to slender Rosalind in an innuendo; not the pictorial lined of the earlier poem.","id":"shakespeare014.lex.line_clothing.sense","status":"draft"}],"status":"draft","variants":[]},"7b35b90c28cb71faec9cf26e4097a4e08be367e1fe8bf19fc43efc757d389f6a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: thread + tree","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: thread + tree","exampleIds":[],"headword":"thirily\u00eblverzet","id":"shakespeare014.lex.line_linden_tree","ipa":"","label":"line_linden_tree","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thirily\u00fclverzet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The fibre-yielding linden from which the garments hang. The stage direction specifies a tree.","id":"shakespeare014.lex.line_linden_tree.sense","status":"draft"}],"status":"draft","variants":[]},"0d10bcdd4d6f02bd5340ebb11eaa0d71c1b22c776373125839fcc067f5c5ad2a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: ancestor + kin","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: ancestor + kin","exampleIds":[],"headword":"p\u00e1npalv\u00d7dlehm","id":"shakespeare014.lex.lineage_race","ipa":"","label":"lineage_race","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4npalv\u0113dlehm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Ancestral stock or lineage in Aufidius\u2019s Hector challenge, source progeny; not specifically Martius\u2019s future children or a modern biological race taxonomy.","id":"shakespeare014.lex.lineage_race.sense","status":"draft"}],"status":"draft","variants":[]},"6a2c60729879b6956506d802f25b9bf92d1e44072bef16a862f88b0b4ea81ebe":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"lingar","id":"shakespeare014.lex.lingare_ancestor","ipa":"","label":"lingare_ancestor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lingar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Daughter of the Charlemagne whom Canterbury places one generation below Lewis the Emperor.","id":"shakespeare014.lex.lingare_ancestor.sense","status":"draft"}],"status":"draft","variants":[]},"46daaeac45e07d4e10f61ea71ca7dbffe02a6737033824d51970e226e97a4ecb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fire + staff","sourc