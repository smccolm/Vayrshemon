e.","id":"shakespeare014.lex.afflict_harm.sense","status":"draft"}],"status":"draft","variants":[]},"b849b21ce35c60913bb54ba20036bd0d9f1104cf4e8b9bdfa7def8255e634d6f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"afrika","id":"shakespeare014.lex.africa_region","ipa":"","label":"africa_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"afrika","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The geographic Africa of Aufidius\u2019s serpent comparison, source Afric; no modern border or single nationality is imposed.","id":"shakespeare014.lex.africa_region.sense","status":"draft"}],"status":"draft","variants":[]},"0c878599baf47ba18e5674ee5ec10cbe0c37076b70bebd40d03da61e4f710d14":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: follow + eye","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: follow + eye","exampleIds":[],"headword":"akradomi","id":"shakespeare014.lex.after_eye_follow","ipa":"","label":"after_eye_follow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"akradomi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Follow a retreating person with one\u2019s gaze. The native compound recreates the act named by Imogen\u2019s unusual verb.","id":"shakespeare014.lex.after_eye_follow.sense","status":"draft"}],"status":"draft","variants":[]},"c397a0a275a458dfccd10182419d3d9f7894ee6c64127e78bf540902eab1afe7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: after + meet","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: after + meet","exampleIds":[],"headword":"h\u00ebthtw\u00ddnjyb","id":"shakespeare014.lex.after_meeting","ipa":"","label":"after_meeting","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"h\u00fcthtw\u012bnjyb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The follow-up civic meeting after earlier business, Menenius\u2019s after-meeting. Explicit nominal meeting with temporal after; no unstated date or numbered sitting.","id":"shakespeare014.lex.after_meeting.sense","status":"draft"}],"status":"draft","variants":[]},"54badde096b1162e9713fa43837099442e379f31a4db09699871ef5705d12809":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"agamemnon","id":"shakespeare014.lex.agamemnon_greek","ipa":"","label":"agamemnon_greek","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"agamemnon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Greek commander in Doll's comparison of Falstaff to the heroes of Troy.","id":"shakespeare014.lex.agamemnon_greek.sense","status":"draft"}],"status":"draft","variants":[]},"5104db7944cbf2016bc2117702aa6a1a0c7e22c22ef24fadd2a3139de8a0da46":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of age","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of age","exampleIds":[],"headword":"vornvenor","id":"shakespeare014.lex.age_personified","ipa":"","label":"age_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"vornvenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1