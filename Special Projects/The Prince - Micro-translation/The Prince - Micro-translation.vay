oun","pronunciation":"farp\u00f4f\u0113j\u0117rtonda","senses":[{"citations":[{"locator":"lex.kjv_gospel","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Gospel,the proclaimed good news of the kingdom in Matthew4:23;good-news. Not automatically a title of a completed written book.","id":"shakespeare014.biblical-vocabulary.kjv_gospel.sense","status":"draft"}],"status":"draft","variants":[]},"7385b9cf2eb6de6b6d86b076f3aceec7a4da35f7a928ee1b3af15c381d58efe5":{"audioLinks":[],"citations":[{"locator":"lex.kjv_grisled","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"ve\u00dbthrenpirilna","id":"shakespeare014.biblical-vocabulary.kjv_grisled","ipa":"","label":"kjv_grisled","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"veshthrenpirilna","senses":[{"citations":[{"locator":"lex.kjv_grisled","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Grizzled or grey-mottled in the source animal marking list; kept distinct from ring-banded and speckled.","id":"shakespeare014.biblical-vocabulary.kjv_grisled.sense","status":"draft"}],"status":"draft","variants":[]},"b7ff296d91eb11703afaeb090b0c62da2e1432e98537270839fd9c4e5e276f21":{"audioLinks":[],"citations":[{"locator":"lex.kjv_hatch","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"pelshal\u00c5el","id":"shakespeare014.biblical-vocabulary.kjv_hatch","ipa":"","label":"kjv_hatch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"pelshal\u0101el","senses":[{"citations":[{"locator":"lex.kjv_hatch","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Hatch or bring young from eggs,egg-open;the nesting bird action inIsaiah34:15. Distinct from opening an arbitrary container or a nautical hatch;no exact egg count or incubation procedure added.","id":"shakespeare014.biblical-vocabulary.kjv_hatch.sense","status":"draft"}],"status":"draft","variants":[]},"02e31753484cf6c6f4611bb59cb125d71a6329ab276e4dc6ba42891385df6a3c":{"audioLinks":[],"citations":[{"locator":"lex.kjv_haven","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"y\u00eblyemardlen\u00e7l\u00d7on","id":"shakespeare014.biblical-vocabulary.kjv_haven","ipa":"","label":"kjv_haven","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclyemardlen\u016bl\u0113on","senses":[{"citations":[{"locator":"lex.kjv_haven","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"A sheltered place for ships by the sea; not heaven or an abstract refuge alone.","id":"shakespeare014.biblical-vocabulary.kjv_haven.sense","status":"draft"}],"status":"draft","variants":[]},"203828afa699ab81dcdb446bd7cdb10dba65b826cd351aa4931ecaa9c2bea47e":{"audioLinks":[],"citations":[{"locator":"lex.kjv_heifer","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"pelna zanna boral","id":"shakespeare014.biblical-vocabulary.kjv_heifer","ipa":"","label":"kjv_heifer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pelna zanna boral","senses":[{"citations":[{"locator":"lex.kjv_heifer","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"A young female bovine in the source sacrificial list; not a generic animal nor an adult male ox.","id":"shakespeare014.biblical-vocabulary.kjv_heifer.sense","status":"draft"}],"status":"draft","variants":[]},"1ccb1236b80f03b4a67e95deac9ec7d71a118154508020ac457cd1eadbfec297":{"audioLinks":[],"citations":[{"locator":"lex.kjv_hinge","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"dar\u00c5elelyi\u00d1","id":"shakespeare014.biblical-vocabulary.kjv_hinge","ipa":"","label":"hinge","notes":"","orthographyId":"thimfora-79","part