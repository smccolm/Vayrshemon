ource.pericles.r1"}],"definition":"A woman who serves in Diana's temple, including Thaisa in the final scene.","id":"shakespeare014.lex.woman_priest_diana.sense","status":"draft"}],"status":"draft","variants":[]},"96289ffb5da7e7d196cfd81e249a0cc71d6f417d815be68105fb6db0af7d5885":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"wonkot","id":"shakespeare014.lex.woncot_village","ipa":"","label":"woncot_village","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wonkot","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Home of William Visor.","id":"shakespeare014.lex.woncot_village.sense","status":"draft"}],"status":"draft","variants":[]},"7349265b81a91a08eebf7ef0b487071eaf51b9146a3343e8e9860d421b1e0a1a":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: wood + piece","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: wood + piece","exampleIds":[],"headword":"y\u00eblthrenin","id":"shakespeare014.lex.wood_chip","ipa":"","label":"wood_chip","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A small piece of wood; the dancing chips of the keyboard in Sonnet 128. Does not turn the intact instrument into discarded splinters.","id":"shakespeare014.lex.wood_chip.sense","status":"draft"}],"status":"draft","variants":[]},"7d3aa9b533523665298b623f0500ddd0fd4bbd5aa8dff65923ad101cae45940a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: wood + line","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: wood + line","exampleIds":[],"headword":"y\u00eblthrenin","id":"shakespeare014.lex.wood_grain","ipa":"","label":"wood_grain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The fibrous pattern or grain of wood, source grained ash. Native wood-line, distinct from cereal grain and the scarlet grain dye.","id":"shakespeare014.lex.wood_grain.sense","status":"draft"}],"status":"draft","variants":[]},"3b805bbe103762e6e5b9a020ac206ad6b48b7ba98731c74544a5580e9ec301e4":{"audioLinks":[],"citations":[{"locator":"Authored native compound: wood + piece","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: wood + piece","exampleIds":[],"headword":"y\u00eblthrenin","id":"shakespeare014.lex.wood_panel","ipa":"","label":"wood_panel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A board or panel used in that lining, native wood + piece. A member that may shrink/warp in the marriage simile, not a software control.","id":"shakespeare014.lex.wood_panel.sense","status":"draft"}],"status":"draft","variants":[]},"3511a2097f3f5ba50d404c0a942eeb40c0f2691bebe4624c14f7d07866c306d8":{"audioLinks":[],"citations":[{"locator":"Authored native compound: wood + wall","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: wood + wall","exampleIds":[],"headword":"y\u00ebldar","id":"shakespeare014.lex.wood_panelling","ipa":"","label":"wood_panelling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fcldar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Joined wooden wall lining, native wood + wall. The carpentry comparison for a badly made marriage; not a specific wood species or an invented modern joinery method.","id":"shakespeare014.lex.wood_panelling.sense","status":"draft"}],"status":"draft","variants":[]},"ad6f25b1ae1d324b1028b60c1fd683e361c2796b7d2923ca9f62078ce0f2a974":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: wood + fragment_scrap","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: wood + fragment_scrap","exampleIds":[],"headword":"y\u00eblthrenin","id":"shakespeare014.lex.wood_splinter","ipa":"","label":"wood_splinter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A sharp fragment of broken wood, in the exaggerated image of spear splinters scarring the moon. Native wood-fragment; not an actual astronomical event.","id":"shakespeare014.lex.wood_splinter.sense","status":"draft"}],"status":"draft","variants":[]},"a7c34eb1d0ab91e80c695d28d187c09dcf287bbbc09cc604365d82f51f181074":{"audioLinks":[],"citations":[{"locator":"Authored native compound: wood + stand","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: wood + stand","exampleIds":[],"headword":"y\u00eblkoj","id":"shakespeare014.lex.wooden_post","ipa":"","label":"wooden_post","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclkoj","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An upright wooden post in Rosalind\u2019s joke about silent sadness, native wood + stand. Not the existing post verb meaning relay-horse travel.","id":"shakespeare014.lex.wooden_post.sense","status":"draft"}],"status":"draft","variants":[]},"7ae8e442e40f78a438f071cab211993c84edcdecf40867ca8f857bd7e935e7e2":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"wudvil","id":"shakespeare014.lex.woodeville_elizabeth_brother","ipa":"","label":"woodeville_elizabeth_brother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wudvil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The Queen's brother named by Richard. The supplied entrance names Woodeville, Rivers and Scales separately; preserve its stage roster.","id":"shakespeare014.lex.woodeville_elizabeth_brother.sense","status":"draft"}],"status":"draft","variants":[]},"6eec414447daa87db23d113db67fdf9cb26d07dbcc598a07d19995d750070d93":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"wudstok","id":"shakespeare014.lex.woodstock_birthplace","ipa":"","label":"woodstock_birthplace","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wudstok","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Place in the byname of Thomas, listed as Edward's sixth son.","id":"shakespeare014.lex.woodstock_birthplace.sense","status":"draft"}],"status":"draft","variants":[]},"4ed24b4b4925e28124cc5904a6a0abc6c4e26ac6d6afc8dedb8b381b037f150a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"wudstok","id":"shakespeare014.lex.woodstock_duke_byname","ipa":"","label":"woodstock_duke_byname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wudstok","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"Thomas of Woodstock, the dead Duke of Gloucester, called here by his territorial byname.","id":"shakespeare014.lex.woodstock_duke_byname.sense","status":"draft"}],"status":"draft","variants":[]},"e01080c856a3040fb562c0c7c596f5d3854042dd922c80bab1f05591dd89f47b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"wudvil","id":"shakespeare014.lex.woodville_lieutenant","ipa":"","label":"woodville_lieutenant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wudvil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The Tower lieutenant whom Winchester has forbidden to admit Gloucester.","id":"shakespeare014.lex.woodville_lieutenant.sense","status":"draft"}],"status":"draft","variants":[]},"22ff8f4abe705458b370dd4dd01e2103dfa6e23ef317cd207e9584e9f16db05d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: suitor","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: suitor","exampleIds":[],"headword":"w\u00cf\u00dfens\u00dflum","id":"shakespeare014.lex.wooer_jailer_daughter","ipa":"","label":"wooer_jailer_daughter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00cf\u014dens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The Jailer's daughter's unnamed suitor, who discusses her marriage settlement with her father.","id":"shakespeare014.lex.wooer_jailer_daughter.sense","status":"draft"}],"status":"draft","variants":[]},"d0f003322110d24120108202f2afd5cca92aa18944a19c93becbcadc491f7080":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_wool","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_wool","exampleIds":[],"headword":"sh\u00ebralf\u00ebl","id":"shakespeare014.lex.wool_material","ipa":"","label":"wool_material","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sh\u00fcralf\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The textile material in woolen vassals, retaining the class-marking clothing and sheep association without changing the people into animals.","id":"shakespeare014.lex.wool_material.sense","status":"draft"}],"status":"draft","variants":[]},"d0d8ebffae0c43de73fb99300a6cefaa4efaba7ea5e2de4c5bdad3dc7365e335":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"wuster","id":"shakespeare014.lex.worcester_city","ipa":"","label":"worcester_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wuster","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The city where Vernon learned of Glendower's delay, distinct from Hotspur's uncle.","id":"shakespeare014.lex.worcester_city.sense","status":"draft"}],"status":"draft","variants":[]},"9bca3c7b8ccb975452703051f54c42785c9714b5f2ead09a64c0fe77c3a37a4c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"wuster","id":"shakespeare014.lex.worcester_earl","ipa":"","label":"worcester_earl","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wuster","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Hotspur's uncle, blamed by Westmoreland for encouraging the nephew's defiance.","id":"shakespeare014.lex.worcester_earl.sense","status":"draft"}],"status":"draft","variants":[]},"44a2d207dfb5a92a77c2989642714f4afd6f829e33a44784ea97abdc9a1d8a9d":{"audioLinks":[],"citations":[{"locator":"Authored native compound: work + day","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: work + day","exampleIds":[],"headword":"d\u00c7\u00d3yel","id":"shakespeare014.lex.working_day","ipa":"","label":"working_day","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u00e3thyel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An ordinary day of labour contrasted with holiday pleasure; native work + day. No assigned weekday or Unta calendar interval.","id":"shakespeare014.lex.working_day.sense","status":"draft"}],"status":"draft","variants":[]},"e3004c6afa27bc4b215ad3f6566c62e69217a57448e6f91d84493c60e62757c6":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: labour + house","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: labour + house","exampleIds":[],"headword":"d\u00c7\u00d3z\u00e1l","id":"shakespeare014.lex.workshop","ipa":"","label":"workshop","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u00e3thz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A place where an artisan works and displays the picture; the heart\u2019s figurative painter shop.","id":"shakespeare014.lex.workshop.sense","status":"draft"}],"status":"draft","variants":[]},"f19799b9fcb3aeb3a517bdefbf0d7a39ebe0329bdc5621c12c9a34510eaaedc2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of support_pillar","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of support_pillar","exampleIds":[],"headword":"halemin\u00d7y\u00ebl","id":"shakespeare014.lex.world_pillar","ipa":"","label":"world_pillar","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"halemin\u0113y\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A supporting pillar of the world, Antony\u2019s place among the three rulers in Philo\u2019s accusation. Retains the structural metaphor without turning the figure into threefold thickness.","id":"shakespeare014.lex.world_pillar.sense","status":"draft"}],"status":"draft","variants":[]},"41d396b9376d41e351f5ff83bc4a59c31a02c1df895acf71d14c733b272c62fa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: drama_native_worm","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: drama_native_worm","exampleIds":[],"headword":"vimvor","id":"shakespeare014.lex.worm_conscience_name","ipa":"","label":"worm_conscience_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"vimvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Benedick gives the gnawing conscience the title Don Worm.","id":"shakespeare014.lex.worm_conscience_name.sense","status":"draft"}],"status":"draft","variants":[]},"8e87036637c821367c4df1bf0f4deb14ba602109a6981378b3e0ae2b63bbd303":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_wormwood","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_wormwood","exampleIds":[],"headword":"taremyel","id":"shakespeare014.lex.wormwood","ipa":"","label":"wormwood","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"taremyel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The bitter plant in the taste comparison; distinct from the named star in the historical bank.","id":"shakespeare014.lex.wormwood.sense","status":"draft"}],"status":"draft","variants":[]},"ab45bd16c7db63dbde24cd96c9b6574cff71e3a2c812527dbb1ff25b1c67eeb6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: drama_native_brewing_malt + juice","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: drama_native_brewing_malt + juice","exampleIds":[],"headword":"verzetpelnanelnil\u00ebm","id":"shakespeare014.lex.wort_malt_liquid","ipa":"","label":"wort_malt_liquid","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"verzetpelnanelnil\u00fcm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The sweet malt liquid before fermentation, included between mead and malmsey.","id":"shakespeare014.lex.wort_malt_liquid.sense","status":"draft"}],"status":"draft","variants":[]},"126a08abe2b8a712fd449f04297bbc55fd1ecb0e0d65b4f3d5bc945221b67c5b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: hold + fight","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: hold + fight","exampleIds":[],"headword":"gl\u00c9z\u00cbenhefak","id":"shakespeare014.lex.wrestle_grapple","ipa":"","label":"wrestle_grapple","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gl\u00e4zhwenhefak","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Grapple by bodily holds, Antony\u2019s loving wrestling embrace of Caesar. Native hold-fight preserves the martial affection metaphor without adding an actual hostile contest.","id":"shakespeare014.lex.wrestle_grapple.sense","status":"draft"}],"status":"draft","variants":[]},"98c9ea7d60e666c08d3835ce4c316b1676ac729b92a88ad186840473c8149c83":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of wrestle_grapple","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of wrestle_grapple","exampleIds":[],"headword":"gl\u00c9z\u00cbenhefak","id":"shakespeare014.lex.wrestle_sport","ipa":"","label":"wrestle_sport","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gl\u00e4zhwenhefak","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Bodily wrestling as a contest, Charles\u2019s occupation and the threatened bout with Orlando. Distinct from the affectionate embrace that introduced the native hold-fight compound.","id":"shakespeare014.lex.wrestle_sport.sense","status":"draft"}],"status":"draft","variants":[]},"7b2dbc5c8cf4faca5e3b0b871de3e32df2435e934b65de0099128de674a14aa7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_wrestling","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_wrestling","exampleIds":[],"headword":"hefakef","id":"shakespeare014.lex.wrestling_bout","ipa":"","label":"wrestling_bout","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakef","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An encounter in wrestling, the source try a fall. It does not assert that a particular contestant has already fallen or lost.","id":"shakespeare014.lex.wrestling_bout.sense","status":"draft"}],"status":"draft","variants":[]},"f111e70b368fe2f731bac24070879692ce0936f57709d15421f57ecba1338268":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_wring","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_wring","exampleIds":[],"headword":"tarennerda\u00c3","id":"shakespeare014.lex.wring","ipa":"","label":"wring","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tarennerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Twist or squeeze forcefully; here the youth\u2019s hand is hurt, with no implication of severing it.","id":"shakespeare014.lex.wring.sense","status":"draft"}],"status":"draft","variants":[]},"d3b0ee25b961654637579db4db2a0b45105d682b40503d0c6b002c5a5940087e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: hand + joint","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: hand + joint","exampleIds":[],"headword":"tremb\u00c5rkl\u00e1r\u00e7l\u00d7on","id":"shakespeare014.lex.wrist_joint","ipa":"","label":"wrist_joint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tremb\u0101rkl\u00f4r\u016bl\u0113on","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The joint where Posthumus fastens Imogen\u2019s bracelet. Distinguishes the bracelet on her wrist from her ring on his finger.","id":"shakespeare014.lex.wrist_joint.sense","status":"draft"}],"status":"draft","variants":[]},"fe2e97a4772e4cb9d241445b38dd9d86fb9ab4b6f99da0e056f5c568d