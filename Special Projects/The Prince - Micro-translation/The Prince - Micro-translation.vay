shakespeares-sonnets.r1"}],"definition":"Full development reached by a growing human life in Sonnet 60; nominal ripeness, without a stipulated age.","id":"shakespeare014.lex.adult_maturity.sense","status":"draft"}],"status":"draft","variants":[]},"75dde16b842da99cf4d75f3eacfda6546cb08246e062793334c835992daefc11":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_adultery","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_adultery","exampleIds":[],"headword":"zerillamprodika\u00d9","id":"shakespeare014.lex.adultery","ipa":"","label":"adultery","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zerillamprodikang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Violation of the marriage bond, in the false story Tarquin threatens to tell; not the narrator\u2019s verdict on Lucrece.","id":"shakespeare014.lex.adultery.sense","status":"draft"}],"status":"draft","variants":[]},"bc7e9a1c53ac15abb94290f772bea446c5b64d512da575e1bb53bca50743df5a":{"audioLinks":[],"citations":[{"locator":"Authored native compound: rank + rise","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: rank + rise","exampleIds":[],"headword":"arventhrenner\u00c3\u00cd","id":"shakespeare014.lex.advancement_rank","ipa":"","label":"advancement_rank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arventhrennerjzh\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Advancement in social standing or office sought by self-interested servants. Native rank + rise; does not insert a particular rank or employment contract.","id":"shakespeare014.lex.advancement_rank.sense","status":"draft"}],"status":"draft","variants":[]},"dca7d5fb58d9313e461d86e8657799079443fe4c663f37a3d9f7071a934ce