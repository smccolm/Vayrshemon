-like-it.r1"}],"definition":"The opening for a key, native key + hole, in the escaping-wit image. No modern lock mechanism is specified.","id":"shakespeare014.lex.keyhole_opening.sense","status":"draft"}],"status":"draft","variants":[]},"15a1a40aff60b09c227ba9c855f8ad9c7f5bb1b4f5bcfce1095985b6d0788abd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kildar","id":"shakespeare014.lex.kildare_irish_deputy","ipa":"","label":"kildare_irish_deputy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kildar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The Irish deputy whose removal the gentleman cites when conjecturing about Wolsey's motives.","id":"shakespeare014.lex.kildare_irish_deputy.sense","status":"draft"}],"status":"draft","variants":[]},"a580a6fbe38ae05e97c05c32ba03c3f9e1973d95a6101e4b5dc6c62a5ae11fb9":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"kilinwort","id":"shakespeare014.lex.killingworth_castle","ipa":"","label":"killingworth_castle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kilinwort","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The refuge to which Buckingham advises Henry to retire while the rebels advance.","id":"shakespeare014.lex.killingworth_castle.sense","status":"draft"}],"status":"draft","variants":[]},"16639802a24a1c43683a749aa6398f43f7803d68cc010749f07324fa2160e1ce":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: k