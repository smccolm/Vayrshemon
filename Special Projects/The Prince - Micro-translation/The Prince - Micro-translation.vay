-79","partOfSpeech":"noun","pronunciation":"lunor\u016bztjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A curved catching implement associated with bait, distinct from a suspension hook.","id":"shakespeare014.lex.hook_trap.sense","status":"draft"}],"status":"draft","variants":[]},"4ff5329cc429a9a5795e25e37436e54b52de90af4b0c4de5bea932f783ad19cd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of ring","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of ring","exampleIds":[],"headword":"viminolen","id":"shakespeare014.lex.hoop_binding","ipa":"","label":"hoop_binding","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminolen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A circular binding band holding the rulers firm together in Caesar\u2019s image. Not a numerically specified ring size or a newly implied marriage ceremony.","id":"shakespeare014.lex.hoop_binding.sense","status":"draft"}],"status":"draft","variants":[]},"739f3c8c37becdd19d02023ebc24833943180f93d157921bfe6616800417f6ee":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: hoop_binding + kjv_skirt_garment","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: hoop_binding + kjv_skirt_garment","exampleIds":[],"headword":"viminolenfelenthren","id":"shakespeare014.lex.hooped_farthingale","ipa":"","label":"hooped_farthingale","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminolenfelenthren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The hooped petticoat that Falstaff pictures framing Mistress Ford's gait.","id":"shakespeare014.lex.hooped_farthingale.sense","status":"draft"}],"status":"draft","variants":[]},"017c305793b531f173d467a396f56178436db4c9857a5a36b94eecec8e8d08b7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: jump + small","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: jump + small","exampleIds":[],"headword":"talvimin","id":"shakespeare014.lex.hop_step","ipa":"","label":"hop_step","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"talvimin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Move with short jumps on the feet, used for Cleopatra\u2019s forty paces. Native jump-small deliberately avoids relying on the inherited English-looking hopil; this new standard does not rewrite sealed older editions.","id":"shakespeare014.lex.hop_step.sense","status":"draft"}],"status":"draft","variants":[]},"6f8941f9fe067c47a84bedf95358f9fc6dcba4f5a83f2d45b9f2099ec81da6e4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hopkinz","id":"shakespeare014.lex.hopkins_chartreux_monk","ipa":"","label":"hopkins_chartreux_monk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hopkinz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The monk Buckingham names when Brandon reads the warrant.","id":"shakespeare014.lex.hopkins_chartreux_monk.sense","status":"draft"}],"status":"draft","variants":[]},"316e271b511f4683f882c681419ff6c1bb98ef7320c0232abdd17f3ad7759651":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: hop_step + dance","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: hop_step + dance","exampleIds":[],"headword":"talviminvalen","id":"shakespeare014.lex.hoppedance_fiend","ipa":"","label":"hoppedance_fiend","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"talviminvalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The named fiend Edgar hears crying in Tom's hungry belly. The native name retains both movements.","id":"shakespeare014.lex.hoppedance_fiend.sense","status":"draft"}],"status":"draft","variants":[]},"0fb5bcb0100cd0d575f704d6fb2549b3b6a6dad872d4e4fe81a553c4ebf76bae":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"horas","id":"shakespeare014.lex.horace_roman_poet","ipa":"","label":"horace_roman_poet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"horas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The Roman poet whom Holofernes attempts to cite before he notices the verses.","id":"shakespeare014.lex.horace_roman_poet.sense","status":"draft"}],"status":"draft","variants":[]},"c50969c48fb4199272957166177a1d0598abbf3df61340155e118f4672f3281d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"horatio","id":"shakespeare014.lex.horatio_scholar","ipa":"","label":"horatio_scholar","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"horatio","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakesp