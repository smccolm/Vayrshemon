 decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The strap or fitting suspending a sword. Osric's ornate carriages prompt Hamlet's cannon joke.","id":"shakespeare014.lex.sword_hanger.sense","status":"draft"}],"status":"draft","variants":[]},"83d32930dd5e03c8657a36254313c7d00f07ae803826a4ebe20dd6204d47754b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: shade + tree","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: shade + tree","exampleIds":[],"headword":"swify\u00eblverzet","id":"shakespeare014.lex.sycamore_park_tree","ipa":"","label":"sycamore_park_tree","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"swify\u00fclverzet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The tree under whose cool shade Boyet hopes to nap. No identity with the distinct biblical sycomore is imposed.","id":"shakespeare014.lex.sycamore_park_tree.sense","status":"draft"}],"status":"draft","variants":[]},"68c5d0fd3bc151ecb8828f27c09dc7b0ca020384b9460dcd8f35dc69575f1b7a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"sikoraks","id":"shakespeare014.lex.sycorax_caliban_mother","ipa":"","label":"sycorax_caliban_mother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sikoraks","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"Caliban's mother, expelled from Argier before the arrival of Prospero.","id":"shakespeare014.lex.sycorax_caliban_mother.sense","status":"draft"}],"status":"draft","variants":[]},"6026cc5d4f3c43cc07333e98f9fc8406ce66866da901163879e2c2a5e028fa9c":