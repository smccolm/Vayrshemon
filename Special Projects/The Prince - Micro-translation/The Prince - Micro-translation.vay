8115bcd384728113b8ad1223fa89376e6f0f41d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of turn","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of turn","exampleIds":[],"headword":"elyi\u00d1","id":"shakespeare014.lex.roll_native","ipa":"","label":"roll_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"elyich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Turn continuously or revolve, as eyes or a flood; reviewed rotational sense of the native turn stem, replacing undocumented rol\u00ebn.","id":"shakespeare014.lex.roll_native.sense","status":"draft"}],"status":"draft","variants":[]},"5acf0149f488a716ddf2774afc54812237f0e416203039b6c842d2692efa38fb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: corner + drama_native_alphabet_writing_sign","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: corner + drama_native_alphabet_writing_sign","exampleIds":[],"headword":"maser\u00c3\u00cdzarilj\u00cdenden","id":"shakespeare014.lex.roman_angle_letter_l","ipa":"","label":"roman_angle_letter_l","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"maserjzh\u0117rzarilj\u0117renden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The corner-shaped source letter L, also the Roman numeral for fifty. The native descriptive name refers to that foreign sign.","id":"shakespeare014.lex.roman_angle_letter_l.sense","status":"draft"}],"status":"draft","variants":[]},"50e04a5201fe5b396877d886e0890017106b4ae5afe799caa8dee49dc220d6a4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: rome + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: rome + person","exampleIds":[],"headword":"romas\u00dflum","id":"shakespeare014.lex.roman_civic_person","ipa":"","label":"roman_civic_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"romas\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A person of Rome in the contested civic identity of this play. The permitted place-name plus native person retains the designation without importing the later imperial setting or claiming a particular legal citizenship test.","id":"shakespeare014.lex.roman_civic_person.sense","status":"draft"}],"status":"draft","variants":[]},"7eb6649152eb62d41fa556c41fc4cc82fc9a45817361b5cd29f7612371ecc873":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: priest + council","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: priest + council","exampleIds":[],"headword":"prodvard\u00c7vens\u00dflumh\u00c5b\u00cdtorpgur","id":"shakespeare014.lex.roman_consistory","ipa":"","label":"roman_consistory","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodvard\u00e3vens\u014dlumh\u0101b\u0117rtorpgur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"A church court or governing council. Wolsey invokes the authority of Rome's whole consistory.","id":"shakespeare014.lex.roman_consistory.sense","status":"draft"}],"status":"draft","variants":[]},"ab786e4758c8c65640c0b39f8afda5f7e5b3bbdfa640f51c0e5ff2403acefdd2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: open + circle + bar","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Authored native derivation or sense: open + circle + bar","exampleIds":[],"headword":"\u00c5elolenzaril","id":"shakespeare014.lex.roman_open_circle_bar_g","ipa":"","label":"roman_open_circle_bar_g","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u0101elolenzaril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"A descriptive name for the Roman capital G in the prophecy. George and Gloucester share an initial in the source alphabet; their established native forms begin differently.","id":"shakespeare014.lex.roman_open_circle_bar_g.sense","status":"draft"}],"status":"draft","variants":[]},"96d6b47b9877e1824f42000306965954d3b6070920d2db1b7c17eb1d77e4cd02":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: wander + people","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: wander + people","exampleIds":[],"headword":"m\u00e5rmasers\u00dflum","id":"shakespeare014.lex.romani_source_people","ipa":"","label":"romani_source_people","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mourmasers\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The people called gypsies in the source comparison. Authored native ethnonym wander-people for this source-cultural referent, not a claim that all Romani travel or that every traveller is Romani. Source ethnonym and its outsider stereotype remain documented.","id":"shakespeare014.lex.romani_source_people.sense","status":"draft"}],"status":"draft","variants":[]},"5e2266a0f57a529a60ecb9c8c435ce102dc8d87c9c765d0636acfc058e3711ba":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_rome_acts","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_rome_acts","exampleIds":[],"headword":"roma","id":"shakespeare014.lex.rome","ipa":"","label":"rome","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"roma","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Rome as the place in the poem; retains the established place sound, without importing the Acts narrative or imperial chronology.","id":"shakespeare014.lex.rome.sense","status":"draft"}],"status":"draft","variants":[]},"fe6572b2b0af57539ad2e8930c3ff81cdc637ed5cbb7bfe50eaef98ec47f70b9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: rome","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: rome","exampleIds":[],"headword":"roma","id":"shakespeare014.lex.rome_go_jest","ipa":"","label":"rome_go_jest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"roma","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Gloucester turns Winchester's native place name for Rome into a command to go there, answering the source's Rome and roam pun.","id":"shakespeare014.lex.rome_go_jest.sense","status":"draft"}],"status":"draft","variants":[]},"7f1de5d0156fb489a27ee5d991e36e36077363fe67321e2daa368f0427f8bc73":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"rom\u00d7o","id":"shakespeare014.lex.romeo_montague_son","ipa":"","label":"romeo_montague_son","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"rom\u0113o","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"Montague's son, who marries Juliet.","id":"shakespeare014.lex.romeo_montague_son.sense","status":"draft"}],"status":"draft","variants":[]},"f55dd890b9a98d2030fe7eb6514d5004d24077a45b69b3308720a9b120cf910c":{"audioLinks":[],"citations