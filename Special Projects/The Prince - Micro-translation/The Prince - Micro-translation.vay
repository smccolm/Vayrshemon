e","status":"draft"}],"status":"draft","variants":[]},"04abbe215a15b289bab924d56723e409f32528d64c8a6e9b91253711913a732c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: keep + spirit","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: keep + spirit","exampleIds":[],"headword":"jem\u00e3swifl\u00dfn","id":"shakespeare014.lex.guardian_spirit","ipa":"","label":"guardian_spirit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jemoiswifl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The personal guardian spirit called daemon and angel by the soothsayer. Neither an evil demon nor an imported Biblical messenger; the supernatural claim belongs to the speaker.","id":"shakespeare014.lex.guardian_spirit.sense","status":"draft"}],"status":"draft","variants":[]},"f834684271af94e5769c8428f74246112961cc107fb8540ed039048de6c17389":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: small + fish","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"etymology":"Authored native derivation or sense: small + fish","exampleIds":[],"headword":"vimindrig\u00e1l","id":"shakespeare014.lex.gudgeon_fish_bait","ipa":"","label":"gudgeon_fish_bait","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vimindrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"definition":"A small easily caught fish, applied by Gratiano to the reputation for wisdom for which a silent man angles.","id":"shakespeare014.lex.gudgeon_fish_bait.sense","status":"draft"}],"status":"draft","variants":[]},"cfba400228832b1d0fdda144b76b267a590a7fbe21d91ef0c5fcdff5a1aa2d01":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: honour + gift","sourceId":"