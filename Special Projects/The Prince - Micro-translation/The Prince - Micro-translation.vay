draft","variants":[]},"89ecc3379b196f83768c94b09d6ed2b267710f28efb393ce0cf13386691788c5":{"audioLinks":[],"citations":[{"locator":"Declared native literary performance adaptation","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Declared native literary performance adaptation","exampleIds":[],"headword":"lila","id":"shakespeare014.lex.song_vocable_li","ipa":"","label":"song_vocable_li","notes":"","orthographyId":"thimfora-79","partOfSpeech":"interjection","pronunciation":"lila","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Authored native performance syllables for the song\u2019s hey refrain; not a lexical translation or historical attestation.","id":"shakespeare014.lex.song_vocable_li.sense","status":"draft"}],"status":"draft","variants":[]},"d2ef7a1739c8d2ca24faef0c6a8cc7c94d0e6b5953debea8ea16fe811972d906":{"audioLinks":[],"citations":[{"locator":"Declared native literary performance adaptation","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Declared native literary performance adaptation","exampleIds":[],"headword":"lila lilin lu","id":"shakespeare014.lex.song_vocable_lilin","ipa":"","label":"song_vocable_lilin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"interjection","pronunciation":"lila lilin lu","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Authored expanded native refrain corresponding to hey-nonny-no.","id":"shakespeare014.lex.song_vocable_lilin.sense","status":"draft"}],"status":"draft","variants":[]},"b5c18e8601b2012a3277a89b73f3123da78c1f9020f140463ba62f6bc9964d1e":{"audioLinks":[],"citations":[{"locator":"Declared native literary performance adaptation","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Declared native literary performance adaptation","exampleIds":[],"headword":"lulo","id":"shakespeare014.lex.song_