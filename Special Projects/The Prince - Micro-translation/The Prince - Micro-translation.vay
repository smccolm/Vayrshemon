urceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The stringed weapon used with arrows in Celia\u2019s remark about Orlando. Reviewed native curved-string bow; not the bodily action of bowing or the rainbow extension.","id":"shakespeare014.lex.bow_weapon.sense","status":"draft"}],"status":"draft","variants":[]},"d3f291e0e0e9e3196caa066784b12b0a37ecab909f01102558c92484e34d28b0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: roll + ball","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: roll + ball","exampleIds":[],"headword":"rol\u00ebnl\u00dfnkor","id":"shakespeare014.lex.bowls_ball","ipa":"","label":"bowls_ball","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"rol\u00fcnl\u014dnkor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The rolling ball in the game of bowls. Menenius imagines his praise overrunning its intended mark on a deceptive playing surface.","id":"shakespeare014.lex.bowls_ball.sense","status":"draft"}],"status":"draft","variants":[]},"cfc46b724d71a7017a7e8f2ae6f27004c56e1b41fe451232d0c4238888c38778":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: weight + turn","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: weight + turn","exampleIds":[],"headword":"memvorelyi\u00d1","id":"shakespeare014.lex.bowls_turning_bias","ipa":"","label":"bowls_turning_bias","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memvorelyich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The unequal weight that turns a rolling bowl aside, applied to the world's deviation from impartiality. Distinct from a bowl used as a vessel.","id":"shakespeare014.lex.bowls_turning_bias.sense","status":"draft"}],"status":"draft","variants":[]},"b2a27551bb6ea955ded67200425ca289fb73dc2b8f87e41ee549dbe81794a58f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: ship_prow + beam","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: ship_prow + beam","exampleIds":[],"headword":"meranpanenmemilvorteral","id":"shakespeare014.lex.bowsprit_forward_spar","ipa":"","label":"bowsprit_forward_spar","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"meranpanenmemilvorteral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The spar projecting forward from the ship's bow.","id":"shakespeare014.lex.bowsprit_forward_spar.sense","status":"draft"}],"status":"draft","variants":[]},"6e46f13f227de1da3f6815cf6d03edfe8d2043df81ca45d388931caaa9615a9c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"boyet","id":"shakespeare014.lex.boyet_french_courtier","ipa":"","label":"boyet_french_courtier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"boyet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The princess's envoy and companion, sent to ask for a personal audience.","id":"shakespeare014.lex.boyet_french_courtier.sense","status":"draft"}],"status":"draft","variants":[]},"7e2ddfae1380186b03d2e32ca030c84bdd5bd08635694e18f1dc956096828c1d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"brabant","id":"shakespeare014.lex.brabant_du