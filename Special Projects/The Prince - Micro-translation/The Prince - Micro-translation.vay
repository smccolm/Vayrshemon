Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The besieged place from which Tarquin departs; no invented modern location or campaign date.","id":"shakespeare014.lex.ardea.sense","status":"draft"}],"status":"draft","variants":[]},"f2d763ca70150a529a2c52ad9a7ac442dea41ce453477cef46d73d05ea7f6b02":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"arden","id":"shakespeare014.lex.arden_forest","ipa":"","label":"arden_forest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"arden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The named forest of the play. Do not force its mixed geographical references into an asserted modern location.","id":"shakespeare014.lex.arden_forest.sense","status":"draft"}],"status":"draft","variants":[]},"790db1e405dd98a08627558a7a7d85799f1ad49347363a3cf62060d6f8872544":{"audioLinks":[],"citations":[{"locator":"Authored metathesis of the existing connective horrav","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored metathesis of the existing connective horrav","exampleIds":[],"headword":"horvar","id":"shakespeare014.lex.argal_inference","ipa":"","label":"argal_inference","notes":"","orthographyId":"thimfora-79","partOfSpeech":"connective","pronunciation":"horvar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The gravedigger's affected inference, a comic transposition of horrav, therefore. Used in his mock inquest and gallows logic.","id":"shakespeare014.lex.argal_inference.sense","status":"draft"}],"status":"draft","variants":[]},"ccb5204f6b9e5841ae99336e42f26b03636b6a541ed81a102bfd36558f1eac5