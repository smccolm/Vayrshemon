the whole forehead.","id":"shakespeare014.lex.eyebrow_hair.sense","status":"draft"}],"status":"draft","variants":[]},"ddac3072c07108f2244ee24c1387035ee0df1ccda915a51c1dc45ba9cb9b96cc":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: eye + kjv_cord","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: eye + kjv_cord","exampleIds":[],"headword":"omithiril jw\u00ebnenplesten","id":"shakespeare014.lex.eyestring_band","ipa":"","label":"eyestring_band","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"omithiril jw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"An imagined cord of the eye strained by prolonged looking. Imogen would have broken these in trying to see her departing husband.","id":"shakespeare014.lex.eyestring_band.sense","status":"draft"}],"status":"draft","variants":[]},"1af72b2697e7de6fe3e7049810e840d9426ce4972a9a30345cbbeaf6fc4ac3ef":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"f\u00c5","id":"shakespeare014.lex.fa_solmization_syllable","ipa":"","label":"fa_solmization_syllable","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"f\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The foreign sung syllable fa in Peter's parallel threat. The musician answers by turning the two syllables back into notes.","id":"shakespeare014.lex.fa_solmization_syllable.sense","status":"draft"}],"status":"draft","variants":[]},"acf332f8363a6786da9a925228a43b5a88c2199c1f9a69db1787d89041115d3c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic p