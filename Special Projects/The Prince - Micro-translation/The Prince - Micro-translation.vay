ource.pericles.r1"}],"definition":"Simonides's daughter, wife of Pericles, mother of Marina. Her apparent death at sea is followed by revival at Ephesus.","id":"shakespeare014.lex.thaisa_simonides_daughter.sense","status":"draft"}],"status":"draft","variants":[]},"5922ff1d9f358e5112d2a3958f726941d7994824f20ce8394087c894e5be7214":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"thaliard","id":"shakespeare014.lex.thaliard_antiochus_agent","ipa":"","label":"thaliard_antiochus_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"thaliard","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The chamber attendant whom Antiochus supplies with poison and gold to kill Pericles.","id":"shakespeare014.lex.thaliard_antiochus_agent.sense","status":"draft"}],"status":"draft","variants":[]},"44b349dff9f83418be6ef4f1627d8f7b9ddfe54d7d9b97a6d1e76e0a4d083e41":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"temz","id":"shakespeare014.lex.thames_river","ipa":"","label":"thames_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"temz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The English river where Bates imagines himself and the king neck-deep if only they could escape the battle.","id":"shakespeare014.lex.thames_river.sense","status":"draft"}],"status":"draft","variants":[]},"42707e8c1fde7ecd277d20c8f3807c0aa305f47b266caaff24fd5c4eae140847":{"audioLinks":[],"citations":[{"locator":"Authored native derivati