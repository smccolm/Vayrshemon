n","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The French dance Mote proposes, heard by Armado as a quarrel in French.","id":"shakespeare014.lex.french_brawl_dance.sense","status":"draft"}],"status":"draft","variants":[]},"e7493aee277307a078618b3476a1c0470dfabd37703017c87e1b55e41cdc3a1e":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from mind, storm","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from mind, storm","exampleIds":[],"headword":"w\u00c5vumenenifetyeks","id":"shakespeare014.lex.frenzy_mad","ipa":"","label":"frenzy_mad","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u0101vumenenifetyeks","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Wild disordered mental excitement in the source disease catalogue; native mind-storm, not a sound-copy of frenzy.","id":"shakespeare014.lex.frenzy_mad.sense","status":"draft"}],"status":"draft","variants":[]},"c310c6efba4350d9746c319b1dea6e60613164d366fc3e00416b9b968ff9a0d5":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"wavenif","id":"shakespeare014.lex.frenzy_native","ipa":"","label":"frenzy_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wavenif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Overwhelming mental agitation; authored shortened mind/storm-family formation, replacing undocumented fren\u00ebs without claiming a historical sound change.","id":"shakespeare014.lex.frenzy_native.sense","status":"draft"}],"status":"draft","variants":[]},"9d97d15c59009dc3fc6f2d98ab8e633d8da04f9e29ff85a2070bc0212bff7b82":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from fresh, life","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from fresh, life","exampleIds":[],"headword":"nesh\u00d5\u00dfr","id":"shakespeare014.lex.fresh_vigour","ipa":"","label":"fresh_vigour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nesh\u0167h\u014dr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Living freshness/vigour, the verdure of crimson lips; does not paint them green.","id":"shakespeare014.lex.fresh_vigour.sense","status":"draft"}],"status":"draft","variants":[]},"43005f1a8ac4388e350665b294b6ee82ae637af68acef3ac51ae1b14d036a532":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"thirkel","id":"shakespeare014.lex.fret_music","ipa":"","label":"fret_music","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thirkel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A fitting that determines a vibrating string\u2019s speaking length on an instrument; authored string-family term, distinct from anxious fretting.","id":"shakespeare014.lex.fret_music.sense","status":"draft"}],"status":"draft","variants":[]},"cf54a52c975623b7cc3918cfb28c54aa7e286f6a3a29e500511607c05d823a34":{"audioLinks":[],"citations":[{"locator":"Authored source-calendar label: Unta spoken ordinal plus day; not a native-calendar equivalence.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored source-calendar label: Unta spoken ordinal plus day; not a native-calendar equivalence.","exampleIds":[],"headword":"\u00dfd\u00d7um\u2019t yel","id":"shakespeare014.lex.friday_source","ipa":"","label":"friday_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u014dd\u0113um\u2019t yel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Friday in the source English seven-day week. Authored native calendar label using Unta word ordinal six + day, with Sunday explicitly the first day of this source-calendar convention. Not the sixth day of an invented Vayrshemon calendar or six Fridays; no foreign weekday sound is borrowed.","id":"shakespeare014.lex.friday_source.sense","status":"draft"}],"status":"draft","variants":[]},"1309f6c70ec0263f5203800802a0d3d01484e16e666d9f428443cd9c81ff3674":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: friend","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: friend","exampleIds":[],"headword":"nemir","id":"shakespeare014.lex.friend_intimate","ipa":"","label":"friend_intimate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nemir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A lover or intimate, the sense Posthumus sets against adorer and Iachimo takes up in his reply. The supplied text reads friend in both places.","id":"shakespeare014.lex.friend_intimate.sense","status":"draft"}],"status":"draft","variants":[]},"bb6e6df4c66a328ae88f7047a7b9b6798183a60291faf27da75fe271234cc8ca":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: rough + wool_material","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: rough + wool_material","exampleIds":[],"headword":"krathsh\u00ebralf\u00ebl","id":"shakespeare014.lex.frieze_rough_wool","ipa":"","label":"frieze_rough_wool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"krathsh\u00fcralf\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"A coarse woolen cloth. Iago likens extracting an invention from his head to pulling birdlime from its fibers.","id":"shakespeare014.lex.frieze_rough_wool.sense","status":"draft"}],"status":"draft","variants":[]},"14e5ee844d9096e76a31c7e12a16f3556d01153c74b8d9f568fc6c0707251cac":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_fringe","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_fringe","exampleIds":[],"headword":"felenthiril","id":"shakespeare014.lex.fringe_clothing","ipa":"","label":"fringe_clothing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"felenthiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Threads or trimming at a garment edge. Promoted native garment-fringe form for the forest-edge/petticoat simile, without importing the earlier historical verse\u2019s ritual instruction.","id":"shakespeare014.lex.fringe_clothing.sense","status":"draft"}],"status":"draft","variants":[]},"477314f837c8dfdfc3aa72434f3d77976661404205884103cb84106e231d4e3b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"frits","id":"shakespeare014.lex.fritz_may_dancer","ipa":"","label":"fritz_may_dancer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"frits","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"One of the five countrywomen who enter to dance in the local witness.","id":"shakespeare014.lex.fritz_may_dancer.sense","status":"draft"}],"status":"draft","variants":[]},"4ef904bcd3b7d5736e6ca13acdfd92c8fe8c7cc39d13f684540bc526e4640ed4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_frog + bog","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: kjv_frog + bog","exampleIds":[],"headword":"yems\u00d7talbog\u00ebn","id":"shakespeare014.lex.frogmore_windsor_fields","ipa":"","label":"frogmore_windsor_fields","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"yems\u0113talbog\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The wet ground near Windsor where the duellists are brought together. The source name is rendered with the native frog and bog roots.","id":"shakespeare014.lex.frogmore_windsor_fields.sense","status":"draft"}],"status":"draft","variants":[]},"3e04e4759e76b2fc509997bad475c33c698b6945a3e8c1d9fb3abc651df13093":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"frwasar","id":"shakespeare014.lex.froissart_chronicler","ipa":"","label":"froissart_chronicler","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"frwasar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Chronicler whom Alanson cites about the English heroes.","id":"shakespeare014.lex.froissart_chronicler.sense","status":"draft"}],"status":"draft","variants":[]},"e47c2b85548be7cc873d9a66537606ed0a2ae93fcb8541ec1cbba5f9cc9a9565":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: cold + dew","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: cold + dew","exampleIds":[],"headword":"t\u00e9znivil","id":"shakespeare014.lex.frost_native","ipa":"","label":"frost_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"t\u00e9znivil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Frozen surface moisture or a frost episode; authored cold-dew compound avoiding the ungrounded frost-like form in an older entry. Older sealed books are untouched.","id":"shakespeare014.lex.frost_native.sense","status":"draft"}],"status":"draft","variants":[]},"4a6ad4e22d2f62e657c264e8f5103d870b7958129977dc2593436c2d8895890d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: foam","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: foam","exampleIds":[],"headword":"yems\u00d7pulen","id":"shakespeare014.lex.froth_vienna_gentleman","ipa":"","label":"froth_vienna_gentleman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"yems\u0113pulen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The gentleman brought in by Elbow. His airy name hints at insubstantiality.","id":"shakespeare014.lex.froth_vienna_gentleman.sense","status":"draft"}],"status":"draft","variants":[]},"086e21b497d51364040afc90c87f351b132ff19d91d7ed01e861212f6701df5f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: fruit + give","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author