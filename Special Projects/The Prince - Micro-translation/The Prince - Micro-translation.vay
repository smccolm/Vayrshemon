rtOfSpeech":"noun","pronunciation":"braj\u0117ren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"A consonant contrasted with the five cited source vowel letters.","id":"shakespeare014.lex.consonant_school_sound.sense","status":"draft"}],"status":"draft","variants":[]},"f1e28163e5174336128017efb9c57a2dc831c7c2c4cddf376dedd2f4cff9c166":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: eye + judge + view","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: eye + judge + view","exampleIds":[],"headword":"ominerbw\u00c5vumeno\u00c3","id":"shakespeare014.lex.conspectuity_pomp","ipa":"","label":"conspectuity_pomp","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ominerbw\u0101vumenojzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A deliberately ponderous native eye-judgment-view for the comic conspectuities, prefaced by blind in Menenius\u2019s insult. Local rhetorical coinage, not a newly productive grammatical ending.","id":"shakespeare014.lex.conspectuity_pomp.sense","status":"draft"}],"status":"draft","variants":[]},"c12f148b0d4028f26203435b4a80bd1cae172e8c114b712a9bed4b89aeb4278c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: secret + plan + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: secret + plan + person","exampleIds":[],"headword":"o\u00c3brenp\u00e1ns\u00ebrs\u00dflum","id":"shakespeare014.lex.conspirator_plotter","ipa":"","label":"conspirator_plotter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ojzhbrenp\u00f4ns\u00fcrs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A member of the faction secretly planning the death of Coriolanus.","id":"shakespeare014.lex.conspirator_plotter.sense","status":"draft"}],"status":"draft","variants":[]},"b4387f50f7bc3b41d7056b06f23cd0fb4b16ac80efd70bb5aabcfba7acbf127a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"konstans","id":"shakespeare014.lex.constance_arthur_mother","ipa":"","label":"constance_arthur_mother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"konstans","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Widow of Geoffrey who seeks her son Arthur's inheritance.","id":"shakespeare014.lex.constance_arthur_mother.sense","status":"draft"}],"status":"draft","variants":[]},"b199d190c068753a2b6c9bc7cb1e4d66123786f5f96b2e497be00df77c7feddd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"konstantin","id":"shakespeare014.lex.constantine_emperor","ipa":"","label":"constantine_emperor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"konstantin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The emperor whose mother Helen is named by Charles.","id":"shakespeare014.lex.constantine_emperor.sense","status":"draft"}],"status":"draft","variants":[]},"ff734975994b05b246d9bb643db29e1c91a6733e08f8f59e0708e6de8868dc0d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"konstantinopol","id":"shakespeare014.lex.constantinople_city","ipa":"","label":"constantinople_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"konstantinopol","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The city Henry imagines a future child reaching.","id":"shakespeare014.lex.constantinople_city.sense","status":"draft"}],"status":"draft","variants":[]},"8da1f36b4c4b367dd5e1f8ed4efc2ebaa809ab4512cd4804e84052dadcd03e60":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"nerbvar","id":"shakespeare014.lex.consul_office","ipa":"","label":"consul_office","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerbvar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The Roman consular magistracy contrasted with monarchy. Authored compact native choose-rule formation; no Latin sound loan and no extra office count inserted into the source.","id":"shakespeare014.lex.consul_office.sense","status":"draft"}],"status":"draft","variants":[]},"aee48e16bc9fb94dd2b4f2f57589a834f92b791f6aedd81499140264056c8a26":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: contagious","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: contagious","exampleIds":[],"headword":"murenstrasf\u00c5w","id":"shakespeare014.lex.contagion_disease","ipa":"","label":"contagion_disease","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murenstrasf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Communicable affliction in Martius\u2019s south-wind curse, nominal use of native illness-spread. No modern pathogen or actual outbreak is asserted.","id":"shakespeare014.lex.contagion_disease.sense","status":"draft"}],"status":"draft","variants":[]},"0bf7ade82edfcdb3197cb506c5e694522f93cca9b59687651477f0948430f790":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of score","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of score","exampleIds":[],"headword":"kerel","id":"shakespeare014.lex.contest_goal","ipa":"","label":"contest_goal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kerel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A success scored in a contest, Antony\u2019s goal-for-goal comparison with youth. Native tally sense; not an explicit quantity of twenty or a modern sporting rule.","id":"shakespeare014.lex.contest_goal.sense","status":"draft"}],"status":"draft","variants":[]},"375fb00f6ae1210dfa0995c5bb291a0356817d372e9deb08830c96552e8d6fbf":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of enclosure","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of enclosure","exampleIds":[],"headword":"\u00e7l\u00d7ono\u00c3t\u00e7","id":"shakespeare014.lex.continent_container","ipa":"","label":"continent_container","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u016bl\u0113onojzht\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The enclosure of the heart, Antony\u2019s body as its continent. Not a geographical continent or a chastity adjective.","id":"shakespeare014.lex.continent_container.sense","status":"draft"}],"status":"draft","variants":[]},"50173472743b5880469ee448247cf3be8e023039e610d33f29a5441f3fd12aaa":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of endure","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of endure","exampleIds":[],"headword":"dlen\u00dbeminvenor","id":"shakespeare014.lex.continuance","ipa":"","label":"continuance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlensheminvenor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The passing duration that tames old grief; nominal extension of endure.","id":"shakespeare014.lex.continuance.sense","status":"draft"}],"status":"draft","variants":[]},"e15c21fc863856ae1cd5dc6ea3bb001abc1b0cc8289fabf91155b20c7d3ac25e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: against + say","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: against + say","exampleIds":[],"headword":"zethtonda","id":"shakespeare014.lex.contradiction_opposition","ipa":"","label":"contradiction_opposition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zethtonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Spoken opposition in Brutus\u2019s description of Coriolanus having his full portion of contradiction. Native against-say; preserves the supplied worth reading rather than silently emending it to word.","id":"shakespeare014.lex.contradiction_opposition.sense","status":"draft"}],"status":"draft","variants":[]},"48e24bb3896515d1bb15fba6ef39dd271afc0bfa72e79417fea3607624bf7b69":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_gainsay_romans","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_gainsay_romans","exampleIds":[],"headword":"zethtonda","id":"shakespeare014.lex.contradiction_speech","ipa":"","label":"contradiction_speech","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zethtonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An opposing assertion, which Lepidus claims he has not heard about the pyramids. Native against-say used nominally; no religious disobedience imported.","id":"shakespeare014.lex.contradiction_speech.sense","status":"draft"}],"status":"draft","variants":[]},"1289e6344ca64cc9955bcc33f6fcebb3153d3dd63f25f6b91e7902e8ff8426ae":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_contrite","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_contrite","exampleIds":[],"headword":"gr\u00c9tswifl\u00dfn","id":"shakespeare014.lex.contrite","ipa":"","label":"contrite","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"gr\u00e4tswifl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Crushed or deeply sorrowful in spirit, Lucrece\u2019s sighs; not a new admission of culpability.","id":"shakespeare014.lex.contrite.sense","status":"draft"}],"status":"draft","variants":[]},"b8cd3d09f212ad80f316b247c132309827a6bfbef9e784e098f76079acfad52c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: quarrel","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: quarrel","exampleIds":[],"headword":"\u00e5\u00d1hefak","id":"shakespeare014.lex.controversy_dispute","ipa":"","label":"controversy_dispute","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ouchhefak","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The contested matter before the tribunes, personified as bleeding after their mishandling. Not a new separate fight on stage.","id":"shakespeare014.lex.controversy_dispute.sense","status":"draft"}],"status":"draft","variants":[]},"767f281c36acb13fae517a45b96f18ffdba73d6f94e58ce16328ca43c4eb2d1f":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of change","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of change","exampleIds":[],"headword":"\u00e3lum","id":"shakespeare014.lex.conversion_change","ipa":"","label":"conversion_change","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"oilum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A change of character or moral disposition, Oliver\u2019s claimed conversion. Native change as a nominal sense; no unstated baptism, creed or separate new person is invented.","id":"shakespeare014.lex.conversion_change.sense","status":"draft"}],"status":"draft","variants":[]},"ee355bd9cba0f47db5e3c297d1f55b0bde8878aa6f7b4276cd58746d585019fd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: violent + illness","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: violent + illness","exampleIds":[],"headword":"jorgorplestenmuren","id":"shakespeare014.lex.convulsive_fit","ipa":"","label":"convulsive_fit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jorgorplestenmuren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A violent attack or convulsive episode used as an image for the political crisis. Native violent-illness; not suitedness and not a diagnosis of an actual person.","id":"shakespeare014.lex.convulsive_fit.sense","status":"draft"}],"status":"draft","variants":[]},"df683f851730fdb648a29417a80a0d5413e3b10a56eabebe7c58c82f058289f9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: cook + art","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: cook + art","exampleIds":[],"headword":"n\u00ddjw\u00ebnh\u00c5b\u00cd","id":"shakespeare014.lex.cooking_art","ipa":"","label":"cooking_art","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u012bjw\u00fcnh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Preparation of food as a practiced skill, the Egyptian cookery whose reputation Pompey praises with an erotic insinuation. Not a cookbook or inserted recipe.","id":"shakespeare014.lex.cooking_art.sense","status":"draft"}],"status":"draft","variants":[]},"20504d84231aa30455c29be42caf911116f99a24866a669cc1790da2f2f0fcc9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_pot","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_pot","exampleIds":[],"headword":"borem","id":"shakespeare014.lex.cooking_pot","ipa":"","label":"cooking_pot","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"borem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A cooking vessel in the soldiers\u2019 to-the-pot destruction idiom; native pot category, not an assertion that Martius is literally cooked.","id":"shakespeare014.lex.cooking_pot.sense","status":"draft"}],"status":"draft","variants":[]},"2214927223a73026fff5a229a2470c7e84cf4d890ead3ca42c55df60627eb3ac":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adap