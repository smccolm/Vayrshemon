]},"997324f29340335d1d04c7d1d6392cac5270a396e6cf08b5151f6c7bf3a74a5e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: hold + land","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: hold + land","exampleIds":[],"headword":"gl\u00c9z\u00cbenjo\u00d9","id":"shakespeare014.lex.demesne_lands","ipa":"","label":"demesne_lands","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gl\u00e4zhwenjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The grounds Belarius calls his world during exile. Possession in the speech does not confer a legal title.","id":"shakespeare014.lex.demesne_lands.sense","status":"draft"}],"status":"draft","variants":[]},"08388a5d8809d30c2633322294d89ef711852eeb751fb3d4d91956432b38031c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of demetrius","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of demetrius","exampleIds":[],"headword":"demetriw","id":"shakespeare014.lex.demetrius_roman","ipa":"","label":"demetrius_roman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"demetriw","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The Roman who speaks with Philo in Antony and Cleopatra. Distinct semantic identity from the Athenian lover in Midsummer, despite the shared name form.","id":"shakespeare014.lex.demetrius_roman.sense","status":"draft"}],"status":"draft","variants":[]},"87d15e37b1d9430c1f09ad593ec33469fceef4a1544bd7aec98b2e6ebdcfb7b6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exam