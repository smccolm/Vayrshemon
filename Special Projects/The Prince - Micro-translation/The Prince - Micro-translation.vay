.r1"}],"definition":"Another person\u2019s grief reflected into the hearer\u2019s heart, Dolabella\u2019s sympathetic rebound. Figurative extension of a returning echo, not a literal sound or physical collision.","id":"shakespeare014.lex.rebound_sympathy.sense","status":"draft"}],"status":"draft","variants":[]},"c7fa62f558653d6fb5c098d4fa82210e4f066fdaf20de2f3d0ad00ab999d3cde":{"audioLinks":[],"citations":[{"locator":"Grumio's question about a supposed insult","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Grumio's question about a supposed insult","exampleIds":[],"headword":"murmalet\u00e5v","id":"shakespeare014.lex.rebused_grumio_slip","ipa":"","label":"rebused_grumio_slip","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murmaletouv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Grumio mispronounces the ordinary verb for abusing someone.","id":"shakespeare014.lex.rebused_grumio_slip.sense","status":"draft"}],"status":"draft","variants":[]},"7ee805ef0c83891da0881d0bebbea4e67b82355dc26f8115f74670ad99a6d016":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: return + permit","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: return + permit","exampleIds":[],"headword":"sezif\u00c7\u00c3\u00c3ah","id":"shakespeare014.lex.recall_from_exile","ipa":"","label":"recall_from_exile","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sezif\u00e3jzhjzhah","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Permission to return from banishment, source repeal in Cominius\u2019s proposed plan. Native return-permit; distinct from remembering something or repealing an unspecified law.","id":"shakespeare014.lex.recall_from_exile.sense","status":"draft"}],"status":"draft","variants":[]},"4ffa02e7160be94ba2d56d6cce11c8d143ce603e2d37d595dc8ce2e6f77fcd21":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: receive + treat","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: receive + treat","exampleIds":[],"headword":"mlapv\u00d7staf\u00d7r\u00c7n\u00d3","id":"shakespeare014.lex.reception_treatment","ipa":"","label":"reception_treatment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mlapv\u0113staf\u0113r\u00e3nth","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The treatment given to an arriving person, source entertainment in Coriolanus\u2019s judgment of his unwelcome arrival. Native receive-treat; distinct from amusement and from military employment in the previous scene.","id":"shakespeare014.lex.reception_treatment.sense","status":"draft"}],"status":"draft","variants":[]},"c96f252293c6ca6b83a88c03496f724c4476cb0bab1ddc61283bff60269adb95":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: return + horn + call","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: return + horn + call","exampleIds":[],"headword":"sezif\u00c7\u00c3kraner\u00d3\u00c5\u00e7","id":"shakespeare014.lex.recheat_return_call","ipa":"","label":"recheat_return_call","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sezif\u00e3jzhkranerth\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The hunting call sounded on the horn to bring the hounds back.","id":"shakespeare014.lex.recheat_return_call.sense","status":"draft"}],"status":"draft","variants":[]},"2c2b3369e07e47ba87f8bc6b460ee60b3b6a7a18cdea84b4ae6d33be6e92cdf8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: reckon","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: reckon","exampleIds":[],"headword":"taren","id":"shakespeare014.lex.reckon_as","ipa":"","label":"reckon_as","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"taren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Account or judge something to be so, including reckoning the song wasted time. Not a noble count.","id":"shakespeare014.lex.reckon_as.sense","status":"draft"}],"status":"draft","variants":[]},"9f9803c5dca0cd7efe529d77c16312290dbc27768466332db0f255f7ef3b9fb5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of reckon","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of reckon","exampleIds":[],"headword":"taren","id":"shakespeare014.lex.reckoning","ipa":"","label":"reckoning","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"taren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"An accounting of what has been received and returned; not the homonymous noble rank.","id":"shakespeare014.lex.reckoning.sense","status":"draft"}],"status":"draft","variants":[]},"97efcc6c0232c4cf8d3034da9caad2804130fbcadb18d4f08d99667529a176b4":{"audioLinks":[],"citations":[{"locator":"Authored native compound: reckon + token","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: reckon + token","exampleIds":[],"headword":"tarenden","id":"shakespeare014.lex.reckoning_counter","ipa":"","label":"reckoning_counter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarenden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A token used for reckoning, offered as a trivial wager by Jaques. Native reckon + token; not a serving surface or an assigned cash amount.","id":"shakespeare014.lex.reckoning_counter.sense","status":"draft"}],"status":"draft","variants":[]},"9310eb7d506a6b9a5fca618a92f67714cc3e20ba5438d08715744a757a1ea7db":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of reckoning","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of reckoning","exampleIds":[],"headword":"taren","id":"shakespeare014.lex.reckoning_mark","ipa":"","label":"reckoning_mark","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"taren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Counts or visible tallies left by personified Fortune on Pompey\u2019s face. Native accounting sense, not the noble title count and not a newly invented count of scars.","id":"shakespeare014.lex.reckoning_mark.sense","status":"draft"}],"status":"draft","variants":[]},"5f8ba7afcb38680064d001f846c25f889f796ab161d5aabfbeda120b05624afe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: court + bond","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: court + bond","exampleIds":[],"headword":"var\u00dfnkinkl\u00e1rjem","id":"shakespeare014.lex.recognizance_bond","ipa":"","label":"recognizance_bond","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnkinkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"An obligation acknowledged in court, in the list of the land buyer's instruments.","id":"shakespeare014.lex.recognizance_bond.sense","status":"draft"}],"status":"draft","variants":[]},"c8dca36168727ca1870a67c1c362d249dcac0e6154cac4de045ee55d54dbda81":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_reconcile_relation","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_reconcile_relation","exampleIds":[],"headword":"ilkomtarf\u00c5w","id":"shakespeare014.lex.reconcile_people","ipa":"","label":"reconcile_people","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ilkomtarf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Bring estranged people into agreement, source atone in Maecenas\u2019s mediation. Distinct from ritual expiation; no sacrificial doctrine or unprinted agent is introduced.","id":"shakespeare014.lex.reconcile_people.sense","status":"draft"}],"status":"draft","variants":[]},"ea21534f46144cf3c037f7aa25ee2f8aff9ca8bf8abcabbee25ba8cdcbf9b447":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of record","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of record","exampleIds":[],"headword":"int\u00dff\u00c9ben","id":"shakespeare014.lex.record_register","ipa":"","label":"record_register","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"int\u014df\u00e4ben","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A written record in which the world may class Enobarbus; the action record used nominally, not a new bureaucratic office.","id":"shakespeare014.lex.record_register.sense","status":"draft"}],"status":"draft","variants":[]},"531ff9516c7ba51cd73d3dc075c26a9fa22c6f24bf06496c2715d45a440a4f69":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: town + lawyer","sourceId":"shakespeare014.source.richard-iii.r1"}],