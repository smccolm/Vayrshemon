:"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The pearl-bearing shellfish of Antony\u2019s gift metaphor. Native pearl-shell cultural designation; no claim that every oyster yields a pearl or that the poem identifies a modern species.","id":"shakespeare014.lex.oyster_shellfish.sense","status":"draft"}],"status":"draft","variants":[]},"8f017c01b9cbb1191fca1ade48f1fab496a63487770ebe4163813b20284c761a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"peis","id":"shakespeare014.lex.pace_former_secretary","ipa":"","label":"pace_former_secretary","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"peis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The learned doctor who previously held Gardiner's office. Campeius reports what people say about his service abroad.","id":"shakespeare014.lex.pace_former_secretary.sense","status":"draft"}],"status":"draft","variants":[]},"6d28363a6c90830c41ce43a1d7e288e0a7a233734e06f8483be4497aadca98f4":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: burden + horse","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: burden + horse","exampleIds":[],"headword":"darumthal","id":"shakespeare014.lex.packhorse","ipa":"","label":"packhorse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"darumthal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A horse bearing loads, figuratively Time carrying sin; no modern transport substitution.","id":"shakespeare014.lex.packhorse.sense","status":"draft"}],"status":"draft","variants":[]},"4b54f70fa7f91114b692072cc77ec70a301ecf61b3d968d48c8c7d9feea28e29":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: burden + saddle","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: burden + saddle","exampleIds":[],"headword":"darum\u00e5v\u00d1et\u00c7piba","id":"shakespeare014.lex.packsaddle_load","ipa":"","label":"packsaddle_load","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"darumouvchet\u00e3piba","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A saddle supporting a carried load rather than a rider, the donkey\u2019s packsaddle in the beard-burial insult.","id":"shakespeare014.lex.packsaddle_load.sense","status":"draft"}],"status":"draft","variants":[]},"d7d26208e764945085d9391748e7ebdce2afde2490ec7e2981c18f597c2cca07":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"pakorus","id":"shakespeare014.lex.pacorus_prince","ipa":"","label":"pacorus_prince","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pakorus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Pacorus, whose dead body precedes Ventidius in the triumph-like entrance; identified in the speech as Orodes\u2019s son. No new person is introduced by an internal identity label.","id":"shakespeare014.lex.pacorus_prince.sense","status":"draft"}],"status":"draft","variants":[]},"56ea39b07b1fa3fdf6e49a299f49c89906864777385b315155eca0f2e66b1ad2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: toad","sourceId":"shakespeare014.source.macbeth.r1