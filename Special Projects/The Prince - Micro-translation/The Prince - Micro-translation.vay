n","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"A flexible sword that can be bent hilt to point, unlike the restraint called bilboes.","id":"shakespeare014.lex.bilbo_flexible_sword.sense","status":"draft"}],"status":"draft","variants":[]},"0b99cf75bd0d9b4ac007502916e354af552743bdd40b054d18d490c455f3b3e8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: foot + fetter","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: foot + fetter","exampleIds":[],"headword":"paleszernkl\u00e1rjem","id":"shakespeare014.lex.bilbo_iron","ipa":"","label":"bilbo_iron","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"paleszernkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A shipboard restraint fastening the legs of mutineers, used in Hamlet's account of his unrest.","id":"shakespeare014.lex.bilbo_iron.sense","status":"draft"}],"status":"draft","variants":[]},"cf20947053119a177b3ef1d1b3861a65016cff08bd26cb465b285bdc17d09148":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kiss","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kiss","exampleIds":[],"headword":"melomi","id":"shakespeare014.lex.bill_caress","ipa":"","label":"bill_caress","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melomi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Birds touching or rubbing their bills in paired caress, native kiss as an explicit animal-action extension. Not a financial bill, a weapon or a new courtship claim about all birds.","id":"shakespeare014.lex.bill_caress.sense","status":"draft"}],"status":"draft","variants":[]},"32fca92c43959e02f03feae6166618e8dfa5767d08ea2138ef79c54abfaea5f7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of proclamation","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of proclamation","exampleIds":[],"headword":"oltonda","id":"shakespeare014.lex.bill_public_notice","ipa":"","label":"bill_public_notice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"oltonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A written public notice, the written sense of bills invoked by Rosalind\u2019s formal announcement. The English weapon/notice homonym is recorded as a wordplay loss, not silently assigned to the native notice root.","id":"shakespeare014.lex.bill_public_notice.sense","status":"draft"}],"status":"draft","variants":[]},"d53e500d1c53b6688e2a3d2fd555c4fe69777d5e8e692af2e9bfd95d1fae6009":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: name + write","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: name + write","exampleIds":[],"headword":"den\u00ddv","id":"shakespeare014.lex.billet_enrol","ipa":"","label":"billet_enrol","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"den\u012bv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Enter names separately in a military list, source distinctly billeted. Native name-write; does not assume the troops are assigned lodgings in this passage.","id":"shakespeare014.lex.billet_enrol.sense","status":"draft"}],"status":"draft","variants":[]},"b191f6b53bf3afa2816c2fbd26191f7c22f503afc2a4b25cd0651e969828c045":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: ball + rod","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: ball + rod","exampleIds":[],"headword":"l\