rthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nikander","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The person asked to bring the satin coffin during the storm.","id":"shakespeare014.lex.nicander_ship_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"1afeec10a8ec72db5af0bad1915bfc1ff2831fbd5888ce2e2b6c2663b1392070":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nikanor","id":"shakespeare014.lex.nicanor_roman","ipa":"","label":"nicanor_roman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nikanor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The Roman informant in Coriolanus4.3, not the separately retained biblical Nicanor; no identity suffix prints.","id":"shakespeare014.lex.nicanor_roman.sense","status":"draft"}],"status":"draft","variants":[]},"90c7279ee1969d447d0c4722a2dbb06c95dec7cb13f4d41610c150c7bdfd9415":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nikolas","id":"shakespeare014.lex.nicholas_gawsey","ipa":"","label":"nicholas_gawsey","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nikolas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Given name of the knight calling for assistance, distinct from Saint Nicholas.","id":"shakespeare014.lex.nicholas_gawsey.sense","status":"draft"}],"status":"draft","variants":[]},"31cade26ce5