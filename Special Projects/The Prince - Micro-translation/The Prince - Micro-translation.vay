":"draft","variants":[]},"dfdeea17dc8027cd31949b7ec02460a506c108ed72e287c98775f636062ac7bb":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nel","id":"shakespeare014.lex.nell_poins","ipa":"","label":"nell_poins","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Poins's sister in the marriage story told in Falstaff's letter.","id":"shakespeare014.lex.nell_poins.sense","status":"draft"}],"status":"draft","variants":[]},"2ac26fff999e1cbdbdc16d1d7ac0d60904db761f4ec35520e680fc9c4c330379":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nel","id":"shakespeare014.lex.nell_quickly","ipa":"","label":"nell_quickly","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The hostess Quickly's given name in this play, distinct from Poins's sister Nell.","id":"shakespeare014.lex.nell_quickly.sense","status":"draft"}],"status":"draft","variants":[]},"2f4d42de19590238d5c7d1ef56e572986cd7a2cb8538452d296ff498822fadf4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nel","id":"shakespeare014.lex.nell_verona_guest","ipa":"","label":"nell_verona_guest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The woman to be admitted with Susan Grindstone.","id":"shakespeare014.lex.nell_verona_guest.sense","status":"draft"}],"status":"draft","variants":[]},"5eaa23fc3491e2cb496d77dd7c633884554298625c8c244a30b158d83e80d4f4":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"nemea","id":"shakespeare014.lex.nemea_place","ipa":"","label":"nemea_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nemea","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The place identifying the lion of the heroic comparison, rather than a personal name for that lion.","id":"shakespeare014.lex.nemea_place.sense","status":"draft"}],"status":"draft","variants":[]},"4770e0c9f1e2b93216c0bd1caeb3edcbd6709ab265aa0a4a27f447f40d66fd6c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nemesis","id":"shakespeare014.lex.nemesis_avenger","ipa":"","label":"nemesis_avenger","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nemesis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The avenging power to which Lucy compares the elder Talbot.","id":"shakespeare014.lex.nemesis_avenger.sense","status":"draft"}],"status":"draft","variants":[]},"da76300ebe7c87e652e78edfb2ee73e3c2b7d0dd76db614b5f676762ea4c2e2b":{"audioLinks":[],"citations":[{"locator":"Author-permitted