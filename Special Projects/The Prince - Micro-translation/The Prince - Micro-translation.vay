"status":"draft"}],"status":"draft","variants":[]},"3abbb5479d562046befdeb75bcbbf01b46ce4c4113f4a40406a3fd55afb21310":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_syracuse_acts + person","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: kjv_syracuse_acts + person","exampleIds":[],"headword":"sirakuss\u00dflum","id":"shakespeare014.lex.syracusan_dramatic_citizen","ipa":"","label":"syracusan_dramatic_citizen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sirakuss\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"A native of Syracuse in the play's reciprocal ban on trade. Reuses the sealed place name.","id":"shakespeare014.lex.syracusan_dramatic_citizen.sense","status":"draft"}],"status":"draft","variants":[]},"9d0f5994e38d962c63d2237530814597d032dbd51d3b9af99f6415938a95428c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_syria","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_syria","exampleIds":[],"headword":"siria","id":"shakespeare014.lex.syria_region","ipa":"","label":"syria_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"siria","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Syria in the messenger\u2019s route of conquest. The source name is retained without modern borders.","id":"shakespeare014.lex.syria_region.sense","status":"draft"}],"status":"draft","variants":[]},"12c3f5da3d564ebf4a8896ace00e39813718ee41b7007c2b476e5036d2a1e8de":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: small + drum","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: small + drum","exampleIds":[],"headword":"viminshalemson","id":"shakespeare014.lex.tabor_small_drum","ipa":"","label":"tabor_small_drum","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminshalemson","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The small drum contrasted with thunder in Cominius\u2019s recognition of Martius\u2019s voice. Native small-drum; no invented rhythm or performer.","id":"shakespeare014.lex.tabor_small_drum.sense","status":"draft"}],"status":"draft","variants":[]},"42afa09df2eec049124db2b0774e8aaac28fd1db4d7bcbc3debf3d34e4a78868":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: tabor_small_drum + man","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: tabor_small_drum + man","exampleIds":[],"headword":"viminshalemsons\u00dflum","id":"shakespeare014.lex.taborer_morris_musician","ipa":"","label":"taborer_morris_musician","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminshalemsons\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The performer on the small drum, called Timothy by one of the countrymen.","id":"shakespeare014.lex.taborer_morris_musician.sense","status":"draft"}],"status":"draft","variants":[]},"0cba20130ddfca5c612bf8d7da6c6635be221e6ef8d1ebd40b4109af2f18c65d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of drum","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of drum","exampleIds":[],"headword":"shalemson","id":"shakespeare014.lex.taborin_drum","ipa":"","label":"taborin_drum","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"shalemson","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The small marching drum whose rattling sound mingles with the trumpets; native drum term, with the supplied subtype retained in the gloss.","id":"shakespeare014.lex.taborin_drum.sense","status":"draft"}],"status":"draft","variants":[]},"e4c5ad5de2c25a083acfd6728bc0ae9d32f6915d279d357ffd0064f70a285055":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_frog + drama_native_young","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Authored native derivation or sense: kjv_frog + drama_native_young","exampleIds":[],"headword":"yems\u00d7talpelna","id":"shakespeare014.lex.tadpole_frog_young","ipa":"","label":"tadpole_frog_young","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113talpelna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"A frog\u2019s young, used by Demetrius as an insult for the infant.","id":"shakespeare014.lex.tadpole_frog_young.sense","status":"draft"}],"status":"draft","variants":[]},"3a56386b0baab08970f6564ae6bdc5d52a317dfef57195d9877f8ab91ec94186":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: smooth + silk","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: smooth + silk","exampleIds":[],"headword":"siv\u00eblshilin","id":"shakespeare014.lex.taffeta_silk","ipa":"","label":"taffeta_silk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"siv\u00fclshilin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The silk fabric of the young woman's flame-colored dress in Hal's imagined sun.","id":"shakespeare014.lex.taffeta_silk.sense","status":"draft"}],"status":"draft","variants":[]},"32f83f6ca1e901694ff9519920835ff0751de357339df6f05e5c14aba8d89ad0":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from chase, play","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from chase, play","exampleIds":[],"headword":"h\u00ebthterastfaln","id":"shakespeare014.lex.tag_game","ipa":"","label":"tag_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"h\u00fcthterastfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Base/prisoner\u2019s-base as the chasing game challenged by the horse to the wind; not lowliness, a pedestal or a numeral base.","id":"shakespeare014.lex.tag_game.sense","status":"draft"}],"status":"draft","variants":[]},"d2870bde8d39de610e831a5c46abe1aeae96f123df2cc3568d87946434cd6c85":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of tainted","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of tainted","exampleIds":[],"headword":"mayata\u00d9","id":"shakespeare014.lex.taint","ipa":"","label":"taint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"mayatang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Corrupt or infect morally through hearing; verbal use of the established tainted stem.","id":"shakespeare014.lex.taint.sense","status":"draft"}],"status":"draft","variants":[]},"3ba5099bf1b52d05c665ff7d47849dfdc4bbd0f8fb830c99f22ebde8089f7577":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of fault","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of fault","exampleIds":[],"headword":"murf\u00d7venor","id":"shakespeare014.lex.taint_fault","ipa":"","label":"taint_fault","notes":"","orthographyId":"thimf