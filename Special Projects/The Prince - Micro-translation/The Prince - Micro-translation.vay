shakespeare014.source.venus-and-adonis.r1"}],"definition":"A three-dimensional fashioned figure, prototypically stone; the poem\u2019s insult does not assign a literal material to the youth.","id":"shakespeare014.lex.statue.sense","status":"draft"}],"status":"draft","variants":[]},"2303c45646fefe28dae129d131a62819ac7f5bef75e5696a1d84bed510eb0224":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: law","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: law","exampleIds":[],"headword":"lamthr\u00ebn","id":"shakespeare014.lex.statute_public","ipa":"","label":"statute_public","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamthr\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A prescribed public law in the citizens\u2019 accusation about class oppression; distinct from a debt security.","id":"shakespeare014.lex.statute_public.sense","status":"draft"}],"status":"draft","variants":[]},"58fd94d256a64db5e5393d2c266507c228223e59ec76d3903338d9d84637c920":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of bond","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of bond","exampleIds":[],"headword":"kl\u00e1rjem","id":"shakespeare014.lex.statute_security","ipa":"","label":"statute_security","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A formally binding debt obligation invoked through beauty in Sonnet 134; not merely any written public law. The exact historical legal procedure remains a source note, not newly invented Vayrshemon law.","id":"shakespeare014.lex.statute_security.sense","status":"draft"}],"status":"draft","variants":[]},"1a72111049221a0ddb3cdc7c8065e343e64afcaa476a1aef71ee9964c4bcc5c9":{"audioLinks":[],"citations":[{"locator":"Authored native contextual sense of staff","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native contextual sense of staff","exampleIds":[],"headword":"teral","id":"shakespeare014.lex.stave_club","ipa":"","label":"stave_club","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"teral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A stout stick carried by the citizens, source bat; uses the native staff category, distinct in the paired list from the heavy club weapon. Not a flying animal or a modern sporting specification.","id":"shakespeare014.lex.stave_club.sense","status":"draft"}],"status":"draft","variants":[]},"ed11760f600224dde6aff7b44fc2f83b53547a5c4b4136d47f16a8fded7e533a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_steadfast","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_steadfast","exampleIds":[],"headword":"kojjw\u00ebnenplesten","id":"shakespeare014.lex.steadfast","ipa":"","label":"steadfast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"kojjw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Unchanging in loyalty or affection, the constant heart in Sonnet 53; no inherited Biblical participant is imported.","id":"shakespeare014.lex.steadfast.sense","status":"draft"}],"status":"draft","variants":[]},"9ca196ca57ab360d7ab8bb0b4bd4d2a31a08c3fb95fd66ec08e9ce53b81d8406":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of secret","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of secret","exampleIds":[],"headword":"o\u00c3bren"