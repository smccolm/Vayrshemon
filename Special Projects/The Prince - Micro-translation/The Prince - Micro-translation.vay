4.source.lucrece.r1"}],"definition":"Bitter fluid or bitterness, contrasted with honey; no exact chemical identification is imposed.","id":"shakespeare014.lex.gall.sense","status":"draft"}],"status":"draft","variants":[]},"c9f4be1f10e03c663ffca03f06703c32501968d21b88f662095f57d79936e265":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: war + galley_ship","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: war + galley_ship","exampleIds":[],"headword":"hefakgurmeranyems\u00d7 nerda\u00c3","id":"shakespeare014.lex.galleass_oared_warship","ipa":"","label":"galleass_oared_warship","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgurmeranyems\u0113 nerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"A large armed oared ship listed separately from a galley and an argosy.","id":"shakespeare014.lex.galleass_oared_warship.sense","status":"draft"}],"status":"draft","variants":[]},"fe7eebc3415aeea410c11ffa675a94303d8e8a49dfa41681bd77269f5d6e3f1b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_galley","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_galley","exampleIds":[],"headword":"meranyems\u00d7 nerda\u00c3","id":"shakespeare014.lex.galley_ship","ipa":"","label":"galley_ship","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"meranyems\u0113 nerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Pompey\u2019s rowing vessel, the site of the proposed feast. Native ship-oar category; no new crew count, deck plan or ancient ship model is invented.","id":"shakespeare014.lex.galley_ship.sense","status":"draft"}],"status":"draft","variants":[]},"cc644f0f0f34132e5fc974ff49c25b29b06e5db1c97f5d07088d544e6515abd4":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"galia","id":"shakespeare014.lex.gallia_country","ipa":"","label":"gallia_country","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"galia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The name for Gaul in Iachimo\u2019s supposed journey. Preserve the variation between Gallia and France.","id":"shakespeare014.lex.gallia_country.sense","status":"draft"}],"status":"draft","variants":[]},"491317f127b9a45ef774cbc774617b43b354325b74ed9184f8ced3c92e6ea6ba":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"galya","id":"shakespeare014.lex.gallia_host_name","ipa":"","label":"gallia_host_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"galya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The Host's old name for France, used as a direct address to Caius.","id":"shakespeare014.lex.gallia_host_name.sense","status":"draft"}],"status":"draft","variants":[]},"95ad5585f6547a2a2c761d583510d32aa0eca349e88276747de0a663718297ae":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: leap + dance","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: leap + dance","exampleIds":[],"headword":"talvalen","id":"shakespeare014.lex.galliard_dance","ipa":"","label":"galliard_dance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"talvalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The lively dance with which the Dauphin says his rival will never win a duchy.","id":"shakespeare014.lex.galliard_dance.sense","status":"draft"}],"status":"draft","variants":[]},"9bdd0d55d595eb19e1aa73200302ca3a74788e705ec8fdf54bd7ff3e06dff37d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wine + measure","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: wine + measure","exampleIds":[],"headword":"m\u00ebrvenmem","id":"shakespeare014.lex.gallon_wine","ipa":"","label":"gallon_wine","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrvenmem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The English wine measure in the item for two gallons of sack. The receipt preserves the number and the named unit.","id":"shakespeare014.lex.gallon_wine.sense","status":"draft"}],"status":"draft","variants":[]},"425d3dc2fc24ad0c7a2944131e44f9453dac6f48a2934764787f39b57685f648":{"audioLinks":[],"citations":[{"locator":"Authored native compound: horse + run","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: horse + run","exampleIds":[],"headword":"thall\u00e3t\u00d5","id":"shakespeare014.lex.gallop_gait","ipa":"","label":"gallop_gait","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalloit\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A horse\u2019s rapid running gait, native horse + run, figuratively applied to verse rhythm. False gallop preserves the rough or affected progression; no fixed native metrical pattern is claimed.","id":"shakespeare014.lex.gallop_gait.sense","status":"draft"}],"status":"draft","variants":[]},"6ce8a053563268ef191575618b17c32b595bef4be0ca9b7fb3211b326109cc37":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of gallop_gait","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of gallop_gait","exampleIds":[],"headword":"thall\u00e3t\u00d5","id":"shakespeare014.lex.gallop_motion","ipa":"","label":"gallop_motion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thalloit\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Move at the horse\u2019s rapid running gait; verbal use of the existing horse-run gait noun. Time gallops for the condemned thief in the source comparison, even if he walks softly.","id":"shakespeare014.lex.gallop_motion.sense","status":"draft"}],"status":"draft","variants":[]},"7ff5a83c0b42b0fac81fee2df6218be00cf6763676a7de25ed1fe7939da6a29c":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"galowei","id":"shakespeare014.lex.galloway_region","ipa":"","label":"galloway_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"galowei","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Region invoked through the Galloway nags in Pistol's retort.","id":"shakespeare014.lex.galloway_region.sense","status":"draft"}],"status":"draft","variants":[]},"5a9808ee2a36fe9ba3864b7d0a1e6b52368a2edbdacfd3bc323d5351158fc8c0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: heavy + armour + soldier","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: heavy + armour + soldier","exampleIds":[],"headword":"memvorplesten hefakgur\u00e5v\u00d1et hefak gurs\u00dflum","id":"shakespeare014.lex.gallowglass_soldier","ipa":"","label":"gallowglass_soldier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memvorplesten hefakgurouvchet hefak gurs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"A heavily armed Irish infantryman. The messenger distinguishes York's gallowglasses from his kerns.","id":"shakespeare014.lex.gallowglass_soldier.sense","status":"draft"}],"status":"draft","variants":[]},"5672783230e6d9a98c897f4b65080b963f47c0bb44c560cc3ff6fa18fbf16a00":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"galus","id":"shakespeare014.lex.gallus_caesar_officer","ipa":"","label":"gallus_caesar_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"galus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The officer sent with Proculeius to Cleopatra. Distinct named participant; the source does not authorize identifying him with a particular poet or supplying a biography.","id":"shakespeare014.lex.gallus_caesar_officer.sense","status":"draft"}],"status":"draft","variants":[]},"aa20a7423db415cd3a3965d5df36861f6dd6ca86d71fcb2d3176f9ec9eda36a0":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gam","id":"shakespeare014.lex.gam_esquire","ipa":"","label":"gam_esquire","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The surname of the esquire Davy in the battlefield roll.","id":"shakespeare014.lex.gam_esquire.sense","status":"draft"}],"status":"draft","variants":[]},"a8c318ea9e19132294249ddb63624121e494241710a765f27d733b3e5b14682c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: deer + keeper","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Authored native derivation or sense: deer + keeper","exampleIds":[],"headword":"velnorjem\u00e3s\u00dflum","id":"shakespeare014.lex.gamekeeper_hunter","ipa":"","label":"gamekeeper_hunter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velnorjemois\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The keeper of the hunting ground who proposes taking the former king like a deer.","id":"shakespeare014.lex.gamekeeper_hunter.sense","status":"draft"}],"status":"draft","variants":[]},"6e007927677e33fadb3f335dc0f4f7a47a7822b3bcae20328dbdfce99aa07060":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: salt_pork + thigh","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: salt_pork + thigh","exampleIds":[],"headword":"merkw\u00d7silpor\u00ebnvorinthavil","id":"shakespeare014.lex.gammon_cured_ham","ipa":"","label":"gammon_cured_ham","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"merkw\u0113silpor\u00fcnvorinthavil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"A cured hind leg of pork, compared with the sufferers endlessly boiling in the Daughter's vision.","id":"shakespeare014.lex.gammon_cured_ham.sense","status":"draft"}],"status":"draft","variants":[]},"1dc7cf4f6a2fea4cd525404ca018f1ef3a044d45159c834d2c270c1b952335d7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: music + step","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: music + step","exampleIds":[],"headword":"valempalen","id":"shakespeare014.lex.gamut_music_scale","ipa":"","label":"gamut_music_scale","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"valempalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The ordered musical scale Hortensio turns into an amorous lesson.","id":"shakespeare014.lex.gamut_music_scale.sense","status":"draft"}],"status":"draft","variants":[]},"abb860c7765a6f821611e4037963117aa95e94a4a41f6aca9079facdb56354e7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: flesh + rot","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: flesh + rot","exampleIds":[],"headword":"vorinmuram","id":"shakespeare014.lex.gangrene_decay","ipa":"","label":"gangrene_decay","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vorinmuram","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Become gangrenous in the diseased-foot analogy. Native flesh-decay preserves the medical image; it is neither a diagnosis of Coriolanus nor medical advice.","id":"shakespeare014.lex.gangrene_decay.sense","status":"draft"}],"status":"draft","variants":[]},"7827b24916b65ecff54158cee2c16dce856b6b00f6799fc8f26c904d52fe460d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"ganimed","id":"shakespeare014.lex.ganymede_alias","ipa":"","label":"ganymede_alias","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ganimed","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The name of Jove\u2019s page chosen by Rosalind for her disguise. The allusion and assumed name are explicit; she is not asserted to be the mythic figure.","id":"shakespeare014.lex.ganymede_alias.sense","status":"draft"}],"status":"draft","variants":[]},"18f2fccc65c2e8a3195db6af951d9bdfdf3317a8bb4212c73e5fb4ffa3796b53":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"ganimed","id":"shakespeare014.lex.ganymede_joves_youth","ipa":"","label":"ganymede_joves_youth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ganimed","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The youth seized by Jove in Emilia's comparison. The same localized name is used in Rosalind's disguise.","id":"shakespeare014.lex.ganymede_joves_youth.sense","status":"draft"}],"status":"draft","variants":[]},"30ac048916db5e1d7e46158b9bdbbb3ce712a2d40cf9e37947892cd38af80080":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of turmoil","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of turmoil","exampleIds":[],"headword":"nor\u00d3amamemil","id":"shakespeare014.lex.garboil_tumult","ipa":"","label":"garboil_tumult","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"northamamemil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Political commotions stirred by Fulvia, the garboils reported in Antony\u2019s papers.","id":"shakespeare014.lex.garboil_tumult.sense","status":"draft"}],"status":"draft","variants":[]},"82b76d9ab4468edc959e0337fb94ee89d7468a0385cdfdb750eebf53c9b1fbab":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_garden","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_garden","exampleIds":[],"headword":"ragum\u00e7l\u00d7ono\u00c3t\u00e7","id":"shakespeare014.lex.garden","ipa":"","label":"garden","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ragum\u016bl\u0113onojzht\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Cultivated growing enclosure, imagined as flower-filled cheeks in the poem.","id":"shakespeare014.lex.garden.sense","status":"draft"}],"status":"draft","variants":[]},"4b2eb2399f3b905a9dd2b5857387530b195bef0ca6bd14d03faa0de17f5f7cfa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: garden + person","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Authored native derivation or sense: garden + person","exampleIds":[],"headword":"ragum\u00e7l\u00d7ono\u00c3t\u00e7s\u00dflum","id":"shakespeare014.lex.gardener_richard_household","ipa":"","label":"gardener_richard_household","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ragum\u016bl\u0113onojzht\u016bs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"A person who tends a garden. The gardener directs two servingmen and explains the pruning and rue to the listening Queen.","id":"shakespeare014.lex.gardener_richard_household.sense","status":"draft"}],"status":"draft","variants":[]},"f892f1a7ba1740f909cf3969a7436febe6c72e8217feab158ad13ab6bab6d6ac":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gardiner","id":"shakespeare014.lex.gardiner_royal_secretary","ipa":"","label":"gardiner_royal_secretary","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gardiner","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Henry's new secretary, later Bishop of Winchester. He tells Wolsey privately that he still takes Wolsey's orders.","id":"shakespeare014.lex.gardiner_royal_secretary.sense","status":"draft"}],"status":"draft","variants":[]},"c59b25978b3a73bf2865930eef1fbb55f96005996b25e118a590ae2b8a0cc113":{"audioLinks":[],"citations":[{"locator":"Stage mispronunciation with a dropped medial syllable from the native expression.","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Stage mispronunciation with a dropped medial syllable from the native expression.","exampleIds":[],"headword":"arvf\u00c5wen","id":"shakespeare014.lex.gardon_costard","ipa":"","label":"gardon_costard","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"arvf\u0101wen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Garbled guerdon in Costard's mispronunciation.","id":"shakespeare014.lex.gardon_costard.sense","status":"draft"}],"status":"draft","variants":[]},"bc629d638859ba4de0daf493f414ae484441bec3ecc3d30af622a6a67c79c5ff":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"gargantua","id":"shakespeare014.lex.gargantua_giant","ipa":"","label":"gargantua_giant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gargantua","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The giant Gargantua named in Celia\u2019s exaggerated request for a mouth large enough for all her answers. Permitted personal-name adaptation; no additional episode from Rabelais is inserted.","id":"shakespeare014.lex.gargantua_giant.sense","status":"draft"}],"status":"draft","variants":[]},"cee377c721fd936d26465a9e7efb3ad23c14ff74f9e3b3acadd821124c955c0c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gargrav","id":"shakespeare014.lex.gargrave_knight","ipa":"","label":"gargrave_knight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gargrav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The knight who proposes the north gate, falls with Salisbury and is carried out dead.","id":"shakespeare014.lex.gargrave_knight.sense","status":"draft"}],"status":"draft","variants":[]},"22a8588f0e70e4ee4b0ada9affa1c9eb51e1f8c98512133b37332e61e9dc595e":{"audioLinks":[],"citations":[{"locator":"Authored native compound: round + bind","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: round + bind","exampleIds":[],"headword":"olenkl\u00e1rjem","id":"shakespeare014.lex.garment_button","ipa":"","label":"garment_button","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"olenkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A button fastening a garment, native round + bind as a lexicalized clothing fastener. Does not require a round geometric shape for every token or import a digital UI button.","id":"shakespeare014.lex.garment_button.sense","status":"draft"}],"status":"draft","variants":[]},"0ede894fc36d216754e017a4b0666bf52f8b0051468c48c6a86d35957a1e0419":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: garment + string","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: garment + string","exampleIds":[],"headword":"felenthiril","id":"shakespeare014.lex.garment_lacing","ipa":"","label":"garment_lacing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"felenthiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A garment\u2019s fastening lace, which Cleopatra orders cut during her performed faintness; not ornamental lace fabric.","id":"shakespeare014.lex.garment_lacing.sense","status":"draft"}],"status":"draft","variants":[]},"672302b4f7265fa592e2145288c8768541eb12ddcb77fb24f878c5c5d96ef8cf":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"garter","id":"shakespeare014.lex.garter_king_of_arms","ipa":"","label":"garter_king_of_arms","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"garter","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The heraldic officer in a coat of arms and gilt copper crown. He returns to proclaim the newborn princess.","id":"shakespeare014.lex.garter_king_of_arms.sense"