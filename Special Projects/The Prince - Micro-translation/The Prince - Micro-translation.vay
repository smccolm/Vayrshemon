74c6da95235a45edeb6292c52:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"at-least","microPoints":"14000000"},"color":"#E4E9F0FF","styleId":"style.6d6c5ad69ccd6745"},{"fontId":"font:931c5de5c70401d9324d5014c123802b4fb753000360ceb2f56c589403cd58c5:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"at-least","microPoints":"14000000"},"color":"#E4E9F0FF","styleId":"style.f66a632c998ec4b4"},{"fontId":"font:9ba7c6f12d40ea8a0aafb8f07a69f8b65b424e374c6da95235a45edeb6292c52:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"exact","microPoints":"38000000"},"color":"#E4E9F0FF","styleId":"style.3a6e197999bea489"},{"fontId":"font:931c5de5c70401d9324d5014c123802b4fb753000360ceb2f56c589403cd58c5:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"exact","microPoints":"38000000"},"color":"#E4E9F0FF","styleId":"style.bafcb097b4f75dc4"},{"fontId":"font:931c5de5c70401d9324d5014c123802b4fb753000360ceb2f56c589403cd58c5:0","fontSizeMicroPoints":"22000000","lineHeight":{"mode":"exact","microPoints":"38000000"},"color":"#E4E9F0FF","styleId":"style.archive-punctuation"}],"pages":[{"pageId":"page.1","widthMicroPoints":"339411255","heightMicroPoints":"992777921","marginsMicroPoints":{"top":"0","right":"0","bottom":"0","left":"0"},"frames":[{"frameId":"frame.1","storyId":"story.1","xMicroPoints":"0","yMicroPoints":"0","widthMicroPoints":"339411255","heightMicroPoints":"992777921","overflow":"show"}]}],"stories":[{"storyId":"story.1","blocks":[{"blockId":"block.2556ab38b2874ef2acce36c6390f678a","type":"paragraph","direction":"auto","runs":[{"runId":"run.5e1eaacb60604b2c8a792ea96660717e","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"And although a complete proof of this latter cannot be shown, nevertheless there was some evidence of it at the battle of Ravenna,"}]},{"blockId":"block.3d302d7fb186405fad8ef818962f01c4","type":"paragraph","direction":"auto","runs":[{"runId":"run.2d9d0d70ba3345328c320e01dc0690c2","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"when the Spanish infantry were confronted by German battalions, who follow the same tactics as the Swiss;"}]},{"blockId":"block.6e6b001e6fe44bc58810aa2a235dc41d","type":"paragraph","direction":"auto","runs":[{"runId":"run.5444540a7e8846a897484980cb399f9b","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"when the Spaniards, by agility of body and with the aid of their shields, got in under the pikes"},{"runId":"run.7f9f97019c3b48169b9dfeb9202edf03","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":" of the Germans and stood out of danger, able to attack, while the Germans stood helpless,"}]},{"blockId":"block.c433c7c7accb48ef9bd0224ac7129874","type":"paragraph","direction":"auto","runs":[{"runId":"run.ca32421a85d2492fa09c2e7f815a3204","languageId":"language.en","styleId":"style.3a6e197999bea489","type":"unicode","normalization":"none","text":"and, if the cavalry had not dashed up, all would have been over with them."}]}]}]},"styleFeatures":{"style.body":{"kern":true,"liga":true},"style.6d6c5ad69ccd6745":{"kern":true,"liga":true},"style.f66a632c998ec4b4":{"kern":true,"liga":true},"style.3a6e197999bea489":{"kern":true,"liga":true},"style.bafcb097b4f75dc4":{"kern":true,"liga":true},"style.archive-punctuation":{"kern":true,"liga":true}},"characters":[{"start":0,"end":130,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":131,"end":236,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":237,"end":333,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":333,"end":423,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}},{"start":424,"end":498,"attributes":{"tracking":0,"wordSpacing":0.0,"baseline":0.0}}],"paragraphs":[{"alignment":"left","before":1.0,"after":24.0,"tabs":[]},{