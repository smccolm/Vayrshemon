,"senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The dead customer mentioned by the Bawd.","id":"shakespeare014.lex.transylvanian_customer.sense","status":"draft"}],"status":"draft","variants":[]},"48ce18959feb43a37e84f6bb2e948670f7c8c9564eb4b689ff55f1c453ca9df5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"traverz","id":"shakespeare014.lex.travers_retainer","ipa":"","label":"travers_retainer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"traverz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Northumberland's servant sent out for news.","id":"shakespeare014.lex.travers_retainer.sense","status":"draft"}],"status":"draft","variants":[]},"7faec097b91aab4da79a45929cf34a8939614b189e107c8ce4f4362b7c7a4bd4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"trei","id":"shakespeare014.lex.tray_lear_hound","ipa":"","label":"tray_lear_hound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"trei","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The first of the little dogs Lear imagines barking at him.","id":"shakespeare014.lex.tray_lear_hound.sense","status":"draft"}],"status":"draft","variants":[]},"be302858fa5ad73020d0ae846040a5c97e77e0a57045acc89d859b7b01b8e161":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: treasure + guard","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: treasure + guard","exampleIds":[],"headword":"minelm\u00c5rumjemeks\u00dflum","id":"shakespeare014.lex.treasurer_keeper","ipa":"","label":"treasurer_keeper","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"minelm\u0101rumjemeks\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The keeper accountable for Cleopatra\u2019s valuables, Seleucus\u2019s stated office. Native treasure-keeper, not a borrowed bureaucratic title.","id":"shakespeare014.lex.treasurer_keeper.sense","status":"draft"}],"status":"draft","variants":[]},"ef4d3c4fd17a8b69ae3dcaf6c0f08a8d52ebb1fff07e81ec0bce1ffa9b57455e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of contract","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of contract","exampleIds":[],"headword":"le\u00db\u00c7kl\u00e1rjem","id":"shakespeare014.lex.treaty_agreement","ipa":"","label":"treaty_agreement","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lesh\u00e3kl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The negotiated political compact to be written and sealed among the rulers. Distinct from writing a literary composition or an unmentioned marriage agreement.","id":"shakespeare014.lex.treaty_agreement.sense","status":"draft"}],"status":"draft","variants":[]},"917d86a8040e5701d8f2da71eaaf57efa4c404d710979ad7f873f7c42b3b342f":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Native compound of three, life. Having a threefold life-span in the crow address. No numeral is changed and no zoological mechanism or comparison species is inserted.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Native compound of three, life. Having a threefold life-span in the crow address. No numeral is changed and no zoological mechanism or comparison species is inserted.","exampleIds":[],"headword":"venik\u00d5\u00dfr","id":"shakespeare014.lex.treble_lived","ipa":"","label":"treble_lived","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"venik\u0167h\u014dr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Having a threefold life-span in the crow address. No numeral is changed and no zoological mechanism or comparison species is inserted.","id":"shakespeare014.lex.treble_lived.sense","status":"draft"}],"status":"draft","variants":[]},"5ea9afe5875cc59bc231e0fc37566c14398928ce94387f8456ab87b1a7ccf0e0":{"audioLinks":[],"citations":[{"locator":"Authored native compound: high + voice","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: high + voice","exampleIds":[],"headword":"naorgiktenv\u00d7son","id":"shakespeare014.lex.treble_voice","ipa":"","label":"treble_voice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"naorgiktenv\u0113son","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A high vocal register, native high + voice. Source childish treble is not three, threefold, a musical interval, or a specified frequency.","id":"shakespeare014.lex.treble_voice.sense","status":"draft"}],"status":"draft","variants":[]},"8984399b57a7da764e622936234e8af9778ee87d1be5984ec43386a9d9817032":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"trebonius","id":"shakespeare014.lex.trebonius_conspirator","ipa":"","label":"trebonius_conspirator","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"trebonius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The conspirator who later draws Antony away from Caesar.","id":"shakespeare014.lex.trebonius_conspirator.sense","status":"draft"}],"status":"draft","variants":[]},"378845726f66c77a7217dd8c42c101389157d515092fc8b2289af1b4efde7f3f":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Explicit literary promotion of kjv_tree; same native form, reviewed meaning, older entry untouched.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Explicit literary promotion of kjv_tree; same native form, reviewed meaning, older entry untouched.","exampleIds":[],"headword":"y\u00eblverzet","id":"shakespeare014.lex.tree","ipa":"","label":"tree","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclverzet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Woody plant with trunk and branches. Generic tree; the Arabian tree is not silently identified as a palm.","id":"shakespeare014.lex.tree.sense","status":"draft"}],"status":"draft","variants":[]},"3b0c9b5f21f95ef9a77e73101d916344ec5ad3c0b0ea2dc80979a5ca8df722db":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: trench + dig","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: trench + dig","exampleIds":[],"headword":"dest\u00eb\u00c5durunjo\u00d9dest\u00eb\u00c5s\u00dflum","id":"shakespeare014.lex.trench_digger","ipa":"","label":"trench_digger","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dest\u00fc\u0101durunjongdest\u00fc\u0101s\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A military worker digging siege approaches or trenches, not a settler or innovator.","id":"shakespeare014.lex.trench_digger.sense","status":"draft"}],"status":"draft","variants":[]},"9bf695c8e022be77e5a5c919eaed560219b2eff84509725323d87b078fd3caeb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: trench","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: trench","exampleIds":[],"headword":"dest\u00eb\u00c5durun","id":"shakespeare014.lex.trench_military","ipa":"","label":"trench_military","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dest\u00fc\u0101durun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A defensive or siege ditch, the Roman soldiers\u2019 retreat position. Nominal use of native trench, not only a figurative facial furrow.","id":"shakespeare014.lex.trench_military.sense","status":"draft"}],"status":"draft","variants":[]},"5795252534b6c5322544b594558e863ce7d8d8567af5f0bf6904e04ded18b23f":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of plate","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of plate","exampleIds":[],"headword":"shalet","id":"shakespeare014.lex.trencher_plate","ipa":"","label":"trencher_plate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"shalet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A dish holding food in Antony\u2019s insulting leftovers comparison; not military armour.","id":"shakespeare014.lex.trencher_plate.sense","status":"draft"}],"status":"draft","variants":[]},"856bd70d6fbad7467dc4ece984379a80452382d25bfbf6a4d6bc078d28bb95dd":{"audioLinks":[],"cita