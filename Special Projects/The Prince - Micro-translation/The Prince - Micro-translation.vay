"}],"definition":"A detestable act as evaluated by its agent after gratification; preserves the narrator\u2019s moral vocabulary.","id":"shakespeare014.lex.abomination.sense","status":"draft"}],"status":"draft","variants":[]},"70e69e8dc21d202cbd81f66c28e05de6d88f7d5d795b8d9e7405f51b67c8d804":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"avr\u00c5ham","id":"shakespeare014.lex.abraham_cupid_nickname","ipa":"","label":"abraham_cupid_nickname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"avr\u0101ham","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"Mercutio's nickname for Cupid in the transmitted reading Young Abraham Cupid. It echoes the inherited name without identifying Cupid with the biblical patriarch.","id":"shakespeare014.lex.abraham_cupid_nickname.sense","status":"draft"}],"status":"draft","variants":[]},"e8c7fde61055d7d554bacfc7591e013371f7b07324c6b9597252a8b47cbdf86a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"abram","id":"shakespeare014.lex.abraham_slender_given","ipa":"","label":"abraham_slender_given","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"abram","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"Shallow's young kinsman, addressed by Sir Hugh. Distinct from the biblical patriarch.","id":"shakespeare014.lex.abraham_slender_given.sense","status":"draft"}],"status":"draft","variants":[]},"84a7fc86baee3f2d