]},"365fdfcd3ef6f73b82a7e5200489531408a81fc8bd3b9c4f741c3b717e618e93":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: reckoning_counter + reckon","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: reckoning_counter + reckon","exampleIds":[],"headword":"tarendentaren","id":"shakespeare014.lex.countercaster_reckoning","ipa":"","label":"countercaster_reckoning","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarendentaren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"A reckoner using counting tokens. Iago sneers at the officer he sees as a book-trained calculator.","id":"shakespeare014.lex.countercaster_reckoning.sense","status":"draft"}],"status":"draft","variants":[]},"cca1c31eb523098429256bda3487916b137ba3873b529056a5708faae0a586fa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: back + rebuke","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: back + rebuke","exampleIds":[],"headword":"tarmurlam","id":"shakespeare014.lex.countercheck_rebuke","ipa":"","label":"countercheck_rebuke","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarmurlam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A countering rebuke, distinct in the named ladder from the preceding reproof.","id":"shakespeare014.lex.countercheck_rebuke.sense","status":"draft"}],"status":"draft","variants":[]},"102f34c9ccde2756284cf8596df4f76418fd4a64ad604624265cb86ded5b8f43":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of false","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of false","exampleIds":[],"headword":"dlen","id":"shakespeare014.lex.counterfeit_bastard","ipa":"","label":"counterfeit_bastard","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"dlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Illegitimate or counterfeit signs of beauty in Sonnet 68; source bastard attacks the artifice, not the family status of a newly invented child.","id":"shakespeare014.lex.counterfeit_bastard.sense","status":"draft"}],"status":"draft","variants":[]},"7627030d7733de57817898cbe7c8fe9d07500de974593ce1c8e3dd4412e822fa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: resist + dig","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: resist + dig","exampleIds":[],"headword":"zethkojjo\u00d9dest\u00eb\u00c5","id":"shakespeare014.lex.countermine_passage","ipa":"","label":"countermine_passage","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zethkojjongdest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A counter-tunnel dug in siege warfare. Fluellen says the enemy has got below these countermines.","id":"shakespeare014.lex.countermine_passage.sense","status":"draft"}],"status":"draft","variants":[]},"21ce96795de3c29d61eb8e39696ff75538b3fc7f803549919d77fca61170af06":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_innumerable","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_innumerable","exampleIds":[],"headword":"nathavimtaren","id":"shakespeare014.lex.countless","ipa":"","label":"countless","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"nathavimtaren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Beyond counting in the speaker\u2019s hyperbole. Deliberately no fabricated finite quantity.","id":"shakespeare014.lex.countless.sense","status":"draft"}],"status":"draft","variants":[]},"fd40995b144ac6fec7761a5d6b13b5370bb76e7acee97e038808ed5a7baaeb83":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of countryman","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of countryman","exampleIds":[],"headword":"ilnajo\u00d9s\u00dflum","id":"shakespeare014.lex.country_dweller","ipa":"","label":"country_dweller","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ilnajongs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A rustic inhabitant or farm worker, source peasant/swain; no claim that a specific listener shares their nationality.","id":"shakespeare014.lex.country_dweller.sense","status":"draft"}],"status":"draft","variants":[]},"ef630c3bbd29835734f638043fdb3021b9f05710e7ca70a4615c78f02603d0b5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of countryman","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of countryman","exampleIds":[],"headword":"ilnajo\u00d9s\u00dflum","id":"shakespeare014.lex.countryman_rustic","ipa":"","label":"countryman_rustic","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ilnajongs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The rustic bringer of figs and the basket, the Countryman speaker in the supplied text. Not merely a compatriot or a named individual.","id":"shakespeare014.lex.countryman_rustic.sense","status":"draft"}],"status":"draft","variants":[]},"6afdb810e7d317eeac593932b39fc307771bc0a8d7fcedc880c13d22b84ef3ef":{"audioLinks":[],"citations":[{"locator":"Aut