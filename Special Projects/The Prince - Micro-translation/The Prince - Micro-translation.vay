e","ipa":"","label":"radish_vegetable","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"destnay\u00fcldur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The peppery root vegetable in Falstaff's conditional oath that he is a bunch of radishes.","id":"shakespeare014.lex.radish_vegetable.sense","status":"draft"}],"status":"draft","variants":[]},"fc5774b4e61bb29f48de8f9edce3f5cdb2d1e13c08526abdd1cf6b843a25c0d4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"reif","id":"shakespeare014.lex.rafe_mouldy","ipa":"","label":"rafe_mouldy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"reif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Given name of the recruit Mouldy.","id":"shakespeare014.lex.rafe_mouldy.sense","status":"draft"}],"status":"draft","variants":[]},"b6cf2b4bb11e2e4d7edcf005a466e0c5d99d2d204247dd108fc2843c53d2382e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"reif","id":"shakespeare014.lex.rafe_petruchio_servant","ipa":"","label":"rafe_petruchio_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"reif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"A well-dressed servant included with Adam and Gregory.","id":"shakespeare014.lex.rafe_petruchio_servant.sense","status":"draft"}],"status":"draft","variants":[]},"a980c99e7a63e216e4119874f560be3c33bcb9dd8e529129718a9e78ba5e1b9b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_rag","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_rag","exampleIds":[],"headword":"yemsininfelen","id":"shakespeare014.lex.ragged_clothing","ipa":"","label":"ragged_clothing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"yemsininfelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Wearing torn or worn clothing, the ragged sleeping man. Native rag form used adjectivally; not a change to his identity or the source\u2019s account of how he arrived.","id":"shakespeare014.lex.ragged_clothing.sense","status":"draft"}],"status":"draft","variants":[]},"fb68e7ed09960b1c1ce3e44305ca14f52f4b3d0580fd46bd6300f7e5efcf7a4d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"ragozin","id":"shakespeare014.lex.ragozine_dead_pirate","ipa":"","label":"ragozine_dead_pirate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ragozin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The pirate whose head is sent in Claudio's place after he dies of fever.","id":"shakespeare014.lex.ragozine_dead_pirate.sense","status":"draft"}],"status":"draft","variants":[]},"09fe0ed91bab8f24d0bb5b1871e4d427c72e15c4aaa04d5f2325dfe8ede4d640":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_raid","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_raid","exampleIds":[],"headword":"slebybs\u00df","id"