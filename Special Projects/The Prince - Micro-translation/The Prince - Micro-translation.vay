thored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The Roman priest assigned to a particular deity, here rarely seen in the crowd. Native god-priest as a lexicalized office, with no numerical count of offices or invented individual deity.","id":"shakespeare014.lex.flamen_priest.sense","status":"draft"}],"status":"draft","variants":[]},"f844cee31e6ac0aa811648435f75d35e8ead70f54505782159ebf95ad19626b7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"flaminius","id":"shakespeare014.lex.flaminius_timon_servant","ipa":"","label":"flaminius_timon_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"flaminius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"definition":"Timon's servant who asks Lucullus for help.","id":"shakespeare014.lex.flaminius_timon_servant.sense","status":"draft"}],"status":"draft","variants":[]},"9ab1771253352205193c7225e028433669e58b73ed87bf17af11c70c27b2bc2f":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"flanderz","id":"shakespeare014.lex.flanders_region","ipa":"","label":"flanders_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"flanderz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"Destination overseas after Edward's escape by way of Lynn.","id":"shakespeare014.lex.flanders_region.sense","status":"draft"}],"status":"draft","variants":[]},"cc4cafa0bc9e013ad2e8e8c0a6aeae04c5ca60b672af5f8cbcca0fda2f34f707