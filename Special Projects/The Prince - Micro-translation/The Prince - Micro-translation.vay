thographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"klo\u0167harius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The early Frankish king named beside Pepin in the chamberlain's joke. His genealogy is not specified here.","id":"shakespeare014.lex.clotharius_frankish_king.sense","status":"draft"}],"status":"draft","variants":[]},"31ce20f03dc7df922d9c689e71c59e06aef1211d102c5a0e821922b84f21e4f3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cloth + work + person","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: cloth + work + person","exampleIds":[],"headword":"felend\u00c7\u00d3s\u00dflum","id":"shakespeare014.lex.clothier_trade","ipa":"","label":"clothier_trade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"felend\u00e3ths\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"One who works at making or finishing cloth. The opening textile joke presents Cade as a clothier.","id":"shakespeare014.lex.clothier_trade.sense","status":"draft"}],"status":"draft","variants":[]},"15ac320b70cb9ea9ff89057f6df2f11b3af92de5b797f88c3828d2eab2eeeab3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of bandage_cloth","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of bandage_cloth","exampleIds":[],"headword":"felenkl\u00e1rjem","id":"shakespeare014.lex.clothing_band","ipa":"","label":"clothing_band","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"felenkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A strip or binding band on clothing, here around a bonnet. Same native cloth-bind formation, without the injury/wound meaning of bandage or the unsupported group word banel.","id":"shakespeare014.lex.clothing_band.sense","status":"draft"}],"status":"draft","variants":[]},"c71cbf9825d183c6f7e3788095384b7a4bd1d3311ba62dc2eb4e8806c9c11f5c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_lace_cord","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_lace_cord","exampleIds":[],"headword":"thirilkl\u00e1rjem","id":"shakespeare014.lex.clothing_lace","ipa":"","label":"clothing_lace","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thirilkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The fastening laces of clothing, source points tied by Caesar\u2019s attendant; no number or pointing gesture.","id":"shakespeare014.lex.clothing_lace.sense","status":"draft"}],"status":"draft","variants":[]},"5b5c208ba0e17d94195617edd3d2162985b9f7f9793b26e339769f2dc49b47f3":{"audioLinks":[],"citations":[{"locator":"Authored native compound: needle + bind","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: needle + bind","exampleIds":[],"headword":"jelinkl\u00e1rjem","id":"shakespeare014.lex.clothing_pin","ipa":"","label":"clothing_pin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jelinkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A small pointed fastening pin, native needle + bind, able to leave a scratch in Phoebe\u2019s comparison. Not an added weapon or a modern safety pin mechanism.","id":"shakespeare014.lex.clothing_pin.sense","status":"draft"}],"status":"draft","variants":[]},"fb62abaafa62135b2eb6d915f70ab4c15cc2c097a5b9a843135704c82920c611":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of cloud","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of cloud","exampleIds":[],"headword":"kumul","id":"shakespeare014.lex.cloud_bank","ipa":"","label":"cloud_bank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kumul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The moving cloud mass which erases its own horse-shaped outline. Rack is not a torture apparatus in this image.","id":"shakespeare014.lex.cloud_bank.sense","status":"draft"}],"status":"draft","variants":[]},"2f793961eb9cb2ce712ae23eeda1b1139d0b6b10cce6fea966a3f1fc90aa19ba":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: drama_native_spice + bud","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: drama_native_spice + bud","exampleIds":[],"headword":"nelverpelith","id":"shakespeare014.lex.clove_spice_bud","ipa":"","label":"clove_spice_bud","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nelverpelith","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"An aromatic dried bud stuck into the lemon. The next speaker hears the participle of cleaving.","id":"shakespeare014.lex.clove_spice_bud.sense","status":"draft"}],"status":"draft","variants":[]},"97ea683634227de501cd1181cbd1aeab2fea7c984fe543599e180fd24890e908":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: meadow + leaf","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: meadow + leaf","exampleIds":[],"headword":"mivily\u00eblet","id":"shakespeare014.lex.clover_plant","ipa":"","label":"clover_plant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mivily\u00fclet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The clover leaf of the earlier sweet meadow, distinct from the flowers listed with it.","id":"shakespeare014.lex.clover_plant.sense","status":"draft"}],"status":"draft","variants":[]},"dfc3db4e4f536afde77c5f0dccbb44bcd2d452f09a93b626b4d9b2ff0566d996":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"klauder","id":"shakespeare014.lex.clowder_sly_hound","ipa":"","label":"clowder_sly_hound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"klauder","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The hound to be coupled with the deep-voiced female hound.","id":"shakespeare014.lex.clowder_sly_hound.sense","status":"draft"}],"status":"draft","variants":[]},"c7659960c0f08c00b2b08c21fb588a866aa277e5936e4e7c3487e939696104a9":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: full + weary","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: full + weary","exampleIds":[],"headword":"plestenlevna","id":"shakespeare014.lex.cloy","ipa":"","label":"cloy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"plestenlevna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Weary through excess or satiation, explicitly denied of the beloved\u2019s sweetness in Sonnet 118. Native full-weary, not simply fill or nourish.","id":"shakespeare014.lex.cloy.sense","status":"draft"}],"status":"draft","variants":[]},"b0061e5ef7986356c3d31d1b539c019100f203bf54901b6d08ac706717a04903":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: wood + strike","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: wood + strike","exampleIds":[],"headword":"y\u00eblsleb","id":"shakespeare014.lex.club_weapon","ipa":"","label":"club_weapon","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclsleb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The heavy striking weapon of Hercules; wooden striker, distinct from a social club.","id":"shakespeare014.lex.club_weapon.sense","status":"draft"}],"status":"draft","variants":[]},"94703c257a2602c9a2aa3a412dcda7d78d7526cd8c656f09f4c9f25e80cdbc7f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: hen + call","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: hen + call","exampleIds":[],"headword":"kekla\u00d3\u00c5\u00e7","id":"shakespeare014.lex.cluck_hen","ipa":"","label":"cluck_hen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"keklath\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The hen\u2019s call to her brood, applied to Volumnia sending her son to war and welcoming him home.","id":"shakespeare014.lex.cluck_hen.sense","status":"draft"}],"status":"draft","variants":[]},"351f33efc645de3b1db327318baf2bb02b944fae6d6c1a596350dbc588f0dbdd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_bowels + pipe","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: kjv_bowels + pipe","exampleIds":[],"headword":"vornifilir","id":"shakespeare014.lex.clyster_pipe","ipa":"","label":"clyster_pipe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vornifilir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"A tube for administering an enema, Iago's malicious wish as Cassio repeatedly kisses his fingers.","id":"shakespeare014.lex.clyster_pipe.sense","status":"draft"}],"status":"draft","variants":[]},"c5cd53458dd857d6e7621b8d21f0ade2109cff4f386463ea348a9f65530b75a0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: traveller + wagon","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: traveller + wagon","exampleIds":[],"headword":"r\u00ddy\u00d3s\u00dflumolirborel","id":"shakespeare014.lex.coach_passenger_vehicle","ipa":"","label":"coach_passenger_vehicle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"r\u012byths\u014dlumolirborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The covered passenger vehicle that carries the beloved in the king's comparison with a tear.","id":"shakespeare014.lex.coach_passenger_vehicle.sense","status":"draft"}],"status":"draft","variants":[]},"8b3d7b5cfaef92a5a436e861bf14deaa960ca91545e99c7856563f7d0a3d2b2c":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical root; no claim of historical attestation.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Authored short native lexical root; no claim of historical attestation.","exampleIds":[],"headword":"zarim","id":"shakespeare014.lex.coal","ipa":"","label":"coal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarim","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A coal or ember of glowing fuel; a new short native root inspired by zarun (flame), without a claim about mined versus wood fuel.","id":"shakespeare014.lex.coal.sense","status":"draft"}],"status":"draft","variants":[]},"ae030cc51d50f1045bce9cd1a91fc9bae076ef2fc95757a00f58209879224ffd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: carry + coal","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: carry + coal","exampleIds":[],"headword":"\u00db\u00c7dzarim","id":"shakespeare014.lex.coal_bearing_insult","ipa":"","label":"coal_bearing_insult","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"sh\u00e3dzarim","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"An ignominious coal porter's burden used to signify submitting to insults. The literal coals are repeated in the reply.","id":"shakespeare014.lex.coal_bearing_insult.sense","status":"draft"}],"status":"draft","variants":[]},"b79345d92c62f5011225ec53ce4a9ebaceddb9469fa1ed533915fc92e08020a8":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from coal, black","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from coal, black","exampleIds":[],"headword":"zarimk\u00c9\u00cfn","id":"shakespeare014.lex.coal_black","ipa":"","label":"coal_black","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"zarimk\u00e4\u00cfn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Black as coal, qualifying the evening clouds.","id":"shakespeare014.lex.coal_black.sense","status":"draft"}],"status":"draft","variants":[]},"72c025ff8581481be471cd9a3099780dabf23a735f3577abcb9f576426860540":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: coal + carry + person","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: coal + carry + person","exampleIds":[],"headword":"zarim\u00db\u00c7ds\u00dflum","id":"shakespeare014.lex.coal_carrier_worker","ipa":"","label":"coal_carrier_worker","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarimsh\u00e3ds\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The person who bears or deals in coals in Gregory's literal retort.","id":"shakespeare014.lex.coal_carrier_worker.sense","status":"draft"}],"status":"draft","variants":[]},"65183573a746c2e5ffc2fa1e931442205021b9f6c322ca368dfa43847d5f114c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: shoe + repairer","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Authored native derivation or sense: shoe + repairer","exampleIds":[],"headword":"palinufols\u00dflum","id":"shakespeare014.lex.cobbler_shoe_mender","ipa":"","label":"cobbler_shoe_mender","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"palinufols\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The tradesman who repairs shoes. In his opening self-description he also invites the customary sense of an indifferent workman.","id":"shakespeare014.lex.cobbler_shoe_mender.sense","status":"draft"}],"status":"draft","variants":[]},"9e3e29212e858b90d487b5629ea60ea07413fad1012c45db489c6799aa6dfae0":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kobam","id":"shakespeare014.lex.cobham_eleanor","ipa":"","label":"cobham_eleanor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kobam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Eleanor's family name when Henry publicly sentences her.","id":"shakespeare014.lex.cobham_eleanor.sense","status":"draft"}],"status":"draft","variants":[]},"87425c64f83f9588079dd00d4b761d9d8e8936ad4f9f76fb2be2d35fb82c5d09":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kobam","id":"shakespeare014.lex.cobham_hereford_ally","ipa":"","label":"cobham_hereford_ally","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kobam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"Rainold's title in the report of the returning party. This is not the Lancastrian conspirator's wife.","id":"shakespeare014.lex.cobham_hereford_ally.sense","status":"draft"}],"status":"draft","variants":[]},"79818e560aa8c6767f4c816fa5e25d0ebf71ec83e91c191e7bd71806a9e8cd51":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kobam","id":"shakespeare014.lex.cobham_kent_lord","ipa":"","label":"cobham_kent_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kobam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The Kentish lord to whom York sends his son Edward for support. Distinct from Duchess Eleanor Cobham.","id":"shakespeare014.lex.cobham_kent_lord.sense","status":"draft"}],"status":"draft","variants":[]},"895f5af0de30825eb42c13b87e047692e0cf7b4112463153be8339ec24c2d7f7":{"audioLinks":[],"citations":[{"locator":"Authored native bird-family coinage related to kekla, replacing a suspicious English-like ordinary form only in this new working translation.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native bird-family coinage related to kekla, replacing a suspicious English-like ordinary form only in this new working translation.","exampleIds":[],"headword":"keklen","id":"shakespeare014.lex.cock_fowl","ipa":"","label":"cock_fowl","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"keklen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Adult male domestic fowl, the fighting cock in Antony\u2019s comparison. A deliberate lexical counterpart to native hen kekla; the ending is not a productive sex-changing suffix.","id":"shakespeare014.lex.cock_fowl.sense","status":"draft"}],"status":"draft","variants":[]},"9d0ef7ef66bb801ecb424c73cb4cd50ae198277e98b3fd33536d190eeae0586f":{"audioLinks":[],"citations":[{"locator":"Authored clipped oath in a sung quotation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored clipped oath in a sung quotation","exampleIds":[],"headword":"prod","id":"shakespeare014.lex.cock_minced_oath","ipa":"","label":"cock_minced_oath","notes":"","orthographyId":"thimfora-79","partOfSpeech":"interjection","pronunciation":"prod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A shortened prodvar, god, for the song's softened oath by Cock. The English sound also permits a bawdy undertone; that sound play does not carry over.","id":"shakespeare014.lex.cock_minced_oath.sense","status":"draft"}],"status":"draft","variants":[]},"8ee7780130ef9d55119cb1eac9d8ae43bb9cf899517dce63e888b09c5d02f0c4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_cockatric