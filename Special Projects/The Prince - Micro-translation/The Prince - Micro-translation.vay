w\u00fcnenplesten shalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"A small ribbed shellfish, distinct from the weed.","id":"shakespeare014.lex.cockle_sea_shell.sense","status":"draft"}],"status":"draft","variants":[]},"85a62b19867439d7999f0b0b9c8fff8de2366f6d974d518001dd995546a1ff54":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_cockle","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_cockle","exampleIds":[],"headword":"yel\u00c3\u00ddn","id":"shakespeare014.lex.cockle_weed","ipa":"","label":"cockle_weed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yeljzh\u012bn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The unwanted corn-field weed in Coriolanus\u2019s metaphor for rebellion; reviewed native plant category, not shellfish. No modern species identification is imposed.","id":"shakespeare014.lex.cockle_weed.sense","status":"draft"}],"status":"draft","variants":[]},"ded7152ac6a21d082fd2c48dff2c1fb9b5ec1dc8d339a8395bcbb81da677ac43":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cock_fowl + pit","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: cock_fowl + pit","exampleIds":[],"headword":"keklenjo\u00d9dul","id":"shakespeare014.lex.cockpit_arena","ipa":"","label":"cockpit_arena","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"keklenjongdul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A cockfighting pit whose limited size the Chorus compares with the playhouse.","id":"shakespeare014.lex.cockpit_arena.sense","status":"draft"}],"status":"draft","variants":[]},"f491a6126de17682619669