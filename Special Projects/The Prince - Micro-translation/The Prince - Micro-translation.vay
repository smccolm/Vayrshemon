or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"nestor","id":"shakespeare014.lex.nestor","ipa":"","label":"nestor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nestor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The elder Greek counsellor represented speaking in the painting.","id":"shakespeare014.lex.nestor.sense","status":"draft"}],"status":"draft","variants":[]},"772775592eba7d8aed9bf21004b246816977b8377a95874acef9c9d53e6fd3c9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nestor","id":"shakespeare014.lex.nestor_ship_attendant","ipa":"","label":"nestor_ship_attendant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nestor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"Pericles asks Lychorida to have this attendant fetch spices, ink, paper, casket and jewels. He is distinct from the ancient Greek counselor.","id":"shakespeare014.lex.nestor_ship_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"a436a050daec37177793368a65495b3c4ec485f549fc4800b704093b03024674":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_net","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_net","exampleIds":[],"headword":"thiril thirav","id":"shakespeare014.lex.net","ipa":"","label":"net","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thiril thirav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Mesh used to entangle a bird. Does not import the historical brass material of its earlier occasion.","id":"shakespeare014.lex.net.sense","status":"draft"}],"status":"draft","variants":[]},"eda1f2df537ab4a87b3b991672b886bc4773839f6960a48085cebb568248e53b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_nettle","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_nettle","exampleIds":[],"headword":"kraniny\u00eblet","id":"shakespeare014.lex.nettle_plant","ipa":"","label":"nettle_plant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kraniny\u00fclet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The stinging plant in Menenius\u2019s plain-naming proverb. Retains the native thorn-leaf category without identifying a modern species or borrowing its English name.","id":"shakespeare014.lex.nettle_plant.sense","status":"draft"}],"status":"draft","variants":[]},"8d7610039d6e6de90fc1ac9f4204d35f801c15d1d6dc9d9645feffd1e6b673c4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"nevil","id":"shakespeare014.lex.nevil_warwick","ipa":"","label":"nevil_warwick","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nevil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Warwick as addressed by the king in the scene of Richard's prediction.","id":"shakespeare014.lex.nevil_warwick.sense","status":"draft"}],"status":"draft","variants":[]},"d3167e1d3d2bb73f67d3883abfd7d77b89f