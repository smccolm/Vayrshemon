Id":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: cooking_pot","exampleIds":[],"headword":"borem","id":"shakespeare014.lex.pots_stabbed_man","ipa":"","label":"pots_stabbed_man","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"borem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The man stabbed by Half-can. Use native pot with the plural ending in his name.","id":"shakespeare014.lex.pots_stabbed_man.sense","status":"draft"}],"status":"draft","variants":[]},"bfb1f26fd1842e53e12ede8876ae2c270ae7141b00b870b292ffbfd98e86ef65":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: perfume_scent + box","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: perfume_scent + box","exampleIds":[],"headword":"nel\u00ebrborel","id":"shakespeare014.lex.pouncet_box","ipa":"","label":"pouncet_box","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nel\u00fcrborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The small box held to the elegant lord's nose. Its scent and his taking offense drive Hotspur's snuff joke.","id":"shakespeare014.lex.pouncet_box.sense","status":"draft"}],"status":"draft","variants":[]},"8434eef1e6176ade169f489bb49613acba7257ace9dd86cee3f72f4fdc6e1b1a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: pound_weight + money","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: pound_weight + money","exampleIds":[],"headword":"memv\u00c5rzarven","id":"shakespeare014.lex.pound_sterling_unit","ipa":"","label":"pound_sterling_unit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memv\u0101rzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The pound as a monetary unit in the bowling wager. Its count is retained without conversion to weight or to another currency.","id":"shakespeare014.lex.pound_sterling_unit.sense","status":"draft"}],"status":"draft","variants":[]},"c95883158366e497f464c004e8fdfaf6031d475a1f83e93e2d18870eb04d797d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_pound_weight","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_pound_weight","exampleIds":[],"headword":"memv\u00c5r","id":"shakespeare014.lex.pound_weight","ipa":"","label":"pound_weight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memv\u0101r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The source pound-weight in imagined leaden restraints on haste. Reviewed native weight category, not money or a verb of beating; no number of pounds or weight-standard conversion is invented.","id":"shakespeare014.lex.pound_weight.sense","status":"draft"}],"status":"draft","variants":[]},"5f0b53ce23e6fe5f746a1a359a0b46ef1c647c7cea3bb9fd2c819462efa8ee9d":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from lip, push","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from lip, push","exampleIds":[],"headword":"melinnerda\u00c3","id":"shakespeare014.lex.pout","ipa":"","label":"pout","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melinnerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Protrude the lips in displeasure or disdain.","id":"shakespeare014.lex.pout.sense","status":"draft"}],"status":"draft","variants":[]},"eaa086f6dd675d99840c992c2bd7eac1c28d31763d08158a9b9968359d48514d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of poor","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of poor","exampleIds":[],"headword":"mavmin","id":"shakespeare014.lex.poverty","ipa":"","label":"poverty","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mavmin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Having very little, the speaker\u2019s paradoxical remaining possessions stolen in Sonnet 40; no quantitative income is inferred.","id":"shakespeare014.lex.poverty.sense","status":"draft"}],"status":"draft","variants":[]},"614f61b7daccaddfa6b62df98f650e3281d3ef7353a117872c54b03535e92c10":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: foreign + forfeit","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: foreign + forfeit","exampleIds":[],"headword":"vesnap\u00e1b\u00e9rv","id":"shakespeare014.lex.praemunire_forfeiture","ipa":"","label":"praemunire_forfeiture","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vesnap\u00f4b\u00e9rv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The offense named in Suffolk's charge over legatine authority, with seizure of property and loss of the king's protection.","id":"shakespeare014.lex.praemunire_forfeiture.sense","status":"draft"}],"status":"draft","variants":[]},"d92860065b498c29803d5cd326da40a811d2488a2ca78bfe730f900461f92b19":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: city + judge","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Authored native derivation or sense: city + judge","exampleIds":[],"headword":"z\u00e1lagurnerbw\u00c5vumen","id":"shakespeare014.lex.praetor_judicial_office","ipa":"","label":"praetor_judicial_office","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurnerbw\u0101vumen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The Roman magistrate whose chair is to receive one of the anonymous papers where Brutus can find it.","id":"shakespeare014.lex.praetor_judicial_office.sense","status":"draft"}],"status":"draft","variants":[]},"8f86dddad1f5bbc6a2c63390ca004bd1c4741c71976d6aab170b9a80db25466d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"prag","id":"shakespeare014.lex.prague_hermit_city","ipa":"","label":"prague_hermit_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prag","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"City in Feste's tale of a hermit.","id":"shakespeare014.lex.prague_hermit_city.sense","status":"draft"}],"status":"draft","variants":[]},"78bc73bd94d73dcdd666121b89ad6454bbd06d7445f554e69ac83d995fc2cbf7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: idle + speak","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: idle + speak","exampleIds":[],"headword":"mad\u00c7\u00d3giktenv\u00d7","id":"shakespeare014.lex.prate_talk","ipa":"","label":"prate_talk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"mad\u00e3thgiktenv\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Talk idly or at excessive length, the first citizen\u2019s impatient question before marching.","id":"shakespeare014.lex.prate_talk.sense","status":"draft"}],"status":"draft","variants":[]},"6bcc85274ff745f1a43d6f5f2513164139919fcc58f008cf563bfc70b974cc1d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"prat","id":"shakespeare014.lex.pratt_maid_aunt","ipa":"","label":"pratt_maid_aunt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"prat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The maid's aunt called Mother Pratt; Falstaff wears her clothes when the wives give him her name.","id":"shakespeare014.lex.pratt_maid_aunt.sense","status":"draft"}],"status":"draft","variants":[]},"5b437b79b83894d7762f252b43a0ed17894ec5b5162174730f0c67362e2ebd6c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: small + sea + claw","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: small + sea + claw","exampleIds":[],"headword":"viminmerklawil","id":"shakespeare014.lex.prawn_crustacean","ipa":"","label":"prawn_crustacean","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminmerklawil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The small crustaceans in the butcher's wife's dish, named for their small sea-claws.","id":"shakespeare014.lex.prawn_crustacean.sense","status":"draft"}],"status":"draft","variants":[]},"ffb99b7628d66ed0f80fd4671b24308fb60a8b9b3df1776109dc0dac3959d1e1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: before + rank","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: before + rank","exampleIds":[],"headword":"p\u00e1narventhren","id":"shakespeare014.lex.precedence_rank","ipa":"","label":"precedence_rank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4narventhren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The right to go before another by rank or esteem, Lartius\u2019s courteous military precedence, not a newly assigned numerical office.","id":"shakespeare014.lex.precedence_rank.sense","status":"draft"}],"status":"draft","variants":[]},"ca6378b409729403ed3fc80145b5529dc1f845908f79bd77862eaa14662244c9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: teach + rule","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: teach + rule","exampleIds":[],"headword":"pomf\u00c5wvar\u00dfnen","id":"shakespeare014.lex.precept_teaching","ipa":"","label":"precept_teaching","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pomf\u0101wvar\u014dnen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An instructive principle remembered from Volumnia\u2019s upbringing of her son. Native teach-rule, not a newly enacted civic statute.","id":"shakespeare014.lex.precept_teaching.sense","status":"draft"}],"status":"draft","variants":[]},"ddf5fd97b14b08850feae5f6e3ef2fba3298b5a22940014139b6617e4af7a8a5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: down + fall","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: down + fall","exampleIds":[],"headword":"velgaktriv","id":"shakespeare014.lex.precipice_descent","ipa":"","label":"precipice_descent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velgaktriv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The imagined downward fall from the heightened Tarpeian rock, source precipitation. Native down-fall; not rainfall or an assertion that any execution has occurred.","id":"shakespeare014.lex.precipice_descent.sense","status":"draft"}],"status":"draft","variants":[]},"13a46d24bcf1497736b5e0a99b1a54422772b60c9e284777cd9b473c67908245":{"audioLinks":[],"citations":[{"locator":"Authored native compound: early + know","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: early + know","exampleIds":[],"headword":"p\u00e1nvenorh\u00c5b\u00cd","id":"shakespeare014.lex.precocious_child","ipa":"","label":"precocious_child","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"p\u00f4nvenorh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Earlier-developed understanding, source forward child; native early + know. Not physical forward motion or an added age.","id":"shakespeare014.lex.precocious_child.sense","status":"draft"}],"status":"draft","variants":[]},"738a7adc3d5859412f70906a9e05dc1b75b2a3f3e023bfcbea613a047c457fe1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: preceding + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: preceding + person","exampleIds":[],"headword":"p\u00e1ns\u00dflum","id":"shakespeare014.lex.predecessor_office","ipa":"","label":"predecessor_office","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4ns\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Someone earlier occupying the same position, the previous consular candidates whose public form he is urged to follow; not necessarily a biological ancestor.","id":"shakespeare014.lex.predecessor_office.sense","status":"draft"}],"status":"draft","variants":[]},"0fbc838b9c3057218954e156ad0a87af883baa2994b1e35510da7e546b20aacc":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of foretell","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of foretell","exampleIds":[],"headword":"p\u00e1tonda","id":"shakespeare014.lex.prediction","ipa":"","label":"prediction","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4tonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A prognostic or forecast, the celestial signs the poet disclaims reading; nominal use of foretell.","id":"shakespeare014.lex.prediction.sense","status":"draft"}],"status":"draft","variants":[]},"369b57de60c48bbce2b58b03017b0ef84847fcbff69f013bda837a741310c9ef":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: devout + appearance","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: devout + appearance","exampleIds":[],"headword":"lamzar\u00d3\u00e1lun\u00c3","id":"shakespeare014.lex.prenzie_outward_austerity","ipa":"","label":"prenzie_outward_austerity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"lamzarth\u00f4lunjzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The witness repeats this uncertain adjective for Angelo and for trimmings that disguise a damned body. The native expression reads it as outwardly pious. Priestly and princely are among the alternative editorial readings.","id":"shakespeare014.lex.prenzie_outward_austerity.sense","status":"draft"}],"status":"draft","variants":[]},"28d7215f592789d5ac87c81fec4b23147d389a34923979366f330239da41a740":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: old + right","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: old + right","exampleIds":[],"headword":"vornlamet","id":"shakespeare014.lex.prerogative_entitlement","ipa":"","label":"prerogative_entitlement","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vornlamet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The longstanding civic entitlement invoked by the tribunes, native old-right. Their assertion of the right is not translator certification of the proceeding\u2019s justice.","id":"shakespeare014.lex.prerogative_entitlement.sense","status":"draft"}],"status":"draft","variants":[]},"358ef4f2818ace31a4cf5e204ccb8aac254257962ddc13bd0c833eb6ac7f28ed":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of divination","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of divination","exampleIds":[],"headword":"p\u00e1nh\u00c5b\u00cd","id":"shakespeare014.lex.prescience_knowledge","ipa":"","label":"prescience_knowledge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4nh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Purported foreknowledge attributed to the soothsayer; the dialogue treats it as an ability, not an editorial assertion of supernatural fact.","id":"shakespeare014.lex.prescience_knowledge.sense","status":"draft"}],"status":"draft","variants":[]},"96e8b409072583781e9f5dab60b59326dad4b78a87ab75ce68f80179eee7772a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: time + right","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Authored native derivation or sense: time + right","exampleIds":[],"headword":"venorlamet","id":"shakespeare014.lex.prescription_title","ipa":"","label":"prescription_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venorlamet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"A claim founded on long possession. Warwick disputes that sixty-two years establishes title to a kingdom.","id":"shakespeare014.lex.prescription_title.sense","status":"draft"}],"status":"draft","variants":[]},"a50c017dcfb5406a16b14a425a4b5204a6929ac565f9698196e0aaf9c8c440c9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of presence","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of presence","exampleIds":[],"headword":"kinr\u00d7","id":"shakespeare014.lex.presence_assembly","ipa":"","label":"presence_assembly","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kinr\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The eminent company present in the Roman meeting, which Antony says Enobarbus offends. Not bare existence or a theatre audience.","id":"shakespeare014.lex.presence_assembly.sense","status":"draft"}],"status":"draft","variants":[]},"6118b1c8e97c805cbc811b50129ca5df7201f843c420933380c582b883faa464":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: health + preserve","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: health + preserve","exampleIds":[],"headword":"faren\u00d5\u00dfr\u00d5\u00dfrjem","id":"shakespeare014.lex.preservative_health","ipa":"","label":"preservative_health","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"faren\u0167h\u014dr\u0167h\u014drjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Something imagined to keep a person healthy, the letter in Menenius\u2019s extravagant comparison; not a food additive or an instruction for treatment.","id":"shakespeare014.lex.preservative_health.sense","status":"draft"}],"status":"draft","variants":[]},"d98c9898ac18845d782fe61e0c4edd826c1253441ddd50e1c4e23577e8c8d820":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: soldier + pay","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: soldier + pay","exampleIds":[],"headword":"hefak gurs\u00dflumv\u00df\u00d5","id":"shakespeare014.lex.press_money_soldier","ipa":"","label":"press_money_soldier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlumv\u014d\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Pay for an impressed soldier. Lear imagines recruiting, then turns to archery.","id":"shakespeare014.lex.press_money_soldier.sense","status":"draft"}],"status":"draft","variants":[]},"f921f63e4aef5bcd96587dbf609105949b8a6442749dcb7c35ac6db1934a978d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"priyamus","id":"shakespeare014.lex.priamus_trojan_king_variant","ipa":"","label":"priamus_trojan_king_variant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"priyamus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"definition":"Extended name of Priam in Hector's address to his brothers.","id":"shakespeare014.lex.priamus_trojan_king_variant.sense","status":"draft"}],"status":"draft","variants":[]},"de2fc72b9eb6ea4623dcfce5699352964cd8601466505a97652e05d95da4f8f9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"priyapus","id":"shakespeare014.lex.priapus_fertility_god","ipa":"","label":"priapus_fertility_god","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"priyapus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The fertility deity the Bawd says Marina could freeze.","id":"shakespeare014.lex.priapus_fertility_god.sense","status":"draft"}],"status":"draft","variants":[]},"eac807ca9f34bc0960b1b9178b154079e0fcd5a7f86b06f4dd141529e3221741":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: point + stag_deer","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: point + stag_deer","exampleIds":[],"headword":"jelgl\u00c9stz\u00c5nvelnor","id":"shakespeare014.lex.pricket_spike_buck","ipa":"","label":"pricket_spike_buck","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jelgl\u00e4stz\u0101nvelnor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The hunting name for a buck in its second year, with spike antlers. This is Dull's identification of the deer.","id":"shakespeare014.lex.pricket_spike_buck.sense","status":"draft"}],"status":"draft","variants":[]},"8a5f0fad9b9956b3b6a6d7059abcbdfba6bd952cf2ec4ac7f1eda1af330f7391":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from plant, point","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from plant, point","exampleIds":[],"headword":"verzetjelgl\u00c9st","id":"shakespeare014.lex.prickle","ipa":"","label":"prickle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"verzetjelgl\u00e4st","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A sharp projection on a plant, here a rose\u2019s prickles; not any act of pricking.","id":"shakespeare014.lex.prickle.sense","status":"draft"}],"status":"draft","variants":[]},"e1b645479ea145b6c1679ff78b9627a62e9bc0cadf726eae6ef40548c9d6e85c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sound + mark + book","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: sound + mark + book","exampleIds":[],"headword":"sondengovis","id":"shakespeare014.lex.primer_letters_book","ipa":"","label":"primer_letters_book","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sondengovis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"An alphabet primer. The Bastard mocks a stock answer learnt as if from a beginner's book.","id":"shakespeare014.lex.primer_letters_book.sense","status":"draft"}],"status":"draft","variants":[]},"ebf83ad74133c031a717f5fddff5f9831d62c8c8dd10a92e62ddedfabfcb2de3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: playing_card + game","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: playing_card + game","exampleIds":[],"headword":"falny\u00ebletfaln","id":"shakespeare014.lex.primero_card_game","ipa":"","label":"primero_card_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"falny\u00fcletfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The card game at which Gardiner left Henry with Suffolk. Its foreign name is rendered through native game vocabulary.","id":"shakespeare014.lex.primero_card_game.sense","status":"draft"}],"status":"draft","variants":[]},"0b5f66d648f04c90b657ec6ee234598bf2706362666aa108ede57cbb21b3a560":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: prince","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: prince","exampleIds":[],"headword":"var\u00dfn s\u00dflum","id":"shakespeare014.lex.princely_gift","ipa":"","label":"princely_gift","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"var\u014dn s\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Magnificently generous as a prince\u2019s gift, not a newly named prince giving the reward.","id":"shakespeare014.lex.princely_gift.sense","status":"draft"}],"status":"draft","variants":[]},"6ad2b47bcd19c21f97c2140c60650ca5716fb7136907421cacfc17ad6d30ba05":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: rule + land","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: rule + land","exampleIds":[],"headword":"var\u00dfnenjo\u00d9","id":"shakespeare014.lex.princely_territory","ipa":"","label":"princely_territory","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnenjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A territory under sovereign rule, offered in Antony\u2019s bitter imagined reward for his own head. Native rule-land; distinct from principal sums or heavenly powers.","id":"shakespeare014.lex.princely_territory.sense","status":"draft"}],"status":"draft","variants":[]},"98d65f1d919f5259fbac9c4318eaaac0acd8a8e7ef9c05ab82e7ad5f9005b8d3"