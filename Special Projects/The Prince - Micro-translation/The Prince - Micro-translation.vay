speare014.lex.port_blanc_brittany_bay.sense","status":"draft"}],"status":"draft","variants":[]},"0fd819cd8cbfee5468de5b077ecff3da5e8c0ba2397071e55b6fb0d8b494e1fe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: gate + guard","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: gate + guard","exampleIds":[],"headword":"daraljemek","id":"shakespeare014.lex.porter_gate","ipa":"","label":"porter_gate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"daraljemek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The household gatekeeper whom the servants accuse of admitting an unwelcome stranger. Native gate-guard; not a baggage carrier or a new named character.","id":"shakespeare014.lex.porter_gate.sense","status":"draft"}],"status":"draft","variants":[]},"adfbe974917e7026a8bc3568af781150826c1965d0b1cebdf82c66268b8ac8e5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"portia","id":"shakespeare014.lex.portia_belmont_heiress","ipa":"","label":"portia_belmont_heiress","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"portia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"definition":"The heiress of Belmont who argues the bond case. Bassanio compares her with Cato's daughter; they are separate women.","id":"shakespeare014.lex.portia_belmont_heiress.sense","status":"draft"}],"status":"draft","variants":[]},"33be79ebf1e6af3ca36a8bc0da4a398190cfa63d953a75a16eb22e1537782464":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare01