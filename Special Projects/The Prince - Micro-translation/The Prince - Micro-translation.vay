.4.","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Source-specific learner pronunciation in Henry V 3.4.","exampleIds":[],"headword":"\u00d1e","id":"shakespeare014.lex.lesson_le","ipa":"","label":"lesson_le","notes":"","orthographyId":"thimfora-79","partOfSpeech":"particle","pronunciation":"che","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A clipped native pointing form registers the switch into French le just before a quoted English noun.","id":"shakespeare014.lex.lesson_le.sense","status":"draft"}],"status":"draft","variants":[]},"43249075f1a8d376f950f7c671f860b5c4afe3d3b6f7e1ec3172c38722c479f6":{"audioLinks":[],"citations":[{"locator":"Source-specific learner pronunciation in Henry V 3.4.","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Source-specific learner pronunciation in Henry V 3.4.","exampleIds":[],"headword":"meljeran","id":"shakespeare014.lex.lesson_nails_mailes","ipa":"","label":"lesson_nails_mailes","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"meljeran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Katherine displaces the initial consonant in her recall of fingernails. Alice supplies the ordinary word.","id":"shakespeare014.lex.lesson_nails_mailes.sense","status":"draft"}],"status":"draft","variants":[]},"829b5f28b800ea931a02fa2be6525e6219bfe2f7f860d353eb23cce2fe2b3862":{"audioLinks":[],"citations":[{"locator":"Source-specific learner pronunciation in Henry V 3.4.","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Source-specific learner pronunciation in Henry V 3.4.","exampleIds":[],"headword":"harinkl\u00e1r","id":"shakespeare014.lex.lesson_neck_nick","ipa":"","label":"lesson_neck_nick","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harinkl\u00f4r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Alice gives an accented form of neck, which Katherine repeats without correction.","id":"shakespeare014.lex.lesson_neck_nick.sense","status":"draft"}],"status":"draft","variants":[]},"0fe264b2f3a0168499446647cc54834cc7cbdc422a6816a4a2bf77a9d790a1f8":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"lestral","id":"shakespeare014.lex.lestrale_lord","ipa":"","label":"lestrale_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lestral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"French lord called between Foix and Bouciquault.","id":"shakespeare014.lex.lestrale_lord.sense","status":"draft"}],"status":"draft","variants":[]},"037d704f72d77ac6b3ca42ca983b1376dad52de19673779b210d746babbe78ed":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: heavy + sleep","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: heavy + sleep","exampleIds":[],"headword":"memvorplestense\u00db","id":"shakespeare014.lex.lethargy_slumber","ipa":"","label":"lethargy_slumber","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memvorplestensesh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Heavy unresponsive drowsiness in the hostile description of peace. Native heavy-sleep; distinct from healthy ordinary sleep or a moral judgment by the narrator.","id":"shakespeare014.lex.lethargy_slumber.sense","status":"draft"}],"status":"draft","variants":[]},"aeef60cef40556cf9bfdcd10199bbc2bbdf8106701619480206c2708360f722a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"lethe","id":"shakespeare014.lex.lethe_river","ipa":"","label":"lethe_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lethe","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The mythic river whose oblivion informs Pompey\u2019s Lethe\u2019d stupor. An allowed place-name adaptation; the name does not exempt ordinary words such as forgetting from native formation.","id":"shakespeare014.lex.lethe_river.sense","status":"draft"}],"status":"draft","variants":[]},"119e261eaee5440c8f4319a0db17de046e4f10261943d6993bac4978fdd42511":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: pair + bar + sign","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: pair + bar + sign","exampleIds":[],"headword":"parilzariljelam","id":"shakespeare014.lex.letter_joined_posts","ipa":"","label":"letter_joined_posts","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"parilzariljelam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Descriptive native name for the foreign capital H shape in Scarus\u2019s wound joke: paired upright bars joined across. The English H/ache sound pun is recorded as a translation loss, not falsely reproduced by native phonology.","id":"shakespeare014.lex.letter_joined_posts.sense","status":"draft"}],"status":"draft","variants":[]},"21dbd0b208d128e1d4ea5ca3bd703d2f9afd333379122e8d32f4ee7e1d1618a5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of manner","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of manner","exampleIds":[],"headword":"f\u00c7l","id":"shakespeare014.lex.letter_tenor","ipa":"","label":"letter_tenor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u00e3l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The prevailing tone or drift of a written message, here Silvius\u2019s guess at anger from Phoebe\u2019s behaviour. Contextual native manner; not a musical vocal range.","id":"shakespeare014.lex.letter_tenor.sense","status":"draft"}],"status":"draft","variants":[]},"03a68df701769ffb13a634741cd6341b8fa2833801fc956de6f3578cd520b948":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: top + bar + sign","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: top + bar + sign","exampleIds":[],"headword":"naorthreninzariljelam","id":"shakespeare014.lex.letter_top_cross","ipa":"","label":"letter_top_cross","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"naorthreninzariljelam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Descriptive native name for the foreign capital T shape in Scarus\u2019s wound joke: a stem crossed at its top. It does not assert that a Thimfora glyph has the Roman T outline.","id":"shakespeare014.lex.letter_top_cross.sense","status":"draft"}],"status":"draft","variants":[]},"2a0857bc02ac2e73c51b0b132b0309169069ee5dcda57634ffda8ad3ccd950fc":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: milk + leaf","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: milk + leaf","exampleIds":[],"headword":"melaty\u00eblet","id":"shakespeare014.lex.lettuce_garden_leaf","ipa":"","label":"lettuce_garden_leaf","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melaty\u00fclet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The garden plant with milky sap. Iago sets sowing it beside planting nettles.","id":"shakespeare014.lex.lettuce_garden_leaf.sense","status":"draft"}],"status":"draft","variants":[]},"de307d0c1f163bb5738dfcfe422930285019671dc26d01b6d67321c2897d99b8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: gather + soldier","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: gather + soldier","exampleIds":[],"headword":"z\u00dfgu\u00d9hefak gurs\u00dflum","id":"shakespeare014.lex.levy_forces","ipa":"","label":"levy_forces","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u014dgunghefak gurs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Forces raised for a campaign and the investment in raising them. The lord complains about the benefit lost when Coriolanus agreed terms.","id":"shakespeare014.lex.levy_forces.sense","status":"draft"}],"status":"draft","variants":[]},"2d9b2d2eb160ec9a2b9680a2ad7a5cefe81c0a38da35d2ad697df690a0634150":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"luis","id":"shakespeare014.lex.lewis_emperor","ipa":"","label":"lewis_emperor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"luis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The emperor named as son of Charles the Great and father of Lingare's father.","id":"shakespeare014.lex.lewis_emperor.sense","status":"draft"}],"status":"draft","variants":[]},"d07b4517e6a39d933bd5fd97023820322307c8816f4a206988221187740fd88b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"luis","id":"shakespeare014.lex.lewis_french_king","ipa":"","label":"lewis_french_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"luis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The French king whom Margaret and Warwick petition. Distinct from namesakes in the French genealogy.","id":"shakespeare014.lex.lewis_french_king.sense","status":"draft"}],"status":"draft","variants":[]},"2b4339abd7d489a5abae14e9dce656a387be2b3e5365c42065c7bddc465656a7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"luis","id":"shakespeare014.lex.lewis_tenth","ipa":"","label":"lewis_tenth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"luis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"King Lewis the Tenth, distinguished from Lewis the Emperor.","id":"shakespeare014.lex.lewis_tenth.sense","status":"draft"}],"status":"draft","variants":[]},"b1f5e62d3a4e1c0da924bdfff067b9855acb22c39fb06dcfe9a1cb0ac0c64886":{"audioLinks":[],"citations":[{"locator":"Authored native compound: lust + liberty + person","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: lust + liberty + person","exampleIds":[],"headword":"vor\u00c9lmmasers\u00dflum","id":"shakespeare014.lex.libertine_person","ipa":"","label":"libertine_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vor\u00e4lmmasers\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A person given to unrestrained sensual living in the Duke\u2019s accusation. Native lust + liberty + person, not the historical named synagogue group or a modern political affiliation.","id":"shakespeare014.lex.libertine_person.sense","status":"draft"}],"status":"draft","variants":[]},"b7158def001885640365618577d0e0c481c1d533a45159eaa5723ed4162bd550":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of free","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of free","exampleIds":[],"headword":"maser","id":"shakespeare014.lex.liberty","ipa":"","label":"liberty","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"maser","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Freedom to act, shading into licence in Sonnet 41; not a constitutional guarantee added to the scene.","id":"shakespeare014.lex.liberty.sense","status":"draft"}],"status":"draft","variants":[]},"4a98174f6f4167132c23130006a8f18c37cdec0e5aada5625cee5107dff222bf":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_libya","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_libya","exampleIds":[],"headword":"libya","id":"shakespeare014.lex.libya_region","ipa":"","label":"libya_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"libya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Libya as the named realm of Bocchus in Caesar\u2019s roster. Preserve the source attribution without modern borders or an unprinted historical correction.","id":"shakespeare014.lex.libya_region.sense","status":"draft"}],"status":"draft","variants":[]},"5b213f91ef8705957c60dae03d953e03468ae54bf8099fe1fde0a0abe07ed5b9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"likas","id":"shakespeare014.lex.lichas_attendant","ipa":"","label":"lichas_attendant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"likas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Hercules\u2019s attendant in Antony\u2019s imagined violent reenactment; a permitted personal name, not a generic messenger label.","id":"shakespeare014.lex.lichas_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"1c89351485888286e37ac2d61bb538b84fe21b733c56ac419f86fc0fbc22aec0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_lick","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_lick","exampleIds":[],"headword":"tomilsv\u00ebpel","id":"shakespeare014.lex.lick","ipa":"","label":"lick","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tomilsv\u00fcpel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Move the tongue over a surface, here a wounded hound licking its wound.","id":"shakespeare014.lex.lick.sense","status":"draft"}],"status":"draft","variants":[]},"971ed1af3706c173486d61a39aabfd93404c34559fabc4402298c0d53bbbd7d4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: rod + guard","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: rod + guard","exampleIds":[],"headword":"y\u00eblvenorjemeks\u00dflum","id":"shakespeare014.lex.lictor_roman_officer","ipa":"","label":"lictor_roman_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclvenorjemeks\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The Roman officer attending a magistrate with rods and coercive authority, whom Cleopatra fears as a rude captor. Native rod-guard; no number of rods or officers is inserted.","id":"shakespeare014.lex.lictor_roman_officer.sense","status":"draft"}],"status":"draft","variants":[]},"2b60d9fbcc859a5a14f978ff14d76a48b09a290cfa37d6985287a9a641a8320c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: false + accuse","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: false + accuse","exampleIds":[],"headword":"dlenmurlamtonda","id":"shakespeare014.lex.lie_challenge","ipa":"","label":"lie_challenge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlenmurlamtonda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Giving someone the lie: an accusation that they speak falsely. This is not a lie told by the accuser; qualified/direct are stages in Touchstone\u2019s quarrel parody.","id":"shakespeare014.lex.lie_challenge.sense","status":"draft"}],"status":"draft","variants":[]},"63e5c2cc35b38faea1fc501e1989d777196ecd67f592326c30b441ea87909aa0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: remain + messenger","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: remain + messenger","exampleIds":[],"headword":"dlen\u00dbemingaz\u00e9ms\u00dflum","id":"shakespeare014.lex.lieger_resident","ipa":"","label":"lieger_resident","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlenshemingaz\u00e9ms\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"An agent residing on behalf of someone elsewhere. The queen wants Imogen to lose the resident agent of her absent husband.","id":"shakespeare014.lex.lieger_resident.sense","status":"draft"}],"status":"draft","variants":[]},"1c7f1f07efc5c728dddd75b96f3be8ebf3da14918a7fb6350f9ca8f00516c21e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: lift + bar","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: lift + bar","exampleIds":[],"headword":"onegazaril","id":"shakespeare014.lex.lift_lever","ipa":"","label":"lift_lever","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"onegazaril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Falstaff imagines that he would need levers to get up from the ground.","id":"shakespeare014.lex.lift_lever.sense","status":"draft"}],"status":"draft","variants":[]},"2b8e3c26a3970f349d605968ccb4e6bf174392f0401ce86270858ba2f8bb7f3e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"ligarius","id":"shakespeare014.lex.ligarius_roman_conspirator","ipa":"","label":"ligarius_roman_conspirator","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ligarius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The Roman reproved by Caesar for praising Pompey, who joins Brutus despite his illness.","id":"shakespeare014.lex.ligarius_roman_conspirator.sense","status":"draft"}],"status":"draft","variants":[]},"f46bd984c6c0be5f3584f765be79236708b4660137287248548943b4304cea09":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: light_weight + love","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: light_weight + love","exampleIds":[],"headword":"memv\u00ebla\u00d9z","id":"shakespeare014.lex.light_o_love_song","ipa":"","label":"light_o_love_song","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"memv\u00fclangz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The song Margaret proposes, whose lightness leads to the joke about a burden and sexual levity.","id":"shakespeare014.lex.light_o_love_song.sense","status":"draft"}],"status":"draft","variants":[]},"efac8e434f7f16a0fee2e18298f90a04daabb6cac241e05b01a5d6ec17c8f5b6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of trifle","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of trifle","exampleIds":[],"headword":"vimin\u00d1et","id":"shakespeare014.lex.light_trifling","ipa":"","label":"light_trifling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"viminchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Lacking serious weight, the light answers Antony rejects. Not luminous or pale in colour.","id":"shakespeare014.lex.light_trifling.sense","status":"draft"}],"status":"draft","variants":[]},"1d9c01ce1b13e4df4b31ae2b9b6e16cb8620601d0e1ed4760181e75018eaddf8":{"audioLinks":[],"citations":[{"locator":"Authored native lexical root, not a claim of documented historical sound change.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Authored native lexical root, not a claim of documented historical sound change.","exampleIds":[],"headword":"memv\u00ebl","id":"shakespeare014.lex.light_weight","ipa":"","label":"light_weight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"memv\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Of little weight, motivated by native memvor (weight); distinct from visible illumination.","id":"shakespeare014.lex.light_weight.sense","status":"draft"}],"status":"draft","variants":[]},"cfdbab7d9dce893f2cb4d79bfbee745c7d24316192e1a51ef0767831e446f40e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of trifle","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of trifle","exampleIds":[],"headword":"vimin\u00d1et","id":"shakespeare014.lex.lightness_frivolity","ipa":"","label":"lightness_frivolity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Frivolity whose cost is a heavy weight on Antony\u2019s partners. The light/heavy metaphor is retained in the source review.","id":"shakespeare014.lex.lightness_frivolity.sense","status":"draft"}],"status":"draft","variants":[]},"202de936d459eedf91ae5be8ac8b6470819c24d5481bf94bd1e327c13ab36f12":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"veslin","id":"shakespeare014.lex.lily_native","ipa":"","label":"lily_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"veslin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The flower called lily in the source complexion image. Authored native flower-category root motivated by white ve\u0161, not a phonetic lily loan or a precise botanical identification.","id":"shakespeare014.lex.lily_native.sense","status":"draft"}],"status":"draft","variants":[]},"2ad67213788b998cf8600545528aba0da7f11668991487f8d68f172cb37a6c8f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: prison + spirit","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: prison + spirit","exampleIds":[],"headword":"kl\u00e1rjemz\u00e1lswifl\u00dfn","id":"shakespeare014.lex.limbo_infernal_confinement","ipa":"","label":"limbo_infernal_confinement","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kl\u00f4rjemz\u00f4lswifl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The place of confinement for souls with which Dromio compares his master's arrest.","id":"shakespeare014.lex.limbo_infernal_confinement.sense","status":"draft"}],"status":"draft","variants":[]},"bab5b8b9738adbd2fb0a2b316e4c9e6128cc746e831bbcf431468ef8ed92a7cb":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"laimhaus","id":"shakespeare014.lex.limehouse_london_place","ipa":"","label":"limehouse_london_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"laimhaus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"London place named in the porter's catalogue of unruly audiences.","id":"shakespeare014.lex.limehouse_london_place.sense","status":"draft"}],"status":"draft","variants":[]},"d34219aca6a6ff85b9fd1a600c078663a6693725d96cbd06b7ad547e8946e236":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"limoj","id":"shakespeare014.lex.limoges_austria_title","ipa":"","label":"limoges_austria_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"limoj","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Another address to the same lion-clad duke called Austria. Constance uses both names in one speech.","id":"shakespeare014.lex.limoges_austria_title.sense","status":"draft"}],"status":"draft","variants":[]},"b8ceb07309c321d023a6181b21966fcc72fa748bb084fe125be1cc20ac629676":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"palzin","id":"shakespeare014.lex.limp","ipa":"","label":"limp","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb/modifier","pronunciation":"palzin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Walk with an uneven impaired gait, the source halt beside lame; authored native leg-family term, preserving the paired source descriptors without adding a diagnosis.","id":"shakespeare014.l