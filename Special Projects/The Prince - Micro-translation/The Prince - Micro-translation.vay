he loud report of a great thing breaking in Caesar\u2019s reaction to Antony\u2019s death. A contextual audible crash, distinct from a narrow physical chink.","id":"shakespeare014.lex.crack_breaking_sound.sense","status":"draft"}],"status":"draft","variants":[]},"756fd262b2e7809ba3c169b49fee07877120a54b24163fc669a55b9f0654c805":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: boy","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: boy","exampleIds":[],"headword":"nevpelen","id":"shakespeare014.lex.crack_youngster","ipa":"","label":"crack_youngster","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nevpelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A lively young boy or little rascal, Virgilia\u2019s modest response to the praise of her child. Not a split, a sound, or an invented injury.","id":"shakespeare014.lex.crack_youngster.sense","status":"draft"}],"status":"draft","variants":[]},"ee9a2c2aa7c2e1b4cee714dea7ff8316d9abdbe30ac7cc219ee459fb3397b298":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: crack","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: crack","exampleIds":[],"headword":"chiril","id":"shakespeare014.lex.cracked_split","ipa":"","label":"cracked_split","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"chiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Split or damaged, the low-value drachma in Martius\u2019s comparison; not the lively-boy sense of crack.","id":"shakespeare014.lex.cracked_split.sense","status":"draft"}],"status":"draft","variants":[]},"d131fb447f964f433f42726963ace896413834e4d62063637e5368451671b199":{"audioLinks":[],"citations":[{"locator":"Native infant + bed; authored source-category compound.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Native infant + bed; authored source-category compound.","exampleIds":[],"headword":"nevpelbelen","id":"shakespeare014.lex.cradle_baby","ipa":"","label":"cradle_baby","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nevpelbelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An infant\u2019s bed, the cradle from which the cousins were raised together. Native infant + bed replaces the unjustified inherited cradil imitation for this new work; earlier sealed editions are unchanged.","id":"shakespeare014.lex.cradle_baby.sense","status":"draft"}],"status":"draft","variants":[]},"8ac740f5668b2e0a91efb1c2de677d93da5815f4239c7c49c67e8ac9270ba600":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from child, bed","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from child, bed","exampleIds":[],"headword":"pelbelen","id":"shakespeare014.lex.cradle_native","ipa":"","label":"cradle_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pelbelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A small resting bed for a baby, figuratively Venus\u2019s hollow breast; native child-bed instead of a sound-copy of cradle.","id":"shakespeare014.lex.cradle_native.sense","status":"draft"}],"status":"draft","variants":[]},"f80f8676fd8a7073b5496fa1a624a29f280f65eba5c1a6ef791a8f2776f843a5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: trade + secret","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: trade + secret","exampleIds":[],"headword":"kwisto\u00c3bren","id":"shakespeare014.lex.craft_mystery_trade","ipa":"","label":"craft_mystery_trade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kwistojzhbren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"A skilled calling with its own mysteries. Abhorson and Pompey debate whose trade merits the title.","id":"shakespeare014.lex.craft_mystery_trade.sense","status":"draft"}],"status":"draft","variants":[]},"5de44b37d01601aa9c517b40de5b3ad93d616889a2acc5e6b2235c95c56518b1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kranmer","id":"shakespeare014.lex.cranmer_archbishop","ipa":"","label":"cranmer_archbishop","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kranmer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The scholar for whose return Henry wishes when the cardinals adjourn the first hearing.","id":"shakespeare014.lex.cranmer_archbishop.sense","status":"draft"}],"status":"draft","variants":[]},"ce959d08858e53c2d02c4e5ff945725b2eda8723a1a09e002392b92c46ddcbbb":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"krasus","id":"shakespeare014.lex.crassus_general","ipa":"","label":"crassus_general","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"krasus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Crassus, whose death Ventidius claims to avenge. The name stays separate from Antony and from the Parthian king and son.","id":"shakespeare014.lex.crassus_general.sense","status":"draft"}],"status":"draft","variants":[]},"6467c5937aa552a6e80ba297b6826e94428d0adee55b6ed4b19735d1104567b5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"krasus","id":"shakespeare014.lex.crassus_vienna_contact","ipa":"","label":"crassus_vienna_contact","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"krasus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The local man named with Valencius and Rowland, distinct from the Roman general.","id":"shakespeare014.lex.crassus_vienna_contact.sense","status":"draft"}],"status":"draft","variants":[]},"25bb287edb0a65188783b424a32173ff90c306472cc5076ee76c65aa85d8f4c4":{"audioLinks":[],"citations":[{"locator":"Authored native compound: milk + top","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: milk + top","exampleIds":[],"headword":"melatnaorthrenin","id":"shakespeare014.lex.cream_milk","ipa":"","label":"cream_milk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melatnaorthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The rich upper part of milk, native milk + top, in the pale-cheek image. No cosmetic preparation or modern manufacturing process.","id":"shakespeare014.lex.cream_milk.sense","status":"draft"}],"status":"draft","variants":[]},"ad39a5e2255378d2950f3b2798d2ffc834b73171b7cb38ea31f3e031fed147e3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of invention","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of invention","exampleIds":[],"headword":"ble\u00dbta","id":"shakespeare014.lex.creative_invention","ipa":"","label":"creative_invention","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"bleshta","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The faculty or exercise of devising verse, Jaques\u2019s invention. In despite of it preserves his self-disparaging paradox; does not assert an independently known motive for writing the parody.","id":"shakespeare014.lex.creative_invention.sense","status":"draft"}],"status":"draft","variants":[]},"d33438b3c653db411e67e99a9f9a688f235f9cb31c6b92f01698d98900e15153":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kreon","id":"shakespeare014.lex.creon_theban_king","ipa":"","label":"creon_theban_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kreon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The ruler of Thebes who denies burial to the queens' husbands, and uncle of the two kinsmen.","id":"shakespeare014.lex.creon_theban_king.sense","status":"draft"}],"status":"draft","variants":[]},"03ad7fab8e191a3952bc8c3cd802a5c0ed7c01a2500e6a5531f428d4ec64dc0e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: moon + grow","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: moon + grow","exampleIds":[],"headword":"m\u00ebnirragum","id":"shakespeare014.lex.crescent_waxing","ipa":"","label":"crescent_waxing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"m\u00fcnirragum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Grow or increase toward fullness, Pompey\u2019s crescent forces and forecasting hope. The native moon-grow preserves the lunar image alongside the political growth, without assigning a lunar date.","id":"shakespeare014.lex.crescent_waxing.sense","status":"draft"}],"status":"draft","variants":[]},"fc0206edeced0e5b8f606d811a58da923b28c7a085424c7612ef6283c8ec26cf":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kresid","id":"shakespeare014.lex.cressid_short_name","ipa":"","label":"cressid_short_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kresid","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"definition":"Short form of Cressida, the daughter of Calchas.","id":"shakespeare014.lex.cressid_short_name.sense","status":"draft"}],"status":"draft","variants":[]},"2036367b9485bc9d62ab30604c1675fa5fcd1ce6b65a275a447e690dae6b85ca":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"kresi","id":"shakespeare014.lex.cressy_field","ipa":"","label":"cressy_field","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kresi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The battlefield in the French king's recollection of Edward the Black Prince.","id":"shakespeare014.lex.cressy_field.sense","status":"draft"}],"status":"draft","variants":[]},"2b6c93e7a51f0470827603c95fca09eb80b5c23dd816242bc79f770000229896":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of crown","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of crown","exampleIds":[],"headword":"varil","id":"shakespeare014.lex.crest_crown","ipa":"","label":"crest_crown","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"varil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Form the crest or crowning summit of something, Antony\u2019s raised arm above the world. Verbal extension of native crown; not the crown coin.","id":"shakespeare014.lex.crest_crown.sense","status":"draft"}],"status":"draft","variants":[]},"b3bb49d5176743f5afbe6110849fd58ae0321edcb6ed5373cfbb5c64840d2bd1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cricket_singer","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: cricket_singer","exampleIds":[],"headword":"liljivem","id":"shakespeare014.lex.cricket_fairy_player","ipa":"","label":"cricket_fairy_player","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"liljivem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The named fairy ordered to inspect the chimneys, distinct from the literal singing insect.","id":"shakespeare014.lex.cricket_fairy_player.sense","status":"draft"}],"status":"draft","variants":[]},"79e74b99583f1334b3deb5cc252530e50a7f7fce2a741c1e24b594ae1c266685":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sing + insect","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: sing + insect","exampleIds":[],"headword":"liljivem","id":"shakespeare014.lex.cricket_singer","ipa":"","label":"cricket_singer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"liljivem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The chirping insect heard in the room while Imogen sleeps.","id":"shakespeare014.lex.cricket_singer.sense","status":"draft"}],"status":"draft","variants":[]},"9cdd5eae4117f1a2521e22245122fb5d44e0c8cfbae49f64e2876fe04c49350e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: court + call","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: court + call","exampleIds":[],"headword":"var\u00dfnkin\u00d3\u00c5\u00e7","id":"shakespeare014.lex.crier_court","ipa":"","label":"crier_court","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnkinth\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The officer who repeats the summons to Henry and Katherine.","id":"shakespeare014.lex.crier_court.sense","status":"draft"}],"status":"draft","variants":[]},"b06c97be5b9c4e6101c37e800590aa7b6ef184093d8c00ea81362026ae215333":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"krispian","id":"shakespeare014.lex.crispian_saint","ipa":"","label":"crispian_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"krispian","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The other saint of the shared feast, called Crispian in Henry's address.","id":"shakespeare014.lex.crispian_saint.sense","status":"draft"}],"status":"draft","variants":[]},"b3254be8b977e67151a2ddffd3b80159e4327fbe673b10d4cc0a068922025043":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"krispianus","id":"shakespeare014.lex.crispianus_saint","ipa":"","label":"crispianus_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"krispianus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The king uses this longer form of Crispian's name when he names the field of Agincourt.","id":"shakespeare014.lex.crispianus_saint.sense","status":"draft"}],"status":"draft","variants":[]},"7683edaff00bde1e3bbaabd26859fe347cf94aeaf57af49e3c8a5d8ac7bbab35":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"krispin","id":"shakespeare014.lex.crispin_saint","ipa":"","label":"crispin_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"krispin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The saint named in the final cry of Henry's speech; the shared feast also honors Crispian.","id":"shakespeare014.lex.crispin_saint.sense","status":"draft"}],"status":"draft","variants":[]},"a10b89c0707ff440495c63fb5e39336a80424fbabeb2ceb6a24df01d547663c4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: river + kjv_lizard","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: river + kjv_lizard","exampleIds":[],"headword":"nilom\u00d3\u00ddrven","id":"shakespeare014.lex.crocodile_creature","ipa":"","label":"crocodile_creature","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nilomth\u012brven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The large river reptile named in the Egyptian drinking conversation. Native river-lizard is a lexicalized creature name, not a claim about modern taxonomy or a respelling of the English/Greek word.","id":"shakespeare014.lex.crocodile_creature.sense","status":"draft"}],"status":"draft","variants":[]},"ac11150dc2ceda7ecfa39925d1eb03f7b29b13a870cfdc46ac463634983422c5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kromer","id":"shakespeare014.lex.cromer_son_in_law","ipa":"","label":"cromer_son_in_law","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kromer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"Saye's son-in-law, whose head is brought to Cade together with Saye's head.","id":"shakespeare014.lex.cromer_son_in_law.sense","status":"draft"}],"status":"draft","variants":[]},"228c8535f31650d0bee726fe62429ee99aacf5a9b479124b554b6ef060656eb5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kromwel","id":"shakespeare014.lex.cromwell_title","ipa":"","label":"cromwell_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kromwel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The title coupled with Wingfield in Lucy's roll.","id":"shakespeare014.lex.cromwell_title.sense","status":"draft"}],"status":"draft","variants":[]},"862d2f4428a28c08705c0b752a9cc3ce445b2e21e69c545a3c178a8c0045bf6e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kromwel","id":"shakespeare014.lex.cromwell_wolsey_servant","ipa":"","label":"cromwell_wolsey_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kromwel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Wolsey's servant who hands the sealed packet to Henry. Distinct from the title recited at Talbot's funeral.","id":"shakespeare014.lex.cromwell_wolsey_servant.sense","status":"draft"}],"status":"draft","variants":[]},"fbb3cab8fbbabd451decb74f35ed7a38312eac5ece2ec2bb0b1a99e6a70fe02d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of crop","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of crop","exampleIds":[],"headword":"trornek","id":"shakespeare014.lex.crop_bear","ipa":"","label":"crop_bear","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"trornek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Bear a crop in Agrippa\u2019s sexual farming metaphor for Cleopatra\u2019s pregnancy by Julius Caesar; not reap or cut away an already-grown crop. No unprinted child name is added.","id":"shakespeare014.lex.crop_bear.sense","status":"draft"}],"status":"draft","variants":[]},"02ef564d3d5c0978640cd9237d782d08535ff52ccf90529e6bb414280410454d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"krosbi","id":"shakespeare014.lex.crosby_richard_house","ipa":"","label":"crosby_richard_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"krosbi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The London house Richard names to Anne.","id":"shakespeare014.lex.crosby_richard_house.sense","status":"draft"}],"status":"draft","variants":[]},"9dbf520b8a2402b3e8eae3564a58fd12c5dccfeb408d20a66ac3c5d206a84f0d":{"audioLinks":[],"citations":[{"locator":"Authored native compound: cross + mark","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: cross + mark","exampleIds":[],"headword":"tharden","id":"shakespeare014.lex.cross_mark","ipa":"","label":"cross_mark","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tharden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An intersecting cross-shaped mark or object, invoked through the stamp on source-culture coins in Touchstone\u2019s joke. Native cross + mark retains the shape; its monetary implication follows the purse clause. Not a new native religious doctrine.","id":"shakespeare014.lex.cross_mark.sense","status":"draft"}],"status":"draft","variants":[]},"8b3b1da081296fba452f815ddcedb94b944b346a3c2c0d5c7a7dc824dc9daa81":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cross + bow_weapon","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Authored native derivation or sense: cross + bow_weapon","exampleIds":[],"headword":"tharlunorthiril","id":"shakespeare014.lex.crossbow_hunter","ipa":"","label":"crossbow_hunter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tharlunorthiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The hunters' bows with a transverse bow and stock. The sound of the shot may alarm the herd.","id":"shakespeare014.lex.crossbow_hunter.sense","status":"draft"}],"status":"draft","variants":[]},"c1b32698f03b631aeedefeab253e3bdb2799c3f9f0a4a507a8f4e849c81bb178":{"audioLinks":[],"citations":[{"locator":"Native compound of black, bird","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"Native compound of black, bird","exampleIds":[],"headword":"k\u00c9\u00cfnwil","id":"shakespeare014.lex.crow_bird","ipa":"","label":"crow_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"k\u00e4\u00cfnwil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Crow: lexicalized native black-bird compound identifying the crow species category in this poem; not every black bird.","id":"shakespeare014.lex.crow_bird.sense","status":"draft"}],"status":"draft","variants":[]},"05c87137072a406bfdb28903176cf240b89a643c7d2185704b76ab860e673a18":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"sulmar","id":"shakespeare014.lex.crowd","ipa":"","label":"crowd","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun/verb","pronunciation":"sulmar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A close gathering of people; verb to press together in a crowd. Authored people-family collective, distinct from all people generally.","id":"shakespeare014.lex.crowd.sense","status":"draft"}],"status":"draft","variants":[]},"5bcca6248df7c0af5acad6f96c867d10a15cfdb09adac03e6b8b29aa935e2e0f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: crow_bird + flower","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: crow_bird + flower","exampleIds":[],"headword":"k\u00c9\u00cfnwilyelfal","id":"shakespeare014.lex.crowflower_bloom","ipa":"","label":"crowflower_bloom","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"k\u00e4\u00cfnwilyelfal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The crowflowers in Gertrude's account of Ophelia's garlands. Preserve the source plant label without specifying a modern species.","id":"shakespeare014.lex.crowflower_bloom.sense","status":"draft"}],"status":"draft","variants":[]},"dd7fc975eca60195e867d15fef87a35558bb2853b0589683268bf53c3755f7ba":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of crown","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of crown","exampleIds":[],"headword":"varil","id":"shakespeare014.lex.crown_adorn","ipa":"","label":"crown_adorn","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"varil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Adorn the hair or head with a wreath-like crown in the drinking song. Native crown made verbal; not payment with a coin or an unstated coronation as ruler.","id":"shakespeare014.lex.crown_adorn.sense","status":"draft"}],"status":"draft","variants":[]},"0d466757708e0a9b3c7247f8167c1b08629423ce6f08dc53bf22c7adb606f209":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of mend","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of mend","exampleIds":[],"headword":"fader","id":"shakespeare014.lex.crown_arrange","ipa":"","label":"crown_arrange","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"fader","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Put a crown back into its proper arrangement, Charmian\u2019s final task. Native restoring-to-order, not cutting or trimming material off the diadem.","id":"shakespeare014.lex.crown_arrange.sense","status":"draft"}],"status":"draft","variants":[]},"6c62eb167dcfeb791db9e19ffabc36f0349b8ff2e710ac25897ed2d0d63e62e6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of crown","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of crown","exampleIds":[],"headword":"varil","id":"shakespeare014.lex.crown_currency","ipa":"","label":"crown_currency","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"varil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The source crown coin in Orlando\u2019s inheritance, not a royal headpiece. Preserve the stated count without converting to a modern currency.","id":"shakespeare014.lex.crown_currency.sense","status":"draft"}],"status":"draft","variants":[]},"128af135cda80c64adfa7a72f49b20ae9bd10f3a5a8476670405276dd788783d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: crown","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: crown","exampleIds":[],"headword":"varil","id":"shakespeare014.lex.crown_head_henry","ipa":"","label":"crown_head_henry","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"varil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The crown of a person's head. Shares the form of the crown coin in Henry's twenty-to-one joke.","id":"shakespeare014.lex.crown_head_henry.sense","status":"draft"}],"status":"draft","variants":[]},"793c17f9b03db25e5ff1624d1fd7509aee9cd3d9b11cf20c9e6a6fbc7e75dcec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: crown + bell","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: crown + bell","exampleIds":[],"headword":"varilzarviminolen","id":"shakespeare014.lex.crown_imperial_flower","ipa":"","label":"crown_imperial_flower","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"varilzarviminolen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The flowering plant with a crown of hanging bells in the spring garland speech.","id":"shakespeare014.lex.crown_imperial_flower.sense","status":"draft"}],"status":"draft","variants":[]},"98c2a5727bd73ea42ec386d265cdd0175828e3f58c816bcab504b952124016be":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: tail + strap","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: tail + strap","exampleIds":[],"headword":"vorh\u00eb\u00d3skirenthiril","id":"shakespeare014.lex.crupper_saddle_strap","ipa":"","label":"crupper_saddle_strap","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorh\u00fcthskirenthiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The strap that passes under the tail to secure the saddle. Sixpence was paid to the saddler.","id":"shakespeare014.lex.crupper_saddle_strap.sense","status":"draft"}],"status":"draft","variants":[]},"ed8121a468b34799d1fe142ebbe365cfe1936c088b299f634b7727aeffa00363":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cross_mark + coin_currency","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: cross_mark + coin_currency","exampleIds":[],"headword":"thardenzarzarven","id":"shakespeare014.lex.crusado_portuguese_coin","ipa":"","label":"crusado_portuguese_coin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thardenzarzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The cross-marked Portuguese coin in Desdemona's imagined full purse. Its number and exchange value are unspecified.","id":"shakespeare014.lex.crusado_portuguese_coin.sense","status":"draft"}],"status":"draft","variants":[]},"d2175364e9e18efb5b9d223f0ed8b1eefa67fe88710bd533ff1fd2dc26fe458e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: walk + support","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: walk + support","exampleIds":[],"headword":"m\u00e5rhalemin\u00d7","id":"shakespeare014.lex.crutch_aid","ipa":"","label":"crutch_aid","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mourhalemin\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A support used by someone with impaired walking, Lartius\u2019s proposed support and improvised weapon; no medical cause added.","id":"shakespeare014.lex.crutch_aid.sense","status":"draft"}],"status":"draft","variants":[]},"948d96d4fbdc39e966d2c57f7e4343d31d25918d69655387c38751228df22897":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: other + nest + bird","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored nativ