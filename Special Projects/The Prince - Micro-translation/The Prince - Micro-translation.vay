d native derivation/sense: direction + circle","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: direction + circle","exampleIds":[],"headword":"marjo\u00d9olen","id":"shakespeare014.lex.compass_directions","ipa":"","label":"compass_directions","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"marjongolen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The whole circle of directions in the citizens\u2019 scattering-wits joke. No particular number of points or invented navigational instrument appears.","id":"shakespeare014.lex.compass_directions.sense","status":"draft"}],"status":"draft","variants":[]},"02cd4e526bb047a7a2e49e79b920fe4d413ce3967e16dc42d23c5ee9ae06b30a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of partner","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of partner","exampleIds":[],"headword":"inst\u00dfb\u00dfs\u00dflum","id":"shakespeare014.lex.competitor_colleague","ipa":"","label":"competitor_colleague","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"inst\u014db\u014ds\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Antony as Caesar\u2019s fellow ruler, source competitor. Not merely a rival contestant; political antagonism does not erase their shared office.","id":"shakespeare014.lex.competitor_colleague.sense","status":"draft"}],"status":"draft","variants":[]},"b99f0bf725c8b07657df7ae0f149cc724d94d7403d9c0acea2a4d0249de151aa":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of complaint","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of complaint","exampleIds":[],"headword":"murlamgiktenv\u00d7en","id":"shakespeare014.lex.complain","ipa":"","label":"complain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murlamgiktenv\u0113en","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Give voice to a grievance, verbal conversion of complaint.","id":"shakespeare014.lex.complain.sense","status":"draft"}],"status":"draft","variants":[]},"61e03629195d78ae307fda2122e54b78865181965c6e9e24616daf95ccfcba21":{"audioLinks":[],"citations":[{"locator":"Authored native compound: face + colour","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: face + colour","exampleIds":[],"headword":"ub\u00e1nt\u00e9vl\u00c7m","id":"shakespeare014.lex.complexion_colour","ipa":"","label":"complexion_colour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ub\u00f4nt\u00e9vl\u00e3m","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Colour or visible appearance of the face, native face + colour. Good my complexion retains the source apostrophe and its interpretive uncertainty; do not emend it to Hudson\u2019s complicator.","id":"shakespeare014.lex.complexion_colour.sense","status":"draft"}],"status":"draft","variants":[]},"766bd2eb8e5bbe37ab184e6264d71ec593ed51957b1a820402ecbae68fab0a3d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: face + colour","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: face + colour","exampleIds":[],"headword":"ub\u00e1nt\u00e9vl\u00c7m","id":"shakespeare014.lex.complexion_face","ipa":"","label":"complexion_face","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ub\u00f4nt\u00e9vl\u00e3m","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The various facial appearances or colours of the spectators, without converting the source phrase into modern ethnic categories.","id":"shakespeare014.lex.complexion_face.sense","status":"draft"}],"status":"draft","variants":[]},"63c60a3d94ce3ee229c4d9ad56fba7c99a840b50e47702b7bec27cc4cb0910c9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of courtesy","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of courtesy","exampleIds":[],"headword":"var\u00dfnkinf\u00c7l","id":"shakespeare014.lex.compliment_formal","ipa":"","label":"compliment_formal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnkinf\u00e3l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Ceremonial expressions of politeness or thanks in Jaques\u2019s contemptuous comparison. Contextual courtesy, not necessarily a factual praise of merit.","id":"shakespeare014.lex.compliment_formal.sense","status":"draft"}],"status":"draft","variants":[]},"1dedb503e92e68552a8624105cebe575f0f5b86bbbaede9de84bc94fb6b14cc4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of nature","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of nature","exampleIds":[],"headword":"jo\u00d9\u00d5\u00dfren","id":"shakespeare014.lex.composure_constitution","ipa":"","label":"composure_constitution","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jong\u0167h\u014dren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The constitution or combination of qualities making a person, source composure. Not merely outward calm.","id":"shakespeare014.lex.composure_constitution.sense","status":"draft"}],"status":"draft","variants":[]},"910a10ea7108fdd985823cb6ee62c24ff58a7b23c75370c745a57019b436f0fe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: mix + medicine","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: mix + medicine","exampleIds":[],"headword":"j\u00c9gwa\u00c3fadervoren","id":"shakespeare014.lex.compound_confection","ipa":"","label":"compound_confection","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"j\u00e4gwajzhfadervoren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A preparation mixed by the queen. She boasts of the king repeatedly asking for hers.","id":"shakespeare014.lex.compound_confection.sense","status":"draft"}],"status":"draft","variants":[]},"2161a4cf2ab7a78074ca00b818301f839e998bc6ecd3e0649a61e99cb46da6d6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: receive + thought","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: receive + thought","exampleIds":[],"headword":"mlapv\u00d7staw\u00c5vumen","id":"shakespeare014.lex.conceive_comprehend","ipa":"","label":"conceive_comprehend","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"mlapv\u0113staw\u0101vumen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Kent's inability to conceive what Gloucester means. The paired bodily sense answers his phrase.","id":"shakespeare014.lex.conceive_comprehend.sense","status":"draft"}],"status":"draft","variants":[]},"04073925e5c57fa2747a590be200659f101941b3bb1efdb4a67fa721e3d2af13":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: receive + child","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: receive + child","exampleIds":[],"headword":"mlapv\u00d7stapel","id":"shakespeare014.lex.conceive_in_womb","ipa":"","label":"conceive_in_womb","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"mlapv\u0113stapel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Gloucester applies the shared native receive construction to Edmund's mother's pregnancy.","id":"shakespeare014.lex.conceive_in_womb.sense","status":"draft"}],"status":"draft","variants":[]},"f2dce404199a2ceb36b989a0427f39760d6ca66e5f7ee2c5d0a160299231c5b1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: plan","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: plan","exampleIds":[],"headword":"p\u00e1ns\u00ebr","id":"shakespeare014.lex.conceived_plan","ipa":"","label":"conceived_plan","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4ns\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An intended enterprise or design, Aufidius\u2019s great pretenses; not chiefly an allegation that the plans are fraudulent.","id":"shakespeare014.lex.conceived_plan.sense","status":"draft"}],"status":"draft","variants":[]},"eebf69932a401904e2e2cf7f81570b9d35a4b7fb9c831391cfd385b2bd54c8a3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of condemn","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of condemn","exampleIds":[],"headword":"murlamjor","id":"shakespeare014.lex.condemn_discredit","ipa":"","label":"condemn_discredit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murlamjor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Judge an imitation inadequate or worthless, the imagined Antony putting fancy\u2019s shadows to shame. Extends native adverse judgment without imposing criminal punishment.","id":"shakespeare014.lex.condemn_discredit.sense","status":"draft"}],"status":"draft","variants":[]},"251f5e90d64f72bb73167e58d023c58c35106d1295dea3ecb4570b90a6047683":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: grief + pay","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: grief + pay","exampleIds":[],"headword":"w\u00e9asemv\u00df\u00d5","id":"shakespeare014.lex.condolement_fishermans_fee","ipa":"","label":"condolement_fishermans_fee","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00e9asemv\u014d\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"Grief-pay, a comic word for the fisherman's expected recompense. It mixes a word of mourning into his demand for a tip.","id":"shakespeare014.lex.condolement_fishermans_fee.sense","status":"draft"}],"status":"draft","variants":[]},"4e2a9a4aa6ee28a4da294408608b9de831fc8f742556c52779abc76b1e70af5b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of behaviour","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of behaviour","exampleIds":[],"headword":"f\u00c7lf\u00d7venor","id":"shakespeare014.lex.conduct_life","ipa":"","label":"conduct_life","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u00e3lf\u0113venor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Conversation in its manner-of-living sense, Octavia\u2019s holy, cold and still disposition. Not merely how she talks in a conversation.","id":"shakespeare014.lex.conduct_life.sense","status":"draft"}],"status":"draft","variants":[]},"b8b688bdbf4c1708f25ae8f6a8e5f6693cff5ef6acf735d857049fa76f862803":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_conduit","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_conduit","exampleIds":[],"headword":"yems\u00d7marjo\u00d9","id":"shakespeare014.lex.conduit","ipa":"","label":"conduit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113marjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A water-carrying passage, in the women\u2019s tear-stream comparison; no unprinted mechanism.","id":"shakespeare014.lex.conduit.sense","status":"draft"}],"status":"draft","variants":[]},"fda6255629213b128833d382dcb5072b5b60fd35e51b9a491547ec6dcd3023f0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: meet + speak","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: meet + speak","exampleIds":[],"headword":"tw\u00ddnjybgiktenv\u00d7","id":"shakespeare014.lex.conference_meeting","ipa":"","label":"conference_meeting","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tw\u012bnjybgiktenv\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"An occasion to meet and converse. Iachimo asks for the opportunity of a second such meeting with Imogen.","id":"shakespeare014.lex.conference_meeting.sense","status":"draft"}],"status":"draft","variants":[]},"a77895174375d11811d63c88fad545f2b118616df5d513ced5d1596c276aab22":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of confine","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of confine","exampleIds":[],"headword":"threngl\u00c9z\u00cben","id":"shakespeare014.lex.confinement_prison","ipa":"","label":"confinement_prison","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"threngl\u00e4zhwen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The prison bounds imposed on Lepidus and imagined released only by death. Native confine used as a place/state noun; not a precise cell dimension.","id":"shakespeare014.lex.confinement_prison.sense","status":"draft"}],"status":"draft","variants":[]},"dbf7dbf74a867cd422f5ef5332870145b4beff5652a2bdf7d1803af85d9f790b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of confirm","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of confirm","exampleIds":[],"headword":"lamemkl\u00e1rjem","id":"shakespeare014.lex.confirm_report","ipa":"","label":"confirm_report","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"lamemkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Demonstrate that a report is true, source approves the common liar in 1.1. Does not mean moral approval of the liar or a new binding legal agreement.","id":"shakespeare014.lex.confirm_report.sense","status":"draft"}],"status":"draft","variants":[]},"0d8e6d511ec75e38b974ef259cae273e435e8b11f475aa165668dc3ae99cacc8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: long + sea + fish_creature","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: long + sea + fish_creature","exampleIds":[],"headword":"venormerdrig\u00e1l","id":"shakespeare014.lex.conger_fish","ipa":"","label":"conger_fish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venormerdrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The marine eel in Doll's insult and in Falstaff's account of Poins's tastes.","id":"shakespeare014.lex.conger_fish.sense","status":"draft"}],"status":"draft","variants":[]},"b4728e8ade7f30f2b3dff6ce35932ce7099a5dd8cf59d8807bf5633ae5e676a8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spirit + shape","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Authored native derivation or sense: spirit + shape","exampleIds":[],"headword":"swifl\u00dfnl\u00dfn","id":"shakespeare014.lex.conjured_apparition","ipa":"","label":"conjured_apparition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"swifl\u014dnl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"One of the spirits appearing in a distinct form and speaking to Macbeth at the cauldron.","id":"shakespeare014.lex.conjured_apparition.sense","status":"draft"}],"status":"draft","variants":[]},"1fbd54b146c4a7afd4249eb69e20c96d6763915c62e94c2cae9e8a33b695892b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of conquer","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of conquer","exampleIds":[],"headword":"hefakgurzift","id":"shakespeare014.lex.conquest","ipa":"","label":"conquest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgurzift","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A taking by force, the body imagined as the knife\u2019s cowardly conquest in Sonnet 74; nominal result rather than a new historical campaign.","id":"shakespeare014.lex.conquest.sense","status":"draft"}],"status":"draft","variants":[]},"4a3f364fe31d02f102d0c0b49ba3b192fb40a0900d012b68cd86ad2bc9da6e48":{"audioLinks":[],"c