noun","pronunciation":"meranm\u0113ss\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The officer assisting the master. The lieutenant assigns him the second gentleman.","id":"shakespeare014.lex.masters_mate.sense","status":"draft"}],"status":"draft","variants":[]},"aaf9cf3cddd825981610e7bf648b8c117727b55383741c9cacb134d52cefd674":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: strong + dog","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: strong + dog","exampleIds":[],"headword":"jw\u00ebnenplestenb\u00cfeb","id":"shakespeare014.lex.mastiff_dog","ipa":"","label":"mastiff_dog","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jw\u00fcnenplestenb\u00cfeb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The heavy strong dog of England in Rambures's boast and Orleans's retort about bear-baiting.","id":"shakespeare014.lex.mastiff_dog.sense","status":"draft"}],"status":"draft","variants":[]},"50f3dbbd37085ccfc7470986b34e95c94b6caff17f30049ed4bb0f14b72d64a9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: number_abstract + study","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: number_abstract + study","exampleIds":[],"headword":"tarennir\u00d7\u00c3\u00eb\u00d5\u00ebr\u00eb","id":"shakespeare014.lex.mathematics_number_study","ipa":"","label":"mathematics_number_study","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarennir\u0113jzh\u00fc\u0167h\u00fcr\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The numerical discipline named in Tranio's advice on studies.","id":"shakespeare014.lex.mathematics_number_study.sense","status":"draft"}],"status":"draft","variants":[]},"161f426a7147e998d9d37ceb879cf376ef88e766ad115f1d07f7798b9aac3e5a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of weight","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of weight","exampleIds":[],"headword":"memvor","id":"shakespeare014.lex.matter_importance","ipa":"","label":"matter_importance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Significance or consequence in that is no matter. Figurative native weight, distinct from material substance or a specific measurable mass.","id":"shakespeare014.lex.matter_importance.sense","status":"draft"}],"status":"draft","variants":[]},"cd7cbcbf32a7abb9c8d762b8f27be436df1f7e29b70f450655c54b986ff926db":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"matyu","id":"shakespeare014.lex.matthew_gough","ipa":"","label":"matthew_gough","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"matyu","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The given name of the soldier Scales sends to the city's defense.","id":"shakespeare014.lex.matthew_gough.sense","status":"draft"}],"status":"draft","variants":[]},"c9e1fe7f72efbaea9fc5b96282bac960e88ea08079fabcc6a6025a619d6ab2ec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: bed + cushion","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: bed + cushion","exampleIds":[],"headword"