exical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Servant named and speaking in Petruchio's household.","id":"shakespeare014.lex.joseph_petruchio_servant.sense","status":"draft"}],"status":"draft","variants":[]},"1de1b6b05bb9275eaec936c1cd0e1684d23765f3b72b869717bef7c09838493a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_jot","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_jot","exampleIds":[],"headword":"vimin jelam","id":"shakespeare014.lex.jot_small_part","ipa":"","label":"jot_small_part","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vimin jelam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A very small mark or part, here any smallest part of a promise. Native small-sign, without asserting that the source sign is a Thimfora letter or adding a script-specific character.","id":"shakespeare014.lex.jot_small_part.sense","status":"draft"}],"status":"draft","variants":[]},"4e1a097ac607b1f01ea845fc7f82b07f278579d5614bdaf9e6b0a228f1e5bc74":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"jurden","id":"shakespeare014.lex.jourdain_witch","ipa":"","label":"jourdain_witch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"jurden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The witch Margery whom Hume promises to bring to Eleanor.","id":"shakespeare014.lex.jourdain_witch.sense","status":"draft"}],"status":"draft","variants":[]},"1633644701d8290f8b92ecb6688f8ad3fa050ffa8125d36c1cdc883738c27d2a":{"audioLinks":[],"citations"