ce.coriolanus.r1"}],"definition":"A heavy stick invoked in the servant\u2019s boast about striking the stranger. Native heavy-rod; a contemplated blow, not a newly performed assault.","id":"shakespeare014.lex.cudgel_club.sense","status":"draft"}],"status":"draft","variants":[]},"660f01ee7150b97efa1a8376f46e8a7c40062a5b2cabdbc187419796132b01d6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: long + cannon","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: long + cannon","exampleIds":[],"headword":"venorzaruntom","id":"shakespeare014.lex.culverin_gun","ipa":"","label":"culverin_gun","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venorzaruntom","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The long cannon in Lady Percy's list of guns.","id":"shakespeare014.lex.culverin_gun.sense","status":"draft"}],"status":"draft","variants":[]},"bdb329a69d6b178182497923168cae7961b73ef9f1fe3ee924c11b3ea7ae6c4c":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"kumberland","id":"shakespeare014.lex.cumberland_clifford","ipa":"","label":"cumberland_clifford","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kumberland","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The northern territory by which Warwick calls out the elder Clifford in battle.","id":"shakespeare014.lex.cumberland_clifford.sense","status":"draft"}],"status":"draft","variants":[]},"56024351688cfe802909ea0318148a36059117ea09da55a21a94331857b32d90":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptati