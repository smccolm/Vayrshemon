erivation/sense: confirm","exampleIds":[],"headword":"lamemkl\u00e1rjem","id":"shakespeare014.lex.establish_law","ipa":"","label":"establish_law","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"lamemkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Make a public law binding, the previously established protections the citizen says are repealed; not founding a building.","id":"shakespeare014.lex.establish_law.sense","status":"draft"}],"status":"draft","variants":[]},"b3183b353a758e50e578d307ff0f4daef9ce591ef9d843a5c684b5bfcd23dc5c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: possess","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: possess","exampleIds":[],"headword":"\u00d1\u00c5z","id":"shakespeare014.lex.estate_possession","ipa":"","label":"estate_possession","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ch\u0101z","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A secure possession or property-interest, here Menenius imagining seven years of health as an estate conferred by the letter; not social rank or a literal land transfer.","id":"shakespeare014.lex.estate_possession.sense","status":"draft"}],"status":"draft","variants":[]},"86c303eaad5d3308733ab6b4381391a23257961de00822cc8c2c45a523579f50":{"audioLinks":[],"citations":[{"locator":"Authored native compound: land + right + give","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: land + right + give","exampleIds":[],"headword":"jo\u00d9lametf\u00c5w","id":"shakespeare014.lex.estate_settle","ipa":"","label":"estate_settle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"jonglametf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Bestow property or its rights as an estate upon another, source estate upon you. Native land-right-give; not merely social rank or a change in who physically occupies a house.","id":"shakespeare014.lex.estate_settle.sense","status":"draft"}],"status":"draft","variants":[]},"c58c5beb08999f7804bfd5b626bfe42c5e70d6ec0ffcb21633e014f67743cc9c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of hawk","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of hawk","exampleIds":[],"headword":"v\u00ddlawor","id":"shakespeare014.lex.estridge_hawk","ipa":"","label":"estridge_hawk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"v\u012blawor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Estridge in the dove comparison, read as a large predatory hawk. The source category is retained without an asserted modern species; the alternative ostrich reading is recorded in translation review.","id":"shakespeare014.lex.estridge_hawk.sense","status":"draft"}],"status":"draft","variants":[]},"8ad8fb0118fe0afcafe8e0994c0bab4a7435122561e35212118d0d8718158282":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of eternal","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of eternal","exampleIds":[],"headword":"vinolthav","id":"shakespeare014.lex.eternity","ipa":"","label":"eternity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vinolthav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Unending duration, not a particular calendar quantity; nominal use of eternal.","id":"shakespeare014.lex.eternity.sense","status":"draft"}],"status":"draft","variants":[]},"2c28d1570b6a173f2186e0e0376bebcd7508c45671716b92c3a39a46b7f26cd6":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"etna","id":"shakespeare014.lex.etna","ipa":"","label":"etna","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"etna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The named volcano in Lucrece\u2019s breath/smoke comparison; retains the source place identity without an invented eruption date.","id":"shakespeare014.lex.etna.sense","status":"draft"}],"status":"draft","variants":[]},"6f27b73dff53f607f07751541221573acfe70ee03b5139beb92453b0fea14acc":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"eton","id":"shakespeare014.lex.eton_windsor_town","ipa":"","label":"eton_windsor_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"eton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The town of Slender's intended wedding and the point beyond which Bardolph is thrown off a horse.","id":"shakespeare014.lex.eton_windsor_town.sense","status":"draft"}],"status":"draft","variants":[]},"3b5f922d1920e6350ec3b66151cf10c283beadd68bc02d39bf2f3f2ea0403dc4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_euphrates","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/id