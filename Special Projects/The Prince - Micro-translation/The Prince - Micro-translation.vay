ng.","id":"shakespeare014.lex.defend.sense","status":"draft"}],"status":"draft","variants":[]},"e2268cabb608030f319c62d8acbd6cbea4a0761f4432607b46c5e96dc972b4ba":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: defend","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: defend","exampleIds":[],"headword":"jemzeths\u00dflum","id":"shakespeare014.lex.defendant","ipa":"","label":"defendant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jemzeths\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The party answering the claim, the eye in Sonnet 46; a contextual legal role, not a newly introduced physical guard.","id":"shakespeare014.lex.defendant.sense","status":"draft"}],"status":"draft","variants":[]},"889b61fa336a9039cf64782b2750044084a6d09f60a9a8a39fd308d01c0fedb1":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from bad, form","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from bad, form","exampleIds":[],"headword":"murl\u00dfn","id":"shakespeare014.lex.deformed","ipa":"","label":"deformed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"murl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Ill-formed, applied to an authored work as offspring. Does not turn the literary metaphor into a judgment on actual disabled people.","id":"shakespeare014.lex.deformed.sense","status":"draft"}],"status":"draft","variants":[]},"5f30af123baccfdf641e874b54a12f5c81201a84292790b67b403ed998c3b802":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: deformed","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native de