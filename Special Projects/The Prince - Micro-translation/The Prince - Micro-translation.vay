.coriolanus.r1"}],"definition":"A diplomatic mission bringing a public request or proposing terms. The collective mission can include multiple messengers.","id":"shakespeare014.lex.embassy_mission.sense","status":"draft"}],"status":"draft","variants":[]},"380d3ebab7fedd82463702d525fc0129ca90808890566743ccd54e0bd29963fa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fast_abstain + evening","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: fast_abstain + evening","exampleIds":[],"headword":"mawemvenm\u00ebr","id":"shakespeare014.lex.ember_eve_fast","ipa":"","label":"ember_eve_fast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mawemvenm\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The eve of a seasonal religious fast, among the occasions Gower says the old tale has been sung.","id":"shakespeare014.lex.ember_eve_fast.sense","status":"draft"}],"status":"draft","variants":[]},"41eb5af346439eb5722af6b3387553f0f5ad4ce0f444d469d49e622d34bfef19":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: fire + seed","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: fire + seed","exampleIds":[],"headword":"zarunp\u00e1in","id":"shakespeare014.lex.ember_fireseed","ipa":"","label":"ember_fireseed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarunp\u00f4in","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A small glowing remnant that can rekindle fire; native fire-seed, used for the quarrel Lepidus asks Enobarbus not to stir. No literal botanical seed is asserted.","id":"shakespeare014.lex.ember_fireseed.sense","status":"draft"}],"status":"draft","variants":[]},"18f662e3709458d7e92fd24f3646993