es":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A wrong opposed to justice; pursued by the pledged avengers.","id":"shakespeare014.lex.injustice.sense","status":"draft"}],"status":"draft","variants":[]},"23f74d80bcbbfbc84e8670a34e6a7a646cf4b72bf5cfa74881aeb59977a9f057":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"tonmel","id":"shakespeare014.lex.ink","ipa":"","label":"ink","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tonmel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A marking liquid for writing; authored word/mark-family substance term, not a sound adaptation of ink.","id":"shakespeare014.lex.ink.sense","status":"draft"}],"status":"draft","variants":[]},"c6b82a306480474a4b404cfd25a53494140a619e920c9d86eb3d78dbbf395c50":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_gall_bitter","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: kjv_gall_bitter","exampleIds":[],"headword":"taremrenna","id":"shakespeare014.lex.ink_gall","ipa":"","label":"ink_gall","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"taremrenna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The bitter gall in the image of drinking his wife\u2019s words. It carries both bitterness and the connection with writing ink.","id":"shakespeare014.lex.ink_gall.sense","status":"draft"}],"status":"draft","variants":[]},"3bf352a8727c7063e1e84a8ffede2249f1013cdf9ec722adeb37e146caade8c2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: narrow + ribbon","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: narrow + ribbon","exampleIds":[],"headword":"n\u00ebrf\u00eblin","id":"shakespeare014.lex.inkle_woven_tape","ipa":"","label":"inkle_woven_tape","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u00fcrf\u00fclin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The narrow woven tape in Costard's imagined bargaining example.","id":"shakespeare014.lex.inkle_woven_tape.sense","status":"draft"}],"status":"draft","variants":[]},"f27e671475c16a004319570ad5b3b6630a0b0faa44b255a95bc0226a5201e2bd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: slight + knowledge","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: slight + knowledge","exampleIds":[],"headword":"viminh\u00c5b\u00cden","id":"shakespeare014.lex.inkling_knowledge","ipa":"","label":"inkling_knowledge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminh\u0101b\u0117ren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Partial awareness or a hint of knowledge, without claiming exact prior knowledge of the citizens\u2019 plan.","id":"shakespeare014.lex.inkling_knowledge.sense","status":"draft"}],"status":"draft","variants":[]},"8f85441a5c02048777fef97d28f6b0c44fc08e184582ef30bea25e7115c6992b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of nurture_upbringing","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of nurture_upbringing","exampleIds":[],"headword":"pomen","id":"shakespeare014.lex.inland_cultivated","ipa":"","label":"inland_cultivated","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"pomen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Cultivated in manners through life among settled society, source inland man. Contextual modifier from the native upbringing term, contrasted with remote forest life; no exact geographical interior, court rank or modern city is assigned.","id":"shakespeare014.lex.inland_cultivated.sense","status":"draft"}],"status":"draft","variants":[]},"db40016cb6e360316326d80bb0c1b3eeb4bf230ee611c31d218535a96e89ca82":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: guest + chamber + servant","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: guest + chamber + servant","exampleIds":[],"headword":"z\u00e1l\u00c3\u00cdo\u00c3s\u00dflumkinemd\u00c7v","id":"shakespeare014.lex.inn_chamberlain","ipa":"","label":"inn_chamberlain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4ljzh\u0117rojzhs\u014dlumkinemd\u00e3v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The inn servant who supplies intelligence to the highway robber. Distinct from a royal court office.","id":"shakespeare014.lex.inn_chamberlain.sense","status":"draft"}],"status":"draft","variants":[]},"b03b216fa93a630f10d6c0d292cbc58e71ec703ed2f6c7749d927d1649a2f9bd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"inosent","id":"shakespeare014.lex.innocent_pope_john","ipa":"","label":"innocent_pope_john","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"inosent","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The pope in whose name Pandulph makes his demand. The witness gives his name without a regnal figure.","id":"shakespeare014.lex.innocent_pope_john.sense","status":"draft"}],"status":"draft","variants":[]},"960d1af94978a8eb48ee102148a459357886f4d3788e33aa90f205cd35f3e3ff":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: sense + lack","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: sense + lack","exampleIds":[],"headword":"yjafunmavsif","id":"shakespeare014.lex.insensible_unfeeling","ipa":"","label":"insensible_unfeeling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"yjafunmavsif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Lacking sensation or responsiveness in the personification of peace. Native sense-lack; not simply imprudent or an actual diagnosis of a person.","id":"shakespeare014.lex.insensible_unfeeling.sense","status":"draft"}],"status":"draft","variants":[]},"275e31b908a84cb67db38bb72089dae4d1136acfab626d912d910a0cd72da2ec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: pride","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: pride","exampleIds":[],"headword":"nasevar","id":"shakespeare014.lex.insolence_pride","ipa":"","label":"insolence_pride","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nasevar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Arrogant disregard for others, the tribunes\u2019 accusation about Martius\u2019s willingness to take orders; not the narrator\u2019s endorsement.","id":"shakespeare014.lex.insolence_pride.sense","status":"draft"}],"status":"draft","variants":[]},"e59091775185b5ca3741cb480b0ea77954c25f03d206b4a6bb53262c766f8419":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: respect + lack","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: respect + lack","exampleIds":[],"headword":"arvlams\u00e3\u00d1mavsif","id":"shakespeare014.lex.insolent_disrespect","ipa":"","label":"insolent_disrespect","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"arvlamsoichmavsif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Disrespectfully overbearing, in Brutus\u2019s judgment of Coriolanus. Native respect-lack, distinguished from courage, pride alone or a narrator\u2019s verdict.","id":"shakespeare014.lex.insolent_disrespect.sense","status":"draft"}],"status":"draft","variants":[]},"1fc2b99da309b902e8b92ef5e6b419f83acdd2bd86d9767e6d78a9001021aa67":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from debt, fail","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from debt, fail","exampleIds":[],"headword":"ow\u00ebomenat","id":"shakespeare014.lex.insolvent","ipa":"","label":"insolvent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun/adjective","pronunciation":"ow\u00fcomenat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Unable to discharge debts, the paradoxical bankrupt enriched by love; native debt-fail rather than a source-derived loan.","id":"shakespeare014.lex.insolvent.sense","status":"draft"}],"status":"draft","variants":[]},"c681fbfaf3db21bb3bb39a8b9dc4b79a61a7b899fba4b8e8c029dfcd5815f204":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of stir","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of stir","exampleIds":[],"headword":"da\u00c3","id":"shakespeare014.lex.instigate_action","ipa":"","label":"instigate_action","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Prompt another person\u2019s hostile action; Menas thinks Lucius was not moved by Antony. Not bodily transport or a claim that Antony ordered the war.","id":"shakespeare014.lex.instigate_action.sense","status":"draft"}],"status":"draft","variants":[]},"ba66ebd700e07f47083c5994d433f8bb7a4debe2bd241104327c9acaae1aade9":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: nature + know","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: nature + know","exampleIds":[],"headword":"jo\u00d9\u00d5\u00dfrenh\u00c5b\u00cd","id":"shakespeare014.lex.instinct","ipa":"","label":"instinct","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jong\u0167h\u014drenh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Innate apprehension attributed hypothetically to the riding animal in Sonnet 50; not an assertion that it understands human speech.","id":"shakespeare014.lex.instinct.sense","status":"draft"}],"status":"draft","variants":[]},"3983de62c38cafdc356739d4b73f9a0bb627a0d3e9409d069fefbf0489a858c7":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from debt, gain","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from debt, gain","exampleIds":[],"headword":"ow\u00ebm\u00e3n","id":"shakespeare014.lex.interest_charge","ipa":"","label":"interest_charge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ow\u00fcmoin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An addition to the returned principal, here one kiss; not a percentage or a condemned rate imposed by the translator.","id":"shakespeare014.lex.interest_charge.sense","status":"draft"}],"status":"draft","variants":[]},"11d1ad997141b1ee4b91cbd18acbfeb337264b69950b858fa17f9a84e745191f":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: part + right","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: part + right","exampleIds":[],"headword":"threninlamet","id":"shakespeare014.lex.interest_share","ipa":"","label":"interest_share","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"threninlamet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A retained share or right in a work, the life invested in verse in Sonnet 74; not a lending rate or merely curiosity.","id":"shakespeare014.lex.interest_share.sense","status":"draft"}],"status":"draft","variants":[]},"4ff6539574d9aec42910e95a6d0b790caa4805b5afd900fc3d9f2c4aa12a2cda":{"audioLinks":[],"citations":[{"locator":"Authored native compound: off + cut","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: off + cut","exampleIds":[],"headword":"thavdest\u00eb\u00c5","id":"shakespeare014.lex.interrupt_speech","ipa":"","label":"interrupt_speech","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thavdest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Cut off a train of speech or reasoning. Native off + cut forms an inflecting interruption verb, retaining the cutting image without an ambiguous particle stranded outside an agent noun.","id":"shakespeare014.lex.interrupt_speech.sense","status":"draft"}],"status":"draft","variants":[]},"abbbc14d750e7d37f9713488baadc3120ceebc1ac90c414ee7c7a8f17a8a5a93":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: time + space","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: time + space","exampleIds":[],"headword":"venorkinem","id":"shakespeare014.lex.interval_gap","ipa":"","label":"interval_gap","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venorkinem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A gap between ongoing events, the times at which distant fighting can be heard. No fixed duration is asserted.","id":"shakespeare014.lex.interval_gap.sense","status":"draft"}],"status":"draft","variants":[]},"d9ff8d98ac48bc8d69ec2cf31b0e49376feefee6324fd8254a04efbe6e18ce6c":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from enter, conquer","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from enter, conquer","exampleIds":[],"headword":"ybs\u00dfhefakgurzift","id":"shakespeare014.lex.invader","ipa":"","label":"invader","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ybs\u014dhefakgurzift","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An overpowering assailant, the source insulter who dictates the kiss-ransom; not merely a speaker of rude words.","id":"shakespeare014.lex.invader.sense","status":"draft"}],"status":"draft","variants":[]},"78337b61a89399fa47eaf439fc47730fb60e9534c9c21072454e8665e5f37f6a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_invade","sourceId":"shakespeare014.source.lucrece.r1"}],"etymolog