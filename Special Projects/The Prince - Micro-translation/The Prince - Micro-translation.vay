ision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The place name heard in holland linen, following the prince's reference to the low countries.","id":"shakespeare014.lex.holland_region.sense","status":"draft"}],"status":"draft","variants":[]},"d60344a2ce289dcfc732faf554d2215af538148ade19a6e3b6a68198cc1020fe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: holland_region + person","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: holland_region + person","exampleIds":[],"headword":"holands\u00dflum","id":"shakespeare014.lex.hollander_demonym","ipa":"","label":"hollander_demonym","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"holands\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"A person of Holland in Iago's brag about rival drinkers.","id":"shakespeare014.lex.hollander_demonym.sense","status":"draft"}],"status":"draft","variants":[]},"2a7e3d6c18affb27020f0280bc7f872e79171c1fa3c73a2534ff734911a05f99":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_hollow","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_hollow","exampleIds":[],"headword":"vorkin","id":"shakespeare014.lex.hollow","ipa":"","label":"hollow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorkin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A recessed concavity, here a smiling cheek; not the historical thigh reference.","id":"shakespeare014.lex.hollow.sense","status":"draft"}],"status":"draft","variants":[]},"364981fa18cd1357e7eb70e365cf8b401085cc57cd95487bcacfd433d73ff526":{"audioLinks":[],"citations":[{"locator":"Authored native compound: thorn + leaf","sourceId":"shakespeare014.so