unciation":"rosalinda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The poem\u2019s expanded name for Rosalind, the same woman. Preserve the supplied final vowel as a poetic name variant, not a new person.","id":"shakespeare014.lex.rosalinda_poem.sense","status":"draft"}],"status":"draft","variants":[]},"f072e88b843d1e8ae69beca306830b6fcef03581732ae9b756a222814196076c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"rozalin","id":"shakespeare014.lex.rosaline_french_lady","ipa":"","label":"rosaline_french_lady","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"rozalin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The French lady who matches Berowne's wit.","id":"shakespeare014.lex.rosaline_french_lady.sense","status":"draft"}],"status":"draft","variants":[]},"1b4b11d6be1486f4f06002f5d649556cff695facd07707f400b701e67b51547f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"rozalin","id":"shakespeare014.lex.rosaline_verona_beloved","ipa":"","label":"rosaline_verona_beloved","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"rozalin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The woman Romeo loves before meeting Juliet. Distinct from the French courtier.","id":"shakespeare014.lex.rosaline_verona_beloved.sense","status":"draft"}],"status":"draft","variants":[]},