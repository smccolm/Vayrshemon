status":"draft","variants":[]},"682efcc5a87ed410e16d2057dde904ea39f317ea46de18f4861317d03ff765b8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: mood","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: mood","exampleIds":[],"headword":"mav","id":"shakespeare014.lex.humour_bodily","ipa":"","label":"humour_bodily","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Nym's word humor carried across to the supposed bodily workings of a sick man. The native form remains the same as the speaker's habitual word.","id":"shakespeare014.lex.humour_bodily.sense","status":"draft"}],"status":"draft","variants":[]},"0420fac4bff64eeb3b01ae83892ef6fe566c112ebe9a81ce64f19cd8bf4dc1b6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"umfri","id":"shakespeare014.lex.humphrey_buckingham","ipa":"","label":"humphrey_buckingham","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"umfri","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The given name used by York for Buckingham, distinct from Gloucester and from Humphrey Stafford.","id":"shakespeare014.lex.humphrey_buckingham.sense","status":"draft"}],"status":"draft","variants":[]},"c98eaba4e6315cd39404353bb71a6f84d8a0f7386752c8fabe34af744d4bc12f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"humfri","id":"shakes