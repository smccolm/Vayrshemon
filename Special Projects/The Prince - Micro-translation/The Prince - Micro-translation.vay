tted place form of the earlier kingdom.","id":"shakespeare014.lex.naples_musicians_city.sense","status":"draft"}],"status":"draft","variants":[]},"27f0d84899a45ab54921dd76367570ae47b748cf71abb99000bf8d6b50f6fd42":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: cloth + bare","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: cloth + bare","exampleIds":[],"headword":"felenslefy","id":"shakespeare014.lex.napless_cloth","ipa":"","label":"napless_cloth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"felenslefy","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Worn or plain cloth without a raised nap, the humble candidate\u2019s garment; not sleep deprivation or bodily nakedness.","id":"shakespeare014.lex.napless_cloth.sense","status":"draft"}],"status":"draft","variants":[]},"725cbc267b9430a4e982290659dea6d80ad9ac25038ab23df06cc63e6818c005":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"naps","id":"shakespeare014.lex.naps_greete_surname","ipa":"","label":"naps_greete_surname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"naps","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Surname of old John, associated with Greete.","id":"shakespeare014.lex.naps_greete_surname.sense","status":"draft"}],"status":"draft","variants":[]},"1a99dc85a184390178a071e1b4148e10d42c34dec21e65b3121c932e50b6050e":{"audioLinks":[],"citations":[{"locator":"Permitted personal/place-name sound approximation.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Permitted 