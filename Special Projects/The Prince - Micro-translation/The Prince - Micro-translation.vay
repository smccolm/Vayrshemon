 lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Joan's French title, the Maid. Use the native maiden root; the given name has its own entry.","id":"shakespeare014.lex.pucelle_epithet.sense","status":"draft"}],"status":"draft","variants":[]},"165628a78c361fd202013a630088c76ca6588f64b5b49e8db24c8ce7f011902f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: belly + food","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: belly + food","exampleIds":[],"headword":"bavild\u00cdn\u00d7r","id":"shakespeare014.lex.pudding_dish","ipa":"","label":"pudding_dish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"bavild\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A dish traditionally encased in gut. Quickly makes a grim promise about what the crow will eat.","id":"shakespeare014.lex.pudding_dish.sense","status":"draft"}],"status":"draft","variants":[]},"21b91bf7b44e6b1688e46c3245012fb0fa6bc55f1f64c32654825af7487d6147":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: pudding_dish","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: pudding_dish","exampleIds":[],"headword":"bavild\u00cdn\u00d7r","id":"shakespeare014.lex.pudding_slain_man","ipa":"","label":"pudding_slain_man","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"bavild\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The man killed by Drop-heir. His speaking name denotes the dish.","id":"shakespeare014.lex.pudding_slain_man.sense","status":"draft"}],"status":"draft","variants":[]},"2310887c927d0be469ef501222cedaeaa736100a7ace0fd1db3d927a2efb70cc":{"audioLinks"