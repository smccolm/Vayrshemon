ilir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A small high flute in the victory procession. The native form describes the instrument rather than respelling the foreign name.","id":"shakespeare014.lex.fife_instrument.sense","status":"draft"}],"status":"draft","variants":[]},"9b2c8b33c8ff093c8f3939fed57756baf118da0e5e0c4e7a80170ed2e51e96ce":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"faif","id":"shakespeare014.lex.fife_scottish_district","ipa":"","label":"fife_scottish_district","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"faif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"The Scottish district named by Ross and associated with Macduff.","id":"shakespeare014.lex.fife_scottish_district.sense","status":"draft"}],"status":"draft","variants":[]},"74e598a23ba2a313d29048067114e0ecf2d195393e0c85a3fbdd31f957cdf1c3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of mark","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of mark","exampleIds":[],"headword":"den","id":"shakespeare014.lex.figure_sign","ipa":"","label":"figure_sign","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"den","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A sign or figure in the list paired with thinking, speaking and reckoning. The native sign category permits numerical notation and expressive figures without inserting particular digits or treating every figure as a measurable quantity.","id":"shakespeare014.lex.figure_sign.sense","status":"draft"}],"status":"draft","variants":[]},"3512c85a87b8ac5985d6b120ee1c0fbf978812bc9a59134fd9e87744d28762b8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: finger + strike","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: finger + strike","exampleIds":[],"headword":"jelsleb","id":"shakespeare014.lex.fillip_flick","ipa":"","label":"fillip_flick","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"jelsleb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Flick or strike lightly with the finger. In the impossible image pebbles would flick the stars.","id":"shakespeare014.lex.fillip_flick.sense","status":"draft"}],"status":"draft","variants":[]},"0b1e899e98dcc2fb57e50f2adccef0e031d17410e27d899b21cc1a5905a3dde4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_filth","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_filth","exampleIds":[],"headword":"vor matond","id":"shakespeare014.lex.filth_dirt","ipa":"","label":"filth_dirt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vor matond","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Defiling dirt into which Antony imagines judgment dropped; physical filth with moral metaphor, not a new medical claim.","id":"shakespeare014.lex.filth_dirt.sense","status":"draft"}],"status":"draft","variants":[]},"1616cb09fa6cd486791125c62193c52131622c3acfb08d79f0d16a9e5d4756f1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: end + land + claim","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: end + land + claim","exampleIds":[],"headword":"h\