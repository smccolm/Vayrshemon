:"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The earth's middle line in the jerkin joke. The word also calls back to the tree carrying the clothes.","id":"shakespeare014.lex.equatorial_line.sense","status":"draft"}],"status":"draft","variants":[]},"97921fd59dfe0e6eba39596463de5e8e0840edcf58e23c19d5dacd9d604cdfe7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: equal + night","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: equal + night","exampleIds":[],"headword":"ilmem\u00c5\u00d9gif","id":"shakespeare014.lex.equinox_equal_night","ipa":"","label":"equinox_equal_night","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ilmem\u0101nggif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The balancing of night and day used by Iago to claim Cassio's vice equals his virtue.","id":"shakespeare014.lex.equinox_equal_night.sense","status":"draft"}],"status":"draft","variants":[]},"fc2ff6597be2a401cb37d42315387a604f1de37485b27428c3214900b0a9c7e1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"erebus","id":"shakespeare014.lex.erebus_dark","ipa":"","label":"erebus_dark","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"erebus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The underworld darkness invoked in Pistol's theatrical threats.","id":"shakespeare014.lex.erebus_dark.sense","status":"draft"}],"status":"draft","variants":[]},"0d521f2be8640f5593c63b9da71dfe6a4c6dadb061df47aaf906f4db7ad50fb9":{"audioLinks":[],"citations":[{"locator":"A