.r1"}],"definition":"The poetic name of Troy in the painting; retains the alternative name without inventing a different city.","id":"shakespeare014.lex.ilion.sense","status":"draft"}],"status":"draft","variants":[]},"7e548c334400a97760aee9d846c093cff7b35b2d5f56234b2f9aafb729cd375d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"ilium","id":"shakespeare014.lex.ilium_troy","ipa":"","label":"ilium_troy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ilium","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"An alternative name for Troy in the Player's personification of its burning buildings.","id":"shakespeare014.lex.ilium_troy.sense","status":"draft"}],"status":"draft","variants":[]},"05d9d878924b659a2c01305dad48e7f72095ac34a1e1a12ab1cdb82d0bef2366":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from bad, manner","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from bad, manner","exampleIds":[],"headword":"murf\u00c7l","id":"shakespeare014.lex.ill_mannered","ipa":"","label":"ill_mannered","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"murf\u00e3l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Ill-mannered or poorly brought up in social conduct, not underfed or a statement of ancestry.","id":"shakespeare014.lex.ill_mannered.sense","status":"draft"}],"status":"draft","variants":[]},"56d43f04260580e5c1b1f707b841846db41c382ebf3006e26b3f1ca0a20ed5c9":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: bad + shape","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymol