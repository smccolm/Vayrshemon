Oliver\u2019s rescue story, native female + lion. Hunger and nursing state are stated separately; no substitution of a male lion.","id":"shakespeare014.lex.lioness_animal.sense","status":"draft"}],"status":"draft","variants":[]},"f13a329c680f56e415cb2cae7647d6351f5a9606d9cbb5a96b5f330253174fa6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of lip","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of lip","exampleIds":[],"headword":"melin","id":"shakespeare014.lex.lip_kiss","ipa":"","label":"lip_kiss","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Touch or kiss with the lips, the kings who lipped Cleopatra\u2019s hand. Explicit nominal-to-verbal use, not an anatomical noun mistaken for a finite action.","id":"shakespeare014.lex.lip_kiss.sense","status":"draft"}],"status":"draft","variants":[]},"a37484fa193754b0b68660e1b801ae34f45aa9d260be6219f25fae805e2cd8c4":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"lipsberi","id":"shakespeare014.lex.lipsbury_pinfold_place","ipa":"","label":"lipsbury_pinfold_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lipsberi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The name Kent gives to the pound in which he would trap Oswald. Its real-world location is unspecified.","id":"shakespeare014.lex.lipsbury_pinfold_place.sense","status":"draft"}],"status":"draft","variants":[]},"935837c33b1fb455d8cef170edf073ce48d7fa152f61669041b2f0aa63633bea":{"audioLinks":[],"citations":[{"locator"