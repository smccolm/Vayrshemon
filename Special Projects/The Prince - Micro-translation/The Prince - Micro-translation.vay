a":"","label":"severity_rigor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"krath","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Harshness or rigor of public power in Sicinius\u2019s demand for summary punishment. Explicit nominal harsh, not a narrator endorsement of the sentence.","id":"shakespeare014.lex.severity_rigor.sense","status":"draft"}],"status":"draft","variants":[]},"b796cc79c7739237705079b5ffcff41f0aee024c0035a5a2c5de7acc9e6da41d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"severn","id":"shakespeare014.lex.severn_river","ipa":"","label":"severn_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"severn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The river the escort must see Lucius across on his way to Milford Haven.","id":"shakespeare014.lex.severn_river.sense","status":"draft"}],"status":"draft","variants":[]},"0d65b7bfce8c9a713ef258479eb8d9dc05b3d9f99da64a11a594a4ee7a52374e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_sew","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_sew","exampleIds":[],"headword":"jelinkl\u00e1r","id":"shakespeare014.lex.sew_stitch","ipa":"","label":"sew_stitch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"jelinkl\u00f4r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Join or close by stitching; Seleucus would sew his lips shut rather than lie at his peril. The source seeling/falconry resonance is noted in the verse review, without replacing lips with eyelids.","id":"shakespeare014.lex.sew_stitch.sense","status":"draft"}],"status":"draft","variants":[]},"30bd9732255c92f91c4fc59ff9948e1fd1d143c92c954d0ecf4d10e4f2b6904d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: table_meal + steward","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Authored native derivation or sense: table_meal + steward","exampleIds":[],"headword":"klojvord\u00cdn\u00d7rz\u00e1linhif\u00e5r","id":"shakespeare014.lex.sewer_table_steward","ipa":"","label":"sewer_table_steward","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"klojvord\u0117rn\u0113rz\u00f4linhifour","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"The officer overseeing dishes at the feast. The word denotes an office in the household.","id":"shakespeare014.lex.sewer_table_steward.sense","status":"draft"}],"status":"draft","variants":[]},"6d9e4f7cde53b86e826d32ac25b878168a84bd92de9fd14bdb6ad2cae840abe2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: needle + shield","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: needle + shield","exampleIds":[],"headword":"jelinjemzethf\u00c5w","id":"shakespeare014.lex.sewing_thimble","ipa":"","label":"sewing_thimble","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jelinjemzethf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The protective implement for a sewing finger that the Bastard contrasts with the armed gauntlet.","id":"shakespeare014.lex.sewing_thimble.sense","status":"draft"}],"status":"draft","variants":[]},"a52a20aeb34bcc2e1aecd246ccadd0481dcf45a82d48d8d77373ade8cccbeaea":{"audioLinks":[],"citations":[{"locator":"Authored n