:"shakespeare014.lex.clapperclaw_beat.sense","status":"draft"}],"status":"draft","variants":[]},"7a6b55f7fbd1b60e4067e9e1539a51ef17a803069dba6bcf8fda6c9a956db4a6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"klara","id":"shakespeare014.lex.clare_saint_foundress","ipa":"","label":"clare_saint_foundress","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"klara","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The saint after whom the sisters of Isabella's intended order are named.","id":"shakespeare014.lex.clare_saint_foundress.sense","status":"draft"}],"status":"draft","variants":[]},"56da99cab877ab65730e5293383da4789a06dfafc98da43487c523fadfef5499":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"klarens","id":"shakespeare014.lex.clarence_duchy","ipa":"","label":"clarence_duchy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"klarens","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Thomas's territorial title.","id":"shakespeare014.lex.clarence_duchy.sense","status":"draft"}],"status":"draft","variants":[]},"7f7f6fb7ba14859d39af58456199943c191f533c236060f699cd7d07f5456760":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"klarens","id":"shakespeare014.lex.clarence_george_duchy","ipa"