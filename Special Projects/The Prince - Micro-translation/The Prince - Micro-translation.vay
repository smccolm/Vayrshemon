14.lex.julius_given_name.sense","status":"draft"}],"status":"draft","variants":[]},"07425c402d0aefbdefead2eba58ed572d6c4fb8017c0ea638a94463fb172e0e1":{"audioLinks":[],"citations":[{"locator":"Native Unta ordinal and month, following the established names of source months.","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Native Unta ordinal and month, following the established names of source months.","exampleIds":[],"headword":"p\u00c9rsus\u2019t venlun","id":"shakespeare014.lex.july_source","ipa":"","label":"july_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"p\u00e4rsus\u2019t venlun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"July, the seventh month of the source calendar in Buckingham's comparison of clear springs and proof.","id":"shakespeare014.lex.july_source.sense","status":"draft"}],"status":"draft","variants":[]},"5fa398c3284064414acb1a4cbaa751bdedd4f06d0dad31b8caed56b3c8182b8f":{"audioLinks":[],"citations":[{"locator":"Source-calendar name expressed as native Unta ordinal six plus month.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Source-calendar name expressed as native Unta ordinal six plus month.","exampleIds":[],"headword":"\u00dfd\u00d7um\u2019t venlun","id":"shakespeare014.lex.june_source","ipa":"","label":"june_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u014dd\u0113um\u2019t venlun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"June, the sixth month in the source English calendar; the repeated Junes of Sonnet 104 remain three occurrences of that month, not three months invented for a native calendar.","id":"shakespeare014.lex.june_source.sense","status":"draft"}],"status":"draft","variants":[]},"de1bd4566058ddb58732725d70738b13b5e0e8bec80c10