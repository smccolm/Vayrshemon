kespeare014.source.lucrece.r1"}],"definition":"Liveliness or vigour, deficient in the shy courier; distinct from the fact of being alive.","id":"shakespeare014.lex.vitality.sense","status":"draft"}],"status":"draft","variants":[]},"394db3031619b9f44367e4767eab9f023a6129345beb142644b953489709e184":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"vitruvyo","id":"shakespeare014.lex.vitruvio_widow_husband","ipa":"","label":"vitruvio_widow_husband","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"vitruvyo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"His widow is named on the invitation list.","id":"shakespeare014.lex.vitruvio_widow_husband.sense","status":"draft"}],"status":"draft","variants":[]},"976fc1204f5fbec6b96d3b941896884deb07f06fe27989ec4d4d33449afcc1bb":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"volkesen","id":"shakespeare014.lex.volquessen_dowry","ipa":"","label":"volquessen_dowry","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"volkesen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The first territory named in John's grant of five provinces with Blanche.","id":"shakespeare014.lex.volquessen_dowry.sense","status":"draft"}],"status":"draft","variants":[]},"bb25a983cd047b6222146b020ca291b35788971d81bb05427fbbb70cf309b4e6":{"audioLinks":[],"citations":[{"locator":"Permitted geographic name adaptation with native affiliation morphology","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Permitted geographic name adaptation with native affiliation morphology","exampleIds":[],"headword":"volskis\u00dflum","id":"shakespeare014.lex.volsces_people","ipa":"","label":"volsces_people","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"volskis\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The people of the named Volscian territory, using its geographic name plus native person. Not an unrelated ordinary lexical loan and not a claim of a modern national identity.","id":"shakespeare014.lex.volsces_people.sense","status":"draft"}],"status":"draft","variants":[]},"d699596fa9977833d53daefa840b3f15f5ff0cfdd4b79efe95deeb359a0c7bf5":{"audioLinks":[],"citations":[{"locator":"Permitted geographic name adaptation with native affiliation morphology","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Permitted geographic name adaptation with native affiliation morphology","exampleIds":[],"headword":"volski","id":"shakespeare014.lex.volscian_territory","ipa":"","label":"volscian_territory","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"volski","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Geographic base naming the Volscian territory represented in the play; phonetic source-name adaptation, without claiming a formal country called Volskia or inventing borders.","id":"shakespeare014.lex.volscian_territory.sense","status":"draft"}],"status":"draft","variants":[]},"6ae4fef3fe7d5049264d051edc5e267488e5b472550d74f0b4d4ff7f2b66fa87":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"voltemand","id":"shakespeare014.