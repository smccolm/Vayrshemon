t","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"umfrevil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Sir John who first gave Travers glad news. The unidentified later horseman brings contrary news.","id":"shakespeare014.lex.umfrevile_knight.sense","status":"draft"}],"status":"draft","variants":[]},"1d74544469466dab13394794a404599df5fa995575f5b474285b7b5af68cca8f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: care + lack","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: care + lack","exampleIds":[],"headword":"s\u00e3\u00d1mavsif","id":"shakespeare014.lex.unconcern_disposition","ipa":"","label":"unconcern_disposition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"soichmavsif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Indifference to being loved or hated, praised by the second officer as noble carelessness; distinct from a failure of craftsmanship or inability to care.","id":"shakespeare014.lex.unconcern_disposition.sense","status":"draft"}],"status":"draft","variants":[]},"8e78569dc5ddac0d0b98e61c2bd3e9744d12226a473fb1021e45a5cf7871f72c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_secure_ease","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_secure_ease","exampleIds":[],"headword":"marmakin","id":"shakespeare014.lex.unconcerned","ipa":"","label":"unconcerned","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"marmakin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Unalarmed and unaware of danger; does not assert that the unsuspecting person is actually safe.","id":"shakespeare014.lex.unconcerned.sense","status":"draft"}],"status":"draft","variants":[]},"7c2986283190af8a5404c45928bd8ab6ec47880edf83cf120b999ca8cee425f6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: inside + garment","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: inside + garment","exampleIds":[],"headword":"nifelen","id":"shakespeare014.lex.undergarment_smock","ipa":"","label":"undergarment_smock","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nifelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A woman\u2019s shift or undergarment, the old smock in Enobarbus\u2019s wife-as-clothing metaphor. Distinct from the lower petticoat.","id":"shakespeare014.lex.undergarment_smock.sense","status":"draft"}],"status":"draft","variants":[]},"6215b5d21e2960f3bd21733d33c54f2b4c9f94ef6844d2382838c8fd126d7857":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: below + garment","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: below + garment","exampleIds":[],"headword":"grelfelen","id":"shakespeare014.lex.underskirt_petticoat","ipa":"","label":"underskirt_petticoat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grelfelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A lower or under-skirt garment, the new petticoat replacing an old smock in the metaphor. No modern fabric or precise cut is imposed.","id":"shakespeare014.lex.underskirt_petticoat.sense","status":"draft"}],"status":"draft","variants":[]},"aa60b7fc63130b4484d6aeb5fe623622ab164bfb9fd7e4505dafb1efbebfead0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of rude","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of rude","exampleIds":[],"headword":"krath","id":"shakespeare014.lex.ungentleness_hurt","ipa":"","label":"ungentleness_hurt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"krath","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Hurtful discourtesy or rough treatment, Phoebe\u2019s complaint about disclosure of her letter. Nominal native rude; not merely low social rank or the physical texture of an object.","id":"shakespeare014.lex.ungentleness_hurt.sense","status":"draft"}],"status":"draft","variants":[]},"9e1cb3fd5bef62e163f81c59c142f38b6fc75a2b234eacbc669a4ba3e3979fd9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_unicorn","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_unicorn","exampleIds":[],"headword":"neksuskraner\u00d5\u00dfrvor","id":"shakespeare014.lex.unicorn","ipa":"","label":"unicorn","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"neksuskraner\u0167h\u014drvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The source\u2019s one-horn creature in the taming image; retains native Unta one in the lexicalized name without fixing a zoological species.","id":"shakespeare014.lex.unicorn.sense","status":"draft"}],"status":"draft","variants":[]},"12a3825030b3ec447255252782579a8030ab420631e87b3e6a9249b2fc3ccce3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of bond","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of bond","exampleIds":[],"headword":"kl\u00e1rjem","id":"shakespeare014.lex.union_relation","ipa":"","label":"union_relation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kl\u0