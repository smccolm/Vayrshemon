"Deliberate tactical planning, Brutus\u2019s concealed political intelligence.","id":"shakespeare014.lex.strategy.sense","status":"draft"}],"status":"draft","variants":[]},"026a6328c31c231181ed63daa76acaee2303d31ab6c3d6f892a3065cf50072ca":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"strato","id":"shakespeare014.lex.strato_brutus_attendant","ipa":"","label":"strato_brutus_attendant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"strato","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The man who eventually holds Brutus's sword at his request.","id":"shakespeare014.lex.strato_brutus_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"ad77ce2006501d819d6cbdbf45cf44122dfcc621c5b8d6f3432f504e7117bc32":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: red + berry","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: red + berry","exampleIds":[],"headword":"azberil","id":"shakespeare014.lex.strawberry_fruit","ipa":"","label":"strawberry_fruit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azberil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The small red berry beneath the nettle in Ely's comparison with Henry's hidden habits of reflection.","id":"shakespeare014.lex.strawberry_fruit.sense","status":"draft"}],"status":"draft","variants":[]},"5dd8d03733281693fa6110de1d54cffebf8b0dc63a8a41dffa3c450eeefed218":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Explicit literary promotion of kjv_strict; same native form, reviewed meaning, older entry untouched.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Explicit literary promotion of kjv_strict; same native form, reviewed meaning, older entry untouched.","exampleIds":[],"headword":"n\u00ebrvar\u00dfnen","id":"shakespeare014.lex.strict","ipa":"","label":"strict","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"n\u00fcrvar\u014dnen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Close observance of a rule or ritual; not narrow spatial width.","id":"shakespeare014.lex.strict.sense","status":"draft"}],"status":"draft","variants":[]},"17c2ef3cac50985138dec83af6a622ff88931f6b5ce27db44339df18232abdcb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: grain_kernel + measure","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: grain_kernel + measure","exampleIds":[],"headword":"nelmem","id":"shakespeare014.lex.strike_grain_measure","ipa":"","label":"strike_grain_measure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nelmem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The source grain measure in the imagined mare's dowry of oats. The amount is kept in strikes without an inferred conversion.","id":"shakespeare014.lex.strike_grain_measure.sense","status":"draft"}],"status":"draft","variants":[]},"cf904b8a482db2815f646ca673acaef18b6b85c1130e109f416cbfecc0045e29":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from gentle, touch","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from gentle, touch","exampleIds":[],"headword":"venlavoril","id":"shakespeare014.lex.stroke","ipa":"","label":"stroke","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"venlavoril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Stroke or caress by a gentle moving touch.","id":"shakespeare014.lex.stroke.sense","status":"draft"}],"status":"draft","variants":[]},"8c87ac1a1d3c596f7391240c852a57ca842532ef8f1cbaed2f42288af1b06b77":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: proud + walk","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: proud + walk","exampleIds":[],"headword":"nasevarm\u00e5r","id":"shakespeare014.lex.strut_walk","ipa":"","label":"strut_walk","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"nasevarmour","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Walk in ostentatious pride, the movement toward ruin in Antony\u2019s accusation.","id":"shakespeare014.lex.strut_walk.sense","status":"draft"}],"status":"draft","variants":[]},"cf6ecae371599029338aa02feb596834f15ec7f694792e6907d0eda2426be39c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: corn + cut + remain","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: corn + cut + remain","exampleIds":[],"headword":"thendest\u00eb\u00c5dlen\u00dbemin","id":"shakespeare014.lex.stubble_field","ipa":"","label":"stubble_field","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thendest\u00fc\u0101dlenshemin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Cut grain stalks remaining in the field, dry fuel in Sicinius\u2019s analogy for the commoners. Native grain-cut-remain; not a new crop species or a literal arson plan.","id":"shakespeare014.lex.stubble_field.sense","status":"draft"}],"status":"draft","variants":[]},"fddaed11a2d878d685ce7a39310f542b26d8c1f11937c6c6a56177974b3c0a2f":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical root; no claim of historical attestation.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Authored short native lexical root; no claim of historical attestation.","exampleIds":[],"headword":"pemil","id":"shakespeare014.lex.stud","ipa":"","label":"stud","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pemil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A projecting ornamental boss or stud on equipment, without assigning an unprinted material.","id":"shakespeare014.lex.stud.sense","status":"draft"}],"status":"draft","variants":[]},"3b10db06f37cd3ef44ccfcdd8b6605444e034962e282bf16a4d0ca82fcdebf48":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"stiks","id":"shakespeare014.lex.styx_underworld_river","ipa":"","label":"styx_underworld_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"stiks","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"The river of the dead, on whose shore Titus imagines his unburied sons waiting.","id":"shakespeare014.lex.styx_underworld_river.sense","status":"draft"}],"status":"draft","variants":[]},"da44a2d0608e69bd0a3fcdf2910f842659a2989b03c7dec528cfb937cff4260d":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from rule, person","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from rule, person","exampleIds":[],"headword":"var\u00dfnens\u00dflum","id":"shakespeare014.lex.subject_ruled","ipa":"","label":"subject_ruled","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A person subject to a ruler, here the faculties under the heart\u2019s kingship; distinct from a subject of discussion.","id":"shakespeare014.lex.subject_ruled.sense","status":"draft"}],"status":"draft","variants":[]},"01c68d1a6e379699c40cdaee08844586c24e9abf4a1228d094307cf857c61d77":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of submit","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of submit","exampleIds":[],"headword":"grelf\u00c5w","id":"shakespeare014.lex.submission_compliance","ipa":"","label":"submission_compliance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grelf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Willing compliance or submission, the dependency Proculeius asks to report. Nominal use of native submit, not a dependent territory or a medical addiction.","id":"shakespeare014.lex.submission_compliance.sense","status":"draft"}],"status":"draft","variants":[]},"766abd54fb087cc902236c7ddf0fd742254b967ff32e72b370dba496f25ba46f":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: fraud + induce","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: fraud + induce","exampleIds":[],"headword":"trat\u00e9kmiktaz\u00d7rh\u00eb","id":"shakespeare014.lex.suborn","ipa":"","label":"suborn","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"trat\u00e9kmiktaz\u0113rh\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Induce to deceptive or corrupt testimony, the unknown informer addressed in Sonnet 125. Native fraud-induce; no actual monetary bribe or named historical conspirator is supplied.","id":"shakespeare014.lex.suborn.sense","status":"draft"}],"status":"draft","variants":[]},"144532332623462e6dd396a0c04c929f9027e442b9f581d2ee8c8ba3e01e94ff":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of incite","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of incite","exampleIds":[],"headword":"venjar","id":"shakespeare014.lex.subornation","ipa":"","label":"subornation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venjar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Inducement to wrongdoing, not restricted here to the technical modern offence of inducing perjury.","id":"shakespeare014.lex.subornation.sense","status":"draft"}],"status":"draft","variants":[]},"ca81202cb1329ba41fe0e5bbc4debf3ecaedcd1700d7952e64ee9be5dae9c1e7":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: law + seek","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: law + seek","exampleIds":[],"headword":"lamthr\u00ebnt\u00d7y\u00dfb\u00dfkelde\u00dbon","id":"shakespeare014.lex.sue_debt","ipa":"","label":"sue_debt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"lamthr\u00fcnt\u0113y\u014db\u014dkeldeshon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Pursue a claim through legal process, the creditor pursuing the friend\u2019s debt in Sonnet 134; not ordinary romantic wooing.","id":"shakespeare014.lex.sue_debt.sense","status":"draft"}],"status":"draft","variants":[]},"533083fb1ed481ece9770ba006e667044b688eaf8c961258d07dbe300e792cf2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: suffer","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: suffer","exampleIds":[],"headword":"mursem","id":"shakespeare014.lex.suffering_condition","ipa":"","label":"suffering_condition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mursem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The experience of deprivation and harm, nominal use of native suffer; not permission to act.","id":"shakespeare014.lex.suffering_condition.sense","status":"draft"}],"status":"draft","variants":[]},"59596821a7d7d10b1d2e329b098ee7d4553402fe643cca7ce8538ef12a49c67c":{"audioLinks":[],"citations":[{"locator":"A deliberate alteration of a native word in Dogberry's report to Leonato.","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"A deliberate alteration of a native word in Dogberry's report to Leonato.","exampleIds":[],"headword":"meml\u00d7m","id":"shakespeare014.lex.suffigance_dogberry_error","ipa":"","label":"suffigance_dogberry_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"lexical","pronunciation":"meml\u0113m","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Dogberry's malformed suffigance. The intended native expression is memr\u0113.","id":"shakespeare014.lex.suffigance_dogberry_error.sense","status":"draft"}],"status":"draft","variants":[]},"61aa207842b1d74f9d12c3870ef793af7e76d9a68f616351f9c9d3654ec437a4":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"sufolk","id"