fSpeech":"noun","pronunciation":"var\u00fcnyatang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"The state of purification after death which Emilia says she would risk in her hypothetical bargain.","id":"shakespeare014.lex.purgatory_souls_cleansing.sense","status":"draft"}],"status":"draft","variants":[]},"e7ffd51054b6470532540d9b5fcae0eb9ef639191d4dcafef7ab8e447d4c2e0f":{"audioLinks":[],"citations":[{"locator":"Stage mispronunciation with an added initial consonant.","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Stage mispronunciation with an added initial consonant.","exampleIds":[],"headword":"vren","id":"shakespeare014.lex.pursent_costard_error","ipa":"","label":"pursent_costard_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Garbled present in Costard's mispronunciation.","id":"shakespeare014.lex.pursent_costard_error.sense","status":"draft"}],"status":"draft","variants":[]},"2849e06626cb141546e6dc0cc5518dd73b7a896306c76daad8072efd86da0e4a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: summon + officer","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: summon + officer","exampleIds":[],"headword":"kin\u00d3\u00c5\u00e7marvenens\u00dflum","id":"shakespeare014.lex.pursuivant_officer","ipa":"","label":"pursuivant_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kinth\u0101\u016bmarvenens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The officer to be sent to summon Peter's master to answer the complaint.","id":"shakespeare014.lex.pursuivant_officer.sense","status":"draft"}],"status":"draft","variants":[]},"068295ff82849013be78d8713734bcd20a5548ebc940a1c8d53dea1314338f67":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: push + pin_fastener","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: push + pin_fastener","exampleIds":[],"headword":"nerda\u00c3viminjeran","id":"shakespeare014.lex.pushpin_game","ipa":"","label":"pushpin_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerdajzhviminjeran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"A children's pin game, which Berowne imagines the wise Nestor playing.","id":"shakespeare014.lex.pushpin_game.sense","status":"draft"}],"status":"draft","variants":[]},"c65fbd44a1a12218cdc79102479d70d898c2ba22def5b2e5713736ac503c9f6b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: maiden + harlot_person","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: maiden + harlot_person","exampleIds":[],"headword":"salinbelenkwist","id":"shakespeare014.lex.puzel_taunt","ipa":"","label":"puzel_taunt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"salinbelenkwist","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Talbot twists Joan's maiden title into a sexual slur. The taunt retains the exact native maiden root.","id":"shakespeare014.lex.puzel_taunt.sense","status":"draft"}],"status":"draft","variants":[]},"630211c3375b032fb39fb6f098c9c13cd08ca40d6ec567df0f549c5007c35d07":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"pigmaliyon","id":"shakespeare014.lex.pygmalion_sculptor","ipa":"","label":"pygmalion_sculptor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pigmaliyon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The sculptor whose statue becomes a woman. Lucio applies the myth to Pompey's trade.","id":"shakespeare014.lex.pygmalion_sculptor.sense","status":"draft"}],"status":"draft","variants":[]},"2e6224761e0314e6fa5f35046bf8af4d4204a65abfb81ea8154ce434f1c70b47":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_cubit + people","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: kjv_cubit + people","exampleIds":[],"headword":"larmems\u00dflum","id":"shakespeare014.lex.pygmies_legendary_people","ipa":"","label":"pygmies_legendary_people","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"larmems\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The small people of classical legend. The native cubit-and-people name reflects the forearm measure in the traditional name.","id":"shakespeare014.lex.pygmies_legendary_people.sense","status":"draft"}],"status":"draft","variants":[]},"4cfb69e18425625065da29723b6e2fcb64390d205d01bcd96a95bc1c3abbc137":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of pyramid_monument","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of pyramid_monument","exampleIds":[],"headword":"n\u00ebrnaorl\u00dfn","id":"shakespeare014.lex.pyramid_egypt","ipa":"","label":"pyramid_egypt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u00fcrnaorl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The Egyptian tapering monument in the Nile measurement discussion. Pyramises is a historical source variant, not evidence that Lepidus invents a wrong word; the native noun remains the same.","id":"shakespeare014.lex.pyramid_egypt.sense","status":"draft"}],"status":"draft","variants":[]},"92c361c88778f24948ac6bdc7aa67f8c5e08c85d53b549229c7f0a515052fad8":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: narrow + high + form","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: narrow + high + form","exampleIds":[],"headword":"n\u00ebrnaorl\u00dfn","id":"shakespeare014.lex.pyramid_monument","ipa":"","label":"pyramid_monument","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u00fcrnaorl\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A tapering high monument, the pyramids raised by Time in Sonnet 123. Native narrow-high-form; retains the historical pyramid/obelisk breadth without naming an Egyptian site or specifying an unprinted number of faces.","id":"shakespeare014.lex.pyramid_monument.sense","status":"draft"}],"status":"draft","variants":[]},"5da8793d3a4effbc77ae2aa3608b30ef3b44ff6534a8aad6f2f8df33a0fd6662":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"pirenez","id":"shakespeare014.lex.pyrenees_mountains","ipa":"","label":"pyrenees_mountains","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pirenez","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The Pyrenean mountains named in the same exchange with an imagined traveler.","id":"shakespeare014.lex.pyrenees_mountains.sense","status":"draft"}],"status":"draft","variants":[]},"32daaa977c6328bc890ce497c3f76dcab0b284f89121ec2b54dd6aa7a359bf42":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"pirus","id":"shakespeare014.lex.pyrrhus","ipa":"","label":"pyrrhus","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pirus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The warrior shown over the wounded Priam, not the later Epirote king of the same name.","id":"shakespeare014.lex.pyrrhus.sense","status":"draft"}],"status":"draft","variants":[]},"c40a6ca00d9157b93fce8138bec44d081cd238de0e4fc9ee2b6acab6e44c9752":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"pithagoras","id":"shakespeare014.lex.pythagoras_philosopher","ipa":"","label":"pythagoras_philosopher","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pithagoras","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The philosopher in Rosalind\u2019s playful reference to transmigration. The joke does not establish that he knew an Irish rat or that Rosalind literally remembers a prior life.","id":"shakespeare014.lex.pythagoras_philosopher.sense","status":"draft"}],"status":"draft","variants":[]},"ecac1e537ae1ea181b5c537e13c90ea3231270e926bbfbd2045d0726e826c9ae":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: false + medicine + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: false + medicine + person","exampleIds":[],"headword":"dlenfadervorens\u00dflum","id":"shakespeare014.lex.quack_showman","ipa":"","label":"quack_showman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlenfadervorens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A fraudulent medicine-selling showman, source mountebank as a metaphor for courting public affection. Native false-medicine-person; the analytical performance phrase does not add an actual sale or illness.","id":"shakespeare014.lex.quack_showman.sense","status":"draft"}],"status":"draft","variants":[]},"316852e7ed0326c13ead26aab48423e29ec97bbde00a5fe51741cdc31b8827d1":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_quail","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_quail","exampleIds":[],"headword":"wil\u00d7n","id":"shakespeare014.lex.quail_bird","ipa":"","label":"quail_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wil\u0113n","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The bird in Antony\u2019s comparison of fighting birds. Reuses the corrected native bird-kind term, without importing manna, wilderness events, or the verb shrink in fear.","id":"shakespeare014.lex.quail_bird.sense","status":"draft"}],"status":"draft","variants":[]},"2bf467e2bf4dc0a11a4e173dafa9a00f325e05a8b482bef64a7557f4ebe6053f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: hunt + heap_mound","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: hunt + heap_mound","exampleIds":[],"headword":"ynstumgurnel","id":"shakespeare014.lex.quarry_hunted_pile","ipa":"","label":"quarry_hunted_pile","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ynstumgurnel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A heap of killed game, Martius\u2019s monstrous image for mutilated citizens. Native hunt-heap; distinct from a stone extraction site.","id":"shakespeare014.lex.quarry_hunted_pile.sense","status":"draft"}],"status":"draft","variants":[]},"eb7d149829b04ecb78f7fbfb703edf1ec1f9433fe728f687ef04f8be0e64319a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: gallon_wine + quarter","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: gallon_wine + quarter","exampleIds":[],"headword":"m\u00ebrvenmem\u00e7l\u00d7on","id":"shakespeare014.lex.quart_sealed_vessel","ipa":"","label":"quart_sealed_vessel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrvenmem\u016bl\u0113on","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"A vessel of a quarter gallon. Sly wants the tavern measure certified; no modern volume conversion is assumed.","id":"shakespeare014.lex.quart_sealed_vessel.sense","status":"draft"}],"status":"draft","variants":[]},"4d6501592b2c64a7d96c5c9ffe6ffa7e9a541eb7bc05e675b2b224dfc5bb1ec9":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from water, cease","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from water, cease","exampleIds":[],"headword":"yems\u00d7f\u00e7s","id":"shakespeare014.lex.quench","ipa":"","label":"quench","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"yems\u0113f\u016bs","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Extinguish a burning or allay it; tears quench the blush metaphorically, without making the skin literally burn.","id":"shakespeare014.lex.quench.sense","status":"draft"}],"status":"draft","variants":[]},"d536bb98cac5e38bcd8034772057975215a97418461feead805730d80f977946":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of affair","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of affair","exampleIds":[],"headword":"norvend\u00c7\u00d3","id":"shakespeare014.lex.question_issue","ipa":"","label":"question_issue","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"norvend\u00e3th","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The disputed matter at stake, the question in Enobarbus\u2019s mered question. Not an interrogative utterance. The exact restrictive force of mered is noted as uncertain in the source review.","id":"shakespeare014.lex.question_issue.sense","status":"draft"}],"status":"draft","variants":[]},"de232dd1192900f1d675e050e7f7d58e70ea61e1772d3d4fe7bfc3071f737506":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kwebus","id":"shakespeare014.lex.queubus_jesters_equator","ipa":"","label":"queubus_jesters_equator","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kwebus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Invented name attached to the equinoctial line.","id":"shakespeare014.lex.queubus_jesters_equator.sense","status":"draft"}],"status":"draft","variants":[]},"4ef29411cb3471839411f51c3c74948d4d9788546f12b81954134aaaf192ec4e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of speed","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of speed","exampleIds":[],"headword":"s\u00dfrn","id":"shakespeare014.lex.quick_speed","ipa":"","label":"quick_speed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"s\u014drn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Celerity in Cleopatra\u2019s figurative repeated dying; nominal rate rather than the adjective quick in the distinct lively-winds phrase.","id":"shakespeare014.lex.quick_speed.sense","status":"draft"}],"status":"draft","variants":[]},"8b1b3ff5bc1976bcf89adf08b79ceb7fd629bd04ae5b31e625afec7071ccba7a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: confirm + weakness","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: confirm + weakness","exampleIds":[],"headword":"lamemkl\u00e1rjemvimjw\u00ebn","id":"shakespeare014.lex.quickly_confirmities","ipa":"","label":"quickly_confirmities","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamemkl\u00f4rjemvimjw\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Quickly blends confirmation into infirmities while asking her guests to bear each other's faults.","id":"shakespeare014.lex.quickly_confirmities.sense","status":"draft"}],"status":"draft","variants":[]},"f6de7c2c8d1c2820e61202478970eb7b94257a03dca4c96b57cc8f376fb24773":{"audioLinks":[],"citations":[{"locator":"Source-specific Vayrshemon malapropism for Quickly's exion in 2.1.","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Source-specific Vayrshemon malapropism for Quickly's exion in 2.1.","exampleIds":[],"headword":"lemthr\u00ebnv\u00c7lda\u00c3","id":"shakespeare014.lex.quickly_exion","ipa":"","label":"quickly_exion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lemthr\u00fcnv\u00e3ldajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Quickly's slip for her legal action, with the opening vowel of the native legal-process term displaced.","id":"shakespeare014.lex.quickly_exion.sense","status":"draft"}],"status":"draft","variants":[]},"34ff73431a37585b5d5d13741954f42c2148c147aab3c2266592f32a56d300a4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kwikli","id":"shakespeare014.lex.quickly_hostess","ipa":"","label":"quickly_hostess","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kwikli","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The Eastcheap hostess, wife of the man Hal asks after.","id":"shakespeare014.lex.quickly_hostess.sense","status":"draft"}],"status":"draft","variants":[]},"b925e4677eb886b6462e35ce3b6798cc41fbe9b995414dceb1c579055f200f83":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: pulse + rank","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: pulse + rank","exampleIds":[],"headword":"sevarsonarventhren","id":"shakespeare014.lex.quickly_pulsidge","ipa":"","label":"quickly_pulsidge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sevarsonarventhren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Quickly adorns pulse with a misplaced status ending as she takes Doll's pulse.","id":"shakespeare014.lex.quickly_pulsidge.sense","status":"draft"}],"status":"draft","variants":[]},"ff1c23661850eebf048e5d3a7b42aeb84d1abcf8ed6b2a76cdd4d08705a9700d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kwikli","id":"shakespeare014.lex.quickly_windsor_housekeeper","ipa":"","label":"quickly_windsor_housekeeper","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kwikli","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The doctor's housekeeper. Uses the established dramatic pronunciation; the Windsor speeches identify her by her employment here.","id":"shakespeare014.lex.quickly_windsor_housekeeper.sense","status":"draft"}],"status":"draft","variants":[]},"65686286698105a05777c9b431eefc7d0bb4cb9c2d7f36f1be01268783d551cf":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_quicksand_acts","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_quicksand_acts","exampleIds":[],"headword":"melsanil","id":"shakespeare014.lex.quicksand_hazard","ipa":"","label":"quicksand_hazard","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melsanil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Unstable sand that allows sinking, the image Antony uses for Lepidus\u2019s drinking hazard. No literal sand on the galley and no Acts voyage or modern mechanism is asserted.","id":"shakespeare014.lex.quicksand_hazard.sense","status":"draft"}],"status":"draft","variants":[]},"401ebf2aba66122be3f68dff37863170261e87a7251be464de021aebcd472e87":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: liquid + silver","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: liquid + silver","exampleIds":[],"headword":"rennave\u00dbzar","id":"shakespeare014.lex.quicksilver_metal","ipa":"","label":"quicksilver_metal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"rennaveshzar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The fluid metal mercury, used to describe the swiftness of the poison through the body. Distinct from the god Mercury.","id":"shakespeare014.lex.quicksilver_metal.sense","status":"draft"}],"status":"draft","variants":[]},"f43686e7b41f29c7fa991030177c03f8de2874c4453770d2c0c768e08cf0cf7e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of quiet","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of quiet","exampleIds":[],"headword":"dlenson","id":"shakespeare014.lex.quietness_condition","ipa":"","label":"quietness_condition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlenson","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Untroubled stillness, personified as growing sick of rest and seeking disruptive change.","id":"shakespeare014.lex.quietness_condition.sense","status":"draft"}],"status":"draft","variants":[]},"9366301d95a739eece492628426cd1a623cb5392a8e91829020c27f9eaaa07a7":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: wing + feather","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: wing + feather","exampleIds":[],"headword":"v\u00ddlawinwilen","id":"shakespeare014.lex.quill","ipa":"","label":"quill","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"v\u012blawinwilen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A strong wing feather of the raven, not necessarily cut as a writing pen in this occurrence.","id":"shakespeare014.lex.quill.sense","status":"draft"}],"status":"draft","variants":[]},"502b5001c8d44ce4f3b5d5eed5accb2203d988dbfa211c07a74794bf8b923b46":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: feather + pen","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: feather + pen","exampleIds":[],"headword":"wilenseren","id":"shakespeare014.lex.quill_pen","ipa":"","label":"quill_pen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wilenseren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A feather writing pen, explicitly writing verse in Sonnets 83 and 85; distinct from an uncut bird feather.","id":"shakespeare014.lex.quill_pen.sense","status":"draft"}],"status":"draft","variants":[]},"f8cd76d36028a938a7d0bdf59f1076f68bd50a6d37941101fba95c6f4ec73691":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kwinapalus","id":"shakespeare014.lex.quinapalus_fools_authority","ipa":"","label":"quinapalus_fools_authority","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kwinapalus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Authority cited by Feste to license his witticism.","id":"shakespeare014.lex.quinapalus_fools_authority.sense","status":"draft"}],"status":"draft","variants":[]},"11036ad2146527cc7c31c70f93650d44d1f310fdc540c038943bc7b7ced09134":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: gold + scent + fruit","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: gold + scent + fruit","exampleIds":[],"headword":"azarnel\u00ebrvenam","id":"shakespeare014.lex.quince_fruit_kitchen","ipa":"","label":"quince_fruit_kitchen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azarnel\u00fcrvenam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The fragrant fruit requested for cooking with dates. Distinct from Peter Quince's surname.","id":"shakespeare014.lex.quince_fruit_kitchen.sense","status":"draft"}],"status":"draft","variants":[]},"e53aaa3931766838486ad8b265f47529ddcdfb29a0de9232467abbaad468907d":{"audioLinks":[],"citations":[{"locator":"Authored native compound: exercise + target","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: exercise + target","exampleIds":[],"headword":"vor\u00cb\u00cdnonkerth\u00ebn","id":"shakespeare014.lex.quintain_practice","ipa":"","label":"quintain_practice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorhw\u0117rnonkerth\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A practice target for mock mounted combat, invoked as a lifeless stand-in for the speechless Orlando. Native exercise + target; not a living opponent or an actual object brought onstage.","id":"shakespeare014.lex.quintain_practice.sense","status":"draft"}],"status":"draft","variants":[]},"c3e5c1fb87d27104ea596accf584ac7f645acda21a2f9172f60ad8b2ea6dc85f":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of essence","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of essence","exampleIds":[],"headword":"nir\u00d7","id":"shakespeare014.lex.quintessence_extract","ipa":"","label":"quintessence_extract","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nir\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The finest concentrated essence, distilled from every spirit in the poem. Native essence in an explicit extraction sense. The word\u2019s fifth-element background is not an assertion of five spirits or one fifth of each spirit in this passage.","id":"shakespeare014.lex.quintessence_extract.sense","status":"draft"}],"status":"draft","variants":[]},"a6cecef4ac5759bed723b0be06e2d1d5f4c404b012afbd7f9406df4e498b3479":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kwintus","id":"shakespeare014.lex.quintus_ancestry","ipa":"","label":"quintus_ancestry","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kwintus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Quintus paired with Publius in Brutus\u2019s ancestry claim. Personal name, not a number word to be converted to Unta five.","id":"shakespeare014.lex.quintus_ancestry.sense","status":"draft"}],"status":"draft","variants":[]},"556554c3d2698cfe20f76b28bf2bf74f1ed57c9a773731ec522472675f84bb3a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kwintus","id":"shakespeare014.lex.quintus_titus_son","ipa":"","label":"quintus_titus_son","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kwintus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"Son of Titus, accused with his brother Martius. His personal name is distinct from an ordinal.","id":"shakespeare014.lex.quintus_titus_son.sense","status":"draft"}],"status":"draft","variants":[]},"25c2abc7ef56f9898fd0b412ba334aa5b1422be0bb3050ae931c331de15d5b86":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: small + taunt","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: small + taunt","exampleIds":[],"headword":"vimintavrel","id":"shakespeare014.lex.quip_taunt","ipa":"","label":"quip_taunt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vimintavrel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A pointed mocking reply in Touchstone\u2019s named ladder of quarrels.","id":"shakespeare014.lex.quip_taunt.sense","status":"draft"}],"status":"draft","variants":[]},"649c937be61c99bd1010cff1ad626acf65cb19e1aaf8eda4f22ebe523719408f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: ring + throw + sport","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: ring + throw + sport","exampleIds":[],"headword":"viminolentarnfaln","id":"shakespeare014.lex.quoits_game","ipa":"","label":"quoits_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminolentarnfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The ring-throwing game at which Falstaff says Poins excels.","id":"shakespeare014.lex.quoits_game.sense","status":"draft"}],"status":"draft","variants":[]},"4a5e8e5bf4647b90ddb701c0f1c1179303c2547ccb4e7c98ea2fa549d8c1f6c3":{"audioLinks":[],"citations":[{"locator":"Authored native compound: day + fever","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: day + fever","exampleIds":[],"headword":"yelvorher\u00db","id":"shakespeare014.lex.quotidian_fever","ipa":"","label":"quotidian_fever","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yelvorhersh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A recurrent daily fever, native day + fever, used for love\u2019s recurring fits. Keeps the daily interval without assigning a new number of fits per day or making a real clinical diagnosis.","id":"shakespeare014.lex.quotidian_fever.sense","status":"draft"}],"status":"draft","variants":[]},"911ed1d6af8fe2d0a7a7a27253f1d159bcccdd23f7c888a01d08a8308c567cb5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_coney","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_coney","exampleIds":[],"headword":"\u00d3\u00d7m\u00eb","id":"shakespeare014.lex.rabbit","ipa":"","label":"rabbit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"th\u0113m\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The burrowing coney/rabbit in the English hunting passage. Contextual later use of the native coney-category form; makes no retrospective taxonomic claim about the frozen Bible.","id":"shakespeare014.lex.rabbit.sense","status":"draft"}],"status":"draft","variants":[]},"17b720a2041fa66370552ce45a0ad584ebc68b9554