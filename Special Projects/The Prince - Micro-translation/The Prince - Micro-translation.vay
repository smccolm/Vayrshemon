_richards_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ratklif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The knight who oversees executions and brings Richard news at Bosworth.","id":"shakespeare014.lex.ratcliffe_richards_agent.sense","status":"draft"}],"status":"draft","variants":[]},"e549562a1a52b6b1287d58a54d55b7e53bbd536d541262d0e36a34e64430c2f6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: rat_rodent + poison","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: rat_rodent + poison","exampleIds":[],"headword":"musilgorenmurnam","id":"shakespeare014.lex.ratsbane_poison","ipa":"","label":"ratsbane_poison","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"musilgorenmurnam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Rat poison in the shepherd's wish about the milk Joan drank as a child.","id":"shakespeare014.lex.ratsbane_poison.sense","status":"draft"}],"status":"draft","variants":[]},"9d42e9fd602bb9bfb9f1d2c379a315d3210c9858849a05751e1dfe6ab2292cf2":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"ravenspurg","id":"shakespeare014.lex.raven_spurgh","ipa":"","label":"raven_spurgh","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ravenspurg","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The place from which Hotspur recollects Northumberland and Bolingbroke returning.","id":"shakespeare014.lex.raven_spurgh.sense","status":"draft"}],"status":"draft","variants":[]},"c6c3e992f3c744999c32526920c9c31192dbf1d4d4e8951e318cc0ab7fe18557":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: ravish + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: ravish + person","exampleIds":[],"headword":"jorgor\u00e7zts\u00dflum","id":"shakespeare014.lex.ravisher_person","ipa":"","label":"ravisher_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jorgor\u016bzts\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A perpetrator of sexual violence, in the servingman\u2019s personification of war. Native ravish-person preserves the opposed sexual injury and cuckold-making analogy; it is not merely a destroyer.","id":"shakespeare014.lex.ravisher_person.sense","status":"draft"}],"status":"draft","variants":[]},"5ec859e8d86411c54a331c8e5044c3e567075a54b12d0e0e2d8947a41cb8b2cb":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: skin + hurt","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: skin + hurt","exampleIds":[],"headword":"shalemmurvorh\u00eb","id":"shakespeare014.lex.raw","ipa":"","label":"raw","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"shalemmurvorh\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Tender and abraded-looking, applied to tear-soaked eyes; not uncooked food.","id":"shakespeare014.lex.raw.sense","status":"draft"}],"status":"draft","variants":[]},"09a48e0873da5716b21add64ce3fc6f9ffc9152e948273e9606efe2ae0389bca":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of raw","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of raw","exampleIds":[],"headword":"shalemmurvorh\u00eb","id":"shakespeare014.lex.raw_untrained","ipa":"","label":"raw_untrained","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"shalemmurvorh\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Unpractised or unformed in wit, with tender/sore flesh available in the adjacent incision joke. Contextual extension of native raw; the source English overlap with uncooked food is not claimed exact native homophony.","id":"shakespeare014.lex.raw_untrained.sense","status":"draft"}],"status":"draft","variants":[]},"050a277e0fe14aca94c7a4d6f20042c7c74984619fbd3114c62b851973d28e93":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from light, thread","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from light, thread","exampleIds":[],"headword":"b\u00d7\u00c7rthiril","id":"shakespeare014.lex.ray","ipa":"","label":"ray","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u0113\u00e3rthiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A directed beam of light, extended to the gaze of the eye-lamps.","id":"shakespeare014.lex.ray.sense","status":"draft"}],"status":"draft","variants":[]},"bd3d7a786f2ae66783de8ee3d57d392bd2eb394686932f886f38a85160540d65":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"r\u00d7","id":"shakespeare014.lex.re_solmization_syllable","ipa":"","label":"re_solmization_syllable","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"r\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The foreign sung syllable re in Peter's threat to re the musicians. Localized as a named musical syllable, without assigning an absolute pitch.","id":"shakespeare014.lex.re_solmization_syllable.sense","status":"draft"}],"status":"draft","variants":[]},"fe0740b557401cccc1030113f8c6a938a26be08ceeacc08992b8c78a5594a382":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"reding","id":"shakespeare014.lex.reading_berkshire_town","ipa":"","label":"reading_berkshire_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"reding","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The first of the towns Evans names when warning the Host about horse thieves. Source label preserves Readings.","id":"shakespeare014.lex.reading_berkshire_town.sense","status":"draft"}],"status":"draft","variants":[]},"11a462a3be8d63791cb3977064e73c476585ec7b0c0dcea4ce9ce551809af903":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from horse, rise","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from horse, rise","exampleIds":[],"headword":"thalner\u00c3\u00cd","id":"shakespeare014.lex.rear_horse","ipa":"","label":"rear_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thalnerjzh\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A horse rises on its hind legs; not rear a child.","id":"shakespeare014.lex.rear_horse.sense","status":"draft"}],"status":"draft","variants":[]},"b3d9f4fd8aa726c9a0bd3ac5d2dfd868be7f80b9c0b1eee74f81cf1557e34141":{"audioLinks":[],