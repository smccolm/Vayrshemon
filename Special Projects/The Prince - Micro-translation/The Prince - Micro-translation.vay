andon_arrest_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"brandon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The officer who orders the sergeant to arrest Buckingham, then tells Abergavenny to accompany him.","id":"shakespeare014.lex.brandon_arrest_officer.sense","status":"draft"}],"status":"draft","variants":[]},"519e5c1eef46d73a862e4103b265875e65df3d6687115a758cdfece734605940":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"brandon","id":"shakespeare014.lex.brandon_richmond_bearer","ipa":"","label":"brandon_richmond_bearer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"brandon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"Richmond's standard-bearer at Bosworth. Distinct from the officer arresting Buckingham in Henry VIII.","id":"shakespeare014.lex.brandon_richmond_bearer.sense","status":"draft"}],"status":"draft","variants":[]},"7a511135463f8ff9cb63f45a26fa2c0e6d4703ae07fd62eb3d1d4914160d17f0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_brass","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_brass","exampleIds":[],"headword":"zar\u00d7\u00d3","id":"shakespeare014.lex.brass","ipa":"","label":"brass","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zar\u0113th","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The durable copper-alloy monumental metal in Sonnets 64\u201365; the source label is retained without asserting a precise modern alloy composition.","id":"shakespeare014.lex.brass.sense","status":"draft"}],"status":"draft","variants":[]},"4611a6ae330abc81c2ffe35d610dfc86770a601fd5339878120368bb23414aa5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of fine","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of fine","exampleIds":[],"headword":"elin","id":"shakespeare014.lex.brave_showy","ipa":"","label":"brave_showy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"elin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Fine, splendid or showy, with ironic force in Celia\u2019s repeated brave/bravely. Distinct from the narrower courageous sense; the same native stem is repeated throughout the boast parody.","id":"shakespeare014.lex.brave_showy.sense","status":"draft"}],"status":"draft","variants":[]},"527cecad229aa1ba7449ccbca37210ed351fe8498c0987bbe9239ba484145bec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: strong + flesh","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: strong + flesh","exampleIds":[],"headword":"jw\u00ebnenplestenvorin","id":"shakespeare014.lex.brawn_muscle","ipa":"","label":"brawn_muscle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jw\u00fcnenplestenvorin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Muscular flesh, especially the arm bearing the shield that Aufidius intended to hew away. Native strong-flesh, not prepared meat or a target board.","id":"shakespeare014.lex.brawn_muscle.sense","status":"draft"}],"status":"draft","variants":[]},"39c24cff0d55a2e2160b9b0bd89f17ccb0b33d6e480d6bc72a49d3bc16530836":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: coal + vessel","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: coal + vessel","exampleIds":[],"headword":"zarimborel","id":"shakespeare014.lex.brazier_coals","ipa":"","label":"brazier_coals","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarimborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The vessel of burning coals used to heat the irons. The stage direction does not describe a sanctuary implement.","id":"shakespeare014.lex.brazier_coals.sense","status":"draft"}],"status":"draft","variants":[]},"611e48553165a5e5915f2285496082be50c98a1d352190d0e4615b087472d21c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: morning + meal","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: morning + meal","exampleIds":[],"headword":"venserklojvord\u00cdn\u00d7r","id":"shakespeare014.lex.breakfast_meal","ipa":"","label":"breakfast_meal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venserklojvord\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The morning meal where eight whole boars and twelve guests are reported. No invented meal time or Unta calendar unit.","id":"shakespeare014.lex.breakfast_meal.sense","status":"draft"}],"status":"draft","variants":[]},"191722169b0a5074878bb3975fbb219dbc840674b3583a27555284e95dc31b4d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"breknok","id":"shakespeare014.lex.brecknock_buckingham_refuge","ipa":"","label":"brecknock_buckingham_refuge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"