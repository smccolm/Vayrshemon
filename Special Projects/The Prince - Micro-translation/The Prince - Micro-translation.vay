s":[],"citations":[{"locator":"Authored native derivation/sense: fool + head","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fool + head","exampleIds":[],"headword":"lofharen","id":"shakespeare014.lex.coxcomb_head","ipa":"","label":"coxcomb_head","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lofharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A fool\u2019s head in Menenius\u2019s threat that heads will fall as caps once flew. Native fool-head preserves the contempt and cap/head parallel, without inventing literal cock feathers or a separate jester costume.","id":"shakespeare014.lex.coxcomb_head.sense","status":"draft"}],"status":"draft","variants":[]},"706e3470d8abdf83f31bbf93eac9e0c980bec4cbd0701a3cfede22ae2a8aa2d7":{"audioLinks":[],"citations":[{"locator":"Authored native lexical root, not a claim of documented historical sound change.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Authored native lexical root, not a claim of documented historical sound change.","exampleIds":[],"headword":"zelin","id":"shakespeare014.lex.coy","ipa":"","label":"coy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"zelin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Reserved or withholding in affection, without implying secretly consenting; here the speaker\u2019s description.","id":"shakespeare014.lex.coy.sense","status":"draft"}],"status":"draft","variants":[]},"7be26f3a87315163c21b9085f1eacd260f046d35557fe09c172b51e3bc189f70":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sour + apple","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Authored native derivation or sense: sour + apple","exampleIds":[],"he