":"apeninz","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Mountains named by the Bastard in his parody of conversation with a traveler.","id":"shakespeare014.lex.apennines_mountains.sense","status":"draft"}],"status":"draft","variants":[]},"e0c74b8e53a5084366685fd87a717ccf67dda35d7390e70cb28a4411e6609a04":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"apolodorus","id":"shakespeare014.lex.apollodorus_carrier","ipa":"","label":"apollodorus_carrier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"apolodorus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The named man who carried the queen in the reported episode. The source\u2019s unfinished sentence is completed by Enobarbus; no added personal history is supplied.","id":"shakespeare014.lex.apollodorus_carrier.sense","status":"draft"}],"status":"draft","variants":[]},"a735c4c0f28570bfad5f66580c3e4ad06a293841c2be64b411757e2366556954":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: body + stop","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: body + stop","exampleIds":[],"headword":"vorg\u00e7z\u00e9l","id":"shakespeare014.lex.apoplexy_torpor","ipa":"","label":"apoplexy_torpor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorg\u016bz\u00e9l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A disabling bodily shutdown or torpor in the servant\u2019s personification of peace. Native body-stop, without imposing a modern clinical diagnosis or cause.","id":"shakespeare014.lex.apoplexy_torpor.sense","status":"draft"}],"status":"draft","variants":[]},"5bf0932ed0be68e8b42fa8d9fb391070ac01cc27b1f032fb20232e2ce46548ab":{"audioLinks":[],"citations":[{"locator":"Native compound of fear, astonish","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"Native compound of fear, astonish","exampleIds":[],"headword":"marh\u00c9ft\u00cdh\u00eb","id":"shakespeare014.lex.appall_native","ipa":"","label":"appall_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"marh\u00e4ft\u0117rh\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Astound with horror, in the poem the reaction of personified Property to the loss of self-distinction.","id":"shakespeare014.lex.appall_native.sense","status":"draft"}],"status":"draft","variants":[]},"ab03dfacc0685273a9ebd2d4cb879dbeb7bd010a7332f52eba945f704ec5277f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: accuse + challenge","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Authored native derivation or sense: accuse + challenge","exampleIds":[],"headword":"murlamtondaw\u00cf\u00dfen","id":"shakespeare014.lex.appeal_charge_combat","ipa":"","label":"appeal_charge_combat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murlamtondaw\u00cf\u014den","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"Charge a person with treason under the offer of proof by individual combat.","id":"shakespeare014.lex.appeal_charge_combat.sense","status":"draft"}],"status":"draft","variants":[]},"dd37a1580949d1680243b97b8d654d26acc35d84cb134c246a4ad6f1c85e01e2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of ask","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of ask","exampleIds":[],"headword":"w\u00cf\u00df","id":"shakespeare014.lex.appeal_request","ipa":"","label":"appeal_request","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb/noun","pronunciation":"w\u00cf\u014d","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"An earnest oral appeal for intervention, made by raised hands or speech; distinct from a written petition or formal judicial appeal.","id":"shakespeare014.lex.appeal_request.sense","status":"draft"}],"status":"draft","variants":[]},"f81306d0973ba5c59020c2fb45b977d84cb71ecc2b4ed39790d96710a7ee8f7a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of hue","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of hue","exampleIds":[],"headword":"l\u00c7m","id":"shakespeare014.lex.appearance_hue","ipa":"","label":"appearance_hue","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"l\u00e3m","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Colour, complexion and visible form together in Sonnet 20; no biographical proper name is inferred from the word.","id":"shakespeare014.lex.appearance_hue.sense","status":"draft"}],"status":"draft","variants":[]},"2b5153e44085ce2a332c8f125496c31d1bad35b1e8d47d593b479f0210e5df54":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_appease","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_appease","exampleIds":[],"headword":"\u00e5\u00d1dlenson","id":"shakespeare014.lex.appease","ipa":"","label":"appease","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ouchdlenson","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Quiet or relieve hostility/passion; context extends the inherited anger-soothing sense to desire and distress.","id":"shakespeare014.lex.appease.sense","status":"draft"}],"status":"draft","variants":[]},"a4e0d7098a111741e92ed26f352cfc4ac284ec7073a42988f271bacafb112fd2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: accuse + person","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Authored native derivation or sense: accuse + person","exampleIds":[],"headword":"murlamtondas\u00dflum","id":"shakespeare014.lex.appellant_trial_combat","ipa":"","label":"appellant_trial_combat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murlamtondas\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"The party who brings a formal charge and offers to prove it by combat.","id":"shakespeare014.lex.appellant_trial_combat.sense","status":"draft"}],"status":"draft","variants":[]},"4b59258b84720ddb1ddca1686a254f7e218b0da8b5e2333e3da4873ecb57fbc0":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: approve + sound","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: approve + sound","exampleIds":[],"headword":"lamsenson","id":"shakespeare014.lex.applause","ipa":"","label":"applause","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamsenson","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Audible public approval or acclamation; plausibly at the poem\u2019s close, not an assertion of mere probability.","id":"shakespeare014.lex.applause.sense","status":"draft"}],"status":"draft","variants":[]},"1454e4327c207ac081579334a551c473384c5f0c0ed1ac430b451164dc518e83":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wrinkle + apple","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: wrinkle + apple","exampleIds":[],"headword":"shalenv\u00dfrmel","id":"shakespeare014.lex.applejohn_fruit","ipa":"","label":"applejohn_fruit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"shalenv\u014drmel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The long-keeping apple to which Falstaff compares his supposed shriveling.","id":"shakespeare014.lex.applejohn_fruit.sense","status":"draft"}],"status":"draft","variants":[]},"dedbcf09d2e2fa5ccb436d7780d5656653c1bac8ffb3dac02e1ff935354689ae":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: part + give","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: part + give","exampleIds":[],"headword":"threninf\u00c5w","id":"shakespeare014.lex.apportion_allot","ipa":"","label":"apportion_allot","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"threninf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Assign a portion or territory to a recipient. Native part-give, distinguishing allocation from a price rating or an unqualified physical handover.","id":"shakespeare014.lex.apportion_allot.sense","status":"draft"}],"status":"draft","variants":[]},"37bfae5ddc598706b1f3bf8ef060ca89da004ecce958e8a16e4bb15de6a24c4b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of proof","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of proof","exampleIds":[],"headword":"l\u00e1mgl\u00c9st","id":"shakespeare014.lex.approof_character","ipa":"","label":"approof_character","notes":"","orthographyId":"thimfora-79","