rb/noun","pronunciation":"horen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Examine opposed arguments in speech or thought; the rhetorical contest within Tarquin.","id":"shakespeare014.lex.debate.sense","status":"draft"}],"status":"draft","variants":[]},"af6da3477b5c1186a232434dc28ff879908987e09257767a2051d9dbbebd55a9":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: debt + release","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: debt + release","exampleIds":[],"headword":"ow\u00ebmaserf\u00c5w","id":"shakespeare014.lex.debt_discharge","ipa":"","label":"debt_discharge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ow\u00fcmaserf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Release from an outstanding obligation, the quietus obtained when Nature hands over her treasure in Sonnet 126. Financial metaphor, not a named death certificate.","id":"shakespeare014.lex.debt_discharge.sense","status":"draft"}],"status":"draft","variants":[]},"868b1e8374a46818d87be2aeaf32befd226aa8e52c4c4526072d5b32ef7223b0":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: debt","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: debt","exampleIds":[],"headword":"ow\u00ebs\u00dflum","id":"shakespeare014.lex.debtor_person","ipa":"","label":"debtor_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ow\u00fcs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A person owing an obligation, the friend made liable for the speaker in Sonnet 134.","id":"shakespeare014.lex.debtor_person.sense","status":"draft"}],"status":"draft","variants":[]},"d22a8f91601ac6f15b0d488fc9d68fe05c792048e0a6ba01f8b813260810f5fd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_corrupt_decay","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_corrupt_decay","exampleIds":[],"headword":"muram","id":"shakespeare014.lex.decay","ipa":"","label":"decay","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"muram","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Lose soundness or substance; extended here to fragile happiness, without implying moral guilt.","id":"shakespeare014.lex.decay.sense","status":"draft"}],"status":"draft","variants":[]},"b972bf41c9f1b7782ea8555682e5806c5ede0a48d5bd08c28e1978f3eb033f75":{"audioLinks":[],"citations":[{"locator":"Source-calendar name expressed as native Unta ordinal twelve plus month.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Source-calendar name expressed as native Unta ordinal twelve plus month.","exampleIds":[],"headword":"\u00c9m\u00d7n\u00df\u2019t venlun","id":"shakespeare014.lex.december_source","ipa":"","label":"december_source","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u00e4m\u0113n\u014d\u2019t venlun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"December, the twelfth month of the source English calendar, personified as old in Sonnet 97. Uses the Unta word ordinal for twelve plus month, without inventing a Vayrshemon calendar equivalence.","id":"shakespeare014.lex.december_source.sense","status":"draft"}],"status":"draft","variants":[]},"d0304d23547c13e09de773e4c3962619f83e23b4d157a86e072e8db2c19d072a":{"audioLinks":[],"citations":[{"locator":"A deliberate alteration of a native word in Dogberry's report to Leonato.","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"A deliberate alteration of a native word in Dogberry's report to Leonato.","exampleIds":[],"headword":"s\u00e3\u00d1d\u00d7vlehm","id":"shakespeare014.lex.decerns_dogberry_error","ipa":"","label":"decerns_dogberry_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"soichd\u0113vlehm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Dogberry's malformed decerns. The intended native expression is soichv\u0113dlehm.","id":"shakespeare014.lex.decerns_dogberry_error.sense","status":"draft"}],"status":"draft","variants":[]},"8d2b482b4ee41938a9a45b4731b01520c6ab3455d5220e7cd95e17051a0172ac":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"desius","id":"shakespeare014.lex.decius_brutus_conspirator","ipa":"","label":"decius_brutus_conspirator","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"desius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"Decius Brutus, the conspirator who interprets Calphurnia's dream. Distinct from the Brutus married to Portia.","id":"shakespeare014.lex.decius_brutus_conspirator.sense","status":"draft"}],"status":"draft","variants":[]},"a1ae91aefb093d4c40e7af3afb34968aadb8ac30c4d01420cf5f19e7670dd8f1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: ship + floor","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: ship + floor","exampleIds":[],"headword":"meranjo\u00d9shal","id":"shakespeare014.lex.deck_surface","ipa":"","label":"deck_surface","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"meranjongshal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The exposed surface where Posthumus remains in sight as the ship departs.","id":"shakespeare014.lex.deck_surface.sense","status":"draft"}],"status":"draft","variants":[]},"75a253caad99182b6be75bad83fb90afc15f3874eaca4a90e5f8cf292959c3f6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: fall","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fall","exampleIds":[],"headword":"gaktriv","id":"shakespeare014.lex.decline_fortune","ipa":"","label":"decline_fortune","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gaktriv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Fall in fortune or influence, the citizens\u2019 supposed political predictions; no physical falling is asserted.","id":"shakespeare014.lex.decline_fortune.sense","status":"draft"}],"status":"draft","variants":[]},"068c53fd3fe6a649dc8afb0bcad280487d392d9c5db7590aabdc4ae894489c3c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of offer","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of offer","exampleIds":[],"headword":"f\u00c5wgl\u00c9st","id":"shakespeare014.lex.dedicate","ipa":"","label":"dedicate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"f\u0101wgl\u00e4st","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Address or offer a work to its honoured subject in Sonnet 82; literary dedication, without requiring a sacred consecration ceremony.","id":"shakespeare014.lex.dedicate.sense","status":"draft"}],"status":"draft","variants":[]},"8a3953c7a37f1630a409b9161ce1766194bcc7db17e838c0b0f17c41534de3ba":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from honour, offer","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from honour, offer","exampleIds":[],"headword":"arvlamf\u00c5wgl\u00c9st","id":"shakespeare014.lex.dedicate_work","ipa":"","label":"dedicate_work","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"arvlamf\u0101wgl\u00e4st","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Offer an authored work in honour of a named patron; not consecrate a building or merely address someone.","id":"shakespeare014.lex.dedicate_work.sense","status":"draft"}],"status":"draft","variants":[]},"91a81489669a8b89bf44e9027968600ef9cd5afa823c2f3ae16cecce20c4c089":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cut + bond","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: cut + bond","exampleIds":[],"headword":"dest\u00eb\u00c5kl\u00e1rjem","id":"shakespeare014.lex.deed_indenture","ipa":"","label":"deed_indenture","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dest\u00fc\u0101kl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"An indenture whose counterparts attest an agreement. Hamlet restricts the body to a pair of deeds' dimensions.","id":"shakespeare014.lex.deed_indenture.sense","status":"draft"}],"status":"draft","variants":[]},"aac977b7a9df240b2ef1e0921ac342d88251af2f54d945af8a8c7ae1338eeb3f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: deep + vow","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: deep + vow","exampleIds":[],"head