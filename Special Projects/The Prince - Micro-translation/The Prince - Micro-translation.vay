on":"adalas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Adallas, the printed name of the Thracian king. Do not silently emend the source spelling to another edition\u2019s form.","id":"shakespeare014.lex.adallas_king.sense","status":"draft"}],"status":"draft","variants":[]},"31d6ca321ebf13a4a045ee1c211bae37950d40ba742061701a3c5e27d14aedc6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"adam","id":"shakespeare014.lex.adam_ballad_archer","ipa":"","label":"adam_ballad_archer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"adam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The accomplished archer in Benedick's bottle-and-cat boast, traditionally identified as Adam Bell. Only Adam is spoken here.","id":"shakespeare014.lex.adam_ballad_archer.sense","status":"draft"}],"status":"draft","variants":[]},"b2285742cd1b9e26fce0027cde4960daebc924e5f04889bab5530221f7d5bac5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"adam","id":"shakespeare014.lex.adam_petruchio_servant","ipa":"","label":"adam_petruchio_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"adam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"One of the servants whom Grumio declares adequately dressed.","id":"shakespeare014.lex.adam_petruchio_servant.sense","status":"draft"}],"status":"draft","variants":[]},"9cded79c70a61255500013543993e8bca590ef104ed026e603732d01323727ab":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_adam","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_adam","exampleIds":[],"headword":"adam","id":"shakespeare014.lex.adam_primordial","ipa":"","label":"adam_primordial","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"adam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The primordial Adam named in the Duke\u2019s allusion to Adam\u2019s penalty, not the old servant Adam present elsewhere in this play. Reviewed personal-name identity; the disputed interpretation of the penalty is recorded separately.","id":"shakespeare014.lex.adam_primordial.sense","status":"draft"}],"status":"draft","variants":[]},"2fed1c87565e55e1620172f4bb1bf60a76bc81066cc2e7daeaab7e2cf48e8808":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"adam","id":"shakespeare014.lex.adam_servant","ipa":"","label":"adam_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"adam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The old servant Adam in As You Like It, not Biblical Adam or a place bearing that name.","id":"shakespeare014.lex.adam_servant.sense","status":"draft"}],"status":"draft","variants":[]},"6cb1d8ed5872741a7afe17a07e0ea403e942b33c71b9b5081ee93a707539e682":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: delay","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native de