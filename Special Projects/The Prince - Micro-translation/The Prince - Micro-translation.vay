cal decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Overshadow or diminish a rival in Antony\u2019s promised military preparations. Source stain has the belittling sense here; explicit native shadow made verbal, without inventing dye or a completed victory.","id":"shakespeare014.lex.stain_eclipse.sense","status":"draft"}],"status":"draft","variants":[]},"75ef47a89f00ac53c696d99667d70c244a8b7b8a8f192667a7826982072eda98":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"steins","id":"shakespeare014.lex.staines_town","ipa":"","label":"staines_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"steins","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The town to which Quickly offers to accompany Pistol.","id":"shakespeare014.lex.staines_town.sense","status":"draft"}],"status":"draft","variants":[]},"35afd10cbdca0d571e66fc555abfbaa9d9541e10075ee82d7e88202428c0fa10":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_stair","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_stair","exampleIds":[],"headword":"nerpalen","id":"shakespeare014.lex.stair_step","ipa":"","label":"stair_step","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerpalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A step in a flight of stairs, native up-step, extended to successive courtship stages. Source pair of stairs denotes a flight, not two staircases or a supplied exact tread count.","id":"shakespeare014.lex.stair_step.sense","status":"draft"}],"status":"draft","variants":[]},"556967f758e2eda