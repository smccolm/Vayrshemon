el":"notch_cut","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dest\u00fc\u0101den","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Cut a notch or score, paired with scotch/cut in the servants\u2019 meat comparison. Native cut-mark; not a numerical score or tally.","id":"shakespeare014.lex.notch_cut.sense","status":"draft"}],"status":"draft","variants":[]},"929e642a1ce78a398ccab9d01e6ae02a1bfe7cdeeb45e3d21317e68eacc5ecf1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: name + word","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: name + word","exampleIds":[],"headword":"denton","id":"shakespeare014.lex.noun_grammar","ipa":"","label":"noun_grammar","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"denton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The grammatical word for a name, one of the terms that Cade declares abhorrent.","id":"shakespeare014.lex.noun_grammar.sense","status":"draft"}],"status":"draft","variants":[]},"f404846b8194aa23684d3646fb830b433b85126db9e7b1ee46a088db1a1b4260":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_nourish","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_nourish","exampleIds":[],"headword":"wemar\u00d5\u00dfr","id":"shakespeare014.lex.nourish","ipa":"","label":"nourish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"wemar\u0167h\u014dr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Sustain life or a flame, the nourishment consumed into ashes in Sonnet 73; native feed-life development without inherited Biblical agency.","id":"shakespeare014.lex.nourish.sense","status":"draft"}],"status":"draft","variants":[]},"55f3c013fed964b83d739e4cf03f87a15fe40757d970b94848d9bd22982987b7":{"audioLinks":[],"citations":[{"locator":"Authored native compound: new + desire","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: new + desire","exampleIds":[],"headword":"neval\u00c9lm","id":"shakespeare014.lex.novelty_fond","ipa":"","label":"novelty_fond","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"neval\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Fond of new things and changing fashions, source newfangled; native new + desire. Not newly manufactured or merely young.","id":"shakespeare014.lex.novelty_fond.sense","status":"draft"}],"status":"draft","variants":[]},"9b9ba7e3d3c277f1f948ecd5e241c844d3b6b6c1b347a00728624f2321f60cbb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dice + game","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: dice + game","exampleIds":[],"headword":"tarikfaln","id":"shakespeare014.lex.novum_dice_game","ipa":"","label":"novum_dice_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarikfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The dice game excepted in Berowne's boast that five such players cannot otherwise be picked. The spoken line gives no score for a throw.","id":"shakespeare014.lex.novum_dice_game.sense","status":"draft"}],"status":"draft","variants":[]},"937a3d93c504b8d290fd741d25c3223895f91fdce53e4dc32ed7291e10fbc5fb":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"numa","id":"shakespeare014.lex.numa_king","ipa":"","label":"numa_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"numa","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Numa, maternal grandfather of Ancus in the ancestry claim; no other Numa is silently imported.","id":"shakespeare014.lex.numa_king.sense","status":"draft"}],"status":"draft","variants":[]},"c3b76747a5865a2fe8e6b4208062ce41ce1584f9f84bbdc8ac3a757578534a1f":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from feel, cease","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from feel, cease","exampleIds":[],"headword":"semf\u00e7s","id":"shakespeare014.lex.numb","ipa":"","label":"numb","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"semf\u016bs","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Deprive a part of sensation, here fear paralysing Venus\u2019s faculties.","id":"shakespeare014.lex.numb.sense","status":"draft"}],"status":"draft","variants":[]},"674f2c09d4368ebece5beb5212da79062794bfbfc4eba8a24ff8a015fbb49ef7":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Native compound of reckon, essence. Number as numerical distinction, personified in love\u2019s abolition of counting; distinct from noble Count.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Native compound of reckon, essence. Number as numerical distinction, personified in love\u2019s abolition of counting; distinct from noble Count.","exampleIds":[],"headword":"tarennir\u00d7","id":"shakespeare014.lex.number_abstract","ipa":"","label":"number_abstract","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarennir\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Number as numerical distinction, personified in love\u2019s abolition of counting; distinct from noble Count.","id":"shakespeare014.lex.number_abstract.sense","status":"draft"}],"status":"draft","variants":[]},"578f68c008c8fd808344ac341475cb024cf3fbd6f03741849ce4635055413ddf":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of number_abstract","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of number_abstract","exampleIds":[],"headword":"tarennir\u00d7","id":"shakespeare014.lex.number_aggregate","ipa":"","label":"number_aggregate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarennir\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A numerical total or counted company, Sonnet 136\u2019s number among which the speaker asks to pass uncounted. No fixed cardinal value is invented.","id":"shakespeare014.lex.number_aggregate.sense","status":"draft"}],"status":"draft","variants":[]},"436c55c00ae8a90c363b82c913aff8f7d7ad0896eb1bd9639010a0aa08c1e678":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: verse + measure","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: verse + measure","exampleIds":[],"headword":"lilthreninmem","id":"shakespeare014.lex.number_in_verse","ipa":"","label":"number_in_verse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"lilthreninmem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Number as composing or measuring verse in the rhetorical list. Native verse-measure, distinct from numerically counting the love; the parallel cast remains reckon.","id":"shakespeare014.lex.number_in_verse.sense","status":"draft"}],"status":"draft","variants":[]},"15a18ff722dfe47cf7c8244dd39674edb1720343b97dbf4c88f0e42e36437a40":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: write + count","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: write + count","exampleIds":[],"headword":"\u00ddvtaren","id":"shakespeare014.lex.numeral_sign","ipa":"","label":"numeral_sign","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u012bvtaren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"A written sign that represents a number. The Fool pictures Lear as a solitary round zero without another digit beside it.","id":"shakespeare014.lex.numeral_sign.sense","status":"draft"}],"status":"draft","variants":[]},"6a2c60191621fbe8ca93bc1d6307d5d64545f9a00fb2b178336d86f9f3ba5136":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: number_aggregate + excess","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: number_aggregate + excess","exampleIds":[],"headword":"tarennir\u00d7gimeren","id":"shakespeare014.lex.numerical_odds","ipa":"","label":"numerical_odds","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarennir\u0113gimeren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An imbalance of numbers favoring the opposing crowd, described as beyond arithmetic. Native number-excess retains the numerical comparison without inventing a ratio or betting probability.","id":"shakespeare014.lex.numerical_odds.sense","status":"draft"}],"status":"draft","variants":[]},"a1af11bd439bb4086d8d472a28507db1ab690fd794dc468441f08ddc654f7a52":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: vow + woman + house","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: vow + woman + house","exampleIds":[],"headword":"lamjorsalenaz\u00e1l","id":"shakespeare014.lex.nunnery_house","ipa":"","label":"nunnery_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamjorsalenaz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A religious house for vowed women. Hamlet repeats the command to go there. The celibate house, the language of breeding, and the taunting delivery can all be heard together.","id":"shakespeare014.lex.nunnery_house.sense","status":"draft"}],"status":"draft","variants":[]},"3d8a27be5cd55ed78dfae629daaa18d4f979a40244819bd74d1f5cf9e996bca5":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_nurse","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_nurse","exampleIds":[],"headword":"s\u00e3\u00d1s\u00dflum","id":"shakespeare014.lex.nurse","ipa":"","label":"nurse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"soichs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A sustaining caregiver, metaphorically taste nourishing the other senses.","id":"shakespeare014.lex.nurse.sense","status":"draft"}],"status":"draft","variants":[]},"e5f5d03f4d5f5c4f48b1a8920bef23ab16092c993eefbd82115a79ad9b6aecec":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_nurse_feed","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_nurse_feed","exampleIds":[],"headword":"melatwemar","id":"shakespeare014.lex.nurse_feed_child","ipa":"","label":"nurse_feed_child","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melatwemar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Feed and nurture a child, with the mother\u2019s milk-feeding sense available. Reviewed native milk-feed; not hospital care or the noun caregiver.","id":"shakespeare014.lex.nurse_feed_child.sense","status":"draft"}],"status":"draft","variants":[]},"239139b68b80ca6420688b522ed5e5961dde19449cd932e00db5bd2a5416126b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of nurture_upbringing","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of nurture_upbringing","exampleIds":[],"headword":"pomen","id":"shakespeare014.lex.nurture_rear","ipa":"","label":"nurture_rear","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"pomen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Bring up or form a child through care and training, source breed it like a fool. Explicit verbal extension of native upbringing; not beget a new child.","id":"shakespeare014.lex.nurture_rear.sense","status":"draft"}],"status":"draft","variants":[]},"9619460399aad765d584c11180afabb9d6d2aadde4a0f20f344f522554a125c9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of education","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of education","exampleIds":[],"headword":"pomen","id":"shakespeare014.lex.nurture_upbringing","ipa":"","label":"nurture_upbringing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pomen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Cultivated upbringing and good breeding, source nurture in Orlando\u2019s defence. Not merely feeding, and not a claim that he was raised at a particular modern school.","id":"shakespeare014.lex.nurture_upbringing.sense","status":"draft"}],"status":"draft","variants":[]},"7cfebf7bc8d916f58aff5d7b6ae26a3bfd78e581a58ea5a9d4ff7dfb7fbc9e96":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spice + nut","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: spice + nut","exampleIds":[],"headword":"spirilnoral","id":"shakespeare014.lex.nutmeg_spice","ipa":"","label":"nutmeg_spice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"spirilnoral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The brown aromatic seed used to compare the horse's coloring.","id":"shakespeare014.lex.nutmeg_spice.sense","status":"draft"}],"status":"draft","variants":[]},"61d36ff093be62813666d6c5f75ec8ab0665ce1f534338c8b43bca7085da8a40":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from nose, touch","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from nose, touch","exampleIds":[],"headword":"n\u00ebrvoril","id":"shakespeare014.lex.nuzzle","ipa":"","label":"nuzzle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"n\u00fcrvoril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Press or rub with the nose/snout, Venus\u2019s imagined explanation for the wound.","id":"shakespeare014.lex.nuzzle.sense","status":"draft"}],"status":"draft","variants":[]},"fb24596fada22704a19eba2e56111b1d8ae761030769f3ed84cea96baafe32ae":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: mood","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: mood","exampleIds":[],"headword":"mav","id":"shakespeare014.lex.nym_humour","ipa":"","label":"nym_humour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Nym's recurring word for a disposition, intention or way of looking at things. Its form recurs when he speaks of the king's humors.","id":"shakespeare014.lex.nym_humour.sense","status":"draft"}],"status":"draft","variants":[]},"e2392291cb47cbcb3be9dea034d4f1f3c8d1d01a439b15bb1799d899c89eb15f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: steal","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: steal","exampleIds":[],"headword":"shel","id":"shakespeare014.lex.nym_soldier","ipa":"","label":"nym_soldier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"shel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The corporal called Nym. A telling-name rendering takes up the old verb for stealing.","id":"shakespeare014.lex.nym_soldier.sense","status":"draft"}],"status":"draft","variants":[]},"06b6a6d56adb3f1cb3b6beab6e078d7c5d301432999bb1a2f95cfd9fce81bf5f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: water + beat + instrument","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: water + beat + instrument","exampleIds":[],"headword":"yems\u00d7slebs\u00ebnal","id":"shakespeare014.lex.oar_implement","ipa":"","label":"oar_implement","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113slebs\u00fcnal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A hand-worked implement beating water to propel a vessel. Native water-beat-instrument; not row meaning an arrangement of items.","id":"shakespeare014.lex.oar_implement.sense","status":"draft"}],"status":"draft","variants":[]},"99c1168ceee183299302ea5b46e3a858786b1db0572d57e0bf514efcc14396cf":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: hang + grain_kernel","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: hang + grain_kernel","exampleIds":[],"headword":"zarnnel","id":"shakespeare014.lex.oat_nodding_grain","ipa":"","label":"oat_nodding_grain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarnnel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The cereal with nodding grain heads, distinguished from wheat, barley and rye in Ceres's fields.","id":"shakespeare014.lex.oat_nodding_grain.sense","status":"draft"}],"status":"draft","variants":[]},"ecc07e9e0e6ea02181cf639c1c15b2d1394777f61f56407991cf62f57f009207":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: horse + grain_kernel + cake","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: horse + grain_kernel + cake","exampleIds":[],"headword":"thalnelpelam","id":"shakespeare014.lex.oatcake_watch_surname","ipa":"","label":"oatcake_watch_surname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"thalnelpelam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The watchman's oat-and-cake surname. A native horse-grain expression specifies oats, a familiar feed grain.","id":"shakespeare014.lex.oatcake_watch_surname.sense","status":"draft"}],"status":"draft","variants":[]},"818dffd805ea372b3618675ad9c9198137568a80e36b731ce684d66be38b3f7e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: bind + word","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: bind + word","exampleIds":[],"headword":"kl\u00e1rjemton","id":"shakespeare014.lex.oath_clause","ipa":"","label":"oath_clause","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kl\u00f4rjemton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A binding provision or term within an oath, cited in Caesar\u2019s accusation. Not a newspaper article, object, or extra oath.","id":"shakespeare014.lex.oath_clause.sense","status":"draft"}],"status":"draft","variants":[]},"3579916c0fea136f3dce9c5189e64d9f84ba5fe63bf451aa25c07f3fd15dc3dc":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from vow, break","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from vow, break","exampleIds":[],"headword":"lamjorika\u00d9","id":"shakespeare014.lex.oathbroken","ipa":"","label":"oathbroken","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"lamjorikang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Having broken an oath, in the imagined theft of a kiss by the chaste goddess.","id":"shakespeare014.lex.oathbroken.sense","status":"draft"}],"status":"draft","variants":[]},"3ac6536973333acf6abfb0be3bb88e14fdc9f1f2d2abc280cffde9277bb047d6":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from heart, hard","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from heart, hard","exampleIds":[],"headword":"sevarjw\u00ebnenplesten","id":"shakespeare014.lex.obdurate","ipa":"","label":"obdurate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"sevarjw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Unyielding or hardened in feeling; source accusation rather than narrator endorsement.","id":"shakespeare014.lex.obdurate.sense","status":"draft"}],"status":"draft","variants":[]},"fd9a203f68771c8074d0e57851e6aff9b4626bc92919459d66b77372ea53590c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"obidikut","id":"shakespeare014.lex.obidicut_fiend","ipa":"","label":"obidicut_fiend","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"obidikut","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The fiend of lust in Poor Tom's list of five.","id":"shakespeare014.lex.obidicut_fiend.sense","status":"draft"}],"status":"draft","variants":[]},"be84007aeab5ee4974e4f917517c1387f19c8e125c2cc165d722c974a3c770ce":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of offer","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of offer","exampleIds":[],"headword":"f\u00c5wgl\u00c9st","id":"shakespeare014.lex.oblation","ipa":"","label":"oblation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u0101wgl\u00e4st","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A freely offered gift of self, with ritual resonance in Sonnet 125; not automatically a slaughtered sacrifice, bribe or demanded payment.","id":"shakespeare014.lex.oblation.sense","status":"draft"}],"status":"draft","variants":[]},"d878e23aea27be8404a5c95bef1137649316fdecd174ce17ea54de7707171be7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of duty","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of duty","exampleIds":[],"headword":"norven","id":"shakespeare014.lex.obligation","ipa":"","label":"obligation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"norven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A binding duty, specifically the chivalric charge invoked by Lucrece.","id":"shakespeare014.lex.obligation.sense","status":"draft"}],"status":"draft","variants":[]},"514bfb1b09bdae371e2acd4f6bd244b55dd4a5b6ed375acfc1066fbf01713fc0":{"audioLinks":[],"citations":[{"locator":"Authored citation construction from native be:must; external nominal marking applies to the quoted predicate as a whole.","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored citation construction from native be:must; external nominal marking applies to the quoted predicate as a whole.","exampleIds":[],"headword":"r\u00d7\u2019jor","id":"shakespeare014.lex.obligation_citation","ipa":"","label":"obligation_citation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"citation","pronunciation":"r\u0113\u2019jor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Metalinguistic citation of native be-with-obligation, used for the commanding shall discussed in Coriolanus3.1. The native predicate supplies a host for the bound modal; the quoted whole may take external nominal possession/case. It is not an English loan or a claim that the modal suffix is independently a free word.","id":"shakespeare014.lex.obligation_citation.sense","status":"draft"}],"status":"draft","variants":[]},"33d24cd49af942d1f111fa695cd3444362d0a1e2c5170541347a10eb5e712d50":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from hide, dark","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from hide, dark","exampleIds":[],"headword":"o\u00c3brak\u00ebr","id":"shakespeare014.lex.obscurity_hidden","ipa":"","label":"obscurity_hidden","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ojzhbrak\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A concealed or unnoticed state, the dark obscurity in which imagined posterity is destroyed.","id":"shakespeare014.lex.obscurity_hidden.sense","status":"draft"}],"status":"draft","variants":[]},"3839a3d8f21ef12750b7c66537db9953147fc34b65199c767dcce917c3a1cef3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: use","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: use","exampleIds":[],"headword":"\u00e5v","id":"shakespeare014.lex.occupy_euphemism","ipa":"","label":"occupy_euphemism","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ouv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The common verb use made objectionable by a sexual use in Doll's comparison. Both senses are assigned to the same native word here.","id":"shakespeare014.lex.occupy_euphemism.sense","status":"draft"}],"status":"draft","variants":[]},"da650c75f91b4c54b65c7d0b789638124a3fbefd2f55b1b114a95c85f7e21196":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: sound + unta_fraction_b_over_c","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: sound + unta_fraction_b_over_c","exampleIds":[],"headword":"sonf\u00dflem\u00d1\u00e3 \u00dfd\u00d7um","id":"shakespeare014.lex.octave_below","ipa":"","label":"octave_below","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sonf\u014dlemchoi \u014dd\u0113um","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The lower octave: half the vibration rate of its counterpart, expressed through native sound and the exact Unta half. This defines the interval without borrowing octave/diapason or asserting a new Vayrshemon scale.","id":"shakespeare014.lex.octave_below.sense","status":"draft"}],"status":"draft","variants":[]},"0bcd858af9cbac02a4680c1443345ffb663520c50cf0798465a6b0c78454d19c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"oktaviya","id":"shakespeare014.lex.octavia_sister","ipa":"","label":"octavia_sister","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"oktaviya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Octavia, Caesar\u2019s maternal sister proposed as Antony\u2019s wife. Her name is not an Unta eighth or an internal number label.","id":"shakespeare014.lex.octavia_sister.sense","status":"draft"}],"status":"draft","variants":[]},"368f1327781a1a842fbaf4417405215e37871ef2c798a6af1bbb9c1975b1efea":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"oktavius","id":"shakespeare014.lex.octavius_name","ipa":"","label":"octavius_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"oktavius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The given name Octavius attached to Caesar in Charmian\u2019s marriage wish; same person as lex.caesar_octavian, not an ordinal eight.","id":"shakespeare014.lex.octavius_name.sense","status":"draft"}],"status":"draft","variants":[]},"606fb580439a13aa99263d4ca47b4bcffedfd935187833e001b60d749c3ea66c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: pair + remain","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: pair + remain","exampleIds":[],"headword":"\u00d5\u00c5tus gurdlen\u00dbemin","id":"shakespeare014.lex.odd_numerical_parity","ipa":"","label":"odd_numerical_parity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"\u0167h\u0101tus gurdlenshemin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"Counting in pairs leaves a single unpaired member. Falstaff twice attributes luck or divine force to this numerical property.","id":"shakespeare014.lex.odd_numerical_parity.sense","status":"draft"}],"status":"draft","variants":[]},"3046035eae54ef3a6ce988d8c2e05258ecf9a92cbb886b426120307f4c880313":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of advantage","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of advantage","exampleIds":[],"headword":"farmin","id":"shakespeare014.lex.odds_distinction","ipa":"","label":"odds_distinction","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farmin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The preeminence or distinguishing advantage Cleopatra says is gone when Antony dies. Qualitative odds, not numerical betting odds or a stated ratio.","id":"shakespeare014.lex.odds_distinction.sense","status":"draft"}],"status":"draft","variants":[]},"75a566f03c34fdf60e2d5d00f4a5690f4421fbed1dff14554bcc020d6394e85e":{"audioLinks":[],"citations":[{"locator":"Authored native compound: praise + song","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: praise + song","exampleIds":[],"headword":"fartondalil","id":"shakespeare014.lex.ode_lyric","ipa":"","label":"ode_lyric","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"fartondalil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A lyric poem of praise, native praise + song. The tree-hung odes exalt Rosalind; no unstated ancient metrical pattern is claimed.","id":"shakespeare014.lex.ode_lyric.sense","status":"draft"}],"status":"draft","variants":[]},"09b1d117305b518d9b69b3b416364c0f8fca560353e2d46be70b6fe74674beb6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: beast + waste","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: beast + waste","exampleIds":[],"headword":"\u00d5\u00dfrvorf\u00e7venmasifbebis","id":"shakespeare014.lex.offal_refuse","ipa":"","label":"offal_refuse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u0167h\u014drvorf\u016bvenmasifbebis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The rejected animal parts craved after the choice lamb. Garbage carries this bodily sense here.","id":"shakespeare014.lex.offal_refuse.sense","status":"draft"}],"status":"draft","variants":[]},"ce34ed911bd206360033e089dab0e594f16274e60e06897b33fc54eb2c641a8a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: love + offer","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: love + offer","exampleIds":[],"headword":"a\u00d9zf\u00c5wgl\u00c9st","id":"shakespeare014.lex.offer_affection","ipa":"","label":"offer_affection","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"angzf\u0101wgl\u00e4st","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A declaration offered to a lover. Shares its offer stem with tendering payment and offering oneself at a higher price.","id":"shakespeare014.lex.offer_affection.sense","status":"draft"}],"status":"draft","variants":[]},"7d95f81c006fd9090841b988cc45d3f142bf35d60ea0b3b6e3661a7609bd0496":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: office + mark","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: office + mark","exampleIds":[],"headword":"norvenden","id":"shakespeare014.lex.official_insignia","ipa":"","label":"official_insignia","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"norvenden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The marks of public office worn after selection, source official marks. Native office-mark; distinct from bodily wounds as marks of merit and without inventing particular insignia.","id":"shakespeare014.lex.official_insignia.sense","status":"draft"}],"status":"draft","variants":[]},"d6c22b321739b8c32b85e32c8327d9b7be8b4fd99c2d87cc0fe491cebf2ac12e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"oldkastel","id":"shakespeare014.lex.oldcastle_martyr","ipa":"","label":"oldcastle_martyr","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"oldkastel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"John Oldcastle, the martyr expressly distinguished from Falstaff in the Epilogue.","id":"shakespeare014.lex.oldcastle_martyr.sense","status":"draft"}],"status":"draft","variants":[]},"c529d756bad3d281971edc76c8e360d370c9e1c236a9b54d4dcba1222a45df57":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_olive","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_olive","exampleIds":[],"headword":"y\u00eblmel","id":"shakespeare014.lex.olive_tree","ipa":"","label":"olive_tree","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclmel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Olive as the tree or its branches, Peace\u2019s emblem in Sonnet 107. Retains the native botanical form without importing the Genesis dove narrative.","id":"shakespeare014.lex.olive_tree.sense","status":"draft"}],"status":"draft","variants":[]},"ec37062c669a9dfd6b336a7a2a775ba1ba37e922169f9f02fde2610b47c8ade5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"oliver","id":"shakespeare014.lex.oliver_brother","ipa":"","label":"oliver_brother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"oliver","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Oliver, Orlando\u2019s elder brother; distinct from the later Sir Oliver Martext.","id":"shakespeare014.lex.oliver_brother.sense","status":"draft"}],"status":"draft","variants":[]},"1d17415d08d3e1bb06f4dba39089b520a104cc814c65f420c616e7049b78828f":{"audioLinks"