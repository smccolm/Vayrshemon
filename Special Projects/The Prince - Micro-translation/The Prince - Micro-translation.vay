e014.source.henry-v.r1"}],"definition":"The proposed act for the transfer of church estates. Distinguish it from Falstaff's account of tavern expenses.","id":"shakespeare014.lex.parliament_bill.sense","status":"draft"}],"status":"draft","variants":[]},"0c912f137dbae8f541bafb4eb2efca35d1560e6de41e14db7971f095148126ae":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kingdom + council","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: kingdom + council","exampleIds":[],"headword":"var\u00dfnjo\u00d9h\u00c5b\u00cdtorpgur","id":"shakespeare014.lex.parliament_england","ipa":"","label":"parliament_england","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnjongh\u0101b\u0117rtorpgur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The high assembly of the realm summoned by the newly acceded king; it is distinct from the counsel of his personal advisers.","id":"shakespeare014.lex.parliament_england.sense","status":"draft"}],"status":"draft","variants":[]},"7a29c7f7db2e49e21bfcb711740e7c2521537c3c4c81b39ebce99efd0e78b509":{"audioLinks":[],"citations":[{"locator":"Authored native compound: speech + bird","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: speech + bird","exampleIds":[],"headword":"giktenv\u00d7enwil","id":"shakespeare014.lex.parrot_native","ipa":"","label":"parrot_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"giktenv\u0113enwil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The parrot whose noisy cries are compared with a wife\u2019s clamour before rain; native speech + bird as a lexicalized animal category, not every calling bird.","id":"shakespeare014.lex.parrot_native.sense","status":"draft"}],"status":"draft","variants":[]},"f3a39173b75291e8e8fd17b6dfb8addd3f3e451b4d0118021dc805a62ed015aa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cut + leaf + herb","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: cut + leaf + herb","exampleIds":[],"headword":"dest\u00eb\u00c5y\u00ebletyelin","id":"shakespeare014.lex.parsley_kitchen_herb","ipa":"","label":"parsley_kitchen_herb","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dest\u00fc\u0101y\u00fcletyelin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Culinary parsley for stuffing a rabbit, named for its divided leaf.","id":"shakespeare014.lex.parsley_kitchen_herb.sense","status":"draft"}],"status":"draft","variants":[]},"05d1941d7665832f83d3bf4e9ffcce94366b0970623c079f95a785de547572aa":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"partia","id":"shakespeare014.lex.parthia_region","ipa":"","label":"parthia_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"partia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Parthia as the named affiliation of Labienus\u2019s force. An allowed place-name adaptation; not an ordinary word for force or conquest.","id":"shakespeare014.lex.parthia_region.sense","status":"draft"}],"status":"draft","variants":[]},"803078a0f7d290a4122eddb773b518184c66fe293d9ab568883661a57d02656b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: parthia_region + person","sourceId":"shakespe