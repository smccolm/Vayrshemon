e014.source.venus-and-adonis.r1"}],"definition":"The sea-growth material in the red-mouth comparison, without assigning a modern species.","id":"shakespeare014.lex.coral.sense","status":"draft"}],"status":"draft","variants":[]},"161ab57188cc864f5e4de5cd32c733a30fcedcce4bdc7711aad44148dd909552":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kordelya","id":"shakespeare014.lex.cordelia_lear_daughter","ipa":"","label":"cordelia_lear_daughter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kordelya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Lear's youngest daughter, who refuses to measure love in a declaration for a dower.","id":"shakespeare014.lex.cordelia_lear_daughter.sense","status":"draft"}],"status":"draft","variants":[]},"cc55f97caaae7499925db625087ca528bc329851657f006ac42979238e054798":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: heart + strength","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: heart + strength","exampleIds":[],"headword":"sevarjw\u00ebnenplesten","id":"shakespeare014.lex.cordial_restorative","ipa":"","label":"cordial_restorative","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sevarjw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A cordial that strengthens or restores. The queen claims the box contains one, while Cornelius knows its actual action.","id":"shakespeare014.lex.cordial_restorative.sense","status":"draft"}],"status":"draft","variants":[]},"55a5a0fdde4e00602c6fe91876e0b55828666ef8c98a652d506ddecf4bd18af4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"korin","id":"shakespeare014.lex.corin_shepherd","ipa":"","label":"corin_shepherd","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"korin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The older shepherd who advises Silvius and helps the disguised cousins. Distinct semantic identity from the Corin name invoked in another play\u2019s pastoral allusion.","id":"shakespeare014.lex.corin_shepherd.sense","status":"draft"}],"status":"draft","variants":[]},"f5c24017107e782f845e7bb9242f0a2f10bdf4045b2bfb547dea0e80a174014e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"koriolanus","id":"shakespeare014.lex.coriolanus_name","ipa":"","label":"coriolanus_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"koriolanus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The new victory name bestowed on Caius Martius after Corioles; same person, with no role or lookup suffix printed.","id":"shakespeare014.lex.coriolanus_name.sense","status":"draft"}],"status":"draft","variants":[]},"751b0489beb4392a802ba1e3be5107e602451272df86dd7d86097c5a0d58319b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"korioles","id":"shakespeare014.lex.corioles_city","ipa":"","label":"corioles_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"korioles","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The city in the source scene heading and military instructions, without invented modern borders.","id":"shakespeare014.lex.corioles_city.sense","status":"draft"}],"status":"draft","variants":[]},"36854f8226a0dbc2054ffdc5724ed96fa85c9f5545bb7f95304d40daec77bfc2":{"audioLinks":[],"citations":[{"locator":"Authored native compound: wood + close","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: wood + close","exampleIds":[],"headword":"y\u00eblbra","id":"shakespeare014.lex.cork_stop","ipa":"","label":"cork_stop","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclbra","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A cork closure for a bottle, native wood + close as a lexicalized stopper name. Its bark-derived material is part of the category; the compound does not assert it is cut solid timber or provide manufacturing instructions.","id":"shakespeare014.lex.cork_stop.sense","status":"draft"}],"status":"draft","variants":[]},"056cf63f256a9469e31faf5b831775fb0a26ec5c889a43ca40611d2bd3afd784":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: fish_creature + bird","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fish_creature + bird","exampleIds":[],"headword":"drig\u00e1lwil","id":"shakespeare014.lex.cormorant_bird","ipa":"","label":"cormorant_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"drig\u00f4lwil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The fish-eating aquatic bird of the source\u2019s proverbial voracity. Authored lexicalized native fish-bird for this source category, not every bird that eats fish and not a claim of a precise modern species.","id":"shakespeare014.lex.cormorant_bird.sense","status":"draft"}],"status":"draft","variants":[]},"40e69e547006c7a68469e2d5d29bc17fbc6820e63f6a1fc7db93bacefa67842f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: devour","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: devour","exampleIds":[],"headword":"etyekswem","id":"shakespeare014.lex.cormorant_greedy","ipa":"","label":"cormorant_greedy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"etyekswem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Voracious like the proverbial bird, the citizen\u2019s description of the belly. The bird image is explicitly recorded; native devouring epithet does not borrow the English animal sound.","id":"shakespeare014.lex.cormorant_greedy.sense","status":"draft"}],"status":"draft","variants":[]},"eebed84cb8cef940fccecc0da2c691ffd7f386e66f596ee5b3659bd4e23f0224":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"korneliya","id":"shakespeare014.lex.cornelia_mother_of_gracchi","ipa":"","label":"cornelia_mother_of_gracchi","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"korneliya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"The Roman mother invoked by Titus when he recalls Lavinia reading to young Lucius.","id":"shakespeare014.lex.cornelia_mother_of_gracchi.sense","status":"draft"}],"status":"draft","variants":[]},"9913b3f8d3a7951315af779b3febe513245e60d536baace0dae2b867622aaed4":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"korneliya","id":"shakespeare014.lex.cornelia_roman_midwife","ipa":"","label":"cornelia_roman_midwife","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"korneliya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"The midwife who witnesses the birth of Tamora\u2019s son. Distinct from the Roman mother in Titus\u2019s reading analogy.","id":"shakespeare014.lex.cornelia_roman_midwife.sense","status":"draft"}],"status":"draft","variants":[]},"6cce2063837a5ce31099d83514a7d4261625e8478d34e18c7815a6589b9dd7d9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kornelius","id":"shakespeare014.lex.cornelius_envoy_hamlet","ipa":"","label":"cornelius_envoy_hamlet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kornelius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"Danish envoy. Distinct from the physician of the same name in Cymbeline.","id":"shakespeare014.lex.cornelius_envoy_hamlet.sense","status":"draft"}],"status":"draft","variants":[]},"4dd082aafcb8f8eadcc3446e45e73e3614616f24a24d9f9ad349b23256a5c228":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kornelius","i