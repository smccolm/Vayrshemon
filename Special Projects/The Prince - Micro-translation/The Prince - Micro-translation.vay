on","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Unwanted metalworking residue, the low-value hours sold for divine terms in Sonnet 146. The material category is retained without importing a Biblical accusation or verse participants.","id":"shakespeare014.lex.dross_material.sense","status":"draft"}],"status":"draft","variants":[]},"ac65e8cf4fe05cb15e5be8a8e5b6b5e9c5a24b1c768484a6018c3e1b35dda5c9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_drought","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_drought","exampleIds":[],"headword":"mayemsher\u00db","id":"shakespeare014.lex.drought","ipa":"","label":"drought","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mayemshersh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Dryness and lack of water, metaphor for unsatisfied lips rather than a measured weather event.","id":"shakespeare014.lex.drought.sense","status":"draft"}],"status":"draft","variants":[]},"125ec6b600c25c32c6482e4016e9cc0319b6753ac351ab6f577741396a804674":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of medicine","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of medicine","exampleIds":[],"headword":"fadervoren","id":"shakespeare014.lex.drug_preparation","ipa":"","label":"drug_preparation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"fadervoren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An active preparation taken for its bodily effect. Cleopatra means drugs capable of causing death alongside knives and serpents; this later contextual extension of the native medicinal-preparation word does not imply that the preparation is healing or harmless.","id":"shakespeare014.lex.drug_preparation.sense","status":"draft"}],"status":"draft","variants":[]},"cd639071d6331c99a65c99c58c8d6e9c6b8681582c397aa3d50594d077bbb5ca":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_drunkard","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_drunkard","exampleIds":[],"headword":"m\u00ebrvennazifts\u00dflum","id":"shakespeare014.lex.drunkard_person","ipa":"","label":"drunkard_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrvennazifts\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A habitually drunken person in the comparison with excessive melancholy or laughter. Reviewed native drunk-person, without importing the historical accusation context.","id":"shakespeare014.lex.drunkard_person.sense","status":"draft"}],"status":"draft","variants":[]},"ddfdd5618c8f0572314c4648eff8aa7a24795147501bcfd5aac0a23fa2605d46":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of dry","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of dry","exampleIds":[],"headword":"mayems","id":"shakespeare014.lex.dryness_condition","ipa":"","label":"dryness_condition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mayems","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The dry wasting of bones invoked as a consequence of excess, not a new medical diagnosis or advice.","id":"shakespeare014.lex.dryness_condition.sense","status":"draft"}],"status":"draft","variants":[]},"8364ca10c6d43ec200611b22d0ab51a4fe573213e7ef2f9e0636aff9c538337e":{"audioLinks":[],"citations":[{"locator":"Authored native compound: duke + land","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: duke + land","exampleIds":[],"headword":"durvenjo\u00d9","id":"shakespeare014.lex.ducal_territory","ipa":"","label":"ducal_territory","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"durvenjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The Duke\u2019s territorial dominion taken by Frederick, source dukedom. Native duke + land keeps the rank explicit instead of replacing it with a generic principality.","id":"shakespeare014.lex.ducal_territory.sense","status":"draft"}],"status":"draft","variants":[]},"99c9aa8ab18c191788efe68bd596ed710d5d51e00b19085ae17fc693b8124e8c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: gold + coin_currency","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: gold + coin_currency","exampleIds":[],"headword":"azarzarzarven","id":"shakespeare014.lex.ducat_coin","ipa":"","label":"ducat_coin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azarzarzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The named gold coin in Iachimo\u2019s wager. The stake is counted in the source denomination without a modern price conversion.","id":"shakespeare014.lex.ducat_coin.sense","status":"draft"}],"status":"draft","variants":[]},"9f2207b5b6c6f3ebdeb67f4665f4e72e2d24431b0a080ad0997d0a093cf568ec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: duchess","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Authored native derivation or sense: duchess","exampleIds":[],"headword":"durvenzanna","id":"shakespeare014.lex.duchess_gloucester_widow","ipa":"","label":"duchess_gloucester_widow","notes":"","orthographyId":"