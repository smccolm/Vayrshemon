r":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The cardinal south, including the misty south wind in Rosalind\u2019s simile. Not a particular modern country or the named South Sea.","id":"shakespeare014.lex.south_direction.sense","status":"draft"}],"status":"draft","variants":[]},"1665acdf3f27e76ad6f22195385386615a8b4c8f6c4cb075657c97fcf4f865b6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"r\u00dfvmer","id":"shakespeare014.lex.south_sea_place","ipa":"","label":"south_sea_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"r\u014dvmer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The South Sea in Rosalind\u2019s oceanic discovery metaphor, commonly the Pacific. Native historical south plus sea forms the geographical name; not a travel instruction or a newly invented sea.","id":"shakespeare014.lex.south_sea_place.sense","status":"draft"}],"status":"draft","variants":[]},"c13d5c0b5df2924e080903cffc82b05ed3cf1aafc56d03554569d8c62aedd6ed":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"su\u00d5am","id":"shakespeare014.lex.southam_town","ipa":"","label":"southam_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"su\u0167ham","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"Where Somerville left Clarence, distinct from the direction of the drum.","id":"shakespeare014.lex.southam_town.sense","status":"draft"}],"status":"draft","variants":[]},"46194a2f63a95a7edb4fa016686ac9c0863fe2117caae873e3b1b3f4a9629168":{"audioLinks":[],"citations":[{"locator":"Permitted personal/place-name sound approximation.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Permitted personal/place-name sound approximation.","exampleIds":[],"headword":"sa\u00d3ampton","id":"shakespeare014.lex.southampton","ipa":"","label":"southampton","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sathampton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Southampton, the geographic title in the patron\u2019s name.","id":"shakespeare014.lex.southampton.sense","status":"draft"}],"status":"draft","variants":[]},"cdceb3cd79f92a50ba70a57dd756aff5bdc164468d65d0716feaeee3624f5c3c":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"sa\u00d3ampton","id":"shakespeare014.lex.southampton_port","ipa":"","label":"southampton_port","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sathampton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The port at which the king is to embark. The inherited Southampton form also occurs as a patron's territorial title.","id":"shakespeare014.lex.southampton_port.sense","status":"draft"}],"status":"draft","variants":[]},"64813ed3164c8ab1732b5216a0e9ec175b72db859c384fe1a564d0f7b5857c7c":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"suthwark","id":"shakespeare014.lex.southwark_district","ipa":"","label":"southwark_district","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"suthwark","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The district where the messenger first places Cade's rebels.","id":"shakespeare014.lex.southwark_district.sense","status":"draft"}],"status":"draft","variants":[]},"7b8a4d2ae01dad096bcd06c44653980c3af7f2087936be2bebb8a667c7a352a6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"suthwel","id":"shakespeare014.lex.southwell_priest","ipa":"","label":"southwell_priest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"suthwel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The priest who records the spirit's answers. The witness allows either him or Bolingbroke to read the opening formula.","id":"shakespeare014.lex.southwell_priest.sense","status":"draft"}],"status":"draft","variants":[]},"fc7a33e3c04d784a6c449e933941cc7fe30e807c005f6a0185b419bf3868bf0c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of sovereign","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of sovereign","exampleIds":[],"headword":"var\u00dfn","id":"shakespeare014.lex.sovereign_intensity","ipa":"","label":"sovereign_intensity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"var\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Supreme or overpowering in quality, Caesar\u2019s tears likened to the blood of hearts. A recorded figurative extension of native sovereign; not an assertion that the tears are people who rule.","id":"shakespeare014.lex.sovereign_intensity.sense","status":"draft"}],"status":"draft","variants":[]},"4057b17d0b9774376f1bc5e8ab9112bc5350d616df817efc7932a6e4bf39e6b4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_sow","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_sow","exampleIds":[],"headword":"p\u00e1instrasf\u00c5w","id":"shakespeare014.lex.sow_seed","ipa":"","label":"sow_seed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"p\u00f4instrasf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Put seed into soil for a crop, reviewed native sow in the rebellion-as-weed metaphor. Distinct from planting a grown plant and from the following scattering action; no physical planting scene is added.","id":"shakespeare014.lex.sow_seed.sense","status":"draft"}],"status":"draft","variants":[]},"aa7ca7943a1715210895058d1542314b78dedd58226f65909a6862fffeb9235a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"sauter","id":"shakespeare014.lex.sowter_letter_hound","ipa":"","label":"sowter_letter_hound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sauter","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Name Fabian gives the hound following the counterfeit letter's scent.","id":"shakespeare014.lex.sowter_letter_hound.sense","status":"draft"}],"status":"draft","variants":[]},"f956e966f4bfacaad2a75ea3b4f5cce3e6ee9eb7b1ac1241059bbda6136ed766":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_span","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_span","exampleIds":[],"headword":"tremb\u00c5r mem","id":"shakespeare014.lex.span_hand_measure","ipa":"","label":"span_hand_measure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tremb\u0101r mem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A hand-span, the source bodily length image enclosing an entire lifetime. Same native hand + measure as the historical witness, reviewed for later use without importing a fixed metric length.","id":"shakespeare014.lex.span_hand_measure.sense","status":"draft"}],"status":"draft","variants":[]},"01e314457f74f00aff62d649664dc2194500316f11a0c0bd1ac84a0fae162473":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spaniard_guest","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: spaniard_guest","exampleIds":[],"headword":"espans\u00dflum","id":"shakespeare014.lex.spaniard_clothing_style","ipa":"","label":"spaniard_clothing_style","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"espans\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"A person in Spanish dress in Pedro's imagined costume. The native Spanish demonym is shared with the unnamed guest in Cymbeline.","id":"shakespeare014.lex.spaniard_clothing_style.sense","status":"draft"}],"status":"draft","variants":[]},"0d534268acb355b79cc9ce9902a05bfcc4f6bb8337d5403f8a5ed0a8ab671542":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spanish + person","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: spanish + person","exampleIds":[],"headword":"espans\u00dflum","id":"shakespeare014.lex.spaniard_guest","ipa":"","label":"spaniard_guest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"espans\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The Spanish guest who enters with Philario. The source gives him no speech in the wager scene.","id":"shakespeare014.lex.spaniard_guest.sense","status":"draft"}],"status":"draft","variants":[]},"1896011452ff93a00ac0a2e0d6ac93b57cc1b79b29d3d9a143328f6097d8d96c":{"audioLinks":[],"citations":[{"locator":"Authored native compound: little + means","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: little + means","exampleIds":[],"headword":"vimin\u00e5v\u00d1et","id":"shakespeare014.lex.sparing_plain","ipa":"","label":"sparing_plain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"viminouvchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Lean or scant in provision, the spare pastoral life that suits Touchstone\u2019s disposition but not his appetite. Native little + means, not spare as forgive or rescue.","id":"shakespeare014.lex.sparing_plain.sense","status":"draft"}],"status":"draft","variants":[]},"0b77f4b955d35d5259034ec99eb05bab701a167a2d9261988f60a282ccc31b08":{"audioLinks":[],"citations":[{"locator":"Authored native compound: seed + bird","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: seed + bird","exampleIds":[],"headword":"p\u00e1inwil","id":"shakespeare014.lex.sparrow_bird","ipa":"","label":"sparrow_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4inwil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The small seed-eating bird category called sparrow in Adam\u2019s providence allusion. Native seed + bird is a lexicalized category, not a claim that every seed-eating bird is a sparrow; replaces unjustified sparil in this new work only.","id":"shakespeare014.lex.sparrow_bird.sense","status":"draft"}],"status":"draft","variants":[]},"e8ce7043f01fa38d006c28ced094922cdbfa62af09151bd9d2976eb469cc4a44":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: few + space","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: few + space","exampleIds":[],"headword":"vimkinem","id":"shakespeare014.lex.sparse","ipa":"","label":"sparse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"vimkinem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Thinly distributed with intervals, the placement of festival-jewels in Sonnet 52; not an exact density.","id":"shakespeare014.lex.sparse.sense","status":"draft"}],"status":"draft","variants":[]},"a87ddd6a6ee0fabfd65fcb96ba979ccfd7134d0dfd5823c0d83a6b6550adc737":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: horse + joint + swell","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: horse + joint + swell","exampleIds":[],"headword":"thalkl\u00e1r\u00e7l\u00d7onniragum","id":"shakespeare014.lex.spavin_horse","ipa":"","label":"spavin_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalkl\u00f4r\u016bl\u0113onniragum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"A horse's swollen hock in Sands's mock account of the courtiers' gait.","id":"shakespeare014.lex.spavin_horse.sense","status":"draft"}],"status":"draft","variants":[]},"84a80d0e847dbcb60c1d2be78af597b1e7646bf15cecca10e3b92649436aa9b8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_spear","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_spear","exampleIds":[],"headword":"tarven","id":"shakespeare014.lex.spear","ipa":"","label":"spear","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The pointed hunting weapon whose point is compared with the boar\u2019s resistant hide.","id":"shakespeare014.lex.spear.sense","status":"draft"}],"status":"draft","variants":[]},"ea2237ecc01c65e54962a7e8a1a45c0ce49d786b151462714a1fadf71ebae906":{"audioLinks":[],"citations":[{"locator":"Authored native compound: sight + glass","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: sight + glass","exampleIds":[],"headword":"o\u00c3sh\u00eblen","id":"shakespeare014.lex.spectacles_sight","ipa":"","label":"spectacles_sight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ojzhsh\u00fclen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Eyeglasses aiding sight, native sight + glass as a lexicalized implement. One noun denotes the apparatus; no unsupported extra numerical count of lenses is inserted.","id":"shakespeare014.lex.spectacles_sight.sense","status":"draft"}],"status":"draft","variants":[]},"7a086270d3a7ed3ad400c9997d12aee4d6bbfe48d206c559d0cd781c2d2ff29c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: speed","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Authored native derivation or sense: speed","exampleIds":[],"headword":"s\u00dfrn","id":"shakespeare014.lex.speed_valentine_servant","ipa":"","label":"speed_valentine_servant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"s\u014drn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"definition":"Valentine's quick-witted servant. His name is rendered by the native word for speed.","id":"shakespeare014.lex.speed_valentine_servant.sense","status":"draft"}],"status":"draft","variants":[]},"9d64804761698625f914a5b2113cf8587620ab46aac265459e733adaea7f7058":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: whale + wax","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sense: whale + wax","exampleIds":[],"headword":"gorenmer\u00d5\u00dfrvormelsakor","id":"shakespeare014.lex.spermaceti_wax","ipa":"","label":"spermaceti_wax","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gorenmer\u0167h\u014drvormelsakor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Parmacety, the waxlike substance from the sperm whale, mentioned by the visitor as a remedy for an internal bruise.","id":"shakespeare014.lex.spermaceti_wax.sense","status":"draft"}],"status":"draft","variants":[]},"0a77f86fb3832855a4a286e71dc460b16b65d88884edfed1a73c1fd738600c68":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"sfinks","id":"shakespeare014.lex.sphinx_riddle_figure","ipa":"","label":"sphinx_riddle_figure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"sfinks","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The riddle-giving creature in Berowne's comparison with love's subtlety.","id":"shakespeare014.lex.sphinx_riddle_figure.sense","status":"draft"}],"status":"draft","variants":[]},"4ebe7e9b6f46eabc4c6e1ff857f144d0c6488f321804287ef1b5e3771793d52d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wood + stop","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: wood + stop","exampleIds":[],"headword":"y\u00eblg\u00e7z\u00e9l","id":"shakespeare014.lex.spigot_cask_plug","ipa":"","label":"spigot_cask_plug","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"y\u00fclg\u016bz\u00e9l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The wooden plug for drawing a drink from a cask. Pistol mocks Bardolph for agreeing to handle it.","id":"shakespeare014.lex.spigot_cask_plug.sense","status":"draft"}],"status":"draft","variants":[]},"8efdcd5620f442f21bc94cc89ef17dd4186da3d30efd8033b27b3ef9d3ea2283":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_spin_thread","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_spin_thread","exampleIds":[],"headword":"thirila\u00d9","id":"shakespeare014.lex.spin_thread","ipa":"","label":"spin_thread","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thirilang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Make thread from fibres; the domestic work in the Argument, not weaving finished cloth.","id":"shakespeare014.lex.spin_thread.sense","status":"draft"}],"status":"draft","variants":[]},"775ba4ceaa152ef70c752ebcaa762f700a2a78ddf9c428206a03ea2ec7201b90":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: thread + make","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: thread + make","exampleIds":[],"headword":"thirila\u00d9","id":"shakespeare014.lex.spin_yarn","ipa":"","label":"spin_yarn","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thirilang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Make thread by spinning fibres, Penelope\u2019s yarn, distinct from turning the body in a circle.","id":"shakespeare014.lex.spin_yarn.sense","status":"draft"}],"status":"draft","variants":[]},"bb95929b3ada18859a0fe86e3bf97cba673242e94265d7adcc066bba95e239e9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: turn + play","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: turn + play","exampleIds":[],"headword":"elyi\u00d1faln","id":"shakespeare014.lex.spinning_top","ipa":"","label":"spinning_top","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elyichfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A spinning toy set moving by the fingers in the servant\u2019s comparison. Native turn-play; not the highest point or a ranking.","id":"shakespeare014.lex.spinning_top.sense","status":"draft"}],"status":"draft","variants":[]},"5f3e03dd061c650402a0f8704b83e1d7b95c7c13b0fd80db883e839e4443289f":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of vitality","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of vitality","exampleIds":[],"headword":"\u00d5\u00dfrjw\u00ebnenplesten","id":"shakespeare014.lex.spirits_vigour","ipa":"","label":"spirits_vigour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u0167h\u014drjw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The bodily and mental animation exhausted by travel in Rosalind and Touchstone\u2019s exchange. Contextual vitality, conventionally plural in this contrast; not multiple ghosts or a count of souls.","id":"shakespeare014.lex.spirits_vigour.sense","status":"draft"}],"status":"draft","variants":[]},"ebfb11475155eb077fa8391a076af103404675a14261967ba7f5500cc3900875":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_spit","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_spit","exampleIds":[],"headword":"tomtarn","id":"shakespeare014.lex.spit_saliva","ipa":"","label":"spit_saliva","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tomtarn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Expel saliva from the mouth, the scornful gesture in Rosalind\u2019s claimed treatment. Reviewed native mouth-expel form; no speech or vomiting substituted.","id":"shakespeare014.lex.spit_saliva.sense","status":"draft"}],"status":"draft","variants":[]},"28ced8cc95c2b62bb4f8c5ed929b815b1e508147ff30df6c8ca4348ae06da288":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of capricious_temper","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of capricious_temper","exampleIds":[],"headword":"\u00e3lum\u00c9lm","id":"shakespeare014.lex.spleen_caprice","ipa":"","label":"spleen_caprice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"oilum\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Capricious or impulsive temper in Cupid\u2019s mock conception, nominal native change-will. The bodily-humour image is recorded; it does not assert a surgical organ or prescribe a theory of medicine.","id":"shakespeare014.lex.spleen_caprice.sense","status":"draft"}],"status":"draft","variants":[]},"c214abc205293cff5e27fbbd49248915f1f9097f72d85de5e0938a1214d8dad5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: fury","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: fury","exampleIds":[],"headword":"etyeks","id":"shakespeare014.lex.spleen_fury","ipa":"","label":"spleen_fury","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"etyeks","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Furious anger in Coriolanus\u2019s promise to fight with infernal spite. Explicit nominal native fury; preserves the emotional force while documenting the loss of the source bodily-humour image.","id":"shakespeare014.lex.spleen_fury.sense","status":"draft"}],"status":"draft","variants":[]},"1a0b07507493db2440cf681af4979a52143a0cfbc2501407caca709f9a6dde2a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: belly + laughter","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: belly + laughter","exampleIds":[],"headword":"bavilhaha","id":"shakespeare014.lex.spleen_laughter_organ","ipa":"","label":"spleen_laughter_organ","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"bavilhaha","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The bodily seat of laughter that Armado says Costard's thought stirs. It receives a distinct native term from spleen as anger or caprice.","id":"shakespeare014.lex.spleen_laughter_organ.sense","status":"draft"}],"status":"draft","variants":[]},"606ffa24f61cb0defd05e1fb85ddb897da80ff16ebf20ea5ff154db4e668a91e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of bright","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of bright","exampleIds":[],"headword":"b\u00e7orna","id":"shakespeare014.lex.splendour","ipa":"","label":"splendour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u016borna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Radiant brightness, the sun\u2019s gold-like splendour; nominal colour/light use.","id":"shakespeare014.lex.splendour.sense","status":"draft"}],"status":"draft","variants":[]},"59ca089086c587a02f0ef4ac54d39ae6d8fcd4582a19acdfcc7146e3f9a299dd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: plunder","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: plunder","exampleIds":[],"headword":"hefakgur\u00e7zt","id":"shakespeare014.lex.spoil_goods","ipa":"","label":"spoil_goods","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgur\u016bzt","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Goods seized in warfare, the Romans carrying spoils from Corioles; nominal use of native plunder, not damaged food.","id":"shakespeare014.lex.spoil_goods.sense","status":"draft"}],"status":"draft","variants":[]},"a2c1bffad1bdf9ca71f19d34002394d7a007e139ddabb528f5900914d90275db":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_spoon","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_spoon","exampleIds":[],"headword":"bore\u00d3il","id":"shakespeare014.lex.spoon_utensil","ipa":"","label":"spoon_utensil","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"borethil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The eating/serving utensil in Martius\u2019s contemptuous inventory, here made of lead. Reviewed historical native category without a liturgical function.","id":"shakespeare014.lex.spoon_utensil.sense","status":"draft"}],"status":"draft","variants":[]},"b32a983a352b998ab648635c7e932630997927a05e2e26fac629eddbcce10afb":{"audioLinks":[],"citations":[{"locator":"Authored native compound: spot + cat","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: spot + cat","exampleIds":[],"headword":"pirilmiyal","id":"shakespeare014.lex.spotted_cat_native","ipa":"","label":"spotted_cat_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pirilmiyal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The large spotted wild-cat category called pard in the source. Native spot + cat, lexicalized rather than denoting any marked domestic cat; no new species or invented beard anatomy asserted.","id":"shakespeare014.lex.spotted_cat_native.sense","status":"draft"}],"status":"draft","variants":[]},"2c250c7e74ab75278a82e8a0b8705352c8894448952e8de2d683118aa05f5cde":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from sprout, season","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from sprout, season","exampleIds":[],"headword":"verzetnevf\u00ebr","id":"shakespeare014.lex.spring_season","ipa":"","label":"spring_season","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"verzetnevf\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The growing season of spring in the annually renewed beauty comparison; not a water-source.","id":"shakespeare014.lex.spring_season.sense","status":"draft"}],"status":"draft","variants":[]},"9e3a90538c9458ad0ee5e0e692581d611b72084dccac52cf191b5cff81c53de5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: horse + leg + jerk","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: horse + leg + jerk","exampleIds":[],"headword":"thalpalmaven\u00e1lw\u00c5vumenda\u00c3","id":"shakespeare014.lex.springhalt_horse","ipa":"","label":"springhalt_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalpalmaven\u00f4lw\u0101vumendajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"A jerking gait of a horse's hind legs, applied mockingly to French-influenced gentlemen.","id":"shakespeare014.lex.springhalt_horse.sense","status":"draft"}],"status":"draft","variants":[]},"d883bc3fc0530d3683ec6d77f6276b6bcaae4a0c92a2e276cd2d0521ed30eab9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of sprout","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of sprout","exampleIds":[],"headword":"verzetnev","id":"shakespeare014.lex.sprout_grow","ipa":"","label":"sprout_grow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"root","pronunciation":"verzetnev","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Grow forth as a shoot; the source seeds spring from seeds, not the spring water source.","id":"shakespeare014.lex.sprout_grow.sense","status":"draft"}],"status":"draft","variants":[]},"b8e5a29946dfa0b68573d15b7e81f0b88a644171d5f106d98a0166ca928f0a61":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of spur","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of spur","exampleIds":[],"headword":"kerin","id":"shakespeare014.lex.spur_horse","ipa":"","label":"spur_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"kerin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Urge a horse with the rider\u2019s spur. Reviewed noun-to-action conversion, preserving the source one-sided riding error without an unstated race or military charge.","id":"shakespeare014.lex.spur_horse.sense","status":"draft"}],"status":"draft","variants":[]},"f3de63eae0f2eaca1389c224a419d72292ecad5b57fde34371b2410ae4476696":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: soldier + part","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: soldier + part","exampleIds":[],"headword":"hefak gurs\u00dflumthrenin","id":"shakespeare014.lex.squadron_detachment","ipa":"","label":"squadron_detachment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlumthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A body or subdivision of soldiers in the proposed hill position; not an aircraft unit or an invented fixed troop count.","id":"shakespeare014.lex.squadron_detachment.sense","status":"draft"}],"status":"draft","variants":[]},"9df4e698f6635e5ee14917bc11c699029252d0451d1286c34fb8d9a9bc525637":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: measure + straight","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: measure + straight","exampleIds":[],"headword":"memjemin","id":"shakespeare014.lex.square_measure","ipa":"","label":"square_measure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memjemin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An angled measuring square used figuratively for correct conduct, paired with the measuring rule. Not a quarrel, a plaza, an arithmetic power, or an inserted numerical angle.","id":"shakespeare014.lex.square_measure.sense","status":"draft"}],"status":"draft","variants":[]},"427da5d8c1e89302ed41ba7e3ecf975e6a86c2d90793c739c6d7883cfe827e18":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"skw\u00ddl","id":"shakespeare014.lex.squele_companion","ipa":"","label":"squele_companion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"skw\u012bl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Surname of Shallow's companion from the Cotswolds.","id":"shakespeare014.lex.squele_companion.sense","status":"draft"}],"status":"draft","variants":[]},"b1b5639bcc1e179ed4d353cbe98af3188c47a2239fd269dab307ae81fc897f12":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"staford","id":"shakespeare014.lex.stafford_buckingham_son","ipa":"","label":"stafford_buckingham_son","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"staford","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"Buckingham's son. York reports him killed at the front of the battle.","id":"shakespeare014.lex.stafford_buckingham_son.sense","status":"draft"}],"status":"draft","variants":[]},"9412522962a56bb8976b3ce5a2ce6c3de966d16f50381f5a4f3deac8a2d847d7":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.he