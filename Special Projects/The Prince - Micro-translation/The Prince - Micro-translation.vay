lex.aspect_gaze.sense","status":"draft"}],"status":"draft","variants":[]},"9240205295bc6bc5d7096ac4d6566f8ffc50c2767130c5f93c1db14393a35e6f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: tremble + tree","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: tremble + tree","exampleIds":[],"headword":"zively\u00eblverzet","id":"shakespeare014.lex.aspen_tree","ipa":"","label":"aspen_tree","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zively\u00fclverzet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The tree whose trembling leaf Quickly likens to her own shaking.","id":"shakespeare014.lex.aspen_tree.sense","status":"draft"}],"status":"draft","variants":[]},"24db819c3b461e65e2f043698d336310c39868763a6846ca07f3fdf00de54622":{"audioLinks":[],"citations":[{"locator":"A deliberate alteration of a native word in Dogberry's report to Leonato.","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"A deliberate alteration of a native word in Dogberry's report to Leonato.","exampleIds":[],"headword":"farvesw\u00c5vum","id":"shakespeare014.lex.aspicious_dogberry_error","ipa":"","label":"aspicious_dogberry_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farvesw\u0101vum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Dogberry's malformed aspicious. The intended native expression is lamvesw\u0101vum.","id":"shakespeare014.lex.aspicious_dogberry_error.sense","status":"draft"}],"status":"draft","variants":[]},"37db31928e4480ef67f8dcf90805a447c9f42d94e556ba11d5f795f5bd213c2f":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of company","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed c