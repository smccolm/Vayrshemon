id":"shakespeare014.lex.sunset","ipa":"","label":"sunset","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u016borgorvelgaktriv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The sun\u2019s apparent setting, native sun-sink; no claim that the celestial body physically submerges in water.","id":"shakespeare014.lex.sunset.sense","status":"draft"}],"status":"draft","variants":[]},"35ef5ac7fbec233a407ca690da0b8c92d57c1c3eea9ae4385aa2c17cebef3f2c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of proud","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of proud","exampleIds":[],"headword":"nasevar","id":"shakespeare014.lex.superbus_epithet","ipa":"","label":"superbus_epithet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"nasevar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The meaning-bearing cognomen Superbus, rendered natively as Proud. The source explains it by excessive pride; no ordinary Latin word is disguised as a permitted loan.","id":"shakespeare014.lex.superbus_epithet.sense","status":"draft"}],"status":"draft","variants":[]},"2da483ae5dc41167cb004a8c531d90d597ca43fdd68fa447e718b420ad09c44e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dream + fear","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: dream + fear","exampleIds":[],"headword":"se\u00dbo\u00c3l\u00dfnmar","id":"shakespeare014.lex.superstitious_dream_observance","ipa":"","label":"superstitious_dream_observance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"seshojzhl\u014dnmar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The fearful reverence that leads Antigonus to obey a dream despite calling dreams trifles. Distinct from Festus's description of a religious dispute.","id":"shakespeare014.lex.superstitious_dream_observance.sense","status":"draft"}],"status":"draft","variants":[]},"d8c6487eab605dd8de7fe97e6f8a2b518af32460c3dc64dccb214afb523f5f05":{"audioLinks":[],"citations":[{"locator":"Authored native compound: evening + food","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: evening + food","exampleIds":[],"headword":"venm\u00ebrd\u00cdn\u00d7r","id":"shakespeare014.lex.supper_evening","ipa":"","label":"supper_evening","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"venm\u00fcrd\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Evening meal, native evening + food. Replaces the unsupported ordinary sound-copy supen in this new work only; no earlier edition is rewritten.","id":"shakespeare014.lex.supper_evening.sense","status":"draft"}],"status":"draft","variants":[]},"c4f51d55c9973c868810613616f35fd4947b9a9b042e61611ee1d13955d20ed9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: bend","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: bend","exampleIds":[],"headword":"lunor","id":"shakespeare014.lex.supple_compliant","ipa":"","label":"supple_compliant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"lunor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Ready to bend to the people\u2019s will, the second officer\u2019s contrast with unbending martial service; metaphorical compliance, not a claim about joints.","id":"shakespeare014.lex.supple_compliant.sense","status":"draft"}],"status":"draft","variants":[]},"2a348c0f90b8e5130c1b13bb022c4d21bb110f865e72d05f5a75b12da5b40b86":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: food + give","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: food + give","exampleIds":[],"headword":"d\u00cdn\u00d7rf\u00c5w","id":"shakespeare014.lex.supply_food","ipa":"","label":"supply_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"d\u0117rn\u0113rf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Provision with food for a journey, Jaques\u2019s metaphor for a short-lived marriage.","id":"shakespeare014.lex.supply_food.sense","status":"draft"}],"status":"draft","variants":[]},"5e967ecb31223646718728f410601932d37959c3108b68b25a9c780ea3bee809":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from support, wood","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from support, wood","exampleIds":[],"headword":"halemin\u00d7y\u00ebl","id":"shakespeare014.lex.support_pillar","ipa":"","label":"support_pillar","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"halemin\u0113y\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A supporting prop/pillar, metaphorically the patron; no added claim that the patron is literally wooden.","id":"shakespeare014.lex.support_pillar.sense","status":"draft"}],"status":"draft","variants":[]},"ff7a70e3b0af74d647d7c1a861da14ac999d44d05dc496cf6558471968e61903":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: excess + eat","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: excess + eat","exampleIds":[],"headword":"gimerenwem","id":"shakespeare014.lex.surfeit_eat","ipa":"","label":"surfeit_eat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gimerenwem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Eat to excess, the citizens\u2019 charge against those in authority. Not a count or a claim that all wealthy people literally ate the scene\u2019s grain.","id":"shakespeare014.lex.surfeit_eat.sense","status":"draft"}],"status":"draft","variants":[]},"6de9cc05945d00fe03d6cf399589d1f2049125683502cf8378a70bf325ca5f16":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_surname","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_surname","exampleIds":[],"headword":"deny\u00cd\u00d7f\u00c5w","id":"shakespeare014.lex.surname_add","ipa":"","label":"surname_add","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"deny\u0117r\u0113f\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Receive or add a further identifying name, source so surnamed Censorinus. Reviewed native name-add; not an assertion of a modern inherited surname convention.","id":"shakespeare014.lex.surname_add.sense","status":"draft"}],"status":"draft","variants":[]},"aa5e8fed4b5672348f136a3053ea08651edbfdfc076a7af95455f0604eb5a213":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: excess","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: excess","exampleIds":[],"headword":"gimeren","id":"shakespeare014.lex.surplus_goods","ipa":"","label":"surplus_goods","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gimeren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Material supplies beyond need, specifically the rulers\u2019 alleged surplus food; no fixed numerical amount.","id":"shakespeare014.lex.surplus_goods.sense","status":"draft"}],"status":"draft","variants":[]},"c15e2eb902f7c8b0dc14e77fedeea647f060af5f8ec3defe6fbacce19879a19a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"suri","id":"shakespeare014.lex.surrey_bosworth_earl","ipa":"","label":"surrey_bosworth_earl","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"suri","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"Norfolk's son at Bosworth. Distinct from the earlier and later characters bearing the same earldom.","id":"shakespeare014.lex.surrey_bosworth_earl.sense","status":"draft"}],"status":"draft","variants":[]},"a2934e82283bef83df6f71425a4fc307eb0433e6d85c4fbc5cde47f893d16c2d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"suri","id":"shakespeare014.lex.surrey_earl","ipa":"","label":"surrey_earl","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"suri","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The earl summoned with Warwick to attend King Henry at night.","id":"shakespeare014.lex.surrey_earl.sense","status":"draft"}],"status":"draft","variants":[]},"3095d366328e1fc10ac6612f566e175945d5053bdd26f92afc19a8097076dd7c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author