7h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Name attached to Prince Harry in Hotspur's challenge. The prince is the same Harry of Wales.","id":"shakespeare014.lex.monmouth_prince_title.sense","status":"draft"}],"status":"draft","variants":[]},"727fc5485d8e27e63c781ba51fd2034b9546dcb3e94cf8cd4e31f3818c18d667":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"monme\u00d5","id":"shakespeare014.lex.monmouth_town","ipa":"","label":"monmouth_town","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"monme\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The town of Henry's birth in Fluellen's comparison of Monmouth and Macedon. Uses the established Monmouth form.","id":"shakespeare014.lex.monmouth_town.sense","status":"draft"}],"status":"draft","variants":[]},"374f8fe58da06686d71f88edfc7563e410e19a309ccb803ddd1e73eb4007f391":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: monster + make","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: monster + make","exampleIds":[],"headword":"mar \u00cddema\u00d5\u00dfrnaa\u00d9","id":"shakespeare014.lex.monster_exaggerate","ipa":"","label":"monster_exaggerate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"mar \u0117rdema\u0167h\u014drnaang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Enlarge small deeds into prodigious things in praise, Coriolanus\u2019s my nothings monstered. Native monster-make preserves the image; no literal creatures appear.","id":"shakespeare014.lex.monster_exaggerate.sense","status":"draft"}],"status":"draft","variants":[]},"f6efdb64214573a6bd607ec45ef60edfff97cb9622b51f8a28edb899debd922f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"montagyu","id":"shakespeare014.lex.montague_verona_house","ipa":"","label":"montague_verona_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"montagyu","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"Romeo's father and his family name. Distinct from the Yorkist lord.","id":"shakespeare014.lex.montague_verona_house.sense","status":"draft"}],"status":"draft","variants":[]},"de4b2c5474f5705c1b7546c57e0f06aa15c44cc56ce15a5b46502ad55cc34223":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"montagyu","id":"shakespeare014.lex.montague_york_ally","ipa":"","label":"montague_york_ally","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"montagyu","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The ally who shows his sword to York and calls him brother. This preserves his spoken address without supplying a family relationship.","id":"shakespeare014.lex.montague_york_ally.sense","status":"draft"}],"status":"draft","variants":[]},"7d7f0a8b78dacb6ee8294ace7757405f8e1b10e9d2faa27158a551df07e2ff81":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Author-permitted phonetic p