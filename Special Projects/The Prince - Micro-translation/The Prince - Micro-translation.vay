e","status":"draft"}],"status":"draft","variants":[]},"7930e13136123a23ce994be0c4cdb8cb6cbd43221c759b6aa001fc14d5782b4f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sin + simplicity","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: sin + simplicity","exampleIds":[],"headword":"prodmurlametvenek","id":"shakespeare014.lex.sinplicity_costard","ipa":"","label":"sinplicity_costard","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodmurlametvenek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Costard slips sin into simplicity as he speaks of listening after flesh.","id":"shakespeare014.lex.sinplicity_costard.sense","status":"draft"}],"status":"draft","variants":[]},"cbf89c59802f04e977f197a79ac3256e5296ab61570b442e896021d89bb3030c":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: charm + sing","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: charm + sing","exampleIds":[],"headword":"f\u00eblmirlils\u00dflum","id":"shakespeare014.lex.siren_creature","ipa":"","label":"siren_creature","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u00fclmirlils\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A dangerously enchanting song-creature in Sonnet 119, native charm-sing agent. The tears are metaphorical seduction; no mermaid anatomy or named individual is supplied.","id":"shakespeare014.lex.siren_creature.sense","status":"draft"}],"status":"draft","variants":[]},"f1412988aaf13c6178ec06dcf9a48d8c1563afd58c8b2d0045504a9714e3ce8f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: seat + flesh","sourceId":"shakespeare014.sourc