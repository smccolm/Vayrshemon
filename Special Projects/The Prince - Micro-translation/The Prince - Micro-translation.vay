phyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"venjar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Stir another toward action or wrongdoing; native impulse/movement family, not merely offer a neutral suggestion.","id":"shakespeare014.lex.incite.sense","status":"draft"}],"status":"draft","variants":[]},"fcb5814f23de25d35a5a2a2819dfa603374db86481c1286b235dcbb4c9bf7f08":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of yield","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of yield","exampleIds":[],"headword":"f\u00c5wmarjo\u00d9","id":"shakespeare014.lex.income_return","ipa":"","label":"income_return","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u0101wmarjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Income or return from a holding, metaphorically the revenues of other beds in Sonnet 142; no tax or particular amount is introduced.","id":"shakespeare014.lex.income_return.sense","status":"draft"}],"status":"draft","variants":[]},"89000c15e7db3b0326563b0b9bdd7bc79c7bb51616ca17eb5b53c763ab394e84":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of mistaken","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of mistaken","exampleIds":[],"headword":"murlameth\u00c5b\u00cdpomna","id":"shakespeare014.lex.incorrect_fastening","ipa":"","label":"incorrect_fastening","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"murlameth\u0101b\u0117rpomna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Mistaken arrangement of the armour fastenings, Antony\u2019s false, false correction; n