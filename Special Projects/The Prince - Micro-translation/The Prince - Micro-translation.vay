/dance extension of native measure retains the later measures/measure echo.","id":"shakespeare014.lex.measure_dance.sense","status":"draft"}],"status":"draft","variants":[]},"36a2c29b0f89644123064e74c85416c66dfce9a28db4d7a22d32d4e20bb04be5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: neck + image","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: neck + image","exampleIds":[],"headword":"harenkl\u00e1rl\u00dfnil","id":"shakespeare014.lex.medal_neck_piece","ipa":"","label":"medal_neck_piece","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harenkl\u00f4rl\u014dnil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The medal hung at the neck in Leontes's claim that Polixenes wears Hermione like her medal.","id":"shakespeare014.lex.medal_neck_piece.sense","status":"draft"}],"status":"draft","variants":[]},"e30b591b94bde894dd7e624d6be2175f9da6af5ea0ee3ecd8bee914e2b439de9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: meddle","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: meddle","exampleIds":[],"headword":"etnifalnthren","id":"shakespeare014.lex.meddle_contact","ipa":"","label":"meddle_contact","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"etnifalnthren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Interfere with or concern oneself with a person, with sexual involvement evoked by the answering mistress clause. Explicit contextual extension of native interfere; preserves the repeated verb without asserting that an affair actually happened.","id":"shakespeare014.lex.meddle_contact.sense","status":"draft"}],"status":"draft","variants":[]},"3415d16a23a123fb49bdb60be1e72bc98158