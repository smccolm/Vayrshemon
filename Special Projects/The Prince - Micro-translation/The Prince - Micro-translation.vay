1"}],"definition":"Dim transitional light, specifically after sunset in Sonnet 73; the time is fixed by the clause, not by a new astronomical measurement.","id":"shakespeare014.lex.twilight.sense","status":"draft"}],"status":"draft","variants":[]},"e4325bfb22bd014e45dc5374c5e373c9fdf4802f4d0c1d661df03bc1e586719b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_twine","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_twine","exampleIds":[],"headword":"tarenthiril","id":"shakespeare014.lex.twine","ipa":"","label":"twine","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"tarenthiril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Twist or wind together, figuratively the entwining arms.","id":"shakespeare014.lex.twine.sense","status":"draft"}],"status":"draft","variants":[]},"22ac8f92c8ee94785b7e55b52087cf94eb0584f4bf7d2d2c5e94c47d359f35de":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: small + flash","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: small + flash","exampleIds":[],"headword":"vimins\u00dfrnb\u00d7\u00c7r","id":"shakespeare014.lex.twinkle","ipa":"","label":"twinkle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vimins\u014drnb\u0113\u00e3r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Shine with small intermittent flashes, here the star-handmaids of the moon.","id":"shakespeare014.lex.twinkle.sense","status":"draft"}],"status":"draft","variants":[]},"4e9e1f1d52d6ff7d37dae245d65c7f827662055b2c5c5d11c057443c40a95fa7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_twin","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymolog