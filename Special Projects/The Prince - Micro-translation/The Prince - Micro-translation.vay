.lex.dick_drawer.sense","status":"draft"}],"status":"draft","variants":[]},"575faf16df20d8814803088820f94398a4fb547af195a1455eaf72eca988a365":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dik","id":"shakespeare014.lex.dick_gloucester_brother","ipa":"","label":"dick_gloucester_brother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The captive prince's familiar form for Richard of Gloucester in his defiance of the brothers.","id":"shakespeare014.lex.dick_gloucester_brother.sense","status":"draft"}],"status":"draft","variants":[]},"065baf88abb20dbec2d7338f914ed895f1ac34cd011d47ab943b59de956ce26e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dik","id":"shakespeare014.lex.dick_illyrian_surgeon","ipa":"","label":"dick_illyrian_surgeon","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Surgeon Toby asks for after the fight.","id":"shakespeare014.lex.dick_illyrian_surgeon.sense","status":"draft"}],"status":"draft","variants":[]},"f65afef2191c391844f587ee3f051a68cb34247c3e77c02e192b628586b81aec":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dik","id":"shakespeare014