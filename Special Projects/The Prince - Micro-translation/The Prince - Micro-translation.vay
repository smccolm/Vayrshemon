","pronunciation":"chir\u00fcnmurlamvut","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"An ecclesiastical indulgence which Gloucester alleges the bishop gives to sex workers as permission to sin.","id":"shakespeare014.lex.church_indulgence.sense","status":"draft"}],"status":"draft","variants":[]},"41bfe6092e4e822ccff1839922181a70fc229c593630eff95b3c883c9ac74f46":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sacred + meal + rite","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: sacred + meal + rite","exampleIds":[],"headword":"prodna klojvord\u00cdn\u00d7r prodnavenar","id":"shakespeare014.lex.church_mass","ipa":"","label":"church_mass","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodna klojvord\u0117rn\u0113r prodnavenar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The Christian service in Polonius's oath. His use of Mass is an exclamation and no service takes place on stage.","id":"shakespeare014.lex.church_mass.sense","status":"draft"}],"status":"draft","variants":[]},"5fe08a7a4b2fe5a63c12d50170d470d3dbf8f29449f5aef410865791a6db16e2":{"audioLinks":[],"citations":[{"locator":"Authored native formation; motivation in definition, not claimed historical attestation.","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native formation; motivation in definition, not claimed historical attestation.","exampleIds":[],"headword":"krathlen","id":"shakespeare014.lex.churl_native","ipa":"","label":"churl_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"krathlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"An ungenerous, rough-mannered pe