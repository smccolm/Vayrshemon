"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"An infant\u2019s wrapping cloth. It identifies the younger stolen child as still in infancy without giving an exact age.","id":"shakespeare014.lex.swaddling_cloth.sense","status":"draft"}],"status":"draft","variants":[]},"6e845ac09ff9711e04b98f93255ff5b6182f8c6ec9e62e2fbb119010009d7895":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_swallow","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_swallow","exampleIds":[],"headword":"niwem","id":"shakespeare014.lex.swallow","ipa":"","label":"swallow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"niwem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Take through the mouth, figuratively the dimples consuming Venus\u2019s desire.","id":"shakespeare014.lex.swallow.sense","status":"draft"}],"status":"draft","variants":[]},"e35f8abc7874b7dc73548b094bfd0455a979f72b6631bc31aff58ef5707830f9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_swallow_bird","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_swallow_bird","exampleIds":[],"headword":"wil\u00c3il","id":"shakespeare014.lex.swallow_nesting_bird","ipa":"","label":"swallow_nesting_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wiljzhil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The nesting bird in Cleopatra\u2019s sails, distinct from the verb take into the mouth. The omen remains the characters\u2019 report, with no imposed modern species.","id":"shakespeare014.lex.swallow_nesting_bird.sense","status":"draft"}],"status":"draft","variants":[]},"890fbbbd686fbba89317630ef658dc625688ea45877442a1cbc31946b5ecb1fb":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Explicit literary promotion of kjv_swan; same native form, reviewed meaning, older entry untouched.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Explicit literary promotion of kjv_swan; same native form, reviewed meaning, older entry untouched.","exampleIds":[],"headword":"wilv\u00ebn","id":"shakespeare014.lex.swan","ipa":"","label":"swan","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wilv\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"The poem\u2019s white swan and death-song image. Literary bird identity is explicit here; no claim resolves the old Biblical zoological uncertainty.","id":"shakespeare014.lex.swan.sense","status":"draft"}],"status":"draft","variants":[]},"cafa9af6261feac0bbeffc6174507d1e9dc3f3bd622b2bea2287c30ab73a493e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sweat + sickness","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: sweat + sickness","exampleIds":[],"headword":"savilmuren","id":"shakespeare014.lex.sweat_epidemic","ipa":"","label":"sweat_epidemic","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"savilmuren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The sweating sickness in the bawd's list of things that have cost her customers.","id":"shakespeare014.lex.sweat_epidemic.sense","status":"draft"}],"status":"draft","variants":[]},"2f13ddc8c74ec7036b3870a39f24a068c0a194ecd42f524c3a3dca4451ee520c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sweet + heart","sourceId":"shakespeare014.sou