se","status":"draft"}],"status":"draft","variants":[]},"67b363083355e91795f082bd60b1d6c7888c8ec3d9d8fef291773477c6db2545":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: chance + token","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: chance + token","exampleIds":[],"headword":"vengrafden","id":"shakespeare014.lex.lot_token","ipa":"","label":"lot_token","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vengrafden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A token drawn to decide by chance. Distinct from a landed allotment, the personal name Lot, and an unspecified large amount.","id":"shakespeare014.lex.lot_token.sense","status":"draft"}],"status":"draft","variants":[]},"17bcd408256e41e8e3e36c1644ef223b382bd63b64bf6a36eecedd23d9b68141":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"lui","id":"shakespeare014.lex.louis_john_dauphin","ipa":"","label":"louis_john_dauphin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"lui","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Philip of France's son and heir who speaks for Arthur before Angiers. Distinct from the Dauphins in other plays.","id":"shakespeare014.lex.louis_john_dauphin.sense","status":"draft"}],"status":"draft","variants":[]},"ac8d2eb68ce887ed103e159439f7c08885987a892aab5c8708d3bb8795db0ea4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: rude + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: rude + person","exampleIds":[],"headword":