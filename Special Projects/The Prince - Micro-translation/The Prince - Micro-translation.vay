ng stand to which the conspirators direct Brutus and from which Antony will address the plebeians in the Forum.","id":"shakespeare014.lex.forum_speaking_platform.sense","status":"draft"}],"status":"draft","variants":[]},"784e26f3c69e203040ffa9795a3150b0a70c6754cd1d20bf5f57fe1a444ca20c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_foundation","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_foundation","exampleIds":[],"headword":"jo\u00d9halemin\u00d7","id":"shakespeare014.lex.foundation","ipa":"","label":"foundation","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jonghalemin\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The supporting base of earth in the underground-wind simile; not a new account of physical geology.","id":"shakespeare014.lex.foundation.sense","status":"draft"}],"status":"draft","variants":[]},"c683e0d741e705721c5387e8191cb01d6974a9fc889fb00afc6f007cec64ffed":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of foundation","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of foundation","exampleIds":[],"headword":"jo\u00d9halemin\u00d7","id":"shakespeare014.lex.foundation_base","ipa":"","label":"foundation_base","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jonghalemin\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A supporting base for a grand construction imagined to endure in Sonnet 125; carries the native foundation form without importing Lucrece\u2019s underground-wind account.","id":"shakespeare014.lex.foundation_base.sense","status":"draft"}],"status":"draft","variants":[]},"fbfb4fe5c2e9b4dea4c9d55760d051b90dcb5355dbcdf9cc4f1e7905c2e7106