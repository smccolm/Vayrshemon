"draft"}],"status":"draft","variants":[]},"449241a69580e82a9cf66b3a0677fe255be0b5e8a767a2433e3765e11022248f":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from leg, kjv_joint","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from leg, kjv_joint","exampleIds":[],"headword":"palkl\u00e1r\u00e7l\u00d7on","id":"shakespeare014.lex.fetlock","ipa":"","label":"fetlock","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"palkl\u00f4r\u016bl\u0113on","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The low equine joint and its adjacent tufted hair in the source description, not the entire leg or human ankle.","id":"shakespeare014.lex.fetlock.sense","status":"draft"}],"status":"draft","variants":[]},"f7a2fca178a5bd40d81c1649499e78ca7290ef5048f05b1ff1f95968435acc7c":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Explicit literary promotion of kjv_fever; same native form, reviewed meaning, older entry untouched.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Explicit literary promotion of kjv_fever; same native form, reviewed meaning, older entry untouched.","exampleIds":[],"headword":"vorher\u00db","id":"shakespeare014.lex.fever","ipa":"","label":"fever","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorhersh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Bodily fever, whose end is ominously foretold; do not assert recovery when death may be meant.","id":"shakespeare014.lex.fever.sense","status":"draft"}],"status":"draft","variants":[]},"95b9646573380798b3b3af3626dccf74576cde8248ef421e7b6a1b3a647a83db":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of change","sourceId":"shakespeare014.so