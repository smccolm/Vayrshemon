-cleopatra.r1"}],"definition":"Silius, Ventidius\u2019s military interlocutor in Act 3. Distinct from Silvius the earlier reporter and the pastoral lover.","id":"shakespeare014.lex.silius_roman.sense","status":"draft"}],"status":"draft","variants":[]},"954df63f6ca4c0d8cfe6de644880a4c430c79a58e478b07dfa19c28621f67e6b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: silver + money","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: silver + money","exampleIds":[],"headword":"ve\u00dbzarzarven","id":"shakespeare014.lex.silver_coin","ipa":"","label":"silver_coin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"veshzarzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A silver coin, the plate falling from Antony\u2019s pocket in Cleopatra\u2019s extravagant comparison. No exact denomination, weight, or number is specified.","id":"shakespeare014.lex.silver_coin.sense","status":"draft"}],"status":"draft","variants":[]},"7415b075f0e2763384f1c66d272da85eaa13fccf135115c0d30ed2413ea4e477":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: silver","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: silver","exampleIds":[],"headword":"ve\u00dbzar","id":"shakespeare014.lex.silver_sly_hound","ipa":"","label":"silver_sly_hound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"veshzar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The hound who recovers the scent at the hedge corner.","id":"shakespeare014.lex.silver_sly_hound.sense","status":"draft"}],"status":"draft","variants":[]},"06202977959fef55bffdcb3b3c8cdf457b7586b9be74e8dfee78b572f0980683":{"audioLinks":[],"citati