urceId":"shakespeare014.source.lucrece.r1"}],"definition":"The honey-producing insect of the extended hive image; native honey-wing, not an ordinary foreign borrowing.","id":"shakespeare014.lex.bee.sense","status":"draft"}],"status":"draft","variants":[]},"33425518380f26bea47d9b7dd0ead45a1f2e4d174a71ba13aa5714d782b69b5d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wing + drama_native_sound","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Authored native derivation or sense: wing + drama_native_sound","exampleIds":[],"headword":"v\u00ddlawinj\u00cden","id":"shakespeare014.lex.bee_wing_buzz","ipa":"","label":"bee_wing_buzz","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"v\u012blawinj\u0117ren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The sound of the Hybla bees, which Brutus says Antony has stolen along with their honey and their sting.","id":"shakespeare014.lex.bee_wing_buzz.sense","status":"draft"}],"status":"draft","variants":[]},"1eccc97e3c89a4d98003c777b58b5a55e8531dbb6b8b47657cb38418a0aa952b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: smooth + tree","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: smooth + tree","exampleIds":[],"headword":"siv\u00ebly\u00eblverzet","id":"shakespeare014.lex.beech_smooth_bark","ipa":"","label":"beech_smooth_bark","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"siv\u00fcly\u00fclverzet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The broad beech recalled by Arcite while the cousins tease one another about former encounters.","id":"shakespeare014.lex.beech_smooth_bark.sense","status":"draft"}],"status":"draft","variants":[]},"9c40255776f