ine.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gordius","id":"shakespeare014.lex.gordius_name","ipa":"","label":"gordius_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gordius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The personal name in the allusion to the Gordian knot.","id":"shakespeare014.lex.gordius_name.sense","status":"draft"}],"status":"draft","variants":[]},"bcf9b0a292b51dab361d8c61d516d092bf16d6009cd1b2e47436a75187001918":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"gorgon","id":"shakespeare014.lex.gorgon_figure","ipa":"","label":"gorgon_figure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gorgon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A Gorgon in Cleopatra\u2019s contrasting portrait of Antony with Mars. Named mythic class, not an ordinary borrowed term for ugliness; no particular Gorgon\u2019s personal identity is invented.","id":"shakespeare014.lex.gorgon_figure.sense","status":"draft"}],"status":"draft","variants":[]},"1677f3800efb73d281ec5923625bb974378ec6ccc7aa6b9c27e8b9c2d1321aa0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: young + goose","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: young + goose","exampleIds":[],"headword":"nevgansil","id":"shakespeare014.lex.gosling_young","ipa":"","label":"gosling_young","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nevgansil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A young goose imagined as following instinct in Coriolanus\u2019s attempt to disown family feeling.","id":"shakespeare014.lex.gosling_young.sense","status":"draft"}],"status":"draft","variants":[]},"27e30a887b4326466d374fb6475cda75da9b52b7637230ddf545ba5c72518ff1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: birth + witness","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: birth + witness","exampleIds":[],"headword":"a\u00d9\u00d5\u00dfrs\u00ebven","id":"shakespeare014.lex.gossip_birth_sponsor","ipa":"","label":"gossip_birth_sponsor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ang\u0167h\u014drs\u00fcven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"A sponsor or companion at a birth celebration. The abbess invites the household to a gossips' feast and the Duke accepts that role.","id":"shakespeare014.lex.gossip_birth_sponsor.sense","status":"draft"}],"status":"draft","variants":[]},"4ac8e30bba1fa522c3618d023f97d133a6e57e0f2d32d42fee4250cf1e4b764e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"got","id":"shakespeare014.lex.goth_people","ipa":"","label":"goth_people","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"got","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A member of the named Goth people in Touchstone\u2019s comparison, with ordinary native plural morphology. Source name retained; not silently changed to Getae or confused with Audrey\u2019s goats.","id":"shakespeare014.lex.goth_people.sense","status":"draft"}],"status":"draft","variants":[]},"6c1c4e1beead207f533a6e75685af2f93d6aab825d6f39c4fa7b4a46b8d7858b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gof","id":"shakespeare014.lex.gough_soldier","ipa":"","label":"gough_soldier","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gof","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The soldier sent by Lord Scales and reported killed in the next alarm.","id":"shakespeare014.lex.gough_soldier.sense","status":"draft"}],"status":"draft","variants":[]},"3ebcd4d3a12f93d1c9de8bb8f4459236cae33ebdc7868c6d3cad4b2d79da2b53":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: hollow + dice","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: hollow + dice","exampleIds":[],"headword":"vorkintarik","id":"shakespeare014.lex.gourd_false_die","ipa":"","label":"gourd_false_die","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorkintarik","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"A false die called a gourd, distinguished from the fullam in Pistol's boast. The hollow image does not specify a weight or outcome.","id":"shakespeare014.lex.gourd_false_die.sense","status":"draft"}],"status":"draft","variants":[]},"afede28f8d2af97c69977718b5708dfa7238be993819f20ddd509a3e3aa95146":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"klarmur","id":"shakespeare014.lex.gout","ipa":"","label":"gout","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"klarmur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The source ailment called gout in the old miser\u2019s pains; native joint-pain lexicalization, without diagnosing any real person or collapsing every painful joint condition into this category.","id":"shakespeare014.lex.gout.sense","status":"draft"}],"status":"draft","variants":[]},"0f1081fde8b7234995c090c43321b2556984cf5b8de3f38202310c2f353fda2b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gower","id":"shakespeare014.lex.gower_captain","ipa":"","label":"gower_captain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gower","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The English captain beside Fluellen. The witness supplies no identification with the messenger in Henry IV, Part 2.","id":"shakespeare014.lex.gower_captain.sense","status":"draft"}],"status":"draft","variants":[]},"b191255760db143f928265d1392d77c2d8c86571750f8dc495badfe4b34fc7c8":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gauer","id":"shakespeare014.lex.gower_chorus_poet","ipa":"","label":"gower_chorus_poet","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gauer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"The old poet who returns to tell and stage this story. The earlier messenger and captain of this name are distinct people.","id":"shakespeare014.lex.gower_chorus_poet.sense","status":"draft"}],"status":"draft","variants":[]},"ccf6b0ef55be7aca8f34567e537e83001ad7ad815c94304b971d4f59559c593d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"gauer","id":"shakespeare014.lex.gower_messenger","ipa":"","label":"gower_messenger","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gauer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The messenger to the chief justice. A personal name distinct from the poet of Pericles.","id":"shakespeare014.lex.gower_messenger.sense","status":"draft"}],"status":"draft","variants":[]},"e36e18afb297c7f7a8f58bb2dee7f786703a01fffa6e7c0bff8171bcc3dbb522":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of graceful","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of graceful","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.grace_attraction","ipa":"","label":"grace_attraction","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Attractive grace imagined as Cleopatra\u2019s trapping net. Nominal attractive quality, distinct from divine favour or legal pardon.","id":"shakespeare014.lex.grace_attraction.sense","status":"draft"}],"status":"draft","variants":[]},"179317e7a4612c97a1c498d5e41ad5d697fd9839d85bfcedd21aa004184c2d5d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: grace","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: grace","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.grace_elder_deed","ipa":"","label":"grace_elder_deed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"Hermione imagines Grace as the name of her earlier good deed, figured as an elder sister. Uses the native word for favor.","id":"shakespeare014.lex.grace_elder_deed.sense","status":"draft"}],"status":"draft","variants":[]},"70bbd669646244791f61f8c098e922d0d9f46b639df0782bb902196fe027b2c3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of grace","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of grace","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.grace_elegance","ipa":"","label":"grace_elegance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Attractive bearing or elegance in the oxymoron lascivious grace, Sonnet 40; not divine forgiveness or an honorific title.","id":"shakespeare014.lex.grace_elegance.sense","status":"draft"}],"status":"draft","variants":[]},"3bdd39ccfca4873a88d6f48854a3329a9b077d3d88c3bd7c13df91cba93098a4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of grace","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of grace","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.grace_favour","ipa":"","label":"grace_favour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Favour shown to a lover, the grace Silvius lacks. Ordinary relational extension without making Phoebe a deity or asserting a doctrine of salvation.","id":"shakespeare014.lex.grace_favour.sense","status":"draft"}],"status":"draft","variants":[]},"9284838ee206c56c7bdda10011275720567cf6af77235745f7a7a2138714ad59":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of grace","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of grace","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.grace_personified","ipa":"","label":"grace_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Grace personified as the opponent of Desire in the moral contest; not an additional foreign name.","id":"shakespeare014.lex.grace_personified.sense","status":"draft"}],"status":"draft","variants":[]},"7bc792239b71fc33a6663f53666ac9578f570f5b74bbcdafee5359f526712f44":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of graceful","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of graceful","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.grace_quality","ipa":"","label":"grace_quality","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An attractive or admirable personal quality, the graces that expose Orlando to envy. Nominal attractive grace, distinct from a title of address and from divine favour; the following holy-traitor metaphor remains explicit.","id":"shakespeare014.lex.grace_quality.sense","status":"draft"}],"status":"draft","variants":[]},"6b37a165aed911f83b517d6a2ad20d5c61cf3d6c57b4902a2fd1af21b965475a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of grace","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of grace","exampleIds":[],"headword":"farprod","id":"shakespeare014.lex.graceful","ipa":"","label":"graceful","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farprod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Grace as attractive excellence/ease in courtly and poetic description, not necessarily divine favour.","id":"shakespeare014.lex.graceful.sense","status":"draft"}],"status":"draft","variants":[]},"fb2f5f3316aff801289a0f4c910dadc4065aca74d61282a53b17b91fe4274a1f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: grace + goddess","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: grace + goddess","exampleIds":[],"headword":"farprodprodvara","id":"shakespeare014.lex.graces_divine_attendants","ipa":"","label":"graces_divine_attendants","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"farprodprodvara","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"One of the divine Graces. Pericles imagines them attending the princess as subjects.","id":"shakespeare014.lex.graces_divine_attendants.sense","status":"draft"}],"status":"draft","variants":[]},"aa203e8ca100294092cb3b0a385aa10c032f208c515b1f42f2a175783dc18bf0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: measure + mark","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: measure + mark","exampleIds":[],"headword":"memden","id":"shakespeare014.lex.graduation_mark","ipa":"","label":"graduation_mark","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"memden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A graduated mark for comparing the river\u2019s level, the scales in the pyramid. Not a fish scale or a weighing pan; the source supplies no measured flood quantity.","id":"shakespeare014.lex.graduation_mark.sense","status":"draft"}],"status":"draft","variants":[]},"d22aa510a8e5a07d1020ad1fcb852e7451b0933f9c7b203b3f790d863e988c53":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_grain_ear","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_grain_ear","exampleIds":[],"headword":"thenharen","id":"shakespeare014.lex.grain_ear","ipa":"","label":"grain_ear","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thenharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A cereal seed-head, native grain-head, here broken remnants after harvesting; not an anatomical ear or specifically maize.","id":"shakespeare014.lex.grain_ear.sense","status":"draft"}],"status":"draft","variants":[]},"dc119386e03bae46239306b6e0141f7d435a906900bb2b5b564c37a8347790ce":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: seed + weight","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: seed + weight","exampleIds":[],"headword":"p\u00e1inmemvor","id":"shakespeare014.lex.grain_fine_weight","ipa":"","label":"grain_fine_weight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4inmemvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A minute weight in Exeter's image of Henry weighing time to the utmost grain. The verse gives no count of grains.","id":"shakespeare014.lex.grain_fine_weight.sense","status":"draft"}],"status":"draft","variants":[]},"5432ffea3aeb6331290eb26ee6774a5d5ca303982037a7352621b9fe31acba6c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kernel","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kernel","exampleIds":[],"headword":"nel","id":"shakespeare014.lex.grain_kernel","ipa":"","label":"grain_kernel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An individual cereal kernel, contrasted with chaff in the few-friends metaphor. Explicit counted use of native kernel, distinct from collective corn, grain dye and wood grain.","id":"shakespeare014.lex.grain_kernel.sense","status":"draft"}],"status":"draft","variants":[]},"122dfc7d43bcb8b11807e94dcfb552022e9fecff78c657f9931878370e71c3e9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: speech + rule","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: speech + rule","exampleIds":[],"headword":"giktenv\u00d7envar\u00dfnen","id":"shakespeare014.lex.grammar_study","ipa":"","label":"grammar_study","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"giktenv\u0113envar\u014dnen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The rules taught at the grammar school Cade accuses Saye of erecting.","id":"shakespeare014.lex.grammar_study.sense","status":"draft"}],"status":"draft","variants":[]},"d9f12be5a116d23a3121c675a517761b49ee2a46e0223971a24f1511c5215fe1":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_grandmother_timothy","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_grandmother_timothy","exampleIds":[],"headword":"palmela","id":"shakespeare014.lex.grandmother","ipa":"","label":"grandmother","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"palmela","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"An aged matron shown the daughters of her daughter; source context determines the maternal relation, not the noun alone.","id":"shakespeare014.lex.grandmother.sense","status":"draft"}],"status":"draft","variants":[]},"c832b5964053207346b2ce23108ba16516ff148b28110123cc51dfaab9d8cb28":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"granpre","id":"shakespeare014.lex.grandpre_lord","ipa":"","label":"grandpre_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"granpre","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"French lord named in the summons and later a speaker. Source label Grandpre.","id":"shakespeare014.lex.grandpre_lord.sense","status":"draft"}],"status":"draft","variants":[]},"e5fcabce363ca20dab27cd9137315aa89bd26229261b4ab2221e077498e9d532":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: rough + rub","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: rough + rub","exampleIds":[],"headword":"krathrul","id":"shakespeare014.lex.grate_sound","ipa":"","label":"grate_sound"