.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"troilus","id":"shakespeare014.lex.troilus_petruchio_spaniel","ipa":"","label":"troilus_petruchio_spaniel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"troilus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Petruchio's spaniel, distinguished from the Trojan man for whom he is named.","id":"shakespeare014.lex.troilus_petruchio_spaniel.sense","status":"draft"}],"status":"draft","variants":[]},"9701ea65f287f27a60fef6b388bed6982ac39adbb35f35bc2d246553060de03a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: ball + arch","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: ball + arch","exampleIds":[],"headword":"l\u00dfnkorlunor","id":"shakespeare014.lex.troll_my_dames_game","ipa":"","label":"troll_my_dames_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"l\u014dnkorlunor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"A portable game in which balls are rolled through arches. One of the enterprises Autolycus ascribes to his supposed assailant.","id":"shakespeare014.lex.troll_my_dames_game.sense","status":"draft"}],"status":"draft","variants":[]},"cfd797c440337277e91c58bb2cfd5d3eb8d1b3247a49764ebefeb675802c9a44":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from horse, step","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from horse, step","exampleIds":[],"headword":"thalpalen","id":"shakespeare014.lex.trot","ipa":"","label":"trot","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thalpalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The horse\u2019s measured trotting gait; does not claim that each performed gait is anatomically demonstrated by the text.","id":"shakespeare014.lex.trot.sense","status":"draft"}],"status":"draft","variants":[]},"b6f0cb925c6dd2b8b3ad4390d9ea00250e0bc98a0638c0c70d37eeb5a7d09eb8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_trouble","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_trouble","exampleIds":[],"headword":"w\u00e9asem","id":"shakespeare014.lex.trouble","ipa":"","label":"trouble","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u00e9asem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Distress or difficulty, here the burden of the demanded kisses.","id":"shakespeare014.lex.trouble.sense","status":"draft"}],"status":"draft","variants":[]},"c18b56e8c17092745ec84e243565b3c9a7ca824fa1d1f1eb5f4ce0465f66b9e5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spot + stream + fish_creature","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: spot + stream + fish_creature","exampleIds":[],"headword":"pirilyems\u00d7rendrig\u00e1l","id":"shakespeare014.lex.trout_river_fish","ipa":"","label":"trout_river_fish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pirilyems\u0113rendrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The spotted stream fish in Pompey's sexual image of fishing another person's private water.","id":"shakespeare014.lex.trout_river_fish.sense","status":"draft"}],"status":"draft","variants":[]},"ae4f7c1bf8de3cee06151a430c0ca733f252cea1458e30111f3d742ad8