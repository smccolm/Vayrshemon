ry_percy.sense","status":"draft"}],"status":"draft","variants":[]},"30e671b304bfddf4a88fb5a70905e2c80bba955df5921d9b184dcf1e8041dbd3":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hari","id":"shakespeare014.lex.harry_prince_wales","ipa":"","label":"harry_prince_wales","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hari","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Prince of Wales, the king's son. The king calls him my young Harry.","id":"shakespeare014.lex.harry_prince_wales.sense","status":"draft"}],"status":"draft","variants":[]},"805dddd246b39ef18e53288bb69fa8f5b12bab33a1250c6916502ba77b8391dd":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of harvest","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of harvest","exampleIds":[],"headword":"trornek","id":"shakespeare014.lex.harvest_crop","ipa":"","label":"harvest_crop","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"trornek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The yield to be reaped, kisses figured as the lips\u2019 due harvest in Sonnet 128; nominal result of harvesting.","id":"shakespeare014.lex.harvest_crop.sense","status":"draft"}],"status":"draft","variants":[]},"0b583474175a155f04aa9fec2364d5e77dd0c0fb6c552582b65f7276e10e327d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hasti\u00d9z","id":"shakesp