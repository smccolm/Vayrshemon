phonetic personal-name adaptation","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kafis","id":"shakespeare014.lex.caphis_athenian_agent","ipa":"","label":"caphis_athenian_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kafis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"definition":"A senator's servant sent to collect from Timon.","id":"shakespeare014.lex.caphis_athenian_agent.sense","status":"draft"}],"status":"draft","variants":[]},"b0fd0010bdbc8934ef23fde657deb4fbf6833fcaa7b1ba7fb0f3410b1dd6aa82":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kapilet","id":"shakespeare014.lex.capilet_andrew_horse","ipa":"","label":"capilet_andrew_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kapilet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Andrew's gray horse offered to avert the duel.","id":"shakespeare014.lex.capilet_andrew_horse.sense","status":"draft"}],"status":"draft","variants":[]},"2ea2c75446cfbc3139063688edca1819bdbbf49e764d7f8c9ac0f7f4a43d92d9":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","exampleIds":[],"headword":"kapitol","id":"shakespeare014.lex.capitol","ipa":"","label":"capitol","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kapitol","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The named Roman sacred civic site invoked in Brutus\u2019s oath; a place name, not an ordinary borrowing for a government building.","id":"shakespeare014.lex.capitol.sense","status":"draft"}],"status":"draft","variants":[]},"4b5ef4f4b06129dd9e2cbef82198cbe8e1c582f9297e314a7b4e25b92a488d88":{"audioLinks":[],"citations":[{"locator":"Authored native compound: cut + cock_fowl","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: cut + cock_fowl","exampleIds":[],"headword":"dest\u00eb\u00c5keklen","id":"shakespeare014.lex.capon_fowl","ipa":"","label":"capon_fowl","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dest\u00fc\u0101keklen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A castrated domestic male fowl raised for eating, native cut + cock as a lexicalized food category. Not any injured cock and not a new productive castration morpheme.","id":"shakespeare014.lex.capon_fowl.sense","status":"draft"}],"status":"draft","variants":[]},"420e5383a8aa83cb3545c0f3ae1e77f73cc22f2f8c15ec5047bbb445b88974a3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_cappadocia_acts","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_cappadocia_acts","exampleIds":[],"headword":"kappadokia","id":"shakespeare014.lex.cappadocia_region","ipa":"","label":"cappadocia_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kappadokia","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Cappadocia, the realm of the Archelaus in this play\u2019s war roster; not the realm of Herod\u2019s son Archelaus in the Bible.","id":"shakespeare014.lex.cappadocia_region.sense","status":"draft"}],"status":"draft","variants":[]},"48d96c702eb2b5fb32158b7f543794039386b1b961a74c5e9ae7196133aaea67":{"audioLinks":[],"citations":[{"locator":"Authored native compound: change + will","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: change + will","exampleIds":[],"headword":"\u00e3lum\u00c9lm","id":"shakespeare014.lex.capricious_temper","ipa":"","label":"capricious_temper","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"oilum\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Humorous in Le Beau\u2019s warning means governed by changing moods, not funny. Native change + will describes this unstable inclination.","id":"shakespeare014.lex.capricious_temper.sense","status":"draft"}],"status":"draft","variants":[]},"90b3b6a48a812ae478e1fbb2894303e494c37153f507b2771da463ed30f92c21":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: captain","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: captain","exampleIds":[],"headword":"hefak gurs\u00dflum\u00e1pe\u00dbem haren","id":"shakespeare014.lex.captain_prison_order","ipa":"","label":"captain_prison_order","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlum\u00f4peshem haren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The captain entrusted with Edmund's note to follow the prisoners. Edmund later sends him a reprieve token.","id":"shakespeare014.lex.captain_prison_order.sense","status":"draft"}],"status":"draft","variants":[]},"5ef8427d7b068421cda1f1ccbd62020a7aadc3743bc3ae34eafc85acf9b8ad04":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: captain","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: captain","exampleIds":[],"headword":"hefak gurs\u00dflum\u00e1pe\u00dbem haren","id":"shakespeare014.lex.captain_trumpet_signal","ipa":"","label":"captain_trumpet_signal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlum\u00f4peshem haren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"The captain in Albany's company who orders the trumpet to sound. The source introduces a captain after the recipient of Edmund's note has exited.","id":"shakespeare014.lex.captain_trumpet_signal.sense","status":"draft"}],"status":"draft","variants":[]},"5f993c7e20d05a5a98f27baf0decae90d21cd4b20b209b1411e5a65c74a2011d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: command + craft","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: command + craft","exampleIds":[],"headword":"nor\u00d3ajw\u00ebnh\u00c5b\u00cd","id":"shakespeare014.lex.captainship_command","ipa":"","label":"captainship_command","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"northajw\u00fcnh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Competence in military command, native command-craft. Enobarbus contrasts this with Antony\u2019s desire; not simply possession of a captain\u2019s rank.","id":"shakespeare014.lex.captainship_command.sense","status":"draft"}],"status":"draft","variants":[]},"c70990551ee2f7c801454c2913f265610554baef0d52ec2378a38c16856817ea":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from eye, capture","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from eye, capture","exampleIds":[],"headword":"omi\u00e7ztkl\u00e1rjem","id":"shakespeare014.lex.captivate","ipa":"","label":"captivate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"omi\u016bztkl\u00f4rjem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Seize attention or fascination, metaphorical capture of the eye without literal confinement.","id":"shakespeare014.lex.captivate.sense","status":"draft"}],"status":"draft","variants":[]},"a8dc1a37cc793773785e87932f1703534d15017c28d7dd04692d0815e5dfaddd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kapu\u00d1ius","id":"shakespeare014.lex.capuchius_imperial_envoy","ipa":"","label":"capuchius_imperial_envoy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kapuchius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The emperor's ambassador who agrees to carry Katherine's last petitions to Henry.","id":"shakespeare014.lex.capuchius_imperial_envoy.sense","status":"draft"}],"status":"draft","variants":[]},"ec0a88a2b0c147b46a4e5450050efe93b622e9fccab1d39f243b1946db4a03f8":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kapulet","id":"shakespeare014.lex.capulet_verona_house","ipa":"","label":"capulet_verona_house","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kapulet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"Juliet's father and the family name in Verona. Distinct from Diana's name Capilet.","id":"shakespeare014.lex.capulet_verona_house.sense","status":"draft"}],"status":"draft","variants":[]},"fb7ac77bc31fb7e05a3e4236f12588c3f23625a9125d2438124a356e819db74f":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kar","id":"shakespeare014.lex.car_confessor_short","ipa":"","label":"car_confessor_short","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Short form of de la Car, the same John named as Buckingham's confessor in the warrant.","id":"shakespeare014.lex.car_confessor_short.sense","status":"draft"}],"status":"draft","variants":[]},"2bc95154c3d81cf8697326cfba769d3756ee89878d0b7520c5610fd8dd84c01e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: gold + weight + part","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Authored native derivation or sense: gold + weight + part","exampleIds":[],"headword":"azarmemvorthrenin","id":"shakespeare014.lex.carat_goldsmith_weight","ipa":"","label":"carat_goldsmith_weight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"azarmemvorthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"A fine unit of weight used on the goldsmith's note. The dialogue gives neither a number of carats nor a modern gram equivalent.","id":"shakespeare014.lex.carat_goldsmith_weight.sense","status":"draft"}],"status":"draft","variants":[]},"36721551549b7302b0484a554c367e08abd7538729141000c20191f268eb6883":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: spice + seed","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: spice + seed","exampleIds":[],"headword":"spirilp\u00e1in","id":"shakespeare014.lex.caraway_seed","ipa":"","label":"caraway_seed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"spirilp\u00f4in","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The aromatic seeds eaten with Shallow's apple in the orchard.","id":"shakespeare014.lex.caraway_seed.sense","status":"draft"}],"status":"draft","variants":[]},"10442cc170ebd8f598dcfc3ade085d053ba3c8b2f0af33b07f6083578db0ccf8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: grill + flesh","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: grill + flesh","exampleIds":[],"headword":"zarunzarilvorin","id":"shakespeare014.lex.carbonado_meat","ipa":"","label":"carbonado_meat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarunzarilvorin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Meat slashed for grilling, the image for Aufidius\u2019s wounds. Native grill-flesh; retains the cooking comparison without importing the dish-name sound.","id":"shakespeare014.lex.carbonado_meat.sense","status":"draft"}],"status":"draft","variants":[]},"07ce9efab9cfd8a042f4d1594cce98ef54c3002d51ac1ff5b8c5cd7aa32e3de1":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of ruby","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of ruby","exampleIds":[],"headword":"rub\u00ebn","id":"shakespeare014.lex.carbuncle_gem","ipa":"","label":"carbuncle_gem","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"rub\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A rich red precious stone in the comparison with Phoebus\u2019s chariot. Retains the source jewel category without asserting an exact modern mineral; not a skin lesion.","id":"shakespeare014.lex.carbuncle_gem.sense","status":"draft"}],"status":"draft","variants":[]},"686fa8bce51cc9324b2fb6668fed8eb2b83c995bd339ec6c6209d30889b3d4b2":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of triumph","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of triumph","exampleIds":[],"headword":"ziftarvb\u00e7or","id":"shakespeare014.lex.card_trump","ipa":"","label":"card_trump","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ziftarvb\u016bor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A winning card in Antony\u2019s rigged-card metaphor, carrying the source triumph/victory overlap. The established native triumph word takes a contextual card sense; no English trump loan.","id":"shakespeare014.lex.card_trump.sense","status":"draft"}],"status":"draft","variants":[]},"54812e40cf0aba586e37bf61ce55aa0e15e33fcbbd60bc6686a0016a6cd505fa":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wool_material + separate","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: wool_material + separate","exampleIds":[],"headword":"sh\u00ebralf\u00eblstras","id":"shakespeare014.lex.carder_wool","ipa":"","label":"carder_wool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sh\u00fcralf\u00fclstras","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"A worker who separates and straightens wool fibers. The clothiers dismiss carders alongside spinners, fullers and weavers.","id":"shakespeare014.lex.carder_wool.sense","status":"draft"}],"status":"draft","variants":[]},"387ce4eed79173df84628ec49e3ae0078c01fed837b2eba044189144cb6c8883":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: chief + bishop_english","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: chief + bishop_english","exampleIds":[],"headword":"harennao\u00c3s\u00dflum","id":"shakespeare014.lex.cardinal_church","ipa":"","label":"cardinal_church","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harennaojzhs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The ecclesiastical office and robes associated with Winchester at the Tower.","id":"shakespeare014.lex.cardinal_church.sense","status":"draft"}],"status":"draft","variants":[]},"3fffeb9c202c8468fe6962db81c5f85fc1cbed9799d1049a544404943b3929c9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of care","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of care","exampleIds":[],"headword":"s\u00e3\u00d1","id":"shakespeare014.lex.careful_concern","ipa":"","label":"careful_concern","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"soich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Anxious attention to a loose domestic bird in Sonnet 143; careful does not simply praise technical precision.","id":"shakespeare014.lex.careful_concern.sense","status":"draft"}],"status":"draft","variants":[]},"1ccd1e2c88e59feff834f2bec45b44bca7ea92a7039b6a72f5910349c7997356":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-ii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"karlail","id":"shakespeare014.lex.carlisle_bishop_richard","ipa":"","label":"carlisle_bishop_richard","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"karlail","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-ii.r1"}],"definition":"The bishop who condemns a subject's judgment of his king, later sentenced by Henry to live in retirement.","id":"shakespeare014.lex.carlisle_bishop_richard.sense","status":"draft"}],"status":"draft","variants":[]},"49dceca16a873918e0e336bc0dd180f480f2f86feac456b3e4bc9d8a506ac086":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"karnarvan\u00dbir","id":"shakespeare014.lex.carnarvanshire_county","ipa":"","label":"carnarvanshire_county","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"karnarvanshir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The county the old lady says would be enough land to tempt her to queenship.","id":"shakespeare014.lex.carnarvanshire_county.sense","status":"draft"}],"status":"draft","variants":[]},"7e91747ced432212c8ea9de7a9ad1e0956cffebe77bb286ee3a04347234b5cc4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: flesh + colour","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: flesh + colour","exampleIds":[],"headword":"vorinl\u00c7m","id":"shakespeare014.lex.carnation_colour","ipa":"","label":"carnation_colour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorinl\u00e3m","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The flesh-colored hue that Quickly hears when the Boy says the devils are incarnate. Keep the shared flesh root audible.","id":"shakespeare014.lex.carnation_colour.sense","status":"draft"}],"status":"draft","variants":[]},"4acb158f7a382d53f41be55a4ad8aaae0d8072aa9564f0618d53dfa4e97a2200":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fringe_clothing + flower","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: fringe_clothing + flower","exampleIds":[],"headword":"felenthirilyelfal","id":"shakespeare014.lex.carnation_garden_blossom","ipa":"","label":"carnation_garden_blossom","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"felenthirilyelfal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The garden blossom, distinguished from the established flesh-color sense. The native description follows the fringed petals.","id":"shakespeare014.lex.carnation_garden_blossom.sense","status":"draft"}],"status":"draft","variants":[]},"14505bffdf5ca25eb927feef870567e9ecc5fdf0059a317a54896c3e27f8d360":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sweet + pod_shell","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: sweet + pod_shell","exampleIds":[],"headword":"melp\u00e1inshalen","id":"shakespeare014.lex.carob_sweet_pod","ipa":"","label":"carob_sweet_pod","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melp\u00f4inshalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"Sweet carob pods in the locusts comparison, a botanical reading beside the bitter gourd. The edible insect is an alternate interpretation.","id":"shakespeare014.lex.carob_sweet_pod.sense","status":"draft"}],"status":"draft","variants":[]},"f9e6760086f7155e77d6eab409091e98a55becb8aa2348090cc1044366d3f5df":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: trade + ship","sourceId":"shakespeare014.source.othello.r1"}],"etymology":"Authored native derivation or sense: trade + ship","exampleIds":[],"headword":"kwistmeran","id":"shakespeare014.lex.carrack_trading_ship","ipa":"","label":"carrack_trading_ship","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kwistmeran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.othello.r1"}],"definition":"A large merchant sailing ship. Iago likens Othello's new marriage to the taking of such a prize on land.","id":"shakespeare014.lex.carrack_trading_ship.sense","status":"draft"}],"status":"draft","variants":[]},"3b00d72175a2d8d73f3bb7098e977ffc1577f434bb4a50c9c88abfc680ff8939":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: carry + away","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: carry + away","exampleIds":[],"headword":"\u00db\u00c7dthav","id":"shakespeare014.lex.carry_away","ipa":"","label":"carry_away","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"sh\u00e3dthav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Carry someone away, physically or figuratively; calamity is the carrier in the opening political argument, not supernatural magic.","id":"shakespeare014.lex.carry_away.sense","status":"draft"}],"status":"draft","variants":[]},"8c067fef9f201fe541a3648fccd6294c228123a903edf579f6be1d063c642282":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of wagon","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of wagon","exampleIds":[],"headword":"olirborel","id":"shakespeare014.lex.cart_vehicle","ipa":"","label":"cart_vehicle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"olirborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A wheeled carrier of loads, the harvest-cart image in Touchstone\u2019s bawdy verse. Contextual native wagon; no exact wheel count or public punishment is silently added.","id":"shakespeare014.lex.cart_vehicle.sense","status":"draft"}],"status":"draft","variants":[]},"a0c785e9c165f37f75aaab33527503e5ed256c766751f4a4c226d546ef2b48ab":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: cut + form","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: cut + form","exampleIds":[],"headword":"dest\u00eb\u00c5l\u00dfn","id":"shakespeare014.lex.carve","ipa":"","label":"carve","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dest\u00fc\u0101l\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Cut or work a visible shape into a surface, figuratively the marks grief carves in faces.","id":"shakespeare014.lex.carve.sense","status":"draft"}],"status":"draft","variants":[]},"9c980d7757e58222d62f99fa2a0de0927326431d01f9d0c313ae2432afe34dbe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fire + carve","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: fire + carve","exampleIds":[],"headword":"zarundest\u00eb\u00c5l\u00dfn","id":"shakespeare014.lex.carved_chimneypiece","ipa":"","label":"carved_chimneypiece","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarundest\u00fc\u0101l\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The carved decorative surround of a fireplace. Iachimo identifies its subject as the bathing Dian.","id":"shakespeare014.lex.carved_chimneypiece.sense","status":"draft"}],"status":"draft","variants":[]},"cc3360cc4f2469269e8a1e1dbd9e05aaa771660e6351e04e0289cbbc076984eb":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.julius-caesar.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kaska","id":"shakespeare014.lex.casca_roman_conspirator","ipa":"","label":"casca_roman_conspirator","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kaska","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.julius-caesar.r1"}],"definition":"The man who describes the three offers of a crown and takes part in the attack on Caesar.","id":"shakespeare014.lex.casca_roman_conspirator.sense","status":"draft"}],"status":"draft","variants":[]},"1f421bc993f55fcda956e366dcd8891adfd3487e88b95e23df2b3ee01073728d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: judge + matter","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: judge + matter","exampleIds":[],"headword":"nerbw\u00c5vumenvoren","id":"shakespeare014.lex.case_legal","ipa":"","label":"case_legal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerbw\u0101vumenvoren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A dispute brought for judgment, rather than an enclosing case, circumstance in general or bodily innuendo.","id":"shakespeare014.lex.case_legal.sense","status":"draft"}],"status":"draft","variants":[]},"83b086b7db9de0eae6d6106dfc385308ed955955edb852f6a577b4b6395b787e":{"audioLinks":[],"citations":[{"locator":"Authored native compound: turn + window","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: turn + window","exampleIds":[],"headword":"elyi\u00d1daromi","id":"shakespeare014.lex.casement_window","ipa":"","label":"casement_window","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elyichdaromi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An opening window, native turn + window, in the escaping-wit sequence. Keeps the hinged-window category without an unsupported source-sounding kasel form.","id":"shakespeare014.lex.casement_window.sense","status":"draft"}],"status":"draft","variants":[]},"8d87602673dcfc9df4a26ae4d59dfcdf7dfcbbe2f35bb8cd6a59799fde515e29":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: choose + box","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"etymology":"Authored native derivation or sense: choose + box","exampleIds":[],"headword":"nerbyalborel","id":"shakespeare014.lex.casket_choice_box","ipa":"","label":"casket_choice_box","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerbyalborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"definition":"One of the gold, silver and lead boxes in the condition imposed by Portia's father.","id":"shakespeare014.lex.casket_choice_box.sense","status":"draft"}],"status":"draft","variants":[]},"7a88c44d8aafaf97e41d52e3e830ec944f4052b85b394c4376fcd11d56d9d39c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kasandra","id":"shakespeare014.lex.cassandra_priam_daughter","ipa":