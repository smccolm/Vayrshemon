":"","label":"curio_orsino_gentleman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kuriyo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Orsino's attendant who proposes the hart hunt.","id":"shakespeare014.lex.curio_orsino_gentleman.sense","status":"draft"}],"status":"draft","variants":[]},"bf917c871b3c64074299851f2405c1ad4d651f8d0efbf220d6ccde5627adeaa7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of careful","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of careful","exampleIds":[],"headword":"s\u00e3\u00d1plesten","id":"shakespeare014.lex.curious_exact","ipa":"","label":"curious_exact","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"soichplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Exacting and difficult to satisfy when looking for cause of distrust. Distinct from simple inquisitiveness or a fabricated investigation already completed.","id":"shakespeare014.lex.curious_exact.sense","status":"draft"}],"status":"draft","variants":[]},"ffbb8830e3ec23e64870e96cee98ec40931be8a9faee3eeaaafb811458e17a8b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: small + grape","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: small + grape","exampleIds":[],"headword":"viminvemel","id":"shakespeare014.lex.currant_dried_grape","ipa":"","label":"currant_dried_grape","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminvemel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"Small dried grapes used in cookery, distinguished here from the