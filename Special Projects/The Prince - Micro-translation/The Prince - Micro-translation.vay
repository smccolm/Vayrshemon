eglin_spiced_mead","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yelinmelsam\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The spiced honey drink in Berowne's second throw of sweet things.","id":"shakespeare014.lex.metheglin_spiced_mead.sense","status":"draft"}],"status":"draft","variants":[]},"a8cc8c553f367a0a1f5adf9819ecfdbd4f58cb63b617d0b8793ed2a8ce0d0d86":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of foot","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of foot","exampleIds":[],"headword":"pales","id":"shakespeare014.lex.metrical_foot","ipa":"","label":"metrical_foot","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"pales","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A rhythmic unit of verse, extended from the same native foot noun as the body part. This shared form carries the feet-bearing/limping joke; it does not certify that the native translation has the source\u2019s exact scansion.","id":"shakespeare014.lex.metrical_foot.sense","status":"draft"}],"status":"draft","variants":[]},"9152996c624a1678329395ba23619eb97b238f5ad38b023663c22e107ca44f93":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of metal","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of metal","exampleIds":[],"headword":"zar","id":"shakespeare014.lex.mettle_vigour","ipa":"","label":"mettle_vigour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Effective vigour, with the metal/mettle association retained by the existing native metal/mettle polysemy. Enobarbus makes death a vigorous lover; no literal metallic substance is asserted.","id":"shakespeare014.lex.mettle_vigour.sense","status":"draft"}],"status":"draft","variants":[]},"cfeed5da6172dc383eacd33d3482c72584ccfb32e77ebd14b80dd09ef0efd8ae":{"audioLinks":[],"citations":[{"locator":"Authored native compound: weak + call","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: weak + call","exampleIds":[],"headword":"vimjw\u00ebn\u00d3\u00c5\u00e7","id":"shakespeare014.lex.mewl_infant","ipa":"","label":"mewl_infant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vimjw\u00fcnth\u0101\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A weak plaintive infant cry. Native weak + call, lexicalized for this vocal action; no imitation of the English sound is claimed.","id":"shakespeare014.lex.mewl_infant.sense","status":"draft"}],"status":"draft","variants":[]},"165a8e7467a047ce7a6e121d54abdf9ce3e7cee210b2359f7b415039670d0d4d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"meksiko","id":"shakespeare014.lex.mexico_merchant_destination","ipa":"","label":"mexico_merchant_destination","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"meksiko","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"definition":"Place where Shylock has heard that Antonio has a third trading ship.","id":"shakespeare014.lex.mexico_merchant_destination.sense","status":"draft"}],"status":"draft","variants":[]},"8d6c3dae176e1f5956fe42c6b75836b3973430538449f7d7480c808156e9fc58":{"audioLinks":[],"citations":[{"locator":"A 