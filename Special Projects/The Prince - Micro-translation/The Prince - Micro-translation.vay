ajel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Nominal conversion of dull: slowness of wit, contrasted with the sharpening whetstone. Retains the repeated native dull root without importing the Lethe stupor context.","id":"shakespeare014.lex.dullness_wit.sense","status":"draft"}],"status":"draft","variants":[]},"e4a065cef2f71956082d2d411351c97bae81a2cde2a9b55a74a8031ff2488095":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dum\u00ebn","id":"shakespeare014.lex.dumaine_navarre_lord","ipa":"","label":"dumaine_navarre_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dum\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"Navarre's lord and fellow scholar. His name shares the sound used for the two brothers in All's Well.","id":"shakespeare014.lex.dumaine_navarre_lord.sense","status":"draft"}],"status":"draft","variants":[]},"13abc408f7db7ec10a01a88cfa2ed9db2edaf15d6c96a335bcc6215947b7d0e9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: silent","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: silent","exampleIds":[],"headword":"dwe\u00d9","id":"shakespeare014.lex.dumb_minister","ipa":"","label":"dumb_minister","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dweng","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The minister named Dumb by Quickly, rendered with the native root for silent.","id":"shakespeare014.lex.dumb_minister.sense","status":"draft"}],"st