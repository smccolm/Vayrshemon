10170f09428c841d84dac5608cc5f373819687c7ef00b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_incense","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_incense","exampleIds":[],"headword":"spirilzarun","id":"shakespeare014.lex.incense","ipa":"","label":"incense","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"spirilzarun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Aromatic sacred fumigation, figuratively offered at the woman-as-shrine; not the verb anger.","id":"shakespeare014.lex.incense.sense","status":"draft"}],"status":"draft","variants":[]},"05ec92559cbd1ef59c2ae8c9d12004e84bc555278b79dbbf465de4c15ab9e482":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: kin + bed","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: kin + bed","exampleIds":[],"headword":"v\u00d7dlehmbelen","id":"shakespeare014.lex.incest","ipa":"","label":"incest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"v\u0113dlehmbelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Sexual relations prohibited on grounds of close kinship, in the catalogue of sins; native kin-bed lexicalization, not ordinary shared sleeping space or an allegation about this poem\u2019s assailant and victim.","id":"shakespeare014.lex.incest.sense","status":"draft"}],"status":"draft","variants":[]},"c94852af88ad11b96e53a5a73aaf5136873eaf1056eba5b0bff195ac1997e23f":{"audioLinks":[],"citations":[{"locator":"Exact native Unta 1/12 plus the source-culture length sense of foot.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Exact native Unta 1/12 plus the source-culture length sense of foot.","exampleIds":[],"headword":"f\u00dflem\u00