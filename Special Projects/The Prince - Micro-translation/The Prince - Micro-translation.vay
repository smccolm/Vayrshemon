],"definition":"Starting point of the day's march Richmond describes.","id":"shakespeare014.lex.tamworth_richmond_march.sense","status":"draft"}],"status":"draft","variants":[]},"8ae46573cc8385dd964f9b36891bf6a399fb32576415fd3a8563ae316b8789a6":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"tamiris","id":"shakespeare014.lex.tamyris_queen","ipa":"","label":"tamyris_queen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tamiris","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The Scythian queen whose fame in the death of Cyrus inspires the countess.","id":"shakespeare014.lex.tamyris_queen.sense","status":"draft"}],"status":"draft","variants":[]},"4565670192a8a256cea4518e3e6ad3b749826b3a60f80d05176e775c42d5c85a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: leather + make + person","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Authored native derivation or sense: leather + make + person","exampleIds":[],"headword":"skirena\u00d9s\u00dflum","id":"shakespeare014.lex.tanner_trade","ipa":"","label":"tanner_trade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"skirenangs\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"A worker who prepares leather from hides. Best's son is a tanner of Wingham.","id":"shakespeare014.lex.tanner_trade.sense","status":"draft"}],"status":"draft","variants":[]},"ea180e06f8e6417d52dc23867e34f6fc71efe09ae67e5813063600da2ae62a38":{"audioLinks":[],"citations":[{"locator":"Permitted personal/place-name sound approximation.","sourceId":"shakespeare014.source.venu