ne_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"torine","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Toryne, the place Caesar has captured according to the report. Not a personal name or a target for automatic historical spelling normalization.","id":"shakespeare014.lex.toryne_place.sense","status":"draft"}],"status":"draft","variants":[]},"5e5a8d20ae98a4b39933a9b9c1e72a245fba611aeac9923d656066e0b26702c1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: metal + test","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: metal + test","exampleIds":[],"headword":"zarkelde\u00dbon","id":"shakespeare014.lex.touch_assay","ipa":"","label":"touch_assay","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarkeldeshon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A test of metal\u2019s quality, the figurative noble touch of trustworthy friends. Native metal-test retains the testing/purity image; not mere bodily contact or the fool Touchstone\u2019s personal name.","id":"shakespeare014.lex.touch_assay.sense","status":"draft"}],"status":"draft","variants":[]},"a707f8c8f345b4fd2b17bb3c6afc7f18d5684c3fcfb012af6944e4b2d22d25a0":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"ta\u00d1st\u00dfn","id":"shakespeare014.lex.touchstone_fool","ipa":"","label":"touchstone_fool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"tachst\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The court fool in As You Like It. Phonetic personal name; no ordinary stone noun is borrowed under this permission.","id":"shakespeare014.lex.touchstone_fool.sense","status":"draft"}],"status":"draft","variants":[]},"f5e91889feb6d0a2face33e3e671bae219b0612f261c57dac2fbf5d963352878":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"turen","id":"shakespeare014.lex.touraine_region","ipa":"","label":"touraine_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"turen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Region where Joan says she found her sword.","id":"shakespeare014.lex.touraine_region.sense","status":"draft"}],"status":"draft","variants":[]},"f1a2536c55a43c40bfd36b1e997a6d9c5e8bdf986216cb9b4863f97cbeb41446":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from fight, field","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from fight, field","exampleIds":[],"headword":"hefakw\u00cfn\u00c7","id":"shakespeare014.lex.tournament_lists","ipa":"","label":"tournament_lists","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakw\u00cfn\u00e3","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The bounded arena of a tournament, metaphor for Venus\u2019s encounter; not a written list.","id":"shakespeare014.lex.tournament_lists.sense","status":"draft"}],"status":"draft","variants":[]},"08c832205537b494c795e8b1acafca9d6f283666c9ea896e46b2796df2671310":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.s