ve derivation or sense: rise + heaven + day","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: rise + heaven + day","exampleIds":[],"headword":"ner\u00c3\u00cdprodnaryel","id":"shakespeare014.lex.ascension_feast","ipa":"","label":"ascension_feast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerjzh\u0117rprodnaryel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The Christian feast named in Peter's prediction about the king's crown. The text specifies noon on the next feast.","id":"shakespeare014.lex.ascension_feast.sense","status":"draft"}],"status":"draft","variants":[]},"d00d887a19c94ce6349d14756a199c94cfaef3f616e44900f607a2ec6f4d81dc":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: rise","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: rise","exampleIds":[],"headword":"ner\u00c3\u00cd","id":"shakespeare014.lex.ascent_rank","ipa":"","label":"ascent_rank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nerjzh\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An advance in public standing, the second officer\u2019s account of Coriolanus\u2019s earned rise. Explicit nominal rise, not a literal mountain climb.","id":"shakespeare014.lex.ascent_rank.sense","status":"draft"}],"status":"draft","variants":[]},"5c569f0cc80c12ef6e6c23d9cbab4781fe60ba0b49a4542402ae5536bb75999d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_ash_tree + spear","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_ash_tree + spear","exampleIds":[],"headword":"y\u00ebl\u00d7\u00d3tarven","id":"shakespeare014.lex.ash_spear","ipa":"","label":"ash_spear","notes":"",