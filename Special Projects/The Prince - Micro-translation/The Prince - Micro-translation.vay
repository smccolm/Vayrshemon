"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnjongjemek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Gloucester's public office in the young king's minority.","id":"shakespeare014.lex.protector_office.sense","status":"draft"}],"status":"draft","variants":[]},"3b04a250efa3d59a62ff68d2de2e31e78b10a6bcba3696f1b2b0b5500ad70151":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"proteos","id":"shakespeare014.lex.proteus_shape_changer","ipa":"","label":"proteus_shape_changer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"proteos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The shape-changing figure with whom Richard compares his own ability to change for advantage.","id":"shakespeare014.lex.proteus_shape_changer.sense","status":"draft"}],"status":"draft","variants":[]},"fe14140a0b95d20b648157bc66d462459e6c8afccfdb09fcdb56aa8b83fa013b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"proteos","id":"shakespeare014.lex.proteus_verona_friend","ipa":"","label":"proteus_verona_friend","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"proteos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-gentlemen-of-verona.r1"}],"definition":"Antonio's son and Valentine's friend. His own changes of allegiance echo the name of the mythic shape-changer.","id":"shakespear