exical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An individual circumstance or point in a lengthy account, not an unspecified particular person.","id":"shakespeare014.lex.particular_detail.sense","status":"draft"}],"status":"draft","variants":[]},"2da4e312ed34519419502ad293ed86c79ddb06f2020c8ee0242df676021fe1bf":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: part + name","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: part + name","exampleIds":[],"headword":"threninden","id":"shakespeare014.lex.particularize_list","ipa":"","label":"particularize_list","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"threninden","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Specify item by item, the native part-name action in the inventory metaphor.","id":"shakespeare014.lex.particularize_list.sense","status":"draft"}],"status":"draft","variants":[]},"3e856465cc1a15a27d0e4bf3e5fe711e94adf2e0460812998a18b4a7e795b2a1":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from farewell, pay","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from farewell, pay","exampleIds":[],"headword":"far\u00d5\u00dfrev\u00df\u00d5","id":"shakespeare014.lex.parting_fee","ipa":"","label":"parting_fee","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"far\u0167h\u014drev\u014d\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A fee offered at leave-taking, figuratively the farewell kiss.","id":"shakespeare014.lex.parting_fee.sense","status":"draft"}],"status":"draft","variants":[]},"da851c4b6e288a3467c11ecfbb7f5e4659b01b61bb2ebd7d4f281e42508569b2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: broad + spear","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: broad + spear","exampleIds":[],"headword":"gimkintarven","id":"shakespeare014.lex.partisan_weapon","ipa":"","label":"partisan_weapon","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gimkintarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A broad-headed pole weapon, native broad-spear, contrasted with a useless reed. Distinct from a political adherent; no exact dimensions or fighting instructions are introduced.","id":"shakespeare014.lex.partisan_weapon.sense","status":"draft"}],"status":"draft","variants":[]},"0150f86385c5b51cc780a3b5f363c7699a6a58766cff32816575a02f899a616c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"partlet","id":"shakespeare014.lex.partlet_hen","ipa":"","label":"partlet_hen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"partlet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The traditional hen name Falstaff applies to the hostess.","id":"shakespeare014.lex.partlet_hen.sense","status":"draft"}],"status":"draft","variants":[]},"03d9b563ca4cdd7994ae5db5dbf7e1f583f0790240cd3aefd13083918525fed6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_partner_philemon","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_partner_philemon","exampleIds":[],"headword":"inst\u00dfb\u00dfs\u00dflum","id":"shakespeare014.lex.partner","ipa":"","label":"partner","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"inst\u014db\u014ds\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A person sharing an action, condition or experience; context distinguishes threatened shame from desired companionship in grief.","id":"shakespeare014.lex.partner.sense","status":"draft"}],"status":"draft","variants":[]},"8649a797f8889248242bdfba76b2f4593d3268ecd29211a1cfafb36a03d31aec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: quarrel + person","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: quarrel + person","exampleIds":[],"headword":"\u00e5\u00d1hefaks\u00dflum","id":"shakespeare014.lex.party_disputant","ipa":"","label":"party_disputant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ouchhefaks\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A party to a quarrel in the etiquette anecdote, not a political faction or festive gathering.","id":"shakespeare014.lex.party_disputant.sense","status":"draft"}],"status":"draft","variants":[]},"deae5171ec7c4f8b4a0d85396a4c39131e8df28e1c149e6a5867cfbfe8f16de3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: side","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: side","exampleIds":[],"headword":"vorel","id":"shakespeare014.lex.party_legal","ipa":"","label":"party_legal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A side in a legal dispute, not a political party or social gathering; may consist of more than one person.","id":"shakespeare014.lex.party_legal.sense","status":"draft"}],"status":"draft","variants":[]},"42692de266a5f24756e2488f6ca0cedd4f5583ee273d8b9da5219f8aa4f27150":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: step + thrust","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: step + thrust","exampleIds":[],"headword":"palenterastnerda\u00c3","id":"shakespeare014.lex.passado_fencing","ipa":"","label":"passado_fencing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"palenterastnerdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The fencing thrust with an advancing step that Armado says Cupid ignores.","id":"shakespeare014.lex.passado_fencing.sense","status":"draft"}],"status":"draft","variants":[]},"6e2efca948c057107421fe64a91f664a29fc1f0882a82b9397b23c3f93a54fa1":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from death, bell","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from death, bell","exampleIds":[],"headword":"n\u00d7nenzarviminolen","id":"shakespeare014.lex.passing_bell","ipa":"","label":"passing_bell","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u0113nenzarviminolen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The bell associated with a person approaching death, heard by the sick person; not a bell heard only after death.","id":"shakespeare014.lex.passing_bell.sense","status":"draft"}],"status":"draft","variants":[]},"0f2069073034834079f0e499d99da826e84fa77edc8cbb84e18d798cacfd44e0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of passion","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of passion","exampleIds":[],"headword":"sevarjor","id":"shakespeare014.lex.passionate_affect","ipa":"","label":"passionate_affect","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"sevarjor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Moved by strong emotion, the title of The Passionate Pilgrim; native passion-family adjective, not a phonetic rendering of a common English word.","id":"shakespeare014.lex.passionate_affect.sense","status":"draft"}],"status":"draft","variants":[]},"0b8ec757e5bb59b60166f3092f8e0952b924b1def830e46e5a0e0a27d8abd56d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: foot + joint","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: foot + joint","exampleIds":[],"headword":"paleskl\u00e1r\u00e7l\u00d7on","id":"shakespeare014.lex.pastern_joint","ipa":"","label":"pastern_joint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"paleskl\u00f4r\u016bl\u0113on","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The short part of a horse's leg immediately above the hoof.","id":"shakespeare014.lex.pastern_joint.sense","status":"draft"}],"status":"draft","variants":[]},"68d775b1af7fdc8d756e9948dfd0152c2c955ddadce04859f598d4767b60eafd":{"audioLinks":[],"citations":[{"locator":"Authored native compound: feed + person","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: feed + person","exampleIds":[],"headword":"wemars\u00dflum","id":"shakespeare014.lex.pastoral_feeder","ipa":"","label":"pastoral_feeder","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wemars\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"One who tends and feeds the flock, the source feeder in Corin\u2019s promise. Native feed + person; do not silently adopt another edition\u2019s factor or assert that Corin has already purchased the property.","id":"shakespeare014.lex.pastoral_feeder.sense","status":"draft"}],"status":"draft","variants":[]},"6eede4d98e860fb6e7f4f217e7817360c5e17cdb34ee7cee0dd2fbef2945ed14":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: shepherd + play","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: shepherd + play","exampleIds":[],"headword":"velngurjem\u00e3s\u00dflumfaln","id":"shakespeare014.lex.pastoral_genre","ipa":"","label":"pastoral_genre","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velngurjemois\u014dlumfaln","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The pastoral dramatic genre woven through Polonius's ornate list of mixed theatrical genres.","id":"shakespeare014.lex.pastoral_genre.sense","status":"draft"}],"status":"draft","variants":[]},"e482f8ad572b33e0e4638cdc395f2aafbbb7141ec3b3c033a194f5ca77f1ed2e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: grass + field","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: grass + field","exampleIds":[],"headword":"yelw\u00cfn\u00c7","id":"shakespeare014.lex.pasture_grazing","ipa":"","label":"pasture_grazing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yelw\u00cfn\u00e3","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Grazing ground covered with snow in the deer comparison, native grass-field.","id":"shakespeare014.lex.pasture_grazing.sense","status":"draft"}],"status":"draft","variants":[]},"4f301e22248469aacebe35e4ecafba27195e9c4506a93cf6cedd7bd66a81ea46":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"pate","id":"shakespeare014.lex.patay_field","ipa":"","label":"patay_field","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pate","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The battle Talbot names when he strips Fastolf of the Garter.","id":"shakespeare014.lex.patay_field.sense","status":"draft"}],"status":"draft","variants":[]},"5c0d1b1d80b2aac0c99d627e2d6546cefce3f21365c7adeb8a9b5bc74d4c5ecb":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of patch","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of patch","exampleIds":[],"headword":"felenthrenin","id":"shakespeare014.lex.patch_fabricate","ipa":"","label":"patch_fabricate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"felenthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Fabricate or piece together an excuse or quarrel, preserving the patchwork metaphor in the leaders\u2019 exchange. Not a literal repair to their clothing.","id":"shakespeare014.lex.patch_fabricate.sense","status":"draft"}],"status":"draft","variants":[]},"98ace4ac0aeeeb99f15e2c4e39d62e041eb2e7096ee0cf751c23fc6a90c3165f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: patch + make","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: patch + make","exampleIds":[],"headword":"felenthrenina\u00d9","id":"shakespeare014.lex.patch_repair","ipa":"","label":"patch_repair","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"felenthreninang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Repair with a patch, used of the political breach that must be mended with cloth of any color. Native patch-make preserves the textile expedient and does not assert literal sewing in the scene.","id":"shakespeare014.lex.patch_repair.sense","status":"draft"}],"status":"draft","variants":[]},"d0ccf8b73105fea5c80ccbb814ccfb225aa0a4895f73cd4d891df2f1a4a0f9cc":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: patch + leg","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: patch + leg","exampleIds":[],"headword":"felenthreninpal","id":"shakespeare014.lex.patchbreech_fishermans_nickname","ipa":"","label":"patchbreech_fishermans_nickname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"felenthreninpal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"Patch-leg. The patch on a trouser leg gives the Third Fisherman's clothing nickname.","id":"shakespeare014.lex.patchbreech_fishermans_nickname.sense","status":"draft"}],"status":"draft","variants":[]},"2126d60d57f364dc612c8a6b180f07d6d8d6c6c1a7ecd491491db43b82d752ec":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of charter","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of charter","exampleIds":[],"headword":"lamet\u00ddv","id":"shakespeare014.lex.patent_right","ipa":"","label":"patent_right","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamet\u012bv","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A granted title or right of possession in Sonnet 87; the love relationship is treated as a revocable legal grant, not an invention patent.","id":"shakespeare014.lex.patent_right.sense","status":"draft"}],"status":"draft","variants":[]},"a06020d09703e69806c2f7a6fcc19c3f2965cceaab5184ed270dee94eb018c66":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of passion","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of passion","exampleIds":[],"headword":"sevarjor","id":"shakespeare014.lex.pathetical_passion","ipa":"","label":"pathetical_passion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"sevarjor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Emotionally emphatic or impassioned, used mockingly in Rosalind\u2019s pathetical break-promise. Native passion modifier follows the impassioned reading; other editors suggest miserable/pitiful, so this is a recorded interpretive choice, not a claim of unanimity.","id":"shakespeare014.lex.pathetical_passion.sense","status":"draft"}],"status":"draft","variants":[]},"fb9e0cd66bc2bc714ea4fa23ab2c65e3b202678140971ddb49b3b37e294f55c3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: patience","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: patience","exampleIds":[],"headword":"br\u00c9hn","id":"shakespeare014.lex.patience_at_graves","ipa":"","label":"patience_at_graves","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"br\u00e4hn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"Pericles imagines personified Patience smiling at kings' graves. Distinct from the historical queen's attendant.","id":"shakespeare014.lex.patience_at_graves.sense","status":"draft"}],"status":"draft","variants":[]},"ddce5a3f6f7ee4c87a4ec0f92800ca3dc15a02676ec68edb992046c81c0d1b55":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: patience","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: patience","exampleIds":[],"headword":"br\u00c9hn","id":"shakespeare014.lex.patience_katherine_attendant","ipa":"","label":"patience_katherine_attendant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"br\u00e4hn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Katherine's attending woman bears the native virtue-name Patience. The dying woman calls on her to stay near.","id":"shakespeare014.lex.patience_katherine_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"ebe20c044f824500476d41a604cca9dccf7c344564d4ae9296aee9e005b9631d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: patience","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Authored native derivation or sense: patience","exampleIds":[],"headword":"br\u00c9hn","id":"shakespeare014.lex.patience_monument_figure","ipa":"","label":"patience_monument_figure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"br\u00e4hn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"The personification carved on a monument in Viola's account of her father's daughter.","id":"shakespeare014.lex.patience_monument_figure.sense","status":"draft"}],"status":"draft","variants":[]},"767be719a1e8acf55eeacf018145ee0a20e32f8aee6e9e56776174b7db1ebd3e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: ancestor + noble","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: ancestor + noble","exampleIds":[],"headword":"p\u00e1npalarven","id":"shakespeare014.lex.patrician_roman","ipa":"","label":"patrician_roman","notes":"","orth