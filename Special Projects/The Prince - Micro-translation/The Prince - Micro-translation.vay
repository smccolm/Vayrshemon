l question to his wife; reviewed native historical category, with no material or actual death asserted.","id":"shakespeare014.lex.coffin_container.sense","status":"draft"}],"status":"draft","variants":[]},"4767087ce8db3bdc507aff1182475e40b66f419bf1584126f24a6c69959e941e":{"audioLinks":[],"citations":[{"locator":"Authored native compound: metal + money","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: metal + money","exampleIds":[],"headword":"zarzarven","id":"shakespeare014.lex.coin_currency","ipa":"","label":"coin_currency","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An individual metal monetary token, native metal + money. Distinguishes a coin from an unbounded sum; its denomination is specified separately, including the source half-penny coins.","id":"shakespeare014.lex.coin_currency.sense","status":"draft"}],"status":"draft","variants":[]},"dbbfbae477306614e0728880c32b7432cd9282dfd49dbd635000faf21f135ce8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: coin_currency + make","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: coin_currency + make","exampleIds":[],"headword":"zarzarvena\u00d9","id":"shakespeare014.lex.coin_mint","ipa":"","label":"coin_mint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"zarzarvenang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Mint or produce as coins, figuratively lungs issuing words. Native coin-make keeps the monetary production image; not literal metal forming in the body.","id":"shakespeare014.lex.coin_mint.sense","status":"draft"}],"status":"draft","variants":[]},"9482a6e63c8757aec70893a128121cb625af7ec3b2e7c17beabd4a