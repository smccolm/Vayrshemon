"pronunciation":"mikael","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Given name by which Buckingham identifies the monk of the Chartreux.","id":"shakespeare014.lex.michael_hopkins_monk.sense","status":"draft"}],"status":"draft","variants":[]},"3dbb6e15f2d73e43e885bd9f6429fbb352afb516545d59a00755877b677a2199":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"mikael","id":"shakespeare014.lex.michael_rebel","ipa":"","label":"michael_rebel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"mikael","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The man who comes to warn Cade of the approach of the Stafford brothers.","id":"shakespeare014.lex.michael_rebel.sense","status":"draft"}],"status":"draft","variants":[]},"0d6d3b08f16bcc80523ac38e9b7a191b2fa1f17d304498a34128314e665fd3b7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"mikel","id":"shakespeare014.lex.michael_williams","ipa":"","label":"michael_williams","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"mikel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"English soldier who disputes the king's assurance of his cause.","id":"shakespeare014.lex.michael_williams.sense","status":"draft"}],"status":"draft","variants":[]},"3354da104241ce8736700cbc56dfb287692c01c5d22ceacea7cc602aff5b3636":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"maikel","id":"shakespeare014.lex.michael_york","ipa":"","label":"michael_york","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"maikel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"Sir Michael, the Archbishop of York's messenger. Not the archangel in the feast name.","id":"shakespeare014.lex.michael_york.sense","status":"draft"}],"status":"draft","variants":[]},"1aa9343efb42063864513e88cb4ad5aa1edccbc601ebaceeced44d9c558185bb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: kjv_michael_jude_archangel + feast","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: kjv_michael_jude_archangel + feast","exampleIds":[],"headword":"mikaely\u00e9\u00dbna","id":"shakespeare014.lex.michaelmas_feast","ipa":"","label":"michaelmas_feast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mikaely\u00e9shna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"Feast of the archangel Michael. Simple confuses its place in the calendar relative to Allhallowmas.","id":"shakespeare014.lex.michaelmas_feast.sense","status":"draft"}],"status":"draft","variants":[]},"1b0df47f1b08aa94ba0585ecfe603d7c87ffa6f8fc84a24de6c2f8f29813fb8e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: small + world","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: small + world","exampleIds":[],"headword":"viminjo\u00d9ol","id":"shakespeare014.lex.microcosm_person","ipa":"","label":"microcosm_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminjongol","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The person as a little world, whose facial map Menenius invites the tribunes to inspect. Not a literal model planet or an English/Greek ordinary loan.","id":"shakespeare014.lex.microcosm_person.sense","status":"draft"}],"status":"draft","variants":[]},"499e8c1510f390ac297146017612c3398f023d1cc11d8884db57bd5380f56298":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"midas","id":"shakespeare014.lex.midas_gold_touch","ipa":"","label":"midas_gold_touch","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"midas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"definition":"The king whose golden touch makes gold hard food in Bassanio's deliberation.","id":"shakespeare014.lex.midas_gold_touch.sense","status":"draft"}],"status":"draft","variants":[]},"cd5c5b1ce665d904d15905355dad4e16c0ec2daf1e9dbddd3314dcc62f8052dd":{"audioLinks":[],"citations":[{"locator":"Authored native compound: so + so","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: so + so","exampleIds":[],"headword":"komkom","id":"shakespeare014.lex.middling_so","ipa":"","label":"middling_so","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"komkom","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Middling or adequate, a colloquial repeated native so expression authored for William\u2019s uncertain wealth and Touchstone\u2019s reply. The repeated so stem also permits the echo of exactly so; this local idiom is a declared adaptation, not independent attestation of the source English pun.","id":"shakespeare014.lex.middling_so.sense","status":"draft"}],"status":"draft","variants":[]},"228a75bcc6623bdf84f0fa4033f229aee9a1042ba7b8a8df1e94e0760d833a36":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"milan","id":"shakespeare014.lex.milan_legate_city","ipa":"","label":"milan_legate_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"milan","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"The city attached to Pandulph's title as cardinal.","id":"shakespeare014.lex.milan_legate_city.sense","status":"draft"}],"status":"draft","variants":[]},"85da5b82d6b56c0da07b807b305f405aaaaee31c9c5189e26065d0d0fcc92e21":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"milford","id":"shakespeare014.lex.milford_place","ipa":"","label":"milford_place","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"milford","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The place in Milford Haven. The harbour element is translated with the established native word for a sheltered landing place.","id":"shakespeare014.lex.milford_place.sense","status":"draft"}],"status":"draft","variants":[]},"f07aaed7150883f5530168167ac9a8f8a1df14dbb19cc0df207801c3bc3386a0":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"hefalin","id":"shakespeare014.lex.military_camp","ipa":"","label":"military_camp","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefalin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"An army\u2019s temporary camp. New short native place noun motivated by hefak (war), distinct from the older multiword camping verb and hefar (courage).","id":"shakespeare014.lex.military_camp.sense","status":"draft"}],"status":"draft","variants":[]},"f0250cf9d773ca75e6b483b7e4ff0e6e1a585d5f6666652bc554c4f77ae26e26":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of file","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of file","exampleIds":[],"headword":"nor\u00d3ajer","id":"shakespeare014.lex.military_file","ipa":"","label":"military_file","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"northajer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An ordered file of soldiers in Philo\u2019s opening comparison; not a document or computer file.","id":"shakespeare014.lex.military_file.sense","status":"draft"}],"status":"draft","variants":[]},"d57c21201ba18c65d25a0dda1e651fa59d75f257191e4b3a45aedb1aa45ffeb8":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: under + commander","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: under + commander","exampleIds":[],"headword":"grelnor\u00d3as\u00dflum","id":"shakespeare014.lex.military_lieutenant","ipa":"","label":"military_lieutenant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grelnorthas\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A commander\u2019s subordinate or deputy, Sossius in the Syria example. Native under-commander, distinct from a modern commissioned pay grade or a provincial governor imported from Esther.","id":"shakespeare014.lex.military_lieutenant.sense","status":"draft"}],"status":"draft","variants":[]},"e600fe76a76d316646085d4b0a84494e31cabd0d1734daf2b77435c9b9c6d2b8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of muster","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of muster","exampleIds":[],"headword":"hefak gurs\u00dflumz\u00dfgu\u00d9","id":"shakespeare014.lex.military_muster","ipa":"","label":"military_muster","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlumz\u014dgung","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An assembled body or review of troops in Antony and Cleopatra 1.1; not an unstated headcount.","id":"shakespeare014.lex.military_muster.sense","status":"draft"}],"status":"draft","variants":[]},"49af4c752e4c6575cf093e32e42e44d9a96a9933fbf077e71a483f76eece66f0":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_guard_rank","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_guard_rank","exampleIds":[],"headword":"hefak gurs\u00dflumjer","id":"shakespeare014.lex.military_rank_row","ipa":"","label":"military_rank_row","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefak gurs\u014dlumjer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An ordered rank of soldiers, the well-paid force Ventidius credits to Antony. Native soldier-row, not a grade of social prestige, a rotten smell or a new headcount.","id":"shakespeare014.lex.military_rank_row.sense","status":"draft"}],"status":"draft","variants":[]},"c89ffbb52063da665febceb8b5258690e269f26cdc71dfc90294553f0e93c1ff":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of stir","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of stir","exampleIds":[],"headword":"da\u00c3","id":"shakespeare014.lex.military_stirring","ipa":"","label":"military_stirring","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Pompey\u2019s movement into military opposition, which he boasts can draw Antony from Egypt. Not stirring a liquid or an invented count of rebellions.","id":"shakespeare014.lex.military_stirring.sense","status":"draft"}],"status":"draft","variants":[]},"9803918f0761a4d8519152ec217cfae3ad31fb84a13e1d5fa0ad34a68a037e8b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: milk + curdle","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: milk + curdle","exampleIds":[],"headword":"melatmelkorgim\u00cba\u00d5","id":"shakespeare014.lex.milk_curd_food","ipa":"","label":"milk_curd_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melatmelkorgimhwa\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The milk curds in Camillo's title for Perdita, queen of curds and cream.","id":"shakespeare014.lex.milk_curd_food.sense","status":"draft"}],"status":"draft","variants":[]},"062fcf549660a3a613bc7191cbc4f0bb3e098b1a39671ff5293dbfd4ece9c960":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of milk","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of milk","exampleIds":[],"headword":"melat","id":"shakespeare014.lex.milk_draw","ipa":"","label":"milk_draw","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Draw milk from an animal. Reviewed verbal conversion of the native milk noun; no processing method or measure is added.","id":"shakespeare014.lex.milk_draw.sense","status":"draft"}],"status":"draft","variants":[]},"3c34311d0dd62e3f18d5bdedf21146d05720b08a65d2d468251eafde9cd291bb":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of milk","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of milk","exampleIds":[],"headword":"melat","id":"shakespeare014.lex.milk_extract","ipa":"","label":"milk_extract","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"melat","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Draw milk from an animal, the ordinary labour in Cleopatra\u2019s comparison with a lowly maid. Verbal extension of the native substance word; not extracting money or feeding milk to a child.","id":"shakespeare014.lex.milk_extract.sense","status":"draft"}],"status":"draft","variants":[]},"178e1d0fa4b75e4edff19c92f3b37f422efe1ab0c2b22eb4ca5c8e0a946e6bb7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_mill","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_mill","exampleIds":[],"headword":"thengr\u00c9trul","id":"shakespeare014.lex.mill_grinding","ipa":"","label":"mill_grinding","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thengr\u00e4trul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A grain-grinding mill near the city, without inventing water, wind or animal power for the unspecified mills.","id":"shakespeare014.lex.mill_grinding.sense","status":"draft"}],"status":"draft","variants":[]},"2ba3b83091edb64cb0de537bd878284382f5991d0684f5f9815355169a4a8af0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: mill_grinding + keeper","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: mill_grinding + keeper","exampleIds":[],"headword":"thengr\u00c9truljem\u00e3s\u00dflum","id":"shakespeare014.lex.miller_yed_surname","ipa":"","label":"miller_yed_surname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"thengr\u00e4truljemois\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"Yed's occupational surname for the seller of Slender's game coins.","id":"shakespeare014.lex.miller_yed_surname.sense","status":"draft"}],"status":"draft","variants":[]},"a2415a6cefd92cadcb754a2131302bd14db8c9029d1c282edd50c4909e97eca5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: glove + sell","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: glove + sell","exampleIds":[],"headword":"tremb\u00c5rfelen\u00e3\u00d1t","id":"shakespeare014.lex.milliner_small_wares","ipa":"","label":"milliner_small_wares","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tremb\u0101rfelenoicht","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"A dealer in fine small wares. The Servant compares the fit of songs with the fit of this dealer's gloves.","id":"shakespeare014.lex.milliner_small_wares.sense","status":"draft"}],"status":"draft","variants":[]},"1ce395a2a7ededde26ede934466d411b9828088e2a23ae8eedf49930a1d546d7":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"milon","id":"shakespeare014.lex.milo_bull_bearing_athlete","ipa":"","label":"milo_bull_bearing_athlete","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"milon","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"definition":"Bull-bearing athlete whose title Ulysses would award to Ajax.","id":"shakespeare014.lex.milo_bull_bearing_athlete.sense","status":"draft"}],"status":"draft","variants":[]},"9aed164c27e800f96e39d98a913957c9e5f0b05ff30076a53bd760f1e965eed6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_mineral_vein","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_mineral_vein","exampleIds":[],"headword":"zarmarjo\u00d9","id":"shakespeare014.lex.mine_resource","ipa":"","label":"mine_resource","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarmarjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A worked mineral source, used of Antony as an inexhaustible store of generosity. The native metal-path image preserves extraction and abundance, distinct from possessive mine.","id":"shakespeare014.lex.mine_resource.sense","status":"draft"}],"status":"draft","variants":[]},"487ee0662ddbc87561e357cdc5281aeb496ea401e1603b1500fd99c82c82d864":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"minerva","id":"shakespeare014.lex.minerva_goddess","ipa":"","label":"minerva_goddess","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"minerva","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The upright goddess in Iachimo\u2019s description of the men's claims about beauty in Italy.","id":"shakespeare014.lex.minerva_goddess.sense","status":"draft"}],"status":"draft","variants":[]},"0a0f06c837ece037bc8f01d89c2a34cd35a623435a5cdbf860406df14c921df9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: music + rest","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: music + rest","exampleIds":[],"headword":"valemdlen","id":"shakespeare014.lex.minim_music_rest","ipa":"","label":"minim_music_rest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"valemdlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"A written rest in Mercutio's parody of Tybalt keeping musical time as he fences.","id":"shakespeare014.lex.minim_music_rest.sense","status":"draft"}],"status":"draft","variants":[]},"7f0582f7c522a6a7f61d45d02cfe5b05565700f1e76d0aaf5ceec7cc02971510":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_minister","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_minister","exampleIds":[],"headword":"m\u00d7sd\u00c7v","id":"shakespeare014.lex.minister_agent","ipa":"","label":"minister_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u0113sd\u00e3v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An assisting agent, Caesar\u2019s claim that the gods make him and Octavia\u2019s friends their ministers of justice. No clerical or modern cabinet office, and the claim remains his rhetoric.","id":"shakespeare014.lex.minister_agent.sense","status":"draft"}],"status":"draft","variants":[]},"671ca9c71b1c8f5ea45957a861a45d185768c896ecbd162edec42b34ee1ed2f5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: small + fish_creature","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: small + fish_creature","exampleIds":[],"headword":"vimindrig\u00e1l","id":"shakespeare014.lex.minnow_smallfish","ipa":"","label":"minnow_smallfish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vimindrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The little fish under the mock Triton\u2019s rule, native small-fish category. Preserves the scale contrast without claiming a modern taxonomic species.","id":"shakespeare014.lex.minnow_smallfish.sense","status":"draft"}],"status":"draft","variants":[]},"d6d08871fb8fd2bc6d7de8091b2fbeb03f89603bd390f1d3e1b686720f195057":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"minola","id":"shakespeare014.lex.minola_paduan_family","ipa":"","label":"minola_paduan_family","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"minola","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"Surname of the Paduan household.","id":"shakespeare014.lex.minola_paduan_family.sense","status":"draft"}],"status":"draft","variants":[]},"116d3573ecd39ed00636265414db35156618f8b0040bf05e352fbfb279de21d0":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"minos","id":"shakespeare014.lex.minos_king","ipa":"","label":"minos_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"minos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The king who barred the fliers' course, corresponding in Henry's speech to Richard's father.","id":"shakespeare014.lex.minos_king.sense","status":"draft"}],"status":"draft","variants":[]},"5a524fbac1bdc980afa70b722c5b5e03a4b85cd7a7c3dc50f08b771221b768f5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"minotar","id":"shakespeare014.lex.minotaur_labyrinth","ipa":"","label":"minotaur_labyrinth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"minotar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The mythical creature, used in the plural for dangers in Suffolk's imagined labyrinth.","id":"shakespeare014.lex.minotaur_labyrinth.sense","status":"draft"}],"status":"draft","variants":[]},"f3d3d10d8dd3788aea4e91a4bb50451bbe5304b4bf1a037098cc6a8791ab49eb":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_minstrel","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_minstrel","exampleIds":[],"headword":"valems\u00dflum","id":"shakespeare014.lex.minstrel","ipa":"","label":"minstrel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"valems\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A music performer seeking feasts as occasions to entertain; the source supplies the circumstances, no instrument is invented.","id":"shakespeare014.lex.minstrel.sense","status":"draft"}],"status":"draft","variants":[]},"31773742d56f35a0ba65928c442eb29499dbb9f4f8f3d2961b11805eaab9abfc":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"miranda","id":"shakespeare014.lex.miranda_prospero_daughter","ipa":"","label":"miranda_prospero_daughter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"miranda","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"Prospero's daughter, raised on the island.","id":"shakespeare014.lex.miranda_prospero_daughter.sense","status":"draft"}],"status":"draft","variants":[]},"02ef540d07e89116c1ae18ad78b4a13325fef95de145c2de3caae5baf931a0d9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_mirror","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_mirror","exampleIds":[],"headword":"o\u00c3ub\u00e1nt\u00e9v","id":"shakespeare014.lex.mirror","ipa":"","label":"mirror","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ojzhub\u00f4nt\u00e9v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A reflecting surface for viewing oneself, the eyes\u2019 looking-glass metaphor; no new physical glass material is required.","id":"shakespeare014.lex.mirror.sense","status":"draft"}],"status":"draft","variants":[]},"67a72a64e9c319fe37fd3747acc55d9d57345c7f8c696c93aa8ec381705dca20":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: human + hate","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"etymology":"Authored native derivation or sense: human + hate","exampleIds":[],"headword":"s\u00dflumvehen","id":"shakespeare014.lex.misanthropos_timon_byname","ipa":"","label":"misanthropos_timon_byname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"s\u014dlumvehen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.timon-of-athens.r1"}],"definition":"The name Timon gives himself in the woods, translated by its Greek sense. It is a self-description of the Athenian Timon.","id":"shakespeare014.lex.misanthropos_timon_byname.sense","status":"draft"}],"status":"draft","variants":[]},"f2139e064279506bba5f38afc4405566015a60578f1b811cb7a5ab186926f6d9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_mischief","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_mischief","exampleIds":[],"headword":"murend\u00c7\u00d3","id":"shakespeare014.lex.mischief_harm","ipa":"","label":"mischief_harm","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murend\u00e3th","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Harm or destructive wrongdoing acknowledged toward the Volsces. Reviewed native evil-work, not harmless play or a modern misdemeanor category.","id":"shakespeare014.lex.mischief_harm.sense","status":"draft"}],"status":"draft","variants":[]},"f8411e461d62fb1c5f7e6638213a3d500f1e08d5d7990de00612ea21abd435fc":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: false + understand","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: false + understand","exampleIds":[],"headword":"dlenh\u00c5b\u00cdpom","id":"shakespeare014.lex.misconstrue","ipa":"","label":"misconstrue","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dlenh\u0101b\u0117rpom","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Twist or misread another\u2019s meaning, the ill-wresting world of Sonnet 140; no physical wrestling match is introduced.","id":"shakespeare014.lex.misconstrue.sense","status":"draft"}],"status":"draft","variants":[]},"69f552dfdc0c934d32982aa8a42171d0ae49aab888aa26f01ee36e03762493f9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"misena","id":"shakespeare014.lex.misena_mount","ipa":"","label":"misena_mount","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"misena","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Mount Misena as named in the supplied text. Preserve this place form without silently substituting a modern map name.","id":"shakespeare014.lex.misena_mount.sense","status":"draft"}],"status":"draft","variants":[]},"81510752db198b60535e6dc36cb72dbad52feb753794e279fc2c12ea6d832fa1":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: miserly + person","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: miserly + person","exampleIds":[],"headword":"f\u00c5wjem\u00e3s\u00dflum","id":"shakespeare014.lex.miser","ipa":"","label":"miser","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u0101wjemois\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"One guarding possessions with reluctance to part, the troubled owner in Sonnet 75; distinct from simply being poor.","id":"shakespeare014.lex.miser.sense","status":"draft"}],"status":"draft","variants":[]},"e30ab869d441767260cc5f4bc7f1494882fd4a838414edcaf12a4c1e5cee1935":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: give + keep","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: give + keep","exampleIds":[],"headword":"f\u00c5wjem\u00e3","id":"shakespeare014.lex.miserly","ipa":"","label":"miserly","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"f\u0101wjemoi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Reluctant to part with what one holds; native give-keep lexicalization in the miserly/prodigal paradox.","id":"shakespeare014.lex.miserly.sense","status":"draft"}],"status":"draft","variants":[]},"f3f65da9a4cb81abba4ba1f330e2776032128021a0fc7fcb23a3fda230ab61fc":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from bad, chance","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from bad, chance","exampleIds":[],"headword":"murvengraf","id":"shakespeare014.lex.mishap","ipa":"","label":"mishap","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murvengraf","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An adverse accident or chance event, distinct from a deliberate offence.","id":"shakespeare014.lex.mishap.sense","status":"draft"}],"status":"draft","variants":[]},"75b8d51f3efcd3222ffb3b5e13114cf9e343aba5bc2547cba2091d3ae1e47663":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: false + show","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: false + show","exampleIds":[],"headword":"dlengl\u00c9st","id":"shakespeare014.lex.misrepresent","ipa":"","label":"misrepresent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dlengl\u00e4st","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Represent inaccurately, the flattering false comparisons applied to women in Sonnet 130; does not accuse the represented women of lying.","id":"shakespeare014.lex.misrepresent.sense","status":"draft"}],"status":"draft","variants":[]},"2f281006933bb05d56351b5e01fcef961bd955241d9f8c4954d268630102109c":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: bad + rule","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: bad + rule","exampleIds":[],"headword":"murvar\u00dfnen","id":"shakespeare014.lex.misrule","ipa":"","label":"misrule","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murvar\u014dnen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Bad exercise of authority, not absence of government or a specific historical festival.","id":"shakespeare014.lex.misrule.sense","status":"draft"}],"status":"draft","variants":[]},"03ca0ff4a1819af9dc87989321f7057a293ddbcbb65bb25da2dd1d8c523da268":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_mist","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed cont