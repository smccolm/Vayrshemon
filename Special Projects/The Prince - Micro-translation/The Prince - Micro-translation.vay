ical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"The younger Siward killed onstage by Macbeth. His given role title includes the explicit young.","id":"shakespeare014.lex.siward_younger_son.sense","status":"draft"}],"status":"draft","variants":[]},"c75e537669b5fb9a25bd60142fbca3c6a1197d77346a4b5d9206acb3b4fb95f2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: skin + swell","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: skin + swell","exampleIds":[],"headword":"shalemniragum","id":"shakespeare014.lex.skin_blister","ipa":"","label":"skin_blister","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"shalemniragum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"A raised swelling of the skin. Hamlet imagines it replacing the rose on the forehead of innocent love.","id":"shakespeare014.lex.skin_blister.sense","status":"draft"}],"status":"draft","variants":[]},"1f21bc3bdd20b802e733f478838086774ec5255ec5eecb37b63839253d5ef934":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: head + bone","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: head + bone","exampleIds":[],"headword":"harenkran","id":"shakespeare014.lex.skull_bone","ipa":"","label":"skull_bone","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"harenkran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The bony enclosure of the head, imagined as a single container for all the citizens\u2019 divergent wits; no actual anatomical experiment is asserted.","id":"shakespeare014.lex.skull_bone.sense","status":"draft"}],"status":"draft","variants":[]},"00ab562c8dc35af682fb4331a94591cab32983e474ccc76838ea2db1e6882315":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_slack","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_slack","exampleIds":[],"headword":"vimjw\u00ebn","id":"shakespeare014.lex.slack_effort","ipa":"","label":"slack_effort","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"vimjw\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Lax in effort or readiness, Antony\u2019s response to the rebuke about speed. Not a slack rope or a literal absence of muscle strength.","id":"shakespeare014.lex.slack_effort.sense","status":"draft"}],"status":"draft","variants":[]},"0fc80d3e79c6be7a09b79c173fe691e5320960af17026064ffb2514564d39169":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_slaughter","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_slaughter","exampleIds":[],"headword":"gim\u00dfvgrij","id":"shakespeare014.lex.slaughter","ipa":"","label":"slaughter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gim\u014dvgrij","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Kill violently, in the painter\u2019s war scene; no extra tally of victims supplied.","id":"shakespeare014.lex.slaughter.sense","status":"draft"}],"status":"draft","variants":[]},"b02370a0fbaf839bb386a5311e52c248041b68431662565328c0c771e7c02a28":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: kill + house","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: kill + house","exampleIds":[],"headword":"grijz\u00e1l","id":"shakespeare014.lex.slaughterhouse","ipa":"","label":"slaughterhouse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grijz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A place equipped for slaughter; explicitly denied of the bedroom in the poem.","id":"shakespeare014.lex.slaughterhouse.sense","status":"draft"}],"status":"draft","variants":[]},"088b1ededad81018c0244b09f8ce99b0f5f97d5b78e5308737c83f21d742c709":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: thin","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: thin","exampleIds":[],"headword":"thirilin","id":"shakespeare014.lex.slender_shallow_kinsman","ipa":"","label":"slender_shallow_kinsman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"thirilin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The telling surname of Shallow's young kinsman.","id":"shakespeare014.lex.slender_shallow_kinsman.sense","status":"draft"}],"status":"draft","variants":[]},"27072297e53ae00786a5396a95f76821589af0ce77c528bd15377609aaa20e50":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of slime_river_mud","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of slime_river_mud","exampleIds":[],"headword":"mul","id":"shakespeare014.lex.slime_residue","ipa":"","label":"slime_residue","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A moist viscous residue the guard attributes to the asp on fig leaves and cave surfaces. Extended from native wet mud; the attribution remains a character\u2019s observation, not zoological certification.","id":"shakespeare014.lex.slime_residue.sense","status":"draft"}],"status":"draft","variants":[]},"a0e18c66556e90c16b3a9305530a0621f4fb0dda8ae394ffdd97a51b4c21df76":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of mud","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of mud","exampleIds":[],"headword":"mul","id":"shakespeare014.lex.slime_river_mud","ipa":"","label":"slime_river_mud","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The moist river mud of the Nile in the oath about life arising from it; not Biblical earth-pitch sealant.","id":"shakespeare014.lex.slime_river_mud.sense","status":"draft"}],"status":"draft","variants":[]},"7578326dfb07098382f8bf0ec418b4ea284b2c9a74b93f1ec15e0c8490043ad3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: wet + smooth","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: wet + smooth","exampleIds":[],"headword":"yems\u00d7siv\u00ebl","id":"shakespeare014.lex.slimy_surface","ipa":"","label":"slimy_surface","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"yems\u0113siv\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Wet slippery coating on a surface, here fish jaws. Distinct from river mud and the historical earth-pitch sense of slime.","id":"shakespeare014.lex.slimy_surface.sense","status":"draft"}],"status":"draft","variants":[]},"709844c26a63745aa24b4f6aaf500cccad8e04424aca45db800f86dc1d8aca83":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: false + coin_currency","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: false + coin_currency","exampleIds":[],"headword":"dlenzarzarven","id":"shakespeare014.lex.slip_false_coin","ipa":"","label":"slip_false_coin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlenzarzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"The slip as a counterfeit coin. Mercutio also uses it for Romeo slipping away.","id":"shakespeare014.lex.slip_false_coin.sense","status":"draft"}],"status":"draft","variants":[]},"51dc6f1c8facc6572ef0420af68bcf05ca630ac08d6df0357aaf725991ba9abc":{"audioLinks":[],"citations":[{"locator":"Authored native compound: soft + shoe","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: soft + shoe","exampleIds":[],"headword":"melpalin","id":"shakespeare014.lex.slipper_shoe","ipa":"","label":"slipper_shoe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melpalin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Soft easily worn footwear, native soft + shoe, worn by the stage old man. No material or indoor location is added.","id":"shakespeare014.lex.slipper_shoe.sense","status":"draft"}],"status":"draft","variants":[]},"d75fb62da882538400980d14ef1dcf176561377d0c909e678c71515f038b5d75":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: slip","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: slip","exampleIds":[],"headword":"verzetpel","id":"shakespeare014.lex.slippery_unstable","ipa":"","label":"slippery_unstable","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"verzetpel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Unstable and liable to slip, figuratively the world\u2019s reversals of friendship and enmity. Native slip as a modifier; no claim that an actual floor is wet.","id":"shakespeare014.lex.slippery_unstable.sense","status":"draft"}],"status":"draft","variants":[]},"039f6e1b5a33b934f58063b1314848eb4f56899808674a76ec7ed948bb302a19":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: loose + kjv_hosen","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: loose + kjv_hosen","exampleIds":[],"headword":"maserf\u00c5wpalvelvor","id":"shakespeare014.lex.slops_breeches","ipa":"","label":"slops_breeches","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"maserf\u0101wpalvelvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The loose breeches for which Falstaff wants satin.","id":"shakespeare014.lex.slops_breeches.sense","status":"draft"}],"status":"draft","variants":[]},"48ef7952a47388bdb5e8af24013d0047d3178aa8cc2907456cd6312d72c9fda5":{"audioLinks":[],"citations":[{"locator":"Authored native compound: dirty + manner","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: dirty + manner","exampleIds":[],"headword":"murmayatf\u00c7l","id":"shakespeare014.lex.slovenliness","ipa":"","label":"slovenliness","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murmayatf\u00e3l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Dirty or careless habits, native dirty + manner. Retains Touchstone\u2019s distinction from plain looks rather than automatically translating the insult as sexual misconduct.","id":"shakespeare014.lex.slovenliness.sense","status":"draft"}],"status":"draft","variants":[]},"f19c7917651e80c65a76dfa95466e46f1991d3c7992e245cdde5847c03fc3de4":{"audioLinks":[],"citations":[{"locator":"Authored native compound: dirty + woman","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: dirty + woman","exampleIds":[],"headword":"murmayatsalena","id":"shakespeare014.lex.slovenly_woman","ipa":"","label":"slovenly_woman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murmayatsalena","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A dirty or careless woman in the foul/slut distinction. Native dirty + woman; no prostitution or specific sexual act is asserted.","id":"shakespeare014.lex.slovenly_woman.sense","status":"draft"}],"status":"draft","variants":[]},"0b546a03478294f1c3e074acb95c1b4c3ec70d331791e4c218a6cc5a980ca0ef":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_sluice","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_sluice","exampleIds":[],"headword":"yems\u00d7daral","id":"shakespeare014.lex.sluice","ipa":"","label":"sluice","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113daral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A gate or passage controlling water, metaphorically lowered eyelids restraining tears.","id":"shakespeare014.lex.sluice.sense","status":"draft"}],"status":"draft","variants":[]},"6cf03b076a0335277ddcc484397e31bf2dc49ecab75790651bb5cc24ca6f3a60":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: town + guard","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: town + guard","exampleIds":[],"headword":"z\u00e1lagurjemek","id":"shakespeare014.lex.sly_headborough_officer","ipa":"","label":"sly_headborough_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurjemek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The local officer whom the hostess goes to fetch. Shares the office word used for Verges.","id":"shakespeare014.lex.sly_headborough_officer.sense","status":"draft"}],"status":"draft","variants":[]},"82bbf13e51edc3dbc5ff98c93f8bf8027c7413d2d6e832c6a62dba2d221d4d0c":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cunning","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Authored native derivation or sense: cunning","exampleIds":[],"headword":"h\u00c5b\u00cdmemna","id":"shakespeare014.lex.sly_tinker_family","ipa":"","label":"sly_tinker_family","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"h\u0101b\u0117rmemna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The tinker's speaking surname is the native word for cunning.","id":"shakespeare014.lex.sly_tinker_family.sense","status":"draft"}],"status":"draft","variants":[]},"8d3f7e381aed34315a4cb5c0f20f12d59876e73c5ba3e63e458e6cd064286f9d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: small + ship","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: small + ship","exampleIds":[],"headword":"viminmeran","id":"shakespeare014.lex.small_cargo_ship","ipa":"","label":"small_cargo_ship","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminmeran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Belarius compares melancholy to a slow small trading craft searching for a coast and harbour.","id":"shakespeare014.lex.small_cargo_ship.sense","status":"draft"}],"status":"draft","variants":[]},"250a1dedbb3470faa