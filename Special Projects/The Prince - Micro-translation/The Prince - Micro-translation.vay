.source.antony-and-cleopatra.r1"}],"definition":"The ceremonial cloth shelter around Cleopatra on the barge, explicitly cloth-of-gold in the source. Not a permanent building or a medical tissue.","id":"shakespeare014.lex.pavilion_ceremonial.sense","status":"draft"}],"status":"draft","variants":[]},"76b15a4378a51b3aebfc2e2aebe00533e0d61fa3ca3c6fa3585a9b365ec7a5af":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: beast + foot","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: beast + foot","exampleIds":[],"headword":"\u00d5\u00dfrvorpales","id":"shakespeare014.lex.paw","ipa":"","label":"paw","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u0167h\u014drvorpales","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"An animal foot including its claws in the lion image; native beast-foot, not a human hand.","id":"shakespeare014.lex.paw.sense","status":"draft"}],"status":"draft","variants":[]},"051d36ba95ea87fc6e953e16931901c53415b8b002e896f8c2a580ad21404f73":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: peace + kiss","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: peace + kiss","exampleIds":[],"headword":"lamenmelomi","id":"shakespeare014.lex.pax_church","ipa":"","label":"pax_church","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamenmelomi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"A liturgical object kissed as a sign of peace. Pistol says Bardolph is sentenced to hang for stealing one from a church.","id":"shakespeare014.lex.pax_church.sense","status":"draft"}],"status":"draft","variants":[]},"b15d80be21a19e658ed831edaecfcf1a4d18aa6e2a67de99081ac486e5695632":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of pay","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of pay","exampleIds":[],"headword":"v\u00df\u00d5","id":"shakespeare014.lex.payment","ipa":"","label":"payment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"v\u014d\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Something given as a fee or recompense, including the reciprocal pardon metaphor in Sonnet 120; no unprinted price or currency is supplied.","id":"shakespeare014.lex.payment.sense","status":"draft"}],"status":"draft","variants":[]},"bc2e3b3423f4e426a7492690a489877bace5d34ae2e7094ce49e56f0de826f5b":{"audioLinks":[],"citations":[{"locator":"Authored native compound: round + seed + cover","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: round + seed + cover","exampleIds":[],"headword":"olenp\u00e1inshalen","id":"shakespeare014.lex.pea_pod_native","ipa":"","label":"pea_pod_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"olenp\u00f4inshalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The pea-pod used as a surrogate beloved in Touchstone\u2019s story. Native round + seed + cover is a lexicalized plant category, not all round-seed coverings. The odd taking of two pods from this personification is retained rather than silently corrected into peas or an added plant.","id":"shakespeare014.lex.pea_pod_native.sense","status":"draft"}],"status":"draft","variants":[]},"579683f49214486523539208d5ccd62222ddc98a1d160fa58553a6de21ca1884":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: peace + make + person","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored na