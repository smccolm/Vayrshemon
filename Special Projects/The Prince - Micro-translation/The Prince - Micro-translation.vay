on","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Short name for Junius Brutus in Lucrece; not automatically identified with another play\u2019s Brutus.","id":"shakespeare014.lex.brutus_lucrece.sense","status":"draft"}],"status":"draft","variants":[]},"6c3ad2e1e9034919cbb57cf0f8b4dab5bdd0f444ca12a922b4735e07f69bad43":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"brutus","id":"shakespeare014.lex.brutus_tribune_short","ipa":"","label":"brutus_tribune_short","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"brutus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Short speaker form of Junius Brutus in Coriolanus, not the assassin Marcus Brutus; the identity distinction is internal only.","id":"shakespeare014.lex.brutus_tribune_short.sense","status":"draft"}],"status":"draft","variants":[]},"97390c8f364a9e3df498694d2ae314a76a14393025cb7a878f8eb10802810f5b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: wash + kjv_basket","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: wash + kjv_basket","exampleIds":[],"headword":"yemyatthiravborel","id":"shakespeare014.lex.buck_basket_laundry","ipa":"","label":"buck_basket_laundry","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yemyatthiravborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"Laundry basket into which Falstaff climbs. The audible buck/deer pun belongs to the subsequent exchange with Ford.","id":"shakespeare014.lex.buck_basket_laundry.sense","status":"draft"}],"status":"draft","va