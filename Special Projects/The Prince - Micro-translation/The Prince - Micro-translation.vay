":[]},"b2275bff3a02d0ea974bc6e8160a98dc65fd3720d72231607da90be3c7ff2f4d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"breisi","id":"shakespeare014.lex.bracy_knight","ipa":"","label":"bracy_knight","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"breisi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The messenger from King Henry, distinct from Sir John Falstaff.","id":"shakespeare014.lex.bracy_knight.sense","status":"draft"}],"status":"draft","variants":[]},"8192d4ffdd54eabfead3e18ca2dc10a98d84fba48409467ff9cff51db8e4eb7f":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from hair, weave","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from hair, weave","exampleIds":[],"headword":"f\u00eblthirav","id":"shakespeare014.lex.braid","ipa":"","label":"braid","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"f\u00fclthirav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Interlace hair in a braid, here the hanging mane.","id":"shakespeare014.lex.braid.sense","status":"draft"}],"status":"draft","variants":[]},"678bcef0d36f09101b95595d485ab499c485bdf7049bd99bb6d79b75acf60941":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: brain + skin","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: brain + skin","exampleIds":[],"headword":"nenalshalem","id":"shakespeare014.lex.brain_membrane_pia","ipa":"","label":"brain_membrane_pia","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nenalshalem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The pia mater, figured as a womb nurturing Holofernes's flights of invention.","id":"shakespeare014.lex.brain_membrane_pia.sense","status":"draft"}],"status":"draft","variants":[]},"eb349ad401255303e5de3e3c1a614d027f73642c10f0da661833319b56e63826":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"brakenberi","id":"shakespeare014.lex.brakenbury_tower_officer","ipa":"","label":"brakenbury_tower_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"brakenberi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The Tower lieutenant who takes Clarence into custody and receives a warrant from Richard's two agents.","id":"shakespeare014.lex.brakenbury_tower_officer.sense","status":"draft"}],"status":"draft","variants":[]},"25f7be8b848670b1ede648566449eb250428aa39e4de2ac39067906744d0637d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_bramble","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_bramble","exampleIds":[],"headword":"kraninthesil","id":"shakespeare014.lex.bramble","ipa":"","label":"bramble","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kraninthesil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A thorny shrub that parts for the boar; no precise botanical species imposed.","id":"shakespeare014.lex.bramble.sense","status":"draft"}],"status":"draft","variants":[]},"83783d73dabf35e73ae07e7483b6dca17f99dbb256f877d5d43db36