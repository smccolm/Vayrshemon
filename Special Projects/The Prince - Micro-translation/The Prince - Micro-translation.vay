.","id":"shakespeare014.lex.hotspur_percy.sense","status":"draft"}],"status":"draft","variants":[]},"9451133cc879fcfd2cb9d303899835f4b7f75ec1c6b97d58c3f7cdc8e6ead9ea":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sick + house","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: sick + house","exampleIds":[],"headword":"murvorz\u00e1l","id":"shakespeare014.lex.house_for_the_sick","ipa":"","label":"house_for_the_sick","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murvorz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The house where Berowne agrees to try his jokes on the sick.","id":"shakespeare014.lex.house_for_the_sick.sense","status":"draft"}],"status":"draft","variants":[]},"556e8af147b2a30ce3fe738e0acb56582bfb460690efb263d3b897946b639cf7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_household","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_household","exampleIds":[],"headword":"z\u00e1ls\u00dflum","id":"shakespeare014.lex.household","ipa":"","label":"household","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4ls\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The family and dependents belonging to a house; family ancestry in the household-tomb image.","id":"shakespeare014.lex.household.sense","status":"draft"}],"status":"draft","variants":[]},"cce2dcf34e3e672eb761daab1aef284f3ccf93faa3b7206a06540d3f796d52ec":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: house + task","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: house + task","exampleIds":[],"headword":"z\u00e1ld\u00c7\u0