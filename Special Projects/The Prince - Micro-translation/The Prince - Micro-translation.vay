e-specific Welsh captain's pronunciation in Henry V 4.8.","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Source-specific Welsh captain's pronunciation in Henry V 4.8.","exampleIds":[],"headword":"slep","id":"shakespeare014.lex.fluellen_plows","ipa":"","label":"fluellen_plows","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"slep","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Fluellen devoices the native word for a physical blow when threatening to pay for treason in plows. His meaning is blows.","id":"shakespeare014.lex.fluellen_plows.sense","status":"draft"}],"status":"draft","variants":[]},"06cd7c8eaaeea54327693932081eb120e2f9bb887f4342796f6d89330a5179f5":{"audioLinks":[],"citations":[{"locator":"Source-specific Welsh captain's pronunciation in Henry V 4.7.","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Source-specific Welsh captain's pronunciation in Henry V 4.7.","exampleIds":[],"headword":"for","id":"shakespeare014.lex.fluellen_pody","ipa":"","label":"fluellen_pody","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"for","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"Fluellen devoices the initial of native body in the same line as his pronunciation of blood.","id":"shakespeare014.lex.fluellen_pody.sense","status":"draft"}],"status":"draft","variants":[]},"4d33587c6ffe3885533b05a888207b0d8d7ed0a3d7e727df3a53963b4eec3ca4":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of pipe","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of pipe","exampleIds":[],"headword":"filir","id":"shakespeare014.lex.flute_instrument","ipa":"","label":"flute_instrument","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"filir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A hollow breath-played musical pipe setting the oars\u2019 rhythm. Distinct from Francis Flute in Midsummer; no modern instrument design is imposed.","id":"shakespeare014.lex.flute_instrument.sense","status":"draft"}],"status":"draft","variants":[]},"994f05ebd4d52d038e584ddf5bc36c49be914366aa0e0f6d182afe2ab43e4959":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from insect, wing","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from insect, wing","exampleIds":[],"headword":"jivemv\u00ddlawin","id":"shakespeare014.lex.fly_insect","ipa":"","label":"fly_insect","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jivemv\u012blawin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"The flying insect bitten by the annoyed horse; not the verb to fly.","id":"shakespeare014.lex.fly_insect.sense","status":"draft"}],"status":"draft","variants":[]},"7e85cb45136fe2e6f507ef621af9088df46e48d7913f8c2b905e23ee6b9c4b63":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_foam","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_foam","exampleIds":[],"headword":"yems\u00d7pulen","id":"shakespeare014.lex.foam","ipa":"","label":"foam","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113pulen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Foam or froth, here at the boar\u2019s mouth and mingled with blood; not water alone.","id":"shakespeare014.lex.foam.sense","status":"draft"}],"status":"draft","variants":[]},"1c32718c4908ffb0d479552d7cb61900451ee3693e7337d4242f95457afe55ac":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: back + shadow","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: back + shadow","exampleIds":[],"headword":"tarswif","id":"shakespeare014.lex.foil_contrasting_backing","ipa":"","label":"foil_contrasting_backing","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tarswif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"A contrasting background that brings another's qualities out, as a backing sets off a jewel. Emilia initially describes Palamon as Arcite's foil.","id":"shakespeare014.lex.foil_contrasting_backing.sense","status":"draft"}],"status":"draft","variants":[]},"937540d6f751e3f1e9cf673f99cb99b5233ce7ff8f167b274156c73ced57923e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of fault","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of fault","exampleIds":[],"headword":"murf\u00d7venor","id":"shakespeare014.lex.foil_defect","ipa":"","label":"foil_defect","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murf\u0113venor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Antony\u2019s foils as defects or failings, not fencing swords or a metallic sheet.","id":"shakespeare014.lex.foil_defect.sense","status":"draft"}],"status":"draft","variants":[]},"599811e45ceaf5247a11498532aa501b7048f00b53d7f9819f602a858f99568b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"fwa","id":"shakespeare014.lex.foix_lord","ipa":"","label":"foix_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"fwa","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"French lord named before Lestrale.","id":"shakespeare014.lex.foix_lord.sense","status":"draft"}],"status":"draft","variants":[]},"e0cf87358a20eefd4f82a90e15473af6be64930e9628d3871ab94123ca88c0e8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_fold_cloth_hebrews","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_fold_cloth_hebrews","exampleIds":[],"headword":"elyi\u00d1","id":"shakespeare014.lex.fold","ipa":"","label":"fold","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"elyich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Turn one part of a sheet over another; Lucrece folds her letter, not a numerical multiplier.","id":"shakespeare014.lex.fold.sense","status":"draft"}],"status":"draft","variants":[]},"e8e8dff4b653999e6800dfcf5db33da49ed3b8b45a3432f001d5a50d9a28a01f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fold + book","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: fold + book","exampleIds":[],"headword":"elyi\u00d1govis","id":"shakespeare014.lex.folio_book_format","ipa":"","label":"folio_book_format","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elyichgovis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"A book printed on sheets folded once. Armado wants whole volumes in this large format.","id":"shakespeare014.lex.folio_book_format.sense","status":"draft"}],"status":"draft","variants":[]},"9f130d48d41bd925a0cfc116dec39f24fa0fdfd1132f23325fdb81af9a03db4e