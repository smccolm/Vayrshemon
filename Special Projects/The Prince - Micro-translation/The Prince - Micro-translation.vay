d lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Hidden knowledge in Nature\u2019s infinite book metaphor, rather than merely an injunction not to speak.","id":"shakespeare014.lex.secret_knowledge.sense","status":"draft"}],"status":"draft","variants":[]},"cc240f44809bf2dd8ceb127d1dcb6dc5dbe520caec7ca46ecb2fba7049ab948b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: write + servant","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Authored native derivation or sense: write + servant","exampleIds":[],"headword":"\u00ddvd\u00c7v","id":"shakespeare014.lex.secretary_court","ipa":"","label":"secretary_court","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u012bvd\u00e3v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"A writing officer in Wolsey's retinue. Two attend with papers.","id":"shakespeare014.lex.secretary_court.sense","status":"draft"}],"status":"draft","variants":[]},"3f61876384b4bf253e4be15cc68dc1cb18854f203d0d24d72ffce8ebb13f8260":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fen_marsh + grass","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: fen_marsh + grass","exampleIds":[],"headword":"yems\u00d7jo\u00d9yel","id":"shakespeare014.lex.sedge_lakeshore","ipa":"","label":"sedge_lakeshore","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yems\u0113jongyel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The grasslike wetland plant distinguished from reeds along the lake where the Wooer hears the Daughter.","id":"shakespeare014.lex.sedge_lakeshore.sense","status":"draft"}],"status":"draft","variants":[]},"9104a8eeebfa93ec8b4755d67b372ccf36a446ec3df19d657b247661e57cd58d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_sedition","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_sedition","exampleIds":[],"headword":"var\u00dfnenzethda\u00c3","id":"shakespeare014.lex.sedition_discord","ipa":"","label":"sedition_discord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"var\u014dnenzethdajzh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Political discord or incited rebellion in Coriolanus\u2019s accusation. Reviewed native rebel-stir; the accusation belongs to the character, not the narrator.","id":"shakespeare014.lex.sedition_discord.sense","status":"draft"}],"status":"draft","variants":[]},"6450a74274c142bf3b639582ab69fd7466ff1afa734f926897891596bc6fb5eb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: kjv_sow","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: kjv_sow","exampleIds":[],"headword":"p\u00e1instrasf\u00c5ws\u00dflum","id":"shakespeare014.lex.seedsman_sower","ipa":"","label":"seedsman_sower","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4instrasf\u0101ws\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"One who sows grain into the receding Nile\u2019s mud. Native sow-agent, not an inserted landowner or a trader selling seeds.","id":"shakespeare014.lex.seedsman_sower.sense","status":"draft"}],"status":"draft","variants":[]},"19677ca8b65c096f858a7b5d39af385f4485ffea099ffdc4149e1994835a83c2":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: eyelid + kjv_sew","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: eyelid + kjv_sew","exa