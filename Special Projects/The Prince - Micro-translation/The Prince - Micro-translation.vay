us_oracle","ipa":"","label":"aeacus_oracle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"eakos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The ancestor implied by the patronymic Aeacida in York's quoted oracle. Its addressee is a descendant, not Aeacus himself.","id":"shakespeare014.lex.aeacus_oracle.sense","status":"draft"}],"status":"draft","variants":[]},"2da4e85429e1160b2768cdf36b6940a2b20fcb13bd76d24dbcd628561257fbd6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: city + officer","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: city + officer","exampleIds":[],"headword":"z\u00e1lagurmarvenens\u00dflum","id":"shakespeare014.lex.aedile_roman","ipa":"","label":"aedile_roman","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u00f4lagurmarvenens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The Roman civic officer serving in the public-order and arrest scene. Native city-officer distinguishes the institution from a tribune or senator without importing the Latin office-name sound.","id":"shakespeare014.lex.aedile_roman.sense","status":"draft"}],"status":"draft","variants":[]},"d987a4c2947c75183b22ccc0d9cb1b39259bb2322b9331113b8f85db4ca37be1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"emilius","id":"shakespeare014.lex.aemilius_imperial_messenger","ipa":"","label":"aemilius_imperial_messenger","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"emilius","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.titus-andronicus.r1"}],"definition":"Messenger for the Roman emperor who approaches Lucius and accompanies the imperial party.","id":"shakespeare014.lex.aemilius_imperial_messenger.sense","status":"draft"}],"status":"draft","variants":[]},"8eca873056bf4ea6fbe517c7c4216cbd231b4ce6be270d7861c366858dc84230":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"aeneas","id":"shakespeare014.lex.aeneas_trojan_hero","ipa":"","label":"aeneas_trojan_hero","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"aeneas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The Trojan hero paired with Dido, distinct from the man named Aeneas in Acts. The internal identity distinction does not print in the name.","id":"shakespeare014.lex.aeneas_trojan_hero.sense","status":"draft"}],"status":"draft","variants":[]},"38e7b0e770e1802fe583dbb6b73264cd09ab3e80972f8d0586ca0bcf755643d9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"eolos","id":"shakespeare014.lex.aeolus_wind_lord","ipa":"","label":"aeolus_wind_lord","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"eolos","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-2.r1"}],"definition":"The wind lord Margaret says refused to kill her at sea.","id":"shakespeare014.lex.aeolus_wind_lord.sense","status":"draft"}],"status":"draft","variants":[]},"ea9f6b74c8c54bccbf17185cb8ff43cffe5e8f0c12bc04a0