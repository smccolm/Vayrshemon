"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Make a person appear fitting or beautiful: everything becomes Cleopatra. Distinct from transform into or acquire a new state.","id":"shakespeare014.lex.suit_becoming.sense","status":"draft"}],"status":"draft","variants":[]},"e579f53748499aa02d6331e12d95b0fe4bd6efc755d26d8b0d50db2266de1d19":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_brimstone","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_brimstone","exampleIds":[],"headword":"zarj\u00d7n","id":"shakespeare014.lex.sulfur_thunder","ipa":"","label":"sulfur_thunder","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarj\u0113n","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Sulfur in the image of a thunderbolt charged with force yet restrained to split an oak.","id":"shakespeare014.lex.sulfur_thunder.sense","status":"draft"}],"status":"draft","variants":[]},"19067c5522e839e71120655457f13dfa4dc77c2921cc373ac9548975de3524eb":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from frown, remain","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from frown, remain","exampleIds":[],"headword":"panenharenshalendlen\u00dbemin","id":"shakespeare014.lex.sullen","ipa":"","label":"sullen","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"panenharenshalendlenshemin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Persistently withdrawn and displeased, not a concealed declaration of desire.","id":"shakespeare014.lex.sullen.sense","status":"draft"}],"status":"draft","variants":[]},"50ea049988a82ecf8ecfb5ce87316ca69a3ff650402d967d