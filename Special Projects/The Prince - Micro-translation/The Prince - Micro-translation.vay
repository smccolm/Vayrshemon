_shallow.sense","status":"draft"}],"status":"draft","variants":[]},"af7447b3f9c2c3598ed9da627d8947aa9467747971fa4145dfa9c85373bad366":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"deivi","id":"shakespeare014.lex.davy_welsh_saint","ipa":"","label":"davy_welsh_saint","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"deivi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The Welsh patron saint whose feast and leek Pistol invokes. Distinct from Shallow's servant Davy and the biblical David.","id":"shakespeare014.lex.davy_welsh_saint.sense","status":"draft"}],"status":"draft","variants":[]},"a143229dd3995a2a8f7f49fcbcb71ea77dbf5a8f9ac1d753e4c153591d0db40d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: small + crow","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: small + crow","exampleIds":[],"headword":"viminkrowil","id":"shakespeare014.lex.daw_bird","ipa":"","label":"daw_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminkrowil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A jackdaw in the servant\u2019s bird-city retort, native small-crow. Also available as a contemptuous fool image in this exchange; not a personal name or an invented precise zoological claim.","id":"shakespeare014.lex.daw_bird.sense","status":"draft"}],"status":"draft","variants":[]},"ebd13d3fac3fd0084de43752007891c251a98d9d903cc32f3b51fcb1298246ef":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of day","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of day","exampleIds":[],"headword":"yel","id":"shakespeare014.lex.day_personified","ipa":"","label":"day_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"yel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Day as the suspicious witness addressed in Lucrece\u2019s lament; native time word with personification Maxima.","id":"shakespeare014.lex.day_personified.sense","status":"draft"}],"status":"draft","variants":[]},"ae41d96f201ff4996c8a7602302ccba400579fa4f333d55f9046addca3729831":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from light, confuse","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from light, confuse","exampleIds":[],"headword":"b\u00d7\u00c7rj\u00c9gwa\u00c3h\u00c5b\u00cd","id":"shakespeare014.lex.dazzle","ipa":"","label":"dazzle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"b\u0113\u00e3rj\u00e4gwajzhh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Confuse sight through glare or visual disturbance, producing apparent multiple images in grief.","id":"shakespeare014.lex.dazzle.sense","status":"draft"}],"status":"draft","variants":[]},"8c4d9b3208012d4b98194274a8d92b7186cf8b8a8105bf1ec1753a3017d113ad":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"de kasado","id":"shakespeare014.lex.de_cassado_agent","ipa":"","label":"de_cassado_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"de kasado","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Gregory's surname in the charge recited by Surrey. Preserve the local witness's spelling.","id":"shakespeare014.lex.de_cassado_agent.sense","status":"draft"}],"status":"draft","variants":[]},"773c0fc3c9b647daffdaf350f8f0f1d2ebddf94cfa3454f66f1491f0d4508073":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"de la kar","id":"shakespeare014.lex.de_la_car_confessor","ipa":"","label":"de_la_car_confessor","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"de la kar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The family name of Buckingham's confessor in the local witness.","id":"shakespeare014.lex.de_la_car_confessor.sense","status":"draft"}],"status":"draft","variants":[]},"90d247d805b3f398029032e777e717226b276db991a827f859f0f152194099a3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_deaf","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_deaf","exampleIds":[],"headword":"jorindwe\u00d9en","id":"shakespeare014.lex.deaf","ipa":"","label":"deaf","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"jorindwengen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Unable to hear; distinct from choosing not to heed or understand.","id":"shakespeare014.lex.deaf.sense","status":"draft"}],"status":"draft","variants":[]},"3ff90576b2f1b73ebe921666a951988535acf46baa19745c85c3dd0bbe938f43":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: costly","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: costly","exampleIds":[],"headword":"v\u00df\u00d5gimennaor","id":"shakespeare014.lex.dear_costly","ipa":"","label":"dear_costly","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"v\u014d\u0167hgimennaor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Costly to maintain, the hungry citizens\u2019 bitter account of how their rulers value them; not affectionate dear.","id":"shakespeare014.lex.dear_costly.sense","status":"draft"}],"status":"draft","variants":[]},"057cdc19cb85c0a72370c86e9e4cb6457530069f5a28df2fb2a76deb3e9ab404":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: food + lack","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: food + lack","exampleIds":[],"headword":"d\u00cdn\u00d7rmavsif","id":"shakespeare014.lex.dearth_food","ipa":"","label":"dearth_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u0117rn\u0113rmavsif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Scarcity of food in the city; not the ordinary desire/want verb.","id":"shakespeare014.lex.dearth_food.sense","status":"draft"}],"status":"draft","variants":[]},"15d686d0b20ce5456be95181d440ba9171116ded0b39699599637deb26707181":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of lack","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of lack","exampleIds":[],"headword":"mavsif","id":"shakespeare014.lex.dearth_scarcity","ipa":"","label":"dearth_scarcity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mavsif","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Want or scarcity, the soul\u2019s deprivation despite the body\u2019s costly decoration in Sonnet 146.","id":"shakespeare014.lex.dearth_scarcity.sense","status":"draft"}],"status":"draft","variants":[]},"632a5aff3f375cd17202fb71e60e1cb1ae4f62c1f2cf2b8e3d4cac0dcc19a580":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of death","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of death","exampleIds":[],"headword":"n\u00d7nen","id":"shakespeare014.lex.death_personified","ipa":"","label":"death_personified","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"n\u0113nen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Death addressed as a tyrant and killer by Venus before she has confirmed Adonis\u2019s death; preserves personification without adding a separate mortal character.","id":"shakespeare014.lex.death_personified.sense","status":"draft"}],"status":"draft","variants":[]},"f85d1d93bb0000ecf574cc61023fea4307b4c31440ebc1565342e95056f10171":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of death","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of death","exampleIds":[],"headword":"n\u00d7nen","id":"shakespeare014.lex.death_scythe","ipa":"","label":"death_scythe","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"n\u0113nen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Death personified as the opponent bearing a pestilent scythe; native death with Maxima, not a borrowed divine name or a new mortal character.","id":"shakespeare014.lex.death_scythe.sense","status":"draft"}],"status":"draft","variants":[]},"84e709690cc0cb905918726ccb9e798b5c8da9e5e2fc07ac71a8ca59394299a7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of dea