":"noun","pronunciation":"venortarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The long thrusting spear of the protestors, not the fish.","id":"shakespeare014.lex.pike_weapon.sense","status":"draft"}],"status":"draft","variants":[]},"61cefbc972ede639298561253729da5d2cc2516575b75f6d35d38ff1c1018871":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: skin + coat","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: skin + coat","exampleIds":[],"headword":"shalemf\u00eblen","id":"shakespeare014.lex.pilch_fishermans_nickname","ipa":"","label":"pilch_fishermans_nickname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"shalemf\u00fclen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"Fur-coat, the name the First Fisherman calls out before the Second Fisherman answers.","id":"shakespeare014.lex.pilch_fishermans_nickname.sense","status":"draft"}],"status":"draft","variants":[]},"5a5f6f87492626a1b4bb3dfb39d0900c695893c742cfa4759f09fe755eb5e79f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cloth_nap_surface","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: cloth_nap_surface","exampleIds":[],"headword":"felenf\u00ebl","id":"shakespeare014.lex.pile_mercers_name","ipa":"","label":"pile_mercers_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"felenf\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The cloth-pile element of Master Three-pile. His preceding spoken Unta three is part of the name.","id":"shakespeare014.lex.pile_mercers_name.sense","status":"draft"}],"status":"draft","varia