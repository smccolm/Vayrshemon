belly-mark, figuratively the state\u2019s vital center under threat. No new anatomical injury or city location is invented.","id":"shakespeare014.lex.navel_body.sense","status":"draft"}],"status":"draft","variants":[]},"991b721b50909b6fd28af6a7ec7ca43e8760c5a8d9ea9842045bb23bcc429d71":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: ox + herd","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: ox + herd","exampleIds":[],"headword":"bor\u00ebnvelngur","id":"shakespeare014.lex.neat_bovine_collective","ipa":"","label":"neat_bovine_collective","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"bor\u00fcnvelngur","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"Cattle as the collective name for the steer, heifer and calf. The English sound-link with neat meaning clean is documented separately.","id":"shakespeare014.lex.neat_bovine_collective.sense","status":"draft"}],"status":"draft","variants":[]},"b99f8aa82aa961baf5437031cc3c62ca27ae934d2fb966be31cf367ff09d7a61":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: herdsman","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: herdsman","exampleIds":[],"headword":"velngurjem\u00e3","id":"shakespeare014.lex.neatherd_cattlekeeper","ipa":"","label":"neatherd_cattlekeeper","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velngurjemoi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A keeper of cattle. Imogen imagines being this man\u2019s daughter while Leonatus is a neighbouring shepherd\u2019s son.","id":"shakespeare014.lex.neatherd_cattlekeeper.sense","status":"draft"}],"status":"draft","variants":[]},"e69a37a14b2069f874af7f9f4313b57830103bb243c