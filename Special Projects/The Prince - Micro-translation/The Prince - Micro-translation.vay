e014.lex.hermit_recluse","ipa":"","label":"hermit_recluse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vemyib\u2019\u00fcwlamzars\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The anchorite in the Player Queen's oath. She invokes the scant fare of a recluse in confinement.","id":"shakespeare014.lex.hermit_recluse.sense","status":"draft"}],"status":"draft","variants":[]},"675063c592a56ffd2f294cc6f81dfbc747686dc029f860e4a52aa708c6cf97ab":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hern","id":"shakespeare014.lex.herne_windsor_hunter","ipa":"","label":"herne_windsor_hunter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hern","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The hunter in the Windsor oak legend, later impersonated by Falstaff.","id":"shakespeare014.lex.herne_windsor_hunter.sense","status":"draft"}],"status":"draft","variants":[]},"3c04e708e070735dd4223b777c01d52d2510a37c928143b81aa9857e56f3596e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"hero","id":"shakespeare014.lex.hero_leonato_daughter","ipa":"","label":"hero_leonato_daughter","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hero","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Leonato's daughter. Distinct from the lover of Leander and from the common noun for a brave person.","id":"shakespeare014.lex.hero_leonato_daughter.sense","status":"draft"}],"status":"draft","variants":[]},"351467251a8e176993007df8d08ba854a70af84ab1d5fde9ac4a12c22b7aaf27":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal name.","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal name.","exampleIds":[],"headword":"hero","id":"shakespeare014.lex.hero_lover","ipa":"","label":"hero_lover","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"hero","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The woman loved by Leander, identified with Sestos in the supplied speech. Not the common noun hero/brave person; no identity qualifier prints.","id":"shakespeare014.lex.hero_lover.sense","status":"draft"}],"status":"draft","variants":[]},"cbabbddd0bdb2a437019882f9154338ddeda3580638c20bd034001be66fe20c3":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of herod_charmian","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of herod_charmian","exampleIds":[],"headword":"herod","id":"shakespeare014.lex.herod_alexas","ipa":"","label":"herod_alexas","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"herod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Herod of Jewry in Alexas\u2019s boast about Cleopatra\u2019s fearfulness and her ensuing head-taking threat. Retains the source\u2019s theatrical Herod identity and the already permitted personal form; does not force the play\u2019s chronology into a different Biblical king or assign a numbered dynasty.","id":"shakespeare014.lex.herod_alexas.sense","status":"draft"}],"status":"draft","variants":[]},"f938d52d2f2b32d0198a959268ad98ba42212a2b2a2e50181c7d51ca350376aa":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_herod_birth","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_herod_birth","exampleIds":[],"headword":"herod","id":"shakespeare014.lex.herod_charmian","ipa":"","label":"herod_charmian","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"herod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Herod of Jewry in Charmian\u2019s extravagant child-and-homage fantasy, which evokes the birth-story king. The child is not silently identified as Yesh\u016ba, nor the source anachronism corrected into a different king.","id":"shakespeare014.lex.herod_charmian.sense","status":"draft"}],"status":"draft","variants":[]},"b09fcd38d033feef866d89d680b700c0538217a74253d50342b4c6d634cd8a4e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_herod_birth","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_herod_birth","exampleIds":[],"headword":"herod","id":"shakespeare014.lex.herod_judean_king","ipa":"","label":"herod_judean_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"herod","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Herod, the Judean king whose allegiance Alexas reportedly tried to shift to Caesar. Distinct from the later tetrarch and Acts king; no internal identity label prints in the reading form.","id":"shakespeare014.lex.herod_judean_king.sense","status":"draft"}],"status":"draft","variants":[]},"2b47fb1345ae4768459271a817b47980df05695891f087a2983daf27c2f54b66":{"audioLinks":[]