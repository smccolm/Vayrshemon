-noble-kinsmen.r1"}],"definition":"The second of the three named dancers, grouped with Arcas and Rycas.","id":"shakespeare014.lex.sennois_may_dancer.sense","status":"draft"}],"status":"draft","variants":[]},"5463158de81f293a670018f31244a038fd4713d0a54e5335f6db55936c334867":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of sense","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of sense","exampleIds":[],"headword":"yjafun","id":"shakespeare014.lex.sensual_sense","ipa":"","label":"sensual_sense","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"yjafun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Pertaining to bodily sensation and sensual enjoyment, Sonnet 141\u2019s feast of the senses; not a diagnosis or a moral doctrine.","id":"shakespeare014.lex.sensual_sense.sense","status":"draft"}],"status":"draft","variants":[]},"8f4373b5c33f98005e91e7fcfc1b7dc2d974521238b3cc3c488b6409a4a513f4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: proverb + speech","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: proverb + speech","exampleIds":[],"headword":"s\u00dfrnh\u00c5b\u00cdmemtondagiktenv\u00d7en","id":"shakespeare014.lex.sententious_speech","ipa":"","label":"sententious_speech","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"s\u014drnh\u0101b\u0117rmemtondagiktenv\u0113en","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Full of pointed maxims or wise-seeming sayings; the Duke\u2019s assessment of Touchstone.","id":"shakespeare014.lex.sententious_speech.sense","status":"draft"}],"status":"draft","variants":[]},"e2f0be374878b99fc049ac85fe4b7c7aabe3952107c42b4e254d176dc78f7dbd":{"audi