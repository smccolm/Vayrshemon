if the world denies the lovers\u2019 peerlessness; nominal penalty, without an added particular punishment.","id":"shakespeare014.lex.punishment_penalty.sense","status":"draft"}],"status":"draft","variants":[]},"961999c1fb07a6f5225b95ce083b661822707ec5057fc760b03fa8a5fda036ab":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: learn","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: learn","exampleIds":[],"headword":"poms\u00dflum","id":"shakespeare014.lex.pupil_student","ipa":"","label":"pupil_student","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"poms\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A learner or novice, the self-deprecating poet\u2019s pen; distinct from the eye\u2019s pupil.","id":"shakespeare014.lex.pupil_student.sense","status":"draft"}],"status":"draft","variants":[]},"79642d221f2d6004cdb34f8320935d25118b3941ef261fe5f8b7b756b52c752b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: young + dog","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: young + dog","exampleIds":[],"headword":"nevb\u00cfeb","id":"shakespeare014.lex.puppy_young","ipa":"","label":"puppy_young","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nevb\u00cfeb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A young dog, used in contempt in the lord\u2019s aside.","id":"shakespeare014.lex.puppy_young.sense","status":"draft"}],"status":"draft","variants":[]},"e6b0692f7e1fca666f134a03552fa7dffbbfdcc080e6d8e3dafb3b3d3ee5c72f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: buy + servant","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology"