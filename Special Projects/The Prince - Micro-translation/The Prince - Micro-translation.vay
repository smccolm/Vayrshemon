nt","ipa":"","label":"mockwater_physician_taunt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lofnayems\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"definition":"The Host's mocking name for a doctor inspecting urine, which he falsely glosses as valour to Caius.","id":"shakespeare014.lex.mockwater_physician_taunt.sense","status":"draft"}],"status":"draft","variants":[]},"1d0f6d1d3cfcee6359fe9ac5c5a5683ed131374480588cd2403dc40c358e9e34":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"modena","id":"shakespeare014.lex.modena_city","ipa":"","label":"modena_city","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"modena","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Modena in Caesar\u2019s account of Antony\u2019s retreat; retain the source place-name form rather than inserting a different ancient name.","id":"shakespeare014.lex.modena_city.sense","status":"draft"}],"status":"draft","variants":[]},"6223df47bef409e53a683f5feb23d8090e3dd7c55c4a768b2b90ecd4cd71f3ee":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"modo","id":"shakespeare014.lex.modo_fiend","ipa":"","label":"modo_fiend","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"modo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"One of the two names Edgar gives the Prince of Darkness.","id":"shakespeare014.lex.modo_fiend.sense","status":"draft"}],"status":"draft","variants":[]},"e8e36156c39a8c1606540488984b882498a0b92f8142dd69c3294b5341248f55":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: give + part","sourceId":"shakespeare014.source.king-lear.r1"}],"etymology":"Authored native derivation or sense: give + part","exampleIds":[],"headword":"f\u00c5wthrenin","id":"shakespeare014.lex.moiety_allotment","ipa":"","label":"moiety_allotment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"f\u0101wthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-lear.r1"}],"definition":"Either duke's allotted share of Lear's kingdom. Its extent is compared with the other duke's but is not given as half the whole realm.","id":"shakespeare014.lex.moiety_allotment.sense","status":"draft"}],"status":"draft","variants":[]},"7cbdc7676c8936c19c8bd53531a08881b9fad0a80ecd4eeb03a054dddc760a49":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_mole_animal + hill","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_mole_animal + hill","exampleIds":[],"headword":"\u00d3\u00ddmuntav\u00ebr","id":"shakespeare014.lex.molehill_mound","ipa":"","label":"molehill_mound","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"th\u012bmuntav\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A small heap made by a burrowing mole. Its contrast with Olympus expresses the enormity of a mother bowing to her son.","id":"shakespeare014.lex.molehill_mound.sense","status":"draft"}],"status":"draft","variants":[]},"69662faa777bcfa2ca35481ca8b0297f70287ae045e85ee2781ff9f49233a283":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: 