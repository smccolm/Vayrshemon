hographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"z\u014dgunglil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Collective anthem or choral response, including the chorus framing this funeral; not an imported Greek sound.","id":"shakespeare014.lex.choral_song.sense","status":"draft"}],"status":"draft","variants":[]},"766a0af7d88474a9cb0d5421ac45413e5b2ae74420e7a345189dbce2dcff0a9e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of chorus","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of chorus","exampleIds":[],"headword":"kor\u00ebn","id":"shakespeare014.lex.chorus_refrain","ipa":"","label":"chorus_refrain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kor\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The holding or recurring sung response assigned to all the men after the boy\u2019s verse. Not a bodily grip, holding office or a new cast member named Chorus.","id":"shakespeare014.lex.chorus_refrain.sense","status":"draft"}],"status":"draft","variants":[]},"7eed57ce37979ec0cabfa1dd8a74b9b448f1fff85f9213ace997bd599af48827":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: cliff + crow_bird","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: cliff + crow_bird","exampleIds":[],"headword":"kar\u00ebnk\u00c9\u00cfnwil","id":"shakespeare014.lex.chough_cliff_bird","ipa":"","label":"chough_cliff_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kar\u00fcnk\u00e4\u00cfnwil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The crow-family cliff bird excluded from the wedding house; hoar is a separate modifier in the song.","id":"shakespeare014.lex.chough_cliff_bird.sense","status":"draft"}],"status":"draft","variants":[]},"83d772028b49347ff3093d13bdb5054f0079b3d28c9ec64d293f4573bac32ae6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_baptize","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_baptize","exampleIds":[],"headword":"meralprodna","id":"shakespeare014.lex.christen_naming","ipa":"","label":"christen_naming","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"meralprodna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The source Christian baptism/naming occasion in Orlando\u2019s answer about Rosalind\u2019s name. Reviewed native ritual-washing term; do not assign an unprinted age or mode of baptism, or reduce the occasion to merely painting or washing an object.","id":"shakespeare014.lex.christen_naming.sense","status":"draft"}],"status":"draft","variants":[]},"4413b42e7f1e85cb2b7ede6196ae7973027945dfb9331df0473807dc71afbc30":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: nativity_saviour + birth + feast","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"etymology":"Authored native derivation or sense: nativity_saviour + birth + feast","exampleIds":[],"headword":"man\u00d7njems\u00dfluma\u00d9\u00d5\u00dfry\u00e9\u00dbna","id":"shakespeare014.lex.christmas_nativity_feast","ipa":"","label":"christmas_nativity_feast","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"man\u0113njems\u014dlumang\u0167h\u014dry\u00e9shna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.loves-labors-lost.r1"}],"definition":"The feast of the Saviour's birth that Berowne sets against May's season of flowers.","id":"shakespeare014.lex.christmas_nativity_feast.sense","status":"draft"}],"status":"draft","variants":[]},"fb913a01193b1ef26da9490361c050572981e71a7b8577a507bbe7a96381e007":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kristofor","id":"shakespeare014.lex.christopher_sly_given","ipa":"","label":"christopher_sly_given","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kristofor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The tinker's given name in the induction.","id":"shakespeare014.lex.christopher_sly_given.sense","status":"draft"}],"status":"draft","variants":[]},"d7ec816d81510f67ed57148bd8c12dedfc15f655f2890713b8185dffe369d999":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"kristofer","id":"shakespeare014.lex.christopher_stanley_envoy","ipa":"","label":"christopher_stanley_envoy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"kristofer","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"Stanley's intermediary for Richmond, who names the leaders joining him.","id":"shakespeare014.lex.christopher_stanley_envoy.sense","status":"draft"}],"status":"draft","variants":[]},"034ea9c6c4d76e31a1fa63f47f2c52aec18d70b54e21cd0921714a93c2bcd4c1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-n