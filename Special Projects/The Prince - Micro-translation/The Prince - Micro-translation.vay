aphor for Jaques\u2019s experience. Not copying written excerpts or introducing an actual pharmaceutical procedure.","id":"shakespeare014.lex.extract_ingredient.sense","status":"draft"}],"status":"draft","variants":[]},"4fc6c906d1246467cc1144ce43918316102bcbd3973a116b49bcda54f2c24898":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of extreme","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of extreme","exampleIds":[],"headword":"gimolthavim","id":"shakespeare014.lex.extremity","ipa":"","label":"extremity","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gimolthavim","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"An extreme condition or pressure, here prompting excessive urgency.","id":"shakespeare014.lex.extremity.sense","status":"draft"}],"status":"draft","variants":[]},"610b89c255e03ae99231249d2edfd6f5c73101571005917b281fe53cf20efaa9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: extremity","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Authored native derivation or sense: extremity","exampleIds":[],"headword":"gimolthavim","id":"shakespeare014.lex.extremity_at_graves","ipa":"","label":"extremity_at_graves","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"gimolthavim","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"In the imagined encounter Patience's smile puts Extremity out of action.","id":"shakespeare014.lex.extremity_at_graves.sense","status":"draft"}],"status":"draft","variants":[]},"454b9318623bf0b60df7aaf954e4c98456d966d815fd06ca0ffcc5d31efd459b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: nest + hawk","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: ne