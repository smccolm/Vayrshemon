"status":"draft"}],"status":"draft","variants":[]},"565964970e16e7ef1efde269ce6e019e7745f437596d19a86d6f1f1eb3dd22a8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_hospitality_romans","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_hospitality_romans","exampleIds":[],"headword":"vesnap\u00e1s\u00dflumfart\u00e7l","id":"shakespeare014.lex.hospitality","ipa":"","label":"hospitality","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vesnap\u00f4s\u014dlumfart\u016bl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Receiving and caring for a guest; the violated welcome in Lucrece, without importing the earlier epistle setting.","id":"shakespeare014.lex.hospitality.sense","status":"draft"}],"status":"draft","variants":[]},"a52f3553e384e3ce522aa79bd52508d17557674f2eb54cbc25e56307a64820cb":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_hostage","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_hostage","exampleIds":[],"headword":"jamakl\u00e1rjems\u00dflum","id":"shakespeare014.lex.hostage_security","ipa":"","label":"hostage_security","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jamakl\u00f4rjems\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A person held as security in the reciprocal prebattle exchange. Native pledge-held-person, without inferring ransom, age, consent or a Biblical setting.","id":"shakespeare014.lex.hostage_security.sense","status":"draft"}],"status":"draft","variants":[]},"a0d8a279a4486c6f83cd26ca5ddcbef7b2c86d7b4f94d4ed73f54a60dd6211ec":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_defy","sourceId":"shakespeare