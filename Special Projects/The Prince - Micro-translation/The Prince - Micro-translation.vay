","senses":[{"citations":[{"locator":"lex.kjv_youngest","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Youngest in age within the referenced set, especially the brothers; not smallest in physical size.","id":"shakespeare014.biblical-vocabulary.kjv_youngest.sense","status":"draft"}],"status":"draft","variants":[]},"ff5e7b22f30fb6d900c52db67ffda91877d8dba97edbad400fc0f09b7fd9cffc":{"audioLinks":[],"citations":[{"locator":"lex.lap","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"palkl\u00e1r","id":"shakespeare014.biblical-vocabulary.lap","ipa":"","label":"lap","notes":"","orthographyId":"thimfora-79","partOfSpeech":"root","pronunciation":"palkl\u00f4r","senses":[{"citations":[{"locator":"lex.lap","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"front hollow formed by the seated thighs","id":"shakespeare014.biblical-vocabulary.lap.sense","status":"draft"}],"status":"draft","variants":[]},"f4ff1d3396d67680324d2ef9f16380a4da7375dd3e2c7116074ef3ff9a24b35e":{"audioLinks":[],"citations":[{"locator":"lex.last","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"h\u00eb\u00d5\u2019na","id":"shakespeare014.biblical-vocabulary.last","ipa":"","label":"last","notes":"","orthographyId":"thimfora-79","partOfSpeech":"adjective","pronunciation":"h\u00fc\u0167h\u2019na","senses":[{"citations":[{"locator":"lex.last","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"last in an ordered sequence","id":"shakespeare014.biblical-vocabulary.last.sense","status":"draft"}],"status":"draft","variants":[]},"75a17c9aee62266c729fe6d33137ed1b30cb6795b3517e2882fc758a5915e51c":{"audioLinks":[],"citations":[{"locator":"lex.lazy","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"mad\u00c7\u00d3na","id":"shakespeare014.biblical-vocabulary.lazy","ipa":