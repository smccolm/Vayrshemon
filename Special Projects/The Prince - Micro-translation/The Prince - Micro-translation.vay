ations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Release from confinement through bail; figurative liberation of the soul, without implying a literal court hearing.","id":"shakespeare014.lex.bail_release.sense","status":"draft"}],"status":"draft","variants":[]},"0eed45d083c0647ec3230101751a5901fa3c97505974257595ffc8ddb8f894b7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_bald","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_bald","exampleIds":[],"headword":"marin f\u00ebl","id":"shakespeare014.lex.bald_bare","ipa":"","label":"bald_bare","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"marin f\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Bare of hair or its figurative leafy counterpart on the oak\u2019s high top. Native hairless expression; the tree metaphor is preserved without diagnosing disease.","id":"shakespeare014.lex.bald_bare.sense","status":"draft"}],"status":"draft","variants":[]},"9d360c25c9ab6c83d2b0f9399bf8bac32d053375505b8c1c4dad6ded13d9bdd1":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: bald_bare + head","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: bald_bare + head","exampleIds":[],"headword":"marin f\u00eblharen","id":"shakespeare014.lex.baldpate_friars_nickname","ipa":"","label":"baldpate_friars_nickname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"marin f\u00fclharen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"Lucio's derisive name for the man in a friar's hood. The speaker does not know he is addressing the duke.","id":"shakespeare014.lex.baldpate_friars_nickname.sense","status":"draft"}],"status":"draft","variants":[]},"1144e07d382595b5ccbdb4a74f60cebff284f2515614c1579b41ba74991c5adf":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: shoulder + belt","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: shoulder + belt","exampleIds":[],"headword":"larnaorthreninthir\u00ebn","id":"shakespeare014.lex.baldric_horn_strap","ipa":"","label":"baldric_horn_strap","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"larnaorthreninthir\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The belt across the shoulder from which a hunter's horn can hang.","id":"shakespeare014.lex.baldric_horn_strap.sense","status":"draft"}],"status":"draft","variants":[]},"142e072c5017d23d42e0cbce800453a9c37bf03441900024336538120e75d75a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sword + belt","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: sword + belt","exampleIds":[],"headword":"keranthir\u00ebn","id":"shakespeare014.lex.baldric_sword_belt","ipa":"","label":"baldric_sword_belt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"keranthir\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The ornamented baldric suspending a knight's sword at his thigh.","id":"shakespeare014.lex.baldric_sword_belt.sense","status":"draft"}],"status":"draft","variants":[]},"4e890003f7a7598837229878cd30e7b6c7d87ace28d7ddc6bfdd6c84bb718c61":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: furrow + ridge","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Authored native derivation or sens