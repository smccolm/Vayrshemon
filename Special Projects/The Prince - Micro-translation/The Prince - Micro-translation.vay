","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The gentleman Anne calls to accompany her after her encounter with Richard.","id":"shakespeare014.lex.tressel_anne_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"664554877db559f79c50af9ae528a020fae6bce6a6079967c145041c0f66279f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: high + floor","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: high + floor","exampleIds":[],"headword":"naorjo\u00d9shal","id":"shakespeare014.lex.tribunal_dais","ipa":"","label":"tribunal_dais","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"naorjongshal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A raised platform supporting the golden chairs in Alexandria. Native high-floor, the spatial sense of tribunal here rather than an entire court of law.","id":"shakespeare014.lex.tribunal_dais.sense","status":"draft"}],"status":"draft","variants":[]},"c277700f5cd2362393023eec4ad799621662cbe48870343ac44068c9db643f67":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: roman_civic_person + officer","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: roman_civic_person + officer","exampleIds":[],"headword":"romas\u00dflummarvenens\u00dflum","id":"shakespeare014.lex.tribune_levy","ipa":"","label":"tribune_levy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"romas\u014dlummarvenens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Roman officer addressed in the raising of troops. Do not substitute the named tribunes of the plebs from Coriolanus.","id":"shakespeare014.lex.tribune_levy.sense","status":"draft"}],"status":"draft","variants":[]},"6e2a7a3b6bac1a438c074616510da7b51f39adafa0da6b9e7fd708982228513f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: common_people + guard","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: common_people + guard","exampleIds":[],"headword":"\u00e1pe\u00dbems\u00dflumjemek","id":"shakespeare014.lex.tribune_plebs","ipa":"","label":"tribune_plebs","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u00f4peshems\u014dlumjemek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The office of protector/representative of the ordinary people granted in the play. Native common-people-guard; distinct from a military commander or a modern newspaper.","id":"shakespeare014.lex.tribune_plebs.sense","status":"draft"}],"status":"draft","variants":[]},"f7f62ce640d0cb203ea8cac420a2c2ee301ec4879cdd1737f61698d63322e7e6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_tribute","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_tribute","exampleIds":[],"headword":"d\u00c7\u00d3f\u00c5w","id":"shakespeare014.lex.tribute","ipa":"","label":"tribute","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u00e3thf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An acknowledgement/dues paid to a superior, figuratively Love\u2019s gazes to the beloved face.","id":"shakespeare014.lex.tribute.sense","status":"draft"}],"status":"draft","variants":[]},"f463489419ec328021323e34d98b4668687b557d63d86286d220b13666ffdf57":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: tribute + debt","sourceId":"shakespeare014.source.cymbeli