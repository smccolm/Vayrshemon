ns":[{"locator":"lex.kjv_censer","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"A vessel for the fire and incense presented in the source, distinct in role from a generic altar pan; no precise suspension or handle shape asserted.","id":"shakespeare014.biblical-vocabulary.kjv_censer.sense","status":"draft"}],"status":"draft","variants":[]},"0bc9d7f0ecb612b5862b3b7fcc06ee8ce95227c127a284f681fb1614c96be110":{"audioLinks":[],"citations":[{"locator":"lex.kjv_cling","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"gl\u00c9z\u00cbenthavvim","id":"shakespeare014.biblical-vocabulary.kjv_cling","ipa":"","label":"kjv_cling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gl\u00e4zhwenthavvim","senses":[{"citations":[{"locator":"lex.kjv_cling","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Adhere or hold closely to another; relational attachment, not splitting as in the other sense of cleave.","id":"shakespeare014.biblical-vocabulary.kjv_cling.sense","status":"draft"}],"status":"draft","variants":[]},"be5e7297cc5206e2c8e9181eaab9a15198767da2c8f866d538641dfc4c3677d8":{"audioLinks":[],"citations":[{"locator":"lex.kjv_cock_crow","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"venwilgoren\u00d3\u00c5\u00e7","id":"shakespeare014.biblical-vocabulary.kjv_cock_crow","ipa":"","label":"kjv_cock_crow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"venwilgorenth\u0101\u016b","senses":[{"citations":[{"locator":"lex.kjv_cock_crow","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Crow,the male chicken's call in Matthew26 denial narrative;cock-cry,distinct from the existing crow bird noun. The printed before-crow/three-denials sequence is not altered to another Gospel's counting.","id":"shakespeare014.biblical-vocabulary.kjv_cock_crow.sense","status":"draft"}],"status":"draft","variants":[]},"ee1373561e105f9227e56e069879fa633a536326c05dcdd4fd92960469f84d74":{"audioLinks":[],"citations":[{"locator":"lex.kjv_coral","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"goryemsy\u00eblen","id":"shakespeare014.biblical-vocabulary.kjv_coral","ipa":"","label":"kjv_coral","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"goryemsy\u00fclen","senses":[{"citations":[{"locator":"lex.kjv_coral","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Coral,the source valuable sea-growth designation,sea-branch. No precise biological species or modern gem identification is imposed.","id":"shakespeare014.biblical-vocabulary.kjv_coral.sense","status":"draft"}],"status":"draft","variants":[]},"81c6cf0ba12db451e60a7dd7165f7687b33c100b3b3ddd4c498c0cfb080c80bb":{"audioLinks":[],"citations":[{"locator":"lex.kjv_creek_inlet_acts","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"goryemsybs\u00df","id":"shakespeare014.biblical-vocabulary.kjv_creek_inlet_acts","ipa":"","label":"kjv_creek_inlet_acts","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"goryemsybs\u014d","senses":[{"citations":[{"locator":"lex.kjv_creek_inlet_acts","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Creek,a coastal inlet with a shore in Acts27:39,sea-enter. Not automatically a small freshwater stream or an asserted named modern bay.","id":"shakespeare014.biblical-vocabulary.kjv_creek_inlet_acts.sense","status":"draft"}],"status":"draft","variants":[]},"733f12ab5f3536b2fb16273332ec42958c8183b8b26132334a22f9a81c27802a":{"audioLinks":[],"citations":[{"locator":"lex.kjv_crescent_tire","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"\u00c5\u00d9b\u00d7rel\u00ebin\u00d1et","id":"shakespeare014.biblical-vocabulary.kjv_crescent_tire","ipa":"","label":"kjv_crescent_tire","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u0101ngb\u0113rel\u00fcinchet","senses":[{"citations":[{"locator":"lex.kjv_crescent_tire","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Round tire like the moon,a moon-shaped adornment in the supplied dress inventory; moon-ornament,not a vehicle tire or fatigue.","id":"shakespeare014.biblical-vocabulary.kjv_crescent_tire.sense","status":"draft"}],"status":"draft","variants":[]},"c7d3c77084cdbd000865bc1861fbb4eb65fce264f749aeb12997a22319b185eb":{"audioLinks":[],"citations":[{"locator":"lex.kjv_cupbearer","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"tremborel\u00db\u00c7d","id":"shakespeare014.biblical-vocabulary.kjv_cupbearer","ipa":"","label":"kjv_cupbearer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tremborelsh\u00e3d","senses":[{"citations":[{"locator":"lex.kjv_cupbearer","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"The royal drink-serving officer called butler in this source; cup-bearer, not an imposed modern domestic servant role.","id":"shakespeare014.biblical-vocabulary.kjv_cupbearer.sense","status":"draft"}],"status":"draft","variants":[]},"fec03dbfe2e65d1325986fca7307852db62f899b985427497ce215d56bec1c8f":{"audioLinks":[],"citations":[{"locator":"lex.kjv_cymbal","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"zarj\u00cdens\u00ebnal","id":"shakespeare014.biblical-vocabulary.kjv_cymbal","ipa":"","label":"kjv_cymbal","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarj\u0117rens\u00fcnal","senses":[{"citations":[{"locator":"lex.kjv_cymbal","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Cymbal, a struck resonating plate instrument; metal-sound-instrument, separate from the timbrel and string instruments.","id":"shakespeare014.biblical-vocabulary.kjv_cymbal.sense","status":"draft"}],"status":"draft","variants":[]},"f397a77f3914dc57329bf2c75b95cce7c663e42b7ecbf88cfc9f76df7c1ca889":{"audioLinks":[],"citations":[{"locator":"lex.kjv_daub","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"strasf\u00c5wdarshal","id":"shakespeare014.biblical-vocabulary.kjv_daub","ipa":"","label":"kjv_daub","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"strasf\u0101wdarshal","senses":[{"citations":[{"locator":"lex.kjv_daub","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Spread or smear a coating on a surface,the source wall-daubing action; spread-plaster. Does not certify sound construction or replace the specified coating with modern plaster chemistry.","id":"shakespeare014.biblical-vocabulary.kjv_daub.sense","status":"draft"}],"status":"draft","variants":[]},"e18bef5049a7faafdd35553a8ad70b60582768a3581f68a4677f44c43a53aa8a":{"audioLinks":[],"citations":[{"locator":"lex.kjv_debt_bill","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"lamf\u00ebrenint\u00dff\u00c9ben","id":"shakespeare014.biblical-vocabulary.kjv_debt_bill","ipa":"","label":"kjv_debt_bill","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamf\u00fcrenint\u014df\u00e4ben","senses":[{"citations":[{"locator":"lex.kjv_debt_bill","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"The written bill recording an obligation in Luke16:6\u20137;debt-record. Distinct from a bird bill or modern currency note. The recorded quantities change without an invented commission or legal justification.","id":"shakespeare014.biblical-vocabulary.kjv_debt_bill.sense","status":"draft"}],"status":"draft","variants":[]},"6ad953ade739688548296c3b062c3b1fae336dedf6d8cc93fc25c98e7cbb1f6c":{"audioLinks":[],"citations":[{"locator":"lex.kjv_door_leaf","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"dar\u00c5elthrenin","id":"shakespeare014.biblical-vocabulary.kjv_door_leaf","ipa":"","label":"kjv_door_leaf","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dar\u0101elthrenin","senses":[{"citations":[{"locator":"lex.kjv_door_leaf","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"A leaf or panel of a folding door, door-part; not the leaf of a plant.","id":"shakespeare014.biblical-vocabulary.kjv_door_leaf.sense","status":"draft"}],"status":"draft","variants":[]},"7405b2c06d6025d203975a09ffc1644a617ed0d3b95b87cf515666c1ee03fb43":{"audioLinks":[],"citations":[{"locator":"lex.kjv_doorpost","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"dar\u00c5elkoj halemin\u00d7","id":"shakespeare014.biblical-vocabulary.kjv_doorpost","ipa":"","label":"kjv_doorpost","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dar\u0101elkoj halemin\u0113","senses":[{"citations":[{"locator":"lex.kjv_doorpost","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"An upright structural post at a doorway, distinct from the verb post or a postal dispatch.","id":"shakespeare014.biblical-vocabulary.kjv_doorpost.sense","status":"draft"}],"status":"draft","variants":[]},"b88610bbf83c9d4c51a2f144a53df4753d813443361b131c39e6a5b4636cfd7d":{"audioLinks":[],"citations":[{"locator":"lex.kjv_drowse","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"se\u00dbthavvim","id":"shakespeare014.biblical-vocabulary.kjv_drowse","ipa":"","label":"kjv_drowse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"seshthavvim","senses":[{"citations":[{"locator":"lex.kjv_drowse","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Drowsiness or sleep-heavy inactivity,sleep-near;Proverbs23:21personifies it as clothing a person in rags. This source's moral claim is not a clinical classification or a claim about every sleepy person.","id":"shakespeare014.biblical-vocabulary.kjv_drowse.sense","status":"draft"}],"status":"draft","variants":[]},"2ce246788fd4279dc41ff197b098f87e2db97c8be39cd6bb91e50e942144b837":{"audioLinks":[],"citations":[{"locator":"lex.kjv_encircling_band","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"olenthrenkl\u00e1rin","id":"shakespeare014.biblical-vocabulary.kjv_encircling_band","ipa":"","label":"kjv_encircling_band","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"olenthrenkl\u00f4rin","senses":[{"citations":[{"locator":"lex.kjv_encircling_band","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"A surrounding round band or form, round-band; compass in the structural description, not a navigation device.","id":"shakespeare014.biblical-vocabulary.kjv_encircling_band.sense","status":"draft"}],"status":"draft","variants":[]},"65be0df5bc6dba1fb62cb01205ef4979efc2c04bf417eafe2ad5c81b2afe6b44":{"audioLinks":[],"citations":[{"locator":"lex.kjv_evangelist_ephesians","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"farp\u00e1f\u00d7j\u00cdtondas\u00dflum","id":"shakespeare014.biblical-vocabulary.kjv_evangelist_ephesians","ipa":"","label":"kjv_evangelist_ephesians","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"farp\u00f4f\u0113j\u0117rtondas\u014dlum","senses":[{"citations":[{"locator":"lex.kjv_evangelist_ephesians","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Evangelist in Ephesians4:11,a good-news proclaimer,gospel-person. Preserves a separate role beside apostle,prophet,pastor and teacher without inventing a modern denomination or numerical hierarchy.","id":"shakespeare014.biblical-vocabulary.kjv_evangelist_ephesians.sense","status":"draft"}],"status":"draft","variants":[]},"1b1eb622f73c127f0d9b99689fab2d620b8534b983edf3504976abefb99fb1e7":{"audioLinks":[],"citations":[{"locator":"lex.kjv_exact_debt","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"lamf\u00ebrenblemf","id":"shakespeare014.biblical-vocabulary.kjv_exact_debt","ipa":"","label":"kjv_exact_debt","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"lamf\u00fcrenblemf","senses":[{"citations":[{"locator":"lex.kjv_exact_debt","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"Exact a debt as demand repayment, distinct from exact as precise or matching.","id":"shakespeare014.biblical-vocabulary.kjv_exact_debt.sense","status":"draft"}],"status":"draft","variants":[]},"0fbf259de91d73a65d8de9ec028967f647922a002558e761aa74831b324cdf10":{"audioLinks":[],"citations":[{"locator":"lex.kjv_familiar_spirit","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"etymology":"Sealed Bible vocabulary review","exampleIds":[],"headword":"h\u00c5b\u00cdthavvimswifl\u00dfn","id":"shakespeare014.biblical-vocabulary.kjv_familiar_spirit","ipa":"","label":"kjv_familiar_spirit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"h\u0101b\u0117rthavvimswifl\u014dn","senses":[{"citations":[{"locator":"lex.kjv_familiar_spirit","sourceId":"shakespeare014.bible.0.10-kjv.285"}],"definition":"The spirit called familiar in the source divination category; not merely a familiar acquaintance or an ordinary friendly person.","id":"shakespeare014.biblical-vocabulary.kjv_familiar_spirit.sense","status":"draft"}],"status":"draft","variants":[]},"8138b8ea7713281b776858559a6e34f830981ccea4b062d14086db562f647303":{"audioLinks":[],"citations":[{"locator":