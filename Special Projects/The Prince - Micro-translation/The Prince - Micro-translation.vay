":[],"citations":[{"locator":"Authored native derivation or sense: dig + blade","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: dig + blade","exampleIds":[],"headword":"jo\u00d9dest\u00eb\u00c5lenir","id":"shakespeare014.lex.digging_spade","ipa":"","label":"digging_spade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongdest\u00fc\u0101lenir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The tool used to dig and knock against the exhumed skulls.","id":"shakespeare014.lex.digging_spade.sense","status":"draft"}],"status":"draft","variants":[]},"e0a1d863d30592f165ad904558ac3391b7ec5e7c40fc44108a6106071caf0ccd":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"daiton","id":"shakespeare014.lex.dighton_princes_killer","ipa":"","label":"dighton_princes_killer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"daiton","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"One of the pair Tyrrel hires to smother Edward's sons.","id":"shakespeare014.lex.dighton_princes_killer.sense","status":"draft"}],"status":"draft","variants":[]},"caff2778ae5e858bededfad83d644e06afb6c4656f3c454962a3f9fd80a43ba4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: weak + cause","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: weak + cause","exampleIds":[],"headword":"vimjw\u00ebnh\u00eb","id":"shakespeare014.lex.dilute_weaken","ipa":"","label":"dilute_weaken","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vimjw\u00fcnh\u00fc","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Reduce wine\u2019s strength by adding water, the rejected allaying Tiber. Native weak-cause, without specifying a ratio or claiming the river itself is inherently weak.","id":"shakespeare014.lex.dilute_weaken.sense","status":"draft"}],"status":"draft","variants":[]},"9afaadaa9eb9ba08f1f88a8aa3feba9738ec8e89e7d3255f957002bda56fa990":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: less + rank","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: less + rank","exampleIds":[],"headword":"vimararventhren","id":"shakespeare014.lex.diminish_rank","ipa":"","label":"diminish_rank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"vimararventhren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"Lower one\u2019s standing by an act deemed beneath one\u2019s dignity. The second lord turns Cloten\u2019s anxiety about derogation against him.","id":"shakespeare014.lex.diminish_rank.sense","status":"draft"}],"status":"draft","variants":[]},"2a9fd61e47e9b81384a40e2a2f2fe9a6e2e30c0aa2064387d23984cb095f0e05":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of loss","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of loss","exampleIds":[],"headword":"b\u00e9rven","id":"shakespeare014.lex.diminution_loss","ipa":"","label":"diminution_loss","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u00e9rven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A decrease in rational capacity in Enobarbus\u2019s judgment of Antony; not complete loss of the brain.","id":"shakespeare014.lex.diminution_loss.sense","status":"draft"}],"status":"draft","variants":[]},"eae81691cfaed20c771f239a114f0fef41d1acff9b4c45683c2b00dd3bfd39af":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from cheek, kjv_hollow","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from cheek, kjv_hollow","exampleIds":[],"headword":"ub\u00e1venvorkin","id":"shakespeare014.lex.dimple","ipa":"","label":"dimple","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ub\u00f4venvorkin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A small concavity in a smiling cheek, subsequently compared to a grave/cave.","id":"shakespeare014.lex.dimple.sense","status":"draft"}],"status":"draft","variants":[]},"1ee647c859f4d619dc5cb7e7f5d23e4bbd45e10489961a9226e99e30a76b7004":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: food + wood","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: food + wood","exampleIds":[],"headword":"d\u00cdn\u00d7ry\u00ebl","id":"shakespeare014.lex.dining_board","ipa":"","label":"dining_board","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u0117rn\u0113ry\u00fcl","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A dining board, hence shared sustenance in board and bed; not a writing tablet.","id":"shakespeare014.lex.dining_board.sense","status":"draft"}],"status":"draft","variants":[]},"37689323ecfc9b3ef4bed576132d33b1463ae6ef889f4ee15360f148439d0207":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of table","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of table","exampleIds":[],"headword":"klojvor","id":"shakespeare014.lex.dining_table","ipa":"","label":"dining_table","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"klojvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A table prepared for eating or drinking. Contextual extension of the native table/surface noun; cover means lay the table in this scene, not conceal the Duke or tree.","id":"shakespeare014.lex.dining_table.sense","status":"draft"}],"status":"draft","variants":[]},"5d2cea1af90926d4f8503b200c6ff05bb15867f64f51233b94671572ddeda64e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"diomed","id":"shakespeare014.lex.diomed_attendant_variant","ipa":"","label":"diomed_attendant_variant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"diomed","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The shortened address Diomed used for Cleopatra\u2019s messenger Diomedes. Same referent as diomedes_attendant; source name variation is retained.","id":"shakespeare014.lex.diomed_attendant_variant.sense","status":"draft"}],"status":"draft","variants":[]},"0d8af82b85e4683e97035ffd6288fdecd6b8597f15241d04dc13d6f4d36a1671":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"diomed","id":"shakespeare014.lex.diomed_greek","ipa":"","label":"diomed_greek","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"diomed","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-3.r1"}],"definition":"The Greek warrior who raided Rhesus's tents with Ulysses. Distinct from Cleopatra's attendant.","id":"shakespeare014.lex.diomed_greek.sense","status":"draft"}],"status":"draft","variants":[]},"832e821188064e2bc0a0985fee94ef0f0363351c184141d54ed824dbbdc0253d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"diomedes","id":"shakespeare014.lex.diomedes_attendant","ipa":"","label":"diomedes_attendant","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"diomedes","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Cleopatra\u2019s messenger who corrects the false death report; distinct from the Trojan-war hero of the same name.","id":"shakespeare014.lex.diomedes_attendant.sense","status":"draft"}],"status":"draft","variants":[]},"2b3e33be02dcc10119050f99e2bf9a88002b710495dd543b80137d526de864c9":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"diomedes","id":"shakespeare014.lex.diomedes_greek_full_name","ipa":"","label":"diomedes_greek_full_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"diomedes","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.troilus-and-cressida.r1"}],"definition":"Full name of the Greek warrior also called Diomed, distinct from Cleopatra's attendant.","id":"shakespeare014.lex.diomedes_greek_full_name.sense","status":"draft"}],"status":"draft","variants":[]},"81da679fa80397884c0ea6221e724b88911b5d77d759cd78eb15ee0065d661f1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dion","id":"shakespeare014.lex.dion_oracle_envoy","ipa":"","label":"dion_oracle_envoy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dion","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"The envoy named alongside Cleomenes, returning with Apollo's sealed answer.","id":"shakespeare014.lex.dion_oracle_envoy.sense","status":"draft"}],"status":"draft","variants":[]},"308ffd7becf512efa5b0e1a010500842fe5448060d048c50e46e0d83753ac785":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.pericles.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"diyoniza","id":"shakespeare014.lex.dionyza_tarsus_wife","ipa":"","label":"dionyza_tarsus_wife","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"diyoniza","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.pericles.r1"}],"definition":"Cleon's wife, mother of Philoten and foster guardian of Marina.","id":"shakespeare014.lex.dionyza_tarsus_wife.sense","status":"draft"}],"status":"draft","variants":[]},"38acf0673dd320ccf43f083f20f98340243cdca896adff47d02a9b5d7cfdf794":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: credit + straight + state","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: credit + straight + state","exampleIds":[],"headword":"denlamjeminlen","id":"shakespeare014.lex.directitude_blunder","ipa":"","label":"directitude_blunder","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"denlamjeminlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An intentionally ill-fitting learned-sounding native compound, credit-straight-state, for the servant\u2019s directitude. Context suggests discredit/disgrace but the source sense is uncertain; the next speaker repeats and questions it. This is an authored compensating joke, not an ordinary synonym or an exact phonetic reproduction of the English pun.","id":"shakespeare014.lex.directitude_blunder.sense","status":"draft"}],"status":"draft","variants":[]},"9ae23a9c73c7cc8695dca4a1fcba8e813b4e95bc89203dcdf16d090615a97b7d":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Native compound of mourn, song. A funeral lament, including the threne/Threnos. Native vocabulary, not a respelled Greek heading.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Native compound of mourn, song. A funeral lament, including the threne/Threnos. Native vocabulary, not a respelled Greek heading.","exampleIds":[],"headword":"n\u00d7nsemlil","id":"shakespeare014.lex.dirge","ipa":"","label":"dirge","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u0113nsemlil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"A funeral lament, including the threne/Threnos. Native vocabulary, not a respelled Greek heading.","id":"shakespeare014.lex.dirge.sense","status":"draft"}],"status":"draft","variants":[]},"38071adb27fe6a0ed4262ad732203a3cdb482acaaa8eaed2d3bcfddf26d50e6e":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dis","id":"shakespeare014.lex.dis_underworld_name","ipa":"","label":"dis_underworld_name","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dis","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The underworld ruler who carried off Ceres's daughter. The masque uses his name Dis.","id":"shakespeare014.lex.dis_underworld_name.sense","status":"draft"}],"status":"draft","variants":[]},"de7b1554ffe113bfec40ec1d67d47b736e046e15ad765dd57f5b11b356fbe6fe":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: harm + condition","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: harm + condition","exampleIds":[],"headword":"murf\u00d7venka","id":"shakespeare014.lex.disadvantage_condition","ipa":"","label":"disadvantage_condition","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murf\u0113venka","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An unfavourable position or circumstance in battle, without inventing a specific numerical inferiority or terrain feature.","id":"shakespeare014.lex.disadvantage_condition.sense","status":"draft"}],"status":"draft","variants":[]},"59ab4c79aa2cde181dec877ade13fa6eb94526792e6d3056cedb41b5b8c66e2e":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: weapon + remove","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: weapon + remove","exampleIds":[],"headword":"hefakd\u00c7\u00d3s\u00ebnal\u00e7ztthav","id":"shakespeare014.lex.disarm_weapons","ipa":"","label":"disarm_weapons","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"hefakd\u00e3ths\u00fcnal\u016bztthav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Deprive of a weapon, here the love-god\u2019s torch in Sonnet 154; native weapon-remove.","id":"shakespeare014.lex.disarm_weapons.sense","status":"draft"}],"status":"draft","variants":[]},"def3576a8b6125fdc424ed1b5f89649c8da65ab82acc9213f72982a510b83ac8":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of disaster","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of disaster","exampleIds":[],"headword":"murfraad","id":"shakespeare014.lex.disaster_disfigure","ipa":"","label":"disaster_disfigure","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murfraad","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Bring ruin upon or disfigure a face in the missing-eyes conceit. Explicit verbal use of native disaster; the source\u2019s astrological overtone remains in the source-linked review.","id":"shakespeare014.lex.disaster_disfigure.sense","status":"draft"}],"status":"draft","variants":[]},"e1156a716843849d851e7b0498406b908c3d78995b366aec482d81c75e8b8c94":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: seat + remove","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: seat + remove","exampleIds":[],"headword":"silen\u00e7ztthav","id":"shakespeare014.lex.disbench_unseat","ipa":"","label":"disbench_unseat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"silen\u016bztthav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Make someone leave the bench or seat, Brutus\u2019s question about his words prompting departure. Not formally removing Coriolanus from an office he has not yet received.","id":"shakespeare014.lex.disbench_unseat.sense","status":"draft"}],"status":"draft","variants":[]},"438d7499e75454b20055b4eb6fc674664efe5b6489f406c66ce4b93c67450ab7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: war + rule","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: war + rule","exampleIds":[],"headword":"hefakgurvar\u00dfnen","id":"shakespeare014.lex.discipline_military","ipa":"","label":"discipline_military","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"hefakgurvar\u014dnen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The principles of military practice, repeatedly invoked by Fluellen in his account of the Roman wars.","id":"shakespeare014.lex.discipline_military.sense","status":"draft"}],"status":"draft","variants":[]},"c897b35c366577dab57a50b594c7e9fa70718ae8b9c8b8218f1aceb4873d7446":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from satisfy, no","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from satisfy, no","exampleIds":[],"headword":"memf\u00c5wmav","id":"shakespeare014.lex.discontent","ipa":"","label":"discontent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"memf\u0101wmav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Dissatisfied, in the horse\u2019s deliberately humanlike characterization.","id":"shakespeare014.lex.discontent.sense","status":"draft"}],"status":"draft","variants":[]},"632503a39a62c8e1f615998f519e08f853bf4c5c737a1001ee8230e43aeabfbc":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_discretion","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_discretion","exampleIds":[],"headword":"p\u00e1nw\u00c5vum","id":"shakespeare014.lex.discretion_judgment","ipa":"","label":"discretion_judgment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4nw\u0101vum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Practical judgment and self-command, personified as at war with Lepidus after drinking. Native forethought sense without importing a Biblical teacher or moral injunction.","id":"shakespeare014.lex.discretion_judgment.sense","status":"draft"}],"status":"draft","variants":[]},"d311972ee22eafc54511f9ecc9dfec5590caf410f6b02e55ad802ee7627810be":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: illness","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native derivation/sense: illness","exampleIds":[],"headword":"muren","id":"shakespeare014.lex.disease_ailment","ipa":"","label":"disease_ailment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"muren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"An ailment in the source deliberately odd dulcet diseases phrase; do not silently emend to phrases.","id":"shakespeare014.lex.disease_ailment.sense","status":"draft"}],"status":"draft","variants":[]},"fca7f0458dfa35aa5c8c931290e6a69d6dceb74356349bb2452e99843b62b90a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of disguise","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of disguise","exampleIds":[],"headword":"dlenvelvor","id":"shakespeare014.lex.disguise_drunken","ipa":"","label":"disguise_drunken","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"dlenvelvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Drunkenness as an alteration of appearance or conduct in Caesar\u2019s complaint. Keeps the disguise metaphor without inventing costumes at the feast.","id":"shakespeare014.lex.disguise_drunken.sense","status":"draft"}],"status":"draft","variants":[]},"2214275ab109223b21accee4da7087aed415884eef3b4102063ab59c0482c95c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of food","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of food","exampleIds":[],"headword":"d\u00cdn\u00d7r","id":"shakespeare014.lex.dish_food","ipa":"","label":"dish_food","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u0117rn\u0113r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Prepared food or a dish to be eaten, the countryman\u2019s woman-as-food joke. Reuses the native food noun, not a newly specified plate shape.","id":"shakespeare014.lex.dish_food.sense","status":"draft"}],"status":"draft","variants":[]},"ba8ee350619188c100639cb6e9903dfa169784680260e916dc96844ddbc8fc71":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: not + healthy + mind","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: not + healthy + mind","exampleIds":[],"headword":"mafaren\u00d5\u00dfrw\u00c5vumen","id":"shakespeare014.lex.disinsanity_schoolmaster","ipa":"","label":"disinsanity_schoolmaster","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mafaren\u0167h\u014drw\u0101vumen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"Gerald's pompous description of the rustics' confusion, with the negation put before healthy mind.","id":"shakespeare014.lex.disinsanity_schoolmaster.sense","status":"draft"}],"status":"draft","variants":[]},"5eb9b77c3bf65322ea5b7064005d64b15a3c1cd5d75674eade71eb6b084ab6dc":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of dismiss","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of dismiss","exampleIds":[],"headword":"thavgaz\u00e9m","id":"shakespeare014.lex.dismission_leave","ipa":"","label":"dismission_leave","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thavgaz\u00e9m","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Dismissal or leave to depart, in Cleopatra\u2019s claim that Caesar has recalled Antony. Keeps the source\u2019s ironic authority reversal without turning it into dismissal from his military office.","id":"shakespeare014.lex.dismission_leave.sense","status":"draft"}],"status":"draft","variants":[]},"7c66f1a9d7eb12fe206cc2172e16217795b0f7016429236885a1104cc0dec959":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of pride","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of pride","exampleIds":[],"headword":"nasevar","id":"shakespeare014.lex.display_splendour","ipa":"","label":"display_splendour","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"nasevar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Visible magnificence of the robe kept out of sight in Sonnet 52; not necessarily arrogance.","id":"shakespeare014.lex.display_splendour.sense","status":"draft"}],"status":"draft","variants":[]},"36cca91e6d884b9aae3a1bb47e410300b7a904384084628529b0833075bb9a37":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: possess + remove","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: possess + remove","exampleIds":[],"headword":"\u00d1\u00c5z\u00e7ztthav","id":"shakespeare014.lex.disproperty_rights","ipa":"","label":"disproperty_rights","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ch\u0101z\u016bztthav","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Deprive people of their freedoms as if taking their property, in the tribunes\u2019 accusation; not a narrator assertion that the confiscation happened.","id":"shakespeare014.lex.disproperty_rights.sense","status":"draft"}],"status":"draft","variants":[]},"85da2df240f11744c6537135a9d9ac6dbb0678a1942b2ff54f56556bad6de11a":{"audioLinks":[],"citations":[{"locator":"Authored native compound: cut + look","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: cut + look","exampleIds":[],"headword":"dest\u00eb\u00c5veritas","id":"shakespeare014.lex.dissect_examine","ipa":"","label":"dissect_examine","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"dest\u00fc\u0101veritas","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Cut open for examination; figuratively expose the wise man\u2019s folly in Jaques\u2019s speech. Native cut + look. No actual surgery or corpse is introduced.","id":"shakespeare014.lex.dissect_examine.sense","status":"draft"}],"status":"draft","variants":[]},"2d3ca0ef32e97681b21dd6228ff89b559992a7ce3a5393e01f19d9b2ebb75d1e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_dissemble","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Reviewed contextual sense of kjv_dissemble","exampleIds":[],"headword":"o\u00c3bratrat\u00e9k","id":"shakespeare014.lex.dissemble","ipa":"","label":"dissemble","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ojzhbratrat\u00e9k","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Conceal by deceptive conduct; here Venus denies hiding her alarm.","id":"shakespeare014.lex.dissemble.sense","status":"draft"}],"status":"draft","variants":[]},"aaa65d01ca8e2f3a203fe2e43ec1934594957d637458b599a0eba32542a006ad":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: apart + assemble","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: apart + assemble","exampleIds":[],"headword":"stras\u00ebwz\u00dfgu\u00d9","id":"shakespeare014.lex.dissembly_dogberry_error","ipa":"","label":"dissembly_dogberry_error","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"stras\u00fcwz\u014dgung","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"Dogberry breaks his assembly apart while asking whether the whole company has assembled.","id":"shakespeare014.lex.dissembly_dogberry_error.sense","status":"draft"}],"status":"draft","variants":[]},"c3298eb71a9aab006953b7e5a35836471362bdf93cd8d69d5985dd6dac6c76d9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: disagree","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: disagree","exampleIds":[],"headword":"amo\u00d1","id":"shakespeare014.lex.dissension_dispute","ipa":"","label":"dissension_dispute","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"amoch","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A disagreement or quarrel that can rupture friendship over a tiny coin. Explicit nominal disagree; no unstated sum is assigned to the dispute.","id":"shakespeare014.lex.dissension_dispute.sense","status":"draft"}],"status":"draft","variants":[]},"0f5aae33fef5f332b6497612e9a2b0c9a7b21ebf52e26c76f895ad36b7ff0f32":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: strife","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: strife","exampleIds":[],"headword":"hefak","id":"shakespeare014.lex.dissentious_quarrel","ipa":"","label":"dissentious_quarrel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"hefak","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Prone to dissension, Martius\u2019s accusation against the protesting citizens; not a neutral narrator judgment.","id":"shakespeare014.lex.dissentious_quarrel.sense","status":"draft"}],"status":"draft","variants":[]},"53cca3028212cba34911f7e9efaca922a132dde9acbe5001702a3588990243d4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: thread + staff","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: thread + staff","exampleIds":[],"headword":"thirilteral","id":"shakespeare014.lex.distaff_spin","ipa":"","label":"distaff_spin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thirilteral","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The tool holding fiber for spinning, imagined turned into a lance by the defenders\u2019 courage.","id":"shakespeare014.lex.distaff_spin.sense","status":"draft"}],"status":"draft","variants":[]},"9be89fff8d88759460e7ac30f87e53694be2103f1cce1203bc409cce253928ea":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of distil","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of distil","exampleIds":[],"headword":"merin","id":"shakespeare014.lex.distillate","ipa":"","label":"distillate","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"merin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The liquid essence left by distillation; nominal result, the prisoner in glass in Sonnet 5.","id":"shakespeare014.lex.distillate.sense","status":"draft"}],"status":"draft","variants":[]},"a129c9d0dd9ab1c29b34f29ee33f320a3f1fcc48059184272c3e2e9c2a56b4ff":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from distil, vessel","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from distil, vessel","exampleIds":[],"headword":"merinborel","id":"shakespeare014.lex.distilling_vessel","ipa":"","label":"distilling_vessel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"merinborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A vessel/apparatus for distillation, the figurative source of the face\u2019s fragrant breath; not a modern laboratory specification.","id":"shakespeare014.lex.distilling_vessel.sense","status":"draft"}],"status":"draft","variants":[]},"56f14da6cc06c27abf6a803869683ae03c730250f26f8764a11c5a3cb246bc0c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of frantic","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of frantic","exampleIds":[],"headword":"w\u00c5vumenstrasf\u00c5w","id":"shakespeare014.lex.distraction_frenzy","ipa":"","label":"distraction_frenzy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"w\u0101vumenstrasf\u0101w","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The mind\u2019s agitated scattering in Sonnet 119\u2019s maddening fever; nominal use of the native mind-release formation, not the English-like frenzy stem or an imposed modern diagnosis.","id":"shakespeare014.lex.distraction_frenzy.sense","status":"draft"}],"status":"draft","variants":[]},"14bc1e1acd34bf3db49b7c7bbe4d7e1ad66234c533e4138c44bc3ffa30633b2b":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of doubt","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of doubt","exampleIds":[],"headword":"lamves","id":"shakespeare014.lex.distrust_person","ipa":"","label":"distrust_person","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"lamves","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Doubt in another person\u2019s promised conduct, Antony\u2019s response to Caesar\u2019s warning. Native doubt used as an interpersonal noun; not a numerical uncertainty estimate or a proven accusation of betrayal.","id":"shakespeare014.lex.distrust_person.sense","status":"draft"}],"status":"draft","variants":[]},"a763a4a149d0f01fdcdfdf42fc677d9a2e8dca2b9bc6d243d586f2ff38fae5a7":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_ditch","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_ditch","exampleIds":[],"headword":"jo\u00d9dest\u00eb\u00c5","id":"shakespeare014.lex.ditch_channel","ipa":"","label":"ditch_channel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongdest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A low cut in the ground which Enobarbus seeks as a place to die; not a preselected grave or a stated modern drainage structure.","id":"shakespeare014.lex.ditch_channel.sense","status":"draft"}],"status":"draft","variants":[]},"61173043baf07df9db4586e1d4ecff5c3aec3e970fc2812e14004a1d69e210b1":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_ditch","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_ditch","exampleIds":[],"headword":"jo\u00d9dest\u00eb\u00c5","id":"shakespeare014.lex.ditch_ground","ipa":"","label":"ditch_ground","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongdest\u00fc\u0101","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A ditch in the ground imagined as Cleopatra\u2019s gentler grave. Reuses the native ground-cut noun; no new depth, location within Egypt, or digging action is added.","id":"shakespeare014.lex.ditch_ground.sense","status":"draft"}],"status":"draft","variants":[]},"fea4601aa054de7d2525d05bd18e0ad0c54edff08fe8a3fabfe8274b5532828f":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from down, swim","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from down, swim","exampleIds":[],"headword":"velnimir","id":"shakespeare014.lex.dive","ipa":"","label":"dive","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"velnimir","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Go down into water; distinct from diving through air or merely swimming on the surface.","id":"shakespeare014.lex.dive.sense","status":"draft"}],"status":"draft","variants":[]},"d9f3cd315b5facb8cd0285d5dc76fd1acac0789caec7a7e71c4b38833da1df6c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_divide","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_divide","exampleIds":[],"headword":"threnina\u00d9","id":"shakespeare014.lex.divide","ipa":"","label":"divide","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"threninang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Separate a whole into parts, the blood into two streams.","id":"shakespeare014.lex.divide.sense","status":"draft"}],"status":"draft","variants":[]},"9a9183f1ed03bf1cdcb66395c6d8637ec2e25e73ee1bf2967ae2b40de8cd7b5a":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from before, know","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from before, know","exampleIds":[],"headword":"p\u00e1nh\u00c5b\u00cd","id":"shakespeare014.lex.divination","ipa":"","label":"divination","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"p\u00f4nh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Purported knowledge of what is to come, here taught by fear rather than independently guaranteed.","id":"shakespeare014.lex.divination.sense","status":"draft"}],"status":"draft","variants":[]},"572e559f741295b7f2458d070eb0911019aecf81548695bbb2265425807570c6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: god + work","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: god + work","exampleIds":[],"headword":"prodvard\u00c7\u00d3s\u00dflum","id":"shakespeare014.lex.divine_agent","ipa":"","label":"divine_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodvard\u00e3ths\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A person acting as the gods\u2019 principal business agent in Pompey\u2019s address to the rulers. Native god-worker, preserving factors as representatives rather than arithmetic factors.","id":"shakespeare014.lex.divine_agent.sense","status":"draft"}],"status":"draft","variants":[]},"379d838210378d4225feaa90bf01379f178322035caa10e9f85f328ff18fa8a4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: god + teach + person","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: god + teach + person","exampleIds":[],"headword":"prodvarpomf\u00c5ws\u00dflum","id":"shakespeare014.lex.divine_cleric","ipa":"","label":"divine_cleric","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodvarpomf\u0101ws\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A religious teacher whose virtues or moral teachings are wasted upon the commoners in Coriolanus\u2019s contemptuous claim. Not a deity or a predictor, and not a narrator assertion that citizens lack virtue.","id":"shakespeare014.lex.divine_cleric.sense","status":"draft"}],"status":"draft","variants":[]},"ae2bae867ebbaff36de4a4b833e8e6f7694248abd39866d45376651f1db36f27":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_godhead_acts","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kjv_godhead_acts","exampleIds":[],"headword":"prodvarlen","id":"shakespeare014.lex.divine_nature","ipa":"","label":"divine_nature","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"prodvarlen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Divine nature or condition in Phoebe\u2019s god-disguised-as-shepherd conceit. Native god-state; no biblical person, Trinity doctrine or exact divine number imported.","id":"shakespeare014.lex.divine_nature.sense","status":"draft"}],"status":"draft","variants":[]},"fa085bea1bd13677f32024473128fad06099f30034fb707094bbbe302010320a":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of divination","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of divination","exampleIds":[],"headword":"p\u00e1nh\u00c5b\u00cd","id":"shakespeare014.lex.divine_predict","ipa":"","label":"divine_predict","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"p\u00f4nh\u0101b\u0117r","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Make a prediction about an alliance\u2019s future, an action distinct from divine as the adjective belonging to a god. The forecast remains Enobarbus\u2019s judgment.","id":"shakespeare014.lex.divine_predict.sense","status":"draft"}],"status":"draft","variants":[]},"212c0b634d1765b142e14ce69d30dd1c4b6304af74f56cccda153f2fe594f08c":{"audioLinks":[],"citations":[{"locator":"Native dive plus bird compound lexicalized for this named waterbird.","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native dive plus bird compound lexicalized for this named waterbird.","exampleIds":[],"headword":"velnimirwil","id":"shakespeare014.lex.diving_bird","ipa":"","label":"diving_bird","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velnimirwil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Divedapper/dabchick, the little diving waterbird of the simile; no narrower modern taxonomic identification is imposed.","id":"shakespeare014.lex.diving_bird.sense","status":"draft"}],"status":"draft","variants":[]},"748bc029098cd5d9f924c9f71d29ebce0fb0584af301d8ee629df28b01505e47":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"olyen","id":"shakespeare014.lex.dizzy","ipa":"","label":"dizzy","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"olyen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Disorienting or giddily turning, the movement of Fortune\u2019s wheel; authored circle-family state word, not a clinical diagnosis.","id":"shakespeare014.lex.dizzy.sense","status":"draft"}],"status":"draft","variants":[]},"e2cb4612afb98fa37cdb678a0491ed25313b25c026e318e0260169f30c600685":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dizzy","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: dizzy","exampleIds":[],"headword":"olyen","id":"shakespeare014.lex.dizzy_prison_customer","ipa":"","label":"dizzy_prison_customer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"olyen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The young man listed among the bawd's former customers.","id":"shakespeare014.lex.dizzy_prison_customer.sense","status":"draft"}],"status":"draft","variants":[]},"eeecf15637d63be1c12a33969d705312264be8bd697284422ff6832c789ccb19":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dobin","id":"shakespeare014.lex.dobbin_gobbo_horse","ipa":"","label":"dobbin_gobbo_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dobin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-merchant-of-venice.r1"}],"definition":"Gobbo's shaft horse, whose tail serves as a measure of Lancelet's supposed beard.","id":"shakespeare014.lex.dobbin_gobbo_horse.sense","status":"draft"}],"status":"draft","variants":[]},"bd5ffa402212ba7252d9d7fa58272e19d70d57351338514603e0758537c6f2d4":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: broad + leaf","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Authored native derivation or sense: broad + leaf","exampleIds":[],"headword":"gimkiny\u00eblet","id":"shakespeare014.lex.dock_weed","ipa":"","label":"dock_weed","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gimkiny\u00fclet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The broad-leaf weed Burgundy calls hateful in the neglected meadow.","id":"shakespeare014.lex.dock_weed.sense","status":"draft"}],"status":"draft","variants":[]},"2ffff434aabbce13ae77a7e64b009d3b3f7c3280954318cac7e5985c58cd95a9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: doctor","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Authored native derivation or sense: doctor","exampleIds":[],"headword":"faders\u00dflum","id":"shakespeare014.lex.doctor_dunsinane_court","ipa":"","label":"doctor_dunsinane_court","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"faders\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"The Scottish physician who witnesses Lady Macbeth sleepwalking. His native role label matches that of the distinct English doctor.","id":"shakespeare014.lex.doctor_dunsinane_court.sense","status":"draft"}],"status":"draft","variants":[]},"f40c8a9233fa3e5ea9019131093c5b89acb58991df728cd498ba33a67031b4d3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: doctor","sourceId":"shakespeare014.source.macbeth.r1"}],"etymology":"Authored native derivation or sense: doctor","exampleIds":[],"headword":"faders\u00dflum","id":"shakespeare014.lex.doctor_edward_court","ipa":"","label":"doctor_edward_court","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"faders\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.macbeth.r1"}],"definition":"The unnamed English doctor who reports patients awaiting Edward. Only his office prints.","id":"shakespeare014.lex.doctor_edward_court.sense","status":"draft"}],"status":"draft","variants":[]},"4b01b52fd2b69a4332823f78c8a71ce02fac5a0693d460376dccea1eb9d6b90e":{"audioLinks":[],"citations":[{"locator":"Authored native compound: female + deer","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: female + deer","exampleIds":[],"headword":"zannavelnor","id":"shakespeare014.lex.doe_deer","ipa":"","label":"doe_deer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zannavelnor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Female deer in Orlando\u2019s comparison of himself seeking food for Adam. Native female + deer; not a claim that Orlando or Adam is literally an animal.","id":"shakespeare014.lex.doe_deer.sense","status":"draft"}],"status":"draft","variants":[]},"75993cbe9371098312d2d5d136916d652991527534e6db68c14b88ef5dd19dfc":{"audioLinks":[],"citations":[{"locator":"Authored native compound: dog + monkey","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: dog + monkey","exampleIds":[],"headword":"b\u00cfebvirel","id":"shakespeare014.lex.dog_ape_native","ipa":"","label":"dog_ape_native","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u00cfebvirel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The dog-faced ape/baboon category of Jaques\u2019s comparison of ceremonial courtesies. Native dog + monkey is lexicalized here; no claim of a dog-primate hybrid or precise modern species. Avoids unsupported ape/apen sound copying.","id":"shakespeare014.lex.dog_ape_native.sense","status":"draft"}],"status":"draft","variants":[]},"024305138d5bd3679d7ff782fb58a3a1259689da5106cfff65a0e092044be7ad":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dog + bush + fruit","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Authored native derivation or sense: dog + bush + fruit","exampleIds":[],"headword":"b\u00cfebthesilvenam","id":"shakespeare014.lex.dogberry_messina_constable","ipa":"","label":"dogberry_messina_constable","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"b\u00cfebthesilvenam","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"The constable's speaking name expressed with dog, bush and fruit.","id":"shakespeare014.lex.dogberry_messina_constable.sense","status":"draft"}],"status":"draft","variants":[]},"6b64b0cd063bf1d135dde8828ed62dcae35decf2c6620f7870a6dc95268ba40a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dog + fish_creature","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Authored native derivation or sense: dog + fish_creature","exampleIds":[],"headword":"b\u00cfebdrig\u00e1l","id":"shakespeare014.lex.dogfish_shark","ipa":"","label":"dogfish_shark","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"b\u00cfebdrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Talbot degrades the French prince to a dogfish in his taunt.","id":"shakespeare014.lex.dogfish_shark.sense","status":"draft"}],"status":"draft","variants":[]},"b83436a38f6a88803c5c4a98d2784343ecad258e4678cfafbfc3c17d3d3878f6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_copper + money","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_copper + money","exampleIds":[],"headword":"zar\u00dfmzarven","id":"shakespeare014.lex.doit_coin","ipa":"","label":"doit_coin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zar\u014dmzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The source doit denomination, lexicalized native copper-money, a small-value coin in the loot inventory. Preserve the cultural denomination without an English/Dutch sound loan, modern conversion, or inferred exact fraction of a different currency.","id":"shakespeare014.lex.doit_coin.sense","status":"draft"}],"status":"draft","variants":[]},"e404ece053d44925743db8d14ce5a95f31f7feda77d53c93aaf27ae2b3932297":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: doit_coin","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: doit_coin","exampleIds":[],"headword":"zar\u00dfmzarven","id":"shakespeare014.lex.doit_companion","ipa":"","label":"doit_companion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"zar\u014dmzarven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The coin surname of Shallow's companion John.","id":"shakespeare014.lex.doit_companion.sense","status":"draft"}],"status":"draft","variants":[]},"c69c7d46c39f3c71f32914fd4f1a6d59d514378aa30489319d6ec9677