itted phonetic personal-name adaptation","exampleIds":[],"headword":"blunt","id":"shakespeare014.lex.blunt_richmond_captain","ipa":"","label":"blunt_richmond_captain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"blunt","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"Captain Blunt, named Sir James in Christopher's roll. Distinct from Walter Blunt and other Blunts in the histories.","id":"shakespeare014.lex.blunt_richmond_captain.sense","status":"draft"}],"status":"draft","variants":[]},"cb1f14d6528faa3caa433f870a6ac4106bed72896d23e0ff50cf4a6f35b8db61":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_ship_boat_acts","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of kjv_ship_boat_acts","exampleIds":[],"headword":"viminmeran","id":"shakespeare014.lex.boat","ipa":"","label":"boat","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"viminmeran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"A small vessel, the poet\u2019s modest craft in Sonnet 80; no inherited shipwreck participants or subsidiary-boat story are introduced.","id":"shakespeare014.lex.boat.sense","status":"draft"}],"status":"draft","variants":[]},"4b0da4e2ccdcd06db6e246e622f4698df0f3c36943d849fb307d7f54dc82483b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: sail + keeper","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: sail + keeper","exampleIds":[],"headword":"enifelenjem\u00e3s\u00dflum","id":"shakespeare014.lex.boatswain_ship_officer","ipa":"","label":"boatswain_ship_officer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"enifelenjemois\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"The working officer who gives sail-handling orders and calls on the passengers to keep clear.","id":"shakespeare014.lex.boatswain_ship_officer.sense","status":"draft"}],"status":"draft","variants":[]},"eb804c00cb1e9ee4dfa7db80961df89d0cc21a1bd837b907498f3ab893b53c3c":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic adaptation of a personal or place name.","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Author-permitted phonetic adaptation of a personal or place name.","exampleIds":[],"headword":"bokus","id":"shakespeare014.lex.bocchus_king","ipa":"","label":"bocchus_king","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"bokus","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The king named with Libya in Caesar\u2019s allied roster. Preserve the supplied name and association without silently correcting historical dates or title.","id":"shakespeare014.lex.bocchus_king.sense","status":"draft"}],"status":"draft","variants":[]},"cf745ca4003c4c7f4763f0280d21e8404470e1dd1cf55a1c8b2b304a6bf6a3a7":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: chest + cloth","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: chest + cloth","exampleIds":[],"headword":"gorenborelfelen","id":"shakespeare014.lex.bodice_front","ipa":"","label":"bodice_front","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"gorenborelfelen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"The front of a woman's garment over her breast. Letters that have lain there are figuratively stomachers to Imogen's heart.","id":"shakespeare014.lex.bodice_front.sense","status":"draft"}],"status":"draft","variants":[]},"574f991339e0fcf541354a85cd0023e42073ed1fcbb2f435458ed4fe8f23e267":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: desire","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: desire","exampleIds":[],"headword":"\u00c9lm","id":"shakespeare014.lex.bodily_affection","ipa":"","label":"bodily_affection","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u00e4lm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The body\u2019s shared appetites or inclinations, broader than romantic love.","id":"shakespeare014.lex.bodily_affection.sense","status":"draft"}],"status":"draft","variants":[]},"5dcee1fb62eb2ce70b2214d5e53f28399d86e6c56ddf96bc343e07513bbfcd8d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: body + make","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: body + make","exampleIds":[],"headword":"vora\u00d9","id":"shakespeare014.lex.bodily_fabric","ipa":"","label":"bodily_fabric","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorang","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"The constructed bodily frame in the political fable, not woven cloth.","id":"shakespeare014.lex.bodily_fabric.sense","status":"draft"}],"status":"draft","variants":[]},"1db15a288d77a77db4bd49f3ee65daa1b0d36360e0118e1d110174979a646578":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of touch","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of touch","exampleIds":[],"headword":"voril","id":"shakespeare014.lex.bodily_feeling","ipa":"","label":"bodily_feeling","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"voril","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"The bodily faculty of touch in Sonnet 141, distinguished from emotional sentiment and named beside the other senses.","id":"shakespeare014.lex.bodily_feeling.sense","status":"draft"}],"status":"draft","variants":[]},"8981d19c8ef86e040a7bf37f855b651ef82373ba3045807d78208599a933be8e":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of ornament","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Reviewed contextual sense of ornament","exampleIds":[],"headword":"el\u00ebin\u00d1et","id":"shakespeare014.lex.bodily_flourish","ipa":"","label":"bodily_flourish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"el\u00fcinchet","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Youthful visible splendour pierced by Time in Sonnet 60; not the existing musical fanfare sense.","id":"shakespeare014.lex.bodily_flourish.sense","status":"draft"}],"status":"draft","variants":[]},"05f5fd372bfb4df2f9bf51971d8d421a9a31a23234cc44ad6a6f34eff463ae31":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_member_body_romans","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_member_body_romans","exampleIds":[],"headword":"vorthrenin","id":"shakespeare014.lex.bodily_member","ipa":"","label":"bodily_member","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A bodily member, the generative members in Enobarbus\u2019s tailor metaphor. The source may also evoke persons who make replacement clothing; the target retains the bodily image without listing organs or importing Paul\u2019s moral argument.","id":"shakespeare014.lex.bodily_member.sense","status":"draft"}],"status":"draft","variants":[]},"7b3ffa552c2ba234479e097ecd3500408a017e3283a61531d302d64bbbd9f02e":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: nourish","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: nourish","exampleIds":[],"headword":"wemar\u00d5\u00dfr","id":"shakespeare014.lex.bodily_sustenance","ipa":"","label":"bodily_sustenance","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"wemar\u0167h\u014dr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Sufficient bodily sustenance, source natural competency, not modern job competence. Amount sufficiency belongs to the clause rather than an invented numerical ration.","id":"shakespeare014.lex.bodily_sustenance.sense","status":"draft"}],"status":"draft","variants":[]},"105721e79c4c0b70d04cb37df40a3bd16f264efe1a72c752239711fe93197d2f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: needle + dagger","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: needle + dagger","exampleIds":[],"headword":"jelinkeranvimin","id":"shakespeare014.lex.bodkin_blade","ipa":"","label":"bodkin_blade","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jelinkeranvimin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"The small pointed blade paired with a figurative settling of accounts in Hamlet's meditation.","id":"shakespeare014.lex.bodkin_blade.sense","status":"draft"}],"status":"draft","variants":[]},"f739f125ce550db90fb639fca4de52d2b765b066070e2935d8ce3fb9c4ec76a1":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from body, act","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from body, act","exampleIds":[],"headword":"vorfalnthren","id":"shakespeare014.lex.body_agent","ipa":"","label":"body_agent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorfalnthren","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"A bodily faculty or part acting toward pleasure after sight; the text leaves exact organs unnamed.","id":"shakespeare014.lex.body_agent.sense","status":"draft"}],"status":"draft","variants":[]},"399d530ec6354048ad59fa889299a460b4ce58b912516242fbd8d5add6073420":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_back_body","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_back_body","exampleIds":[],"headword":"tar","id":"shakespeare014.lex.body_back","ipa":"","label":"body_back","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"tar","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The bodily back in Cleopatra\u2019s dolphin simile. Reuses the dorsal-body sense, distinct from the adverb back; no source or internal lookup label prints.","id":"shakespeare014.lex.body_back.sense","status":"draft"}],"status":"draft","variants":[]},"8e468a24ba0531e728cf9db491e086d631b686a1a7d700969d8ca5d8fecc8dc9":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: turn","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: turn","exampleIds":[],"headword":"elyi\u00d1","id":"shakespeare014.lex.body_crank","ipa":"","label":"body_crank","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"elyich","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A winding passage of the body in the fable, not a machine handle or an eccentric person.","id":"shakespeare014.lex.body_crank.sense","status":"draft"}],"status":"draft","variants":[]},"b7b5163f17342043e6e19d6c9c361ac7955ed1840311ff25d173c3ac4b14e3a6":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of grow","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of grow","exampleIds":[],"headword":"ragum","id":"shakespeare014.lex.body_growth","ipa":"","label":"body_growth","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ragum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Nominal growth of a young man\u2019s body in Le Beau\u2019s description; physical development, not rank vegetation or social promotion.","id":"shakespeare014.lex.body_growth.sense","status":"draft"}],"status":"draft","variants":[]},"2ce56410fe2bb6f4fcea61f1eb3d52fa9807ca78ce23b7d079660c67a5b96b52":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of form","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of form","exampleIds":[],"headword":"l\u00dfn","id":"shakespeare014.lex.body_lineament","ipa":"","label":"body_lineament","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"l\u014dn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"A bodily feature or contour in Rosalind\u2019s distinction between innate Nature and worldly Fortune; not a political boundary.","id":"shakespeare014.lex.body_lineament.sense","status":"draft"}],"status":"draft","variants":[]},"d4f0f3055af86ce2b57d39abb1d83cad42744c8f49897b838909483fb69f4e10":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: body + part","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: body + part","exampleIds":[],"headword":"vorthrenin","id":"shakespeare014.lex.body_member","ipa":"","label":"body_member","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A part or organ of the body in the political fable, not restricted to arms and legs.","id":"shakespeare014.lex.body_member.sense","status":"draft"}],"status":"draft","variants":[]},"78da7a78eb48e472161f4e0e7d72ccb30226fc102b6070bbb0bafab830360672":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: service","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: service","exampleIds":[],"headword":"d\u00c7ven","id":"shakespeare014.lex.body_office","ipa":"","label":"body_office","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u00e3ven","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"An organ\u2019s function or bodily service in the fable, rather than a room or a modern administrative department.","id":"shakespeare014.lex.body_office.sense","status":"draft"}],"status":"draft","variants":[]},"9c5b83fae5d5b1d7f68ad973cc58f338a3aacf4c9fdde0e82c7e95b4da02c710":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of bodily_member","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of bodily_member","exampleIds":[],"headword":"vorthrenin","id":"shakespeare014.lex.body_organ","ipa":"","label":"body_organ","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vorthrenin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"An acting part of the body in Antony\u2019s deliberately uninformative crocodile description. Not a musical instrument, organization or exclusively generative organ.","id":"shakespeare014.lex.body_organ.sense","status":"draft"}],"status":"draft","variants":[]},"6f94fd32544c280424f73fac9c8a85021a69c6b79389ddab7d1075310cbd4b39":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_fish_scale","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_fish_scale","exampleIds":[],"headword":"drig\u00e1lshalem","id":"shakespeare014.lex.body_scale","ipa":"","label":"body_scale","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"drig\u00f4lshalem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A scale on a serpent\u2019s body, extending the existing native bodily-scale category from aquatic creatures. Not weighing scales, stairs or a musical scale.","id":"shakespeare014.lex.body_scale.sense","status":"draft"}],"status":"draft","variants":[]},"44046404171566221ad87b32ae5d712e8f321fee5e5e6a57342df5be950c3b52":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: dirty + hole","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: dirty + hole","exampleIds":[],"headword":"murmayatdul","id":"shakespeare014.lex.body_sink","ipa":"","label":"body_sink","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"murmayatdul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A collecting drain or receptacle for bodily refuse, the citizen\u2019s insult to the belly; native dirty-hole, not the act of sinking underwater.","id":"shakespeare014.lex.body_sink.sense","status":"draft"}],"status":"draft","variants":[]},"1936c735d8d8fe81d4e62baae182cf5e9cd3ecee2a3809c48529cb19cabf293b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: change + mind","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: change + mind","exampleIds":[],"headword":"\u00e3lumw\u00c5vumens\u00dflum","id":"shakespeare014.lex.boggler_waverer","ipa":"","label":"boggler_waverer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"oilumw\u0101vumens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A person who changes allegiance or intention; Antony\u2019s accusation, not an author verdict.","id":"shakespeare014.lex.boggler_waverer.sense","status":"draft"}],"status":"draft","variants":[]},"c956398b091b34449d65b9f4c27695fc119aba4fd6650f9bd6569a22a1759256":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"bohemiya","id":"shakespeare014.lex.bohemia_barnardine_birthplace","ipa":"","label":"bohemia_barnardine_birthplace","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"bohemiya","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The country of Barnardine's birth. The provost says he was reared in Vienna.","id":"shakespeare014.lex.bohemia_barnardine_birthplace.sense","status":"draft"}],"status":"draft","variants":[]},"600c2f101a8f928686512d589d69d9c687c5ba06c43d3df91a0e41fdf5940f0b":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-winters-tale.r1"}],