:"The divine twin by whom Theseus swears when he interrupts the duel. Uses the inherited form of the name. The ship's figurehead in Acts is a separate reference.","id":"shakespeare014.lex.castor_theseus_oath.sense","status":"draft"}],"status":"draft","variants":[]},"a88b6f4d8412b50ca8438eb3f4c406d98927c20379dcba5d0c93646b42a57208":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: return + song","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: return + song","exampleIds":[],"headword":"sezif\u00c7\u00c3lil","id":"shakespeare014.lex.catch_musical_round","ipa":"","label":"catch_musical_round","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"sezif\u00e3jzhlil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"A song with successive entries of the same tune. Caliban asks Stephano and Trinculo to sing it.","id":"shakespeare014.lex.catch_musical_round.sense","status":"draft"}],"status":"draft","variants":[]},"224955e3a54b09e9d72b96ff391e2f1b439253bd5fb2aa4675ce26474ff70895":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: catch + song","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Authored native derivation or sense: catch + song","exampleIds":[],"headword":"\u00e7ztjemlil","id":"shakespeare014.lex.catch_voices_song","ipa":"","label":"catch_voices_song","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"\u016bztjemlil","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"A part-song whose voices enter by turns. The same native catch root is heard in the dog joke.","id":"shakespeare014.lex.catch_voices_song.sense","status":"draft"}],"status":"draft","variants":[]},"02c35ee39ecee4aef9fd000a65e0e7362abd1d3406ad682b9edfa536958e8f0c":