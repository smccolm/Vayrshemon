ecision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Form or fashioned appearance in Touchstone\u2019s feature/features exchange. The native form noun leaves bodily appearance and a fashioned literary piece available; the disputed poem reading is not silently imposed as certain.","id":"shakespeare014.lex.feature_form.sense","status":"draft"}],"status":"draft","variants":[]},"f78be6fd2c171dc49855f330dd599c7408a03729cbf73129a7c36c0e8406ed61":{"audioLinks":[],"citations":[{"locator":"Source-calendar name using the second spoken Unta ordinal and the native month word.","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"etymology":"Source-calendar name using the second spoken Unta ordinal and the native month word.","exampleIds":[],"headword":"\u00d3\u00c5tus\u2019t venlun","id":"shakespeare014.lex.february_source_month","ipa":"","label":"february_source_month","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"th\u0101tus\u2019t venlun","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.much-ado-about-nothing.r1"}],"definition":"February, second month of the source calendar. Pedro likens Benedick's face to its stormy weather.","id":"shakespeare014.lex.february_source_month.sense","status":"draft"}],"status":"draft","variants":[]},"aad2b22f192742755f731185d173a3c85e14998360ba195389426f6209e2a8be":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: feeble","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: feeble","exampleIds":[],"headword":"vimjw\u00ebn","id":"shakespeare014.lex.feeble_recruit","ipa":"","label":"feeble_recruit","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"vimjw\u00fcn","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The woman's tailor whose courage contradicts his name.","id":"shakespeare014.lex.feeble_recruit.sense","status":"draft"}],"status":"draft","variants":[]},"5fb13b118ac94bb3ffcd143f594c6f6fd95af585bf1a020e8baeaa63edf4e81d":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of servant","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of servant","exampleIds":[],"headword":"d\u00c7v","id":"shakespeare014.lex.feeder_dependent","ipa":"","label":"feeder_dependent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"d\u00e3v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"A dependent at another\u2019s table, used contemptuously by Antony of Cleopatra\u2019s supposed object of attention.","id":"shakespeare014.lex.feeder_dependent.sense","status":"draft"}],"status":"draft","variants":[]},"b9a9998e435fd8a3a08b34c33bd55eb005cad99fd807cd94692a5bb40db5015c":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of feign","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of feign","exampleIds":[],"headword":"fengolh\u00dfm","id":"shakespeare014.lex.feigning_noun","ipa":"","label":"feigning_noun","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"fengolh\u014dm","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"Pretence as an activity or condition, nominal use of native feign. In the song, friendship is said to be pretence, not an agent that pretends on somebody\u2019s behalf.","id":"shakespeare014.lex.feigning_noun.sense","status":"draft"}],"status":"draft","variants":[]},"828517438d81acd2b412d0bbda650c563e77b0669636c034f0aea7784e386087":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_marsh","sourceId":"shakes