hakespeare014.source.coriolanus.r1"}],"definition":"Beneficial to health, Martius\u2019s claim that losing blood helps rather than harms him; source physical, not the general bodily-versus-mental distinction or medical advice.","id":"shakespeare014.lex.physical_health.sense","status":"draft"}],"status":"draft","variants":[]},"4dcf4b75dd3ff8ead63de80cbc731539bce2677a14ba90e3831ae9387ac95d0d":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"pikardi","id":"shakespeare014.lex.picardy_region","ipa":"","label":"picardy_region","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"pikardi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The region named after Walloon by Talbot.","id":"shakespeare014.lex.picardy_region.sense","status":"draft"}],"status":"draft","variants":[]},"b23538461bb086d1107897650de8cdb590d80cb3c1a78a14e8795ce4c33319c5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: pick + bone","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: pick + bone","exampleIds":[],"headword":"\u00e7ztdestkran","id":"shakespeare014.lex.pickbone_companion","ipa":"","label":"pickbone_companion","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"\u016bztdestkran","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"The telling surname borne by Francis Pickbone.","id":"shakespeare014.lex.pickbone_companion.sense","status":"draft"}],"status":"draft","variants":[]},"d8ce961c4446b1db43c03ef1b6a571d4c9a0f3c1ac9478f151a482f04fba4925":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: drama_native_salt + water","sourceId":"shakespeare014.source.the-tempest.r1"}],"etymology":"Authored native derivation or sense: drama_native_salt + water","exampleIds":[],"headword":"yemkwesyems\u00d7","id":"shakespeare014.lex.pickle_salt_brine","ipa":"","label":"pickle_salt_brine","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"yemkwesyems\u0113","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-tempest.r1"}],"definition":"Preserving brine, with a secondary sense of a sorry predicament. Trinculo follows this joke by speaking of his bones and flesh-flies.","id":"shakespeare014.lex.pickle_salt_brine.sense","status":"draft"}],"status":"draft","variants":[]},"96eeb1807d3004a034dad3294a63e9d6041588831b267d31fb37c105911fe0df":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: lock + open","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: lock + open","exampleIds":[],"headword":"zarel\u00c5el","id":"shakespeare014.lex.picklock_tool","ipa":"","label":"picklock_tool","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarel\u0101el","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The lock-opening tool found on Pompey and sent to the deputy.","id":"shakespeare014.lex.picklock_tool.sense","status":"draft"}],"status":"draft","variants":[]},"f3d06d63fbf8ed3c27194813ac8a835d3b309b02916ad4386c69be727769a30a":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: point + gate","sourceId":"shakespeare014.source.the-merry-wives-of-windsor.r1"}],"etymology":"Authored native derivation or sense: point + gate","exampleIds":[],"headword":"jelgl\u00c9stdaral","id":"shakespeare014.lex.pickt_hatch_district","ipa":"","label":"pickt_hatch_district","notes":"","orthographyId":"