e: wine + servant","exampleIds":[],"headword":"m\u00ebrvend\u00c7v","id":"shakespeare014.lex.drawer_tavern","ipa":"","label":"drawer_tavern","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u00fcrvend\u00e3v","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"One who draws drink and serves tavern customers, including the apprentice Francis.","id":"shakespeare014.lex.drawer_tavern.sense","status":"draft"}],"status":"draft","variants":[]},"d3f06304777f49ec51b09e9d26be96c46a8975c0195945974c4259ee621caa21":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: sink + remain","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: sink + remain","exampleIds":[],"headword":"velgaktrivdlen\u00dbemin","id":"shakespeare014.lex.dregs","ipa":"","label":"dregs","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"velgaktrivdlenshemin","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Settled unwanted residue, metaphorically the least valuable bodily remainder in Sonnet 74; the speaker\u2019s valuation does not assert that bodies are objectively worthless.","id":"shakespeare014.lex.dregs.sense","status":"draft"}],"status":"draft","variants":[]},"bf52c39ef907138d4a3ab415082f240f79bcad991fab2181d80baba735540cd0":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: horse + medicine + drink","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: horse + medicine + drink","exampleIds":[],"headword":"thalfadervorenm\u00ebr","id":"shakespeare014.lex.drench_horse","ipa":"","label":"drench_horse","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalfadervorenm\u00fcr","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A medicinal draught administered to a horse, used as Menenius\u2019s disparaging comparison. No dose, recipe or efficacy claim is supplied.","id":"shakespeare014.lex.drench_horse.sense","status":"draft"}],"status":"draft","variants":[]},"945c3395384d8ad2430f4a525cac000ffc536dd6721a3c0ba83ccf17552a0e66":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dry + fish","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"etymology":"Authored native derivation or sense: dry + fish","exampleIds":[],"headword":"mayemsdrig\u00e1l","id":"shakespeare014.lex.dried_fish_poor_john","ipa":"","label":"dried_fish_poor_john","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mayemsdrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.romeo-and-juliet.r1"}],"definition":"Poor-john, the cheap dried fish Gregory opposes to Sampson's boast about flesh.","id":"shakespeare014.lex.dried_fish_poor_john.sense","status":"draft"}],"status":"draft","variants":[]},"44901c0051e04ba96bc57aa06d8847932b5d5700ef2bd09d586489d422c1fef1":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dromyo","id":"shakespeare014.lex.dromio_ephesus_twin","ipa":"","label":"dromio_ephesus_twin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dromyo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The Ephesian servant sent to fetch his master for dinner. Same spoken name as his twin.","id":"shakespeare014.lex.dromio_ephesus_twin.sense","status":"draft"}],"status":"draft","variants":[]},"e776d8c35881ac54aa9da8c3906e608c3ea2f7ef1ac722f69e7bef7ac5b8ee35":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"dromyo","id":"shakespeare014.lex.dromio_syracuse_twin","ipa":"","label":"dromio_syracuse_twin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"dromyo","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-comedy-of-errors.r1"}],"definition":"The servant who travels with the Syracusan Antipholus. Same spoken name as his twin.","id":"shakespeare014.lex.dromio_syracuse_twin.sense","status":"draft"}],"status":"draft","variants":[]},"1230997a89b12a7fa5c3e92cca8d38d76f25d07cacd8531a7d76449cda6848ae":{"audioLinks":[],"citations":[{"locator":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored short native lexical formation; motivation specified in definition, not a claimed attested historical change.","exampleIds":[],"headword":"melsakan","id":"shakespeare014.lex.drone_bee","ipa":"","label":"drone_bee","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"melsakan","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A male bee in Lucrece\u2019s honey-loss comparison; authored honey-family creature term. The unproductive implication is source rhetoric, not a claim that a person\u2019s value depends on reproduction.","id":"shakespeare014.lex.drone_bee.sense","status":"draft"}],"status":"draft","variants":[]},"426d8a05534260eea75aaa5d3d200182b1453ec69b365a832f0676925333ed95":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from down, han