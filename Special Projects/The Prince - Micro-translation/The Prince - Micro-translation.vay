4.source.antony-and-cleopatra.r1"}],"definition":"The source\u2019s hostile Gypsy label in Antony\u2019s Egyptian pun: an Egypt-associated wanderer in his stereotype. This native place-and-wandering formation preserves the dramatic pun without asserting that actual Romani people come from Egypt or borrowing the English ordinary label.","id":"shakespeare014.lex.egyptian_rover_label.sense","status":"draft"}],"status":"draft","variants":[]},"bda12d783f7b28719a643e96c51ca7a29aba2c806d7307818cf5ed3362b16159":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: egypt + woman","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: egypt + woman","exampleIds":[],"headword":"ejiptsalena","id":"shakespeare014.lex.egyptian_woman_insult","ipa":"","label":"egyptian_woman_insult","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ejiptsalena","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Philo\u2019s derogatory Egyptian-woman designation, source gypsy. Name-affiliated native woman compound; the English Egyptian/gypsy association and its alienating slur register are recorded, not silently presented as neutral narrator fact or a new Romani character.","id":"shakespeare014.lex.egyptian_woman_insult.sense","status":"draft"}],"status":"draft","variants":[]},"3d66b85e1b6de570b2d86ad3f9819bac49c5cb1630ccea8b5e868ccaa6fedce5":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-v.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"elb","id":"shakespeare014.lex.elbe_river","ipa":"","label":"elbe_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"elb","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-v.r1"}],"definition":"The second river bounding the territory in the bishop's account.","id":"shakespeare014.lex.elbe_river.sense","status":"draft"}],"status":"draft","variants":[]},"9153c63ce8deb31a4900d57458f9966eee07f82d140c9ff2e42a3322ff10aa6c":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from arm, bend","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from arm, bend","exampleIds":[],"headword":"larlunor","id":"shakespeare014.lex.elbow","ipa":"","label":"elbow","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"larlunor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Elbow, the bending joint of the arm; not any arbitrary bend in the limb.","id":"shakespeare014.lex.elbow.sense","status":"draft"}],"status":"draft","variants":[]},"209052967d44d10cadde3d882253c3e9332c9294f91a24c72b115e32ef2b14e3":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: elbow","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: elbow","exampleIds":[],"headword":"larlunor","id":"shakespeare014.lex.elbow_vienna_constable","ipa":"","label":"elbow_vienna_constable","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"larlunor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"The constable. His bodily name remains available for the joke about leaning on justice.","id":"shakespeare014.lex.elbow_vienna_constable.sense","status":"draft"}],"status":"draft","variants":[]},"b498097b883381d40c2c77fbc1ca66c7b1b44b93c9c7e70c1f88e6b808bd4806":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_elder_sibling","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Reviewed contextual sense of kj