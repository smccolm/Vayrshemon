ions, the belly\u2019s claimed proof of fair provision.","id":"shakespeare014.lex.account_audit.sense","status":"draft"}],"status":"draft","variants":[]},"791134fd88c7ae688d3e5a57ed348885c9863040215e416da71ce8198ecfce23":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of kjv_accustomed","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of kjv_accustomed","exampleIds":[],"headword":"venarplesten","id":"shakespeare014.lex.accustom","ipa":"","label":"accustom","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"venarplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Make used to or habituate; the negative denies prior familiarity, not future possibility.","id":"shakespeare014.lex.accustom.sense","status":"draft"}],"status":"draft","variants":[]},"fe86acdeb7ba78e0c9d1a09a7e57932541539630527d55ee529ef3b3adcff464":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense of pain","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Reviewed contextual sense of pain","exampleIds":[],"headword":"murvor","id":"shakespeare014.lex.ache","ipa":"","label":"ache","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"murvor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"Experience pain; the wound is made to ache by seeing an unavailable remedy.","id":"shakespeare014.lex.ache.sense","status":"draft"}],"status":"draft","variants":[]},"f1ef5d5b34975f1826ac44eb5732562963d01ed40665fe26f889a36abe51f024":{"audioLinks":[],"citations":[{"locator":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Permitted sound adaptation of a source personal or place name; no claim of a historical sound law.",