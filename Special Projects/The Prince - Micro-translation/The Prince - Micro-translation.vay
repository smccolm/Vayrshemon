peare014.lex.griffith_katherine_usher","ipa":"","label":"griffith_katherine_usher","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"grifi\u0167h","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"Katherine's usher, who reports Wolsey's death and gives a generous account of his character.","id":"shakespeare014.lex.griffith_katherine_usher.sense","status":"draft"}],"status":"draft","variants":[]},"3d2c262a0b806e9dae35d1cb06154e8fd7f9b0c0635903ef76c8a1c85e060c91":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from tooth, smile","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from tooth, smile","exampleIds":[],"headword":"kerfar\u00d3em","id":"shakespeare014.lex.grin","ipa":"","label":"grin","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"kerfarthem","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"Smile with exposed teeth, here grim Death\u2019s expression.","id":"shakespeare014.lex.grin.sense","status":"draft"}],"status":"draft","variants":[]},"09dd787e0c3b5725141f9d13adc9ffd27c96a5e2dce8a48e182b0f2f328676f9":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of kjv_grind","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of kjv_grind","exampleIds":[],"headword":"gr\u00c9trul","id":"shakespeare014.lex.grind_crush","ipa":"","label":"grind_crush","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"gr\u00e4trul","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Crush by rubbing or pressure, here the paired jaws grinding one another. Native grind retained without implying an actual g