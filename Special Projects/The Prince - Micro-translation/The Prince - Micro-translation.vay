loor","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: ship + back + floor","exampleIds":[],"headword":"merantarjo\u00d9shal","id":"shakespeare014.lex.stern_deck","ipa":"","label":"stern_deck","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"merantarjongshal","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"The raised rear deck called poop in the barge description, beaten gold in the account. Not bodily excrement or a stern facial expression.","id":"shakespeare014.lex.stern_deck.sense","status":"draft"}],"status":"draft","variants":[]},"81d66db823e1346b2a767b471606e89ac0661cfdfcd5a0b669bb687a35f81ddb":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: harlot_person + house","sourceId":"shakespeare014.source.cymbeline.r1"}],"etymology":"Authored native derivation or sense: harlot_person + house","exampleIds":[],"headword":"belenkwistz\u00e1l","id":"shakespeare014.lex.stew_brothel","ipa":"","label":"stew_brothel","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"belenkwistz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.cymbeline.r1"}],"definition":"A place of commercial sex. The princess asks whether her father allows a stranger to trade as in a Roman stew.","id":"shakespeare014.lex.stew_brothel.sense","status":"draft"}],"status":"draft","variants":[]},"c515f1c6bdbfe44b92c08fd5bd07a0c88220737bf4ed7ca9bb64225cb8d0542f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: soak + heat","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: soak + heat","exampleIds":[],"headword":"thimelher\u00db","id":"shakespeare014.lex.stew_simmer","ipa":"","label":"stew_simmer","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"thimelhersh","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Heat while immersed in liquid, Cleopatra\u2019s cruel imagined brine punishment. A native soak-heat action, not a claim of a performed event or a technical preparation procedure.","id":"shakespeare014.lex.stew_simmer.sense","status":"draft"}],"status":"draft","variants":[]},"718caf8e84614c0c21c68cc7351fa440258e2790427d3fbd56946efc69f1e7b5":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: hard","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: hard","exampleIds":[],"headword":"jw\u00ebnenplesten","id":"shakespeare014.lex.stiff_body","ipa":"","label":"stiff_body","notes":"","orthographyId":"thimfora-79","partOfSpeech":"modifier","pronunciation":"jw\u00fcnenplesten","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Bodily stiffness or difficulty moving, the teasing question to Lartius; not necessarily obstinacy or a specified medical diagnosis.","id":"shakespeare014.lex.stiff_body.sense","status":"draft"}],"status":"draft","variants":[]},"372ae3e1ee7f88ff1c754480d74777cf7baa604ddcd0cb124177d962d90f272f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: fence + step","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"etymology":"Authored native derivation or sense: fence + step","exampleIds":[],"headword":"thelirpalen","id":"shakespeare014.lex.stile_fence_step","ipa":"","label":"stile_fence_step","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thelirpalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-winters-tale.r1"}],"definition":"A crossing of a fence by steps, taken merrily in Autolycus's road song.","id":"shakespeare014.lex.stile_fence_step.sense","status":"draft"}],"status":"draft","variants":[]},"3fae3c1e530c48209da254039fdb74b495cac6e9338d521c70fe093d129ab88f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: anger","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: anger","exampleIds":[],"headword":"\u00e5\u00d1","id":"shakespeare014.lex.stir_anger","ipa":"","label":"stir_anger","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ouch","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"Rouse someone\u2019s anger, Brutus\u2019s being moved before mocking the gods, not physical relocation.","id":"shakespeare014.lex.stir_anger.sense","status":"draft"}],"status":"draft","variants":[]},"c724a90cc1e6373a5a808234c4ff214e3e9c5c0748e10cb5ee4f0b8c462a136f":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: horse + foot + ring","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: horse + foot + ring","exampleIds":[],"headword":"thalpalesviminolen","id":"shakespeare014.lex.stirrup_footrest","ipa":"","label":"stirrup_footrest","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"thalpalesviminolen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A riding foot-support in which the armed knee bends. Native horse-foot-ring preserves the supplied theatrical anachronism without importing the English word or asserting a Roman archaeological date.","id":"shakespeare014.lex.stirrup_footrest.sense","status":"draft"}],"status":"draft","variants":[]},"73ed51136afca19726d21ca3980abb0ce8d1bc3cee0570967c09efd38e6d8eba":{"audioLinks":[],"citations":[{"locator":"Authored native compound: old + mask","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"etymology":"Authored native compound: old + mask","exampleIds":[],"headword":"vornub\u00e1nt\u00e9vshalen","id":"shakespeare014.lex.stock_old_man","ipa":"","label":"stock_old_man","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"vornub\u00f4nt\u00e9vshalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.as-you-like-it.r1"}],"definition":"The conventional old-man stage figure represented by the source pantaloon. Native old + mask names the theatrical role without borrowing its Italian name. Its thinness, slippers and spectacles are separately stated in the passage.","id":"shakespeare014.lex.stock_old_man.sense","status":"draft"}],"status":"draft","variants":[]},"dc79e0e402f477e675b5b6fedea4db419c730c74e3d29ab84e5d7230fd3e53bd":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dry + fish_creature","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"etymology":"Authored native derivation or sense: dry + fish_creature","exampleIds":[],"headword":"mayemsdrig\u00e1l","id":"shakespeare014.lex.stockfish_dried_fish","ipa":"","label":"stockfish_dried_fish","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"mayemsdrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.measure-for-measure.r1"}],"definition":"Dried fish in Lucio's absurd account of Angelo's parentage; distinct from the speaking surname in Love's Labor's Lost.","id":"shakespeare014.lex.stockfish_dried_fish.sense","status":"draft"}],"status":"draft","variants":[]},"aef2b8d354f28b466fa634ab55e29c3b2768f92d022af6e5b4d8f185b2f97b1d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: dry + fish_creature","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"etymology":"Authored native derivation or sense: dry + fish_creature","exampleIds":[],"headword":"mayemsdrig\u00e1l","id":"shakespeare014.lex.stockfish_surname","ipa":"","label":"stockfish_surname","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"mayemsdrig\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-2.r1"}],"definition":"Sampson the fruiterer's surname, using the native dried-fish image.","id":"shakespeare014.lex.stockfish_surname.sense","status":"draft"}],"status":"draft","variants":[]},"e478417bc9e2552a1cf42626982bb4ccde65f056a502f511e0ccce95b7859f3d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"stokli","id":"shakespeare014.lex.stokeley_london_bishop","ipa":"","label":"stokeley_london_bishop","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"stokli","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The Bishop of London named beside Gardiner, who now holds Winchester.","id":"shakespeare014.lex.stokeley_london_bishop.sense","status":"draft"}],"status":"draft","variants":[]},"b4e1b38f647ba8851b921748175aacbaf0e0be7a361c06351cb268554add72fe":{"audioLinks":[],"citations":[{"locator":"Reviewed contextual sense/identity of stomaching_resentment","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Reviewed contextual sense/identity of stomaching_resentment","exampleIds":[],"headword":"\u00e5\u00d1jem\u00e3","id":"shakespeare014.lex.stomach_resent","ipa":"","label":"stomach_resent","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"ouchjemoi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Take offence at or nurse resentment over a report, Octavia\u2019s stomach not all. Explicit verbal use of the native resentment expression, not digest food and not endure everything quietly.","id":"shakespeare014.lex.stomach_resent.sense","status":"draft"}],"status":"draft","variants":[]},"675e78c8b4e9b31c5b749b19d11bbc3e7ebc19518bb955fa29a64dd4614aa50d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: anger + keep","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: anger + keep","exampleIds":[],"headword":"\u00e5\u00d1jem\u00e3","id":"shakespeare014.lex.stomaching_resentment","ipa":"","label":"stomaching_resentment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"ouchjemoi","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Keeping private bitter anger, source stomaching. This is resentment rather than the digestive organ or swallowing food.","id":"shakespeare014.lex.stomaching_resentment.sense","status":"draft"}],"status":"draft","variants":[]},"e7829b36abbac5e7a31a8df2f85a6f1ced45dbca1737825d3871fc7ab87f4ce7":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from stone, surround","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"etymology":"Native lexical derivation from stone, surround","exampleIds":[],"headword":"kwestao\u00c3t\u00e7","id":"shakespeare014.lex.stone_band","ipa":"","label":"stone_band","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"kwestaojzht\u016b","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"definition":"An encircling stone band in the ivory/alabaster hand image; not a troupe of people.","id":"shakespeare014.lex.stone_band.sense","status":"draft"}],"status":"draft","variants":[]},"6977be67159f57b6c6a38db55945fbcb9cbc48c9c6ca63ee849b629df44d5a67":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.richard-iii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"stoni stratford","id":"shakespeare014.lex.stony_stratford_road","ipa":"","label":"stony_stratford_road","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"stoni stratford","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.richard-iii.r1"}],"definition":"The reported previous night's lodging on the prince's journey.","id":"shakespeare014.lex.stony_stratford_road.sense","status":"draft"}],"status":"draft","variants":[]},"ef9d1ef2d58334dfaaaf89109f87d238ce4e7fb17a11aed38e6d93cebfeb6a6b":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: stool + ball","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"etymology":"Authored native derivation or sense: stool + ball","exampleIds":[],"headword":"grelsilenl\u00dfnkor","id":"shakespeare014.lex.stool_ball_game","ipa":"","label":"stool_ball_game","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"grelsilenl\u014dnkor","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-two-noble-kinsmen.r1"}],"definition":"The ball game named by the Daughter when discussing their visit to the world's end. The dialogue's sexual suggestion remains in the exchange.","id":"shakespeare014.lex.stool_ball_game.sense","status":"draft"}],"status":"draft","variants":[]},"4634a979e2121215c029b9bd0120f62e9e13253a529926cb5a3d894a9ff4a773":{"audioLinks":[],"citations":[{"locator":"Authored native derivation/sense: kjv_storehouse","sourceId":"shakespeare014.source.coriolanus.r1"}],"etymology":"Authored native derivation/sense: kjv_storehouse","exampleIds":[],"headword":"m\u00c5rumz\u00e1l","id":"shakespeare014.lex.storehouse_building","ipa":"","label":"storehouse_building","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"m\u0101rumz\u00f4l","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.coriolanus.r1"}],"definition":"A building storing supplies, the citizens\u2019 accusation that stored grain is withheld. Reviewed promotion of the native historical category, not a modernization of any Bible file.","id":"shakespeare014.lex.storehouse_building.sense","status":"draft"}],"status":"draft","variants":[]},"ea64362ee0acd8dece5fbb3b518d3cafd7ae7cfa7e5b6f2dd5dd075c3ed309ea":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.twelfth-night.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"straki","id":"shakespeare014.lex.strachy_malvolio_story","ipa":"","label":"strachy_malvolio_story","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"straki","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.twelfth-night.r1"}],"definition":"Malvolio's example of a lady who married beneath her rank. The original title is obscure.","id":"shakespeare014.lex.strachy_malvolio_story.sense","status":"draft"}],"status":"draft","variants":[]},"cb98d36916d0d62fa058c5b1488057643ce7ec8cb7b83e67529eb98206968e7f":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-viii.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"strand","id":"shakespeare014.lex.strand_london_street","ipa":"","label":"strand_london_street","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"strand","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-viii.r1"}],"definition":"The district from which the truncheon-bearers come to the woman's aid.","id":"shakespeare014.lex.strand_london_street.sense","status":"draft"}],"status":"draft","variants":[]},"02a37687cba37abf0c3e12723c4a3fe4533c08c57e3d099cf4a108767a2fb8c5":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"strenj","id":"shakespeare014.lex.strange_title","ipa":"","label":"strange_title","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"strenj","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The family title in Lord Strange of Blackmere, not a description of unfamiliarity.","id":"shakespeare014.lex.strange_title.sense","status":"draft"}],"status":"draft","variants":[]},"a4ea698b177c52c88b6739143b63c9202d40f06d2d5c13f0a9f9addcb4dad2db":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: neck + choke","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"etymology":"Authored native lexical derivation: neck + choke","exampleIds":[],"headword":"harenkl\u00e1reni\u00d1\u00d7bra","id":"shakespeare014.lex.strangle","ipa":"","label":"strangle","notes":"","orthographyId":"thimfora-79","partOfSpeech":"verb","pronunciation":"harenkl\u00f4renich\u0113bra","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.shakespeares-sonnets.r1"}],"definition":"Choke by constricting the neck, metaphorically kill acquaintance in Sonnet 89; preserves the violent self-denial without introducing an actual victim.","id":"shakespeare014.lex.strangle.sense","status":"draft"}],"status":"draft","variants":[]},"0d3472b8746ae477bf0bb3b2fb742e22128c5ef81f580c4607a1ab2f579be059":{"audioLinks":[],"citations":[{"locator":"Native lexical derivation from leather, thread","sourceId":"shakespeare014.source.venus-and-adonis.r1"}],"e