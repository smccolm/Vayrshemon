peech":"verb","pronunciation":"merthrenpalen","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Come ashore from a vessel, Cleopatra landing before the supper invitations. Native shore-step distinguishes the action from cultivated land as property.","id":"shakespeare014.lex.land_disembark.sense","status":"draft"}],"status":"draft","variants":[]},"d652586575918ac721cc53375910a969816b4524d7bf199aa6b2849e6da168c5":{"audioLinks":[],"citations":[{"locator":"Authored native lexical derivation: flat + land","sourceId":"shakespeare014.source.lucrece.r1"}],"etymology":"Authored native lexical derivation: flat + land","exampleIds":[],"headword":"shalinjo\u00d9","id":"shakespeare014.lex.land_plain","ipa":"","label":"land_plain","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"shalinjong","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"A level expanse of open land, contrasted with a rough grove; distinct from plain as unadorned.","id":"shakespeare014.lex.land_plain.sense","status":"draft"}],"status":"draft","variants":[]},"bf372d46a502c463b46a10aa5704630f9dcb5baa562544a56d4f699c96cf0fe6":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: land + nobleman","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Authored native derivation or sense: land + nobleman","exampleIds":[],"headword":"jo\u00d9arvens\u00dflum","id":"shakespeare014.lex.landed_squire","ipa":"","label":"landed_squire","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongarvens\u014dlum","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.king-john.r1"}],"definition":"Robert becomes a landholding gentleman when his brother becomes a landless knight.","id":"shakespeare014.lex.landed_squire.sense","status":"draft"}],"status":"draft","variants":[]},"fd83d7bc3205fec4eb7b640dba79ac9a8076589531e23216fdfaae294a2f9e86":{"audioLinks":[],"citations":[{"locator":"Authored native derivation: land + lord","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"etymology":"Authored native derivation: land + lord","exampleIds":[],"headword":"jo\u00d9arvenek","id":"shakespeare014.lex.landlord_ruler","ipa":"","label":"landlord_ruler","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"jongarvenek","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.antony-and-cleopatra.r1"}],"definition":"Lord or master of land in the envoy\u2019s universal-landlord claim for Caesar. Native land-lord retains the property metaphor without asserting modern tenancy law or worldwide historical sovereignty.","id":"shakespeare014.lex.landlord_ruler.sense","status":"draft"}],"status":"draft","variants":[]},"e1391c72799f68320637b1cf03b64c8301f5174fe4ca191c3170c7fc1751f08a":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"la\u00d9li","id":"shakespeare014.lex.langley_york","ipa":"","label":"langley_york","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"langli","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"Edmund Langley, Duke of York in the account of the Cambridge descent.","id":"shakespeare014.lex.langley_york.sense","status":"draft"}],"status":"draft","variants":[]},"c85aafce9f564be1fbd6f786e2405c37aaa6dc78007c8e0de377542611c2734d":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.king-john.r1"}],"etymology":"Author-permitted phonetic personal-name 