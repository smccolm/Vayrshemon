","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-vi-part-1.r1"}],"definition":"The funeral bier carrying the dead king.","id":"shakespeare014.lex.funeral_bier.sense","status":"draft"}],"status":"draft","variants":[]},"7f52050c756021f4decff749418a0d12746f3d7281e95e215f2a748f8ff0135d":{"audioLinks":[],"citations":[{"locator":"Authored native derivation or sense: death + armorial_coat","sourceId":"shakespeare014.source.hamlet.r1"}],"etymology":"Authored native derivation or sense: death + armorial_coat","exampleIds":[],"headword":"n\u00d7nenarventhrendewy\u00c9","id":"shakespeare014.lex.funeral_hatchment","ipa":"","label":"funeral_hatchment","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"n\u0113nenarventhrendewy\u00e4","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.hamlet.r1"}],"definition":"Funerary display of a dead person's arms, missing from Polonius's burial in Laertes's account.","id":"shakespeare014.lex.funeral_hatchment.sense","status":"draft"}],"status":"draft","variants":[]},"da980ff7d219f6bb07bfa54d264c3a6d0752d73240fc687e7d9948e9beec8493":{"audioLinks":[],"citations":[{"locator":"The Phoenix and Turtle: Native compound of ashes, vessel. Vessel holding funerary burnt remains in this poem; does not imply an unspecified exact shape.","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"etymology":"The Phoenix and Turtle: Native compound of ashes, vessel. Vessel holding funerary burnt remains in this poem; does not imply an unspecified exact shape.","exampleIds":[],"headword":"zarunthrenborel","id":"shakespeare014.lex.funerary_urn","ipa":"","label":"funerary_urn","notes":"","orthographyId":"thimfora-79","partOfSpeech":"noun","pronunciation":"zarunthrenborel","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-phoenix-and-turtle"}],"definition":"Vessel holding funerary 