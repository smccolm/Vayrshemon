Speech":"noun","pronunciation":"ezna","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.lucrece.r1"}],"definition":"The matter conveyed by a text, not the feeling of being content; the contents of old books and Lucrece\u2019s letter.","id":"shakespeare014.lex.written_content.sense","status":"draft"}],"status":"draft","variants":[]},"2e986acb9f0a19f0b3f4272467fbbb3e365fb25046d30fdbdf4afa60857d84fd":{"audioLinks":[],"citations":[{"locator":"Author-permitted geographic-name adaptation","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"etymology":"Author-permitted geographic-name adaptation","exampleIds":[],"headword":"wai","id":"shakespeare014.lex.wye_river","ipa":"","label":"wye_river","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"wai","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.henry-iv-part-1.r1"}],"definition":"The river from whose banks Glendower says he has driven Henry.","id":"shakespeare014.lex.wye_river.sense","status":"draft"}],"status":"draft","variants":[]},"6633e10bbc666fbeb1aebc83f4feb714af70c7d39f927193157eae7bcb757684":{"audioLinks":[],"citations":[{"locator":"Author-permitted phonetic personal-name adaptation","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"etymology":"Author-permitted phonetic personal-name adaptation","exampleIds":[],"headword":"ksantipe","id":"shakespeare014.lex.xanthippe_socrates_wife","ipa":"","label":"xanthippe_socrates_wife","notes":"","orthographyId":"thimfora-79","partOfSpeech":"proper","pronunciation":"ksantipe","senses":[{"citations":[{"locator":"Authored lexical decision","sourceId":"shakespeare014.source.the-taming-of-the-shrew.r1"}],"definition":"The wife whom Petruchio names with Socrates.","id":"shakespeare014.lex.xanthippe_socrates_wife.sense","status":"draft"}],"status":"draft","variants":[]},"984c3f3ef11e4512a7fcf4a26eab7d5bb7beb6e7e0db5b1d8f0ea6428ff78097":{"