    {
      "name": "document_edit",
      "description": "Replace a UTF-16 range on grapheme boundaries. Revision and idempotency key are required.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "text": {
            "type": "string",
            "maxLength": 100000
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "documentId": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "text",
          "expectedRevision",
          "idempotencyKey",
          "documentId"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "document_format",
      "description": "Format a UTF-16 range, retaining explicit font/language and custom spacing.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200000
          },
          "font_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "language": {
            "type": "string",
            "pattern": "^language\\.[A-Za-z0-9._-]+$"
          },
          "size": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{8}$"
          },
          "tracking": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "wordSpacing": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "baseline": {
            "type": "number",
            "minimum": -100,
            "maximum": 100
          },
          "expectedRevision": {
            "type": "integer",
            "minimum": 0
          },
          "idempotencyKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "documentId": {
            "type": "string"
          }
        },
        "required": [
          "start",
          "end",
          "expectedRevision",
          "idempotencyKey",
          "documentId"
        ],
        "additionalProperties": false
      }
    },
