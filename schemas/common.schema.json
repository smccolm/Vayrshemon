{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vayrshemon:schema:common:0.1.0",
  "title": "Vayrshemon common 0.1.0",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "scalar": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1114111,
      "not": {
        "minimum": 55296,
        "maximum": 57343
      }
    },
    "asset": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:])[^\\r\\n]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "assetId",
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "properties": {
        "asset": {
          "type": "object",
          "properties": {
            "assetId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(/|$))(?!.*[\\\\:])[^\\r\\n]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "assetId",
            "path",
            "sha256"
          ],
          "additionalProperties": false
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "asset",
        "locator",
        "method"
      ],
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "properties": {
        "symbolId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
        },
        "form": {
          "enum": [
            "maxima",
            "minima",
            "default"
          ]
        }
      },
      "required": [
        "symbolId",
        "form"
      ],
      "additionalProperties": false
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveMicroPoints": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$",
      "maxLength": 19
    },
    "unsignedMicroPoints": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 19
    },
    "signedMicroPoints": {
      "type": "string",
      "pattern": "^(0|-?[1-9][0-9]*)$",
      "maxLength": 20
    }
  }
}
