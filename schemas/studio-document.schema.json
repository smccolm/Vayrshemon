                "rim": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "highlight": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "recess": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "edge": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "glow": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "bevel": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 0.1
                },
                "depth": {
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 8
                },
                "edgeWidth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.02
                },
                "glowRadius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.08
                },
                "glowOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "shadowRadius": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.08
                },
                "shadowX": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.1
                },
                "shadowY": {
                  "type": "number",
                  "minimum": -0.1,
                  "maximum": 0.1
                },
                "shadowOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "lightAzimuth": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 360
                },
                "lightElevation": {
                  "type": "number",
                  "minimum": 5,
                  "maximum": 85
                },
                "gradient": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "lightingModel": {
                  "enum": [
                    "legacy-1",
                    "individual-glyphs-1"
                  ]
                },
                "referenceGradients": {
                  "type": "boolean"
                },
                "recessTop": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "recessBottom": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "interiorBevel": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 0.15
                },
                "highlightOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "bevelShadowOpacity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "normalSmoothing": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.01
                },
                "glowRange": {
                  "type": "number",
                  "minimum": 0.01,
                  "maximum": 1
                },
                "glowSpread": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.02
                }
              },
              "required": [
                "recipeId",
                "version",
                "revision",
                "rim",
                "highlight",
                "recess",
                "edge",
                "glow",
                "bevel",
                "depth",
                "edgeWidth",
                "glowRadius",
                "glowOpacity",
                "shadowRadius",
                "shadowX",
                "shadowY",
                "shadowOpacity",
                "lightAzimuth",
                "lightElevation",
                "gradient"
              ],
              "additionalProperties": false
            },
            "bindings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "fontId": {
                    "type": "string",
                    "pattern": "^font:[0-9a-f]{64}:0$"
                  },
                  "enabled": {
                    "type": "boolean"
                  },
                  "kind": {
                    "enum": [
                      "layered",
                      "derived"
                    ]
                  },
                  "glowFontId": {
                    "type": "string",
                    "pattern": "^font:[0-9a-f]{64}:0$"
                  },
                  "interiorFontId": {
                    "type": "string",
                    "pattern": "^font:[0-9a-f]{64}:0$"
                  },
                  "profile": {
                    "const": "roman-translation-1"
                  }
                },
                "required": [
                  "fontId",
                  "enabled",
                  "kind"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "kind": {
                          "const": "layered"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "glowFontId",
                        "interiorFontId"
                      ]
                    },
                    "else": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "glowFontId"
                            ]
                          },
                          {
                            "required": [
                              "interiorFontId"
                            ]
                          }
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "required": [
                        "profile"
                      ]
                    },
                    "then": {
                      "properties": {
                        "kind": {
                          "const": "derived"
                        }
                      }
                    }
                  }
                ]
              },
              "maxItems": 128
            },
            "background": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{8}$"
            },
            "rasterDpi": {
              "type": "integer",
              "minimum": 72,
              "maximum": 600
            }
          },
          "required": [
            "version",
            "recipe",
            "bindings",
            "background",
            "rasterDpi"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "documentId",
        "title",
        "revision",
        "pages",
        "activeFrameId",
        "fontSources",
        "recipe",
        "features",
        "view",
        "styles",
        "typesetting",
        "paint"
      ],
      "additionalProperties": false
    },
    "history": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "label": {
            "type": "string"
          },
          "timestamp": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "revision",
          "label",
          "timestamp",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "engine": {
      "type": "object"
    }
  },
  "required": [
    "format",
