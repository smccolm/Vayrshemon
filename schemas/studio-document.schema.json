            },
            "origins": {
              "type": "boolean"
            },
            "bounds": {
              "type": "boolean"
            },
            "zoom": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 3
            }
          },
          "required": [
            "mode",
            "baselines",
            "origins",
            "bounds",
            "zoom"
          ],
          "additionalProperties": false
