                                    "maximum": 100
                                  },
                                  "wordSpacing": {
                                    "type": "number",
                                    "minimum": -100,
                                    "maximum": 100
                                  },
                                  "baseline": {
                                    "type": "number",
                                    "minimum": -100,
                                    "maximum": 100
                                  }
                                },
                                "required": [
                                  "tracking",
                                  "wordSpacing",
                                  "baseline"
                                ],
                                "additionalProperties": false
                              }
                            },
                            "required": [
                              "start",
                              "end",
                              "attributes"
