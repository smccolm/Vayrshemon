              "maxProperties": 128
            },
            "flows": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "targets": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                    },
                    "uniqueItems": true,
                    "maxItems": 127
                  }
                },
                "required": [
                  "source",
                  "targets"
                ],
                "additionalProperties": false
              }
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "languageId": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "wrap": {
                    "enum": [
                      "word",
                      "grapheme",
                      "none"
                    ]
                  },
                  "emergency": {
                    "type": "boolean"
                  },
                  "breakAfter": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "prohibitBefore": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "prohibitAfter": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "hyphenation": {
                    "const": "manual-only"
                  }
