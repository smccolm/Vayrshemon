                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{8}$"
                  },
                  "tracking": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "wordSpacing": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
                  },
                  "baseline": {
                    "type": "number",
                    "minimum": -100,
                    "maximum": 100
