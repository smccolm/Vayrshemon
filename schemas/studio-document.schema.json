                      "type": "object",
                      "properties": {
                        "blockId": {
                          "type": "string",
                          "pattern": "^[A-Za-z][A-Za-z0-9._:-]{0,127}$"
                        },
                        "keepWithNext": {
                          "type": "boolean"
                        },
                        "keepTogether": {
                          "type": "boolean"
                        },
                        "widows": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        },
                        "orphans": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 20
                        }
                      },
                      "required": [
                        "blockId",
                        "keepWithNext",
                        "keepTogether",
                        "widows",
                        "orphans"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 2000
                  },
                  "optical": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "left": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16
                        },
                        "right": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 16
                        },
                        "fontId": {
                          "type": [
                            "string",
                            "null"
