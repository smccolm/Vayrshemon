                    "y": {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)$",
                      "maxLength": 13
                    },
                    "width": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$",
                      "maxLength": 13
                    },
                    "height": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*$",
                      "maxLength": 13
