          "required": [
            "version",
            "frames",
            "flows",
            "profiles"
          ],
          "additionalProperties": false
        },
        "paint": {
          "type": "object",
          "properties": {
            "version": {
              "const": "1.0.0"
            },
            "recipe": {
              "type": "object",
              "properties": {
                "recipeId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "version": {
                  "const": "1.0.0"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1
