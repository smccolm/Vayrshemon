                                "type": "number",
                                "minimum": 0,
                                "maximum": 10000
                              },
                              "after": {
                                "type": "number",
                                "minimum": 0,
                                "maximum": 10000
                              },
                              "tabs": {
                                "type": "array",
                                "items": {
                                  "type": "number",
                                  "minimum": 0,
                                  "maximum": 1000000
                                },
                                "maxItems": 100
                              }
                            },
                            "required": [
                              "alignment",
                              "before",
                              "after",
                              "tabs"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "document",
                        "styleFeatures",
                        "characters",
                        "paragraphs"
